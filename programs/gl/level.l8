// Shared block-game level I/O and rules.
// Level file (one puzzle, local coords):
//   title Name
//   size <w> <h>              room is (0,0)..(w-1,h-1)
//   g / w / p / b / s / r     as below
// World file:
//   world
//   p <column> <row>
//   level <name> <x0> <y0> <x1> <y1> <title>
//   g / b / s / r / w / f         world-space contents
// Legacy world:
//   place <name> <x> <y> <rot>   composed once, then flattened on save
// Legacy numeric: room / c-column migrate. Grid: `= Title` maps.
extern open(path: [z]i8, flags: int, mode: int): int;

extern open_nul(path: []i8, flags: int, mode: int): int;

extern close(fd: int): int;

LEVEL_O_WRONLY: int = 1;

LEVEL_O_CREAT: int = 64;

LEVEL_O_TRUNC: int = 512;

LEVEL_MODE: int = 420;

LEVEL_MAX_BLOCKS: int = 2048;

LEVEL_MAX_ROOMS: int = 64;

LEVEL_MAX_GOALS: int = 64;

LEVEL_MAX_BRICKS: int = 2048;

LEVEL_MAX_GROUND: int = 8192;

LEVEL_MAX_PLACES: int = 64;

LEVEL_SOFT_CAP: int = 4096;

LEVEL_PACK_BIAS: int = 4096;

LEVEL_PACK_SPAN: int = 8193;

LEVEL_PACK_ROW: int = 16;

LEVEL_PACK_COL: int = 131088;

LEVEL_DEFAULT_PATH: []i8 = "programs/gl/world.txt";

LEVEL_MAP_PATH: []i8 = "programs/gl/puzzles.map";

LEVEL_MAX_LAYER: int = 8;

GROUND_DIRT: int = 0;

GROUND_GRASS: int = 1;

GROUND_STONE: int = 2;

GROUND_CLEAR_STONE: int = 3;

type Block = {
    id: int;
    column: int;
    row: int;
    shape: int;
    layer: int;
    ramp: int;
    mounted: int;
};

type Room = {
    x0: int;
    y0: int;
    x1: int;
    y1: int;
};

type Goal = {
    column: int;
    row: int;
};

type Brick = {
    column: int;
    row: int;
};

type GroundCell = {
    column: int;
    row: int;
    style: int;
    stone: int;
};

type Placement = {
    x: int;
    y: int;
    rot: int;
};

zslice_z(s: [z]i8): []i8@new {
    n: int = 0;
    while (s[n] != 0i8) {
        n = n + 1;
    }
    out: []i8 = new i8[n](0i8);
    i: int = 0;
    while (i < n) {
        out[i] = s[i];
        i = i + 1;
    }
    out;
}

arg_eq(a: [z]i8, b: []i8): bool {
    n: int = len(b);
    i: int = 0;
    while (a[i] != 0i8) {
        if (i >= n) {
            return false;
        }
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    i == n;
}

level_path_at(argc: int, argv: [][z]i8, i: int): []i8@new {
    if (argc > i) {
        return zslice_z(argv[i]);
    }
    d: []i8 = LEVEL_DEFAULT_PATH;
    n: int = len(d);
    out: []i8 = new i8[n](0i8);
    memcpy(out, 0, d, 0, n);
    out;
}

open_path(path: []i8, flags: int, mode: int): int {
    n: int = len(path);
    z: []i8 = new i8[n + 1](0i8);
    memcpy(z, 0, path, 0, n);
    z[n] = 0i8;
    open_nul(z, flags, mode);
}

in_bounds(column: int, row: int): bool {
    column >= 0 - LEVEL_SOFT_CAP && column <= LEVEL_SOFT_CAP && row >= 0 - LEVEL_SOFT_CAP && row <= LEVEL_SOFT_CAP;
}

norm_room(x0: int, y0: int, x1: int, y1: int): Room {
    if (x1 < x0) {
        t: int = x0;
        x0 = x1;
        x1 = t;
    }
    if (y1 < y0) {
        t2: int = y0;
        y0 = y1;
        y1 = t2;
    }
    Room {
        x0: x0,
        y0: y0,
        x1: x1,
        y1: y1
    };
}

room_contains(r: Room, column: int, row: int): bool {
    column >= r.x0 && column <= r.x1 && row >= r.y0 && row <= r.y1;
}

room_area(r: Room): int {
    (r.x1 - r.x0 + 1) * (r.y1 - r.y0 + 1);
}

room_at(rooms: []Room, nroom: int, column: int, row: int): int {
    best: int = 0 - 1;
    best_a: int = 0;
    i: int = 0;
    while (i < nroom) {
        r: Room = rooms[i];
        if (room_contains(r, column, row)) {
            a: int = room_area(r);
            if (best < 0 || a < best_a) {
                best = i;
                best_a = a;
            }
        }
        i = i + 1;
    }
    best;
}

same_room(
    rooms: []Room,
    nroom: int,
    ac: int,
    ar: int,
    bc: int,
    br: int
): bool {
    ia: int = room_at(rooms, nroom, ac, ar);
    ia >= 0 && ia == room_at(rooms, nroom, bc, br);
}

is_brick(bricks: []Brick, nbrick: int, column: int, row: int): bool {
    i: int = 0;
    while (i < nbrick) {
        b: Brick = bricks[i];
        if (b.column == column && b.row == row) {
            return true;
        }
        i = i + 1;
    }
    false;
}

is_goal(goals: []Goal, ngoal: int, column: int, row: int): bool {
    i: int = 0;
    while (i < ngoal) {
        g: Goal = goals[i];
        if (g.column == column && g.row == row) {
            return true;
        }
        i = i + 1;
    }
    false;
}

put_ground_cell(
    ground: []GroundCell,
    nground: int,
    column: int,
    row: int,
    style: int,
    stone: int,
    keep_dirt: int
): int {
    if (style == GROUND_STONE) {
        style = GROUND_GRASS;
        stone = 1;
    }
    if (style != GROUND_GRASS) {
        style = GROUND_DIRT;
    }
    if (stone != 0) {
        stone = 1;
    }
    drop: int = 0;
    if (style == GROUND_DIRT && stone == 0 && keep_dirt == 0) {
        drop = 1;
    }
    i: int = 0;
    while (i < nground) {
        f: GroundCell = ground[i];
        if (f.column == column && f.row == row) {
            if (drop != 0) {
                ground[i] = ground[nground - 1];
                return nground - 1;
            }
            f.style = style;
            f.stone = stone;
            ground[i] = f;
            return nground;
        }
        i = i + 1;
    }
    if (drop != 0 || nground >= LEVEL_MAX_GROUND || !in_bounds(column, row)) {
        return nground;
    }
    ground[nground] = GroundCell {
        column: column,
        row: row,
        style: style,
        stone: stone
    };
    nground + 1;
}

paint_ground_cell(
    ground: []GroundCell,
    nground: int,
    column: int,
    row: int,
    brush: int,
    keep_dirt: int
): int {
    style: int = GROUND_DIRT;
    stone: int = 0;
    i: int = 0;
    while (i < nground) {
        f: GroundCell = ground[i];
        if (f.column == column && f.row == row) {
            style = f.style;
            stone = f.stone;
            i = nground;
        } else {
            i = i + 1;
        }
    }
    if (brush == GROUND_DIRT) {
        style = GROUND_DIRT;
    } else if (brush == GROUND_GRASS) {
        style = GROUND_GRASS;
    } else if (brush == GROUND_STONE) {
        stone = 1;
    } else if (brush == GROUND_CLEAR_STONE) {
        stone = 0;
    }
    put_ground_cell(ground, nground, column, row, style, stone, keep_dirt);
}

paint_ground_rect(
    ground: []GroundCell,
    nground: int,
    c0: int,
    r0: int,
    c1: int,
    r1: int,
    style: int,
    explicit_dirt: int
): int {
    if (c1 < c0) {
        t: int = c0;
        c0 = c1;
        c1 = t;
    }
    if (r1 < r0) {
        t: int = r0;
        r0 = r1;
        r1 = t;
    }
    if ((c1 - c0 + 1) * (r1 - r0 + 1) > LEVEL_MAX_GROUND) {
        return nground;
    }
    r: int = r0;
    while (r <= r1) {
        c: int = c0;
        while (c <= c1) {
            nground = paint_ground_cell(ground, nground, c, r, style, explicit_dirt);
            c = c + 1;
        }
        r = r + 1;
    }
    nground;
}

parse_ground_kind(src: []i8, i: int, out: []int): int {
    i = skip_spaces(src, i);
    style: int = 0 - 1;
    stone: int = 0;
    if (word_at(src, i, "stone")) {
        style = GROUND_GRASS;
        stone = 1;
        i = i + 5;
    } else if (word_at(src, i, "dirt")) {
        style = GROUND_DIRT;
        i = i + 4;
    } else if (word_at(src, i, "grass")) {
        style = GROUND_GRASS;
        i = i + 5;
    }
    if (style >= 0) {
        i = skip_spaces(src, i);
        if (word_at(src, i, "stone")) {
            stone = 1;
            i = i + 5;
        }
    }
    out[0] = style;
    out[1] = stone;
    i;
}

put_ground_kind(dst: []i8, i: int, f: GroundCell): int {
    if (f.style == GROUND_GRASS) {
        i = put_str(dst, i, "grass");
    } else {
        i = put_str(dst, i, "dirt");
    }
    if (f.stone != 0) {
        i = put_ch(dst, i, ' ');
        i = put_str(dst, i, "stone");
    }
    i;
}

delete_room_at(rooms: []Room, titles: [][]i8, nroom: int, i: int): int {
    if (i < 0 || i >= nroom) {
        return nroom;
    }
    rooms[i] = rooms[nroom - 1];
    titles[i] = titles[nroom - 1];
    nroom - 1;
}

delete_level_boundary(
    rooms: []Room,
    titles: [][]i8,
    names: [][]i8,
    nroom: int,
    i: int
): int {
    if (i < 0 || i >= nroom) {
        return nroom;
    }
    rooms[i] = rooms[nroom - 1];
    titles[i] = titles[nroom - 1];
    names[i] = names[nroom - 1];
    nroom - 1;
}

add_room(
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    x0: int,
    y0: int,
    x1: int,
    y1: int,
    title: []i8@titles
): int {
    if (nroom >= LEVEL_MAX_ROOMS) {
        return nroom;
    }
    rooms[nroom] = norm_room(x0, y0, x1, y1);
    titles[nroom] = title;
    nroom + 1;
}

set_room_size(
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    w: int,
    h: int
): int {
    if (w < 1) {
        w = 1;
    }
    if (h < 1) {
        h = 1;
    }
    if (nroom < 1) {
        return add_room(rooms, titles, 0, 0, 0, w - 1, h - 1, "");
    }
    rooms[0] = Room {
        x0: 0,
        y0: 0,
        x1: w - 1,
        y1: h - 1
    };
    nroom;
}

grow_room_to(
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    col: int,
    row: int
): int {
    if (nroom < 1) {
        nroom = set_room_size(rooms, titles, 0, 12, 9);
    }
    r: Room = rooms[0];
    if (col < r.x0) {
        r.x0 = col;
    }
    if (row < r.y0) {
        r.y0 = row;
    }
    if (col > r.x1) {
        r.x1 = col;
    }
    if (row > r.y1) {
        r.y1 = row;
    }
    rooms[0] = r;
    nroom;
}

toggle_goal(goals: []Goal, ngoal: int, column: int, row: int): int {
    i: int = 0;
    while (i < ngoal) {
        g: Goal = goals[i];
        if (g.column == column && g.row == row) {
            goals[i] = goals[ngoal - 1];
            return ngoal - 1;
        }
        i = i + 1;
    }
    if (ngoal >= LEVEL_MAX_GOALS || !in_bounds(column, row)) {
        return ngoal;
    }
    goals[ngoal] = Goal {
        column: column,
        row: row
    };
    ngoal + 1;
}

toggle_brick(bricks: []Brick, nbrick: int, column: int, row: int): int {
    i: int = 0;
    while (i < nbrick) {
        b: Brick = bricks[i];
        if (b.column == column && b.row == row) {
            bricks[i] = bricks[nbrick - 1];
            return nbrick - 1;
        }
        i = i + 1;
    }
    if (nbrick >= LEVEL_MAX_BRICKS || !in_bounds(column, row)) {
        return nbrick;
    }
    bricks[nbrick] = Brick {
        column: column,
        row: row
    };
    nbrick + 1;
}

block_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

ramp_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer && b.ramp != 0 && b.mounted == 0) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

body_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer) {
            if (b.ramp == 0 || b.mounted != 0) {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1;
}

flat_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer && b.ramp == 0) {
            if (ramp_at_layer(blocks, n, column, row, layer) < 0) {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1;
}

has_support(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): bool {
    layer == 0 || body_at_layer(blocks, n, column, row, layer - 1) >= 0;
}

sitting_at(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): bool {
    rp: int = ramp_at_layer(blocks, n, column, row, layer);
    rp >= 0 && rp != skip;
}

settle_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): int {
    while (layer > 0 && !has_support(blocks, n, column, row, layer) && !sitting_at(blocks, n, column,
        row, layer, skip)) {
        stay: int = 0;
        if (skip >= 0 && skip < n && blocks[skip].ramp != 0) {
            if (ramp_at_layer(blocks, n, column, row, layer - 1) >= 0) {
                stay = 1;
            }
        }
        if (stay != 0) {
            return layer;
        }
        layer = layer - 1;
    }
    layer;
}

pose_mounted(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): int {
    if (sitting_at(blocks, n, column, row, layer, skip)) {
        return 1;
    }
    0;
}

ramp_dir(dc: int, dr: int): int {
    if (dc == 1 && dr == 0) {
        return 1;
    }
    if (dc == 0 - 1 && dr == 0) {
        return 2;
    }
    if (dc == 0 && dr == 1) {
        return 3;
    }
    if (dc == 0 && dr == 0 - 1) {
        return 4;
    }
    0;
}

is_mount_face(ramp: int, dc: int, dr: int): bool {
    ramp != 0 && ramp == ramp_dir(dc, dr);
}

pack_pos(column: int, row: int, layer: int, mounted: int): int {
    (column + LEVEL_PACK_BIAS) * LEVEL_PACK_COL + (row + LEVEL_PACK_BIAS) * LEVEL_PACK_ROW + layer * 2 + mounted;
}

pos_col(p: int): int {
    p / LEVEL_PACK_COL - LEVEL_PACK_BIAS;
}

pos_row(p: int): int {
    p / LEVEL_PACK_ROW - p / LEVEL_PACK_COL * LEVEL_PACK_SPAN - LEVEL_PACK_BIAS;
}

pos_layer(p: int): int {
    p / 2 - p / LEVEL_PACK_ROW * 8;
}

pos_mounted(p: int): int {
    p - p / 2 * 2;
}

delete_at(blocks: []Block, n: int, i: int): int {
    if (i < 0 || i >= n) {
        return n;
    }
    blocks[i] = blocks[n - 1];
    n - 1;
}

next_block_id(blocks: []Block, n: int): int {
    id: int = n;
    i: int = 0;
    while (i < n) {
        if (blocks[i].id >= id) {
            id = blocks[i].id + 1;
        }
        i = i + 1;
    }
    id;
}

free_layer_at(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    start: int
): int {
    layer: int = start;
    if (layer < 0) {
        layer = 0;
    }
    while (layer < LEVEL_MAX_LAYER) {
        if (body_at_layer(blocks, n, col, row, layer) < 0) {
            return layer;
        }
        layer = layer + 1;
    }
    0 - 1;
}

highest_layer_at(blocks: []Block, n: int, col: int, row: int): int {
    layer: int = LEVEL_MAX_LAYER - 1;
    while (layer >= 0) {
        if (block_at_layer(blocks, n, col, row, layer) >= 0) {
            return layer;
        }
        layer = layer - 1;
    }
    0 - 1;
}

add_block_at(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    layer: int,
    shape: int,
    ramp: int
): int {
    if (n >= LEVEL_MAX_BLOCKS) {
        return n;
    }
    if (layer < 0 || layer >= LEVEL_MAX_LAYER) {
        return n;
    }
    if (body_at_layer(blocks, n, col, row, layer) >= 0) {
        return n;
    }
    if (ramp != 0 && ramp_at_layer(blocks, n, col, row, layer) >= 0) {
        return n;
    }
    blocks[n] = Block {
        id: next_block_id(blocks, n),
        column: col,
        row: row,
        shape: shape,
        layer: layer,
        ramp: ramp,
        mounted: pose_mounted(blocks, n, col, row, layer, n)
    };
    n + 1;
}

erase_top_at(blocks: []Block, n: int, col: int, row: int): int {
    layer: int = highest_layer_at(blocks, n, col, row);
    if (layer < 0) {
        return n;
    }
    hit: int = body_at_layer(blocks, n, col, row, layer);
    if (hit < 0) {
        hit = block_at_layer(blocks, n, col, row, layer);
    }
    if (hit < 0) {
        return n;
    }
    n = delete_at(blocks, n, hit);
    apply_gravity(blocks, n);
    n;
}

cursor_layer_at(blocks: []Block, n: int, col: int, row: int): int {
    layer: int = highest_layer_at(blocks, n, col, row);
    if (layer < 0) {
        return 0;
    }
    layer;
}

toggle_ramp(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    layer: int
): int {
    if (layer < 0 || layer >= LEVEL_MAX_LAYER) {
        return n;
    }
    ai: int = block_at_layer(blocks, n, col, row, layer);
    if (ai >= 0) {
        b: Block = blocks[ai];
        if (b.ramp == 0) {
            b.ramp = 1;
            b.shape = 0;
            blocks[ai] = b;
            return n;
        }
        if (b.ramp < 4) {
            b.ramp = b.ramp + 1;
            blocks[ai] = b;
            return n;
        }
        return delete_at(blocks, n, ai);
    }
    add_block_at(blocks, n, col, row, layer, 0, 1);
}

titles_eq(a: []i8, b: []i8): bool {
    if (len(a) != len(b)) {
        return false;
    }
    i: int = 0;
    while (i < len(a)) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    true;
}

shift_rooms_insert(rooms: []Room, nroom: int, col: int) {
    i: int = 0;
    while (i < nroom) {
        r: Room = rooms[i];
        if (r.x1 >= col) {
            r.x1 = r.x1 + 1;
        }
        if (r.x0 >= col) {
            r.x0 = r.x0 + 1;
        }
        rooms[i] = r;
        i = i + 1;
    }
}

shift_goals_insert(goals: []Goal, ngoal: int, col: int) {
    i: int = 0;
    while (i < ngoal) {
        if (goals[i].column >= col) {
            goals[i].column = goals[i].column + 1;
        }
        i = i + 1;
    }
}

shift_bricks_insert(bricks: []Brick, nbrick: int, col: int) {
    i: int = 0;
    while (i < nbrick) {
        if (bricks[i].column >= col) {
            bricks[i].column = bricks[i].column + 1;
        }
        i = i + 1;
    }
}

shift_ground_insert(ground: []GroundCell, nground: int, col: int) {
    i: int = 0;
    while (i < nground) {
        if (ground[i].column >= col) {
            ground[i].column = ground[i].column + 1;
        }
        i = i + 1;
    }
}

insert_col(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    col: int
) {
    i: int = 0;
    while (i < n) {
        if (blocks[i].column >= col) {
            blocks[i].column = blocks[i].column + 1;
        }
        i = i + 1;
    }
    shift_rooms_insert(rooms, nroom, col);
    shift_goals_insert(goals, ngoal, col);
    shift_bricks_insert(bricks, nbrick, col);
    shift_ground_insert(ground, nground, col);
}

delete_col(
    blocks: []Block,
    n: int,
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    col: int,
    out_n: []int
) {
    i: int = n - 1;
    while (i >= 0) {
        if (blocks[i].column == col) {
            n = delete_at(blocks, n, i);
        } else if (blocks[i].column > col) {
            blocks[i].column = blocks[i].column - 1;
        }
        i = i - 1;
    }
    i = nroom - 1;
    while (i >= 0) {
        r: Room = rooms[i];
        if (r.x0 == r.x1 && r.x0 == col) {
            nroom = delete_room_at(rooms, titles, nroom, i);
        } else {
            if (r.x1 >= col) {
                r.x1 = r.x1 - 1;
            }
            if (r.x0 > col) {
                r.x0 = r.x0 - 1;
            }
            rooms[i] = r;
        }
        i = i - 1;
    }
    i = ngoal - 1;
    while (i >= 0) {
        if (goals[i].column == col) {
            goals[i] = goals[ngoal - 1];
            ngoal = ngoal - 1;
        } else if (goals[i].column > col) {
            goals[i].column = goals[i].column - 1;
        }
        i = i - 1;
    }
    i = nbrick - 1;
    while (i >= 0) {
        if (bricks[i].column == col) {
            bricks[i] = bricks[nbrick - 1];
            nbrick = nbrick - 1;
        } else if (bricks[i].column > col) {
            bricks[i].column = bricks[i].column - 1;
        }
        i = i - 1;
    }
    i = nground - 1;
    while (i >= 0) {
        if (ground[i].column == col) {
            ground[i] = ground[nground - 1];
            nground = nground - 1;
        } else if (ground[i].column > col) {
            ground[i].column = ground[i].column - 1;
        }
        i = i - 1;
    }
    out_n[0] = n;
    out_n[1] = nroom;
    out_n[2] = ngoal;
    out_n[3] = nbrick;
    out_n[4] = nground;
}

skip_spaces(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r')) {
        i = i + 1;
    }
    i;
}

parse_uint(src: []i8, i: int, out: []int): int {
    n: int = len(src);
    i = skip_spaces(src, i);
    if (i >= n || src[i] < '0' || src[i] > '9') {
        out[0] = 0 - 1;
        return i;
    }
    v: int = 0;
    while (i < n && src[i] >= '0' && src[i] <= '9') {
        v = v * 10 + (src[i] - '0') as int;
        i = i + 1;
    }
    out[0] = v;
    i;
}

parse_int(src: []i8, i: int, out: []int): int {
    n: int = len(src);
    i = skip_spaces(src, i);
    sign: int = 1;
    if (i < n && src[i] == '-') {
        sign = 0 - 1;
        i = i + 1;
    }
    i = parse_uint(src, i, out);
    if (out[0] < 0) {
        out[1] = 0;
        return i;
    }
    out[0] = out[0] * sign;
    out[1] = 1;
    i;
}

skip_line(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && src[i] != '\n') {
        i = i + 1;
    }
    if (i < n) {
        i = i + 1;
    }
    i;
}

put_ch(dst: []i8, i: int, c: i8): int {
    if (i >= 0 && i < len(dst)) {
        dst[i] = c;
    }
    i + 1;
}

put_str(dst: []i8, i: int, s: []i8): int {
    k: int = 0;
    while (k < len(s)) {
        i = put_ch(dst, i, s[k]);
        k = k + 1;
    }
    i;
}

put_uint(dst: []i8, i: int, n: int): int {
    if (n >= 10) {
        i = put_uint(dst, i, n / 10);
    }
    put_ch(dst, i, '0' + (n % 10) trunc i8);
}

put_int(dst: []i8, i: int, n: int): int {
    if (n < 0) {
        i = put_ch(dst, i, '-');
        n = 0 - n;
    }
    put_uint(dst, i, n);
}

slurp_path(path: []i8): []i8@new {
    fd: int = open_path(path, 0, 0);
    if (fd < 0) {
        return new i8[0](0i8);
    }
    cap: int = 65536;
    buf: []i8 = new i8[cap](0i8);
    n: int = 0;
    more: int = 1;
    while (more != 0) {
        if (n + 4096 >= cap) {
            cap = cap * 2;
            tmp: []i8 = new i8[cap](0i8);
            memcpy(tmp, 0, buf, 0, n);
            buf = tmp;
        }
        r: int = read(fd, buf, n, cap - n);
        if (r <= 0) {
            more = 0;
        } else {
            n = n + r;
        }
    }
    close(fd);
    src: []i8 = new i8[n](0i8);
    memcpy(src, 0, buf, 0, n);
    src;
}

take_title(src: []i8, i: int): []i8@new {
    n: int = len(src);
    i = skip_spaces(src, i);
    ts: int = i;
    te: int = i;
    while (te < n && src[te] != '\n' && src[te] != '\r') {
        te = te + 1;
    }
    while (te > ts && (src[te - 1] == ' ' || src[te - 1] == '\t')) {
        te = te - 1;
    }
    tn: int = te - ts;
    tbuf: []i8 = new i8[tn](0i8);
    if (tn > 0) {
        memcpy(tbuf, 0, src, ts, tn);
    }
    tbuf;
}

word_at(src: []i8, i: int, w: []i8): bool {
    n: int = len(src);
    wn: int = len(w);
    if (i + wn > n) {
        return false;
    }
    k: int = 0;
    while (k < wn) {
        if (src[i + k] != w[k]) {
            return false;
        }
        k = k + 1;
    }
    if (i + wn < n) {
        c: i8 = src[i + wn];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
            return false;
        }
    }
    true;
}

take_word(src: []i8, i: int): []i8@new {
    n: int = len(src);
    i = skip_spaces(src, i);
    ts: int = i;
    while (i < n && src[i] != ' ' && src[i] != '\t' && src[i] != '\n' && src[i] != '\r') {
        i = i + 1;
    }
    tn: int = i - ts;
    tbuf: []i8 = new i8[tn](0i8);
    if (tn > 0) {
        memcpy(tbuf, 0, src, ts, tn);
    }
    tbuf;
}

skip_word(src: []i8, i: int): int {
    n: int = len(src);
    i = skip_spaces(src, i);
    while (i < n && src[i] != ' ' && src[i] != '\t' && src[i] != '\n' && src[i] != '\r') {
        i = i + 1;
    }
    i;
}

parent_dir(path: []i8): []i8@new {
    last: int = 0 - 1;
    i: int = 0;
    while (i < len(path)) {
        if (path[i] == '/') {
            last = i;
        }
        i = i + 1;
    }
    if (last < 0) {
        out: []i8 = new i8[1](0i8);
        out[0] = '.';
        return out;
    }
    out2: []i8 = new i8[last](0i8);
    if (last > 0) {
        memcpy(out2, 0, path, 0, last);
    }
    out2;
}

join_level_path(world: []i8, name: []i8): []i8@new {
    parent: []i8 = parent_dir(world);
    n: int = len(parent) + 8 + len(name) + 4;
    out: []i8 = new i8[n](0i8);
    i: int = put_str(out, 0, parent);
    i = put_str(out, i, "/levels/");
    i = put_str(out, i, name);
    i = put_str(out, i, ".txt");
    out;
}

room_size_w(r: Room): int {
    r.x1 - r.x0 + 1;
}

room_size_h(r: Room): int {
    r.y1 - r.y0 + 1;
}

rooms_overlap(a: Room, b: Room): bool {
    !(a.x1 < b.x0 || b.x1 < a.x0 || a.y1 < b.y0 || b.y1 < a.y0);
}

room_overlaps_other(rooms: []Room, nroom: int, skip: int, want: Room): int {
    i: int = 0;
    while (i < nroom) {
        if (i != skip && rooms_overlap(rooms[i], want)) {
            return 1;
        }
        i = i + 1;
    }
    0;
}

separate_legacy_rooms(rooms: []Room, nroom: int): int {
    i: int = 0;
    while (i < nroom) {
        r: Room = rooms[i];
        j: int = 0;
        while (j < i) {
            o: Room = rooms[j];
            if (rooms_overlap(r, o)) {
                if (r.x0 >= o.x0 && r.x0 <= o.x1 && r.x1 > o.x1) {
                    r.x0 = o.x1 + 1;
                } else if (r.y0 >= o.y0 && r.y0 <= o.y1 && r.y1 > o.y1) {
                    r.y0 = o.y1 + 1;
                } else if (r.x1 >= o.x0 && r.x1 <= o.x1 && r.x0 < o.x0) {
                    r.x1 = o.x0 - 1;
                } else if (r.y1 >= o.y0 && r.y1 <= o.y1 && r.y0 < o.y0) {
                    r.y1 = o.y0 - 1;
                } else {
                    return 0 - 1;
                }
            }
            j = j + 1;
        }
        if (r.x0 > r.x1 || r.y0 > r.y1) {
            return 0 - 1;
        }
        rooms[i] = r;
        i = i + 1;
    }
    0;
}

place_aabb_w(w: int, h: int, rot: int): int {
    if (rot == 1 || rot == 3) {
        return h;
    }
    w;
}

place_aabb_h(w: int, h: int, rot: int): int {
    if (rot == 1 || rot == 3) {
        return w;
    }
    h;
}

xform_local(x: int, y: int, w: int, h: int, rot: int, out: []int) {
    if (rot == 1) {
        out[0] = y;
        out[1] = w - 1 - x;
    } else if (rot == 2) {
        out[0] = w - 1 - x;
        out[1] = h - 1 - y;
    } else if (rot == 3) {
        out[0] = h - 1 - y;
        out[1] = x;
    } else {
        out[0] = x;
        out[1] = y;
    }
}

xform_ramp(dir: int, rot: int): int {
    r: int = rot % 4;
    if (r < 0) {
        r = r + 4;
    }
    d: int = dir;
    k: int = 0;
    while (k < r) {
        if (d == 1) {
            d = 3;
        } else if (d == 3) {
            d = 2;
        } else if (d == 2) {
            d = 4;
        } else if (d == 4) {
            d = 1;
        }
        k = k + 1;
    }
    d;
}

transform_room_rect(src: Room, dc: int, dr: int, rot: int): Room {
    w: int = room_size_w(src);
    h: int = room_size_h(src);
    Room {
        x0: src.x0 + dc,
        y0: src.y0 + dr,
        x1: src.x0 + dc + place_aabb_w(w, h, rot) - 1,
        y1: src.y0 + dr + place_aabb_h(w, h, rot) - 1
    };
}

transform_room_contents(
    blocks: []Block,
    n: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    rooms: []Room,
    sel: int,
    dc: int,
    dr: int,
    rot: int,
    start: []int,
    xy: []int
) {
    src: Room = rooms[sel];
    w: int = room_size_w(src);
    h: int = room_size_h(src);
    dst: Room = transform_room_rect(src, dc, dr, rot);
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (room_contains(src, b.column, b.row)) {
            xform_local(b.column - src.x0, b.row - src.y0, w, h, rot, xy);
            b.column = dst.x0 + xy[0];
            b.row = dst.y0 + xy[1];
            if (b.ramp != 0) {
                b.ramp = xform_ramp(b.ramp, rot);
            }
            blocks[i] = b;
        }
        i = i + 1;
    }
    i = 0;
    while (i < ngoal) {
        if (room_contains(src, goals[i].column, goals[i].row)) {
            xform_local(goals[i].column - src.x0, goals[i].row - src.y0, w, h, rot, xy);
            goals[i].column = dst.x0 + xy[0];
            goals[i].row = dst.y0 + xy[1];
        }
        i = i + 1;
    }
    i = 0;
    while (i < nbrick) {
        if (room_contains(src, bricks[i].column, bricks[i].row)) {
            xform_local(bricks[i].column - src.x0, bricks[i].row - src.y0, w, h, rot, xy);
            bricks[i].column = dst.x0 + xy[0];
            bricks[i].row = dst.y0 + xy[1];
        }
        i = i + 1;
    }
    i = 0;
    while (i < nground) {
        if (room_contains(src, ground[i].column, ground[i].row)) {
            xform_local(ground[i].column - src.x0, ground[i].row - src.y0, w, h, rot, xy);
            ground[i].column = dst.x0 + xy[0];
            ground[i].row = dst.y0 + xy[1];
        }
        i = i + 1;
    }
    if (room_contains(src, start[0], start[1])) {
        xform_local(start[0] - src.x0, start[1] - src.y0, w, h, rot, xy);
        start[0] = dst.x0 + xy[0];
        start[1] = dst.y0 + xy[1];
    }
    rooms[sel] = dst;
}

clear_room_destination(
    blocks: []Block,
    n: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    src: Room,
    dst: Room,
    out: []int
) {
    i: int = n - 1;
    while (i >= 0) {
        if (room_contains(dst, blocks[i].column, blocks[i].row) &&
            !room_contains(src, blocks[i].column, blocks[i].row)) {
            blocks[i] = blocks[n - 1];
            n = n - 1;
        }
        i = i - 1;
    }
    i = ngoal - 1;
    while (i >= 0) {
        if (room_contains(dst, goals[i].column, goals[i].row) &&
            !room_contains(src, goals[i].column, goals[i].row)) {
            goals[i] = goals[ngoal - 1];
            ngoal = ngoal - 1;
        }
        i = i - 1;
    }
    i = nbrick - 1;
    while (i >= 0) {
        if (room_contains(dst, bricks[i].column, bricks[i].row) &&
            !room_contains(src, bricks[i].column, bricks[i].row)) {
            bricks[i] = bricks[nbrick - 1];
            nbrick = nbrick - 1;
        }
        i = i - 1;
    }
    i = nground - 1;
    while (i >= 0) {
        if (room_contains(dst, ground[i].column, ground[i].row) &&
            !room_contains(src, ground[i].column, ground[i].row)) {
            ground[i] = ground[nground - 1];
            nground = nground - 1;
        }
        i = i - 1;
    }
    out[0] = n;
    out[1] = ngoal;
    out[2] = nbrick;
    out[3] = nground;
}

sort_checks(checks: []int, titles: [][]i8, nc: int) {
    a: int = 0;
    while (a < nc) {
        b: int = a + 1;
        while (b < nc) {
            if (checks[b] < checks[a]) {
                tc: int = checks[a];
                checks[a] = checks[b];
                checks[b] = tc;
                tt: []i8 = titles[a];
                titles[a] = titles[b];
                titles[b] = tt;
            }
            b = b + 1;
        }
        a = a + 1;
    }
}

migrate_old_checks(
    checks: []int,
    titles: [][]i8@room_titles,
    nc: int,
    rooms: []Room,
    room_titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int
) {
    sort_checks(checks, titles, nc);
    nr: int = nroom[0];
    ng: int = ngoal[0];
    i: int = 0;
    while (i + 1 < nc) {
        left: int = checks[i];
        right: int = checks[i + 1];
        title: []i8 = titles[i];
        nr = add_room(rooms, room_titles, nr, left, 0, right, 8, title);
        if (!is_goal(goals, ng, right, 4)) {
            ng = toggle_goal(goals, ng, right, 4);
        }
        i = i + 1;
    }
    nroom[0] = nr;
    ngoal[0] = ng;
}

parse_level_src(
    src: []i8,
    blocks: []Block,
    rooms: []Room,
    titles: [][]i8@new,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    ground: []GroundCell,
    nground: []int,
    start: []int
): int {
    n: int = len(src);
    nb: int = 0;
    nr: int = 0;
    ng: int = 0;
    nw: int = 0;
    nf: int = 0;
    nc: int = 0;
    old_c: []int = new int[64](0);
    old_t: [][]i8 = new []i8[64](new i8[0](0i8));
    i: int = 0;
    val: []int = new int[2](0);
    start[0] = 0;
    start[1] = 0;
    file_title: []i8 = new i8[0](0i8);
    have_size: int = 0;
    size_w: int = 12;
    size_h: int = 9;
    while (i < n) {
        i = skip_spaces(src, i);
        if (i >= n) {
            i = n;
        } else if (src[i] == '\n') {
            i = i + 1;
        } else if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (word_at(src, i, "title")) {
            i = i + 5;
            file_title = take_title(src, i);
            i = skip_line(src, i);
        } else if (word_at(src, i, "size")) {
            i = i + 4;
            i = parse_int(src, i, val);
            sw: int = val[0];
            okw: int = val[1];
            i = parse_int(src, i, val);
            if (okw == 0 || val[1] == 0 || sw < 1 || val[0] < 1) {
                return 0 - 1;
            }
            size_w = sw;
            size_h = val[0];
            have_size = 1;
            i = skip_line(src, i);
        } else if (word_at(src, i, "room")) {
            i = i + 4;
            i = parse_int(src, i, val);
            x0: int = val[0];
            ok0: int = val[1];
            i = parse_int(src, i, val);
            y0: int = val[0];
            ok1: int = val[1];
            i = parse_int(src, i, val);
            x1: int = val[0];
            ok2: int = val[1];
            i = parse_int(src, i, val);
            y1: int = val[0];
            if (ok0 == 0 || ok1 == 0 || ok2 == 0 || val[1] == 0 || !in_bounds(x0, y0) || !in_bounds(x1, y1)) {
                return 0 - 1;
            }
            nr = add_room(rooms, titles, nr, x0, y0, x1, y1, take_title(src, i));
            i = skip_line(src, i);
        } else {
            cmd: i8 = src[i];
            i = i + 1;
            if (cmd == 'c') {
                i = parse_int(src, i, val);
                if (val[1] == 0 || !in_bounds(val[0], 0)) {
                    return 0 - 1;
                }
                if (nc < 64) {
                    old_c[nc] = val[0];
                    old_t[nc] = take_title(src, i);
                    nc = nc + 1;
                }
            } else if (cmd == 'f') {
                i = parse_int(src, i, val);
                colf: int = val[0];
                okf: int = val[1];
                i = parse_int(src, i, val);
                rowf: int = val[0];
                if (okf == 0 || val[1] == 0 || !in_bounds(colf, rowf)) {
                    return 0 - 1;
                }
                kind: []int = new int[2](0);
                i = parse_ground_kind(src, i, kind);
                if (kind[0] < 0) {
                    return 0 - 1;
                }
                nf = put_ground_cell(ground, nf, colf, rowf, kind[0], kind[1], 0);
            } else if (cmd == 'g' || cmd == 'w' || cmd == 'p') {
                i = parse_int(src, i, val);
                colg: int = val[0];
                okg: int = val[1];
                i = parse_int(src, i, val);
                rowg: int = val[0];
                if (okg == 0 || val[1] == 0 || !in_bounds(colg, rowg)) {
                    return 0 - 1;
                }
                if (cmd == 'p') {
                    start[0] = colg;
                    start[1] = rowg;
                } else if (cmd == 'g') {
                    if (!is_goal(goals, ng, colg, rowg)) {
                        ng = toggle_goal(goals, ng, colg, rowg);
                    }
                } else {
                    if (!is_brick(bricks, nw, colg, rowg)) {
                        nw = toggle_brick(bricks, nw, colg, rowg);
                    }
                }
            } else if (cmd == 'b' || cmd == 's' || cmd == 'r') {
                i = parse_int(src, i, val);
                col: int = val[0];
                okc: int = val[1];
                i = parse_int(src, i, val);
                row: int = val[0];
                if (okc == 0 || val[1] == 0) {
                    return 0 - 1;
                }
                shape: int = 0;
                ramp: int = 0;
                layer: int = 0;
                if (cmd == 's') {
                    i = parse_uint(src, i, val);
                    shape = val[0];
                } else if (cmd == 'r') {
                    i = parse_uint(src, i, val);
                    ramp = val[0];
                    if (ramp < 1 || ramp > 4) {
                        return 0 - 1;
                    }
                }
                i = skip_spaces(src, i);
                if (i < n && src[i] >= '0' && src[i] <= '9') {
                    i = parse_uint(src, i, val);
                    layer = val[0];
                }
                mounted: int = 0;
                i = skip_spaces(src, i);
                if (i < n && src[i] >= '0' && src[i] <= '9') {
                    i = parse_uint(src, i, val);
                    mounted = val[0];
                }
                if (!in_bounds(col, row) || layer < 0 || layer >= LEVEL_MAX_LAYER) {
                    return 0 - 1;
                }
                if (nb < len(blocks)) {
                    blocks[nb] = Block {
                        id: nb,
                        column: col,
                        row: row,
                        shape: shape,
                        layer: layer,
                        ramp: ramp,
                        mounted: mounted
                    };
                    nb = nb + 1;
                }
            } else {
                return 0 - 1;
            }
            i = skip_line(src, i);
        }
    }
    nroom[0] = nr;
    ngoal[0] = ng;
    nbrick[0] = nw;
    nground[0] = nf;
    if (nr == 0 && nc > 0) {
        migrate_old_checks(old_c, old_t, nc, rooms, titles, nroom, goals, ngoal);
    } else if (nr == 0 && have_size != 0) {
        nroom[0] = add_room(rooms, titles, 0, 0, 0, size_w - 1, size_h - 1, file_title);
    } else if (nr > 0 && len(file_title) > 0 && len(titles[0]) == 0) {
        titles[0] = file_title;
    }
    nb;
}

save_level(
    path: []i8,
    blocks: []Block,
    n: int,
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    pc: int,
    pr: int
): int {
    cap: int = 524288;
    dst: []i8 = new i8[cap](0i8);
    i: int = 0;
    i = put_str(dst, i, "# L8 block-game level\n");
    i = put_str(dst, i, "# title Name\n");
    i = put_str(dst, i, "# size <w> <h>\n");
    i = put_str(dst, i, "# g <column> <row>\n");
    i = put_str(dst, i, "# w <column> <row>\n");
    i = put_str(dst, i, "# f <column> <row> <dirt|grass> [stone]\n");
    i = put_str(dst, i, "# p <column> <row>\n");
    i = put_str(dst, i, """
# b <column> <row> [layer]
# s <column> <row> <sides> [layer]
# r <column> <row> <dir> [layer]

""");
    ox: int = 0;
    oy: int = 0;
    sw: int = 12;
    sh: int = 9;
    if (nroom > 0) {
        r0: Room = rooms[0];
        ox = r0.x0;
        oy = r0.y0;
        sw = room_size_w(r0);
        sh = room_size_h(r0);
        if (len(titles[0]) > 0) {
            i = put_str(dst, i, "title ");
            i = put_str(dst, i, titles[0]);
            i = put_ch(dst, i, '\n');
        }
    }
    i = put_str(dst, i, "size ");
    i = put_int(dst, i, sw);
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, sh);
    i = put_ch(dst, i, '\n');
    k: int = 0;
    while (k < ngoal) {
        i = put_ch(dst, i, 'g');
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, goals[k].column - ox);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, goals[k].row - oy);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < nbrick) {
        i = put_ch(dst, i, 'w');
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, bricks[k].column - ox);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, bricks[k].row - oy);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < nground) {
        f: GroundCell = ground[k];
        i = put_ch(dst, i, 'f');
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, f.column - ox);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, f.row - oy);
        i = put_ch(dst, i, ' ');
        i = put_ground_kind(dst, i, f);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    i = put_ch(dst, i, 'p');
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, pc - ox);
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, pr - oy);
    i = put_ch(dst, i, '\n');
    i = put_ch(dst, i, '\n');
    k = 0;
    while (k < n) {
        b: Block = blocks[k];
        if (b.ramp != 0) {
            i = put_ch(dst, i, 'r');
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.column - ox);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row - oy);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.ramp);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        } else if (b.shape != 0) {
            i = put_ch(dst, i, 's');
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.column - ox);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row - oy);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.shape);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        } else {
            i = put_ch(dst, i, 'b');
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.column - ox);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row - oy);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        }
        k = k + 1;
    }
    if (i > cap) {
        return 0 - 1;
    }
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    if (fd < 0) {
        return 0 - 1;
    }
    w: int = write(fd, dst, i);
    close(fd);
    if (w != i) {
        return 0 - 1;
    }
    0;
}

copy_blocks(
    dst: []Block,
    doff: int,
    src: []Block,
    soff: int,
    n: int
) {
    i: int = 0;
    while (i < n) {
        dst[doff + i] = src[soff + i];
        i = i + 1;
    }
}

copy_ground(dst: []GroundCell, src: []GroundCell, n: int) {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
}

copy_brick_cells(dst: []Brick, src: []Brick, n: int) {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
}

will_climb(
    blocks: []Block,
    n: int,
    bi: int,
    dc: int,
    dr: int
): int {
    b: Block = blocks[bi];
    home: int = ramp_at_layer(blocks, n, b.column, b.row, b.layer);
    if (home == bi) {
        home = 0 - 1;
    }
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr)) {
        if (flat_at_layer(blocks, n, b.column + dc, b.row + dr, b.layer) >= 0) {
            return 1;
        }
    }
    0;
}

mark_push_group(
    blocks: []Block,
    n: int,
    hit: int,
    rooms: []Room,
    nroom: int,
    marks: []int
) {
    hb: Block = blocks[hit];
    i: int = 0;
    if (hb.shape != 0 && room_at(rooms, nroom, hb.column, hb.row) >= 0) {
        while (i < n) {
            s: Block = blocks[i];
            if (s.shape == hb.shape && same_room(rooms, nroom, s.column, s.row, hb.column, hb.row)) {
                marks[i] = 1;
            }
            i = i + 1;
        }
    } else {
        marks[hit] = 1;
    }
    grown: int = 1;
    while (grown != 0) {
        grown = 0;
        i = 0;
        while (i < n) {
            if (marks[i] != 0) {
                b: Block = blocks[i];
                above: int = body_at_layer(blocks, n, b.column, b.row, b.layer + 1);
                if (above >= 0 && marks[above] == 0) {
                    marks[above] = 1;
                    grown = 1;
                }
            }
            i = i + 1;
        }
    }
}

lowest_marked(
    blocks: []Block,
    n: int,
    marks: []int,
    column: int,
    row: int
): int {
    best: int = 0 - 1;
    best_l: int = LEVEL_MAX_LAYER;
    i: int = 0;
    while (i < n) {
        if (marks[i] != 0) {
            b: Block = blocks[i];
            if (b.column == column && b.row == row && b.layer < best_l) {
                best = i;
                best_l = b.layer;
            }
        }
        i = i + 1;
    }
    best;
}

can_move_marked(
    blocks: []Block,
    n: int,
    bricks: []Brick,
    nbrick: int,
    marks: []int,
    dc: int,
    dr: int
): bool {
    i: int = 0;
    while (i < n) {
        if (marks[i] != 0) {
            b: Block = blocks[i];
            tc: int = b.column + dc;
            tr: int = b.row + dr;
            if (!in_bounds(tc, tr) || is_brick(bricks, nbrick, tc, tr)) {
                return false;
            }
            lo: int = lowest_marked(blocks, n, marks, b.column, b.row);
            climb: int = 0;
            if (lo >= 0) {
                climb = will_climb(blocks, n, lo, dc, dr);
            }
            tl: int = b.layer + climb;
            if (tl < 0 || tl >= LEVEL_MAX_LAYER) {
                return false;
            }
            occ: int = body_at_layer(blocks, n, tc, tr, tl);
            if (occ >= 0 && marks[occ] == 0) {
                return false;
            }
            rp: int = ramp_at_layer(blocks, n, tc, tr, tl);
            if (rp >= 0 && marks[rp] == 0 && !is_mount_face(blocks[rp].ramp, dc, dr)) {
                return false;
            }
        }
        i = i + 1;
    }
    true;
}

slide_marked(
    blocks: []Block,
    n: int,
    marks: []int,
    dc: int,
    dr: int
) {
    region {
        climbs: []int = new int[n](0);
        i: int = 0;
        while (i < n) {
            if (marks[i] != 0) {
                b: Block = blocks[i];
                lo: int = lowest_marked(blocks, n, marks, b.column, b.row);
                if (lo >= 0) {
                    climbs[i] = will_climb(blocks, n, lo, dc, dr);
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            if (marks[i] != 0) {
                b2: Block = blocks[i];
                b2.column = b2.column + dc;
                b2.row = b2.row + dr;
                b2.layer = b2.layer + climbs[i];
                blocks[i] = b2;
            }
            i = i + 1;
        }
    }
}

apply_gravity(blocks: []Block, n: int) {
    moved: int = 1;
    while (moved != 0) {
        moved = 0;
        i: int = 0;
        while (i < n) {
            b: Block = blocks[i];
            nl: int = settle_layer(blocks, n, b.column, b.row, b.layer, i);
            nm: int = pose_mounted(blocks, n, b.column, b.row, nl, i);
            if (nl != b.layer || nm != b.mounted) {
                b.layer = nl;
                b.mounted = nm;
                blocks[i] = b;
                moved = 1;
            }
            i = i + 1;
        }
    }
}

apply_gravity_marked(blocks: []Block, n: int, marks: []int) {
    moved: int = 1;
    while (moved != 0) {
        moved = 0;
        i: int = 0;
        while (i < n) {
            if (marks[i] != 0) {
                b: Block = blocks[i];
                nl: int = settle_layer(blocks, n, b.column, b.row, b.layer, i);
                nm: int = pose_mounted(blocks, n, b.column, b.row, nl, i);
                if (nl != b.layer || nm != b.mounted) {
                    b.layer = nl;
                    b.mounted = nm;
                    blocks[i] = b;
                    moved = 1;
                }
            }
            i = i + 1;
        }
    }
}

try_push(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    hit: int,
    dc: int,
    dr: int
): bool {
    ok: bool = false;
    region {
        marks: []int = new int[n](0);
        mark_push_group(blocks, n, hit, rooms, nroom, marks);
        if (can_move_marked(blocks, n, bricks, nbrick, marks, dc, dr)) {
            slide_marked(blocks, n, marks, dc, dr);
            apply_gravity_marked(blocks, n, marks);
            ok = true;
        }
    }
    ok;
}

finish_move(
    blocks: []Block,
    n: int,
    pc: int,
    pr: int,
    ph: int
): int {
    ph = settle_layer(blocks, n, pc, pr, ph, 0 - 1);
    if (body_at_layer(blocks, n, pc, pr, ph) >= 0) {
        return 0 - 1;
    }
    pack_pos(pc, pr, ph, pose_mounted(blocks, n, pc, pr, ph, 0 - 1));
}

enter_at(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    tc: int,
    tr: int,
    ph: int,
    dc: int,
    dr: int
): int {
    if (is_brick(bricks, nbrick, tc, tr)) {
        return 0 - 1;
    }
    dest_body: int = body_at_layer(blocks, n, tc, tr, ph);
    dest_ramp: int = ramp_at_layer(blocks, n, tc, tr, ph);
    if (dest_ramp >= 0 && dest_body < 0 && is_mount_face(blocks[dest_ramp].ramp, dc, dr)) {
        return finish_move(blocks, n, tc, tr, ph);
    }
    hit: int = dest_body;
    if (hit >= 0 && dest_ramp >= 0 && !is_mount_face(blocks[dest_ramp].ramp, dc, dr)) {
        return 0 - 1;
    }
    if (hit < 0) {
        hit = dest_ramp;
    }
    if (hit >= 0) {
        if (!try_push(blocks, n, rooms, nroom, bricks, nbrick, hit, dc, dr)) {
            return 0 - 1;
        }
    }
    finish_move(blocks, n, tc, tr, ph);
}

move_player(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    pc: int,
    pr: int,
    ph: int,
    dc: int,
    dr: int
): int {
    stay: int = pack_pos(pc, pr, ph, pose_mounted(blocks, n, pc, pr, ph, 0 - 1));
    tc: int = pc + dc;
    tr: int = pr + dr;
    if (!in_bounds(tc, tr) || is_brick(bricks, nbrick, tc, tr)) {
        return stay;
    }
    dest_flat: int = flat_at_layer(blocks, n, tc, tr, ph);
    home: int = ramp_at_layer(blocks, n, pc, pr, ph);
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr) && dest_flat >= 0) {
        if (ph + 1 < LEVEL_MAX_LAYER) {
            landed: int = enter_at(blocks, n, rooms, nroom, bricks, nbrick, tc, tr, ph + 1, dc, dr);
            if (landed >= 0) {
                return landed;
            }
        }
        return stay;
    }
    landed2: int = enter_at(blocks, n, rooms, nroom, bricks, nbrick, tc, tr, ph, dc, dr);
    if (landed2 < 0) {
        return stay;
    }
    landed2;
}

looks_like_grid(src: []i8): bool {
    i: int = 0;
    n: int = len(src);
    while (i < n) {
        if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (src[i] == '\n' || src[i] == '\r' || src[i] == ' ' || src[i] == '\t') {
            i = i + 1;
        } else {
            return src[i] == '=';
        }
    }
    false;
}

grid_shape(ch: i8): int {
    if (ch == '3') {
        return 3;
    }
    if (ch == '4') {
        return 4;
    }
    if (ch == '5') {
        return 5;
    }
    if (ch == '6') {
        return 6;
    }
    if (ch == '7' || ch == 'F' || ch == '*') {
        return 15;
    }
    0;
}

add_grid_block(
    blocks: []Block,
    nb: int,
    col: int,
    row: int,
    shape: int
): int {
    add_grid_piece(blocks, nb, col, row, shape, 0, 0);
}

add_grid_piece(
    blocks: []Block,
    nb: int,
    col: int,
    row: int,
    shape: int,
    layer: int,
    ramp: int
): int {
    if (nb >= len(blocks) || !in_bounds(col, row)) {
        return nb;
    }
    blocks[nb] = Block {
        id: nb,
        column: col,
        row: row,
        shape: shape,
        layer: layer,
        ramp: ramp,
        mounted: 0
    };
    nb + 1;
}

grid_ramp(ch: i8): int {
    if (ch == '>') {
        return 1;
    }
    if (ch == '<') {
        return 2;
    }
    if (ch == 'v' || ch == 'V') {
        return 3;
    }
    if (ch == '^') {
        return 4;
    }
    0;
}

copy_title(src: []i8, a: int, b: int): []i8@new {
    while (a < b && src[a] == ' ') {
        a = a + 1;
    }
    while (b > a && (src[b - 1] == ' ' || src[b - 1] == '\t')) {
        b = b - 1;
    }
    tn: int = b - a;
    if (tn < 0) {
        tn = 0;
    }
    tbuf: []i8 = new i8[tn](0i8);
    if (tn > 0) {
        memcpy(tbuf, 0, src, a, tn);
    }
    tbuf;
}

load_grid_src(
    src: []i8,
    blocks: []Block,
    rooms: []Room,
    titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    start: []int
): int {
    n: int = len(src);
    nb: int = 0;
    nr: int = 0;
    ng: int = 0;
    col0: int = 0;
    title: []i8 = new i8[0](0i8);
    start[0] = 0;
    start[1] = 0;
    have_start: int = 0;
    i: int = 0;
    while (i < n) {
        if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (src[i] == '\n' || src[i] == '\r') {
            i = i + 1;
        } else if (src[i] == '=') {
            i = i + 1;
            ts: int = i;
            while (i < n && src[i] != '\n' && src[i] != '\r') {
                i = i + 1;
            }
            title = copy_title(src, ts, i);
            rows: [][]i8 = new []i8[9](new i8[0](0i8));
            nrow: int = 0;
            width: int = 0;
            if (i < n && src[i] == '\r') {
                i = i + 1;
            }
            if (i < n && src[i] == '\n') {
                i = i + 1;
            }
            more: int = 1;
            while (more != 0 && i < n) {
                if (src[i] == '=') {
                    more = 0;
                } else if (src[i] == '\n' || src[i] == '\r') {
                    more = 0;
                } else {
                    rs: int = i;
                    while (i < n && src[i] != '\n' && src[i] != '\r') {
                        i = i + 1;
                    }
                    rl: int = i - rs;
                    if (nrow < 9) {
                        row: []i8 = new i8[rl](0i8);
                        memcpy(row, 0, src, rs, rl);
                        rows[nrow] = row;
                        if (rl > width) {
                            width = rl;
                        }
                        nrow = nrow + 1;
                    }
                    if (i < n && src[i] == '\r') {
                        i = i + 1;
                    }
                    if (i < n && src[i] == '\n') {
                        i = i + 1;
                    }
                }
            }
            if (width < 1 || nrow < 1) {
                return 0 - 1;
            }
            c: int = 0;
            while (c < width) {
                wc: int = col0 + c;
                r: int = 0;
                while (r < nrow) {
                    row2: []i8 = rows[r];
                    ch: i8 = '.';
                    if (c < len(row2)) {
                        ch = row2[c];
                    }
                    if (ch == '@') {
                        start[0] = wc;
                        start[1] = r;
                        have_start = 1;
                    } else if (ch == '#') {
                        nb = add_grid_block(blocks, nb, wc, r, 0);
                    } else if (ch != '|') {
                        rp: int = grid_ramp(ch);
                        if (rp != 0) {
                            nb = add_grid_piece(blocks, nb, wc, r, 0, 0, rp);
                        } else {
                            sh: int = grid_shape(ch);
                            if (sh != 0) {
                                nb = add_grid_block(blocks, nb, wc, r, sh);
                            }
                        }
                    }
                    r = r + 1;
                }
                c = c + 1;
            }
            x1: int = col0 + width - 1;
            y1: int = nrow - 1;
            nr = add_room(rooms, titles, nr, col0, 0, x1, y1, title);
            mid: int = y1 / 2;
            if (!is_goal(goals, ng, x1, mid)) {
                ng = toggle_goal(goals, ng, x1, mid);
            }
            col0 = col0 + width;
        } else {
            return 0 - 1;
        }
    }
    if (have_start == 0 && nr > 0) {
        start[0] = rooms[0].x0;
        start[1] = rooms[0].y0;
    }
    nroom[0] = nr;
    ngoal[0] = ng;
    nbrick[0] = 0;
    if (len(bricks) < 0) {
        nbrick[0] = 0;
    }
    nb;
}

looks_like_world(src: []i8): bool {
    i: int = 0;
    n: int = len(src);
    while (i < n) {
        i = skip_spaces(src, i);
        if (i >= n) {
            return false;
        }
        if (src[i] == '\n' || src[i] == '\r') {
            i = i + 1;
        } else if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (word_at(src, i, "world") || word_at(src, i, "place") ||
            word_at(src, i, "level")) {
            return true;
        } else if (src[i] == '=') {
            return false;
        } else {
            i = skip_line(src, i);
        }
    }
    false;
}

world_has_places(src: []i8): int {
    i: int = 0;
    while (i < len(src)) {
        i = skip_spaces(src, i);
        if (i < len(src) && src[i] != '#') {
            if (word_at(src, i, "place")) {
                return 1;
            }
        }
        i = skip_line(src, i);
    }
    0;
}

name_listed(names: [][]i8, n: int, s: []i8): int {
    i: int = 0;
    while (i < n) {
        if (titles_eq(names[i], s)) {
            return 1;
        }
        i = i + 1;
    }
    0;
}

valid_level_name(name: []i8): int {
    if (len(name) < 1 || len(name) > 40) {
        return 0;
    }
    i: int = 0;
    while (i < len(name)) {
        c: i8 = name[i];
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')) {
            return 0;
        }
        i = i + 1;
    }
    1;
}

apply_solved(
    names: [][]i8,
    nplace: int,
    dones: [][]i8,
    ndone: int,
    solved: []int,
    nroom: int
) {
    i: int = 0;
    while (i < nroom && i < len(solved)) {
        solved[i] = 0;
        if (i < nplace && name_listed(dones, ndone, names[i]) != 0) {
            solved[i] = 1;
        }
        i = i + 1;
    }
}

load_world(
    path: []i8,
    places: []Placement,
    names: [][]i8@new,
    nplace: []int,
    rooms: []Room,
    titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    start: []int,
    dones: [][]i8@new,
    ndone: []int,
    blocks: []Block,
    nblock: []int,
    bricks: []Brick,
    nbrick: []int,
    ground: []GroundCell,
    nground: []int
): int {
    src: []i8 = slurp_path(path);
    n: int = 0;
    nd: int = 0;
    nb: int = 0;
    nw: int = 0;
    nf: int = 0;
    nr: int = 0;
    ng: int = 0;
    i: int = 0;
    val: []int = new int[2](0);
    start[0] = 0;
    start[1] = 0;
    ndone[0] = 0;
    nroom[0] = 0;
    ngoal[0] = 0;
    nblock[0] = 0;
    nbrick[0] = 0;
    nground[0] = 0;
    while (i < len(src)) {
        i = skip_spaces(src, i);
        if (i >= len(src)) {
            i = len(src);
        } else if (src[i] == '\n' || src[i] == '\r') {
            i = i + 1;
        } else if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (word_at(src, i, "world")) {
            i = skip_line(src, i);
        } else if (word_at(src, i, "level")) {
            i = i + 5;
            slug: []i8 = take_word(src, i);
            i = skip_word(src, i);
            i = parse_int(src, i, val);
            x0: int = val[0];
            ok0: int = val[1];
            i = parse_int(src, i, val);
            y0: int = val[0];
            ok1: int = val[1];
            i = parse_int(src, i, val);
            x1: int = val[0];
            ok2: int = val[1];
            i = parse_int(src, i, val);
            y1: int = val[0];
            want: Room = norm_room(x0, y0, x1, y1);
            if (ok0 == 0 || ok1 == 0 || ok2 == 0 || val[1] == 0 || len(slug) == 0 ||
                !in_bounds(x0, y0) || !in_bounds(x1, y1) ||
                name_listed(names, nr, slug) != 0 || room_overlaps_other(rooms, nr, 0 - 1, want) != 0) {
                return 0 - 1;
            }
            if (nr < LEVEL_MAX_ROOMS) {
                names[nr] = slug;
                nr = add_room(rooms, titles, nr, want.x0, want.y0, want.x1, want.y1,
                    take_title(src, i));
            }
            i = skip_line(src, i);
        } else if (word_at(src, i, "place")) {
            i = i + 5;
            nm: []i8 = take_word(src, i);
            i = skip_word(src, i);
            i = parse_int(src, i, val);
            x: int = val[0];
            okx: int = val[1];
            i = parse_int(src, i, val);
            y: int = val[0];
            oky: int = val[1];
            i = parse_int(src, i, val);
            if (okx == 0 || oky == 0 || val[1] == 0 || len(nm) == 0) {
                return 0 - 1;
            }
            rot: int = val[0];
            if (rot < 0 || rot > 3) {
                return 0 - 1;
            }
            if (n < LEVEL_MAX_PLACES) {
                names[n] = nm;
                places[n] = Placement {
                    x: x,
                    y: y,
                    rot: rot
                };
                n = n + 1;
            }
            i = skip_line(src, i);
        } else if (word_at(src, i, "done")) {
            i = i + 4;
            dn: []i8 = take_word(src, i);
            if (len(dn) > 0 && nd < len(dones)) {
                dones[nd] = dn;
                nd = nd + 1;
            }
            i = skip_line(src, i);
        } else if (src[i] == 'p') {
            i = i + 1;
            i = parse_int(src, i, val);
            col: int = val[0];
            okc: int = val[1];
            i = parse_int(src, i, val);
            if (okc == 0 || val[1] == 0) {
                return 0 - 1;
            }
            start[0] = col;
            start[1] = val[0];
            i = skip_line(src, i);
        } else if (src[i] == 'g') {
            i = i + 1;
            i = parse_int(src, i, val);
            gc: int = val[0];
            okg: int = val[1];
            i = parse_int(src, i, val);
            gr: int = val[0];
            if (okg == 0 || val[1] == 0 || !in_bounds(gc, gr)) {
                return 0 - 1;
            }
            if (!is_goal(goals, ng, gc, gr)) {
                ng = toggle_goal(goals, ng, gc, gr);
            }
            i = skip_line(src, i);
        } else if (src[i] == 'w') {
            i = i + 1;
            i = parse_int(src, i, val);
            wc: int = val[0];
            okw: int = val[1];
            i = parse_int(src, i, val);
            wr: int = val[0];
            if (okw == 0 || val[1] == 0 || !in_bounds(wc, wr)) {
                return 0 - 1;
            }
            if (!is_brick(bricks, nw, wc, wr)) {
                nw = toggle_brick(bricks, nw, wc, wr);
            }
            i = skip_line(src, i);
        } else if (src[i] == 'f') {
            i = i + 1;
            i = parse_int(src, i, val);
            fc: int = val[0];
            okf: int = val[1];
            i = parse_int(src, i, val);
            fr: int = val[0];
            if (okf == 0 || val[1] == 0 || !in_bounds(fc, fr)) {
                return 0 - 1;
            }
            kind: []int = new int[2](0);
            i = parse_ground_kind(src, i, kind);
            if (kind[0] < 0) {
                return 0 - 1;
            }
            nf = put_ground_cell(ground, nf, fc, fr, kind[0], kind[1], 1);
            i = skip_line(src, i);
        } else if (src[i] == 'b' || src[i] == 's' || src[i] == 'r') {
            cmd: i8 = src[i];
            i = i + 1;
            i = parse_int(src, i, val);
            bc: int = val[0];
            okb: int = val[1];
            i = parse_int(src, i, val);
            br: int = val[0];
            if (okb == 0 || val[1] == 0) {
                return 0 - 1;
            }
            shape: int = 0;
            ramp: int = 0;
            layer: int = 0;
            if (cmd == 's') {
                i = parse_uint(src, i, val);
                shape = val[0];
                if (val[1] == 0) {
                    return 0 - 1;
                }
            } else if (cmd == 'r') {
                i = parse_uint(src, i, val);
                ramp = val[0];
                if (val[1] == 0 || ramp < 1 || ramp > 4) {
                    return 0 - 1;
                }
            }
            i = skip_spaces(src, i);
            if (i < len(src) && src[i] >= '0' && src[i] <= '9') {
                i = parse_uint(src, i, val);
                layer = val[0];
            }
            mounted: int = 0;
            i = skip_spaces(src, i);
            if (i < len(src) && src[i] >= '0' && src[i] <= '9') {
                i = parse_uint(src, i, val);
                mounted = val[0];
            }
            if (!in_bounds(bc, br) || layer < 0 || layer >= LEVEL_MAX_LAYER) {
                return 0 - 1;
            }
            if (nb < len(blocks)) {
                blocks[nb] = Block {
                    id: nb,
                    column: bc,
                    row: br,
                    shape: shape,
                    layer: layer,
                    ramp: ramp,
                    mounted: mounted
                };
                nb = nb + 1;
            }
            i = skip_line(src, i);
        } else {
            return 0 - 1;
        }
    }
    nplace[0] = n;
    ndone[0] = nd;
    nroom[0] = nr;
    ngoal[0] = ng;
    nblock[0] = nb;
    nbrick[0] = nw;
    nground[0] = nf;
    n;
}

save_world(
    path: []i8,
    names: [][]i8,
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    blocks: []Block,
    nblock: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    ground: []GroundCell,
    nground: int,
    dones: [][]i8,
    ndone: int,
    pc: int,
    pr: int
): int {
    cap: int = 524288;
    dst: []i8 = new i8[cap](0i8);
    i: int = 0;
    i = put_str(dst, i, "# L8 canonical world\n");
    i = put_str(dst, i, "# level <name> <x0> <y0> <x1> <y1> <title>\n");
    i = put_str(dst, i, "world\n");
    i = put_ch(dst, i, 'p');
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, pc);
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, pr);
    i = put_ch(dst, i, '\n');
    k: int = 0;
    while (k < nroom) {
        i = put_str(dst, i, "level ");
        i = put_str(dst, i, names[k]);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, rooms[k].x0);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, rooms[k].y0);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, rooms[k].x1);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, rooms[k].y1);
        if (len(titles[k]) > 0) {
            i = put_ch(dst, i, ' ');
            i = put_str(dst, i, titles[k]);
        }
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < ndone) {
        i = put_str(dst, i, "done ");
        i = put_str(dst, i, dones[k]);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < ngoal) {
        i = put_str(dst, i, "g ");
        i = put_int(dst, i, goals[k].column);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, goals[k].row);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < nbrick) {
        i = put_str(dst, i, "w ");
        i = put_int(dst, i, bricks[k].column);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, bricks[k].row);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < nground) {
        f: GroundCell = ground[k];
        i = put_str(dst, i, "f ");
        i = put_int(dst, i, f.column);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, f.row);
        i = put_ch(dst, i, ' ');
        i = put_ground_kind(dst, i, f);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < nblock) {
        b: Block = blocks[k];
        if (b.ramp != 0) {
            i = put_str(dst, i, "r ");
            i = put_int(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.ramp);
        } else if (b.shape != 0) {
            i = put_str(dst, i, "s ");
            i = put_int(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.shape);
        } else {
            i = put_str(dst, i, "b ");
            i = put_int(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row);
        }
        if (b.layer != 0 || b.mounted != 0) {
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.layer);
        }
        if (b.mounted != 0) {
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.mounted);
        }
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    if (i > cap) {
        return 0 - 1;
    }
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    if (fd < 0) {
        return 0 - 1;
    }
    w: int = write(fd, dst, i);
    close(fd);
    if (w != i) {
        return 0 - 1;
    }
    0;
}

stamp_level(
    sb: []Block,
    sn: int,
    sr: []Room,
    st: [][]i8@dt,
    snr: int,
    sg: []Goal,
    sng: int,
    sw: []Brick,
    snw: int,
    sf: []GroundCell,
    snf: int,
    px: int,
    py: int,
    rot: int,
    db: []Block,
    dn: int,
    dr: []Room,
    dt: [][]i8,
    dnr: int,
    dg: []Goal,
    dng: int,
    dw: []Brick,
    dnw: int,
    df: []GroundCell,
    dnf: int,
    out: []int,
    xy: []int
): int {
    if (snr < 1) {
        out[0] = dn;
        out[1] = dnr;
        out[2] = dng;
        out[3] = dnw;
        out[4] = dnf;
        return dn;
    }
    base: Room = sr[0];
    w: int = room_size_w(base);
    h: int = room_size_h(base);
    aw: int = place_aabb_w(w, h, rot);
    ah: int = place_aabb_h(w, h, rot);
    title: []i8 = "";
    if (snr > 0 && len(st[0]) > 0) {
        title = st[0];
    }
    dnr = add_room(dr, dt, dnr, px, py, px + aw - 1, py + ah - 1, title);
    i: int = 0;
    while (i < sng) {
        xform_local(sg[i].column - base.x0, sg[i].row - base.y0, w, h, rot, xy);
        if (!is_goal(dg, dng, px + xy[0], py + xy[1])) {
            dng = toggle_goal(dg, dng, px + xy[0], py + xy[1]);
        }
        i = i + 1;
    }
    i = 0;
    while (i < snw) {
        xform_local(sw[i].column - base.x0, sw[i].row - base.y0, w, h, rot, xy);
        if (!is_brick(dw, dnw, px + xy[0], py + xy[1])) {
            dnw = toggle_brick(dw, dnw, px + xy[0], py + xy[1]);
        }
        i = i + 1;
    }
    i = 0;
    while (i < snf) {
        xform_local(sf[i].column - base.x0, sf[i].row - base.y0, w, h, rot, xy);
        dnf = put_ground_cell(df, dnf, px + xy[0], py + xy[1], sf[i].style, sf[i].stone, 0);
        i = i + 1;
    }
    i = 0;
    while (i < sn) {
        if (dn >= len(db)) {
            i = sn;
        } else {
            b: Block = sb[i];
            xform_local(b.column - base.x0, b.row - base.y0, w, h, rot, xy);
            ramp: int = b.ramp;
            if (ramp != 0) {
                ramp = xform_ramp(ramp, rot);
            }
            db[dn] = Block {
                id: dn,
                column: px + xy[0],
                row: py + xy[1],
                shape: b.shape,
                layer: b.layer,
                ramp: ramp,
                mounted: b.mounted
            };
            dn = dn + 1;
            i = i + 1;
        }
    }
    out[0] = dn;
    out[1] = dnr;
    out[2] = dng;
    out[3] = dnw;
    out[4] = dnf;
    dn;
}

compose_world(
    world: []i8,
    places: []Placement,
    names: [][]i8,
    nplace: int,
    over_name: []i8,
    ob: []Block,
    on: int,
    orr: []Room,
    ot: [][]i8@dt,
    onr: int,
    og: []Goal,
    ong: int,
    ow: []Brick,
    onw: int,
    of: []GroundCell,
    onf: int,
    wb: []Block,
    wbn: int,
    ww: []Brick,
    wwn: int,
    wf: []GroundCell,
    wfn: int,
    db: []Block,
    dr: []Room,
    dt: [][]i8,
    dg: []Goal,
    dw: []Brick,
    df: []GroundCell,
    out: []int
): int {
    empty: Block = Block {
        id: 0 - 1,
        column: 0,
        row: 0,
        shape: 0,
        layer: 0,
        ramp: 0,
        mounted: 0
    };
    dn: int = 0;
    dnr: int = 0;
    dng: int = 0;
    dnw: int = 0;
    dnf: int = 0;
    xy: []int = new int[2](0);
    nroom_s: []int = new int[1](0);
    ngoal_s: []int = new int[1](0);
    nbrick_s: []int = new int[1](0);
    nground_s: []int = new int[1](0);
    start_s: []int = new int[2](0);
    sb: []Block = new Block[LEVEL_MAX_BLOCKS](empty);
    sr: []Room = new Room[4](Room {
        x0: 0,
        y0: 0,
        x1: 0,
        y1: 0
    });
    st: [][]i8 = new []i8[4](new i8[0](0i8));
    sg: []Goal = new Goal[LEVEL_MAX_GOALS](Goal {
        column: 0,
        row: 0
    });
    sw: []Brick = new Brick[LEVEL_MAX_BRICKS](Brick {
        column: 0,
        row: 0
    });
    sf: []GroundCell = new GroundCell[LEVEL_MAX_GROUND](GroundCell {
        column: 0,
        row: 0,
        style: GROUND_DIRT,
        stone: 0
    });
    k: int = 0;
    while (k < nplace) {
        p: Placement = places[k];
        if (len(over_name) > 0 && titles_eq(names[k], over_name)) {
            dn = stamp_level(ob, on, orr, ot, onr, og, ong, ow, onw, of, onf, p.x, p.y, p.rot, db, dn,
                dr, dt, dnr, dg, dng, dw, dnw, df, dnf, out, xy);
        } else {
            lp: []i8 = join_level_path(world, names[k]);
            nroom_s[0] = 0;
            ngoal_s[0] = 0;
            nbrick_s[0] = 0;
            nground_s[0] = 0;
            sn: int = load_any(lp, sb, sr, st, nroom_s, sg, ngoal_s, sw, nbrick_s, sf, nground_s,
                start_s);
            if (sn < 0) {
                sn = 0;
            }
            dn = stamp_level(sb, sn, sr, st, nroom_s[0], sg, ngoal_s[0], sw, nbrick_s[0], sf,
                nground_s[0], p.x, p.y, p.rot, db, dn, dr, dt, dnr, dg, dng, dw, dnw, df, dnf,
                out, xy);
        }
        dn = out[0];
        dnr = out[1];
        dng = out[2];
        dnw = out[3];
        dnf = out[4];
        k = k + 1;
    }
    k = 0;
    while (k < wwn) {
        if (!is_brick(dw, dnw, ww[k].column, ww[k].row)) {
            dnw = toggle_brick(dw, dnw, ww[k].column, ww[k].row);
        }
        k = k + 1;
    }
    k = 0;
    while (k < wfn) {
        dnf = put_ground_cell(df, dnf, wf[k].column, wf[k].row, wf[k].style, wf[k].stone, 0);
        k = k + 1;
    }
    k = 0;
    while (k < wbn && dn < len(db)) {
        b: Block = wb[k];
        b.id = dn;
        db[dn] = b;
        dn = dn + 1;
        k = k + 1;
    }
    out[0] = dn;
    out[1] = dnr;
    out[2] = dng;
    out[3] = dnw;
    out[4] = dnf;
    dn;
}

load_unified_world(
    path: []i8,
    names: [][]i8@new,
    rooms: []Room,
    titles: [][]i8,
    nroom: []int,
    blocks: []Block,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    ground: []GroundCell,
    nground: []int,
    start: []int,
    dones: [][]i8@new,
    ndone: []int
): int {
    world_src: []i8 = slurp_path(path);
    legacy: int = world_has_places(world_src);
    ep: Placement = Placement { x: 0, y: 0, rot: 0 };
    eb: Block = Block {
        id: 0 - 1, column: 0, row: 0, shape: 0, layer: 0, ramp: 0, mounted: 0
    };
    ew: Brick = Brick { column: 0, row: 0 };
    ef: GroundCell = GroundCell { column: 0, row: 0, style: GROUND_DIRT, stone: 0 };
    places: []Placement = new Placement[LEVEL_MAX_PLACES](ep);
    np: []int = new int[1](0);
    wb: []Block = new Block[LEVEL_MAX_BLOCKS](eb);
    ww: []Brick = new Brick[LEVEL_MAX_BRICKS](ew);
    wf: []GroundCell = new GroundCell[LEVEL_MAX_GROUND](ef);
    wbn: []int = new int[1](0);
    wwn: []int = new int[1](0);
    wfn: []int = new int[1](0);
    if (load_world(path, places, names, np, rooms, titles, nroom, goals, ngoal, start, dones,
        ndone, wb, wbn, ww, wwn, wf, wfn) < 0) {
        return 0 - 1;
    }
    if (legacy == 0) {
        copy_blocks(blocks, 0, wb, 0, wbn[0]);
        copy_brick_cells(bricks, ww, wwn[0]);
        gn: int = 0;
        gi: int = 0;
        while (gi < wfn[0]) {
            gn = put_ground_cell(ground, gn, wf[gi].column, wf[gi].row, wf[gi].style, wf[gi].stone,
                0);
            gi = gi + 1;
        }
        nbrick[0] = wwn[0];
        nground[0] = gn;
        return wbn[0];
    }
    out: []int = new int[5](0);
    n: int = compose_world(path, places, names, np[0], "", new Block[1](eb), 0, rooms, titles,
        0, goals, 0, bricks, 0, ground, 0, wb, wbn[0], ww, wwn[0], wf, wfn[0], blocks, rooms,
        titles, goals, bricks, ground, out);
    nroom[0] = out[1];
    ngoal[0] = out[2];
    nbrick[0] = out[3];
    nground[0] = out[4];
    if (separate_legacy_rooms(rooms, nroom[0]) != 0) {
        return 0 - 1;
    }
    n;
}

load_any(
    path: []i8,
    blocks: []Block,
    rooms: []Room,
    titles: [][]i8@new,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    ground: []GroundCell,
    nground: []int,
    start: []int
): int {
    src: []i8 = slurp_path(path);
    if (len(src) == 0) {
        fd: int = open_path(path, 0, 0);
        if (fd < 0) {
            return 0 - 1;
        }
        close(fd);
    }
    start[0] = 0;
    start[1] = 0;
    nroom[0] = 0;
    ngoal[0] = 0;
    nbrick[0] = 0;
    nground[0] = 0;
    if (looks_like_grid(src)) {
        return load_grid_src(src, blocks, rooms, titles, nroom, goals, ngoal, bricks, nbrick, start);
    }
    if (looks_like_world(src)) {
        names: [][]i8 = new []i8[LEVEL_MAX_PLACES](new i8[0](0i8));
        dones: [][]i8 = new []i8[LEVEL_MAX_PLACES](new i8[0](0i8));
        nd: []int = new int[1](0);
        return load_unified_world(path, names, rooms, titles, nroom, blocks, goals, ngoal, bricks,
            nbrick, ground, nground, start, dones, nd);
    }
    parse_level_src(src, blocks, rooms, titles, nroom, goals, ngoal, bricks, nbrick, ground,
        nground, start);
}
