// Shared block-game level I/O and rules.
// Numeric format (programs/gl/levels.txt):
//   c <column> [title]
//   b <column> <row> [layer]
//   s <column> <row> <sides> [layer]
//   r <column> <row> <dir> [layer]   ramp; dir 1=+col 2=-col 3=+row 4=-row
// Grid format (programs/gl/puzzles.map): rooms under `= Title` lines.
//   . empty   # block   @ player   | checkpoint column
//   3-6 linked toppings   F or 7 = 15-gon
//   > < v ^  ramp (mount by walking that way)
extern open(path: [z]i8, flags: int, mode: int): int;

extern open_nul(path: []i8, flags: int, mode: int): int;

extern close(fd: int): int;

LEVEL_O_WRONLY: int = 1;

LEVEL_O_CREAT: int = 64;

LEVEL_O_TRUNC: int = 512;

LEVEL_MODE: int = 420;

LEVEL_MAX_BLOCKS: int = 1024;

LEVEL_MAX_CHECKS: int = 64;

LEVEL_DEFAULT_PATH: []i8 = "programs/gl/levels.txt";

LEVEL_MAP_PATH: []i8 = "programs/gl/puzzles.map";

LEVEL_MAX_LAYER: int = 8;

type Block = {
    id: int;
    column: int;
    row: int;
    shape: int;
    layer: int;
    ramp: int;
    mounted: int;
};

zslice_z(s: [z]i8): []i8@new {
    n: int = 0;
    while (s[n] != 0i8) {
        n = n + 1;
    }
    out: []i8 = new i8[n](0i8);
    i: int = 0;
    while (i < n) {
        out[i] = s[i];
        i = i + 1;
    }
    out;
}

arg_eq(a: [z]i8, b: []i8): bool {
    n: int = len(b);
    i: int = 0;
    while (a[i] != 0i8) {
        if (i >= n) {
            return false;
        }
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    i == n;
}

level_path_at(argc: int, argv: [][z]i8, i: int): []i8@new {
    if (argc > i) {
        return zslice_z(argv[i]);
    }
    d: []i8 = LEVEL_DEFAULT_PATH;
    n: int = len(d);
    out: []i8 = new i8[n](0i8);
    memcpy(out, 0, d, 0, n);
    out;
}

open_path(path: []i8, flags: int, mode: int): int {
    n: int = len(path);
    z: []i8 = new i8[n + 1](0i8);
    memcpy(z, 0, path, 0, n);
    z[n] = 0i8;
    open_nul(z, flags, mode);
}

in_bounds(column: int, row: int): bool {
    column >= 0 && row >= 0 && row < 9;
}

is_check(checks: []int, ncheck: int, column: int): bool {
    i: int = 0;
    while (i < ncheck) {
        if (checks[i] == column) {
            return true;
        }
        i = i + 1;
    }
    false;
}

find_prev_check(checks: []int, ncheck: int, column: int): int {
    prev: int = 0;
    i: int = 0;
    while (i < ncheck) {
        c: int = checks[i];
        if (c < column && c > prev) {
            prev = c;
        }
        i = i + 1;
    }
    prev;
}

find_prev_or_same_check(checks: []int, ncheck: int, column: int): int {
    prev: int = 0;
    i: int = 0;
    while (i < ncheck) {
        c: int = checks[i];
        if (c <= column && c > prev) {
            prev = c;
        }
        i = i + 1;
    }
    prev;
}

find_next_check(checks: []int, ncheck: int, column: int): int {
    nxt: int = 0;
    i: int = 0;
    while (i < ncheck) {
        c: int = checks[i];
        if (c > nxt) {
            nxt = c;
        }
        i = i + 1;
    }
    i = 0;
    while (i < ncheck) {
        c2: int = checks[i];
        if (c2 > column && c2 < nxt || nxt == 0) {
            nxt = c2;
        }
        i = i + 1;
    }
    nxt;
}

block_at(
    blocks: []Block,
    n: int,
    column: int,
    row: int
): int {
    block_at_layer(blocks, n, column, row, 0);
}

block_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

ramp_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer && b.ramp != 0 && b.mounted == 0) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

body_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer) {
            if (b.ramp == 0 || b.mounted != 0) {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1;
}

flat_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer && b.ramp == 0) {
            if (ramp_at_layer(blocks, n, column, row, layer) < 0) {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1;
}

has_support(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): bool {
    layer == 0 || flat_at_layer(blocks, n, column, row, layer - 1) >= 0;
}

sitting_at(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): bool {
    rp: int = ramp_at_layer(blocks, n, column, row, layer);
    rp >= 0 && rp != skip;
}

settle_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): int {
    while (layer > 0 && !has_support(blocks, n, column, row, layer) && !sitting_at(blocks, n, column,
        row, layer, skip)) {
        layer = layer - 1;
    }
    layer;
}

pose_mounted(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): int {
    if (sitting_at(blocks, n, column, row, layer, skip)) {
        return 1;
    }
    0;
}

ramp_dir(dc: int, dr: int): int {
    if (dc == 1 && dr == 0) {
        return 1;
    }
    if (dc == 0 - 1 && dr == 0) {
        return 2;
    }
    if (dc == 0 && dr == 1) {
        return 3;
    }
    if (dc == 0 && dr == 0 - 1) {
        return 4;
    }
    0;
}

is_mount_face(ramp: int, dc: int, dr: int): bool {
    ramp != 0 && ramp == ramp_dir(dc, dr);
}

pack_pos(column: int, row: int, layer: int, mounted: int): int {
    column * 512 + row * 32 + layer * 2 + mounted;
}

pos_col(p: int): int {
    p / 512;
}

pos_row(p: int): int {
    p / 32 - p / 512 * 16;
}

pos_layer(p: int): int {
    p / 2 - p / 32 * 16;
}

pos_mounted(p: int): int {
    p - p / 2 * 2;
}

column_has_block(blocks: []Block, n: int, column: int): bool {
    i: int = 0;
    while (i < n) {
        if (blocks[i].column == column) {
            return true;
        }
        i = i + 1;
    }
    false;
}

delete_at(blocks: []Block, n: int, i: int): int {
    if (i < 0 || i >= n) {
        return n;
    }
    blocks[i] = blocks[n - 1];
    n - 1;
}

toggle_block(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    shape: int
): int {
    toggle_block_at(blocks, n, col, row, 0, shape);
}

toggle_block_at(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    layer: int,
    shape: int
): int {
    ai: int = block_at_layer(blocks, n, col, row, layer);
    if (ai >= 0) {
        return delete_at(blocks, n, ai);
    }
    if (n >= LEVEL_MAX_BLOCKS) {
        return n;
    }
    if (layer < 0 || layer >= LEVEL_MAX_LAYER) {
        return n;
    }
    blocks[n] = Block {
        id: n,
        column: col,
        row: row,
        shape: shape,
        layer: layer,
        ramp: 0,
        mounted: 0
    };
    n + 1;
}

toggle_ramp(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    layer: int
): int {
    if (layer < 0 || layer >= LEVEL_MAX_LAYER) {
        return n;
    }
    ai: int = block_at_layer(blocks, n, col, row, layer);
    if (ai >= 0) {
        b: Block = blocks[ai];
        if (b.ramp == 0) {
            b.ramp = 1;
            b.shape = 0;
            blocks[ai] = b;
            return n;
        }
        if (b.ramp < 4) {
            b.ramp = b.ramp + 1;
            blocks[ai] = b;
            return n;
        }
        return delete_at(blocks, n, ai);
    }
    if (n >= LEVEL_MAX_BLOCKS) {
        return n;
    }
    blocks[n] = Block {
        id: n,
        column: col,
        row: row,
        shape: 0,
        layer: layer,
        ramp: 1,
        mounted: 0
    };
    n + 1;
}

title_idx(checks: []int, ncheck: int, col: int): int {
    i: int = 0;
    while (i < ncheck) {
        if (checks[i] == col) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

titles_eq(a: []i8, b: []i8): bool {
    if (len(a) != len(b)) {
        return false;
    }
    i: int = 0;
    while (i < len(a)) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    true;
}

toggle_check(
    blocks: []Block,
    n: int,
    checks: []int,
    titles: [][]i8,
    ncheck: int,
    col: int
): int {
    i: int = 0;
    while (i < ncheck) {
        if (checks[i] == col) {
            checks[i] = checks[ncheck - 1];
            titles[i] = titles[ncheck - 1];
            return ncheck - 1;
        }
        i = i + 1;
    }
    if (column_has_block(blocks, n, col)) {
        return ncheck;
    }
    if (ncheck >= LEVEL_MAX_CHECKS) {
        return ncheck;
    }
    checks[ncheck] = col;
    titles[ncheck] = "";
    ncheck + 1;
}

insert_col(
    blocks: []Block,
    n: int,
    checks: []int,
    ncheck: int,
    col: int
) {
    i: int = 0;
    while (i < n) {
        if (blocks[i].column >= col) {
            blocks[i].column = blocks[i].column + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < ncheck) {
        if (checks[i] >= col) {
            checks[i] = checks[i] + 1;
        }
        i = i + 1;
    }
}

delete_col(
    blocks: []Block,
    n: int,
    checks: []int,
    titles: [][]i8,
    ncheck: int,
    col: int,
    out_n: []int,
    out_nc: []int
) {
    i: int = n - 1;
    while (i >= 0) {
        if (blocks[i].column == col) {
            n = delete_at(blocks, n, i);
        } else if (blocks[i].column > col) {
            blocks[i].column = blocks[i].column - 1;
        }
        i = i - 1;
    }
    i = ncheck - 1;
    while (i >= 0) {
        if (checks[i] == col) {
            checks[i] = checks[ncheck - 1];
            titles[i] = titles[ncheck - 1];
            ncheck = ncheck - 1;
        } else if (checks[i] > col) {
            checks[i] = checks[i] - 1;
        }
        i = i - 1;
    }
    out_n[0] = n;
    out_nc[0] = ncheck;
}

skip_spaces(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r')) {
        i = i + 1;
    }
    i;
}

parse_uint(src: []i8, i: int, out: []int): int {
    n: int = len(src);
    i = skip_spaces(src, i);
    if (i >= n || src[i] < '0' || src[i] > '9') {
        out[0] = 0 - 1;
        return i;
    }
    v: int = 0;
    while (i < n && src[i] >= '0' && src[i] <= '9') {
        v = v * 10 + (src[i] - '0') as int;
        i = i + 1;
    }
    out[0] = v;
    i;
}

skip_line(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && src[i] != '\n') {
        i = i + 1;
    }
    if (i < n) {
        i = i + 1;
    }
    i;
}

put_ch(dst: []i8, i: int, c: i8): int {
    if (i >= 0 && i < len(dst)) {
        dst[i] = c;
    }
    i + 1;
}

put_str(dst: []i8, i: int, s: []i8): int {
    k: int = 0;
    while (k < len(s)) {
        i = put_ch(dst, i, s[k]);
        k = k + 1;
    }
    i;
}

put_uint(dst: []i8, i: int, n: int): int {
    if (n >= 10) {
        i = put_uint(dst, i, n / 10);
    }
    put_ch(dst, i, '0' + (n % 10) trunc i8);
}

slurp_path(path: []i8): []i8@new {
    fd: int = open_path(path, 0, 0);
    if (fd < 0) {
        return new i8[0](0i8);
    }
    cap: int = 65536;
    buf: []i8 = new i8[cap](0i8);
    n: int = 0;
    more: int = 1;
    while (more != 0) {
        if (n + 4096 >= cap) {
            cap = cap * 2;
            tmp: []i8 = new i8[cap](0i8);
            memcpy(tmp, 0, buf, 0, n);
            buf = tmp;
        }
        r: int = read(fd, buf, n, cap - n);
        if (r <= 0) {
            more = 0;
        } else {
            n = n + r;
        }
    }
    close(fd);
    src: []i8 = new i8[n](0i8);
    memcpy(src, 0, buf, 0, n);
    src;
}

parse_level_src(
    src: []i8,
    blocks: []Block,
    checks: []int,
    titles: [][]i8@new,
    ncheck: []int
): int {
    n: int = len(src);
    nb: int = 0;
    nc: int = 0;
    i: int = 0;
    val: []int = new int[1](0);
    while (i < n) {
        i = skip_spaces(src, i);
        if (i >= n) {
            i = n;
        } else if (src[i] == '\n') {
            i = i + 1;
        } else if (src[i] == '#') {
            i = skip_line(src, i);
        } else {
            cmd: i8 = src[i];
            i = i + 1;
            if (cmd == 'c') {
                i = parse_uint(src, i, val);
                if (val[0] < 0) {
                    return 0 - 1;
                }
                if (nc < len(checks) && !is_check(checks, nc, val[0])) {
                    checks[nc] = val[0];
                    i = skip_spaces(src, i);
                    ts: int = i;
                    te: int = i;
                    while (te < n && src[te] != '\n' && src[te] != '\r') {
                        te = te + 1;
                    }
                    while (te > ts && (src[te - 1] == ' ' || src[te - 1] == '\t')) {
                        te = te - 1;
                    }
                    tn: int = te - ts;
                    tbuf: []i8 = new i8[tn](0i8);
                    if (tn > 0) {
                        memcpy(tbuf, 0, src, ts, tn);
                    }
                    titles[nc] = tbuf;
                    nc = nc + 1;
                }
            } else if (cmd == 'b' || cmd == 's' || cmd == 'r') {
                i = parse_uint(src, i, val);
                col: int = val[0];
                i = parse_uint(src, i, val);
                row: int = val[0];
                shape: int = 0;
                ramp: int = 0;
                layer: int = 0;
                if (cmd == 's') {
                    i = parse_uint(src, i, val);
                    shape = val[0];
                } else if (cmd == 'r') {
                    i = parse_uint(src, i, val);
                    ramp = val[0];
                    if (ramp < 1 || ramp > 4) {
                        return 0 - 1;
                    }
                }
                i = skip_spaces(src, i);
                if (i < n && src[i] >= '0' && src[i] <= '9') {
                    i = parse_uint(src, i, val);
                    layer = val[0];
                }
                mounted: int = 0;
                i = skip_spaces(src, i);
                if (i < n && src[i] >= '0' && src[i] <= '9') {
                    i = parse_uint(src, i, val);
                    mounted = val[0];
                }
                if (col < 0 || row < 0 || row > 8 || layer < 0 || layer >= LEVEL_MAX_LAYER) {
                    return 0 - 1;
                }
                if (nb < len(blocks)) {
                    blocks[nb] = Block {
                        id: nb,
                        column: col,
                        row: row,
                        shape: shape,
                        layer: layer,
                        ramp: ramp,
                        mounted: mounted
                    };
                    nb = nb + 1;
                }
            } else {
                return 0 - 1;
            }
            i = skip_line(src, i);
        }
    }
    ncheck[0] = nc;
    nb;
}

load_level(
    path: []i8,
    blocks: []Block,
    checks: []int,
    titles: [][]i8@new,
    ncheck: []int
): int {
    src: []i8 = slurp_path(path);
    if (len(src) == 0) {
        fd: int = open_path(path, 0, 0);
        if (fd < 0) {
            return 0 - 1;
        }
        close(fd);
    }
    parse_level_src(src, blocks, checks, titles, ncheck);
}

save_level(
    path: []i8,
    blocks: []Block,
    n: int,
    checks: []int,
    titles: [][]i8,
    ncheck: int
): int {
    cap: int = 65536;
    dst: []i8 = new i8[cap](0i8);
    i: int = 0;
    i = put_str(dst, i, "# L8 block-game level\n");
    i = put_str(dst, i, "# c <column> [title]\n");
    i = put_str(dst, i, "# b <column> <row> [layer]\n");
    i = put_str(dst, i, """
# s <column> <row> <sides> [layer]
# r <column> <row> <dir> [layer]

""");
    k: int = 0;
    while (k < ncheck) {
        i = put_ch(dst, i, 'c');
        i = put_ch(dst, i, ' ');
        i = put_uint(dst, i, checks[k]);
        if (k < len(titles) && len(titles[k]) > 0) {
            i = put_ch(dst, i, ' ');
            i = put_str(dst, i, titles[k]);
        }
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    i = put_ch(dst, i, '\n');
    k = 0;
    while (k < n) {
        b: Block = blocks[k];
        if (b.ramp != 0) {
            i = put_ch(dst, i, 'r');
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.row);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.ramp);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        } else if (b.shape != 0) {
            i = put_ch(dst, i, 's');
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.row);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.shape);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        } else {
            i = put_ch(dst, i, 'b');
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.row);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        }
        k = k + 1;
    }
    if (i > cap) {
        return 0 - 1;
    }
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    if (fd < 0) {
        return 0 - 1;
    }
    w: int = write(fd, dst, i);
    close(fd);
    if (w != i) {
        return 0 - 1;
    }
    0;
}

copy_blocks(
    dst: []Block,
    doff: int,
    src: []Block,
    soff: int,
    n: int
) {
    i: int = 0;
    while (i < n) {
        dst[doff + i] = src[soff + i];
        i = i + 1;
    }
}

occupant_blocks(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip_shape: int,
    prevc: int,
    nextc: int
): int {
    i: int = 0;
    while (i < n) {
        o: Block = blocks[i];
        if (o.column == column && o.row == row && o.layer == layer) {
            if (skip_shape != 0 && o.shape == skip_shape && o.column > prevc && o.column < nextc) {
                i = i + 1;
            } else {
                return i;
            }
        } else {
            i = i + 1;
        }
    }
    0 - 1;
}

occupant_bodies(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip_shape: int,
    prevc: int,
    nextc: int
): int {
    i: int = 0;
    while (i < n) {
        o: Block = blocks[i];
        if (o.column == column && o.row == row && o.layer == layer && (o.ramp == 0 || o.mounted != 0)) {
            if (skip_shape != 0 && o.shape == skip_shape && o.column > prevc && o.column < nextc) {
                i = i + 1;
            } else {
                return i;
            }
        } else {
            i = i + 1;
        }
    }
    0 - 1;
}

dest_clear(
    blocks: []Block,
    n: int,
    tc: int,
    tr: int,
    tl: int,
    dc: int,
    dr: int,
    skip: int,
    prevc: int,
    nextc: int
): bool {
    if (occupant_bodies(blocks, n, tc, tr, tl, skip, prevc, nextc) >= 0) {
        return false;
    }
    rp: int = ramp_at_layer(blocks, n, tc, tr, tl);
    if (rp >= 0 && !is_mount_face(blocks[rp].ramp, dc, dr)) {
        return false;
    }
    true;
}

can_move_block(
    blocks: []Block,
    n: int,
    checks: []int,
    ncheck: int,
    bi: int,
    dc: int,
    dr: int,
    prevc: int,
    nextc: int
): bool {
    b: Block = blocks[bi];
    tc: int = b.column + dc;
    tr: int = b.row + dr;
    tl: int = b.layer;
    if (!in_bounds(tc, tr) || is_check(checks, ncheck, tc)) {
        return false;
    }
    skip: int = b.shape;
    home: int = ramp_at_layer(blocks, n, b.column, b.row, b.layer);
    if (home == bi) {
        home = 0 - 1;
    }
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr)) {
        if (flat_at_layer(blocks, n, tc, tr, tl) >= 0) {
            if (tl + 1 >= LEVEL_MAX_LAYER) {
                return false;
            }
            return occupant_blocks(blocks, n, tc, tr, tl + 1, skip, prevc, nextc) < 0;
        }
    }
    dest_clear(blocks, n, tc, tr, tl, dc, dr, skip, prevc, nextc);
}

apply_gravity(blocks: []Block, n: int) {
    moved: int = 1;
    while (moved != 0) {
        moved = 0;
        i: int = 0;
        while (i < n) {
            b: Block = blocks[i];
            nl: int = settle_layer(blocks, n, b.column, b.row, b.layer, i);
            nm: int = pose_mounted(blocks, n, b.column, b.row, nl, i);
            if (nl != b.layer || nm != b.mounted) {
                b.layer = nl;
                b.mounted = nm;
                blocks[i] = b;
                moved = 1;
            }
            i = i + 1;
        }
    }
}

slide_one(
    blocks: []Block,
    n: int,
    i: int,
    dc: int,
    dr: int
) {
    b: Block = blocks[i];
    tc: int = b.column + dc;
    tr: int = b.row + dr;
    tl: int = b.layer;
    home: int = ramp_at_layer(blocks, n, b.column, b.row, b.layer);
    if (home == i) {
        home = 0 - 1;
    }
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr)) {
        if (flat_at_layer(blocks, n, tc, tr, tl) >= 0) {
            tl = tl + 1;
        }
    }
    b.column = tc;
    b.row = tr;
    b.layer = settle_layer(blocks, n, tc, tr, tl, i);
    b.mounted = pose_mounted(blocks, n, tc, tr, b.layer, i);
    blocks[i] = b;
}

try_push(
    blocks: []Block,
    n: int,
    checks: []int,
    ncheck: int,
    hit: int,
    dc: int,
    dr: int,
    prevc: int,
    nextc: int
): bool {
    if (!can_move_block(blocks, n, checks, ncheck, hit, dc, dr, prevc, nextc)) {
        return false;
    }
    hb: Block = blocks[hit];
    if (hb.shape != 0) {
        i: int = 0;
        while (i < n) {
            s: Block = blocks[i];
            if (s.column > prevc && s.column < nextc && s.shape == hb.shape) {
                if (!can_move_block(blocks, n, checks, ncheck, i, dc, dr, prevc, nextc)) {
                    return false;
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            s2: Block = blocks[i];
            if (s2.column > prevc && s2.column < nextc && s2.shape == hb.shape) {
                slide_one(blocks, n, i, dc, dr);
            }
            i = i + 1;
        }
        apply_gravity(blocks, n);
        return true;
    }
    slide_one(blocks, n, hit, dc, dr);
    apply_gravity(blocks, n);
    true;
}

finish_move(
    blocks: []Block,
    n: int,
    pc: int,
    pr: int,
    ph: int
): int {
    ph = settle_layer(blocks, n, pc, pr, ph, 0 - 1);
    if (body_at_layer(blocks, n, pc, pr, ph) >= 0) {
        return 0 - 1;
    }
    pack_pos(pc, pr, ph, pose_mounted(blocks, n, pc, pr, ph, 0 - 1));
}

enter_at(
    blocks: []Block,
    n: int,
    checks: []int,
    ncheck: int,
    tc: int,
    tr: int,
    ph: int,
    dc: int,
    dr: int,
    prevc: int,
    nextc: int
): int {
    dest_body: int = body_at_layer(blocks, n, tc, tr, ph);
    dest_ramp: int = ramp_at_layer(blocks, n, tc, tr, ph);
    if (dest_ramp >= 0 && dest_body < 0 && is_mount_face(blocks[dest_ramp].ramp, dc, dr)) {
        return finish_move(blocks, n, tc, tr, ph);
    }
    hit: int = dest_body;
    if (hit < 0) {
        hit = dest_ramp;
    }
    if (hit >= 0) {
        if (!try_push(blocks, n, checks, ncheck, hit, dc, dr, prevc, nextc)) {
            return 0 - 1;
        }
    }
    finish_move(blocks, n, tc, tr, ph);
}

move_player(
    blocks: []Block,
    n: int,
    checks: []int,
    ncheck: int,
    pc: int,
    pr: int,
    ph: int,
    dc: int,
    dr: int
): int {
    stay: int = pack_pos(pc, pr, ph, pose_mounted(blocks, n, pc, pr, ph, 0 - 1));
    tc: int = pc + dc;
    tr: int = pr + dr;
    if (!in_bounds(tc, tr)) {
        return stay;
    }
    prevc: int = find_prev_or_same_check(checks, ncheck, pc);
    nextc: int = find_next_check(checks, ncheck, pc);
    dest_flat: int = flat_at_layer(blocks, n, tc, tr, ph);
    home: int = ramp_at_layer(blocks, n, pc, pr, ph);
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr) && dest_flat >= 0) {
        if (ph + 1 < LEVEL_MAX_LAYER) {
            landed: int = enter_at(blocks, n, checks, ncheck, tc, tr, ph + 1, dc, dr, prevc,
                nextc);
            if (landed >= 0) {
                return landed;
            }
        }
        return stay;
    }
    landed2: int = enter_at(blocks, n, checks, ncheck, tc, tr, ph, dc, dr, prevc, nextc);
    if (landed2 < 0) {
        return stay;
    }
    landed2;
}

looks_like_grid(src: []i8): bool {
    i: int = 0;
    n: int = len(src);
    while (i < n) {
        if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (src[i] == '\n' || src[i] == '\r' || src[i] == ' ' || src[i] == '\t') {
            i = i + 1;
        } else {
            return src[i] == '=';
        }
    }
    false;
}

grid_shape(ch: i8): int {
    if (ch == '3') {
        return 3;
    }
    if (ch == '4') {
        return 4;
    }
    if (ch == '5') {
        return 5;
    }
    if (ch == '6') {
        return 6;
    }
    if (ch == '7' || ch == 'F' || ch == '*') {
        return 15;
    }
    0;
}

add_grid_block(
    blocks: []Block,
    nb: int,
    col: int,
    row: int,
    shape: int
): int {
    add_grid_piece(blocks, nb, col, row, shape, 0, 0);
}

add_grid_piece(
    blocks: []Block,
    nb: int,
    col: int,
    row: int,
    shape: int,
    layer: int,
    ramp: int
): int {
    if (nb >= len(blocks) || row < 0 || row > 8) {
        return nb;
    }
    blocks[nb] = Block {
        id: nb,
        column: col,
        row: row,
        shape: shape,
        layer: layer,
        ramp: ramp,
        mounted: 0
    };
    nb + 1;
}

grid_ramp(ch: i8): int {
    if (ch == '>') {
        return 1;
    }
    if (ch == '<') {
        return 2;
    }
    if (ch == 'v' || ch == 'V') {
        return 3;
    }
    if (ch == '^') {
        return 4;
    }
    0;
}

copy_title(src: []i8, a: int, b: int): []i8@new {
    while (a < b && src[a] == ' ') {
        a = a + 1;
    }
    while (b > a && (src[b - 1] == ' ' || src[b - 1] == '\t')) {
        b = b - 1;
    }
    tn: int = b - a;
    if (tn < 0) {
        tn = 0;
    }
    tbuf: []i8 = new i8[tn](0i8);
    if (tn > 0) {
        memcpy(tbuf, 0, src, a, tn);
    }
    tbuf;
}

load_grid_src(
    src: []i8,
    blocks: []Block,
    checks: []int,
    titles: [][]i8@new,
    ncheck: []int,
    start: []int
): int {
    n: int = len(src);
    nb: int = 0;
    nc: int = 0;
    col0: int = 0;
    title: []i8 = new i8[0](0i8);
    start[0] = 0;
    start[1] = 0;
    have_start: int = 0;
    i: int = 0;
    while (i < n) {
        if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (src[i] == '\n' || src[i] == '\r') {
            i = i + 1;
        } else if (src[i] == '=') {
            i = i + 1;
            ts: int = i;
            while (i < n && src[i] != '\n' && src[i] != '\r') {
                i = i + 1;
            }
            title = copy_title(src, ts, i);
            rows: [][]i8 = new []i8[9](new i8[0](0i8));
            nr: int = 0;
            width: int = 0;
            if (i < n && src[i] == '\r') {
                i = i + 1;
            }
            if (i < n && src[i] == '\n') {
                i = i + 1;
            }
            more: int = 1;
            while (more != 0 && i < n) {
                if (src[i] == '=') {
                    more = 0;
                } else if (src[i] == '\n' || src[i] == '\r') {
                    more = 0;
                } else {
                    rs: int = i;
                    while (i < n && src[i] != '\n' && src[i] != '\r') {
                        i = i + 1;
                    }
                    rl: int = i - rs;
                    if (nr < 9) {
                        row: []i8 = new i8[rl](0i8);
                        memcpy(row, 0, src, rs, rl);
                        rows[nr] = row;
                        if (rl > width) {
                            width = rl;
                        }
                        nr = nr + 1;
                    }
                    if (i < n && src[i] == '\r') {
                        i = i + 1;
                    }
                    if (i < n && src[i] == '\n') {
                        i = i + 1;
                    }
                }
            }
            if (width < 1 || nr < 1) {
                return 0 - 1;
            }
            marked: int = 0;
            c: int = 0;
            while (c < width) {
                wc: int = col0 + c;
                is_ck: int = 0;
                if (c == 0) {
                    is_ck = 1;
                }
                r: int = 0;
                while (r < nr) {
                    row2: []i8 = rows[r];
                    ch: i8 = '.';
                    if (c < len(row2)) {
                        ch = row2[c];
                    }
                    if (ch == '|') {
                        is_ck = 1;
                    } else if (ch == '@') {
                        start[0] = wc;
                        start[1] = r;
                        have_start = 1;
                    } else if (ch == '#') {
                        nb = add_grid_block(blocks, nb, wc, r, 0);
                    } else {
                        rp: int = grid_ramp(ch);
                        if (rp != 0) {
                            nb = add_grid_piece(blocks, nb, wc, r, 0, 0, rp);
                        } else {
                            sh: int = grid_shape(ch);
                            if (sh != 0) {
                                nb = add_grid_block(blocks, nb, wc, r, sh);
                            }
                        }
                    }
                    r = r + 1;
                }
                if (is_ck != 0) {
                    if (nc < len(checks) && !is_check(checks, nc, wc)) {
                        checks[nc] = wc;
                        if (marked == 0) {
                            titles[nc] = title;
                            marked = 1;
                        } else {
                            titles[nc] = new i8[0](0i8);
                        }
                        nc = nc + 1;
                    }
                }
                c = c + 1;
            }
            col0 = col0 + width;
        } else {
            return 0 - 1;
        }
    }
    if (have_start == 0 && nc > 0) {
        start[0] = checks[0];
        start[1] = 0;
    }
    ncheck[0] = nc;
    nb;
}

load_any(
    path: []i8,
    blocks: []Block,
    checks: []int,
    titles: [][]i8@new,
    ncheck: []int,
    start: []int
): int {
    src: []i8 = slurp_path(path);
    if (len(src) == 0) {
        fd: int = open_path(path, 0, 0);
        if (fd < 0) {
            return 0 - 1;
        }
        close(fd);
    }
    start[0] = 0;
    start[1] = 0;
    if (looks_like_grid(src)) {
        return load_grid_src(src, blocks, checks, titles, ncheck, start);
    }
    parse_level_src(src, blocks, checks, titles, ncheck);
}
