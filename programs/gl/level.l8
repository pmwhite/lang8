// Shared block-game level format: programs/gl/levels.txt
//   c <column> [title]
//   b <column> <row>
//   s <column> <row> <sides>
extern open(path: [z]i8, flags: int, mode: int): int;

extern open_nul(path: []i8, flags: int, mode: int): int;

extern close(fd: int): int;

LEVEL_O_WRONLY: int = 1;

LEVEL_O_CREAT: int = 64;

LEVEL_O_TRUNC: int = 512;

LEVEL_MODE: int = 420;

LEVEL_MAX_BLOCKS: int = 1024;

LEVEL_MAX_CHECKS: int = 64;

LEVEL_DEFAULT_PATH: []i8 = "programs/gl/levels.txt";

type Block = {
    id: int;
    column: int;
    row: int;
    shape: int;
};

zslice_z(s: [z]i8): []i8@new {
    n: int = 0;
    while (s[n] != 0i8) {
        n = n + 1;
    }
    out: []i8 = new i8[n](0i8);
    i: int = 0;
    while (i < n) {
        out[i] = s[i];
        i = i + 1;
    }
    out;
}

arg_eq(a: [z]i8, b: []i8): bool {
    n: int = len(b);
    i: int = 0;
    while (a[i] != 0i8) {
        if (i >= n) {
            return false;
        }
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    i == n;
}

level_path_at(argc: int, argv: [][z]i8, i: int): []i8@new {
    if (argc > i) {
        return zslice_z(argv[i]);
    }
    d: []i8 = LEVEL_DEFAULT_PATH;
    n: int = len(d);
    out: []i8 = new i8[n](0i8);
    memcpy(out, 0, d, 0, n);
    out;
}

open_path(path: []i8, flags: int, mode: int): int {
    n: int = len(path);
    z: []i8 = new i8[n + 1](0i8);
    memcpy(z, 0, path, 0, n);
    z[n] = 0i8;
    open_nul(z, flags, mode);
}

in_bounds(column: int, row: int): bool {
    column >= 0 && row >= 0 && row < 9;
}

is_check(checks: []int, ncheck: int, column: int): bool {
    i: int = 0;
    while (i < ncheck) {
        if (checks[i] == column) {
            return true;
        }
        i = i + 1;
    }
    false;
}

find_prev_check(checks: []int, ncheck: int, column: int): int {
    prev: int = 0;
    i: int = 0;
    while (i < ncheck) {
        c: int = checks[i];
        if (c < column && c > prev) {
            prev = c;
        }
        i = i + 1;
    }
    prev;
}

find_prev_or_same_check(checks: []int, ncheck: int, column: int): int {
    prev: int = 0;
    i: int = 0;
    while (i < ncheck) {
        c: int = checks[i];
        if (c <= column && c > prev) {
            prev = c;
        }
        i = i + 1;
    }
    prev;
}

find_next_check(checks: []int, ncheck: int, column: int): int {
    nxt: int = 0;
    i: int = 0;
    while (i < ncheck) {
        c: int = checks[i];
        if (c > nxt) {
            nxt = c;
        }
        i = i + 1;
    }
    i = 0;
    while (i < ncheck) {
        c2: int = checks[i];
        if (c2 > column && c2 < nxt || nxt == 0) {
            nxt = c2;
        }
        i = i + 1;
    }
    nxt;
}

block_at(
    blocks: []Block,
    n: int,
    column: int,
    row: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

column_has_block(blocks: []Block, n: int, column: int): bool {
    i: int = 0;
    while (i < n) {
        if (blocks[i].column == column) {
            return true;
        }
        i = i + 1;
    }
    false;
}

delete_at(blocks: []Block, n: int, i: int): int {
    if (i < 0 || i >= n) {
        return n;
    }
    blocks[i] = blocks[n - 1];
    n - 1;
}

toggle_block(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    shape: int
): int {
    ai: int = block_at(blocks, n, col, row);
    if (ai >= 0) {
        return delete_at(blocks, n, ai);
    }
    if (n >= LEVEL_MAX_BLOCKS) {
        return n;
    }
    blocks[n] = Block {
        id: n,
        column: col,
        row: row,
        shape: shape
    };
    n + 1;
}

title_idx(checks: []int, ncheck: int, col: int): int {
    i: int = 0;
    while (i < ncheck) {
        if (checks[i] == col) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

titles_eq(a: []i8, b: []i8): bool {
    if (len(a) != len(b)) {
        return false;
    }
    i: int = 0;
    while (i < len(a)) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    true;
}

toggle_check(
    blocks: []Block,
    n: int,
    checks: []int,
    titles: [][]i8,
    ncheck: int,
    col: int
): int {
    i: int = 0;
    while (i < ncheck) {
        if (checks[i] == col) {
            checks[i] = checks[ncheck - 1];
            titles[i] = titles[ncheck - 1];
            return ncheck - 1;
        }
        i = i + 1;
    }
    if (column_has_block(blocks, n, col)) {
        return ncheck;
    }
    if (ncheck >= LEVEL_MAX_CHECKS) {
        return ncheck;
    }
    checks[ncheck] = col;
    titles[ncheck] = "";
    ncheck + 1;
}

insert_col(
    blocks: []Block,
    n: int,
    checks: []int,
    ncheck: int,
    col: int
) {
    i: int = 0;
    while (i < n) {
        if (blocks[i].column >= col) {
            blocks[i].column = blocks[i].column + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < ncheck) {
        if (checks[i] >= col) {
            checks[i] = checks[i] + 1;
        }
        i = i + 1;
    }
}

delete_col(
    blocks: []Block,
    n: int,
    checks: []int,
    titles: [][]i8,
    ncheck: int,
    col: int,
    out_n: []int,
    out_nc: []int
) {
    i: int = n - 1;
    while (i >= 0) {
        if (blocks[i].column == col) {
            n = delete_at(blocks, n, i);
        } else if (blocks[i].column > col) {
            blocks[i].column = blocks[i].column - 1;
        }
        i = i - 1;
    }
    i = ncheck - 1;
    while (i >= 0) {
        if (checks[i] == col) {
            checks[i] = checks[ncheck - 1];
            titles[i] = titles[ncheck - 1];
            ncheck = ncheck - 1;
        } else if (checks[i] > col) {
            checks[i] = checks[i] - 1;
        }
        i = i - 1;
    }
    out_n[0] = n;
    out_nc[0] = ncheck;
}

skip_spaces(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r')) {
        i = i + 1;
    }
    i;
}

parse_uint(src: []i8, i: int, out: []int): int {
    n: int = len(src);
    i = skip_spaces(src, i);
    if (i >= n || src[i] < '0' || src[i] > '9') {
        out[0] = 0 - 1;
        return i;
    }
    v: int = 0;
    while (i < n && src[i] >= '0' && src[i] <= '9') {
        v = v * 10 + (src[i] - '0') as int;
        i = i + 1;
    }
    out[0] = v;
    i;
}

skip_line(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && src[i] != '\n') {
        i = i + 1;
    }
    if (i < n) {
        i = i + 1;
    }
    i;
}

put_ch(dst: []i8, i: int, c: i8): int {
    if (i >= 0 && i < len(dst)) {
        dst[i] = c;
    }
    i + 1;
}

put_str(dst: []i8, i: int, s: []i8): int {
    k: int = 0;
    while (k < len(s)) {
        i = put_ch(dst, i, s[k]);
        k = k + 1;
    }
    i;
}

put_uint(dst: []i8, i: int, n: int): int {
    if (n >= 10) {
        i = put_uint(dst, i, n / 10);
    }
    put_ch(dst, i, '0' + (n % 10) trunc i8);
}

load_level(
    path: []i8,
    blocks: []Block,
    checks: []int,
    titles: [][]i8@new,
    ncheck: []int
): int {
    fd: int = open_path(path, 0, 0);
    if (fd < 0) {
        return 0 - 1;
    }
    cap: int = 65536;
    buf: []i8 = new i8[cap](0i8);
    n: int = 0;
    more: int = 1;
    while (more != 0) {
        if (n + 4096 >= cap) {
            cap = cap * 2;
            tmp: []i8 = new i8[cap](0i8);
            memcpy(tmp, 0, buf, 0, n);
            buf = tmp;
        }
        r: int = read(fd, buf, n, cap - n);
        if (r <= 0) {
            more = 0;
        } else {
            n = n + r;
        }
    }
    close(fd);
    src: []i8 = new i8[n](0i8);
    memcpy(src, 0, buf, 0, n);
    nb: int = 0;
    nc: int = 0;
    i: int = 0;
    val: []int = new int[1](0);
    while (i < n) {
        i = skip_spaces(src, i);
        if (i >= n) {
            i = n;
        } else if (src[i] == '\n') {
            i = i + 1;
        } else if (src[i] == '#') {
            i = skip_line(src, i);
        } else {
            cmd: i8 = src[i];
            i = i + 1;
            if (cmd == 'c') {
                i = parse_uint(src, i, val);
                if (val[0] < 0) {
                    return 0 - 1;
                }
                if (nc < len(checks) && !is_check(checks, nc, val[0])) {
                    checks[nc] = val[0];
                    i = skip_spaces(src, i);
                    ts: int = i;
                    te: int = i;
                    while (te < n && src[te] != '\n' && src[te] != '\r') {
                        te = te + 1;
                    }
                    while (te > ts && (src[te - 1] == ' ' || src[te - 1] == '\t')) {
                        te = te - 1;
                    }
                    tn: int = te - ts;
                    tbuf: []i8 = new i8[tn](0i8);
                    if (tn > 0) {
                        memcpy(tbuf, 0, src, ts, tn);
                    }
                    titles[nc] = tbuf;
                    nc = nc + 1;
                }
            } else if (cmd == 'b' || cmd == 's') {
                i = parse_uint(src, i, val);
                col: int = val[0];
                i = parse_uint(src, i, val);
                row: int = val[0];
                shape: int = 0;
                if (cmd == 's') {
                    i = parse_uint(src, i, val);
                    shape = val[0];
                }
                if (col < 0 || row < 0 || row > 8) {
                    return 0 - 1;
                }
                if (nb < len(blocks)) {
                    blocks[nb] = Block {
                        id: nb,
                        column: col,
                        row: row,
                        shape: shape
                    };
                    nb = nb + 1;
                }
            } else {
                return 0 - 1;
            }
            i = skip_line(src, i);
        }
    }
    ncheck[0] = nc;
    nb;
}

save_level(
    path: []i8,
    blocks: []Block,
    n: int,
    checks: []int,
    titles: [][]i8,
    ncheck: int
): int {
    cap: int = 65536;
    dst: []i8 = new i8[cap](0i8);
    i: int = 0;
    i = put_str(dst, i, "# L8 block-game level\n");
    i = put_str(dst, i, "# c <column> [title]\n");
    i = put_str(dst, i, "# b <column> <row>\n");
    i = put_str(dst, i, """
# s <column> <row> <sides>

""");
    k: int = 0;
    while (k < ncheck) {
        i = put_ch(dst, i, 'c');
        i = put_ch(dst, i, ' ');
        i = put_uint(dst, i, checks[k]);
        if (k < len(titles) && len(titles[k]) > 0) {
            i = put_ch(dst, i, ' ');
            i = put_str(dst, i, titles[k]);
        }
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    i = put_ch(dst, i, '\n');
    k = 0;
    while (k < n) {
        b: Block = blocks[k];
        if (b.shape != 0) {
            i = put_ch(dst, i, 's');
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.row);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.shape);
            i = put_ch(dst, i, '\n');
        } else {
            i = put_ch(dst, i, 'b');
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.row);
            i = put_ch(dst, i, '\n');
        }
        k = k + 1;
    }
    if (i > cap) {
        return 0 - 1;
    }
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    if (fd < 0) {
        return 0 - 1;
    }
    w: int = write(fd, dst, i);
    close(fd);
    if (w != i) {
        return 0 - 1;
    }
    0;
}
