// Shared block-game level I/O and rules.
// Numeric format:
//   room x0 y0 x1 y1 Title
//   g <column> <row>          finish point (visual)
//   w <column> <row>          brick (solid)
//   p <column> <row>          player start
//   b <column> <row> [layer]
//   s <column> <row> <sides> [layer]
//   r <column> <row> <dir> [layer]   ramp; dir 1=+col 2=-col 3=+row 4=-row
// Old `c <column> [title]` files migrate: each pair of columns + rows 0-8
// becomes a room; a goal is placed on the right-hand column, middle row.
// Grid format (programs/gl/puzzles.map): rooms under `= Title` lines.
//   . empty   # block   @ player   | ignored (legacy checkpoint)
//   3-6 linked toppings   F or 7 = 15-gon
//   > < v ^  ramp (mount by walking that way)
extern open(path: [z]i8, flags: int, mode: int): int;

extern open_nul(path: []i8, flags: int, mode: int): int;

extern close(fd: int): int;

LEVEL_O_WRONLY: int = 1;

LEVEL_O_CREAT: int = 64;

LEVEL_O_TRUNC: int = 512;

LEVEL_MODE: int = 420;

LEVEL_MAX_BLOCKS: int = 1024;

LEVEL_MAX_ROOMS: int = 64;

LEVEL_MAX_GOALS: int = 64;

LEVEL_MAX_BRICKS: int = 2048;

LEVEL_SOFT_CAP: int = 4096;

LEVEL_PACK_BIAS: int = 4096;

LEVEL_PACK_SPAN: int = 8193;

LEVEL_PACK_ROW: int = 16;

LEVEL_PACK_COL: int = 131088;

LEVEL_DEFAULT_PATH: []i8 = "programs/gl/levels.txt";

LEVEL_MAP_PATH: []i8 = "programs/gl/puzzles.map";

LEVEL_MAX_LAYER: int = 8;

type Block = {
    id: int;
    column: int;
    row: int;
    shape: int;
    layer: int;
    ramp: int;
    mounted: int;
};

type Room = {
    x0: int;
    y0: int;
    x1: int;
    y1: int;
};

type Goal = {
    column: int;
    row: int;
};

type Brick = {
    column: int;
    row: int;
};

zslice_z(s: [z]i8): []i8@new {
    n: int = 0;
    while (s[n] != 0i8) {
        n = n + 1;
    }
    out: []i8 = new i8[n](0i8);
    i: int = 0;
    while (i < n) {
        out[i] = s[i];
        i = i + 1;
    }
    out;
}

arg_eq(a: [z]i8, b: []i8): bool {
    n: int = len(b);
    i: int = 0;
    while (a[i] != 0i8) {
        if (i >= n) {
            return false;
        }
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    i == n;
}

level_path_at(argc: int, argv: [][z]i8, i: int): []i8@new {
    if (argc > i) {
        return zslice_z(argv[i]);
    }
    d: []i8 = LEVEL_DEFAULT_PATH;
    n: int = len(d);
    out: []i8 = new i8[n](0i8);
    memcpy(out, 0, d, 0, n);
    out;
}

open_path(path: []i8, flags: int, mode: int): int {
    n: int = len(path);
    z: []i8 = new i8[n + 1](0i8);
    memcpy(z, 0, path, 0, n);
    z[n] = 0i8;
    open_nul(z, flags, mode);
}

in_bounds(column: int, row: int): bool {
    column >= 0 - LEVEL_SOFT_CAP && column <= LEVEL_SOFT_CAP && row >= 0 - LEVEL_SOFT_CAP && row <= LEVEL_SOFT_CAP;
}

norm_room(x0: int, y0: int, x1: int, y1: int): Room {
    if (x1 < x0) {
        t: int = x0;
        x0 = x1;
        x1 = t;
    }
    if (y1 < y0) {
        t2: int = y0;
        y0 = y1;
        y1 = t2;
    }
    Room {
        x0: x0,
        y0: y0,
        x1: x1,
        y1: y1
    };
}

room_contains(r: Room, column: int, row: int): bool {
    column >= r.x0 && column <= r.x1 && row >= r.y0 && row <= r.y1;
}

room_area(r: Room): int {
    (r.x1 - r.x0 + 1) * (r.y1 - r.y0 + 1);
}

room_at(rooms: []Room, nroom: int, column: int, row: int): int {
    best: int = 0 - 1;
    best_a: int = 0;
    i: int = 0;
    while (i < nroom) {
        r: Room = rooms[i];
        if (room_contains(r, column, row)) {
            a: int = room_area(r);
            if (best < 0 || a < best_a) {
                best = i;
                best_a = a;
            }
        }
        i = i + 1;
    }
    best;
}

same_room(
    rooms: []Room,
    nroom: int,
    ac: int,
    ar: int,
    bc: int,
    br: int
): bool {
    ia: int = room_at(rooms, nroom, ac, ar);
    ia >= 0 && ia == room_at(rooms, nroom, bc, br);
}

is_room_border(rooms: []Room, nroom: int, column: int, row: int): bool {
    i: int = 0;
    while (i < nroom) {
        r: Room = rooms[i];
        if (room_contains(r, column, row)) {
            if (column == r.x0 || column == r.x1 || row == r.y0 || row == r.y1) {
                return true;
            }
        }
        i = i + 1;
    }
    false;
}

is_brick(bricks: []Brick, nbrick: int, column: int, row: int): bool {
    i: int = 0;
    while (i < nbrick) {
        b: Brick = bricks[i];
        if (b.column == column && b.row == row) {
            return true;
        }
        i = i + 1;
    }
    false;
}

is_goal(goals: []Goal, ngoal: int, column: int, row: int): bool {
    i: int = 0;
    while (i < ngoal) {
        g: Goal = goals[i];
        if (g.column == column && g.row == row) {
            return true;
        }
        i = i + 1;
    }
    false;
}

find_room_rect(rooms: []Room, nroom: int, want: Room): int {
    i: int = 0;
    while (i < nroom) {
        r: Room = rooms[i];
        if (r.x0 == want.x0 && r.y0 == want.y0 && r.x1 == want.x1 && r.y1 == want.y1) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

delete_room_at(rooms: []Room, titles: [][]i8, nroom: int, i: int): int {
    if (i < 0 || i >= nroom) {
        return nroom;
    }
    rooms[i] = rooms[nroom - 1];
    titles[i] = titles[nroom - 1];
    nroom - 1;
}

add_room(
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    x0: int,
    y0: int,
    x1: int,
    y1: int,
    title: []i8@titles
): int {
    if (nroom >= LEVEL_MAX_ROOMS) {
        return nroom;
    }
    rooms[nroom] = norm_room(x0, y0, x1, y1);
    titles[nroom] = title;
    nroom + 1;
}

toggle_room_rect(
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    x0: int,
    y0: int,
    x1: int,
    y1: int
): int {
    want: Room = norm_room(x0, y0, x1, y1);
    hit: int = find_room_rect(rooms, nroom, want);
    if (hit >= 0) {
        return delete_room_at(rooms, titles, nroom, hit);
    }
    add_room(rooms, titles, nroom, want.x0, want.y0, want.x1, want.y1, "");
}

toggle_goal(goals: []Goal, ngoal: int, column: int, row: int): int {
    i: int = 0;
    while (i < ngoal) {
        g: Goal = goals[i];
        if (g.column == column && g.row == row) {
            goals[i] = goals[ngoal - 1];
            return ngoal - 1;
        }
        i = i + 1;
    }
    if (ngoal >= LEVEL_MAX_GOALS || !in_bounds(column, row)) {
        return ngoal;
    }
    goals[ngoal] = Goal {
        column: column,
        row: row
    };
    ngoal + 1;
}

toggle_brick(bricks: []Brick, nbrick: int, column: int, row: int): int {
    i: int = 0;
    while (i < nbrick) {
        b: Brick = bricks[i];
        if (b.column == column && b.row == row) {
            bricks[i] = bricks[nbrick - 1];
            return nbrick - 1;
        }
        i = i + 1;
    }
    if (nbrick >= LEVEL_MAX_BRICKS || !in_bounds(column, row)) {
        return nbrick;
    }
    bricks[nbrick] = Brick {
        column: column,
        row: row
    };
    nbrick + 1;
}

block_at(
    blocks: []Block,
    n: int,
    column: int,
    row: int
): int {
    block_at_layer(blocks, n, column, row, 0);
}

block_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

ramp_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer && b.ramp != 0 && b.mounted == 0) {
            return i;
        }
        i = i + 1;
    }
    0 - 1;
}

body_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer) {
            if (b.ramp == 0 || b.mounted != 0) {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1;
}

flat_at_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): int {
    i: int = 0;
    while (i < n) {
        b: Block = blocks[i];
        if (b.column == column && b.row == row && b.layer == layer && b.ramp == 0) {
            if (ramp_at_layer(blocks, n, column, row, layer) < 0) {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1;
}

has_support(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int
): bool {
    layer == 0 || body_at_layer(blocks, n, column, row, layer - 1) >= 0;
}

sitting_at(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): bool {
    rp: int = ramp_at_layer(blocks, n, column, row, layer);
    rp >= 0 && rp != skip;
}

settle_layer(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): int {
    while (layer > 0 && !has_support(blocks, n, column, row, layer) && !sitting_at(blocks, n, column,
        row, layer, skip)) {
        layer = layer - 1;
    }
    layer;
}

pose_mounted(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip: int
): int {
    if (sitting_at(blocks, n, column, row, layer, skip)) {
        return 1;
    }
    0;
}

ramp_dir(dc: int, dr: int): int {
    if (dc == 1 && dr == 0) {
        return 1;
    }
    if (dc == 0 - 1 && dr == 0) {
        return 2;
    }
    if (dc == 0 && dr == 1) {
        return 3;
    }
    if (dc == 0 && dr == 0 - 1) {
        return 4;
    }
    0;
}

is_mount_face(ramp: int, dc: int, dr: int): bool {
    ramp != 0 && ramp == ramp_dir(dc, dr);
}

pack_pos(column: int, row: int, layer: int, mounted: int): int {
    (column + LEVEL_PACK_BIAS) * LEVEL_PACK_COL + (row + LEVEL_PACK_BIAS) * LEVEL_PACK_ROW + layer * 2 + mounted;
}

pos_col(p: int): int {
    p / LEVEL_PACK_COL - LEVEL_PACK_BIAS;
}

pos_row(p: int): int {
    p / LEVEL_PACK_ROW - p / LEVEL_PACK_COL * LEVEL_PACK_SPAN - LEVEL_PACK_BIAS;
}

pos_layer(p: int): int {
    p / 2 - p / LEVEL_PACK_ROW * 8;
}

pos_mounted(p: int): int {
    p - p / 2 * 2;
}

column_has_block(blocks: []Block, n: int, column: int): bool {
    i: int = 0;
    while (i < n) {
        if (blocks[i].column == column) {
            return true;
        }
        i = i + 1;
    }
    false;
}

delete_at(blocks: []Block, n: int, i: int): int {
    if (i < 0 || i >= n) {
        return n;
    }
    blocks[i] = blocks[n - 1];
    n - 1;
}

next_block_id(blocks: []Block, n: int): int {
    id: int = n;
    i: int = 0;
    while (i < n) {
        if (blocks[i].id >= id) {
            id = blocks[i].id + 1;
        }
        i = i + 1;
    }
    id;
}

toggle_block(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    shape: int
): int {
    toggle_block_at(blocks, n, col, row, 0, shape);
}

free_layer_at(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    start: int
): int {
    layer: int = start;
    if (layer < 0) {
        layer = 0;
    }
    while (layer < LEVEL_MAX_LAYER) {
        if (body_at_layer(blocks, n, col, row, layer) < 0) {
            return layer;
        }
        layer = layer + 1;
    }
    0 - 1;
}

highest_layer_at(blocks: []Block, n: int, col: int, row: int): int {
    layer: int = LEVEL_MAX_LAYER - 1;
    while (layer >= 0) {
        if (block_at_layer(blocks, n, col, row, layer) >= 0) {
            return layer;
        }
        layer = layer - 1;
    }
    0 - 1;
}

add_block_at(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    layer: int,
    shape: int,
    ramp: int
): int {
    if (n >= LEVEL_MAX_BLOCKS) {
        return n;
    }
    if (layer < 0 || layer >= LEVEL_MAX_LAYER) {
        return n;
    }
    if (body_at_layer(blocks, n, col, row, layer) >= 0) {
        return n;
    }
    if (ramp != 0 && ramp_at_layer(blocks, n, col, row, layer) >= 0) {
        return n;
    }
    blocks[n] = Block {
        id: next_block_id(blocks, n),
        column: col,
        row: row,
        shape: shape,
        layer: layer,
        ramp: ramp,
        mounted: pose_mounted(blocks, n, col, row, layer, n)
    };
    n + 1;
}

toggle_block_at(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    layer: int,
    shape: int
): int {
    ai: int = block_at_layer(blocks, n, col, row, layer);
    if (ai >= 0) {
        return delete_at(blocks, n, ai);
    }
    add_block_at(blocks, n, col, row, layer, shape, 0);
}

erase_top_at(blocks: []Block, n: int, col: int, row: int): int {
    layer: int = highest_layer_at(blocks, n, col, row);
    if (layer < 0) {
        return n;
    }
    hit: int = body_at_layer(blocks, n, col, row, layer);
    if (hit < 0) {
        hit = block_at_layer(blocks, n, col, row, layer);
    }
    if (hit < 0) {
        return n;
    }
    n = delete_at(blocks, n, hit);
    apply_gravity(blocks, n);
    n;
}

cursor_layer_at(blocks: []Block, n: int, col: int, row: int): int {
    layer: int = highest_layer_at(blocks, n, col, row);
    if (layer < 0) {
        return 0;
    }
    layer;
}

toggle_ramp(
    blocks: []Block,
    n: int,
    col: int,
    row: int,
    layer: int
): int {
    if (layer < 0 || layer >= LEVEL_MAX_LAYER) {
        return n;
    }
    ai: int = block_at_layer(blocks, n, col, row, layer);
    if (ai >= 0) {
        b: Block = blocks[ai];
        if (b.ramp == 0) {
            b.ramp = 1;
            b.shape = 0;
            blocks[ai] = b;
            return n;
        }
        if (b.ramp < 4) {
            b.ramp = b.ramp + 1;
            blocks[ai] = b;
            return n;
        }
        return delete_at(blocks, n, ai);
    }
    add_block_at(blocks, n, col, row, layer, 0, 1);
}

titles_eq(a: []i8, b: []i8): bool {
    if (len(a) != len(b)) {
        return false;
    }
    i: int = 0;
    while (i < len(a)) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    true;
}

shift_rooms_insert(rooms: []Room, nroom: int, col: int) {
    i: int = 0;
    while (i < nroom) {
        r: Room = rooms[i];
        if (r.x1 >= col) {
            r.x1 = r.x1 + 1;
        }
        if (r.x0 >= col) {
            r.x0 = r.x0 + 1;
        }
        rooms[i] = r;
        i = i + 1;
    }
}

shift_goals_insert(goals: []Goal, ngoal: int, col: int) {
    i: int = 0;
    while (i < ngoal) {
        if (goals[i].column >= col) {
            goals[i].column = goals[i].column + 1;
        }
        i = i + 1;
    }
}

shift_bricks_insert(bricks: []Brick, nbrick: int, col: int) {
    i: int = 0;
    while (i < nbrick) {
        if (bricks[i].column >= col) {
            bricks[i].column = bricks[i].column + 1;
        }
        i = i + 1;
    }
}

insert_col(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    col: int
) {
    i: int = 0;
    while (i < n) {
        if (blocks[i].column >= col) {
            blocks[i].column = blocks[i].column + 1;
        }
        i = i + 1;
    }
    shift_rooms_insert(rooms, nroom, col);
    shift_goals_insert(goals, ngoal, col);
    shift_bricks_insert(bricks, nbrick, col);
}

delete_col(
    blocks: []Block,
    n: int,
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    col: int,
    out_n: []int
) {
    i: int = n - 1;
    while (i >= 0) {
        if (blocks[i].column == col) {
            n = delete_at(blocks, n, i);
        } else if (blocks[i].column > col) {
            blocks[i].column = blocks[i].column - 1;
        }
        i = i - 1;
    }
    i = nroom - 1;
    while (i >= 0) {
        r: Room = rooms[i];
        if (r.x0 == r.x1 && r.x0 == col) {
            nroom = delete_room_at(rooms, titles, nroom, i);
        } else {
            if (r.x1 >= col) {
                r.x1 = r.x1 - 1;
            }
            if (r.x0 > col) {
                r.x0 = r.x0 - 1;
            }
            rooms[i] = r;
        }
        i = i - 1;
    }
    i = ngoal - 1;
    while (i >= 0) {
        if (goals[i].column == col) {
            goals[i] = goals[ngoal - 1];
            ngoal = ngoal - 1;
        } else if (goals[i].column > col) {
            goals[i].column = goals[i].column - 1;
        }
        i = i - 1;
    }
    i = nbrick - 1;
    while (i >= 0) {
        if (bricks[i].column == col) {
            bricks[i] = bricks[nbrick - 1];
            nbrick = nbrick - 1;
        } else if (bricks[i].column > col) {
            bricks[i].column = bricks[i].column - 1;
        }
        i = i - 1;
    }
    out_n[0] = n;
    out_n[1] = nroom;
    out_n[2] = ngoal;
    out_n[3] = nbrick;
}

skip_spaces(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r')) {
        i = i + 1;
    }
    i;
}

parse_uint(src: []i8, i: int, out: []int): int {
    n: int = len(src);
    i = skip_spaces(src, i);
    if (i >= n || src[i] < '0' || src[i] > '9') {
        out[0] = 0 - 1;
        return i;
    }
    v: int = 0;
    while (i < n && src[i] >= '0' && src[i] <= '9') {
        v = v * 10 + (src[i] - '0') as int;
        i = i + 1;
    }
    out[0] = v;
    i;
}

parse_int(src: []i8, i: int, out: []int): int {
    n: int = len(src);
    i = skip_spaces(src, i);
    sign: int = 1;
    if (i < n && src[i] == '-') {
        sign = 0 - 1;
        i = i + 1;
    }
    i = parse_uint(src, i, out);
    if (out[0] < 0) {
        out[1] = 0;
        return i;
    }
    out[0] = out[0] * sign;
    out[1] = 1;
    i;
}

skip_line(src: []i8, i: int): int {
    n: int = len(src);
    while (i < n && src[i] != '\n') {
        i = i + 1;
    }
    if (i < n) {
        i = i + 1;
    }
    i;
}

put_ch(dst: []i8, i: int, c: i8): int {
    if (i >= 0 && i < len(dst)) {
        dst[i] = c;
    }
    i + 1;
}

put_str(dst: []i8, i: int, s: []i8): int {
    k: int = 0;
    while (k < len(s)) {
        i = put_ch(dst, i, s[k]);
        k = k + 1;
    }
    i;
}

put_uint(dst: []i8, i: int, n: int): int {
    if (n >= 10) {
        i = put_uint(dst, i, n / 10);
    }
    put_ch(dst, i, '0' + (n % 10) trunc i8);
}

put_int(dst: []i8, i: int, n: int): int {
    if (n < 0) {
        i = put_ch(dst, i, '-');
        n = 0 - n;
    }
    put_uint(dst, i, n);
}

slurp_path(path: []i8): []i8@new {
    fd: int = open_path(path, 0, 0);
    if (fd < 0) {
        return new i8[0](0i8);
    }
    cap: int = 65536;
    buf: []i8 = new i8[cap](0i8);
    n: int = 0;
    more: int = 1;
    while (more != 0) {
        if (n + 4096 >= cap) {
            cap = cap * 2;
            tmp: []i8 = new i8[cap](0i8);
            memcpy(tmp, 0, buf, 0, n);
            buf = tmp;
        }
        r: int = read(fd, buf, n, cap - n);
        if (r <= 0) {
            more = 0;
        } else {
            n = n + r;
        }
    }
    close(fd);
    src: []i8 = new i8[n](0i8);
    memcpy(src, 0, buf, 0, n);
    src;
}

take_title(src: []i8, i: int): []i8@new {
    n: int = len(src);
    i = skip_spaces(src, i);
    ts: int = i;
    te: int = i;
    while (te < n && src[te] != '\n' && src[te] != '\r') {
        te = te + 1;
    }
    while (te > ts && (src[te - 1] == ' ' || src[te - 1] == '\t')) {
        te = te - 1;
    }
    tn: int = te - ts;
    tbuf: []i8 = new i8[tn](0i8);
    if (tn > 0) {
        memcpy(tbuf, 0, src, ts, tn);
    }
    tbuf;
}

sort_checks(checks: []int, titles: [][]i8, nc: int) {
    a: int = 0;
    while (a < nc) {
        b: int = a + 1;
        while (b < nc) {
            if (checks[b] < checks[a]) {
                tc: int = checks[a];
                checks[a] = checks[b];
                checks[b] = tc;
                tt: []i8 = titles[a];
                titles[a] = titles[b];
                titles[b] = tt;
            }
            b = b + 1;
        }
        a = a + 1;
    }
}

migrate_old_checks(
    checks: []int,
    titles: [][]i8@room_titles,
    nc: int,
    rooms: []Room,
    room_titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int
) {
    sort_checks(checks, titles, nc);
    nr: int = nroom[0];
    ng: int = ngoal[0];
    i: int = 0;
    while (i + 1 < nc) {
        left: int = checks[i];
        right: int = checks[i + 1];
        title: []i8 = titles[i];
        nr = add_room(rooms, room_titles, nr, left, 0, right, 8, title);
        if (!is_goal(goals, ng, right, 4)) {
            ng = toggle_goal(goals, ng, right, 4);
        }
        i = i + 1;
    }
    nroom[0] = nr;
    ngoal[0] = ng;
}

parse_level_src(
    src: []i8,
    blocks: []Block,
    rooms: []Room,
    titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    start: []int
): int {
    n: int = len(src);
    nb: int = 0;
    nr: int = 0;
    ng: int = 0;
    nw: int = 0;
    nc: int = 0;
    old_c: []int = new int[64](0);
    old_t: [][]i8 = new []i8[64](new i8[0](0i8));
    i: int = 0;
    val: []int = new int[2](0);
    start[0] = 0;
    start[1] = 0;
    while (i < n) {
        i = skip_spaces(src, i);
        if (i >= n) {
            i = n;
        } else if (src[i] == '\n') {
            i = i + 1;
        } else if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (i + 4 <= n && src[i] == 'r' && src[i + 1] == 'o' && src[i + 2] == 'o' && src[i + 3] == 'm') {
            i = i + 4;
            i = parse_int(src, i, val);
            x0: int = val[0];
            ok0: int = val[1];
            i = parse_int(src, i, val);
            y0: int = val[0];
            ok1: int = val[1];
            i = parse_int(src, i, val);
            x1: int = val[0];
            ok2: int = val[1];
            i = parse_int(src, i, val);
            y1: int = val[0];
            if (ok0 == 0 || ok1 == 0 || ok2 == 0 || val[1] == 0 || !in_bounds(x0, y0) || !in_bounds(x1, y1)) {
                return 0 - 1;
            }
            nr = add_room(rooms, titles, nr, x0, y0, x1, y1, take_title(src, i));
            i = skip_line(src, i);
        } else {
            cmd: i8 = src[i];
            i = i + 1;
            if (cmd == 'c') {
                i = parse_int(src, i, val);
                if (val[1] == 0 || !in_bounds(val[0], 0)) {
                    return 0 - 1;
                }
                if (nc < 64) {
                    old_c[nc] = val[0];
                    old_t[nc] = take_title(src, i);
                    nc = nc + 1;
                }
            } else if (cmd == 'g' || cmd == 'w' || cmd == 'p') {
                i = parse_int(src, i, val);
                colg: int = val[0];
                okg: int = val[1];
                i = parse_int(src, i, val);
                rowg: int = val[0];
                if (okg == 0 || val[1] == 0 || !in_bounds(colg, rowg)) {
                    return 0 - 1;
                }
                if (cmd == 'p') {
                    start[0] = colg;
                    start[1] = rowg;
                } else if (cmd == 'g') {
                    if (!is_goal(goals, ng, colg, rowg)) {
                        ng = toggle_goal(goals, ng, colg, rowg);
                    }
                } else {
                    if (!is_brick(bricks, nw, colg, rowg)) {
                        nw = toggle_brick(bricks, nw, colg, rowg);
                    }
                }
            } else if (cmd == 'b' || cmd == 's' || cmd == 'r') {
                i = parse_int(src, i, val);
                col: int = val[0];
                okc: int = val[1];
                i = parse_int(src, i, val);
                row: int = val[0];
                if (okc == 0 || val[1] == 0) {
                    return 0 - 1;
                }
                shape: int = 0;
                ramp: int = 0;
                layer: int = 0;
                if (cmd == 's') {
                    i = parse_uint(src, i, val);
                    shape = val[0];
                } else if (cmd == 'r') {
                    i = parse_uint(src, i, val);
                    ramp = val[0];
                    if (ramp < 1 || ramp > 4) {
                        return 0 - 1;
                    }
                }
                i = skip_spaces(src, i);
                if (i < n && src[i] >= '0' && src[i] <= '9') {
                    i = parse_uint(src, i, val);
                    layer = val[0];
                }
                mounted: int = 0;
                i = skip_spaces(src, i);
                if (i < n && src[i] >= '0' && src[i] <= '9') {
                    i = parse_uint(src, i, val);
                    mounted = val[0];
                }
                if (!in_bounds(col, row) || layer < 0 || layer >= LEVEL_MAX_LAYER) {
                    return 0 - 1;
                }
                if (nb < len(blocks)) {
                    blocks[nb] = Block {
                        id: nb,
                        column: col,
                        row: row,
                        shape: shape,
                        layer: layer,
                        ramp: ramp,
                        mounted: mounted
                    };
                    nb = nb + 1;
                }
            } else {
                return 0 - 1;
            }
            i = skip_line(src, i);
        }
    }
    nroom[0] = nr;
    ngoal[0] = ng;
    nbrick[0] = nw;
    if (nr == 0 && nc > 0) {
        migrate_old_checks(old_c, old_t, nc, rooms, titles, nroom, goals, ngoal);
    }
    nb;
}

load_level(
    path: []i8,
    blocks: []Block,
    rooms: []Room,
    titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    start: []int
): int {
    src: []i8 = slurp_path(path);
    if (len(src) == 0) {
        fd: int = open_path(path, 0, 0);
        if (fd < 0) {
            return 0 - 1;
        }
        close(fd);
    }
    parse_level_src(src, blocks, rooms, titles, nroom, goals, ngoal, bricks, nbrick, start);
}

save_level(
    path: []i8,
    blocks: []Block,
    n: int,
    rooms: []Room,
    titles: [][]i8,
    nroom: int,
    goals: []Goal,
    ngoal: int,
    bricks: []Brick,
    nbrick: int,
    pc: int,
    pr: int
): int {
    cap: int = 65536;
    dst: []i8 = new i8[cap](0i8);
    i: int = 0;
    i = put_str(dst, i, "# L8 block-game level\n");
    i = put_str(dst, i, "# room x0 y0 x1 y1 Title\n");
    i = put_str(dst, i, "# g <column> <row>\n");
    i = put_str(dst, i, "# w <column> <row>\n");
    i = put_str(dst, i, "# p <column> <row>\n");
    i = put_str(dst, i, """
# b <column> <row> [layer]
# s <column> <row> <sides> [layer]
# r <column> <row> <dir> [layer]

""");
    k: int = 0;
    while (k < nroom) {
        r: Room = rooms[k];
        i = put_str(dst, i, "room ");
        i = put_int(dst, i, r.x0);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, r.y0);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, r.x1);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, r.y1);
        if (k < len(titles) && len(titles[k]) > 0) {
            i = put_ch(dst, i, ' ');
            i = put_str(dst, i, titles[k]);
        }
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < ngoal) {
        i = put_ch(dst, i, 'g');
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, goals[k].column);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, goals[k].row);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    k = 0;
    while (k < nbrick) {
        i = put_ch(dst, i, 'w');
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, bricks[k].column);
        i = put_ch(dst, i, ' ');
        i = put_int(dst, i, bricks[k].row);
        i = put_ch(dst, i, '\n');
        k = k + 1;
    }
    i = put_ch(dst, i, 'p');
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, pc);
    i = put_ch(dst, i, ' ');
    i = put_int(dst, i, pr);
    i = put_ch(dst, i, '\n');
    i = put_ch(dst, i, '\n');
    k = 0;
    while (k < n) {
        b: Block = blocks[k];
        if (b.ramp != 0) {
            i = put_ch(dst, i, 'r');
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.ramp);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        } else if (b.shape != 0) {
            i = put_ch(dst, i, 's');
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row);
            i = put_ch(dst, i, ' ');
            i = put_uint(dst, i, b.shape);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        } else {
            i = put_ch(dst, i, 'b');
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.column);
            i = put_ch(dst, i, ' ');
            i = put_int(dst, i, b.row);
            if (b.layer != 0 || b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.layer);
            }
            if (b.mounted != 0) {
                i = put_ch(dst, i, ' ');
                i = put_uint(dst, i, b.mounted);
            }
            i = put_ch(dst, i, '\n');
        }
        k = k + 1;
    }
    if (i > cap) {
        return 0 - 1;
    }
    fd: int = open_path(path, LEVEL_O_WRONLY + LEVEL_O_CREAT + LEVEL_O_TRUNC, LEVEL_MODE);
    if (fd < 0) {
        return 0 - 1;
    }
    w: int = write(fd, dst, i);
    close(fd);
    if (w != i) {
        return 0 - 1;
    }
    0;
}

copy_blocks(
    dst: []Block,
    doff: int,
    src: []Block,
    soff: int,
    n: int
) {
    i: int = 0;
    while (i < n) {
        dst[doff + i] = src[soff + i];
        i = i + 1;
    }
}

occupant_blocks(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip_shape: int,
    rooms: []Room,
    nroom: int,
    refc: int,
    refr: int
): int {
    i: int = 0;
    while (i < n) {
        o: Block = blocks[i];
        if (o.column == column && o.row == row && o.layer == layer) {
            if (skip_shape != 0 && o.shape == skip_shape && same_room(rooms, nroom, o.column, o.row, refc, refr)) {
                i = i + 1;
            } else {
                return i;
            }
        } else {
            i = i + 1;
        }
    }
    0 - 1;
}

occupant_bodies(
    blocks: []Block,
    n: int,
    column: int,
    row: int,
    layer: int,
    skip_shape: int,
    rooms: []Room,
    nroom: int,
    refc: int,
    refr: int
): int {
    i: int = 0;
    while (i < n) {
        o: Block = blocks[i];
        if (o.column == column && o.row == row && o.layer == layer && (o.ramp == 0 || o.mounted != 0)) {
            if (skip_shape != 0 && o.shape == skip_shape && same_room(rooms, nroom, o.column, o.row, refc, refr)) {
                i = i + 1;
            } else {
                return i;
            }
        } else {
            i = i + 1;
        }
    }
    0 - 1;
}

dest_clear(
    blocks: []Block,
    n: int,
    tc: int,
    tr: int,
    tl: int,
    dc: int,
    dr: int,
    skip: int,
    rooms: []Room,
    nroom: int,
    refc: int,
    refr: int
): bool {
    if (occupant_bodies(blocks, n, tc, tr, tl, skip, rooms, nroom, refc, refr) >= 0) {
        return false;
    }
    rp: int = ramp_at_layer(blocks, n, tc, tr, tl);
    if (rp >= 0 && !is_mount_face(blocks[rp].ramp, dc, dr)) {
        return false;
    }
    true;
}

will_climb(
    blocks: []Block,
    n: int,
    bi: int,
    dc: int,
    dr: int
): int {
    b: Block = blocks[bi];
    home: int = ramp_at_layer(blocks, n, b.column, b.row, b.layer);
    if (home == bi) {
        home = 0 - 1;
    }
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr)) {
        if (flat_at_layer(blocks, n, b.column + dc, b.row + dr, b.layer) >= 0) {
            return 1;
        }
    }
    0;
}

mark_push_group(
    blocks: []Block,
    n: int,
    hit: int,
    rooms: []Room,
    nroom: int,
    marks: []int
) {
    hb: Block = blocks[hit];
    i: int = 0;
    if (hb.shape != 0 && room_at(rooms, nroom, hb.column, hb.row) >= 0) {
        while (i < n) {
            s: Block = blocks[i];
            if (s.shape == hb.shape && same_room(rooms, nroom, s.column, s.row, hb.column, hb.row)) {
                marks[i] = 1;
            }
            i = i + 1;
        }
    } else {
        marks[hit] = 1;
    }
    grown: int = 1;
    while (grown != 0) {
        grown = 0;
        i = 0;
        while (i < n) {
            if (marks[i] != 0) {
                b: Block = blocks[i];
                above: int = body_at_layer(blocks, n, b.column, b.row, b.layer + 1);
                if (above >= 0 && marks[above] == 0) {
                    marks[above] = 1;
                    grown = 1;
                }
            }
            i = i + 1;
        }
    }
}

lowest_marked(
    blocks: []Block,
    n: int,
    marks: []int,
    column: int,
    row: int
): int {
    best: int = 0 - 1;
    best_l: int = LEVEL_MAX_LAYER;
    i: int = 0;
    while (i < n) {
        if (marks[i] != 0) {
            b: Block = blocks[i];
            if (b.column == column && b.row == row && b.layer < best_l) {
                best = i;
                best_l = b.layer;
            }
        }
        i = i + 1;
    }
    best;
}

can_move_marked(
    blocks: []Block,
    n: int,
    bricks: []Brick,
    nbrick: int,
    marks: []int,
    dc: int,
    dr: int
): bool {
    i: int = 0;
    while (i < n) {
        if (marks[i] != 0) {
            b: Block = blocks[i];
            tc: int = b.column + dc;
            tr: int = b.row + dr;
            if (!in_bounds(tc, tr) || is_brick(bricks, nbrick, tc, tr)) {
                return false;
            }
            lo: int = lowest_marked(blocks, n, marks, b.column, b.row);
            climb: int = 0;
            if (lo >= 0) {
                climb = will_climb(blocks, n, lo, dc, dr);
            }
            tl: int = b.layer + climb;
            if (tl < 0 || tl >= LEVEL_MAX_LAYER) {
                return false;
            }
            occ: int = body_at_layer(blocks, n, tc, tr, tl);
            if (occ >= 0 && marks[occ] == 0) {
                return false;
            }
            rp: int = ramp_at_layer(blocks, n, tc, tr, tl);
            if (rp >= 0 && marks[rp] == 0 && !is_mount_face(blocks[rp].ramp, dc, dr)) {
                return false;
            }
        }
        i = i + 1;
    }
    true;
}

slide_marked(
    blocks: []Block,
    n: int,
    marks: []int,
    dc: int,
    dr: int
) {
    climbs: []int = new int[n](0);
    i: int = 0;
    while (i < n) {
        if (marks[i] != 0) {
            b: Block = blocks[i];
            lo: int = lowest_marked(blocks, n, marks, b.column, b.row);
            if (lo >= 0) {
                climbs[i] = will_climb(blocks, n, lo, dc, dr);
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if (marks[i] != 0) {
            b2: Block = blocks[i];
            b2.column = b2.column + dc;
            b2.row = b2.row + dr;
            b2.layer = b2.layer + climbs[i];
            blocks[i] = b2;
        }
        i = i + 1;
    }
}

can_move_block(
    blocks: []Block,
    n: int,
    bricks: []Brick,
    nbrick: int,
    bi: int,
    dc: int,
    dr: int
): bool {
    marks: []int = new int[n](0);
    marks[bi] = 1;
    can_move_marked(blocks, n, bricks, nbrick, marks, dc, dr);
}

apply_gravity(blocks: []Block, n: int) {
    moved: int = 1;
    while (moved != 0) {
        moved = 0;
        i: int = 0;
        while (i < n) {
            b: Block = blocks[i];
            nl: int = settle_layer(blocks, n, b.column, b.row, b.layer, i);
            nm: int = pose_mounted(blocks, n, b.column, b.row, nl, i);
            if (nl != b.layer || nm != b.mounted) {
                b.layer = nl;
                b.mounted = nm;
                blocks[i] = b;
                moved = 1;
            }
            i = i + 1;
        }
    }
}

slide_one(
    blocks: []Block,
    n: int,
    i: int,
    dc: int,
    dr: int
) {
    b: Block = blocks[i];
    tc: int = b.column + dc;
    tr: int = b.row + dr;
    tl: int = b.layer;
    home: int = ramp_at_layer(blocks, n, b.column, b.row, b.layer);
    if (home == i) {
        home = 0 - 1;
    }
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr)) {
        if (flat_at_layer(blocks, n, tc, tr, tl) >= 0) {
            tl = tl + 1;
        }
    }
    b.column = tc;
    b.row = tr;
    b.layer = settle_layer(blocks, n, tc, tr, tl, i);
    b.mounted = pose_mounted(blocks, n, tc, tr, b.layer, i);
    blocks[i] = b;
}

try_push(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    hit: int,
    dc: int,
    dr: int
): bool {
    marks: []int = new int[n](0);
    mark_push_group(blocks, n, hit, rooms, nroom, marks);
    if (!can_move_marked(blocks, n, bricks, nbrick, marks, dc, dr)) {
        return false;
    }
    slide_marked(blocks, n, marks, dc, dr);
    apply_gravity(blocks, n);
    true;
}

finish_move(
    blocks: []Block,
    n: int,
    pc: int,
    pr: int,
    ph: int
): int {
    ph = settle_layer(blocks, n, pc, pr, ph, 0 - 1);
    if (body_at_layer(blocks, n, pc, pr, ph) >= 0) {
        return 0 - 1;
    }
    pack_pos(pc, pr, ph, pose_mounted(blocks, n, pc, pr, ph, 0 - 1));
}

enter_at(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    tc: int,
    tr: int,
    ph: int,
    dc: int,
    dr: int
): int {
    if (is_brick(bricks, nbrick, tc, tr)) {
        return 0 - 1;
    }
    dest_body: int = body_at_layer(blocks, n, tc, tr, ph);
    dest_ramp: int = ramp_at_layer(blocks, n, tc, tr, ph);
    if (dest_ramp >= 0 && dest_body < 0 && is_mount_face(blocks[dest_ramp].ramp, dc, dr)) {
        return finish_move(blocks, n, tc, tr, ph);
    }
    hit: int = dest_body;
    if (hit >= 0 && dest_ramp >= 0 && !is_mount_face(blocks[dest_ramp].ramp, dc, dr)) {
        return 0 - 1;
    }
    if (hit < 0) {
        hit = dest_ramp;
    }
    if (hit >= 0) {
        if (!try_push(blocks, n, rooms, nroom, bricks, nbrick, hit, dc, dr)) {
            return 0 - 1;
        }
    }
    finish_move(blocks, n, tc, tr, ph);
}

move_player(
    blocks: []Block,
    n: int,
    rooms: []Room,
    nroom: int,
    bricks: []Brick,
    nbrick: int,
    pc: int,
    pr: int,
    ph: int,
    dc: int,
    dr: int
): int {
    stay: int = pack_pos(pc, pr, ph, pose_mounted(blocks, n, pc, pr, ph, 0 - 1));
    tc: int = pc + dc;
    tr: int = pr + dr;
    if (!in_bounds(tc, tr) || is_brick(bricks, nbrick, tc, tr)) {
        return stay;
    }
    dest_flat: int = flat_at_layer(blocks, n, tc, tr, ph);
    home: int = ramp_at_layer(blocks, n, pc, pr, ph);
    if (home >= 0 && is_mount_face(blocks[home].ramp, dc, dr) && dest_flat >= 0) {
        if (ph + 1 < LEVEL_MAX_LAYER) {
            landed: int = enter_at(blocks, n, rooms, nroom, bricks, nbrick, tc, tr, ph + 1, dc, dr);
            if (landed >= 0) {
                return landed;
            }
        }
        return stay;
    }
    landed2: int = enter_at(blocks, n, rooms, nroom, bricks, nbrick, tc, tr, ph, dc, dr);
    if (landed2 < 0) {
        return stay;
    }
    landed2;
}

looks_like_grid(src: []i8): bool {
    i: int = 0;
    n: int = len(src);
    while (i < n) {
        if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (src[i] == '\n' || src[i] == '\r' || src[i] == ' ' || src[i] == '\t') {
            i = i + 1;
        } else {
            return src[i] == '=';
        }
    }
    false;
}

grid_shape(ch: i8): int {
    if (ch == '3') {
        return 3;
    }
    if (ch == '4') {
        return 4;
    }
    if (ch == '5') {
        return 5;
    }
    if (ch == '6') {
        return 6;
    }
    if (ch == '7' || ch == 'F' || ch == '*') {
        return 15;
    }
    0;
}

add_grid_block(
    blocks: []Block,
    nb: int,
    col: int,
    row: int,
    shape: int
): int {
    add_grid_piece(blocks, nb, col, row, shape, 0, 0);
}

add_grid_piece(
    blocks: []Block,
    nb: int,
    col: int,
    row: int,
    shape: int,
    layer: int,
    ramp: int
): int {
    if (nb >= len(blocks) || !in_bounds(col, row)) {
        return nb;
    }
    blocks[nb] = Block {
        id: nb,
        column: col,
        row: row,
        shape: shape,
        layer: layer,
        ramp: ramp,
        mounted: 0
    };
    nb + 1;
}

grid_ramp(ch: i8): int {
    if (ch == '>') {
        return 1;
    }
    if (ch == '<') {
        return 2;
    }
    if (ch == 'v' || ch == 'V') {
        return 3;
    }
    if (ch == '^') {
        return 4;
    }
    0;
}

copy_title(src: []i8, a: int, b: int): []i8@new {
    while (a < b && src[a] == ' ') {
        a = a + 1;
    }
    while (b > a && (src[b - 1] == ' ' || src[b - 1] == '\t')) {
        b = b - 1;
    }
    tn: int = b - a;
    if (tn < 0) {
        tn = 0;
    }
    tbuf: []i8 = new i8[tn](0i8);
    if (tn > 0) {
        memcpy(tbuf, 0, src, a, tn);
    }
    tbuf;
}

load_grid_src(
    src: []i8,
    blocks: []Block,
    rooms: []Room,
    titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    start: []int
): int {
    n: int = len(src);
    nb: int = 0;
    nr: int = 0;
    ng: int = 0;
    col0: int = 0;
    title: []i8 = new i8[0](0i8);
    start[0] = 0;
    start[1] = 0;
    have_start: int = 0;
    i: int = 0;
    while (i < n) {
        if (src[i] == '#') {
            i = skip_line(src, i);
        } else if (src[i] == '\n' || src[i] == '\r') {
            i = i + 1;
        } else if (src[i] == '=') {
            i = i + 1;
            ts: int = i;
            while (i < n && src[i] != '\n' && src[i] != '\r') {
                i = i + 1;
            }
            title = copy_title(src, ts, i);
            rows: [][]i8 = new []i8[9](new i8[0](0i8));
            nrow: int = 0;
            width: int = 0;
            if (i < n && src[i] == '\r') {
                i = i + 1;
            }
            if (i < n && src[i] == '\n') {
                i = i + 1;
            }
            more: int = 1;
            while (more != 0 && i < n) {
                if (src[i] == '=') {
                    more = 0;
                } else if (src[i] == '\n' || src[i] == '\r') {
                    more = 0;
                } else {
                    rs: int = i;
                    while (i < n && src[i] != '\n' && src[i] != '\r') {
                        i = i + 1;
                    }
                    rl: int = i - rs;
                    if (nrow < 9) {
                        row: []i8 = new i8[rl](0i8);
                        memcpy(row, 0, src, rs, rl);
                        rows[nrow] = row;
                        if (rl > width) {
                            width = rl;
                        }
                        nrow = nrow + 1;
                    }
                    if (i < n && src[i] == '\r') {
                        i = i + 1;
                    }
                    if (i < n && src[i] == '\n') {
                        i = i + 1;
                    }
                }
            }
            if (width < 1 || nrow < 1) {
                return 0 - 1;
            }
            c: int = 0;
            while (c < width) {
                wc: int = col0 + c;
                r: int = 0;
                while (r < nrow) {
                    row2: []i8 = rows[r];
                    ch: i8 = '.';
                    if (c < len(row2)) {
                        ch = row2[c];
                    }
                    if (ch == '@') {
                        start[0] = wc;
                        start[1] = r;
                        have_start = 1;
                    } else if (ch == '#') {
                        nb = add_grid_block(blocks, nb, wc, r, 0);
                    } else if (ch != '|') {
                        rp: int = grid_ramp(ch);
                        if (rp != 0) {
                            nb = add_grid_piece(blocks, nb, wc, r, 0, 0, rp);
                        } else {
                            sh: int = grid_shape(ch);
                            if (sh != 0) {
                                nb = add_grid_block(blocks, nb, wc, r, sh);
                            }
                        }
                    }
                    r = r + 1;
                }
                c = c + 1;
            }
            x1: int = col0 + width - 1;
            y1: int = nrow - 1;
            nr = add_room(rooms, titles, nr, col0, 0, x1, y1, title);
            mid: int = y1 / 2;
            if (!is_goal(goals, ng, x1, mid)) {
                ng = toggle_goal(goals, ng, x1, mid);
            }
            col0 = col0 + width;
        } else {
            return 0 - 1;
        }
    }
    if (have_start == 0 && nr > 0) {
        start[0] = rooms[0].x0;
        start[1] = rooms[0].y0;
    }
    nroom[0] = nr;
    ngoal[0] = ng;
    nbrick[0] = 0;
    if (len(bricks) < 0) {
        nbrick[0] = 0;
    }
    nb;
}

load_any(
    path: []i8,
    blocks: []Block,
    rooms: []Room,
    titles: [][]i8,
    nroom: []int,
    goals: []Goal,
    ngoal: []int,
    bricks: []Brick,
    nbrick: []int,
    start: []int
): int {
    src: []i8 = slurp_path(path);
    if (len(src) == 0) {
        fd: int = open_path(path, 0, 0);
        if (fd < 0) {
            return 0 - 1;
        }
        close(fd);
    }
    start[0] = 0;
    start[1] = 0;
    nroom[0] = 0;
    ngoal[0] = 0;
    nbrick[0] = 0;
    if (looks_like_grid(src)) {
        return load_grid_src(src, blocks, rooms, titles, nroom, goals, ngoal, bricks, nbrick, start);
    }
    parse_level_src(src, blocks, rooms, titles, nroom, goals, ngoal, bricks, nbrick, start);
}
