tag function_test;

type Small = {
    n: i32;
};

type Big = {
    a: int;
    b: int;
    c: int;
};

type Choice =
    | Empty
    | Value { data: Big };

small(s: Small): Small {
    Small { n: s.n + 1i32 };
}

big(
    a: Big,
    b: Big,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int
): Big {
    a.a = a.a + b.a + c + d + e + f + g;
    a.b = a.b + b.b;
    a.c = a.c + b.c;
    a;
}

make(n: int): Big {
    Big { a: n, b: n + 1, c: n + 2 };
}

get(): fn(n: int): Big {
    &make;
}

sum(xs: []int): int {
    xs[0] + xs[1] + xs[2];
}

strsize(s: str): int {
    len(s);
}

array(xs: [3]int): [3]int {
    xs[1] = xs[1] + 10;
    xs;
}

choice(c: Choice): Choice {
    c;
}

allocate(n: int): []int@new {
    new int[3](n);
}

borrow(xs: []int): []int@xs {
    xs;
}

main(argc: int, argv: []str): int {
    sm: fn(s: Small): Small = &small;
    small_result: Small = sm(Small { n: 4i32 });
    if (small_result.n != 5i32) {
        return 1;
    }
    bg: fn(a: Big, b: Big, c: int, d: int, e: int, f: int, g: int): Big = &big;
    source: Big = make(1);
    result: Big = bg(source, get()(10), 3, 4, 5, 6, 7);
    if (source.a != 1 || result.a != 36 || result.b != 13 || result.c != 15) {
        return 2;
    }
    nested: Big = bg(bg(make(1), make(2), 3, 4, 5, 6, 7), make(8), 9, 10, 11, 12,
        13);
    if (nested.a != 91 || nested.b != 14 || nested.c != 17) {
        return 3;
    }
    fn: fn(xs: []int): int = &sum;
    cfn: int = 3;
    if (fn([cfn, 4, 5]) != 12) {
        return 4;
    }
    size: fn(s: str): int = &strsize;
    if (argc < 1 || size(argv[0]) != len(argv[0])) {
        return 5;
    }
    arr: fn(xs: [3]int): [3]int = &array;
    xs: [3]int = [1, 2, 3];
    ys: [3]int = arr(arr(xs));
    if (xs[1] != 2 || ys[0] != 1 || ys[1] != 22 || ys[2] != 3) {
        return 6;
    }
    choose: fn(c: Choice): Choice = &choice;
    match choose(Choice.Value { data: get()(20) }) {
        Empty -> {
            return 7;
        }
        Value v -> {
            if (v.data.a != 20 || v.data.c != 22) {
                return 8;
            }
        }
    }
    alloc: fn(n: int): []int@new = &allocate;
    id: fn(values: []int): []int@values = &borrow;
    region {
        values: []int = id(alloc(14));
        if (fn(values) != 42) {
            return 9;
        }
    }
    write(1, "native fn OK\n", 13);
    0;
}
