tag alias_test;

need "libc.so.6";

// Two independently checked declarations can address the same C entry point.
extern signed_abs(value: i32): i32 = abs;

extern other_abs(n: i32): i32 = abs;

extern compare_bytes(a: *i8, b: *i8): i32 = strcmp;

extern compare_strings(a: str, b: str): i32 = strcmp;

main(): int {
    if (signed_abs(-42i32) != 42i32 || other_abs(-7i32) != 7i32) return 1;
    a: []i8 = "same";
    b: []i8 = "same";
    if (compare_bytes(a, b) != 0i32 || compare_strings("equal", "equal") != 0i32) return 2;
    write(1, "extern aliases OK\n", 18);
    0;
}
