tag callback_test;

need "libcallback-test.so";

type Listener = {
    notify: fn(state: *i32, serial: u32, number: f32);
    calculate: fn(n: int): int;
    optional: ?fn();
};

extern cb_register(listener: *Listener@immortal): int;

extern cb_dispatch(state: *i32): int;

extern cb_get(): fn(n: int): int;

extern cb_alignment(): int;

extern cb_registers(f: fn(n: int): int): int;

extern cb_mixed(f: fn(a: i32, b: f64, c: int, d: f32, e: u32, f: f64, g: int, h: int, i: int, j: int, k: f64, l: f64, m: f64, n: f64, o: f64, p: f64, q: f64): f64): int;

notify(state: *i32, serial: u32, number: f32) {
    state.* = (serial as int + number as int) trunc i32;
}

twice(n: int): int {
    n * 2;
}

mixed(
    a: i32,
    b: f64,
    c: int,
    d: f32,
    e: u32,
    f: f64,
    g: int,
    h: int,
    i: int,
    j: int,
    k: f64,
    l: f64,
    m: f64,
    n: f64,
    o: f64,
    p: f64,
    q: f64
): f64 {
    a as f64 + b + c as f64 + d as f64 + e as f64 + f + g as f64 + h as f64 + i as f64 + j as f64 + k + l + m + n + o + p + q;
}

number(n: int): int {
    n;
}

real(n: f64): f64 {
    n;
}

exception Local;

fail() raises Local {
    raise Local;
}

exercise(n: int): int {
    region {
        values: []int = [n, n + 1, n + 2];
        scratch: []int = new int[n](0);
        for i in 0..n scratch[i] = values[i % 3];
        if (scratch[n - 1] != n + (n - 1) % 3) return 0;
    }
    // Unwind only to a handler in the callback, while the C caller has live
    // callee-saved registers and a stack frame underneath us.
    try {
        fail();
    } with Local -> { }
    cb_alignment();
}

listener: Listener = Listener { notify: &notify, calculate: &twice, optional: null };

main(): int {
    cb_register(&listener);
    state: i32 = 0i32;
    if (cb_dispatch(&state) != 0 || state != 19i32) return 1;
    if (cb_get()(39) != 42) return 2;
    if (cb_mixed(&mixed) != 0) return 3;
    callback: fn(a: i32, b: f64, c: int, d: f32, e: u32, f: f64, g: int, h: int, i: int, j: int, k: f64, l: f64, m: f64, n: f64, o: f64, p: f64, q: f64): f64 = &mixed;
    // Nested argument calls must not overwrite the target or SSE spill address.
    result: f64 = callback(-3i32, real(1.5f64), number(11), 2.5, 4000000000u32, real(3.5f64),
        number(13), 17, 19, number(23), 4.5f64, 5.5f64, 6.5f64, 7.5f64, 8.5f64, real(9.5f64),
        real(10.5f64));
    if (result != 4000000140.0f64) return 4;
    if (cb_registers(&exercise) != 0) return 5;
    write(1, "C ABI OK\n", 9);
    0;
}
