tag callback_test;

need "libc.so.6";

extern qsort(
    base: *i32,
    count: int,
    width: int,
    compare: fn(a: *i32, b: *i32): i32
): int;

compare(a: *i32, b: *i32): i32 {
    if (a.* < b.*) return -1i32;
    if (a.* > b.*) return 1i32;
    0i32
}

twice(n: int): int {
    n * 2
}

identity(p: *i32): *i32@p {
    p
}

set(p: *i32, n: i32) {
    p.* = n
}

type Listener = {
    compare: fn(left: *i32, right: *i32): i32;
    set: fn(value: *i32, number: i32);
    unused: ?fn()
}

global_callback: fn(value: int): int = &twice;

get_callback(): fn(x: int): int {
    &twice
}

main(): int {
    a: i32 = 3i32;
    b: i32 = 7i32;
    callback: fn(left: *i32, right: *i32): i32 = &compare;
    if (callback(&a, &b) != -1i32) return 1;
    listener: Listener = Listener { compare: &compare, set: &set, unused: null };
    if (sizeof(Listener) != 24) return 2;
    if (listener.compare(&b, &a) != 1i32) return 3;
    listener.set(&a, 9i32);
    if (a != 9i32) return 4;
    optional: ?fn(value: int): int = null;
    if (optional != null) return 5;
    optional = &twice;
    if (optional != null) {
        if (optional(21) != 42) return 6
    }
    optional = null;
    fallback: fn(x: int): int = optional or &twice;
    if (fallback(12) != 24 || global_callback(13) != 26 || get_callback()(14) != 28) return 7;
    pointers: []fn(x: int): int = [&twice, &twice];
    if (pointers[1](15) != 30) return 8;
    id: fn(value: *i32): *i32@value = &identity;
    p: *i32 = id(&a);
    if (p.* != 9i32) return 9;
    values: []i32 = [9i32, -4i32, 2i32, 7i32, 2i32, 0i32];
    qsort(values, len(values), 4, &compare);
    if (values[0] != -4i32 || values[1] != 0i32 || values[2] != 2i32 || values[3] != 2i32 || values[4] != 7i32 || values[5] != 9i32) return 10;
    write(1, "callbacks OK\n", 13);
    0
}

//% test: run
//% stdout: "callbacks OK\n"
//% exit: 0
