tag utf8_internal;

// Validate exactly the prefix, including its final complete code point.
// Invalid spans return false without reading outside the input.
tag utf8
utf8_valid_prefix(data: []i8, size: int): bool {
    if (size < 0 || size > len(data)) return false;
    p: int = 0;
    while (p < size) {
        a: int = data[p] as int & 255;
        if (a < 128) p = p + 1 else {
            need: int = 0;
            min: int = 0;
            value: int = 0;
            if (a >= 194 && a <= 223) {
                need = 1;
                min = 128;
                value = a & 31
            } else {
                if (a >= 224 && a <= 239) {
                    need = 2;
                    min = 2048;
                    value = a & 15
                } else {
                    if (a >= 240 && a <= 244) {
                        need = 3;
                        min = 65536;
                        value = a & 7
                    } else return false
                }
            }
            if (p + need >= size) return false;
            for i in 1..need + 1 {
                next: int = data[p + i] as int & 255;
                if (next < 128 || next > 191) return false;
                value = value << 6 | next & 63
            }
            if (value < min || value > 1114111 || value >= 55296 && value <= 57343) return false;
            p = p + need + 1
        }
    }
    true
}
