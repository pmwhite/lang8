tag archive_test;

use_tag std, deflate, archive;

// The library's contract by example. The archives were made by Python's
// zipfile, tarfile and gzip modules.
import "archive.l8";

import "../../stdlib/print.l8";

hex_digit(c: i8): int {
    k: int = c as int;
    if (k >= 97) k - 87 else k - 48
}

from_hex(text: str): []i8@new {
    out: []i8 = new i8[len(text) / 2](0i8);
    for i in 0..len(out) out[i] = (hex_digit(text[2 * i]) * 16 + hex_digit(text[2 * i + 1])) trunc i8;
    out
}

method_name(method: ZipMethod): str {
    match method {
        Stored -> "stored";
        Deflated -> "deflated";
        OtherMethod _other -> "other"
    }
}

// A folder, a stored file and a deflated one.
zip_hex: str = "";

test "a zip's entries and their data" {
    zip: []i8 = from_hex(zip_hex);
    try {
        entries: []ZipEntry = zip_entries(zip, len(zip));
        for i in 0..len(entries) {
            print(entries[i].name);
            print(method_name(entries[i].method));
            print_int(entries[i].size);
            print_bool(zip_entry_is_folder(&entries[i]))
        }
        expect {|
            mods.d/
            stored
            0
            true
            mods.d/web.conf
            stored
            19
            false
            readme.txt
            deflated
            53
            false
        |}
        conf: int = zip_entry_index(entries, "mods.d/web.conf");
        print(cstr(zip_entry_bytes(zip, len(zip), &entries[conf])));
        readme: int = zip_entry_index(entries, "readme.txt");
        print(cstr(zip_entry_bytes(zip, len(zip), &entries[readme])));
        print_int(zip_entry_index(entries, "missing.txt"));
        expect {|
            [WEB]
            ModDrv=zText

            Hallelujah! Hallelujah! Hallelujah! Praise the LORD.

            -1
        |}
    } with ArchiveError error -> {
        print(archive_failure_name(error.failure))
    }
}

test "damage is reported" {
    // (The stored file's [WEB] changed to [WEX].)
    zip: []i8 = from_hex("");
    try {
        entries: []ZipEntry = zip_entries(zip, len(zip));
        _conf: []i8 = zip_entry_bytes(zip, len(zip), &entries[1])
    } with ArchiveError error -> {
        print(archive_failure_name(error.failure))
    }
    expect {|
        entry checksum mismatch
    |}
    // (Its last 30 bytes cut off, the end of its central directory with
    // them.)
    whole: []i8 = from_hex(zip_hex);
    try {
        _entries: []ZipEntry = zip_entries(whole, len(whole) - 30)
    } with ArchiveError error -> {
        print(archive_failure_name(error.failure))
    }
    expect {|
        not a zip archive
    |}
}

test "a gzipped tar's members" {
    // (mods.d/kjv.conf, and a file whose name needs a GNU long name.)
    tgz: []i8 = from_hex("");
    try {
        tar: []i8 = gzip_decompress(tgz, 0, len(tgz));
        members: []TarEntry = tar_entries(tar, len(tar));
        for i in 0..len(members) {
            print(members[i].name);
            data: []i8 = new i8[members[i].size](0i8);
            memcpy(data, 0, tar, members[i].offset, members[i].size);
            print(cstr(data))
        }
    } with ArchiveError error -> {
        print(archive_failure_name(error.failure))
    } with DeflateError error -> {
        print(deflate_failure_name(error.failure))
    }
    expect {|
        mods.d/kjv.conf
        [KJV]

        mods.d/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.conf
        [Long]

    |}
}

// A tar header for name, of type_flag, its size field's 12 bytes given,
// with its checksum (the header's bytes summed, the checksum's own field
// counted as spaces), and a block of zeros after it.
tar_header(name: str, type_flag: i8, size_field: []i8): []i8@new {
    tar: []i8 = new i8[1024](0i8);
    for i in 0..len(name) tar[i] = name[i];
    memcpy(tar, 124, size_field, 0, 12);
    tar[156] = type_flag;
    for i in 148..156 tar[i] = ' ';
    sum: int = 0;
    for i in 0..512 sum = sum + (tar[i] as int & 255);
    for i in 0..6 tar[148 + i] = ('0' as int + (sum >> 15 - i * 3 & 7)) trunc i8;
    tar[154] = 0i8;
    tar
}

test "a tar member's size too large to hold is damage" {
    // (Base 256: the high bit set, then all ones.)
    huge: []i8 = new i8[12](255 trunc i8);
    huge[0] = 128 trunc i8;
    tar: []i8 = tar_header("a", '0', huge);
    try {
        _members: []TarEntry = tar_entries(tar, len(tar))
    } with ArchiveError error -> {
        print(archive_failure_name(error.failure))
    }
    expect {|
        malformed archive record
    |}
}

test "a zip's entries read a step at a time" {
    zip: []i8 = from_hex(zip_hex);
    try {
        entries: []ZipEntry = zip_entries(zip, len(zip));
        for name in ["mods.d/web.conf", "readme.txt"] {
            at: int = zip_entry_index(entries, name);
            reading: *ZipEntryReading = zip_entry_begin(zip, len(zip), &entries[at]);
            steps: int = 1;
            while (!zip_entry_step(reading, 5)) steps = steps + 1;
            print(cstr(zip_entry_data(reading)));
            print(if (steps > 1) "in steps" else "at once")
        }
    } with ArchiveError error -> {
        print(archive_failure_name(error.failure))
    }
    expect {|
        [WEB]
        ModDrv=zText

        in steps
        Hallelujah! Hallelujah! Hallelujah! Praise the LORD.

        in steps
    |}
}
