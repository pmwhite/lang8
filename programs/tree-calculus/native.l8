tag tree_calculus;

import "tree.l8";

native "reduce.s";

// The native evaluator uses the same permanent machine as the reference loop.
extern native_reduce(m: *Machine, a: int, b: int): int = tc_apply;

// Assembly enters these only at a declared storage boundary. Neither grows.
native_stack_grow(_m: *Machine): noreturn {
    fail("evaluation stack exhausted (16777216 frames)")
}

native_intern_grow(_m: *Machine, _u: int, _v: int): int {
    fail("tree arena exhausted (8388608 nodes)")
}

apply_native(m: *Machine, a: int, b: int): int {
    native_reduce(m, a, b)
}

native_machine(): *Machine {
    machine()
}
