tag tree_calculus;

import "native.l8";

// Deliberately tiny capacities exercise native slow paths and cache collisions.
// The executable also checks the shared L8/native binary layouts.
main(): int {
    if (sizeof(Node) != 8 || sizeof(Frame) != 24 || sizeof(Memo) != 16 || sizeof(Machine) != 56) return 1;
    m: *Machine = new Machine {
        nodes: new Node[4](Node { bits: 0 }),
        count: 2,
        node_cache: new Memo[1](Memo { key: 0, result: 0 }),
        memo: new Memo[1](Memo { key: 0, result: 0 }),
        stack: new Frame[2](Frame { kind: 0, a: 0, b: 0 }),
        top: 0,
        cold: new i8[65536](0i8)
    };
    result: int = 1;
    for i in 0..10000 {
        previous: int = result;
        result = apply_native(m, 1, previous);
        if (intern(m, previous, 0) != result) return 2;
        n: *Node = node(m, result);
        if (n.bits != previous) return 3;
        if (m.top != 0 || m.count != i + 3) return 4
    }
    // Prefix frames must survive a native call, including a stack relocation.
    push(m, 99, result, 1);
    identity: int = intern(m, intern(m, intern(m, 1, 0), 0), 1);
    if (apply_native(m, identity, result) != result) return 5;
    if (m.top != 1) return 6;
    saved: *Frame = pop(m);
    if (saved.kind != 99 || saved.a != result || saved.b != 1) return 7;
    // Disable automatic cache growth to force eviction in a one-slot cache.
    m.node_cache = new Memo[1](Memo { key: 0, result: 0 });
    first: int = native_reduce(m, 1, 1);
    second: int = native_reduce(m, 1, result);
    again: int = native_reduce(m, 1, 1);
    first_node: *Node = node(m, first);
    second_node: *Node = node(m, second);
    again_node: *Node = node(m, again);
    if (first == again || first_node.bits != 1 || again_node.bits != 1 || second_node.bits != result) return 11;
    // Colliding application keys are checked exactly, not accepted by hash.
    m.memo = new Memo[1](Memo { key: 0, result: 0 });
    m.cold = new i8[1](0i8);
    constant: int = intern(m, 1, result);
    for i in 0..100 {
        argument: int = intern(m, result, i % 2 + 1);
        if (native_reduce(m, identity, argument) != argument) return 8;
        if (native_reduce(m, constant, identity) != result) return 9;
        if (native_reduce(m, identity, 1) != 1) return 10
    }
    0
}
