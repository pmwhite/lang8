tag tree_calculus;

import "native.l8";

use_tag std;

main(argc: int, argv: []str) raises IoError: int {
    reference: bool = false;
    if (argc > 1) {
        if (argc != 2 || argv[1] != "--reference") fail("usage: tree-calculus [--reference]");
        reference = true
    }
    m: *Machine = native_machine();
    // Identity is fork(stem(stem(leaf)), leaf), encoded as 21100.
    result: int = intern(m, intern(m, intern(m, 1, 0), 0), 1);
    input: []i8 = native_buffer(8192);
    line: []i8 = native_buffer(8192);
    size: int = 0;
    done: bool = false;
    while (!done) {
        count: int = read(0, input, len(input));
        if (count == -4) count = 0 else if (count == 0) done = true;
        if (count < 0) fail("could not read stdin");
        if (count > len(input)) fail("invalid read length");
        for i in 0..count {
            if (i < 0 || i >= len(input)) fail("invalid input index");
            c: i8 = input[i];
            if (c == '\n') {
                if (size > 0) {
                    term: int = parse(m, line, size);
                    if (reference) result = apply(m, result, term) else result = apply_native(m,
                        result, term)
                }
                size = 0
            } else if (c != '\r') {
                if (size == len(line)) {
                    if (len(line) >= 16777216) fail("input line too long");
                    larger: []i8 = native_buffer(len(line) * 2);
                    for j in 0..len(line) {
                        if (j >= len(larger)) fail("invalid input capacity");
                        larger[j] = line[j]
                    }
                    line = larger
                }
                if (size < 0 || size >= len(line)) fail("invalid input buffer");
                line[size] = c;
                size = size + 1
            }
        }
    }
    if (size > 0) {
        term: int = parse(m, line, size);
        if (reference) result = apply(m, result, term) else result = apply_native(m,
            result, term)
    }
    format(m, result, native_buffer(8192));
    0
}
