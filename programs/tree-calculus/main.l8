tag tree_calculus;

import "native.l8";

use_tag std;

tree_input: []i8 = static_buffer([8192]i8);

tree_line: []i8 = static_buffer([16777216]i8);

tree_output: []i8 = static_buffer([8192]i8);

main(argc: int, argv: []str) raises IoError: int {
    reference: bool = false;
    if (argc > 1) {
        if (argc != 2 || argv[1] != "--reference") fail("usage: tree-calculus [--reference]");
        reference = true
    }
    m: *Machine = native_machine();
    // Identity is fork(stem(stem(leaf)), leaf), encoded as 21100.
    result: int = intern(m, intern(m, intern(m, 1, 0), 0), 1);
    input: []i8 = tree_input;
    line: []i8 = tree_line;
    size: int = 0;
    done: bool = false;
    while (!done) {
        count: int = read(0, input, len(input));
        if (count == -4) count = 0 else if (count == 0) done = true;
        if (count < 0) fail("could not read stdin");
        for i in 0..count {
            c: i8 = input[i];
            if (c == '\n') {
                if (size > 0) {
                    term: int = parse(m, line, size);
                    if (reference) result = apply(m, result, term) else result = apply_native(m,
                        result, term)
                }
                size = 0
            } else if (c != '\r') {
                if (size == len(line)) fail("input line too long (16777216 bytes)");
                line[size] = c;
                size = size + 1
            }
        }
    }
    if (size > 0) {
        term: int = parse(m, line, size);
        if (reference) result = apply(m, result, term) else result = apply_native(m,
            result, term)
    }
    format(m, result, tree_output);
    0
}
