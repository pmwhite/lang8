tag stdlib_tests;

use_tag std;

import "../write.l8";

main() raises IoError: int {
    write_byte(1, 'A');
    write(1, "B");
    data: []i8 = ['C', 'D', 'E'];
    write_bytes_n(1, data, 2);
    write_bytes(1, data);
    if (write_some(1, data, 1, 2) != 2) return 1;
    if (write_some_text(1, "F") != 1) return 1;
    if (write_some(1, data, 3, 0) != 0) return 1;
    try {
        write(-1, "x");
        return 3
    } with IoError e -> {
        if (e.code != 9) return 4
    }
    //% expect: "ABCDCDEDEF"
    0
}
