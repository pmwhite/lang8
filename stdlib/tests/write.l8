tag stdlib_tests;

use_tag std;

import "../write.l8";

test "write variants" {
    write_byte(1, 'A');
    write(1, "B");
    data: []i8 = ['C', 'D', 'E'];
    write_bytes_n(1, data, 2);
    write_bytes(1, data);
    expect {|ABCDCDE|}
}

test "write_some returns the bytes written" {
    data: []i8 = ['C', 'D', 'E'];
    count: int = write_some(1, data, 1, 2);
    write(1, " -> ");
    write_int(1, count);
    write(1, "\n");
    count = write_some_text(1, "F");
    write(1, " -> ");
    write_int(1, count);
    write(1, "\n");
    write_int(1, write_some(1, data, 3, 0));
    expect "DE -> 2\nF -> 1\n0"
}

test "a bad descriptor raises its errno" {
    try {
        write(-1, "x")
    } with IoError e -> {
        write_int(1, e.code)
    }
    expect {|9|}
}

test "write_int and write_fixed" {
    write_int(1, 0 - 120);
    write(1, " ");
    write_fixed(1, 3.14159f64, 3);
    write(1, " ");
    write_fixed(1, 0.0f64 - 2000000000.0f64, 2);
    expect {|-120 3.142 -large|}
}
