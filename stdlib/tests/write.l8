tag stdlib_tests;

use_tag std;

import "../write.l8";

main() raises IoError, InvalidRange: int {
    write_byte(1, 'A');
    write(1, "B");
    data: []i8 = ['C', 'D', 'E'];
    write_bytes_n(1, data, 2);
    write_bytes(1, data);
    if (write_some(1, data, 1, 2) != 2) return 1;
    if (write_some_text(1, "F") != 1) return 1;
    try {
        if (write_some(1, data, 3, 1) >= 0) return 1
    } with InvalidRange e -> {
        if (e.offset != 3 || e.count != 1 || e.length != 3) return 2
    }
    try {
        write_bytes_n(1, data, 4);
        return 5
    } with InvalidRange e -> {
        if (e.offset != 0 || e.count != 4 || e.length != 3) return 6
    }
    try {
        write(-1, "x");
        return 3
    } with IoError e -> {
        if (e.code != 9) return 4
    }
    //% expect: "ABCDCDEDEF"
    0
}
