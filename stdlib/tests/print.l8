tag stdlib_tests;

use_tag std;

import "../print.l8";

test "print writes lines" {
    print("hello");
    print("");
    expect {|
        hello

    |}
}

test "eprint writes to standard error" {
    eprint("problem");
    eprint("");
    expect {|
        problem

    |}
}

test "print_int" {
    print_int(0);
    print_int(42);
    print_int(0 - 7);
    expect {|
        0
        42
        -7
    |}
    // The most negative int has no positive counterpart.
    print_int(0 - 9223372036854775807 - 1);
    expect {|
        -9223372036854775808
    |}
}

test "print_fixed rounds to the given places" {
    print_fixed(2.5f64, 2);
    print_fixed(1.0f64 / 3.0f64, 9);
    print_fixed(7.6f64, 0);
    expect {|
        2.50
        0.333333333
        8
    |}
    print_fixed(0.0f64 - 1.25f64, 1);
    expect {|
        -1.3
    |}
    // A value that rounds to zero has no sign.
    print_fixed(0.0f64 - 0.0004f64, 3);
    expect {|
        0.000
    |}
}

test "print_bool" {
    print_bool(true);
    print_bool(false);
    expect {|
        true
        false
    |}
}
