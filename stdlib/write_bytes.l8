tag std_write_internal;

import "raw_write.l8";

use_tag std;

// Linux errno, as a positive number. A zero-length write never reaches the OS.
tag std
exception IoError {
    code: int
}

// Retry interrupted and partial writes of a valid span.
_write_all_span(
    fd: int,
    data: []i8,
    off: int,
    n: int
) raises IoError {
    if (off < 0 || n < 0 || off > len(data) || n > len(data) - off) raise IoError { code: 22 };
    end: int = off + n;
    while (off < end) {
        count: int = raw::raw_write_some(fd, data, off, end - off);
        if (count != -4) {
            if (count < 0) raise IoError { code: 0 - count };
            if (count == 0) raise IoError { code: 5 };
            off = off + count
        }
    }
}

// Write the entire slice or raise IoError. On failure a prefix may be written.
tag std
write_bytes(fd: int, data: []i8) raises IoError {
    _write_all_span(fd, data, 0, len(data))
}
