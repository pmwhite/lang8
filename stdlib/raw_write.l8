tag raw;

native "write.s";

// Single Linux write syscalls for runtimes and low-level tools. Negative
// results are -errno. Public programs should import write.l8 instead.
extern raw_text_sys(fd: int, data: str, n: int): int = l8_std_write;

extern raw_bytes_sys(fd: int, data: []i8, n: int): int = l8_std_write;

extern raw_pointer_sys(fd: int, data: *i8, n: int): int = l8_std_write;

raw_write(fd: int, data: str) {
    raw_text_sys(fd, data, len(data))
}

raw_write_bytes(fd: int, data: []i8) {
    raw_bytes_sys(fd, data, len(data))
}

raw_write_byte(fd: int, byte: i8) {
    raw_pointer_sys(fd, &byte, 1)
}

raw_write_bytes_n(fd: int, data: []i8, n: int) {
    raw_write_some(fd, data, 0, n)
}

raw_write_some(
    fd: int,
    data: []i8,
    off: int,
    n: int
): int {
    if (n < 0) return -22;
    if (n == 0) {
        if (off < 0 || off > len(data)) return -22;
        return 0
    }
    if (off < 0 || off >= len(data) || n > len(data) - off) return -22;
    raw_pointer_sys(fd, &data[off], n)
}
