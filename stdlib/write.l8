tag std;

import "raw_write.l8";

// Linux errno, as a positive number. A zero-length write never reaches the OS.
exception IoError {
    code: int
}

// Internal caller supplies a valid span. Retry interrupted and partial writes.
_write_all_span(
    fd: int,
    data: []i8,
    off: int,
    n: int
) raises IoError requires (0 <= off && off <= len(data) && 0 <= n && n <= len(data) - off) {
    end: int = off + n;
    while (off < end) {
        count: int = raw::raw_write_some(fd, data, off, end - off);
        if (count != -4) {
            if (count < 0) raise IoError { code: 0 - count };
            if (count == 0) raise IoError { code: 5 };
            off = off + count
        }
    }
}

write(fd: int, text: str) raises IoError {
    write_bytes(fd, bytes(text))
}

write_bytes(fd: int, data: []i8) raises IoError {
    _write_all_span(fd, data, 0, len(data))
}

write_byte(fd: int, byte: i8) raises IoError {
    result: int = -4;
    while (result == -4) result = raw::raw_pointer_sys(fd, &byte, 1);
    if (result < 0) raise IoError { code: 0 - result };
    if (result == 0) raise IoError { code: 5 }
}

write_bytes_n(fd: int, data: []i8, n: int) raises IoError requires (0 <= n && n <= len(data)) {
    _write_all_span(fd, data, 0, n)
}

// One syscall. The caller can use the count to resume after a short write.
write_some(
    fd: int,
    data: []i8,
    off: int,
    n: int
) raises IoError: int requires (0 <= off && off <= len(data) && 0 <= n && n <= len(data) - off) {
    if (n == 0) return 0;
    result: int = raw::raw_write_some(fd, data, off, n);
    if (result < 0) raise IoError { code: 0 - result };
    result
}

write_some_text(fd: int, text: str) raises IoError: int {
    if (len(text) == 0) return 0;
    result: int = raw::raw_text_sys(fd, text, len(text));
    if (result < 0) raise IoError { code: 0 - result };
    result
}
