tag std;

import "write_bytes.l8";

write(fd: int, text: str) raises IoError {
    write_bytes(fd, bytes(text))
}

write_byte(fd: int, byte: i8) raises IoError {
    result: int = -4;
    while (result == -4) result = raw::raw_pointer_sys(fd, &byte, 1);
    if (result < 0) raise IoError { code: 0 - result };
    if (result == 0) raise IoError { code: 5 }
}

write_bytes_n(fd: int, data: []i8, n: int) raises IoError {
    std_write_internal::_write_all_span(fd, data, 0, n)
}

// Write the complete byte span, retrying interrupted and partial writes.
write_bytes_span(
    fd: int,
    data: []i8,
    start: int,
    count: int
) raises IoError {
    std_write_internal::_write_all_span(fd, data, start, count)
}

// One syscall. The caller can use the count to resume after a short write.
write_some(
    fd: int,
    data: []i8,
    off: int,
    n: int
) raises IoError: int {
    if (off < 0 || n < 0 || off > len(data) || n > len(data) - off) raise IoError { code: 22 };
    if (n == 0) return 0;
    result: int = raw::raw_write_some(fd, data, off, n);
    if (result < 0) raise IoError { code: 0 - result };
    result
}

write_some_text(fd: int, text: str) raises IoError: int {
    if (len(text) == 0) return 0;
    result: int = raw::raw_text_sys(fd, text, len(text));
    if (result < 0) raise IoError { code: 0 - result };
    result
}

// Write n in decimal.
write_int(fd: int, n: int) raises IoError {
    digits: []i8 = new i8[20](0i8);
    count: int = 0;
    rest: int = n;
    for i in 0..20 {
        if (i == 0 || rest != 0) {
            // Take digits of a negative value from the negative side, which
            // also holds the most negative int.
            digit: int = rest % 10;
            if (digit < 0) digit = 0 - digit;
            digits[19 - i] = '0' + digit trunc i8;
            rest = rest / 10;
            count = i + 1
        }
    }
    if (n < 0) write_byte(fd, '-');
    std_write_internal::_write_all_span(fd, digits, len(digits) - count, count)
}

// Write x rounded to places decimal places (at most 9), such as 2.50 for
// write_fixed(fd, 2.5f64, 2). Values that round to zero have no sign.
write_fixed(fd: int, x: f64, places: int) raises IoError {
    if (x != x) {
        write(fd, "nan");
        return
    }
    negative: bool = x < 0.0f64;
    magnitude: f64 = if (negative) 0.0f64 - x else x;
    if (magnitude > 1000000000.0f64) {
        if (negative) write_byte(fd, '-');
        if (magnitude - magnitude != 0.0f64) write(fd, "inf") else write(fd, "large");
        return
    }
    digits: int = places;
    if (digits < 0) digits = 0;
    if (digits > 9) digits = 9;
    scale: int = 1;
    for _i in 0..digits scale = scale * 10;
    scaled: int = (magnitude * scale as f64 + 0.5f64) as int;
    if (negative && scaled != 0) write_byte(fd, '-');
    write_int(fd, scaled / scale);
    if (digits == 0) return;
    write_byte(fd, '.');
    fraction: int = scaled % scale;
    unit: int = scale / 10;
    while (unit > 0) {
        write_byte(fd, '0' + (fraction / unit % 10) trunc i8);
        unit = unit / 10
    }
}
