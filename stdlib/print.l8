tag std;

import "write.l8";

// Write one line to standard output.
print(text: str) raises IoError {
    write(1, text);
    write(1, "\n")
}

// Write one line to standard error.
eprint(text: str) raises IoError {
    write(2, text);
    write(2, "\n")
}

// Write n in decimal as one line of standard output.
print_int(n: int) raises IoError {
    write_int(1, n);
    write(1, "\n")
}

// Write x with places decimal places as one line of standard output.
print_fixed(x: f64, places: int) raises IoError {
    write_fixed(1, x, places);
    write(1, "\n")
}

// Write true or false as one line of standard output.
print_bool(value: bool) raises IoError {
    if (value) write(1, "true\n") else write(1, "false\n")
}
