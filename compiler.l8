// L8 self-hosted compiler → x86-64 Linux GAS
// Uses structs for AST/types; implements the full L8 language including structs.

struct Member {
    int name;
    int offset;
    struct Type *ty;
    struct Member *next;
};

struct StructDef {
    int name;
    struct Member *members;
    int size;
    struct StructDef *next;
};

struct Type {
    int kind;
    struct Type *base;
    int array_len;
    struct StructDef *struct_def;
    int size;
};

struct Token {
    int kind;
    int val;
    int str;
    int len;
    struct Token *next;
};

struct Node {
    int kind;
    struct Node *next;
    struct Node *lhs;
    struct Node *rhs;
    struct Node *cond;
    struct Node *then;
    struct Node *els;
    struct Node *body;
    int val;
    struct Obj *var;
    int funcname;
    struct Node *args;
    int str_label;
    struct Type *ty;
    struct Member *member;
};

struct Obj {
    int name;
    int is_local;
    int is_func;
    int offset;
    struct Type *ty;
    struct Obj *next;
};

struct Function {
    int name;
    int nparams;
    struct Obj *p0;
    struct Obj *p1;
    struct Obj *p2;
    struct Obj *p3;
    struct Obj *p4;
    struct Obj *p5;
    struct Obj *locals;
    struct Node *body;
    int stack_size;
    struct Function *next;
};

struct StrLit {
    int data;
    int len;
    int label;
    struct StrLit *next;
};

// type kinds
int TY_INT; int TY_PTR; int TY_ARRAY; int TY_STRUCT;

// token kinds
int TK_EOF; int TK_NUM; int TK_STR; int TK_IDENT;
int TK_INT; int TK_IF; int TK_ELSE; int TK_WHILE; int TK_RETURN;
int TK_STRUCT; int TK_SIZEOF;
int TK_EQ; int TK_NE; int TK_LE; int TK_GE;
int TK_PLUS; int TK_MINUS; int TK_STAR; int TK_SLASH; int TK_PERCENT;
int TK_LT; int TK_GT; int TK_ASSIGN; int TK_NOT; int TK_AMP;
int TK_LPAREN; int TK_RPAREN; int TK_LBRACE; int TK_RBRACE;
int TK_LBRACK; int TK_RBRACK; int TK_SEMI; int TK_COMMA;
int TK_AND; int TK_OR; int TK_DOT;

// node kinds
int ND_NUM; int ND_VAR; int ND_ADD; int ND_SUB; int ND_MUL; int ND_DIV; int ND_MOD;
int ND_EQ; int ND_NE; int ND_LT; int ND_LE; int ND_GT; int ND_GE;
int ND_ASSIGN; int ND_ADDR; int ND_DEREF; int ND_NOT; int ND_NEG;
int ND_FUNCALL; int ND_RETURN; int ND_IF; int ND_WHILE; int ND_BLOCK; int ND_EXPR_STMT;
int ND_LOGAND; int ND_LOGOR; int ND_MEMBER;

int source; int source_len; int pos;
struct Token *tok;
struct Obj *globals;
struct Obj *locals;
struct Function *functions;
struct StructDef *struct_defs;
struct Type *ty_int;
struct StrLit *str_lits;
int str_count;
int label_id;
int current_fn_name;
int REG0; int REG1; int REG2; int REG3; int REG4; int REG5;


int strlen(int s) {
    int i;
    i = 0;
    while (loadb(s + i) != 0) {
        i = i + 1;
    }
    return i;
}

int streq_n(int a, int b, int n) {
    int i;
    i = 0;
    while (i < n) {
        if (loadb(a + i) != loadb(b + i)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int streq(int a, int b) {
    int i;
    int ca;
    int cb;
    i = 0;
    while (1) {
        ca = loadb(a + i);
        cb = loadb(b + i);
        if (ca != cb) {
            return 0;
        }
        if (ca == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int memcpy(int dst, int src, int n) {
    int i;
    i = 0;
    while (i < n) {
        storeb(dst + i, loadb(src + i));
        i = i + 1;
    }
    return dst;
}

int strdup_n(int s, int n) {
    int d;
    d = malloc(n + 1);
    memcpy(d, s, n);
    storeb(d + n, 0);
    return d;
}

int is_space(int c) {
    return c == 32 || c == 10 || c == 13 || c == 9;
}

int is_digit(int c) {
    return c >= 48 && c <= 57;
}

int is_ident1(int c) {
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    return c == 95;
}

int is_ident2(int c) {
    return is_ident1(c) || is_digit(c);
}

int emit(int s) {
    write(1, s, strlen(s));
    return 0;
}

int emit_ch(int c) {
    int ch;
    ch = c;
    write(1, &ch, 1);
    return 0;
}

int emit_num(int n) {
    int buf[32];
    int i;
    int neg;
    neg = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch(48);
        return 0;
    }
    i = 0;
    while (n > 0) {
        buf[i] = 48 + (n % 10);
        n = n / 10;
        i = i + 1;
    }
    if (neg) {
        emit_ch(45);
    }
    while (i > 0) {
        i = i - 1;
        emit_ch(buf[i]);
    }
    return 0;
}

int error(int msg) {
    write(2, "error: ", 7);
    write(2, msg, strlen(msg));
    write(2, "\n", 1);
    exit(1);
    return 0;
}

int init_kinds() {
    TY_INT = 0; TY_PTR = 1; TY_ARRAY = 2; TY_STRUCT = 3;
    TK_EOF = 0; TK_NUM = 1; TK_STR = 2; TK_IDENT = 3;
    TK_INT = 4; TK_IF = 5; TK_ELSE = 6; TK_WHILE = 7; TK_RETURN = 8;
    TK_STRUCT = 9; TK_SIZEOF = 10;
    TK_EQ = 11; TK_NE = 12; TK_LE = 13; TK_GE = 14;
    TK_PLUS = 15; TK_MINUS = 16; TK_STAR = 17; TK_SLASH = 18; TK_PERCENT = 19;
    TK_LT = 20; TK_GT = 21; TK_ASSIGN = 22; TK_NOT = 23; TK_AMP = 24;
    TK_LPAREN = 25; TK_RPAREN = 26; TK_LBRACE = 27; TK_RBRACE = 28;
    TK_LBRACK = 29; TK_RBRACK = 30; TK_SEMI = 31; TK_COMMA = 32;
    TK_AND = 33; TK_OR = 34; TK_DOT = 35;
    ND_NUM = 0; ND_VAR = 1; ND_ADD = 2; ND_SUB = 3; ND_MUL = 4; ND_DIV = 5; ND_MOD = 6;
    ND_EQ = 7; ND_NE = 8; ND_LT = 9; ND_LE = 10; ND_GT = 11; ND_GE = 12;
    ND_ASSIGN = 13; ND_ADDR = 14; ND_DEREF = 15; ND_NOT = 16; ND_NEG = 17;
    ND_FUNCALL = 18; ND_RETURN = 19; ND_IF = 20; ND_WHILE = 21; ND_BLOCK = 22;
    ND_EXPR_STMT = 23; ND_LOGAND = 24; ND_LOGOR = 25; ND_MEMBER = 26;
    REG0 = "%rdi"; REG1 = "%rsi"; REG2 = "%rdx";
    REG3 = "%rcx"; REG4 = "%r8"; REG5 = "%r9";
    ty_int = malloc(sizeof(struct Type));
    ty_int.kind = TY_INT;
    ty_int.base = 0;
    ty_int.array_len = 0;
    ty_int.struct_def = 0;
    ty_int.size = 8;
    return 0;
}

int reg_name(int i) {
    if (i == 0) { return REG0; }
    if (i == 1) { return REG1; }
    if (i == 2) { return REG2; }
    if (i == 3) { return REG3; }
    if (i == 4) { return REG4; }
    return REG5;
}

int read_file(int path) {
    int fd;
    int buf;
    int n;
    int cap;
    int r;
    int tmp;
    fd = open(path, 0, 0);
    if (fd < 0) {
        error("cannot open file");
    }
    cap = 65536;
    buf = malloc(cap);
    n = 0;
    while (1) {
        if (n + 4096 > cap) {
            cap = cap * 2;
            tmp = malloc(cap);
            memcpy(tmp, buf, n);
            buf = tmp;
        }
        r = read(fd, buf + n, 4096);
        if (r <= 0) {
            storeb(buf + n, 0);
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    return buf;
}

struct Type *newtype(int kind) {
    struct Type *t;
    t = malloc(sizeof(struct Type));
    t.kind = kind;
    t.base = 0;
    t.array_len = 0;
    t.struct_def = 0;
    t.size = 0;
    return t;
}

struct Type *ptr_to(struct Type *base) {
    struct Type *t;
    t = newtype(TY_PTR);
    t.base = base;
    t.size = 8;
    return t;
}

struct Type *array_of(struct Type *base, int len) {
    struct Type *t;
    t = newtype(TY_ARRAY);
    t.base = base;
    t.array_len = len;
    t.size = base.size * len;
    return t;
}

struct Type *struct_type(struct StructDef *sd) {
    struct Type *t;
    t = newtype(TY_STRUCT);
    t.struct_def = sd;
    t.size = sd.size;
    return t;
}

struct StructDef *find_struct(int name) {
    struct StructDef *s;
    s = struct_defs;
    while (s != 0) {
        if (streq(s.name, name)) {
            return s;
        }
        s = s.next;
    }
    return 0;
}

struct Member *find_member(struct StructDef *sd, int name) {
    struct Member *m;
    m = sd.members;
    while (m != 0) {
        if (streq(m.name, name)) {
            return m;
        }
        m = m.next;
    }
    return 0;
}

int is_pointer(struct Type *t) {
    return t != 0 && t.kind == TY_PTR;
}

int is_array(struct Type *t) {
    return t != 0 && t.kind == TY_ARRAY;
}

int is_struct_ty(struct Type *t) {
    return t != 0 && t.kind == TY_STRUCT;
}

struct Type *decay(struct Type *t) {
    if (is_array(t)) {
        return ptr_to(t.base);
    }
    return t;
}

struct Token *new_token(int kind, int start, int len) {
    struct Token *t;
    t = malloc(sizeof(struct Token));
    t.kind = kind;
    t.str = start;
    t.len = len;
    t.val = 0;
    t.next = 0;
    return t;
}

int ident_kind(int s, int n) {
    if (n == 3 && streq_n(s, "int", 3)) { return TK_INT; }
    if (n == 2 && streq_n(s, "if", 2)) { return TK_IF; }
    if (n == 4 && streq_n(s, "else", 4)) { return TK_ELSE; }
    if (n == 5 && streq_n(s, "while", 5)) { return TK_WHILE; }
    if (n == 6 && streq_n(s, "return", 6)) { return TK_RETURN; }
    if (n == 6 && streq_n(s, "struct", 6)) { return TK_STRUCT; }
    if (n == 6 && streq_n(s, "sizeof", 6)) { return TK_SIZEOF; }
    return TK_IDENT;
}

int skip_line_comment() {
    while (pos < source_len) {
        if (loadb(source + pos) == 10) {
            return 0;
        }
        pos = pos + 1;
    }
    return 0;
}

int skip_block_comment() {
    while (pos < source_len) {
        if (loadb(source + pos) == 42 && loadb(source + pos + 1) == 47) {
            pos = pos + 2;
            return 0;
        }
        pos = pos + 1;
    }
    return 0;
}

int read_number() {
    int v;
    v = 0;
    while (pos < source_len) {
        if (is_digit(loadb(source + pos)) == 0) {
            return v;
        }
        v = v * 10 + (loadb(source + pos) - 48);
        pos = pos + 1;
    }
    return v;
}

int esc_char(int c) {
    if (c == 110) { return 10; }
    if (c == 116) { return 9; }
    if (c == 48) { return 0; }
    if (c == 92) { return 92; }
    if (c == 39) { return 39; }
    if (c == 34) { return 34; }
    return c;
}

int scan_string_len() {
    int start;
    start = pos;
    while (pos < source_len) {
        if (loadb(source + pos) == 34) {
            return pos - start;
        }
        if (loadb(source + pos) == 92) {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    error("unterminated string");
    return 0;
}

int scan_ident_len() {
    int start;
    start = pos;
    while (pos < source_len) {
        if (is_ident2(loadb(source + pos)) == 0) {
            return pos - start;
        }
        pos = pos + 1;
    }
    return pos - start;
}

int punct_kind(int c) {
    if (c == 43) { return TK_PLUS; }
    if (c == 45) { return TK_MINUS; }
    if (c == 42) { return TK_STAR; }
    if (c == 37) { return TK_PERCENT; }
    if (c == 38) { return TK_AMP; }
    if (c == 46) { return TK_DOT; }
    if (c == 40) { return TK_LPAREN; }
    if (c == 41) { return TK_RPAREN; }
    if (c == 123) { return TK_LBRACE; }
    if (c == 125) { return TK_RBRACE; }
    if (c == 91) { return TK_LBRACK; }
    if (c == 93) { return TK_RBRACK; }
    if (c == 59) { return TK_SEMI; }
    if (c == 44) { return TK_COMMA; }
    if (c == 47) { return TK_SLASH; }
    return 0 - 1;
}

struct Token *tokenize() {
    int c;
    int s;
    int v;
    int n;
    int pk;
    struct Token *head;
    struct Token *cur;
    struct Token *t;
    head = malloc(sizeof(struct Token));
    head.next = 0;
    cur = head;
    pos = 0;
    while (pos < source_len) {
        c = loadb(source + pos);
        if (is_space(c)) {
            pos = pos + 1;
        } else {
            if (c == 47 && loadb(source + pos + 1) == 47) {
                pos = pos + 2;
                skip_line_comment();
            } else {
                if (c == 47 && loadb(source + pos + 1) == 42) {
                    pos = pos + 2;
                    skip_block_comment();
                } else {
                    if (is_digit(c)) {
                        s = source + pos;
                        v = read_number();
                        t = new_token(TK_NUM, s, (source + pos) - s);
                        t.val = v;
                        cur.next = t;
                        cur = t;
                    } else {
                        if (c == 34) {
                            pos = pos + 1;
                            s = source + pos;
                            n = scan_string_len();
                            t = new_token(TK_STR, s, n);
                            cur.next = t;
                            cur = t;
                            pos = pos + 1;
                        } else {
                            if (c == 39) {
                                pos = pos + 1;
                                if (loadb(source + pos) == 92) {
                                    pos = pos + 1;
                                    v = esc_char(loadb(source + pos));
                                    pos = pos + 1;
                                } else {
                                    v = loadb(source + pos);
                                    pos = pos + 1;
                                }
                                if (loadb(source + pos) == 39) {
                                    pos = pos + 1;
                                }
                                t = new_token(TK_NUM, source + pos, 0);
                                t.val = v;
                                cur.next = t;
                                cur = t;
                            } else {
                                if (is_ident1(c)) {
                                    s = source + pos;
                                    n = scan_ident_len();
                                    t = new_token(ident_kind(s, n), s, n);
                                    cur.next = t;
                                    cur = t;
                                } else {
                                    if (c == 61 && loadb(source + pos + 1) == 61) {
                                        t = new_token(TK_EQ, source + pos, 2);
                                        cur.next = t; cur = t; pos = pos + 2;
                                    } else {
                                        if (c == 33 && loadb(source + pos + 1) == 61) {
                                            t = new_token(TK_NE, source + pos, 2);
                                            cur.next = t; cur = t; pos = pos + 2;
                                        } else {
                                            if (c == 60 && loadb(source + pos + 1) == 61) {
                                                t = new_token(TK_LE, source + pos, 2);
                                                cur.next = t; cur = t; pos = pos + 2;
                                            } else {
                                                if (c == 62 && loadb(source + pos + 1) == 61) {
                                                    t = new_token(TK_GE, source + pos, 2);
                                                    cur.next = t; cur = t; pos = pos + 2;
                                                } else {
                                                    if (c == 38 && loadb(source + pos + 1) == 38) {
                                                        t = new_token(TK_AND, source + pos, 2);
                                                        cur.next = t; cur = t; pos = pos + 2;
                                                    } else {
                                                        if (c == 124 && loadb(source + pos + 1) == 124) {
                                                            t = new_token(TK_OR, source + pos, 2);
                                                            cur.next = t; cur = t; pos = pos + 2;
                                                        } else {
                                                                if (c == 61) {
                                                                    t = new_token(TK_ASSIGN, source + pos, 1);
                                                                    cur.next = t; cur = t; pos = pos + 1;
                                                                } else {
                                                                    if (c == 33) {
                                                                        t = new_token(TK_NOT, source + pos, 1);
                                                                        cur.next = t; cur = t; pos = pos + 1;
                                                                    } else {
                                                                        if (c == 60) {
                                                                            t = new_token(TK_LT, source + pos, 1);
                                                                            cur.next = t; cur = t; pos = pos + 1;
                                                                        } else {
                                                                            if (c == 62) {
                                                                                t = new_token(TK_GT, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            } else {
                                                                                pk = punct_kind(c);
                                                                                if (pk < 0) {
                                                                                    error("unexpected character");
                                                                                }
                                                                                t = new_token(pk, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    t = new_token(TK_EOF, source + pos, 0);
    cur.next = t;
    return head.next;
}

int equal(int kind) {
    return tok.kind == kind;
}

int skip(int kind) {
    if (equal(kind) == 0) {
        error("unexpected token");
    }
    tok = tok.next;
    return 0;
}

int cur_tokstr() {
    return strdup_n(tok.str, tok.len);
}

int add_string(int s, int n) {
    int buf;
    int i;
    int j;
    struct StrLit *lit;
    buf = malloc(n + 1);
    i = 0;
    j = 0;
    while (i < n) {
        if (loadb(s + i) == 92 && i + 1 < n) {
            i = i + 1;
            storeb(buf + j, esc_char(loadb(s + i)));
            j = j + 1;
        } else {
            storeb(buf + j, loadb(s + i));
            j = j + 1;
        }
        i = i + 1;
    }
    storeb(buf + j, 0);
    lit = malloc(sizeof(struct StrLit));
    lit.data = buf;
    lit.len = j;
    lit.label = str_count;
    str_count = str_count + 1;
    lit.next = str_lits;
    str_lits = lit;
    return lit.label;
}

struct Node *new_node(int kind) {
    struct Node *n;
    n = malloc(sizeof(struct Node));
    n.kind = kind;
    n.next = 0;
    n.lhs = 0;
    n.rhs = 0;
    n.cond = 0;
    n.then = 0;
    n.els = 0;
    n.body = 0;
    n.val = 0;
    n.var = 0;
    n.funcname = 0;
    n.args = 0;
    n.str_label = 0;
    n.ty = 0;
    n.member = 0;
    return n;
}

struct Node *new_binary(int kind, struct Node *lhs, struct Node *rhs) {
    struct Node *n;
    n = new_node(kind);
    n.lhs = lhs;
    n.rhs = rhs;
    return n;
}

struct Node *new_unary(int kind, struct Node *lhs) {
    struct Node *n;
    n = new_node(kind);
    n.lhs = lhs;
    return n;
}

struct Node *new_num(int v) {
    struct Node *n;
    n = new_node(ND_NUM);
    n.val = v;
    n.ty = ty_int;
    return n;
}

struct Obj *find_obj(struct Obj *list, int name) {
    struct Obj *o;
    o = list;
    while (o != 0) {
        if (streq(o.name, name)) {
            return o;
        }
        o = o.next;
    }
    return 0;
}

struct Obj *find_var(int name) {
    struct Obj *o;
    o = find_obj(locals, name);
    if (o != 0) {
        return o;
    }
    return find_obj(globals, name);
}

struct Obj *new_obj(int name, int is_local) {
    struct Obj *o;
    o = malloc(sizeof(struct Obj));
    o.name = name;
    o.is_local = is_local;
    o.is_func = 0;
    o.offset = 0;
    o.ty = 0;
    if (is_local) {
        o.next = locals;
        locals = o;
    } else {
        o.next = globals;
        globals = o;
    }
    return o;
}

struct Type *decl_spec() {
    int name;
    struct StructDef *sd;
    if (equal(TK_INT)) {
        tok = tok.next;
        return ty_int;
    }
    if (equal(TK_STRUCT)) {
        tok = tok.next;
        if (equal(TK_IDENT) == 0) {
            error("expected struct tag");
        }
        name = cur_tokstr();
        tok = tok.next;
        sd = find_struct(name);
        if (sd == 0) {
            sd = malloc(sizeof(struct StructDef));
            sd.name = name;
            sd.members = 0;
            sd.size = 0;
            sd.next = struct_defs;
            struct_defs = sd;
        }
        return struct_type(sd);
    }
    error("expected type");
    return 0;
}

struct Node *parse_expr() {
    return parse_assign();
}

struct Node *parse_primary() {
    struct Node *n;
    int name;
    struct Node *head;
    struct Node *cur;
    struct Node *arg;
    int label;
    struct Type *ty;
    struct Obj *var;
    if (equal(TK_SIZEOF)) {
        tok = tok.next;
        skip(TK_LPAREN);
        if (equal(TK_STRUCT) || equal(TK_INT)) {
            ty = decl_spec();
            while (equal(TK_STAR)) {
                ty = ptr_to(ty);
                tok = tok.next;
            }
            skip(TK_RPAREN);
            return new_num(ty.size);
        }
        n = parse_expr();
        skip(TK_RPAREN);
        add_type(n);
        return new_num(n.ty.size);
    }
    if (equal(TK_LPAREN)) {
        tok = tok.next;
        n = parse_expr();
        skip(TK_RPAREN);
        return n;
    }
    if (equal(TK_NUM)) {
        n = new_num(tok.val);
        tok = tok.next;
        return n;
    }
    if (equal(TK_STR)) {
        label = add_string(tok.str, tok.len);
        tok = tok.next;
        n = new_node(ND_NUM);
        n.str_label = label + 1;
        n.ty = ptr_to(ty_int);
        return n;
    }
    if (equal(TK_IDENT)) {
        name = cur_tokstr();
        tok = tok.next;
        if (equal(TK_LPAREN)) {
            n = new_node(ND_FUNCALL);
            n.funcname = name;
            n.ty = ty_int;
            tok = tok.next;
            head = 0;
            cur = 0;
            while (equal(TK_RPAREN) == 0) {
                if (cur != 0) {
                    skip(TK_COMMA);
                }
                arg = parse_expr();
                if (cur == 0) {
                    head = arg;
                    cur = arg;
                } else {
                    cur.next = arg;
                    cur = arg;
                }
            }
            n.args = head;
            skip(TK_RPAREN);
            return n;
        }
        var = find_var(name);
        if (var == 0) {
            error("undefined variable");
        }
        n = new_node(ND_VAR);
        n.var = var;
        n.ty = var.ty;
        return n;
    }
    error("expected expression");
    return 0;
}

struct Node *parse_postfix() {
    struct Node *n;
    struct Node *idx;
    struct Node *scaled;
    struct Node *mem;
    struct Type *t;
    struct Type *sty;
    struct Member *m;
    int name;
    n = parse_primary();
    while (1) {
        if (equal(TK_LBRACK)) {
            tok = tok.next;
            idx = parse_expr();
            skip(TK_RBRACK);
            add_type(n);
            t = decay(n.ty);
            if (is_pointer(t) == 0) {
                error("subscript of non-pointer");
            }
            scaled = new_binary(ND_MUL, idx, new_num(t.base.size));
            n = new_unary(ND_DEREF, new_binary(ND_ADD, n, scaled));
            n.ty = t.base;
        } else {
            if (equal(TK_DOT)) {
                tok = tok.next;
                if (equal(TK_IDENT) == 0) {
                    error("expected member name");
                }
                name = cur_tokstr();
                tok = tok.next;
                add_type(n);
                t = decay(n.ty);
                if (is_pointer(t) && is_struct_ty(t.base)) {
                    sty = t.base;
                } else {
                    if (is_struct_ty(n.ty) == 0) {
                        error("member access on non-struct");
                    }
                    sty = n.ty;
                }
                m = find_member(sty.struct_def, name);
                if (m == 0) {
                    error("unknown member");
                }
                mem = new_node(ND_MEMBER);
                mem.lhs = n;
                mem.member = m;
                if (m.ty != 0) {
                    mem.ty = m.ty;
                } else {
                    mem.ty = ty_int;
                }
                n = mem;
            } else {
                return n;
            }
        }
    }
    return n;
}

struct Node *parse_unary() {
    struct Node *n;
    if (equal(TK_PLUS)) {
        tok = tok.next;
        return parse_unary();
    }
    if (equal(TK_MINUS)) {
        tok = tok.next;
        n = new_unary(ND_NEG, parse_unary());
        n.ty = ty_int;
        return n;
    }
    if (equal(TK_STAR)) {
        tok = tok.next;
        return new_unary(ND_DEREF, parse_unary());
    }
    if (equal(TK_AMP)) {
        tok = tok.next;
        return new_unary(ND_ADDR, parse_unary());
    }
    if (equal(TK_NOT)) {
        tok = tok.next;
        n = new_unary(ND_NOT, parse_unary());
        n.ty = ty_int;
        return n;
    }
    return parse_postfix();
}

int add_type(struct Node *n) {
    struct Type *t;
    struct Node *a;
    if (n == 0 || n.ty != 0) {
        return 0;
    }
    add_type(n.lhs);
    add_type(n.rhs);
    add_type(n.cond);
    add_type(n.then);
    add_type(n.els);
    a = n.args;
    while (a != 0) {
        add_type(a);
        a = a.next;
    }
    if (n.kind == ND_BLOCK) {
        a = n.body;
        while (a != 0) {
            add_type(a);
            a = a.next;
        }
    }
    if (n.kind == ND_NUM || n.kind == ND_ADD || n.kind == ND_SUB || n.kind == ND_MUL || n.kind == ND_DIV || n.kind == ND_MOD || n.kind == ND_EQ || n.kind == ND_NE || n.kind == ND_LT || n.kind == ND_LE || n.kind == ND_GT || n.kind == ND_GE || n.kind == ND_LOGAND || n.kind == ND_LOGOR || n.kind == ND_NOT || n.kind == ND_NEG || n.kind == ND_ASSIGN || n.kind == ND_FUNCALL) {
        n.ty = ty_int;
        return 0;
    }
    if (n.kind == ND_VAR) {
        n.ty = n.var.ty;
        return 0;
    }
    if (n.kind == ND_ADDR) {
        add_type(n.lhs);
        if (is_array(n.lhs.ty)) {
            n.ty = ptr_to(n.lhs.ty.base);
        } else {
            n.ty = ptr_to(n.lhs.ty);
        }
        return 0;
    }
    if (n.kind == ND_DEREF) {
        add_type(n.lhs);
        t = decay(n.lhs.ty);
        if (is_pointer(t)) {
            n.ty = t.base;
        } else {
            if (t != 0 && t.kind == TY_INT) {
                n.ty = ty_int;
            } else {
                error("dereferencing non-pointer");
            }
        }
        return 0;
    }
    if (n.kind == ND_MEMBER) {
        if (n.member.ty != 0) {
            n.ty = n.member.ty;
        } else {
            n.ty = ty_int;
        }
        return 0;
    }
    return 0;
}

struct Node *parse_mul() {
    struct Node *n;
    n = parse_unary();
    while (1) {
        if (equal(TK_STAR)) {
            tok = tok.next;
            n = new_binary(ND_MUL, n, parse_unary());
        } else {
            if (equal(TK_SLASH)) {
                tok = tok.next;
                n = new_binary(ND_DIV, n, parse_unary());
            } else {
                if (equal(TK_PERCENT)) {
                    tok = tok.next;
                    n = new_binary(ND_MOD, n, parse_unary());
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

struct Node *parse_add() {
    struct Node *n;
    n = parse_mul();
    while (1) {
        if (equal(TK_PLUS)) {
            tok = tok.next;
            n = new_binary(ND_ADD, n, parse_mul());
        } else {
            if (equal(TK_MINUS)) {
                tok = tok.next;
                n = new_binary(ND_SUB, n, parse_mul());
            } else {
                return n;
            }
        }
    }
    return n;
}

struct Node *parse_relational() {
    struct Node *n;
    n = parse_add();
    while (1) {
        if (equal(TK_LT)) {
            tok = tok.next;
            n = new_binary(ND_LT, n, parse_add());
        } else {
            if (equal(TK_GT)) {
                tok = tok.next;
                n = new_binary(ND_GT, n, parse_add());
            } else {
                if (equal(TK_LE)) {
                    tok = tok.next;
                    n = new_binary(ND_LE, n, parse_add());
                } else {
                    if (equal(TK_GE)) {
                        tok = tok.next;
                        n = new_binary(ND_GE, n, parse_add());
                    } else {
                        return n;
                    }
                }
            }
        }
    }
    return n;
}

struct Node *parse_equality() {
    struct Node *n;
    n = parse_relational();
    while (1) {
        if (equal(TK_EQ)) {
            tok = tok.next;
            n = new_binary(ND_EQ, n, parse_relational());
        } else {
            if (equal(TK_NE)) {
                tok = tok.next;
                n = new_binary(ND_NE, n, parse_relational());
            } else {
                return n;
            }
        }
    }
    return n;
}

struct Node *parse_logand() {
    struct Node *n;
    n = parse_equality();
    while (equal(TK_AND)) {
        tok = tok.next;
        n = new_binary(ND_LOGAND, n, parse_equality());
    }
    return n;
}

struct Node *parse_logor() {
    struct Node *n;
    n = parse_logand();
    while (equal(TK_OR)) {
        tok = tok.next;
        n = new_binary(ND_LOGOR, n, parse_logand());
    }
    return n;
}

struct Node *parse_assign() {
    struct Node *n;
    n = parse_logor();
    if (equal(TK_ASSIGN)) {
        tok = tok.next;
        return new_binary(ND_ASSIGN, n, parse_assign());
    }
    return n;
}

struct Obj *parse_decl(int is_local) {
    struct Type *ty;
    int name;
    struct Obj *o;
    ty = decl_spec();
    while (equal(TK_STAR)) {
        ty = ptr_to(ty);
        tok = tok.next;
    }
    if (equal(TK_IDENT) == 0) {
        error("expected identifier");
    }
    name = cur_tokstr();
    tok = tok.next;
    if (equal(TK_LBRACK)) {
        tok = tok.next;
        if (equal(TK_NUM) == 0) {
            error("expected array size");
        }
        ty = array_of(ty, tok.val);
        tok = tok.next;
        skip(TK_RBRACK);
    }
    o = new_obj(name, is_local);
    o.ty = ty;
    return o;
}

struct Node *parse_compound() {
    struct Node *n;
    struct Node *head;
    struct Node *cur;
    struct Node *s;
    n = new_node(ND_BLOCK);
    skip(TK_LBRACE);
    head = 0;
    cur = 0;
    while (equal(TK_RBRACE) == 0) {
        if (equal(TK_EOF)) {
            error("unterminated block");
        }
        s = parse_stmt();
        if (cur == 0) {
            head = s;
            cur = s;
        } else {
            cur.next = s;
            cur = s;
        }
    }
    n.body = head;
    skip(TK_RBRACE);
    return n;
}

struct Node *parse_stmt() {
    struct Node *n;
    if (equal(TK_RETURN)) {
        n = new_node(ND_RETURN);
        tok = tok.next;
        if (equal(TK_SEMI) == 0) {
            n.lhs = parse_expr();
        }
        skip(TK_SEMI);
        return n;
    }
    if (equal(TK_IF)) {
        n = new_node(ND_IF);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.then = parse_stmt();
        if (equal(TK_ELSE)) {
            tok = tok.next;
            n.els = parse_stmt();
        }
        return n;
    }
    if (equal(TK_WHILE)) {
        n = new_node(ND_WHILE);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.body = parse_stmt();
        return n;
    }
    if (equal(TK_LBRACE)) {
        return parse_compound();
    }
    if (equal(TK_INT) || equal(TK_STRUCT)) {
        parse_decl(1);
        skip(TK_SEMI);
        return new_node(ND_BLOCK);
    }
    n = new_node(ND_EXPR_STMT);
    n.lhs = parse_expr();
    skip(TK_SEMI);
    return n;
}

struct Obj *fn_param(struct Function *fn, int i) {
    if (i == 0) { return fn.p0; }
    if (i == 1) { return fn.p1; }
    if (i == 2) { return fn.p2; }
    if (i == 3) { return fn.p3; }
    if (i == 4) { return fn.p4; }
    return fn.p5;
}

int set_fn_param(struct Function *fn, int i, struct Obj *p) {
    if (i == 0) { fn.p0 = p; }
    if (i == 1) { fn.p1 = p; }
    if (i == 2) { fn.p2 = p; }
    if (i == 3) { fn.p3 = p; }
    if (i == 4) { fn.p4 = p; }
    if (i == 5) { fn.p5 = p; }
    return 0;
}

struct Function *parse_function(int name) {
    struct Function *fn;
    struct Obj *p;
    int np;
    locals = 0;
    fn = malloc(sizeof(struct Function));
    fn.name = name;
    fn.next = 0;
    fn.nparams = 0;
    fn.p0 = 0; fn.p1 = 0; fn.p2 = 0;
    fn.p3 = 0; fn.p4 = 0; fn.p5 = 0;
    skip(TK_LPAREN);
    np = 0;
    while (equal(TK_RPAREN) == 0) {
        if (np != 0) {
            skip(TK_COMMA);
        }
        if (np >= 6) {
            error("too many parameters");
        }
        p = parse_decl(1);
        set_fn_param(fn, np, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TK_RPAREN);
    fn.body = parse_compound();
    fn.locals = locals;
    return fn;
}

int parse_struct_def() {
    int name;
    struct StructDef *sd;
    struct Member *head;
    struct Member *cur;
    struct Member *m;
    struct Type *mty;
    int offset;
    tok = tok.next;
    if (equal(TK_IDENT) == 0) {
        error("expected struct tag");
    }
    name = cur_tokstr();
    tok = tok.next;
    sd = find_struct(name);
    if (sd != 0 && sd.members != 0) {
        error("redefinition of struct");
    }
    if (sd == 0) {
        sd = malloc(sizeof(struct StructDef));
        sd.name = name;
        sd.members = 0;
        sd.size = 0;
        sd.next = struct_defs;
        struct_defs = sd;
    }
    skip(TK_LBRACE);
    head = 0;
    cur = 0;
    offset = 0;
    while (equal(TK_RBRACE) == 0) {
        mty = decl_spec();
        while (equal(TK_STAR)) {
            mty = ptr_to(mty);
            tok = tok.next;
        }
        if (equal(TK_IDENT) == 0) {
            error("expected member name");
        }
        m = malloc(sizeof(struct Member));
        m.name = cur_tokstr();
        m.offset = offset;
        m.ty = mty;
        m.next = 0;
        offset = offset + 8;
        if (cur == 0) {
            head = m;
            cur = m;
        } else {
            cur.next = m;
            cur = m;
        }
        tok = tok.next;
        skip(TK_SEMI);
    }
    sd.members = head;
    sd.size = offset;
    skip(TK_RBRACE);
    skip(TK_SEMI);
    return 0;
}

int parse_program() {
    int name;
    struct Function *fn;
    struct Function *tail;
    struct Obj *o;
    struct Type *ty;
    functions = 0;
    tail = 0;
    while (equal(TK_EOF) == 0) {
        if (equal(TK_STRUCT) && tok.next.kind == TK_IDENT && tok.next.next.kind == TK_LBRACE) {
            parse_struct_def();
        } else {
            ty = decl_spec();
            while (equal(TK_STAR)) {
                ty = ptr_to(ty);
                tok = tok.next;
            }
            if (equal(TK_IDENT) == 0) {
                error("expected identifier");
            }
            name = cur_tokstr();
            tok = tok.next;
            if (equal(TK_LPAREN)) {
                fn = parse_function(name);
                if (tail == 0) {
                    functions = fn;
                    tail = fn;
                } else {
                    tail.next = fn;
                    tail = fn;
                }
                o = new_obj(name, 0);
                o.is_func = 1;
                o.ty = ty;
            } else {
                if (equal(TK_LBRACK)) {
                    tok = tok.next;
                    if (equal(TK_NUM) == 0) {
                        error("expected array size");
                    }
                    ty = array_of(ty, tok.val);
                    tok = tok.next;
                    skip(TK_RBRACK);
                }
                o = new_obj(name, 0);
                o.ty = ty;
                skip(TK_SEMI);
            }
        }
    }
    return 0;
}

int new_label() {
    int l;
    l = label_id;
    label_id = label_id + 1;
    return l;
}

int gen_addr(struct Node *n) {
    struct Type *t;
    add_type(n);
    if (n.kind == ND_VAR) {
        if (n.var.is_local) {
            emit("  lea ");
            emit_num(n.var.offset);
            emit("(%rbp), %rax\n");
        } else {
            emit("  lea ");
            emit(n.var.name);
            emit("(%rip), %rax\n");
        }
        return 0;
    }
    if (n.kind == ND_DEREF) {
        gen_expr(n.lhs);
        return 0;
    }
    if (n.kind == ND_MEMBER) {
        add_type(n.lhs);
        t = decay(n.lhs.ty);
        if (is_pointer(t) && is_struct_ty(t.base)) {
            gen_expr(n.lhs);
        } else {
            gen_addr(n.lhs);
        }
        if (n.member.offset != 0) {
            emit("  add $");
            emit_num(n.member.offset);
            emit(", %rax\n");
        }
        return 0;
    }
    error("not an lvalue");
    return 0;
}

int gen_expr(struct Node *n) {
    int nargs;
    struct Node *a;
    int i;
    int k;
    int l;
    add_type(n);
    k = n.kind;
    if (k == ND_NUM) {
        if (n.str_label != 0) {
            emit("  lea .L.str");
            emit_num(n.str_label - 1);
            emit("(%rip), %rax\n");
        } else {
            emit("  mov $");
            emit_num(n.val);
            emit(", %rax\n");
        }
        return 0;
    }
    if (k == ND_VAR) {
        gen_addr(n);
        if (is_array(n.ty) || is_struct_ty(n.ty)) {
            return 0;
        }
        emit("  mov (%rax), %rax\n");
        return 0;
    }
    if (k == ND_MEMBER) {
        gen_addr(n);
        emit("  mov (%rax), %rax\n");
        return 0;
    }
    if (k == ND_ADDR) {
        gen_addr(n.lhs);
        return 0;
    }
    if (k == ND_DEREF) {
        gen_expr(n.lhs);
        emit("  mov (%rax), %rax\n");
        return 0;
    }
    if (k == ND_ASSIGN) {
        gen_addr(n.lhs);
        emit("  push %rax\n");
        gen_expr(n.rhs);
        emit("  pop %rdi\n");
        emit("  mov %rax, (%rdi)\n");
        return 0;
    }
    if (k == ND_NOT) {
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  sete %al\n");
        emit("  movzb %al, %rax\n");
        return 0;
    }
    if (k == ND_NEG) {
        gen_expr(n.lhs);
        emit("  neg %rax\n");
        return 0;
    }
    if (k == ND_LOGAND) {
        l = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    if (k == ND_LOGOR) {
        l = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  jne .L.true"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit(".L.true"); emit_num(l); emit(":\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    if (k == ND_FUNCALL) {
        nargs = 0;
        a = n.args;
        while (a != 0) {
            nargs = nargs + 1;
            a = a.next;
        }
        if (nargs > 6) {
            error("too many arguments");
        }
        a = n.args;
        while (a != 0) {
            gen_expr(a);
            emit("  push %rax\n");
            a = a.next;
        }
        i = nargs - 1;
        while (i >= 0) {
            emit("  pop ");
            emit(reg_name(i));
            emit("\n");
            i = i - 1;
        }
        emit("  sub $8, %rsp\n");
        emit("  call ");
        emit(n.funcname);
        emit("\n");
        emit("  add $8, %rsp\n");
        return 0;
    }

    gen_expr(n.lhs);
    emit("  push %rax\n");
    gen_expr(n.rhs);
    emit("  mov %rax, %rdi\n");
    emit("  pop %rax\n");

    if (k == ND_ADD) { emit("  add %rdi, %rax\n"); return 0; }
    if (k == ND_SUB) { emit("  sub %rdi, %rax\n"); return 0; }
    if (k == ND_MUL) { emit("  imul %rdi, %rax\n"); return 0; }
    if (k == ND_DIV) { emit("  cqo\n"); emit("  idiv %rdi\n"); return 0; }
    if (k == ND_MOD) {
        emit("  cqo\n"); emit("  idiv %rdi\n"); emit("  mov %rdx, %rax\n"); return 0;
    }
    if (k == ND_EQ) {
        emit("  cmp %rdi, %rax\n"); emit("  sete %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_NE) {
        emit("  cmp %rdi, %rax\n"); emit("  setne %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_LT) {
        emit("  cmp %rdi, %rax\n"); emit("  setl %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_LE) {
        emit("  cmp %rdi, %rax\n"); emit("  setle %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_GT) {
        emit("  cmp %rdi, %rax\n"); emit("  setg %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_GE) {
        emit("  cmp %rdi, %rax\n"); emit("  setge %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    error("invalid expression");
    return 0;
}

int gen_stmt(struct Node *n) {
    struct Node *s;
    int l;
    int k;
    k = n.kind;
    if (k == ND_RETURN) {
        if (n.lhs != 0) {
            gen_expr(n.lhs);
        } else {
            emit("  mov $0, %rax\n");
        }
        emit("  jmp .L.return.");
        emit(current_fn_name);
        emit("\n");
        return 0;
    }
    if (k == ND_EXPR_STMT) {
        gen_expr(n.lhs);
        return 0;
    }
    if (k == ND_BLOCK) {
        s = n.body;
        while (s != 0) {
            gen_stmt(s);
            s = s.next;
        }
        return 0;
    }
    if (k == ND_IF) {
        l = new_label();
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.else"); emit_num(l); emit("\n");
        gen_stmt(n.then);
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.else"); emit_num(l); emit(":\n");
        if (n.els != 0) {
            gen_stmt(n.els);
        }
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    if (k == ND_WHILE) {
        l = new_label();
        emit(".L.begin"); emit_num(l); emit(":\n");
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.end"); emit_num(l); emit("\n");
        gen_stmt(n.body);
        emit("  jmp .L.begin"); emit_num(l); emit("\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    error("invalid statement");
    return 0;
}

int assign_lvar_offsets(struct Function *fn) {
    int off;
    struct Obj *v;
    int sz;
    off = 0;
    v = fn.locals;
    while (v != 0) {
        sz = v.ty.size;
        if (sz <= 0) {
            sz = 8;
        }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 15) / 16 * 16;
    return 0;
}

int emit_data() {
    struct Obj *g;
    struct StrLit *s;
    int i;
    int j;
    int sz;
    emit(".section .bss\n");
    emit(".align 8\n");
    g = globals;
    while (g != 0) {
        if (g.is_func == 0) {
            sz = 8;
            if (g.ty != 0) {
                sz = g.ty.size;
            }
            if (sz <= 0) {
                sz = 8;
            }
            emit(g.name);
            emit(": .skip ");
            emit_num(sz);
            emit("\n");
        }
        g = g.next;
    }
    emit(".section .rodata\n");
    i = 0;
    while (i < str_count) {
        s = str_lits;
        while (s != 0 && s.label != i) {
            s = s.next;
        }
        if (s != 0) {
            emit(".L.str");
            emit_num(i);
            emit(":\n");
            emit("  .byte ");
            j = 0;
            while (j < s.len) {
                if (j != 0) {
                    emit(",");
                }
                emit_num(loadb(s.data + j));
                j = j + 1;
            }
            if (s.len == 0) {
                emit("0");
            } else {
                emit(",0");
            }
            emit("\n");
        }
        i = i + 1;
    }
    return 0;
}

int emit_text() {
    struct Function *fn;
    int i;
    struct Obj *p;
    emit(".section .text\n");
    fn = functions;
    while (fn != 0) {
        assign_lvar_offsets(fn);
        current_fn_name = fn.name;
        emit(".globl ");
        emit(fn.name);
        emit("\n");
        emit(fn.name);
        emit(":\n");
        emit("  push %rbp\n");
        emit("  mov %rsp, %rbp\n");
        emit("  sub $");
        emit_num(fn.stack_size);
        emit(", %rsp\n");
        i = 0;
        while (i < fn.nparams) {
            p = fn_param(fn, i);
            emit("  mov ");
            emit(reg_name(i));
            emit(", ");
            emit_num(p.offset);
            emit("(%rbp)\n");
            i = i + 1;
        }
        gen_stmt(fn.body);
        emit(".L.return.");
        emit(fn.name);
        emit(":\n");
        emit("  mov %rbp, %rsp\n");
        emit("  pop %rbp\n");
        emit("  ret\n");
        fn = fn.next;
    }
    return 0;
}

int codegen() {
    emit_data();
    emit_text();
    return 0;
}

int main(int argc, int argv) {
    int path;
    if (argc != 2) {
        error("usage: l8c <file.l8>");
    }
    path = *(argv + 8);
    init_kinds();
    source = read_file(path);
    tok = tokenize();
    parse_program();
    codegen();
    return 0;
}
