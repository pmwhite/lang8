// L8 self-hosted compiler → x86-64 Linux GAS
// Uses nominal types for AST; Type is a sum over language types.

type Type =
    Int
  | I8
  | Bool
  | Ptr { base: *Type; }
  | Array { base: *Type; len: int; }
  | Record { def: *StructDef; }
  | Enum { def: *EnumDef; };

type Member = {
    name: *i8;
    offset: int;
    ty: *Type;
    next: *Member;
};

type StructDef = {
    name: *i8;
    members: *Member;
    size: int;
    next: *StructDef;
};

type Variant = {
    name: *i8;
    tag: int;
    fields: *Member;
    payload_ty: *Type;
    payload_size: int;
    next: *Variant;
};

type EnumDef = {
    name: *i8;
    variants: *Variant;
    size: int;
    next: *EnumDef;
};

type Token = {
    kind: int;
    val: int;
    str: *i8;
    len: int;
    next: *Token;
};

type Node = {
    kind: int;
    next: *Node;
    lhs: *Node;
    rhs: *Node;
    cond: *Node;
    then: *Node;
    els: *Node;
    body: *Node;
    val: int;
    var: *Obj;
    funcname: *i8;
    args: *Node;
    str_label: int;
    ty: *Type;
    member: *Member;
    variant: *Variant;
};

type Obj = {
    name: *i8;
    is_local: int;
    is_func: int;
    offset: int;
    ty: *Type;
    next: *Obj;
};

type Function = {
    name: *i8;
    nparams: int;
    p0: *Obj;
    p1: *Obj;
    p2: *Obj;
    p3: *Obj;
    p4: *Obj;
    p5: *Obj;
    locals: *Obj;
    body: *Node;
    stack_size: int;
    return_ty: *Type;
    next: *Function;
};

type StrLit = {
    data: *i8;
    len: int;
    label: int;
    next: *StrLit;
};

// token kinds
TK_EOF: int; TK_NUM: int; TK_CHAR: int; TK_STR: int; TK_IDENT: int;
TK_INT: int; TK_I8: int; TK_BOOL: int; TK_TRUE: int; TK_FALSE: int; TK_IF: int; TK_ELSE: int; TK_WHILE: int; TK_RETURN: int;
TK_TYPE: int; TK_SIZEOF: int; TK_UNINITIALIZED: int; TK_AS: int; TK_TRUNC: int; TK_NEW: int;
TK_EQ: int; TK_NE: int; TK_LE: int; TK_GE: int;
TK_PLUS: int; TK_MINUS: int; TK_STAR: int; TK_SLASH: int; TK_PERCENT: int;
TK_LT: int; TK_GT: int; TK_ASSIGN: int; TK_NOT: int; TK_AMP: int;
TK_LPAREN: int; TK_RPAREN: int; TK_LBRACE: int; TK_RBRACE: int;
TK_LBRACK: int; TK_RBRACK: int; TK_SEMI: int; TK_COMMA: int; TK_COLON: int;
TK_AND: int; TK_OR: int; TK_DOT: int; TK_MATCH: int; TK_PIPE: int; TK_ARROW: int;

// node kinds
ND_NUM: int; ND_VAR: int; ND_ADD: int; ND_SUB: int; ND_MUL: int; ND_DIV: int; ND_MOD: int;
ND_EQ: int; ND_NE: int; ND_LT: int; ND_LE: int; ND_GT: int; ND_GE: int;
ND_ASSIGN: int; ND_ADDR: int; ND_DEREF: int; ND_NOT: int; ND_NEG: int;
ND_FUNCALL: int; ND_RETURN: int; ND_IF: int; ND_WHILE: int; ND_BLOCK: int; ND_EXPR_STMT: int;
ND_LOGAND: int; ND_LOGOR: int; ND_MEMBER: int; ND_AS: int; ND_TRUNC: int; ND_NEW: int; ND_STRUCT_LIT: int;
ND_VARIANT_LIT: int; ND_MATCH: int; ND_MATCH_ARM: int;

source: *i8; source_len: int; pos: int;
tok: *Token;
globals: *Obj;
locals: *Obj;
functions: *Function;
struct_defs: *StructDef;
enum_defs: *EnumDef;
field_list_size: int;
ty_int: *Type;
ty_i8: *Type;
ty_bool: *Type;
str_lits: *StrLit;
str_count: int;
label_id: int;
current_fn_name: *i8;
current_return_ty: *Type;
REG0: *i8; REG1: *i8; REG2: *i8; REG3: *i8; REG4: *i8; REG5: *i8;


strlen(s: *i8): int {
    return len(s);
}

streq_n(a: *i8, b: *i8, n: int): bool {
    i: int = 0;
    while (i < n) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

streq(a: *i8, b: *i8): bool {
    i: int = 0;
    while (true) {
        if (a[i] != b[i]) {
            return false;
        }
        if (a[i] == 0 trunc i8) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

memcpy(dst: *i8, src: *i8, n: int): *i8 {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return dst;
}

strdup_n(s: *i8, n: int): *i8 {
    p: *int = malloc(n + 16) as *int;
    p.* = n;
    data: *i8 = (p as *i8) + 8;
    memcpy(data, s, n);
    data[n] = 0 trunc i8;
    return data;
}

is_space(c: i8): bool {
    return c == ' ' || c == '\n' || c == '\r' || c == '\t';
}

is_digit(c: i8): bool {
    return c >= '0' && c <= '9';
}

is_ident1(c: i8): bool {
    if (c >= 'a' && c <= 'z') { return true; }
    if (c >= 'A' && c <= 'Z') { return true; }
    return c == '_';
}

is_ident2(c: i8): bool {
    return is_ident1(c) || is_digit(c);
}

emit(s: *i8) {
    write(1, s, len(s));
}

emit_ch(c: i8) {
    write(1, &c, 1);
}

emit_num(n: int) {
    buf: i8[32] = uninitialized;
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch('0');
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = (('0' as int) + (n % 10)) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    if (neg != 0) {
        emit_ch('-');
    }
    while (i > 0) {
        i = i - 1;
        emit_ch(buf[i]);
    }
}

error(msg: *i8) {
    write(2, "error: ", len("error: "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
    exit(1);
}

init_kinds() {
    TK_EOF = 0; TK_NUM = 1; TK_CHAR = 2; TK_STR = 3; TK_IDENT = 4;
    TK_INT = 5; TK_I8 = 6; TK_BOOL = 7; TK_TRUE = 8; TK_FALSE = 9;
    TK_IF = 10; TK_ELSE = 11; TK_WHILE = 12; TK_RETURN = 13;
    TK_TYPE = 14; TK_SIZEOF = 15; TK_UNINITIALIZED = 16; TK_AS = 17; TK_TRUNC = 18; TK_NEW = 19;
    TK_EQ = 20; TK_NE = 21; TK_LE = 22; TK_GE = 23;
    TK_PLUS = 24; TK_MINUS = 25; TK_STAR = 26; TK_SLASH = 27; TK_PERCENT = 28;
    TK_LT = 29; TK_GT = 30; TK_ASSIGN = 31; TK_NOT = 32; TK_AMP = 33;
    TK_LPAREN = 34; TK_RPAREN = 35; TK_LBRACE = 36; TK_RBRACE = 37;
    TK_LBRACK = 38; TK_RBRACK = 39; TK_SEMI = 40; TK_COMMA = 41; TK_COLON = 42;
    TK_AND = 43; TK_OR = 44; TK_DOT = 45; TK_MATCH = 46; TK_PIPE = 47; TK_ARROW = 48;
    ND_NUM = 0; ND_VAR = 1; ND_ADD = 2; ND_SUB = 3; ND_MUL = 4; ND_DIV = 5; ND_MOD = 6;
    ND_EQ = 7; ND_NE = 8; ND_LT = 9; ND_LE = 10; ND_GT = 11; ND_GE = 12;
    ND_ASSIGN = 13; ND_ADDR = 14; ND_DEREF = 15; ND_NOT = 16; ND_NEG = 17;
    ND_FUNCALL = 18; ND_RETURN = 19; ND_IF = 20; ND_WHILE = 21; ND_BLOCK = 22;
    ND_EXPR_STMT = 23; ND_LOGAND = 24; ND_LOGOR = 25; ND_MEMBER = 26; ND_AS = 27; ND_TRUNC = 28; ND_NEW = 29; ND_STRUCT_LIT = 30;
    ND_VARIANT_LIT = 31; ND_MATCH = 32; ND_MATCH_ARM = 33;
    REG0 = "%rdi"; REG1 = "%rsi"; REG2 = "%rdx";
    REG3 = "%rcx"; REG4 = "%r8"; REG5 = "%r9";
    ty_int = make_int_type();
    ty_i8 = make_i8_type();
    ty_bool = make_bool_type();
}

reg_name(i: int): *i8 {
    if (i == 0) { return REG0; }
    if (i == 1) { return REG1; }
    if (i == 2) { return REG2; }
    if (i == 3) { return REG3; }
    if (i == 4) { return REG4; }
    return REG5;
}

read_file(path: *i8): *i8 {
    fd: int = open(path, 0, 0);
    if (fd < 0) {
        error("cannot open file");
    }
    cap: int = 65536;
    buf: *i8 = malloc(cap) as *i8;
    n: int = 0;
    while (true) {
        if (n + 4096 > cap) {
            cap = cap * 2;
            tmp: *i8 = malloc(cap) as *i8;
            memcpy(tmp, buf, n);
            buf = tmp;
        }
        r: int = read(fd, buf + n, 4096);
        if (r <= 0) {
            buf[n] = 0 trunc i8;
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    return buf;
}

make_int_type(): *Type {
    p: *Type = new Type uninitialized;
    p.* = Type.Int;
    return p;
}

make_i8_type(): *Type {
    p: *Type = new Type uninitialized;
    p.* = Type.I8;
    return p;
}

make_bool_type(): *Type {
    p: *Type = new Type uninitialized;
    p.* = Type.Bool;
    return p;
}

type_size(t: *Type): int {
    match t.* {
        Int -> { return 8; }
        I8 -> { return 1; }
        Bool -> { return 1; }
        Ptr { base } -> { return 8; }
        Array { base, len } -> { return type_size(base) * len; }
        Record { def } -> { return def.size; }
        Enum { def } -> {
            if (def.size <= 0) {
                return 8;
            }
            return def.size;
        }
    }
}

type_base(t: *Type): *Type {
    match t.* {
        Ptr { base } -> { return base; }
        Array { base, len } -> { return base; }
        Int -> { error("not a pointer or array"); return 0; }
        I8 -> { error("not a pointer or array"); return 0; }
        Bool -> { error("not a pointer or array"); return 0; }
        Record { def } -> { error("not a pointer or array"); return 0; }
        Enum { def } -> { error("not a pointer or array"); return 0; }
    }
}

type_array_len(t: *Type): int {
    match t.* {
        Array { base, len } -> { return len; }
        Int -> { error("not an array"); return 0; }
        I8 -> { error("not an array"); return 0; }
        Bool -> { error("not an array"); return 0; }
        Ptr { base } -> { error("not an array"); return 0; }
        Record { def } -> { error("not an array"); return 0; }
        Enum { def } -> { error("not an array"); return 0; }
    }
}

type_struct_def(t: *Type): *StructDef {
    match t.* {
        Record { def } -> { return def; }
        Int -> { error("not a record type"); return 0; }
        I8 -> { error("not a record type"); return 0; }
        Bool -> { error("not a record type"); return 0; }
        Ptr { base } -> { error("not a record type"); return 0; }
        Array { base, len } -> { error("not a record type"); return 0; }
        Enum { def } -> { error("not a record type"); return 0; }
    }
}

type_enum_def(t: *Type): *EnumDef {
    match t.* {
        Enum { def } -> { return def; }
        Int -> { error("not an enum type"); return 0; }
        I8 -> { error("not an enum type"); return 0; }
        Bool -> { error("not an enum type"); return 0; }
        Ptr { base } -> { error("not an enum type"); return 0; }
        Array { base, len } -> { error("not an enum type"); return 0; }
        Record { def } -> { error("not an enum type"); return 0; }
    }
}

ptr_to(base: *Type): *Type {
    p: *Type = new Type uninitialized;
    p.* = Type.Ptr { base: base };
    return p;
}

array_of(base: *Type, len: int): *Type {
    p: *Type = new Type uninitialized;
    p.* = Type.Array { base: base, len: len };
    return p;
}

struct_type(sd: *StructDef): *Type {
    p: *Type = new Type uninitialized;
    p.* = Type.Record { def: sd };
    return p;
}

enum_type(ed: *EnumDef): *Type {
    p: *Type = new Type uninitialized;
    p.* = Type.Enum { def: ed };
    return p;
}

find_struct(name: *i8): *StructDef {
    s: *StructDef = struct_defs;
    while (s != 0) {
        if (streq(s.name, name)) {
            return s;
        }
        s = s.next;
    }
    return 0;
}

find_enum(name: *i8): *EnumDef {
    e: *EnumDef = enum_defs;
    while (e != 0) {
        if (streq(e.name, name)) {
            return e;
        }
        e = e.next;
    }
    return 0;
}

get_or_create_struct(name: *i8): *StructDef {
    sd: *StructDef = find_struct(name);
    if (sd != 0) {
        return sd;
    }
    sd = new StructDef {
        name: name,
        members: 0,
        size: 0,
        next: struct_defs
    };
    struct_defs = sd;
    return sd;
}

get_or_create_enum(name: *i8): *EnumDef {
    ed: *EnumDef = find_enum(name);
    if (ed != 0) {
        return ed;
    }
    ed = new EnumDef {
        name: name,
        variants: 0,
        size: 0,
        next: enum_defs
    };
    enum_defs = ed;
    return ed;
}

find_variant(ed: *EnumDef, name: *i8): *Variant {
    v: *Variant = ed.variants;
    while (v != 0) {
        if (streq(v.name, name)) {
            return v;
        }
        v = v.next;
    }
    return 0;
}

enum_field_offset(m: *Member): int {
    return 8 + m.offset;
}

variant_payload_name(enum_name: *i8, var_name: *i8): *i8 {
    n: int = len(enum_name) + 1 + len(var_name);
    p: *int = malloc(n + 16) as *int;
    p.* = n;
    data: *i8 = (p as *i8) + 8;
    i: int = 0;
    j: int = 0;
    while (i < len(enum_name)) {
        data[j] = enum_name[i];
        j = j + 1;
        i = i + 1;
    }
    data[j] = '.';
    j = j + 1;
    i = 0;
    while (i < len(var_name)) {
        data[j] = var_name[i];
        j = j + 1;
        i = i + 1;
    }
    return data;
}

is_type_name(): bool {
    if (!equal(TK_IDENT)) {
        return false;
    }
    name: *i8 = strdup_n(tok.str, tok.len);
    if (find_struct(name) != 0) {
        return true;
    }
    if (find_enum(name) != 0) {
        return true;
    }
    return false;
}

starts_type(): bool {
    if (equal(TK_INT) || equal(TK_I8) || equal(TK_BOOL) || is_type_name()) {
        return true;
    }
    t: *Token = tok;
    while (t.kind == TK_STAR) {
        t = t.next;
    }
    if (t != tok) {
        if (t.kind == TK_INT || t.kind == TK_I8 || t.kind == TK_BOOL) {
            return true;
        }
        if (t.kind == TK_IDENT) {
            n: *i8 = strdup_n(t.str, t.len);
            if (find_struct(n) != 0 || find_enum(n) != 0) {
                return true;
            }
        }
    }
    return false;
}

find_member(sd: *StructDef, name: *i8): *Member {
    m: *Member = sd.members;
    while (m != 0) {
        if (streq(m.name, name)) {
            return m;
        }
        m = m.next;
    }
    return 0;
}

is_pointer(t: *Type): bool {
    if (t == 0) {
        return false;
    }
    match t.* {
        Ptr { base } -> { return true; }
        Int -> { return false; }
        I8 -> { return false; }
        Bool -> { return false; }
        Array { base, len } -> { return false; }
        Record { def } -> { return false; }
        Enum { def } -> { return false; }
    }
}

is_array(t: *Type): bool {
    if (t == 0) {
        return false;
    }
    match t.* {
        Array { base, len } -> { return true; }
        Int -> { return false; }
        I8 -> { return false; }
        Bool -> { return false; }
        Ptr { base } -> { return false; }
        Record { def } -> { return false; }
        Enum { def } -> { return false; }
    }
}

is_struct_ty(t: *Type): bool {
    if (t == 0) {
        return false;
    }
    match t.* {
        Record { def } -> { return true; }
        Int -> { return false; }
        I8 -> { return false; }
        Bool -> { return false; }
        Ptr { base } -> { return false; }
        Array { base, len } -> { return false; }
        Enum { def } -> { return false; }
    }
}

is_enum_ty(t: *Type): bool {
    if (t == 0) {
        return false;
    }
    match t.* {
        Enum { def } -> { return true; }
        Int -> { return false; }
        I8 -> { return false; }
        Bool -> { return false; }
        Ptr { base } -> { return false; }
        Array { base, len } -> { return false; }
        Record { def } -> { return false; }
    }
}

is_aggregate(t: *Type): bool {
    return is_struct_ty(t) || is_enum_ty(t);
}

is_i8_ty(t: *Type): bool {
    if (t == 0) {
        return false;
    }
    match t.* {
        I8 -> { return true; }
        Int -> { return false; }
        Bool -> { return false; }
        Ptr { base } -> { return false; }
        Array { base, len } -> { return false; }
        Record { def } -> { return false; }
        Enum { def } -> { return false; }
    }
}

is_int_ty(t: *Type): bool {
    if (t == 0) {
        return false;
    }
    match t.* {
        Int -> { return true; }
        I8 -> { return false; }
        Bool -> { return false; }
        Ptr { base } -> { return false; }
        Array { base, len } -> { return false; }
        Record { def } -> { return false; }
        Enum { def } -> { return false; }
    }
}

is_bool_ty(t: *Type): bool {
    if (t == 0) {
        return false;
    }
    match t.* {
        Bool -> { return true; }
        Int -> { return false; }
        I8 -> { return false; }
        Ptr { base } -> { return false; }
        Array { base, len } -> { return false; }
        Record { def } -> { return false; }
        Enum { def } -> { return false; }
    }
}

types_equal(a: *Type, b: *Type): bool {
    if (a == b) {
        return true;
    }
    if (a == 0 || b == 0) {
        return false;
    }
    if (is_int_ty(a) && is_int_ty(b)) {
        return true;
    }
    if (is_i8_ty(a) && is_i8_ty(b)) {
        return true;
    }
    if (is_bool_ty(a) && is_bool_ty(b)) {
        return true;
    }
    if (is_pointer(a) && is_pointer(b)) {
        return types_equal(type_base(a), type_base(b));
    }
    if (is_array(a) && is_array(b)) {
        if (type_array_len(a) != type_array_len(b)) {
            return false;
        }
        return types_equal(type_base(a), type_base(b));
    }
    if (is_struct_ty(a) && is_struct_ty(b)) {
        return type_struct_def(a) == type_struct_def(b);
    }
    if (is_enum_ty(a) && is_enum_ty(b)) {
        return type_enum_def(a) == type_enum_def(b);
    }
    return false;
}

is_word_ty(t: *Type): bool {
    t = decay(t);
    return t != 0 && type_size(t) == 8;
}

check_as(from: *Type, to: *Type) {
    from = decay(from);
    to = decay(to);
    if (types_equal(from, to)) {
        return;
    }
    if ((is_i8_ty(from) || is_bool_ty(from)) && is_int_ty(to)) {
        return;
    }
    if (is_word_ty(from) && is_word_ty(to)) {
        return;
    }
    if (type_size(from) == 1 && type_size(to) == 1) {
        return;
    }
    error("invalid as conversion");
}

check_trunc(from: *Type, to: *Type) {
    from = decay(from);
    to = decay(to);
    if (is_int_ty(from) && (is_i8_ty(to) || is_bool_ty(to))) {
        return;
    }
    error("invalid trunc conversion");
}

decay(t: *Type): *Type {
    if (is_array(t)) {
        return ptr_to(type_base(t));
    }
    return t;
}

new_token(kind: int, start: *i8, len: int): *Token {
    return new Token {
        kind: kind,
        val: 0,
        str: start,
        len: len,
        next: 0
    };
}

ident_kind(s: *i8, n: int): int {
    if (n == 3 && streq_n(s, "int", 3)) { return TK_INT; }
    if (n == 2 && streq_n(s, "i8", 2)) { return TK_I8; }
    if (n == 4 && streq_n(s, "bool", 4)) { return TK_BOOL; }
    if (n == 4 && streq_n(s, "true", 4)) { return TK_TRUE; }
    if (n == 5 && streq_n(s, "false", 5)) { return TK_FALSE; }
    if (n == 2 && streq_n(s, "if", 2)) { return TK_IF; }
    if (n == 4 && streq_n(s, "else", 4)) { return TK_ELSE; }
    if (n == 5 && streq_n(s, "while", 5)) { return TK_WHILE; }
    if (n == 6 && streq_n(s, "return", 6)) { return TK_RETURN; }
    if (n == 4 && streq_n(s, "type", 4)) { return TK_TYPE; }
    if (n == 6 && streq_n(s, "sizeof", 6)) { return TK_SIZEOF; }
    if (n == 13 && streq_n(s, "uninitialized", 13)) { return TK_UNINITIALIZED; }
    if (n == 2 && streq_n(s, "as", 2)) { return TK_AS; }
    if (n == 5 && streq_n(s, "trunc", 5)) { return TK_TRUNC; }
    if (n == 3 && streq_n(s, "new", 3)) { return TK_NEW; }
    if (n == 5 && streq_n(s, "match", 5)) { return TK_MATCH; }
    return TK_IDENT;
}

skip_line_comment() {
    while (pos < source_len) {
        if (source[pos] == '\n') {
            return;
        }
        pos = pos + 1;
    }
}

skip_block_comment() {
    while (pos < source_len) {
        if (source[pos] == '*' && source[pos + 1] == '/') {
            pos = pos + 2;
            return;
        }
        pos = pos + 1;
    }
}

read_number(): int {
    v: int = 0;
    while (pos < source_len) {
        if (!is_digit(source[pos])) {
            return v;
        }
        v = v * 10 + ((source[pos] as int) - ('0' as int));
        pos = pos + 1;
    }
    return v;
}

esc_char(c: i8): i8 {
    if (c == 'n') { return '\n'; }
    if (c == 't') { return '\t'; }
    if (c == 'r') { return '\r'; }
    if (c == '0') { return 0 trunc i8; }
    if (c == '\\') { return '\\'; }
    if (c == '\'') { return '\''; }
    if (c == '"') { return '"'; }
    return c;
}

scan_string_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (source[pos] == '"') {
            return pos - start;
        }
        if (source[pos] == '\\') {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    error("unterminated string");
    return 0;
}

scan_ident_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (!is_ident2(source[pos])) {
            return pos - start;
        }
        pos = pos + 1;
    }
    return pos - start;
}

punct_kind(c: i8): int {
    if (c == '+') { return TK_PLUS; }
    if (c == '-') { return TK_MINUS; }
    if (c == '*') { return TK_STAR; }
    if (c == '%') { return TK_PERCENT; }
    if (c == '&') { return TK_AMP; }
    if (c == '.') { return TK_DOT; }
    if (c == ':') { return TK_COLON; }
    if (c == '(') { return TK_LPAREN; }
    if (c == ')') { return TK_RPAREN; }
    if (c == '{') { return TK_LBRACE; }
    if (c == '}') { return TK_RBRACE; }
    if (c == '[') { return TK_LBRACK; }
    if (c == ']') { return TK_RBRACK; }
    if (c == ';') { return TK_SEMI; }
    if (c == ',') { return TK_COMMA; }
    if (c == '/') { return TK_SLASH; }
    return 0 - 1;
}

tokenize(): *Token {
    head: *Token = new Token {
        kind: 0,
        val: 0,
        str: 0,
        len: 0,
        next: 0
    };
    cur: *Token = head;
    pos = 0;
    while (pos < source_len) {
        c: i8 = source[pos];
        if (is_space(c)) {
            pos = pos + 1;
        } else {
            if (c == '/' && source[pos + 1] == '/') {
                pos = pos + 2;
                skip_line_comment();
            } else {
                if (c == '/' && source[pos + 1] == '*') {
                    pos = pos + 2;
                    skip_block_comment();
                } else {
                    if (is_digit(c)) {
                        s: *i8 = source + pos;
                        v: int = read_number();
                        t: *Token = new_token(TK_NUM, s, (source + pos) - s);
                        t.val = v;
                        cur.next = t;
                        cur = t;
                    } else {
                        if (c == '"') {
                            pos = pos + 1;
                            s = source + pos;
                            n: int = scan_string_len();
                            t = new_token(TK_STR, s, n);
                            cur.next = t;
                            cur = t;
                            pos = pos + 1;
                        } else {
                            if (c == '\'') {
                                pos = pos + 1;
                                ch: i8 = uninitialized;
                                if (source[pos] == '\\') {
                                    pos = pos + 1;
                                    ch = esc_char(source[pos]);
                                    pos = pos + 1;
                                } else {
                                    ch = source[pos];
                                    pos = pos + 1;
                                }
                                if (source[pos] == '\'') {
                                    pos = pos + 1;
                                }
                                t = new_token(TK_CHAR, source + pos, 0);
                                t.val = ch as int;
                                cur.next = t;
                                cur = t;
                            } else {
                                if (is_ident1(c)) {
                                    s = source + pos;
                                    n = scan_ident_len();
                                    t = new_token(ident_kind(s, n), s, n);
                                    cur.next = t;
                                    cur = t;
                                } else {
                                    if (c == '=' && source[pos + 1] == '=') {
                                        t = new_token(TK_EQ, source + pos, 2);
                                        cur.next = t; cur = t; pos = pos + 2;
                                    } else {
                                        if (c == '!' && source[pos + 1] == '=') {
                                            t = new_token(TK_NE, source + pos, 2);
                                            cur.next = t; cur = t; pos = pos + 2;
                                        } else {
                                            if (c == '<' && source[pos + 1] == '=') {
                                                t = new_token(TK_LE, source + pos, 2);
                                                cur.next = t; cur = t; pos = pos + 2;
                                            } else {
                                                if (c == '>' && source[pos + 1] == '=') {
                                                    t = new_token(TK_GE, source + pos, 2);
                                                    cur.next = t; cur = t; pos = pos + 2;
                                                } else {
                                                    if (c == '&' && source[pos + 1] == '&') {
                                                        t = new_token(TK_AND, source + pos, 2);
                                                        cur.next = t; cur = t; pos = pos + 2;
                                                    } else {
                                                            if (c == '|' && source[pos + 1] == '|') {
                                                            t = new_token(TK_OR, source + pos, 2);
                                                            cur.next = t; cur = t; pos = pos + 2;
                                                        } else {
                                                            if (c == '|') {
                                                                t = new_token(TK_PIPE, source + pos, 1);
                                                                cur.next = t; cur = t; pos = pos + 1;
                                                            } else {
                                                                if (c == '-' && source[pos + 1] == '>') {
                                                                    t = new_token(TK_ARROW, source + pos, 2);
                                                                    cur.next = t; cur = t; pos = pos + 2;
                                                                } else {
                                                                    if (c == '=') {
                                                                        t = new_token(TK_ASSIGN, source + pos, 1);
                                                                        cur.next = t; cur = t; pos = pos + 1;
                                                                    } else {
                                                                        if (c == '!') {
                                                                            t = new_token(TK_NOT, source + pos, 1);
                                                                            cur.next = t; cur = t; pos = pos + 1;
                                                                        } else {
                                                                            if (c == '<') {
                                                                                t = new_token(TK_LT, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            } else {
                                                                                if (c == '>') {
                                                                                    t = new_token(TK_GT, source + pos, 1);
                                                                                    cur.next = t; cur = t; pos = pos + 1;
                                                                                } else {
                                                                                    pk: int = punct_kind(c);
                                                                                    if (pk < 0) {
                                                                                        error("unexpected character");
                                                                                    }
                                                                                    t = new_token(pk, source + pos, 1);
                                                                                    cur.next = t; cur = t; pos = pos + 1;
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    t = new_token(TK_EOF, source + pos, 0);
    cur.next = t;
    return head.next;
}

equal(kind: int): bool {
    return tok.kind == kind;
}

skip(kind: int) {
    if (!equal(kind)) {
        error("unexpected token");
    }
    tok = tok.next;
}

cur_tokstr(): *i8 {
    return strdup_n(tok.str, tok.len);
}

add_string(s: *i8, n: int): int {
    buf: *i8 = malloc(n + 1) as *i8;
    i: int = 0;
    j: int = 0;
    while (i < n) {
        if (s[i] == '\\' && i + 1 < n) {
            i = i + 1;
            buf[j] = esc_char(s[i]);
            j = j + 1;
        } else {
            buf[j] = s[i];
            j = j + 1;
        }
        i = i + 1;
    }
    buf[j] = 0 trunc i8;
    lit: *StrLit = new StrLit {
        data: buf,
        len: j,
        label: str_count,
        next: str_lits
    };
    str_count = str_count + 1;
    str_lits = lit;
    return lit.label;
}

new_node(kind: int): *Node {
    return new Node {
        kind: kind,
        next: 0,
        lhs: 0,
        rhs: 0,
        cond: 0,
        then: 0,
        els: 0,
        body: 0,
        val: 0,
        var: 0,
        funcname: 0,
        args: 0,
        str_label: 0,
        ty: 0,
        member: 0,
        variant: 0
    };
}

new_binary(kind: int, lhs: *Node, rhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    n.rhs = rhs;
    return n;
}

new_unary(kind: int, lhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    return n;
}

new_num(v: int): *Node {
    n: *Node = new_node(ND_NUM);
    n.val = v;
    n.ty = ty_int;
    return n;
}

find_function(name: *i8): *Function {
    fn: *Function = functions;
    while (fn != 0) {
        if (streq(fn.name, name)) {
            return fn;
        }
        fn = fn.next;
    }
    return 0;
}

find_obj(list: *Obj, name: *i8): *Obj {
    o: *Obj = list;
    while (o != 0) {
        if (streq(o.name, name)) {
            return o;
        }
        o = o.next;
    }
    return 0;
}

find_var(name: *i8): *Obj {
    o: *Obj = find_obj(locals, name);
    if (o != 0) {
        return o;
    }
    return find_obj(globals, name);
}

new_obj(name: *i8, is_local: int): *Obj {
    nxt: *Obj = globals;
    if (is_local != 0) {
        nxt = locals;
    }
    o: *Obj = new Obj {
        name: name,
        is_local: is_local,
        is_func: 0,
        offset: 0,
        ty: 0,
        next: nxt
    };
    if (is_local != 0) {
        locals = o;
    } else {
        globals = o;
    }
    return o;
}

decl_spec(): *Type {
    if (equal(TK_INT)) {
        tok = tok.next;
        return ty_int;
    }
    if (equal(TK_I8)) {
        tok = tok.next;
        return ty_i8;
    }
    if (equal(TK_BOOL)) {
        tok = tok.next;
        return ty_bool;
    }
    if (equal(TK_IDENT)) {
        name: *i8 = cur_tokstr();
        ed: *EnumDef = find_enum(name);
        if (ed != 0) {
            tok = tok.next;
            return enum_type(ed);
        }
        tok = tok.next;
        sd: *StructDef = get_or_create_struct(name);
        return struct_type(sd);
    }
    error("expected type");
    return 0;
}

parse_type(): *Type {
    if (equal(TK_STAR)) {
        tok = tok.next;
        base: *Type = parse_type();
        return ptr_to(base);
    }
    return decl_spec();
}

parse_expr(): *Node {
    return parse_assign();
}

parse_struct_field_inits(sty: *Type): *Node {
    if (!is_struct_ty(sty)) {
        error("struct literal requires a struct type");
    }
    skip(TK_LBRACE);
    head: *Node = 0;
    cur: *Node = 0;
    while (!equal(TK_RBRACE)) {
        if (cur != 0) {
            skip(TK_COMMA);
        }
        if (!equal(TK_IDENT)) {
            error("expected field name in struct literal");
        }
        fname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TK_COLON);
        m: *Member = find_member(type_struct_def(sty), fname);
        if (m == 0) {
            error("unknown field");
        }
        i: *Node = head;
        while (i != 0) {
            if (i.member == m) {
                error("duplicate field in struct literal");
            }
            i = i.next;
        }
        init: *Node = new_node(ND_EXPR_STMT);
        init.member = m;
        if (equal(TK_UNINITIALIZED)) {
            init.lhs = 0;
            tok = tok.next;
        } else {
            init.lhs = parse_expr();
            add_type(init.lhs);
            lt: *Type = decay(m.ty);
            rt: *Type = decay(init.lhs.ty);
            if (!types_equal(lt, rt)) {
                ok: int = 0;
                if (is_pointer(lt) && init.lhs.kind == ND_NUM && init.lhs.val == 0) {
                    ok = 1;
                }
                if (ok == 0) {
                    error("field initializer type mismatch");
                }
            }
        }
        if (cur == 0) {
            head = init;
            cur = init;
        } else {
            cur.next = init;
            cur = init;
        }
    }
    m = type_struct_def(sty).members;
    while (m != 0) {
        found: int = 0;
        i = head;
        while (i != 0) {
            if (i.member == m) {
                found = 1;
            }
            i = i.next;
        }
        if (found == 0) {
            error("struct literal missing field");
        }
        m = m.next;
    }
    skip(TK_RBRACE);
    return head;
}

parse_variant_field_inits(v: *Variant): *Node {
    skip(TK_LBRACE);
    head: *Node = 0;
    cur: *Node = 0;
    while (!equal(TK_RBRACE)) {
        if (cur != 0) {
            skip(TK_COMMA);
        }
        if (!equal(TK_IDENT)) {
            error("expected field name in variant literal");
        }
        fname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TK_COLON);
        m: *Member = 0;
        x: *Member = v.fields;
        while (x != 0) {
            if (streq(x.name, fname)) {
                m = x;
            }
            x = x.next;
        }
        if (m == 0) {
            error("unknown field");
        }
        i: *Node = head;
        while (i != 0) {
            if (i.member == m) {
                error("duplicate field");
            }
            i = i.next;
        }
        init: *Node = new_node(ND_EXPR_STMT);
        init.member = m;
        if (equal(TK_UNINITIALIZED)) {
            init.lhs = 0;
            tok = tok.next;
        } else {
            init.lhs = parse_expr();
            add_type(init.lhs);
            lt: *Type = decay(m.ty);
            rt: *Type = decay(init.lhs.ty);
            if (!types_equal(lt, rt)) {
                ok: int = 0;
                if (is_pointer(lt) && init.lhs.kind == ND_NUM && init.lhs.val == 0) {
                    ok = 1;
                }
                if (ok == 0) {
                    error("field initializer type mismatch");
                }
            }
        }
        if (cur == 0) {
            head = init;
            cur = init;
        } else {
            cur.next = init;
            cur = init;
        }
    }
    m = v.fields;
    while (m != 0) {
        found: int = 0;
        i = head;
        while (i != 0) {
            if (i.member == m) {
                found = 1;
            }
            i = i.next;
        }
        if (found == 0) {
            error("variant literal missing field");
        }
        m = m.next;
    }
    skip(TK_RBRACE);
    return head;
}

parse_primary(): *Node {
    if (equal(TK_NEW)) {
        tok = tok.next;
        base: *Type = parse_type();
        base = parse_type_suffix(base);
        if (is_pointer(base)) {
            error("new expects a non-pointer type");
        }
        if (is_array(base)) {
            error("new of array type not supported yet");
        }
        n: *Node = new_node(ND_NEW);
        n.ty = ptr_to(base);
        if (equal(TK_UNINITIALIZED)) {
            n.val = 1;
            tok = tok.next;
            return n;
        }
        if (!equal(TK_LBRACE)) {
            error("expected uninitialized or { after new Type");
        }
        n.args = parse_struct_field_inits(base);
        n.val = 0;
        return n;
    }
    if (equal(TK_SIZEOF)) {
        tok = tok.next;
        skip(TK_LPAREN);
        if (starts_type()) {
            ty: *Type = parse_type();
            ty = parse_type_suffix(ty);
            skip(TK_RPAREN);
            return new_num(type_size(ty));
        }
        n: *Node = parse_expr();
        skip(TK_RPAREN);
        add_type(n);
        return new_num(type_size(n.ty));
    }
    if (equal(TK_LPAREN)) {
        tok = tok.next;
        n = parse_expr();
        skip(TK_RPAREN);
        return n;
    }
    if (equal(TK_NUM)) {
        n = new_num(tok.val);
        tok = tok.next;
        return n;
    }
    if (equal(TK_TRUE) || equal(TK_FALSE)) {
        v: int = 0;
        if (equal(TK_TRUE)) {
            v = 1;
        }
        n = new_num(v);
        n.ty = ty_bool;
        tok = tok.next;
        return n;
    }
    if (equal(TK_CHAR)) {
        n = new_num(tok.val);
        n.ty = ty_i8;
        tok = tok.next;
        return n;
    }
    if (equal(TK_STR)) {
        label: int = add_string(tok.str, tok.len);
        tok = tok.next;
        n = new_node(ND_NUM);
        n.str_label = label + 1;
        n.ty = ptr_to(ty_i8);
        return n;
    }
    if (equal(TK_IDENT)) {
        name: *i8 = cur_tokstr();
        if (is_type_name() && tok.next.kind == TK_DOT) {
            ety: *Type = parse_type();
            if (!is_enum_ty(ety)) {
                error("variant construction requires an enum type");
            }
            skip(TK_DOT);
            if (!equal(TK_IDENT)) {
                error("expected variant name");
            }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            v: *Variant = find_variant(type_enum_def(ety), vname);
            if (v == 0) {
                error("unknown variant");
            }
            n = new_node(ND_VARIANT_LIT);
            n.ty = ety;
            n.variant = v;
            n.val = v.tag;
            if (equal(TK_LBRACE)) {
                if (v.fields == 0) {
                    error("unit variant does not take fields");
                }
                n.args = parse_variant_field_inits(v);
            } else {
                if (v.fields != 0) {
                    error("variant requires field initializers");
                }
            }
            return n;
        }
        if (is_type_name() && tok.next.kind == TK_LBRACE) {
            sty: *Type = parse_type();
            if (!is_struct_ty(sty)) {
                error("struct literal requires a struct type");
            }
            n = new_node(ND_STRUCT_LIT);
            n.ty = sty;
            n.args = parse_struct_field_inits(sty);
            return n;
        }
        tok = tok.next;
        if (equal(TK_LPAREN)) {
            n = new_node(ND_FUNCALL);
            n.funcname = name;
            tok = tok.next;
            head: *Node = 0;
            cur: *Node = 0;
            while (!equal(TK_RPAREN)) {
                if (cur != 0) {
                    skip(TK_COMMA);
                }
                arg: *Node = parse_expr();
                if (cur == 0) {
                    head = arg;
                    cur = arg;
                } else {
                    cur.next = arg;
                    cur = arg;
                }
            }
            n.args = head;
            skip(TK_RPAREN);
            return n;
        }
        var: *Obj = find_var(name);
        if (var == 0) {
            error("undefined variable");
        }
        n = new_node(ND_VAR);
        n.var = var;
        n.ty = var.ty;
        return n;
    }
    error("expected expression");
    return 0;
}

parse_postfix(): *Node {
    n: *Node = parse_primary();
    while (true) {
        if (equal(TK_LBRACK)) {
            tok = tok.next;
            idx: *Node = parse_expr();
            skip(TK_RBRACK);
            add_type(n);
            add_type(idx);
            if (!is_int_ty(decay(idx.ty))) {
                error("array index must be int");
            }
            t: *Type = decay(n.ty);
            if (!is_pointer(t)) {
                error("subscript of non-pointer");
            }
            scaled: *Node = new_binary(ND_MUL, idx, new_num(type_size(type_base(t))));
            n = new_unary(ND_DEREF, new_binary(ND_ADD, n, scaled));
            n.ty = type_base(t);
        } else {
            if (equal(TK_DOT)) {
                if (tok.next.kind == TK_STAR) {
                    tok = tok.next;
                    tok = tok.next;
                    n = new_unary(ND_DEREF, n);
                } else {
                    tok = tok.next;
                    if (!equal(TK_IDENT)) {
                        error("expected member name");
                    }
                    name: *i8 = cur_tokstr();
                    tok = tok.next;
                    add_type(n);
                    t: *Type = decay(n.ty);
                    sty: *Type = n.ty;
                    if (is_pointer(t) && is_struct_ty(type_base(t))) {
                        sty = type_base(t);
                    } else {
                        if (!is_struct_ty(n.ty)) {
                            error("member access on non-struct");
                        }
                    }
                    m: *Member = find_member(type_struct_def(sty), name);
                    if (m == 0) {
                        error("unknown member");
                    }
                    mem: *Node = new_node(ND_MEMBER);
                    mem.lhs = n;
                    mem.member = m;
                    if (m.ty != 0) {
                        mem.ty = m.ty;
                    } else {
                        mem.ty = ty_int;
                    }
                    n = mem;
                }
            } else {
                if (equal(TK_AS) || equal(TK_TRUNC)) {
                    is_trunc: bool = equal(TK_TRUNC);
                    tok = tok.next;
                    ty: *Type = parse_type();
                    ty = parse_type_suffix(ty);
                    add_type(n);
                    if (is_trunc) {
                        check_trunc(n.ty, ty);
                    } else {
                        check_as(n.ty, ty);
                    }
                    if (is_trunc) {
                        n = new_unary(ND_TRUNC, n);
                    } else {
                        n = new_unary(ND_AS, n);
                    }
                    n.ty = ty;
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

parse_unary(): *Node {
    if (equal(TK_PLUS)) {
        tok = tok.next;
        return parse_unary();
    }
    if (equal(TK_MINUS)) {
        tok = tok.next;
        n: *Node = new_unary(ND_NEG, parse_unary());
        return n;
    }
    if (equal(TK_AMP)) {
        tok = tok.next;
        return new_unary(ND_ADDR, parse_unary());
    }
    if (equal(TK_NOT)) {
        tok = tok.next;
        n = new_unary(ND_NOT, parse_unary());
        return n;
    }
    return parse_postfix();
}

add_type(n: *Node) {
    if (n == 0 || n.ty != 0) {
        return;
    }
    add_type(n.lhs);
    add_type(n.rhs);
    add_type(n.cond);
    add_type(n.then);
    add_type(n.els);
    a: *Node = n.args;
    while (a != 0) {
        add_type(a);
        a = a.next;
    }
    if (n.kind == ND_BLOCK) {
        a = n.body;
        while (a != 0) {
            add_type(a);
            a = a.next;
        }
    }
    if (n.kind == ND_NUM) {
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_VAR) {
        n.ty = n.var.ty;
        return;
    }
    if (n.kind == ND_ADD || n.kind == ND_SUB) {
        lt: *Type = decay(n.lhs.ty);
        rt: *Type = decay(n.rhs.ty);
        if (n.kind == ND_ADD && is_pointer(lt) && is_int_ty(rt)) {
            n.ty = lt;
            return;
        }
        if (n.kind == ND_ADD && is_int_ty(lt) && is_pointer(rt)) {
            n.ty = rt;
            return;
        }
        if (n.kind == ND_SUB && is_pointer(lt) && is_int_ty(rt)) {
            n.ty = lt;
            return;
        }
        if (n.kind == ND_SUB && is_pointer(lt) && is_pointer(rt)) {
            if (types_equal(lt, rt)) {
                n.ty = ty_int;
                return;
            }
        }
        if (!is_int_ty(lt) || !is_int_ty(rt)) {
            error("arithmetic requires int operands");
        }
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_MUL || n.kind == ND_DIV || n.kind == ND_MOD) {
        if (!is_int_ty(decay(n.lhs.ty)) || !is_int_ty(decay(n.rhs.ty))) {
            error("arithmetic requires int operands");
        }
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_EQ || n.kind == ND_NE || n.kind == ND_LT || n.kind == ND_LE || n.kind == ND_GT || n.kind == ND_GE) {
        lt: *Type = decay(n.lhs.ty);
        rt: *Type = decay(n.rhs.ty);
        if (!types_equal(lt, rt)) {
            ok: int = 0;
            if (is_pointer(lt) && n.rhs.kind == ND_NUM && n.rhs.val == 0) {
                ok = 1;
            }
            if (is_pointer(rt) && n.lhs.kind == ND_NUM && n.lhs.val == 0) {
                ok = 1;
            }
            if (ok == 0) {
                error("comparison type mismatch");
            }
        }
        n.ty = ty_bool;
        return;
    }
    if (n.kind == ND_LOGAND || n.kind == ND_LOGOR) {
        if (!is_bool_ty(decay(n.lhs.ty)) || !is_bool_ty(decay(n.rhs.ty))) {
            error("&& / || require bool operands");
        }
        n.ty = ty_bool;
        return;
    }
    if (n.kind == ND_NOT) {
        if (!is_bool_ty(decay(n.lhs.ty))) {
            error("! requires bool");
        }
        n.ty = ty_bool;
        return;
    }
    if (n.kind == ND_NEG) {
        if (!is_int_ty(decay(n.lhs.ty))) {
            error("unary - requires int");
        }
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_ASSIGN) {
        lt: *Type = decay(n.lhs.ty);
        rt: *Type = decay(n.rhs.ty);
        if (is_array(n.lhs.ty)) {
            error("cannot assign to array");
        }
        if (!types_equal(lt, rt)) {
            null_ok: int = 0;
            if (is_pointer(lt) && n.rhs.kind == ND_NUM && n.rhs.val == 0) {
                null_ok = 1;
            }
            if (null_ok == 0) {
                error("assignment type mismatch");
            }
        }
        n.ty = n.lhs.ty;
        return;
    }
    if (n.kind == ND_AS || n.kind == ND_TRUNC) {
        return;
    }
    if (n.kind == ND_ADDR) {
        if (is_array(n.lhs.ty)) {
            n.ty = ptr_to(type_base(n.lhs.ty));
        } else {
            n.ty = ptr_to(n.lhs.ty);
        }
        return;
    }
    if (n.kind == ND_DEREF) {
        t: *Type = decay(n.lhs.ty);
        if (is_pointer(t)) {
            n.ty = type_base(t);
        } else {
            error("dereferencing non-pointer");
        }
        return;
    }
    if (n.kind == ND_MEMBER) {
        if (n.member.ty != 0) {
            n.ty = n.member.ty;
        } else {
            n.ty = ty_int;
        }
        return;
    }
    if (n.kind == ND_FUNCALL) {
        f: *Obj = find_obj(globals, n.funcname);
        if (f != 0 && f.is_func != 0) {
            n.ty = f.ty;
        } else {
            n.ty = ty_int;
        }
        fn: *Function = find_function(n.funcname);
        if (fn != 0) {
            a = n.args;
            ai: int = 0;
            while (a != 0) {
                p: *Obj = fn_param(fn, ai);
                if (p != 0 && p.ty != 0) {
                    at: *Type = decay(a.ty);
                    pt: *Type = decay(p.ty);
                    if (!types_equal(at, pt)) {
                        ok: int = 0;
                        if (is_pointer(pt) && a.kind == ND_NUM && a.val == 0) {
                            ok = 1;
                        }
                        if (ok == 0) {
                            error("argument type mismatch");
                        }
                    }
                }
                ai = ai + 1;
                a = a.next;
            }
        }
        return;
    }
    if (n.kind == ND_RETURN) {
        if (n.lhs != 0) {
            if (current_return_ty == 0) {
                error("return with a value in a non-returning function");
            }
            rt: *Type = decay(current_return_ty);
            gt: *Type = decay(n.lhs.ty);
            if (!types_equal(gt, rt)) {
                ok: int = 0;
                if (is_pointer(rt) && n.lhs.kind == ND_NUM && n.lhs.val == 0) {
                    ok = 1;
                }
                if (ok == 0) {
                    error("return type mismatch");
                }
            }
        } else {
            if (current_return_ty != 0) {
                error("return missing a value");
            }
        }
        return;
    }
    if (n.kind == ND_IF || n.kind == ND_WHILE) {
        if (n.cond == 0 || !is_bool_ty(decay(n.cond.ty))) {
            error("condition must be bool");
        }
        return;
    }
    if (n.kind == ND_VARIANT_LIT) {
        return;
    }
    if (n.kind == ND_MATCH) {
        return;
    }
    if (n.kind == ND_MATCH_ARM) {
        return;
    }
}

parse_mul(): *Node {
    n: *Node = parse_unary();
    while (true) {
        if (equal(TK_STAR)) {
            tok = tok.next;
            n = new_binary(ND_MUL, n, parse_unary());
        } else {
            if (equal(TK_SLASH)) {
                tok = tok.next;
                n = new_binary(ND_DIV, n, parse_unary());
            } else {
                if (equal(TK_PERCENT)) {
                    tok = tok.next;
                    n = new_binary(ND_MOD, n, parse_unary());
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

parse_add(): *Node {
    n: *Node = parse_mul();
    while (true) {
        if (equal(TK_PLUS)) {
            tok = tok.next;
            n = new_binary(ND_ADD, n, parse_mul());
        } else {
            if (equal(TK_MINUS)) {
                tok = tok.next;
                n = new_binary(ND_SUB, n, parse_mul());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_relational(): *Node {
    n: *Node = parse_add();
    while (true) {
        if (equal(TK_LT)) {
            tok = tok.next;
            n = new_binary(ND_LT, n, parse_add());
        } else {
            if (equal(TK_GT)) {
                tok = tok.next;
                n = new_binary(ND_GT, n, parse_add());
            } else {
                if (equal(TK_LE)) {
                    tok = tok.next;
                    n = new_binary(ND_LE, n, parse_add());
                } else {
                    if (equal(TK_GE)) {
                        tok = tok.next;
                        n = new_binary(ND_GE, n, parse_add());
                    } else {
                        return n;
                    }
                }
            }
        }
    }
    return n;
}

parse_equality(): *Node {
    n: *Node = parse_relational();
    while (true) {
        if (equal(TK_EQ)) {
            tok = tok.next;
            n = new_binary(ND_EQ, n, parse_relational());
        } else {
            if (equal(TK_NE)) {
                tok = tok.next;
                n = new_binary(ND_NE, n, parse_relational());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_logand(): *Node {
    n: *Node = parse_equality();
    while (equal(TK_AND)) {
        tok = tok.next;
        n = new_binary(ND_LOGAND, n, parse_equality());
    }
    return n;
}

parse_logor(): *Node {
    n: *Node = parse_logand();
    while (equal(TK_OR)) {
        tok = tok.next;
        n = new_binary(ND_LOGOR, n, parse_logand());
    }
    return n;
}

parse_assign(): *Node {
    n: *Node = parse_logor();
    if (equal(TK_ASSIGN)) {
        tok = tok.next;
        return new_binary(ND_ASSIGN, n, parse_assign());
    }
    return n;
}

parse_type_suffix(ty: *Type): *Type {
    if (equal(TK_LBRACK)) {
        tok = tok.next;
        if (!equal(TK_NUM)) {
            error("expected array size");
        }
        ty = array_of(ty, tok.val);
        tok = tok.next;
        skip(TK_RBRACK);
    }
    return ty;
}

parse_decl(is_local: int): *Obj {
    if (!equal(TK_IDENT)) {
        error("expected identifier");
    }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TK_COLON);
    ty: *Type = parse_type();
    ty = parse_type_suffix(ty);
    o: *Obj = new_obj(name, is_local);
    o.ty = ty;
    return o;
}

parse_compound(): *Node {
    n: *Node = new_node(ND_BLOCK);
    skip(TK_LBRACE);
    head: *Node = 0;
    cur: *Node = 0;
    while (!equal(TK_RBRACE)) {
        if (equal(TK_EOF)) {
            error("unterminated block");
        }
        s: *Node = parse_stmt();
        if (cur == 0) {
            head = s;
            cur = s;
        } else {
            cur.next = s;
            cur = s;
        }
    }
    n.body = head;
    skip(TK_RBRACE);
    return n;
}

parse_stmt(): *Node {
    if (equal(TK_RETURN)) {
        n: *Node = new_node(ND_RETURN);
        tok = tok.next;
        if (!equal(TK_SEMI)) {
            n.lhs = parse_expr();
        }
        skip(TK_SEMI);
        return n;
    }
    if (equal(TK_IF)) {
        n = new_node(ND_IF);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.then = parse_stmt();
        if (equal(TK_ELSE)) {
            tok = tok.next;
            n.els = parse_stmt();
        }
        return n;
    }
    if (equal(TK_WHILE)) {
        n = new_node(ND_WHILE);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.body = parse_stmt();
        return n;
    }
    if (equal(TK_MATCH)) {
        n = new_node(ND_MATCH);
        tok = tok.next;
        n.cond = parse_expr();
        add_type(n.cond);
        et: *Type = decay(n.cond.ty);
        if (!is_enum_ty(et)) {
            error("match requires an enum value");
        }
        skip(TK_LBRACE);
        arms: *Node = 0;
        acur: *Node = 0;
        while (!equal(TK_RBRACE)) {
            if (!equal(TK_IDENT)) {
                error("expected variant name in match arm");
            }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            arm: *Node = new_node(ND_MATCH_ARM);
            arm.ty = et;
            b: *Node = 0;
            if (equal(TK_LPAREN)) {
                tok = tok.next;
                if (!equal(TK_IDENT)) {
                    error("expected payload binding name");
                }
                b = new_node(ND_VAR);
                b.funcname = cur_tokstr();
                tok = tok.next;
                skip(TK_RPAREN);
                arm.args = b;
                arm.val = 1;
            } else {
                if (equal(TK_LBRACE)) {
                    tok = tok.next;
                    bhead: *Node = 0;
                    bcur: *Node = 0;
                    while (!equal(TK_RBRACE)) {
                        if (bcur != 0) {
                            skip(TK_COMMA);
                        }
                        if (!equal(TK_IDENT)) {
                            error("expected field binding");
                        }
                        b = new_node(ND_VAR);
                        b.funcname = cur_tokstr();
                        tok = tok.next;
                        if (bcur == 0) {
                            bhead = b;
                            bcur = b;
                        } else {
                            bcur.next = b;
                            bcur = b;
                        }
                    }
                    tok = tok.next;
                    arm.args = bhead;
                }
            }
            skip(TK_ARROW);
            v: *Variant = find_variant(type_enum_def(et), vname);
            if (v == 0) {
                error("unknown variant");
            }
            a: *Node = arms;
            while (a != 0) {
                if (a.variant == v) {
                    error("duplicate match arm");
                }
                a = a.next;
            }
            arm.variant = v;
            if (arm.val != 0) {
                if (v.payload_ty == 0) {
                    error("unit variant cannot bind a payload");
                }
                po: *Obj = new_obj(arm.args.funcname, 1);
                po.ty = v.payload_ty;
                arm.args.var = po;
                arm.args.ty = v.payload_ty;
                arm.args.member = 0;
            } else {
                if (v.fields != 0) {
                    if (arm.args == 0) {
                        error("payload variant requires Name(x) or Name { fields } before ->");
                    }
                    b = arm.args;
                    while (b != 0) {
                        m: *Member = 0;
                        x: *Member = v.fields;
                        while (x != 0) {
                            if (streq(x.name, b.funcname)) {
                                m = x;
                            }
                            x = x.next;
                        }
                        if (m == 0) {
                            error("unknown field in variant");
                        }
                        o2: *Node = arm.args;
                        while (o2 != b) {
                            if (o2.member == m) {
                                error("duplicate binding");
                            }
                            o2 = o2.next;
                        }
                        fo: *Obj = new_obj(b.funcname, 1);
                        fo.ty = m.ty;
                        b.var = fo;
                        b.member = m;
                        b.ty = m.ty;
                        b = b.next;
                    }
                    m2: *Member = v.fields;
                    while (m2 != 0) {
                        found: int = 0;
                        b = arm.args;
                        while (b != 0) {
                            if (b.member == m2) {
                                found = 1;
                            }
                            b = b.next;
                        }
                        if (found == 0) {
                            error("match arm missing binding");
                        }
                        m2 = m2.next;
                    }
                } else {
                    if (arm.args != 0) {
                        error("unit variant takes no bindings");
                    }
                }
            }
            arm.body = parse_compound();
            if (acur == 0) {
                arms = arm;
                acur = arm;
            } else {
                acur.next = arm;
                acur = arm;
            }
        }
        vv: *Variant = type_enum_def(et).variants;
        while (vv != 0) {
            found2: int = 0;
            a = arms;
            while (a != 0) {
                if (a.variant == vv) {
                    found2 = 1;
                }
                a = a.next;
            }
            if (found2 == 0) {
                error("match not exhaustive");
            }
            vv = vv.next;
        }
        n.body = arms;
        tok = tok.next;
        return n;
    }
    if (equal(TK_LBRACE)) {
        return parse_compound();
    }
    if (equal(TK_IDENT) && tok.next.kind == TK_COLON) {
        o: *Obj = parse_decl(1);
        if (equal(TK_COMMA)) {
            error("only one variable per declaration");
        }
        skip(TK_ASSIGN);
        if (equal(TK_UNINITIALIZED)) {
            tok = tok.next;
            skip(TK_SEMI);
            return new_node(ND_BLOCK);
        }
        rhs: *Node = parse_expr();
        skip(TK_SEMI);
        lhs: *Node = new_node(ND_VAR);
        lhs.var = o;
        lhs.ty = o.ty;
        as_node: *Node = new_binary(ND_ASSIGN, lhs, rhs);
        es: *Node = new_node(ND_EXPR_STMT);
        es.lhs = as_node;
        return es;
    }
    n = new_node(ND_EXPR_STMT);
    n.lhs = parse_expr();
    skip(TK_SEMI);
    return n;
}

fn_param(fn: *Function, i: int): *Obj {
    if (i == 0) { return fn.p0; }
    if (i == 1) { return fn.p1; }
    if (i == 2) { return fn.p2; }
    if (i == 3) { return fn.p3; }
    if (i == 4) { return fn.p4; }
    return fn.p5;
}

set_fn_param(fn: *Function, i: int, p: *Obj) {
    if (i == 0) { fn.p0 = p; }
    if (i == 1) { fn.p1 = p; }
    if (i == 2) { fn.p2 = p; }
    if (i == 3) { fn.p3 = p; }
    if (i == 4) { fn.p4 = p; }
    if (i == 5) { fn.p5 = p; }
}

parse_function(name: *i8): *Function {
    fn: *Function = new Function {
        name: name,
        nparams: 0,
        p0: 0,
        p1: 0,
        p2: 0,
        p3: 0,
        p4: 0,
        p5: 0,
        locals: 0,
        body: 0,
        stack_size: 0,
        return_ty: 0,
        next: 0
    };
    locals = 0;
    skip(TK_LPAREN);
    np: int = 0;
    while (!equal(TK_RPAREN)) {
        if (np != 0) {
            skip(TK_COMMA);
        }
        if (np >= 6) {
            error("too many parameters");
        }
        p: *Obj = parse_decl(1);
        set_fn_param(fn, np, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TK_RPAREN);
    if (equal(TK_COLON)) {
        tok = tok.next;
        fn.return_ty = parse_type();
    }
    fn.body = parse_compound();
    fn.locals = locals;
    return fn;
}

parse_field_list(base_offset: int): *Member {
    head: *Member = 0;
    cur: *Member = 0;
    offset: int = base_offset;
    while (!equal(TK_RBRACE)) {
        if (!equal(TK_IDENT)) {
            error("expected field name");
        }
        mname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TK_COLON);
        mty: *Type = parse_type();
        mty = parse_type_suffix(mty);
        m: *Member = new Member {
            name: mname,
            offset: offset,
            ty: mty,
            next: 0
        };
        offset = offset + 8;
        if (cur == 0) {
            head = m;
            cur = m;
        } else {
            cur.next = m;
            cur = m;
        }
        skip(TK_SEMI);
    }
    field_list_size = offset - base_offset;
    tok = tok.next;
    return head;
}

parse_variant(tag: int, enum_name: *i8): *Variant {
    if (!equal(TK_IDENT)) {
        error("expected variant name");
    }
    v: *Variant = new Variant {
        name: cur_tokstr(),
        tag: tag,
        fields: 0,
        payload_ty: 0,
        payload_size: 0,
        next: 0
    };
    tok = tok.next;
    if (equal(TK_LBRACE)) {
        tok = tok.next;
        v.fields = parse_field_list(0);
        v.payload_size = field_list_size;
        sd: *StructDef = new StructDef {
            name: variant_payload_name(enum_name, v.name),
            members: v.fields,
            size: field_list_size,
            next: 0
        };
        v.payload_ty = struct_type(sd);
    }
    return v;
}

parse_type_def() {
    tok = tok.next;
    if (!equal(TK_IDENT)) {
        error("expected type name");
    }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TK_ASSIGN);

    if (equal(TK_LBRACE)) {
        if (find_enum(name) != 0) {
            error("redefinition of type");
        }
        sd: *StructDef = get_or_create_struct(name);
        if (sd.members != 0) {
            error("redefinition of type");
        }
        tok = tok.next;
        sd.members = parse_field_list(0);
        sd.size = field_list_size;
        skip(TK_SEMI);
        return;
    }

    if (find_struct(name) != 0) {
        error("redefinition of type");
    }
    ed: *EnumDef = get_or_create_enum(name);
    if (ed.variants != 0) {
        error("redefinition of type");
    }

    head: *Variant = 0;
    cur: *Variant = 0;
    tag: int = 0;
    max_payload: int = 0;
    done: int = 0;
    while (done == 0) {
        v: *Variant = parse_variant(tag, name);
        x: *Variant = head;
        while (x != 0) {
            if (streq(x.name, v.name)) {
                error("duplicate variant");
            }
            x = x.next;
        }
        if (v.payload_size > max_payload) {
            max_payload = v.payload_size;
        }
        if (cur == 0) {
            head = v;
            cur = v;
        } else {
            cur.next = v;
            cur = v;
        }
        tag = tag + 1;
        if (equal(TK_PIPE)) {
            tok = tok.next;
        } else {
            done = 1;
        }
    }
    if (head == 0) {
        error("enum type needs at least one variant");
    }
    ed.variants = head;
    ed.size = 8 + max_payload;
    skip(TK_SEMI);
}

parse_program() {
    tail: *Function = 0;
    functions = 0;
    while (!equal(TK_EOF)) {
        if (equal(TK_TYPE) && tok.next.kind == TK_IDENT && tok.next.next.kind == TK_ASSIGN) {
            parse_type_def();
        } else {
            if (!equal(TK_IDENT)) {
                error("expected identifier");
            }
            name: *i8 = cur_tokstr();
            tok = tok.next;
            if (equal(TK_LPAREN)) {
                fn: *Function = parse_function(name);
                if (tail == 0) {
                    functions = fn;
                    tail = fn;
                } else {
                    tail.next = fn;
                    tail = fn;
                }
                o: *Obj = new_obj(name, 0);
                o.is_func = 1;
                o.ty = fn.return_ty;
            } else {
                skip(TK_COLON);
                ty: *Type = parse_type();
                ty = parse_type_suffix(ty);
                if (equal(TK_COMMA)) {
                    error("only one variable per declaration");
                }
                o = new_obj(name, 0);
                o.ty = ty;
                skip(TK_SEMI);
            }
        }
    }
}

new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    return l;
}

is_byte_ty(t: *Type): bool {
    return t != 0 && type_size(t) == 1;
}

load_mem(ty: *Type) {
    if (is_byte_ty(ty)) {
        emit("  movzb (%rax), %rax\n");
    } else {
        emit("  mov (%rax), %rax\n");
    }
}

store_mem(ty: *Type) {
    if (is_byte_ty(ty)) {
        emit("  mov %al, (%rdi)\n");
    } else {
        emit("  mov %rax, (%rdi)\n");
    }
}

gen_struct_inits(inits: *Node) {
    init: *Node = inits;
    while (init != 0) {
        if (init.lhs != 0) {
            emit("  mov (%rsp), %rax\n");
            if (init.member.offset != 0) {
                emit("  add $");
                emit_num(init.member.offset);
                emit(", %rax\n");
            }
            emit("  push %rax\n");
            gen_expr(init.lhs);
            emit("  pop %rdi\n");
            mty: *Type = ty_int;
            if (init.member.ty != 0) {
                mty = init.member.ty;
            }
            store_mem(mty);
        }
        init = init.next;
    }
}

gen_variant_inits(inits: *Node) {
    init: *Node = inits;
    while (init != 0) {
        if (init.lhs != 0) {
            emit("  mov (%rsp), %rax\n");
            emit("  add $");
            emit_num(enum_field_offset(init.member));
            emit(", %rax\n");
            emit("  push %rax\n");
            gen_expr(init.lhs);
            emit("  pop %rdi\n");
            mty: *Type = ty_int;
            if (init.member.ty != 0) {
                mty = init.member.ty;
            }
            store_mem(mty);
        }
        init = init.next;
    }
}

gen_addr(n: *Node) {
    add_type(n);
    if (n.kind == ND_VAR) {
        if (n.var.is_local != 0) {
            emit("  lea ");
            emit_num(n.var.offset);
            emit("(%rbp), %rax\n");
        } else {
            emit("  lea ");
            emit(n.var.name);
            emit("(%rip), %rax\n");
        }
        return;
    }
    if (n.kind == ND_DEREF) {
        gen_expr(n.lhs);
        return;
    }
    if (n.kind == ND_MEMBER) {
        add_type(n.lhs);
        t: *Type = decay(n.lhs.ty);
        if (is_pointer(t) && is_struct_ty(type_base(t))) {
            gen_expr(n.lhs);
        } else {
            gen_addr(n.lhs);
        }
        if (n.member.offset != 0) {
            emit("  add $");
            emit_num(n.member.offset);
            emit(", %rax\n");
        }
        return;
    }
    error("not an lvalue");
}

gen_expr(n: *Node) {
    k: int = n.kind;
    add_type(n);
    if (k == ND_NUM) {
        if (n.str_label != 0) {
            emit("  lea .L.str");
            emit_num(n.str_label - 1);
            emit("+8(%rip), %rax\n");
        } else {
            emit("  mov $");
            emit_num(n.val);
            emit(", %rax\n");
        }
        return;
    }
    if (k == ND_VAR) {
        gen_addr(n);
        if (is_array(n.ty) || is_aggregate(n.ty)) {
            return;
        }
        load_mem(n.ty);
        return;
    }
    if (k == ND_MEMBER) {
        gen_addr(n);
        load_mem(n.ty);
        return;
    }
    if (k == ND_ADDR) {
        gen_addr(n.lhs);
        return;
    }
    if (k == ND_AS || k == ND_TRUNC) {
        gen_expr(n.lhs);
        return;
    }
    if (k == ND_NEW) {
        base: *Type = type_base(n.ty);
        sz: int = type_size(base);
        if (sz <= 0) {
            sz = 8;
        }
        emit("  mov $");
        emit_num(sz);
        emit(", %rdi\n");
        emit("  call malloc\n");
        if (n.val == 0) {
            emit("  push %rax\n");
            gen_struct_inits(n.args);
            emit("  pop %rax\n");
        }
        return;
    }
    if (k == ND_STRUCT_LIT) {
        sz: int = type_size(n.ty);
        if (sz <= 0) {
            sz = 8;
        }
        sz = (sz + 15) / 16 * 16;
        emit("  sub $");
        emit_num(sz);
        emit(", %rsp\n");
        emit("  mov %rsp, %rax\n");
        emit("  push %rax\n");
        gen_struct_inits(n.args);
        emit("  pop %rax\n");
        return;
    }
    if (k == ND_VARIANT_LIT) {
        sz: int = type_size(n.ty);
        if (sz <= 0) {
            sz = 8;
        }
        sz = (sz + 15) / 16 * 16;
        emit("  sub $");
        emit_num(sz);
        emit(", %rsp\n");
        emit("  mov %rsp, %rax\n");
        emit("  push %rax\n");
        emit("  mov $");
        emit_num(n.val);
        emit(", %rdi\n");
        emit("  mov %rdi, (%rax)\n");
        gen_variant_inits(n.args);
        emit("  pop %rax\n");
        return;
    }
    if (k == ND_DEREF) {
        gen_expr(n.lhs);
        load_mem(n.ty);
        return;
    }
    if (k == ND_ASSIGN) {
        add_type(n.lhs);
        if (n.rhs.kind == ND_STRUCT_LIT && is_struct_ty(n.lhs.ty)) {
            gen_addr(n.lhs);
            emit("  push %rax\n");
            gen_struct_inits(n.rhs.args);
            emit("  pop %rax\n");
            return;
        }
        if (n.rhs.kind == ND_VARIANT_LIT && is_enum_ty(n.lhs.ty)) {
            gen_addr(n.lhs);
            emit("  push %rax\n");
            emit("  mov $");
            emit_num(n.rhs.val);
            emit(", %rdi\n");
            emit("  mov %rdi, (%rax)\n");
            gen_variant_inits(n.rhs.args);
            emit("  pop %rax\n");
            return;
        }
        gen_addr(n.lhs);
        emit("  push %rax\n");
        gen_expr(n.rhs);
        emit("  pop %rdi\n");
        if (is_aggregate(n.lhs.ty)) {
            sz: int = type_size(n.lhs.ty);
            if (sz <= 0) {
                sz = 8;
            }
            emit("  mov %rax, %rsi\n");
            i: int = 0;
            while (i < sz) {
                emit("  movzb ");
                emit_num(i);
                emit("(%rsi), %rax\n");
                emit("  mov %al, ");
                emit_num(i);
                emit("(%rdi)\n");
                i = i + 1;
            }
            emit("  mov %rdi, %rax\n");
        } else {
            store_mem(n.lhs.ty);
        }
        return;
    }
    if (k == ND_NOT) {
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  sete %al\n");
        emit("  movzb %al, %rax\n");
        return;
    }
    if (k == ND_NEG) {
        gen_expr(n.lhs);
        emit("  neg %rax\n");
        return;
    }
    if (k == ND_LOGAND) {
        l: int = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_LOGOR) {
        l = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  jne .L.true"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit(".L.true"); emit_num(l); emit(":\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_FUNCALL) {
        nargs: int = 0;
        a: *Node = n.args;
        while (a != 0) {
            nargs = nargs + 1;
            a = a.next;
        }
        if (nargs > 6) {
            error("too many arguments");
        }
        a = n.args;
        while (a != 0) {
            gen_expr(a);
            emit("  push %rax\n");
            a = a.next;
        }
        i: int = nargs - 1;
        while (i >= 0) {
            emit("  pop ");
            emit(reg_name(i));
            emit("\n");
            i = i - 1;
        }
        emit("  sub $8, %rsp\n");
        emit("  call ");
        emit(n.funcname);
        emit("\n");
        emit("  add $8, %rsp\n");
        return;
    }

    gen_expr(n.lhs);
    emit("  push %rax\n");
    gen_expr(n.rhs);
    emit("  mov %rax, %rdi\n");
    emit("  pop %rax\n");

    if (k == ND_ADD) { emit("  add %rdi, %rax\n"); return; }
    if (k == ND_SUB) { emit("  sub %rdi, %rax\n"); return; }
    if (k == ND_MUL) { emit("  imul %rdi, %rax\n"); return; }
    if (k == ND_DIV) { emit("  cqo\n"); emit("  idiv %rdi\n"); return; }
    if (k == ND_MOD) {
        emit("  cqo\n"); emit("  idiv %rdi\n"); emit("  mov %rdx, %rax\n"); return;
    }
    if (k == ND_EQ) {
        emit("  cmp %rdi, %rax\n"); emit("  sete %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_NE) {
        emit("  cmp %rdi, %rax\n"); emit("  setne %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_LT) {
        emit("  cmp %rdi, %rax\n"); emit("  setl %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_LE) {
        emit("  cmp %rdi, %rax\n"); emit("  setle %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_GT) {
        emit("  cmp %rdi, %rax\n"); emit("  setg %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_GE) {
        emit("  cmp %rdi, %rax\n"); emit("  setge %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    error("invalid expression");
}

gen_stmt(n: *Node) {
    add_type(n);
    k: int = n.kind;
    if (k == ND_RETURN) {
        if (n.lhs != 0) {
            gen_expr(n.lhs);
        } else {
            emit("  mov $0, %rax\n");
        }
        emit("  jmp .L.return.");
        emit(current_fn_name);
        emit("\n");
        return;
    }
    if (k == ND_EXPR_STMT) {
        gen_expr(n.lhs);
        return;
    }
    if (k == ND_BLOCK) {
        s: *Node = n.body;
        while (s != 0) {
            gen_stmt(s);
            s = s.next;
        }
        return;
    }
    if (k == ND_IF) {
        l: int = new_label();
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.else"); emit_num(l); emit("\n");
        gen_stmt(n.then);
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.else"); emit_num(l); emit(":\n");
        if (n.els != 0) {
            gen_stmt(n.els);
        }
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_WHILE) {
        l = new_label();
        emit(".L.begin"); emit_num(l); emit(":\n");
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.end"); emit_num(l); emit("\n");
        gen_stmt(n.body);
        emit("  jmp .L.begin"); emit_num(l); emit("\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_MATCH) {
        l = new_label();
        add_type(n.cond);
        if (n.cond.kind == ND_VAR || n.cond.kind == ND_MEMBER || n.cond.kind == ND_DEREF) {
            gen_addr(n.cond);
        } else {
            gen_expr(n.cond);
        }
        emit("  push %rax\n");
        emit("  mov (%rax), %rax\n");
        emit("  push %rax\n");
        arm: *Node = n.body;
        while (arm != 0) {
            la: int = new_label();
            emit("  mov (%rsp), %rax\n");
            emit("  cmp $");
            emit_num(arm.variant.tag);
            emit(", %rax\n");
            emit("  jne .L.arm");
            emit_num(la);
            emit("\n");
            b: *Node = arm.args;
            while (b != 0) {
                if (b.member == 0) {
                    psz: int = arm.variant.payload_size;
                    emit("  mov 8(%rsp), %rsi\n");
                    emit("  add $8, %rsi\n");
                    emit("  lea ");
                    emit_num(b.var.offset);
                    emit("(%rbp), %rdi\n");
                    i: int = 0;
                    while (i < psz) {
                        emit("  movzb ");
                        emit_num(i);
                        emit("(%rsi), %rax\n");
                        emit("  mov %al, ");
                        emit_num(i);
                        emit("(%rdi)\n");
                        i = i + 1;
                    }
                } else {
                    emit("  mov 8(%rsp), %rax\n");
                    emit("  add $");
                    emit_num(enum_field_offset(b.member));
                    emit(", %rax\n");
                    bty: *Type = ty_int;
                    if (b.member.ty != 0) {
                        bty = b.member.ty;
                    }
                    load_mem(bty);
                    emit("  mov %rax, ");
                    emit_num(b.var.offset);
                    emit("(%rbp)\n");
                }
                b = b.next;
            }
            gen_stmt(arm.body);
            emit("  jmp .L.matchend");
            emit_num(l);
            emit("\n");
            emit(".L.arm");
            emit_num(la);
            emit(":\n");
            arm = arm.next;
        }
        emit("  mov $1, %rdi\n");
        emit("  call exit\n");
        emit(".L.matchend");
        emit_num(l);
        emit(":\n");
        emit("  add $16, %rsp\n");
        return;
    }
    error("invalid statement");
}

assign_lvar_offsets(fn: *Function) {
    off: int = 0;
    v: *Obj = fn.locals;
    while (v != 0) {
        sz: int = type_size(v.ty);
        if (sz <= 0) {
            sz = 8;
        }
        if (!is_array(v.ty)) {
            if (sz < 8) {
                sz = 8;
            }
        } else {
            sz = (sz + 7) / 8 * 8;
        }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 15) / 16 * 16;
}

emit_data() {
    g: *Obj = globals;
    emit(".section .bss\n");
    emit(".align 8\n");
    while (g != 0) {
        if (g.is_func == 0) {
            sz: int = 8;
            if (g.ty != 0) {
                sz = type_size(g.ty);
            }
            if (sz <= 0) {
                sz = 8;
            }
            emit(g.name);
            emit(": .skip ");
            emit_num(sz);
            emit("\n");
        }
        g = g.next;
    }
    emit(".section .rodata\n");
    emit(".align 8\n");
    i: int = 0;
    while (i < str_count) {
        s: *StrLit = str_lits;
        while (s != 0 && s.label != i) {
            s = s.next;
        }
        if (s != 0) {
            emit(".L.str");
            emit_num(i);
            emit(":\n");
            emit("  .quad ");
            emit_num(s.len);
            emit("\n");
            emit("  .byte ");
            j: int = 0;
            while (j < s.len) {
                if (j != 0) {
                    emit(",");
                }
                emit_num(s.data[j] as int);
                j = j + 1;
            }
            if (s.len == 0) {
                emit("0");
            } else {
                emit(",0");
            }
            emit("\n");
        }
        i = i + 1;
    }
}

emit_text() {
    fn: *Function = functions;
    emit(".section .text\n");
    while (fn != 0) {
        assign_lvar_offsets(fn);
        current_fn_name = fn.name;
        current_return_ty = fn.return_ty;
        emit(".globl ");
        emit(fn.name);
        emit("\n");
        emit(fn.name);
        emit(":\n");
        emit("  push %rbp\n");
        emit("  mov %rsp, %rbp\n");
        emit("  sub $");
        emit_num(fn.stack_size);
        emit(", %rsp\n");
        i: int = 0;
        while (i < fn.nparams) {
            p: *Obj = fn_param(fn, i);
            emit("  mov ");
            emit(reg_name(i));
            emit(", ");
            emit_num(p.offset);
            emit("(%rbp)\n");
            i = i + 1;
        }
        gen_stmt(fn.body);
        emit(".L.return.");
        emit(fn.name);
        emit(":\n");
        emit("  mov %rbp, %rsp\n");
        emit("  pop %rbp\n");
        emit("  ret\n");
        fn = fn.next;
    }
}

codegen() {
    emit_data();
    emit_text();
}

main(argc: int, argv: *int): int {
    if (argc != 2) {
        error("usage: l8c <file.l8>");
    }
    path: *i8 = (argv + 8).* as *i8;
    init_kinds();
    source = read_file(path);
    tok = tokenize();
    parse_program();
    codegen();
    return 0;
}
