// L8 self-hosted compiler → x86-64 Linux GAS
// Uses structs for AST/types; implements the full L8 language including structs.

struct Member {
    name: *i8;
    offset: int;
    ty: *Type;
    next: *Member;
};

struct StructDef {
    name: *i8;
    members: *Member;
    size: int;
    next: *StructDef;
};

struct Type {
    kind: int;
    base: *Type;
    array_len: int;
    struct_def: *StructDef;
    size: int;
};

struct Token {
    kind: int;
    val: int;
    str: *i8;
    len: int;
    next: *Token;
};

struct Node {
    kind: int;
    next: *Node;
    lhs: *Node;
    rhs: *Node;
    cond: *Node;
    then: *Node;
    els: *Node;
    body: *Node;
    val: int;
    var: *Obj;
    funcname: *i8;
    args: *Node;
    str_label: int;
    ty: *Type;
    member: *Member;
};

struct Obj {
    name: *i8;
    is_local: int;
    is_func: int;
    offset: int;
    ty: *Type;
    next: *Obj;
};

struct Function {
    name: *i8;
    nparams: int;
    p0: *Obj;
    p1: *Obj;
    p2: *Obj;
    p3: *Obj;
    p4: *Obj;
    p5: *Obj;
    locals: *Obj;
    body: *Node;
    stack_size: int;
    return_ty: *Type;
    next: *Function;
};

struct StrLit {
    data: *i8;
    len: int;
    label: int;
    next: *StrLit;
};

// type kinds
TY_INT: int; TY_I8: int; TY_PTR: int; TY_ARRAY: int; TY_STRUCT: int;

// token kinds
TK_EOF: int; TK_NUM: int; TK_CHAR: int; TK_STR: int; TK_IDENT: int;
TK_INT: int; TK_I8: int; TK_IF: int; TK_ELSE: int; TK_WHILE: int; TK_RETURN: int;
TK_STRUCT: int; TK_SIZEOF: int; TK_UNINITIALIZED: int; TK_AS: int; TK_TRUNC: int; TK_NEW: int;
TK_EQ: int; TK_NE: int; TK_LE: int; TK_GE: int;
TK_PLUS: int; TK_MINUS: int; TK_STAR: int; TK_SLASH: int; TK_PERCENT: int;
TK_LT: int; TK_GT: int; TK_ASSIGN: int; TK_NOT: int; TK_AMP: int;
TK_LPAREN: int; TK_RPAREN: int; TK_LBRACE: int; TK_RBRACE: int;
TK_LBRACK: int; TK_RBRACK: int; TK_SEMI: int; TK_COMMA: int; TK_COLON: int;
TK_AND: int; TK_OR: int; TK_DOT: int;

// node kinds
ND_NUM: int; ND_VAR: int; ND_ADD: int; ND_SUB: int; ND_MUL: int; ND_DIV: int; ND_MOD: int;
ND_EQ: int; ND_NE: int; ND_LT: int; ND_LE: int; ND_GT: int; ND_GE: int;
ND_ASSIGN: int; ND_ADDR: int; ND_DEREF: int; ND_NOT: int; ND_NEG: int;
ND_FUNCALL: int; ND_RETURN: int; ND_IF: int; ND_WHILE: int; ND_BLOCK: int; ND_EXPR_STMT: int;
ND_LOGAND: int; ND_LOGOR: int; ND_MEMBER: int; ND_AS: int; ND_TRUNC: int; ND_NEW: int; ND_STRUCT_LIT: int;

source: *i8; source_len: int; pos: int;
tok: *Token;
globals: *Obj;
locals: *Obj;
functions: *Function;
struct_defs: *StructDef;
ty_int: *Type;
ty_i8: *Type;
str_lits: *StrLit;
str_count: int;
label_id: int;
current_fn_name: *i8;
current_return_ty: *Type;
REG0: *i8; REG1: *i8; REG2: *i8; REG3: *i8; REG4: *i8; REG5: *i8;


strlen(s: *i8): int {
    return len(s);
}

streq_n(a: *i8, b: *i8, n: int): int {
    i: int = 0;
    while (i < n) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

streq(a: *i8, b: *i8): int {
    i: int = 0;
    while (1) {
        if (a[i] != b[i]) {
            return 0;
        }
        if (a[i] == 0 trunc i8) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

memcpy(dst: *i8, src: *i8, n: int): *i8 {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return dst;
}

strdup_n(s: *i8, n: int): *i8 {
    p: *int = malloc(n + 16) as *int;
    p.* = n;
    data: *i8 = (p as *i8) + 8;
    memcpy(data, s, n);
    data[n] = 0 trunc i8;
    return data;
}

is_space(c: i8): int {
    return c == ' ' || c == '\n' || c == '\r' || c == '\t';
}

is_digit(c: i8): int {
    return c >= '0' && c <= '9';
}

is_ident1(c: i8): int {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    return c == '_';
}

is_ident2(c: i8): int {
    return is_ident1(c) || is_digit(c);
}

emit(s: *i8) {
    write(1, s, len(s));
}

emit_ch(c: i8) {
    write(1, &c, 1);
}

emit_num(n: int) {
    buf: i8[32] = uninitialized;
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch('0');
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = (('0' as int) + (n % 10)) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    if (neg) {
        emit_ch('-');
    }
    while (i > 0) {
        i = i - 1;
        emit_ch(buf[i]);
    }
}

error(msg: *i8) {
    write(2, "error: ", len("error: "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
    exit(1);
}

init_kinds() {
    TY_INT = 0; TY_I8 = 1; TY_PTR = 2; TY_ARRAY = 3; TY_STRUCT = 4;
    TK_EOF = 0; TK_NUM = 1; TK_CHAR = 2; TK_STR = 3; TK_IDENT = 4;
    TK_INT = 5; TK_I8 = 6; TK_IF = 7; TK_ELSE = 8; TK_WHILE = 9; TK_RETURN = 10;
    TK_STRUCT = 11; TK_SIZEOF = 12; TK_UNINITIALIZED = 13; TK_AS = 14; TK_TRUNC = 15; TK_NEW = 16;
    TK_EQ = 17; TK_NE = 18; TK_LE = 19; TK_GE = 20;
    TK_PLUS = 21; TK_MINUS = 22; TK_STAR = 23; TK_SLASH = 24; TK_PERCENT = 25;
    TK_LT = 26; TK_GT = 27; TK_ASSIGN = 28; TK_NOT = 29; TK_AMP = 30;
    TK_LPAREN = 31; TK_RPAREN = 32; TK_LBRACE = 33; TK_RBRACE = 34;
    TK_LBRACK = 35; TK_RBRACK = 36; TK_SEMI = 37; TK_COMMA = 38; TK_COLON = 39;
    TK_AND = 40; TK_OR = 41; TK_DOT = 42;
    ND_NUM = 0; ND_VAR = 1; ND_ADD = 2; ND_SUB = 3; ND_MUL = 4; ND_DIV = 5; ND_MOD = 6;
    ND_EQ = 7; ND_NE = 8; ND_LT = 9; ND_LE = 10; ND_GT = 11; ND_GE = 12;
    ND_ASSIGN = 13; ND_ADDR = 14; ND_DEREF = 15; ND_NOT = 16; ND_NEG = 17;
    ND_FUNCALL = 18; ND_RETURN = 19; ND_IF = 20; ND_WHILE = 21; ND_BLOCK = 22;
    ND_EXPR_STMT = 23; ND_LOGAND = 24; ND_LOGOR = 25; ND_MEMBER = 26; ND_AS = 27; ND_TRUNC = 28; ND_NEW = 29; ND_STRUCT_LIT = 30;
    REG0 = "%rdi"; REG1 = "%rsi"; REG2 = "%rdx";
    REG3 = "%rcx"; REG4 = "%r8"; REG5 = "%r9";
    ty_int = new Type {
        kind: TY_INT,
        base: 0,
        array_len: 0,
        struct_def: 0,
        size: 8
    };
    ty_i8 = new Type {
        kind: TY_I8,
        base: 0,
        array_len: 0,
        struct_def: 0,
        size: 1
    };
}

reg_name(i: int): *i8 {
    if (i == 0) { return REG0; }
    if (i == 1) { return REG1; }
    if (i == 2) { return REG2; }
    if (i == 3) { return REG3; }
    if (i == 4) { return REG4; }
    return REG5;
}

read_file(path: *i8): *i8 {
    fd: int = open(path, 0, 0);
    if (fd < 0) {
        error("cannot open file");
    }
    cap: int = 65536;
    buf: *i8 = malloc(cap) as *i8;
    n: int = 0;
    while (1) {
        if (n + 4096 > cap) {
            cap = cap * 2;
            tmp: *i8 = malloc(cap) as *i8;
            memcpy(tmp, buf, n);
            buf = tmp;
        }
        r: int = read(fd, buf + n, 4096);
        if (r <= 0) {
            buf[n] = 0 trunc i8;
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    return buf;
}

ptr_to(base: *Type): *Type {
    return new Type {
        kind: TY_PTR,
        base: base,
        array_len: 0,
        struct_def: 0,
        size: 8
    };
}

array_of(base: *Type, len: int): *Type {
    return new Type {
        kind: TY_ARRAY,
        base: base,
        array_len: len,
        struct_def: 0,
        size: base.size * len
    };
}

struct_type(sd: *StructDef): *Type {
    return new Type {
        kind: TY_STRUCT,
        base: 0,
        array_len: 0,
        struct_def: sd,
        size: sd.size
    };
}

find_struct(name: *i8): *StructDef {
    s: *StructDef = struct_defs;
    while (s != 0) {
        if (streq(s.name, name)) {
            return s;
        }
        s = s.next;
    }
    return 0;
}

get_or_create_struct(name: *i8): *StructDef {
    sd: *StructDef = find_struct(name);
    if (sd != 0) {
        return sd;
    }
    sd = new StructDef {
        name: name,
        members: 0,
        size: 0,
        next: struct_defs
    };
    struct_defs = sd;
    return sd;
}

is_type_name(): int {
    if (equal(TK_IDENT) == 0) {
        return 0;
    }
    name: *i8 = strdup_n(tok.str, tok.len);
    if (find_struct(name) != 0) {
        return 1;
    }
    return 0;
}

starts_type(): int {
    if (equal(TK_INT) || equal(TK_I8) || is_type_name()) {
        return 1;
    }
    t: *Token = tok;
    while (t.kind == TK_STAR) {
        t = t.next;
    }
    if (t != tok) {
        if (t.kind == TK_INT || t.kind == TK_I8) {
            return 1;
        }
        if (t.kind == TK_IDENT) {
            if (find_struct(strdup_n(t.str, t.len)) != 0) {
                return 1;
            }
        }
    }
    return 0;
}

find_member(sd: *StructDef, name: *i8): *Member {
    m: *Member = sd.members;
    while (m != 0) {
        if (streq(m.name, name)) {
            return m;
        }
        m = m.next;
    }
    return 0;
}

is_pointer(t: *Type): int {
    return t != 0 && t.kind == TY_PTR;
}

is_array(t: *Type): int {
    return t != 0 && t.kind == TY_ARRAY;
}

is_struct_ty(t: *Type): int {
    return t != 0 && t.kind == TY_STRUCT;
}


is_i8_ty(t: *Type): int {
    return t != 0 && t.kind == TY_I8;
}

is_int_ty(t: *Type): int {
    return t != 0 && t.kind == TY_INT;
}

types_equal(a: *Type, b: *Type): int {
    if (a == b) {
        return 1;
    }
    if (a == 0 || b == 0) {
        return 0;
    }
    if (a.kind != b.kind) {
        return 0;
    }
    if (a.kind == TY_PTR) {
        return types_equal(a.base, b.base);
    }
    if (a.kind == TY_ARRAY) {
        if (a.array_len != b.array_len) {
            return 0;
        }
        return types_equal(a.base, b.base);
    }
    if (a.kind == TY_STRUCT) {
        return a.struct_def == b.struct_def;
    }
    return 1;
}

is_word_ty(t: *Type): int {
    t = decay(t);
    return t != 0 && t.size == 8;
}

check_as(from: *Type, to: *Type) {
    from = decay(from);
    to = decay(to);
    if (types_equal(from, to)) {
        return;
    }
    if (is_i8_ty(from) && is_int_ty(to)) {
        return;
    }
    if (is_word_ty(from) && is_word_ty(to)) {
        return;
    }
    error("invalid as conversion");
}

check_trunc(from: *Type, to: *Type) {
    from = decay(from);
    to = decay(to);
    if (is_int_ty(from) && is_i8_ty(to)) {
        return;
    }
    error("invalid trunc conversion");
}

decay(t: *Type): *Type {
    if (is_array(t)) {
        return ptr_to(t.base);
    }
    return t;
}

new_token(kind: int, start: *i8, len: int): *Token {
    return new Token {
        kind: kind,
        val: 0,
        str: start,
        len: len,
        next: 0
    };
}

ident_kind(s: *i8, n: int): int {
    if (n == 3 && streq_n(s, "int", 3)) { return TK_INT; }
    if (n == 2 && streq_n(s, "i8", 2)) { return TK_I8; }
    if (n == 2 && streq_n(s, "if", 2)) { return TK_IF; }
    if (n == 4 && streq_n(s, "else", 4)) { return TK_ELSE; }
    if (n == 5 && streq_n(s, "while", 5)) { return TK_WHILE; }
    if (n == 6 && streq_n(s, "return", 6)) { return TK_RETURN; }
    if (n == 6 && streq_n(s, "struct", 6)) { return TK_STRUCT; }
    if (n == 6 && streq_n(s, "sizeof", 6)) { return TK_SIZEOF; }
    if (n == 13 && streq_n(s, "uninitialized", 13)) { return TK_UNINITIALIZED; }
    if (n == 2 && streq_n(s, "as", 2)) { return TK_AS; }
    if (n == 5 && streq_n(s, "trunc", 5)) { return TK_TRUNC; }
    if (n == 3 && streq_n(s, "new", 3)) { return TK_NEW; }
    return TK_IDENT;
}

skip_line_comment() {
    while (pos < source_len) {
        if (source[pos] == '\n') {
            return;
        }
        pos = pos + 1;
    }
}

skip_block_comment() {
    while (pos < source_len) {
        if (source[pos] == '*' && source[pos + 1] == '/') {
            pos = pos + 2;
            return;
        }
        pos = pos + 1;
    }
}

read_number(): int {
    v: int = 0;
    while (pos < source_len) {
        if (is_digit(source[pos]) == 0) {
            return v;
        }
        v = v * 10 + ((source[pos] as int) - ('0' as int));
        pos = pos + 1;
    }
    return v;
}

esc_char(c: i8): i8 {
    if (c == 'n') { return '\n'; }
    if (c == 't') { return '\t'; }
    if (c == 'r') { return '\r'; }
    if (c == '0') { return 0 trunc i8; }
    if (c == '\\') { return '\\'; }
    if (c == '\'') { return '\''; }
    if (c == '"') { return '"'; }
    return c;
}

scan_string_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (source[pos] == '"') {
            return pos - start;
        }
        if (source[pos] == '\\') {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    error("unterminated string");
    return 0;
}

scan_ident_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (is_ident2(source[pos]) == 0) {
            return pos - start;
        }
        pos = pos + 1;
    }
    return pos - start;
}

punct_kind(c: i8): int {
    if (c == '+') { return TK_PLUS; }
    if (c == '-') { return TK_MINUS; }
    if (c == '*') { return TK_STAR; }
    if (c == '%') { return TK_PERCENT; }
    if (c == '&') { return TK_AMP; }
    if (c == '.') { return TK_DOT; }
    if (c == ':') { return TK_COLON; }
    if (c == '(') { return TK_LPAREN; }
    if (c == ')') { return TK_RPAREN; }
    if (c == '{') { return TK_LBRACE; }
    if (c == '}') { return TK_RBRACE; }
    if (c == '[') { return TK_LBRACK; }
    if (c == ']') { return TK_RBRACK; }
    if (c == ';') { return TK_SEMI; }
    if (c == ',') { return TK_COMMA; }
    if (c == '/') { return TK_SLASH; }
    return 0 - 1;
}

tokenize(): *Token {
    head: *Token = new Token {
        kind: 0,
        val: 0,
        str: 0,
        len: 0,
        next: 0
    };
    cur: *Token = head;
    pos = 0;
    while (pos < source_len) {
        c: i8 = source[pos];
        if (is_space(c)) {
            pos = pos + 1;
        } else {
            if (c == '/' && source[pos + 1] == '/') {
                pos = pos + 2;
                skip_line_comment();
            } else {
                if (c == '/' && source[pos + 1] == '*') {
                    pos = pos + 2;
                    skip_block_comment();
                } else {
                    if (is_digit(c)) {
                        s: *i8 = source + pos;
                        v: int = read_number();
                        t: *Token = new_token(TK_NUM, s, (source + pos) - s);
                        t.val = v;
                        cur.next = t;
                        cur = t;
                    } else {
                        if (c == '"') {
                            pos = pos + 1;
                            s = source + pos;
                            n: int = scan_string_len();
                            t = new_token(TK_STR, s, n);
                            cur.next = t;
                            cur = t;
                            pos = pos + 1;
                        } else {
                            if (c == '\'') {
                                pos = pos + 1;
                                ch: i8 = uninitialized;
                                if (source[pos] == '\\') {
                                    pos = pos + 1;
                                    ch = esc_char(source[pos]);
                                    pos = pos + 1;
                                } else {
                                    ch = source[pos];
                                    pos = pos + 1;
                                }
                                if (source[pos] == '\'') {
                                    pos = pos + 1;
                                }
                                t = new_token(TK_CHAR, source + pos, 0);
                                t.val = ch as int;
                                cur.next = t;
                                cur = t;
                            } else {
                                if (is_ident1(c)) {
                                    s = source + pos;
                                    n = scan_ident_len();
                                    t = new_token(ident_kind(s, n), s, n);
                                    cur.next = t;
                                    cur = t;
                                } else {
                                    if (c == '=' && source[pos + 1] == '=') {
                                        t = new_token(TK_EQ, source + pos, 2);
                                        cur.next = t; cur = t; pos = pos + 2;
                                    } else {
                                        if (c == '!' && source[pos + 1] == '=') {
                                            t = new_token(TK_NE, source + pos, 2);
                                            cur.next = t; cur = t; pos = pos + 2;
                                        } else {
                                            if (c == '<' && source[pos + 1] == '=') {
                                                t = new_token(TK_LE, source + pos, 2);
                                                cur.next = t; cur = t; pos = pos + 2;
                                            } else {
                                                if (c == '>' && source[pos + 1] == '=') {
                                                    t = new_token(TK_GE, source + pos, 2);
                                                    cur.next = t; cur = t; pos = pos + 2;
                                                } else {
                                                    if (c == '&' && source[pos + 1] == '&') {
                                                        t = new_token(TK_AND, source + pos, 2);
                                                        cur.next = t; cur = t; pos = pos + 2;
                                                    } else {
                                                        if (c == '|' && source[pos + 1] == '|') {
                                                            t = new_token(TK_OR, source + pos, 2);
                                                            cur.next = t; cur = t; pos = pos + 2;
                                                        } else {
                                                                if (c == '=') {
                                                                    t = new_token(TK_ASSIGN, source + pos, 1);
                                                                    cur.next = t; cur = t; pos = pos + 1;
                                                                } else {
                                                                    if (c == '!') {
                                                                        t = new_token(TK_NOT, source + pos, 1);
                                                                        cur.next = t; cur = t; pos = pos + 1;
                                                                    } else {
                                                                        if (c == '<') {
                                                                            t = new_token(TK_LT, source + pos, 1);
                                                                            cur.next = t; cur = t; pos = pos + 1;
                                                                        } else {
                                                                            if (c == '>') {
                                                                                t = new_token(TK_GT, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            } else {
                                                                                pk: int = punct_kind(c);
                                                                                if (pk < 0) {
                                                                                    error("unexpected character");
                                                                                }
                                                                                t = new_token(pk, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    t = new_token(TK_EOF, source + pos, 0);
    cur.next = t;
    return head.next;
}

equal(kind: int): int {
    return tok.kind == kind;
}

skip(kind: int) {
    if (equal(kind) == 0) {
        error("unexpected token");
    }
    tok = tok.next;
}

cur_tokstr(): *i8 {
    return strdup_n(tok.str, tok.len);
}

add_string(s: *i8, n: int): int {
    buf: *i8 = malloc(n + 1) as *i8;
    i: int = 0;
    j: int = 0;
    while (i < n) {
        if (s[i] == '\\' && i + 1 < n) {
            i = i + 1;
            buf[j] = esc_char(s[i]);
            j = j + 1;
        } else {
            buf[j] = s[i];
            j = j + 1;
        }
        i = i + 1;
    }
    buf[j] = 0 trunc i8;
    lit: *StrLit = new StrLit {
        data: buf,
        len: j,
        label: str_count,
        next: str_lits
    };
    str_count = str_count + 1;
    str_lits = lit;
    return lit.label;
}

new_node(kind: int): *Node {
    return new Node {
        kind: kind,
        next: 0,
        lhs: 0,
        rhs: 0,
        cond: 0,
        then: 0,
        els: 0,
        body: 0,
        val: 0,
        var: 0,
        funcname: 0,
        args: 0,
        str_label: 0,
        ty: 0,
        member: 0
    };
}

new_binary(kind: int, lhs: *Node, rhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    n.rhs = rhs;
    return n;
}

new_unary(kind: int, lhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    return n;
}

new_num(v: int): *Node {
    n: *Node = new_node(ND_NUM);
    n.val = v;
    n.ty = ty_int;
    return n;
}

find_function(name: *i8): *Function {
    fn: *Function = functions;
    while (fn != 0) {
        if (streq(fn.name, name)) {
            return fn;
        }
        fn = fn.next;
    }
    return 0;
}

find_obj(list: *Obj, name: *i8): *Obj {
    o: *Obj = list;
    while (o != 0) {
        if (streq(o.name, name)) {
            return o;
        }
        o = o.next;
    }
    return 0;
}

find_var(name: *i8): *Obj {
    o: *Obj = find_obj(locals, name);
    if (o != 0) {
        return o;
    }
    return find_obj(globals, name);
}

new_obj(name: *i8, is_local: int): *Obj {
    nxt: *Obj = globals;
    if (is_local) {
        nxt = locals;
    }
    o: *Obj = new Obj {
        name: name,
        is_local: is_local,
        is_func: 0,
        offset: 0,
        ty: 0,
        next: nxt
    };
    if (is_local) {
        locals = o;
    } else {
        globals = o;
    }
    return o;
}

decl_spec(): *Type {
    if (equal(TK_INT)) {
        tok = tok.next;
        return ty_int;
    }
    if (equal(TK_I8)) {
        tok = tok.next;
        return ty_i8;
    }
    if (equal(TK_IDENT)) {
        name: *i8 = cur_tokstr();
        tok = tok.next;
        sd: *StructDef = get_or_create_struct(name);
        return struct_type(sd);
    }
    error("expected type");
    return 0;
}

parse_type(): *Type {
    if (equal(TK_STAR)) {
        tok = tok.next;
        base: *Type = parse_type();
        return ptr_to(base);
    }
    return decl_spec();
}

parse_expr(): *Node {
    return parse_assign();
}

parse_struct_field_inits(sty: *Type): *Node {
    if (is_struct_ty(sty) == 0) {
        error("struct literal requires a struct type");
    }
    skip(TK_LBRACE);
    head: *Node = 0;
    cur: *Node = 0;
    while (equal(TK_RBRACE) == 0) {
        if (cur != 0) {
            skip(TK_COMMA);
        }
        if (equal(TK_IDENT) == 0) {
            error("expected field name in struct literal");
        }
        fname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TK_COLON);
        m: *Member = find_member(sty.struct_def, fname);
        if (m == 0) {
            error("unknown field");
        }
        i: *Node = head;
        while (i != 0) {
            if (i.member == m) {
                error("duplicate field in struct literal");
            }
            i = i.next;
        }
        init: *Node = new_node(ND_EXPR_STMT);
        init.member = m;
        if (equal(TK_UNINITIALIZED)) {
            init.lhs = 0;
            tok = tok.next;
        } else {
            init.lhs = parse_expr();
            add_type(init.lhs);
            lt: *Type = decay(m.ty);
            rt: *Type = decay(init.lhs.ty);
            if (types_equal(lt, rt) == 0) {
                ok: int = 0;
                if (is_pointer(lt) && init.lhs.kind == ND_NUM && init.lhs.val == 0) {
                    ok = 1;
                }
                if (ok == 0) {
                    error("field initializer type mismatch");
                }
            }
        }
        if (cur == 0) {
            head = init;
            cur = init;
        } else {
            cur.next = init;
            cur = init;
        }
    }
    m = sty.struct_def.members;
    while (m != 0) {
        found: int = 0;
        i = head;
        while (i != 0) {
            if (i.member == m) {
                found = 1;
            }
            i = i.next;
        }
        if (found == 0) {
            error("struct literal missing field");
        }
        m = m.next;
    }
    skip(TK_RBRACE);
    return head;
}

parse_primary(): *Node {
    if (equal(TK_NEW)) {
        tok = tok.next;
        base: *Type = parse_type();
        base = parse_type_suffix(base);
        if (is_pointer(base)) {
            error("new expects a non-pointer type");
        }
        if (is_array(base)) {
            error("new of array type not supported yet");
        }
        n: *Node = new_node(ND_NEW);
        n.ty = ptr_to(base);
        if (equal(TK_UNINITIALIZED)) {
            n.val = 1;
            tok = tok.next;
            return n;
        }
        if (equal(TK_LBRACE) == 0) {
            error("expected uninitialized or { after new Type");
        }
        n.args = parse_struct_field_inits(base);
        n.val = 0;
        return n;
    }
    if (equal(TK_SIZEOF)) {
        tok = tok.next;
        skip(TK_LPAREN);
        if (starts_type()) {
            ty: *Type = parse_type();
            ty = parse_type_suffix(ty);
            skip(TK_RPAREN);
            return new_num(ty.size);
        }
        n: *Node = parse_expr();
        skip(TK_RPAREN);
        add_type(n);
        return new_num(n.ty.size);
    }
    if (equal(TK_LPAREN)) {
        tok = tok.next;
        n = parse_expr();
        skip(TK_RPAREN);
        return n;
    }
    if (equal(TK_NUM)) {
        n = new_num(tok.val);
        tok = tok.next;
        return n;
    }
    if (equal(TK_CHAR)) {
        n = new_num(tok.val);
        n.ty = ty_i8;
        tok = tok.next;
        return n;
    }
    if (equal(TK_STR)) {
        label: int = add_string(tok.str, tok.len);
        tok = tok.next;
        n = new_node(ND_NUM);
        n.str_label = label + 1;
        n.ty = ptr_to(ty_i8);
        return n;
    }
    if (equal(TK_IDENT)) {
        name: *i8 = cur_tokstr();
        if (is_type_name() && tok.next.kind == TK_LBRACE) {
            sty: *Type = parse_type();
            if (is_struct_ty(sty) == 0) {
                error("struct literal requires a struct type");
            }
            n = new_node(ND_STRUCT_LIT);
            n.ty = sty;
            n.args = parse_struct_field_inits(sty);
            return n;
        }
        tok = tok.next;
        if (equal(TK_LPAREN)) {
            n = new_node(ND_FUNCALL);
            n.funcname = name;
            tok = tok.next;
            head: *Node = 0;
            cur: *Node = 0;
            while (equal(TK_RPAREN) == 0) {
                if (cur != 0) {
                    skip(TK_COMMA);
                }
                arg: *Node = parse_expr();
                if (cur == 0) {
                    head = arg;
                    cur = arg;
                } else {
                    cur.next = arg;
                    cur = arg;
                }
            }
            n.args = head;
            skip(TK_RPAREN);
            return n;
        }
        var: *Obj = find_var(name);
        if (var == 0) {
            error("undefined variable");
        }
        n = new_node(ND_VAR);
        n.var = var;
        n.ty = var.ty;
        return n;
    }
    error("expected expression");
    return 0;
}

parse_postfix(): *Node {
    n: *Node = parse_primary();
    while (1) {
        if (equal(TK_LBRACK)) {
            tok = tok.next;
            idx: *Node = parse_expr();
            skip(TK_RBRACK);
            add_type(n);
            add_type(idx);
            if (is_int_ty(decay(idx.ty)) == 0) {
                error("array index must be int");
            }
            t: *Type = decay(n.ty);
            if (is_pointer(t) == 0) {
                error("subscript of non-pointer");
            }
            scaled: *Node = new_binary(ND_MUL, idx, new_num(t.base.size));
            n = new_unary(ND_DEREF, new_binary(ND_ADD, n, scaled));
            n.ty = t.base;
        } else {
            if (equal(TK_DOT)) {
                if (tok.next.kind == TK_STAR) {
                    tok = tok.next;
                    tok = tok.next;
                    n = new_unary(ND_DEREF, n);
                } else {
                    tok = tok.next;
                    if (equal(TK_IDENT) == 0) {
                        error("expected member name");
                    }
                    name: *i8 = cur_tokstr();
                    tok = tok.next;
                    add_type(n);
                    t: *Type = decay(n.ty);
                    sty: *Type = n.ty;
                    if (is_pointer(t) && is_struct_ty(t.base)) {
                        sty = t.base;
                    } else {
                        if (is_struct_ty(n.ty) == 0) {
                            error("member access on non-struct");
                        }
                    }
                    m: *Member = find_member(sty.struct_def, name);
                    if (m == 0) {
                        error("unknown member");
                    }
                    mem: *Node = new_node(ND_MEMBER);
                    mem.lhs = n;
                    mem.member = m;
                    if (m.ty != 0) {
                        mem.ty = m.ty;
                    } else {
                        mem.ty = ty_int;
                    }
                    n = mem;
                }
            } else {
                if (equal(TK_AS) || equal(TK_TRUNC)) {
                    is_trunc: int = equal(TK_TRUNC);
                    tok = tok.next;
                    ty: *Type = parse_type();
                    ty = parse_type_suffix(ty);
                    add_type(n);
                    if (is_trunc) {
                        check_trunc(n.ty, ty);
                    } else {
                        check_as(n.ty, ty);
                    }
                    if (is_trunc) {
                        n = new_unary(ND_TRUNC, n);
                    } else {
                        n = new_unary(ND_AS, n);
                    }
                    n.ty = ty;
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

parse_unary(): *Node {
    if (equal(TK_PLUS)) {
        tok = tok.next;
        return parse_unary();
    }
    if (equal(TK_MINUS)) {
        tok = tok.next;
        n: *Node = new_unary(ND_NEG, parse_unary());
        return n;
    }
    if (equal(TK_AMP)) {
        tok = tok.next;
        return new_unary(ND_ADDR, parse_unary());
    }
    if (equal(TK_NOT)) {
        tok = tok.next;
        n = new_unary(ND_NOT, parse_unary());
        return n;
    }
    return parse_postfix();
}

add_type(n: *Node) {
    if (n == 0 || n.ty != 0) {
        return;
    }
    add_type(n.lhs);
    add_type(n.rhs);
    add_type(n.cond);
    add_type(n.then);
    add_type(n.els);
    a: *Node = n.args;
    while (a != 0) {
        add_type(a);
        a = a.next;
    }
    if (n.kind == ND_BLOCK) {
        a = n.body;
        while (a != 0) {
            add_type(a);
            a = a.next;
        }
    }
    if (n.kind == ND_NUM) {
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_VAR) {
        n.ty = n.var.ty;
        return;
    }
    if (n.kind == ND_ADD || n.kind == ND_SUB) {
        lt: *Type = decay(n.lhs.ty);
        rt: *Type = decay(n.rhs.ty);
        if (n.kind == ND_ADD && is_pointer(lt) && is_int_ty(rt)) {
            n.ty = lt;
            return;
        }
        if (n.kind == ND_ADD && is_int_ty(lt) && is_pointer(rt)) {
            n.ty = rt;
            return;
        }
        if (n.kind == ND_SUB && is_pointer(lt) && is_int_ty(rt)) {
            n.ty = lt;
            return;
        }
        if (n.kind == ND_SUB && is_pointer(lt) && is_pointer(rt)) {
            if (types_equal(lt, rt)) {
                n.ty = ty_int;
                return;
            }
        }
        if (is_int_ty(lt) == 0 || is_int_ty(rt) == 0) {
            error("arithmetic requires int operands");
        }
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_MUL || n.kind == ND_DIV || n.kind == ND_MOD) {
        if (is_int_ty(decay(n.lhs.ty)) == 0 || is_int_ty(decay(n.rhs.ty)) == 0) {
            error("arithmetic requires int operands");
        }
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_EQ || n.kind == ND_NE || n.kind == ND_LT || n.kind == ND_LE || n.kind == ND_GT || n.kind == ND_GE) {
        lt: *Type = decay(n.lhs.ty);
        rt: *Type = decay(n.rhs.ty);
        if (types_equal(lt, rt) == 0) {
            ok: int = 0;
            if (is_pointer(lt) && n.rhs.kind == ND_NUM && n.rhs.val == 0) {
                ok = 1;
            }
            if (is_pointer(rt) && n.lhs.kind == ND_NUM && n.lhs.val == 0) {
                ok = 1;
            }
            if (ok == 0) {
                error("comparison type mismatch");
            }
        }
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_LOGAND || n.kind == ND_LOGOR) {
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_NOT || n.kind == ND_NEG) {
        if (is_int_ty(decay(n.lhs.ty)) == 0) {
            error("unary requires int");
        }
        n.ty = ty_int;
        return;
    }
    if (n.kind == ND_ASSIGN) {
        lt: *Type = decay(n.lhs.ty);
        rt: *Type = decay(n.rhs.ty);
        if (is_array(n.lhs.ty)) {
            error("cannot assign to array");
        }
        if (types_equal(lt, rt) == 0) {
            null_ok: int = 0;
            if (is_pointer(lt) && n.rhs.kind == ND_NUM && n.rhs.val == 0) {
                null_ok = 1;
            }
            if (null_ok == 0) {
                error("assignment type mismatch");
            }
        }
        n.ty = n.lhs.ty;
        return;
    }
    if (n.kind == ND_AS || n.kind == ND_TRUNC) {
        return;
    }
    if (n.kind == ND_ADDR) {
        if (is_array(n.lhs.ty)) {
            n.ty = ptr_to(n.lhs.ty.base);
        } else {
            n.ty = ptr_to(n.lhs.ty);
        }
        return;
    }
    if (n.kind == ND_DEREF) {
        t: *Type = decay(n.lhs.ty);
        if (is_pointer(t)) {
            n.ty = t.base;
        } else {
            error("dereferencing non-pointer");
        }
        return;
    }
    if (n.kind == ND_MEMBER) {
        if (n.member.ty != 0) {
            n.ty = n.member.ty;
        } else {
            n.ty = ty_int;
        }
        return;
    }
    if (n.kind == ND_FUNCALL) {
        f: *Obj = find_obj(globals, n.funcname);
        if (f != 0 && f.is_func) {
            n.ty = f.ty;
        } else {
            n.ty = ty_int;
        }
        fn: *Function = find_function(n.funcname);
        if (fn != 0) {
            a = n.args;
            ai: int = 0;
            while (a != 0) {
                p: *Obj = fn_param(fn, ai);
                if (p != 0 && p.ty != 0) {
                    at: *Type = decay(a.ty);
                    pt: *Type = decay(p.ty);
                    if (types_equal(at, pt) == 0) {
                        ok: int = 0;
                        if (is_pointer(pt) && a.kind == ND_NUM && a.val == 0) {
                            ok = 1;
                        }
                        if (ok == 0) {
                            error("argument type mismatch");
                        }
                    }
                }
                ai = ai + 1;
                a = a.next;
            }
        }
        return;
    }
    if (n.kind == ND_RETURN) {
        if (n.lhs != 0) {
            if (current_return_ty == 0) {
                error("return with a value in a non-returning function");
            }
            rt: *Type = decay(current_return_ty);
            gt: *Type = decay(n.lhs.ty);
            if (types_equal(gt, rt) == 0) {
                ok: int = 0;
                if (is_pointer(rt) && n.lhs.kind == ND_NUM && n.lhs.val == 0) {
                    ok = 1;
                }
                if (ok == 0) {
                    error("return type mismatch");
                }
            }
        } else {
            if (current_return_ty != 0) {
                error("return missing a value");
            }
        }
        return;
    }
}

parse_mul(): *Node {
    n: *Node = parse_unary();
    while (1) {
        if (equal(TK_STAR)) {
            tok = tok.next;
            n = new_binary(ND_MUL, n, parse_unary());
        } else {
            if (equal(TK_SLASH)) {
                tok = tok.next;
                n = new_binary(ND_DIV, n, parse_unary());
            } else {
                if (equal(TK_PERCENT)) {
                    tok = tok.next;
                    n = new_binary(ND_MOD, n, parse_unary());
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

parse_add(): *Node {
    n: *Node = parse_mul();
    while (1) {
        if (equal(TK_PLUS)) {
            tok = tok.next;
            n = new_binary(ND_ADD, n, parse_mul());
        } else {
            if (equal(TK_MINUS)) {
                tok = tok.next;
                n = new_binary(ND_SUB, n, parse_mul());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_relational(): *Node {
    n: *Node = parse_add();
    while (1) {
        if (equal(TK_LT)) {
            tok = tok.next;
            n = new_binary(ND_LT, n, parse_add());
        } else {
            if (equal(TK_GT)) {
                tok = tok.next;
                n = new_binary(ND_GT, n, parse_add());
            } else {
                if (equal(TK_LE)) {
                    tok = tok.next;
                    n = new_binary(ND_LE, n, parse_add());
                } else {
                    if (equal(TK_GE)) {
                        tok = tok.next;
                        n = new_binary(ND_GE, n, parse_add());
                    } else {
                        return n;
                    }
                }
            }
        }
    }
    return n;
}

parse_equality(): *Node {
    n: *Node = parse_relational();
    while (1) {
        if (equal(TK_EQ)) {
            tok = tok.next;
            n = new_binary(ND_EQ, n, parse_relational());
        } else {
            if (equal(TK_NE)) {
                tok = tok.next;
                n = new_binary(ND_NE, n, parse_relational());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_logand(): *Node {
    n: *Node = parse_equality();
    while (equal(TK_AND)) {
        tok = tok.next;
        n = new_binary(ND_LOGAND, n, parse_equality());
    }
    return n;
}

parse_logor(): *Node {
    n: *Node = parse_logand();
    while (equal(TK_OR)) {
        tok = tok.next;
        n = new_binary(ND_LOGOR, n, parse_logand());
    }
    return n;
}

parse_assign(): *Node {
    n: *Node = parse_logor();
    if (equal(TK_ASSIGN)) {
        tok = tok.next;
        return new_binary(ND_ASSIGN, n, parse_assign());
    }
    return n;
}

parse_type_suffix(ty: *Type): *Type {
    if (equal(TK_LBRACK)) {
        tok = tok.next;
        if (equal(TK_NUM) == 0) {
            error("expected array size");
        }
        ty = array_of(ty, tok.val);
        tok = tok.next;
        skip(TK_RBRACK);
    }
    return ty;
}

parse_decl(is_local: int): *Obj {
    if (equal(TK_IDENT) == 0) {
        error("expected identifier");
    }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TK_COLON);
    ty: *Type = parse_type();
    ty = parse_type_suffix(ty);
    o: *Obj = new_obj(name, is_local);
    o.ty = ty;
    return o;
}

parse_compound(): *Node {
    n: *Node = new_node(ND_BLOCK);
    skip(TK_LBRACE);
    head: *Node = 0;
    cur: *Node = 0;
    while (equal(TK_RBRACE) == 0) {
        if (equal(TK_EOF)) {
            error("unterminated block");
        }
        s: *Node = parse_stmt();
        if (cur == 0) {
            head = s;
            cur = s;
        } else {
            cur.next = s;
            cur = s;
        }
    }
    n.body = head;
    skip(TK_RBRACE);
    return n;
}

parse_stmt(): *Node {
    if (equal(TK_RETURN)) {
        n: *Node = new_node(ND_RETURN);
        tok = tok.next;
        if (equal(TK_SEMI) == 0) {
            n.lhs = parse_expr();
        }
        skip(TK_SEMI);
        return n;
    }
    if (equal(TK_IF)) {
        n = new_node(ND_IF);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.then = parse_stmt();
        if (equal(TK_ELSE)) {
            tok = tok.next;
            n.els = parse_stmt();
        }
        return n;
    }
    if (equal(TK_WHILE)) {
        n = new_node(ND_WHILE);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.body = parse_stmt();
        return n;
    }
    if (equal(TK_LBRACE)) {
        return parse_compound();
    }
    if (equal(TK_IDENT) && tok.next.kind == TK_COLON) {
        o: *Obj = parse_decl(1);
        if (equal(TK_COMMA)) {
            error("only one variable per declaration");
        }
        skip(TK_ASSIGN);
        if (equal(TK_UNINITIALIZED)) {
            tok = tok.next;
            skip(TK_SEMI);
            return new_node(ND_BLOCK);
        }
        rhs: *Node = parse_expr();
        skip(TK_SEMI);
        lhs: *Node = new_node(ND_VAR);
        lhs.var = o;
        lhs.ty = o.ty;
        as_node: *Node = new_binary(ND_ASSIGN, lhs, rhs);
        es: *Node = new_node(ND_EXPR_STMT);
        es.lhs = as_node;
        return es;
    }
    n = new_node(ND_EXPR_STMT);
    n.lhs = parse_expr();
    skip(TK_SEMI);
    return n;
}

fn_param(fn: *Function, i: int): *Obj {
    if (i == 0) { return fn.p0; }
    if (i == 1) { return fn.p1; }
    if (i == 2) { return fn.p2; }
    if (i == 3) { return fn.p3; }
    if (i == 4) { return fn.p4; }
    return fn.p5;
}

set_fn_param(fn: *Function, i: int, p: *Obj) {
    if (i == 0) { fn.p0 = p; }
    if (i == 1) { fn.p1 = p; }
    if (i == 2) { fn.p2 = p; }
    if (i == 3) { fn.p3 = p; }
    if (i == 4) { fn.p4 = p; }
    if (i == 5) { fn.p5 = p; }
}

parse_function(name: *i8): *Function {
    fn: *Function = new Function {
        name: name,
        nparams: 0,
        p0: 0,
        p1: 0,
        p2: 0,
        p3: 0,
        p4: 0,
        p5: 0,
        locals: 0,
        body: 0,
        stack_size: 0,
        return_ty: 0,
        next: 0
    };
    locals = 0;
    skip(TK_LPAREN);
    np: int = 0;
    while (equal(TK_RPAREN) == 0) {
        if (np != 0) {
            skip(TK_COMMA);
        }
        if (np >= 6) {
            error("too many parameters");
        }
        p: *Obj = parse_decl(1);
        set_fn_param(fn, np, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TK_RPAREN);
    if (equal(TK_COLON)) {
        tok = tok.next;
        fn.return_ty = parse_type();
    }
    fn.body = parse_compound();
    fn.locals = locals;
    return fn;
}

parse_struct_def() {
    tok = tok.next;
    if (equal(TK_IDENT) == 0) {
        error("expected tag");
    }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    sd: *StructDef = get_or_create_struct(name);
    if (sd.members != 0) {
        error("redefinition of struct");
    }
    skip(TK_LBRACE);
    head: *Member = 0;
    cur: *Member = 0;
    offset: int = 0;
    while (equal(TK_RBRACE) == 0) {
        if (equal(TK_IDENT) == 0) {
            error("expected member name");
        }
        mname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TK_COLON);
        mty: *Type = parse_type();
        mty = parse_type_suffix(mty);
        m: *Member = new Member {
            name: mname,
            offset: offset,
            ty: mty,
            next: 0
        };
        offset = offset + 8;
        if (cur == 0) {
            head = m;
            cur = m;
        } else {
            cur.next = m;
            cur = m;
        }
        skip(TK_SEMI);
    }
    sd.members = head;
    sd.size = offset;
    skip(TK_RBRACE);
    skip(TK_SEMI);
}

parse_program() {
    tail: *Function = 0;
    functions = 0;
    while (equal(TK_EOF) == 0) {
        if (equal(TK_STRUCT) && tok.next.kind == TK_IDENT && tok.next.next.kind == TK_LBRACE) {
            parse_struct_def();
        } else {
            if (equal(TK_IDENT) == 0) {
                error("expected identifier");
            }
            name: *i8 = cur_tokstr();
            tok = tok.next;
            if (equal(TK_LPAREN)) {
                fn: *Function = parse_function(name);
                if (tail == 0) {
                    functions = fn;
                    tail = fn;
                } else {
                    tail.next = fn;
                    tail = fn;
                }
                o: *Obj = new_obj(name, 0);
                o.is_func = 1;
                o.ty = fn.return_ty;
            } else {
                skip(TK_COLON);
                ty: *Type = parse_type();
                ty = parse_type_suffix(ty);
                if (equal(TK_COMMA)) {
                    error("only one variable per declaration");
                }
                o = new_obj(name, 0);
                o.ty = ty;
                skip(TK_SEMI);
            }
        }
    }
}

new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    return l;
}

is_byte_ty(t: *Type): int {
    return t != 0 && t.size == 1;
}

load_mem(ty: *Type) {
    if (is_byte_ty(ty)) {
        emit("  movzb (%rax), %rax\n");
    } else {
        emit("  mov (%rax), %rax\n");
    }
}

store_mem(ty: *Type) {
    if (is_byte_ty(ty)) {
        emit("  mov %al, (%rdi)\n");
    } else {
        emit("  mov %rax, (%rdi)\n");
    }
}

gen_struct_inits(inits: *Node) {
    init: *Node = inits;
    while (init != 0) {
        if (init.lhs != 0) {
            emit("  mov (%rsp), %rax\n");
            if (init.member.offset != 0) {
                emit("  add $");
                emit_num(init.member.offset);
                emit(", %rax\n");
            }
            emit("  push %rax\n");
            gen_expr(init.lhs);
            emit("  pop %rdi\n");
            mty: *Type = ty_int;
            if (init.member.ty != 0) {
                mty = init.member.ty;
            }
            store_mem(mty);
        }
        init = init.next;
    }
}

gen_addr(n: *Node) {
    add_type(n);
    if (n.kind == ND_VAR) {
        if (n.var.is_local) {
            emit("  lea ");
            emit_num(n.var.offset);
            emit("(%rbp), %rax\n");
        } else {
            emit("  lea ");
            emit(n.var.name);
            emit("(%rip), %rax\n");
        }
        return;
    }
    if (n.kind == ND_DEREF) {
        gen_expr(n.lhs);
        return;
    }
    if (n.kind == ND_MEMBER) {
        add_type(n.lhs);
        t: *Type = decay(n.lhs.ty);
        if (is_pointer(t) && is_struct_ty(t.base)) {
            gen_expr(n.lhs);
        } else {
            gen_addr(n.lhs);
        }
        if (n.member.offset != 0) {
            emit("  add $");
            emit_num(n.member.offset);
            emit(", %rax\n");
        }
        return;
    }
    error("not an lvalue");
}

gen_expr(n: *Node) {
    k: int = n.kind;
    add_type(n);
    if (k == ND_NUM) {
        if (n.str_label != 0) {
            emit("  lea .L.str");
            emit_num(n.str_label - 1);
            emit("+8(%rip), %rax\n");
        } else {
            emit("  mov $");
            emit_num(n.val);
            emit(", %rax\n");
        }
        return;
    }
    if (k == ND_VAR) {
        gen_addr(n);
        if (is_array(n.ty) || is_struct_ty(n.ty)) {
            return;
        }
        load_mem(n.ty);
        return;
    }
    if (k == ND_MEMBER) {
        gen_addr(n);
        load_mem(n.ty);
        return;
    }
    if (k == ND_ADDR) {
        gen_addr(n.lhs);
        return;
    }
    if (k == ND_AS || k == ND_TRUNC) {
        gen_expr(n.lhs);
        return;
    }
    if (k == ND_NEW) {
        base: *Type = n.ty.base;
        sz: int = base.size;
        if (sz <= 0) {
            sz = 8;
        }
        emit("  mov $");
        emit_num(sz);
        emit(", %rdi\n");
        emit("  call malloc\n");
        if (n.val == 0) {
            emit("  push %rax\n");
            gen_struct_inits(n.args);
            emit("  pop %rax\n");
        }
        return;
    }
    if (k == ND_STRUCT_LIT) {
        sz: int = n.ty.size;
        if (sz <= 0) {
            sz = 8;
        }
        sz = (sz + 15) / 16 * 16;
        emit("  sub $");
        emit_num(sz);
        emit(", %rsp\n");
        emit("  mov %rsp, %rax\n");
        emit("  push %rax\n");
        gen_struct_inits(n.args);
        emit("  pop %rax\n");
        return;
    }
    if (k == ND_DEREF) {
        gen_expr(n.lhs);
        load_mem(n.ty);
        return;
    }
    if (k == ND_ASSIGN) {
        add_type(n.lhs);
        if (n.rhs.kind == ND_STRUCT_LIT && is_struct_ty(n.lhs.ty)) {
            gen_addr(n.lhs);
            emit("  push %rax\n");
            gen_struct_inits(n.rhs.args);
            emit("  pop %rax\n");
            return;
        }
        gen_addr(n.lhs);
        emit("  push %rax\n");
        gen_expr(n.rhs);
        emit("  pop %rdi\n");
        if (is_struct_ty(n.lhs.ty)) {
            sz: int = n.lhs.ty.size;
            if (sz <= 0) {
                sz = 8;
            }
            emit("  mov %rax, %rsi\n");
            i: int = 0;
            while (i < sz) {
                emit("  movzb ");
                emit_num(i);
                emit("(%rsi), %rax\n");
                emit("  mov %al, ");
                emit_num(i);
                emit("(%rdi)\n");
                i = i + 1;
            }
            emit("  mov %rdi, %rax\n");
        } else {
            store_mem(n.lhs.ty);
        }
        return;
    }
    if (k == ND_NOT) {
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  sete %al\n");
        emit("  movzb %al, %rax\n");
        return;
    }
    if (k == ND_NEG) {
        gen_expr(n.lhs);
        emit("  neg %rax\n");
        return;
    }
    if (k == ND_LOGAND) {
        l: int = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_LOGOR) {
        l = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  jne .L.true"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit(".L.true"); emit_num(l); emit(":\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_FUNCALL) {
        nargs: int = 0;
        a: *Node = n.args;
        while (a != 0) {
            nargs = nargs + 1;
            a = a.next;
        }
        if (nargs > 6) {
            error("too many arguments");
        }
        a = n.args;
        while (a != 0) {
            gen_expr(a);
            emit("  push %rax\n");
            a = a.next;
        }
        i: int = nargs - 1;
        while (i >= 0) {
            emit("  pop ");
            emit(reg_name(i));
            emit("\n");
            i = i - 1;
        }
        emit("  sub $8, %rsp\n");
        emit("  call ");
        emit(n.funcname);
        emit("\n");
        emit("  add $8, %rsp\n");
        return;
    }

    gen_expr(n.lhs);
    emit("  push %rax\n");
    gen_expr(n.rhs);
    emit("  mov %rax, %rdi\n");
    emit("  pop %rax\n");

    if (k == ND_ADD) { emit("  add %rdi, %rax\n"); return; }
    if (k == ND_SUB) { emit("  sub %rdi, %rax\n"); return; }
    if (k == ND_MUL) { emit("  imul %rdi, %rax\n"); return; }
    if (k == ND_DIV) { emit("  cqo\n"); emit("  idiv %rdi\n"); return; }
    if (k == ND_MOD) {
        emit("  cqo\n"); emit("  idiv %rdi\n"); emit("  mov %rdx, %rax\n"); return;
    }
    if (k == ND_EQ) {
        emit("  cmp %rdi, %rax\n"); emit("  sete %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_NE) {
        emit("  cmp %rdi, %rax\n"); emit("  setne %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_LT) {
        emit("  cmp %rdi, %rax\n"); emit("  setl %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_LE) {
        emit("  cmp %rdi, %rax\n"); emit("  setle %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_GT) {
        emit("  cmp %rdi, %rax\n"); emit("  setg %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_GE) {
        emit("  cmp %rdi, %rax\n"); emit("  setge %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    error("invalid expression");
}

gen_stmt(n: *Node) {
    add_type(n);
    k: int = n.kind;
    if (k == ND_RETURN) {
        if (n.lhs != 0) {
            gen_expr(n.lhs);
        } else {
            emit("  mov $0, %rax\n");
        }
        emit("  jmp .L.return.");
        emit(current_fn_name);
        emit("\n");
        return;
    }
    if (k == ND_EXPR_STMT) {
        gen_expr(n.lhs);
        return;
    }
    if (k == ND_BLOCK) {
        s: *Node = n.body;
        while (s != 0) {
            gen_stmt(s);
            s = s.next;
        }
        return;
    }
    if (k == ND_IF) {
        l: int = new_label();
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.else"); emit_num(l); emit("\n");
        gen_stmt(n.then);
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.else"); emit_num(l); emit(":\n");
        if (n.els != 0) {
            gen_stmt(n.els);
        }
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_WHILE) {
        l = new_label();
        emit(".L.begin"); emit_num(l); emit(":\n");
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.end"); emit_num(l); emit("\n");
        gen_stmt(n.body);
        emit("  jmp .L.begin"); emit_num(l); emit("\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    error("invalid statement");
}

assign_lvar_offsets(fn: *Function) {
    off: int = 0;
    v: *Obj = fn.locals;
    while (v != 0) {
        sz: int = v.ty.size;
        if (sz <= 0) {
            sz = 8;
        }
        if (is_array(v.ty) == 0) {
            if (sz < 8) {
                sz = 8;
            }
        } else {
            sz = (sz + 7) / 8 * 8;
        }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 15) / 16 * 16;
}

emit_data() {
    g: *Obj = globals;
    emit(".section .bss\n");
    emit(".align 8\n");
    while (g != 0) {
        if (g.is_func == 0) {
            sz: int = 8;
            if (g.ty != 0) {
                sz = g.ty.size;
            }
            if (sz <= 0) {
                sz = 8;
            }
            emit(g.name);
            emit(": .skip ");
            emit_num(sz);
            emit("\n");
        }
        g = g.next;
    }
    emit(".section .rodata\n");
    emit(".align 8\n");
    i: int = 0;
    while (i < str_count) {
        s: *StrLit = str_lits;
        while (s != 0 && s.label != i) {
            s = s.next;
        }
        if (s != 0) {
            emit(".L.str");
            emit_num(i);
            emit(":\n");
            emit("  .quad ");
            emit_num(s.len);
            emit("\n");
            emit("  .byte ");
            j: int = 0;
            while (j < s.len) {
                if (j != 0) {
                    emit(",");
                }
                emit_num(s.data[j] as int);
                j = j + 1;
            }
            if (s.len == 0) {
                emit("0");
            } else {
                emit(",0");
            }
            emit("\n");
        }
        i = i + 1;
    }
}

emit_text() {
    fn: *Function = functions;
    emit(".section .text\n");
    while (fn != 0) {
        assign_lvar_offsets(fn);
        current_fn_name = fn.name;
        current_return_ty = fn.return_ty;
        emit(".globl ");
        emit(fn.name);
        emit("\n");
        emit(fn.name);
        emit(":\n");
        emit("  push %rbp\n");
        emit("  mov %rsp, %rbp\n");
        emit("  sub $");
        emit_num(fn.stack_size);
        emit(", %rsp\n");
        i: int = 0;
        while (i < fn.nparams) {
            p: *Obj = fn_param(fn, i);
            emit("  mov ");
            emit(reg_name(i));
            emit(", ");
            emit_num(p.offset);
            emit("(%rbp)\n");
            i = i + 1;
        }
        gen_stmt(fn.body);
        emit(".L.return.");
        emit(fn.name);
        emit(":\n");
        emit("  mov %rbp, %rsp\n");
        emit("  pop %rbp\n");
        emit("  ret\n");
        fn = fn.next;
    }
}

codegen() {
    emit_data();
    emit_text();
}

main(argc: int, argv: *int): int {
    if (argc != 2) {
        error("usage: l8c <file.l8>");
    }
    path: *i8 = (argv + 8).* as *i8;
    init_kinds();
    source = read_file(path);
    tok = tokenize();
    parse_program();
    codegen();
    return 0;
}
