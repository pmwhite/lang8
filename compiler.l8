// L8 self-hosted compiler → x86-64 Linux GAS
// Uses structs for AST/types; implements the full L8 language including structs.

struct Member {
    name: int;
    offset: int;
    ty: *Type;
    next: *Member;
};

struct StructDef {
    name: int;
    members: *Member;
    size: int;
    next: *StructDef;
};

struct Type {
    kind: int;
    base: *Type;
    array_len: int;
    struct_def: *StructDef;
    size: int;
};

struct Token {
    kind: int;
    val: int;
    str: int;
    len: int;
    next: *Token;
};

struct Node {
    kind: int;
    next: *Node;
    lhs: *Node;
    rhs: *Node;
    cond: *Node;
    then: *Node;
    els: *Node;
    body: *Node;
    val: int;
    var: *Obj;
    funcname: int;
    args: *Node;
    str_label: int;
    ty: *Type;
    member: *Member;
};

struct Obj {
    name: int;
    is_local: int;
    is_func: int;
    offset: int;
    ty: *Type;
    next: *Obj;
};

struct Function {
    name: int;
    nparams: int;
    p0: *Obj;
    p1: *Obj;
    p2: *Obj;
    p3: *Obj;
    p4: *Obj;
    p5: *Obj;
    locals: *Obj;
    body: *Node;
    stack_size: int;
    next: *Function;
};

struct StrLit {
    data: int;
    len: int;
    label: int;
    next: *StrLit;
};

// type kinds
TY_INT: int; TY_PTR: int; TY_ARRAY: int; TY_STRUCT: int; TY_STRING: int;

// token kinds
TK_EOF: int; TK_NUM: int; TK_STR: int; TK_IDENT: int;
TK_INT: int; TK_IF: int; TK_ELSE: int; TK_WHILE: int; TK_RETURN: int;
TK_STRUCT: int; TK_SIZEOF: int; TK_STRING: int; TK_UNINITIALIZED: int;
TK_EQ: int; TK_NE: int; TK_LE: int; TK_GE: int;
TK_PLUS: int; TK_MINUS: int; TK_STAR: int; TK_SLASH: int; TK_PERCENT: int;
TK_LT: int; TK_GT: int; TK_ASSIGN: int; TK_NOT: int; TK_AMP: int;
TK_LPAREN: int; TK_RPAREN: int; TK_LBRACE: int; TK_RBRACE: int;
TK_LBRACK: int; TK_RBRACK: int; TK_SEMI: int; TK_COMMA: int; TK_COLON: int;
TK_AND: int; TK_OR: int; TK_DOT: int;

// node kinds
ND_NUM: int; ND_VAR: int; ND_ADD: int; ND_SUB: int; ND_MUL: int; ND_DIV: int; ND_MOD: int;
ND_EQ: int; ND_NE: int; ND_LT: int; ND_LE: int; ND_GT: int; ND_GE: int;
ND_ASSIGN: int; ND_ADDR: int; ND_DEREF: int; ND_NOT: int; ND_NEG: int;
ND_FUNCALL: int; ND_RETURN: int; ND_IF: int; ND_WHILE: int; ND_BLOCK: int; ND_EXPR_STMT: int;
ND_LOGAND: int; ND_LOGOR: int; ND_MEMBER: int;

source: int; source_len: int; pos: int;
tok: *Token;
globals: *Obj;
locals: *Obj;
functions: *Function;
struct_defs: *StructDef;
ty_int: *Type;
ty_string: *Type;
str_lits: *StrLit;
str_count: int;
label_id: int;
current_fn_name: int;
REG0: string; REG1: string; REG2: string; REG3: string; REG4: string; REG5: string;


strlen(s: int): int {
    return len(s);
}

streq_n(a: int, b: int, n: int): int {
    i: int = 0;
    while (i < n) {
        if (loadb(a + i) != loadb(b + i)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

streq(a: int, b: int): int {
    i: int = 0;
    while (1) {
        ca: int = loadb(a + i);
        cb: int = loadb(b + i);
        if (ca != cb) {
            return 0;
        }
        if (ca == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

memcpy(dst: int, src: int, n: int): int {
    i: int = 0;
    while (i < n) {
        storeb(dst + i, loadb(src + i));
        i = i + 1;
    }
    return dst;
}

strdup_n(s: int, n: int): int {
    p: int = malloc(n + 16);
    p.* = n;
    memcpy(p + 8, s, n);
    storeb(p + 8 + n, 0);
    return p + 8;
}

is_space(c: int): int {
    return c == 32 || c == 10 || c == 13 || c == 9;
}

is_digit(c: int): int {
    return c >= 48 && c <= 57;
}

is_ident1(c: int): int {
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    return c == 95;
}

is_ident2(c: int): int {
    return is_ident1(c) || is_digit(c);
}

emit(s: string): int {
    write(1, s, len(s));
    return 0;
}

emit_ch(c: int): int {
    ch: int = c;
    write(1, &ch, 1);
    return 0;
}

emit_num(n: int): int {
    buf: int[32] = uninitialized;
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch(48);
        return 0;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = 48 + (n % 10);
        n = n / 10;
        i = i + 1;
    }
    if (neg) {
        emit_ch(45);
    }
    while (i > 0) {
        i = i - 1;
        emit_ch(buf[i]);
    }
    return 0;
}

error(msg: string): int {
    write(2, "error: ", len("error: "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
    exit(1);
    return 0;
}

init_kinds(): int {
    TY_INT = 0; TY_PTR = 1; TY_ARRAY = 2; TY_STRUCT = 3; TY_STRING = 4;
    TK_EOF = 0; TK_NUM = 1; TK_STR = 2; TK_IDENT = 3;
    TK_INT = 4; TK_IF = 5; TK_ELSE = 6; TK_WHILE = 7; TK_RETURN = 8;
    TK_STRUCT = 9; TK_SIZEOF = 10; TK_STRING = 11; TK_UNINITIALIZED = 12;
    TK_EQ = 13; TK_NE = 14; TK_LE = 15; TK_GE = 16;
    TK_PLUS = 17; TK_MINUS = 18; TK_STAR = 19; TK_SLASH = 20; TK_PERCENT = 21;
    TK_LT = 22; TK_GT = 23; TK_ASSIGN = 24; TK_NOT = 25; TK_AMP = 26;
    TK_LPAREN = 27; TK_RPAREN = 28; TK_LBRACE = 29; TK_RBRACE = 30;
    TK_LBRACK = 31; TK_RBRACK = 32; TK_SEMI = 33; TK_COMMA = 34; TK_COLON = 35;
    TK_AND = 36; TK_OR = 37; TK_DOT = 38;
    ND_NUM = 0; ND_VAR = 1; ND_ADD = 2; ND_SUB = 3; ND_MUL = 4; ND_DIV = 5; ND_MOD = 6;
    ND_EQ = 7; ND_NE = 8; ND_LT = 9; ND_LE = 10; ND_GT = 11; ND_GE = 12;
    ND_ASSIGN = 13; ND_ADDR = 14; ND_DEREF = 15; ND_NOT = 16; ND_NEG = 17;
    ND_FUNCALL = 18; ND_RETURN = 19; ND_IF = 20; ND_WHILE = 21; ND_BLOCK = 22;
    ND_EXPR_STMT = 23; ND_LOGAND = 24; ND_LOGOR = 25; ND_MEMBER = 26;
    REG0 = "%rdi"; REG1 = "%rsi"; REG2 = "%rdx";
    REG3 = "%rcx"; REG4 = "%r8"; REG5 = "%r9";
    ty_int = malloc(sizeof(Type));
    ty_int.kind = TY_INT;
    ty_int.base = 0;
    ty_int.array_len = 0;
    ty_int.struct_def = 0;
    ty_int.size = 8;
    ty_string = malloc(sizeof(Type));
    ty_string.kind = TY_STRING;
    ty_string.base = 0;
    ty_string.array_len = 0;
    ty_string.struct_def = 0;
    ty_string.size = 8;
    return 0;
}

reg_name(i: int): string {
    if (i == 0) { return REG0; }
    if (i == 1) { return REG1; }
    if (i == 2) { return REG2; }
    if (i == 3) { return REG3; }
    if (i == 4) { return REG4; }
    return REG5;
}

read_file(path: int): int {
    fd: int = open(path, 0, 0);
    if (fd < 0) {
        error("cannot open file");
    }
    cap: int = 65536;
    buf: int = malloc(cap);
    n: int = 0;
    while (1) {
        if (n + 4096 > cap) {
            cap = cap * 2;
            tmp: int = malloc(cap);
            memcpy(tmp, buf, n);
            buf = tmp;
        }
        r: int = read(fd, buf + n, 4096);
        if (r <= 0) {
            storeb(buf + n, 0);
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    return buf;
}

newtype(kind: int): *Type {
    t: *Type = malloc(sizeof(Type));
    t.kind = kind;
    t.base = 0;
    t.array_len = 0;
    t.struct_def = 0;
    t.size = 0;
    return t;
}

ptr_to(base: *Type): *Type {
    t: *Type = newtype(TY_PTR);
    t.base = base;
    t.size = 8;
    return t;
}

array_of(base: *Type, len: int): *Type {
    t: *Type = newtype(TY_ARRAY);
    t.base = base;
    t.array_len = len;
    t.size = base.size * len;
    return t;
}

struct_type(sd: *StructDef): *Type {
    t: *Type = newtype(TY_STRUCT);
    t.struct_def = sd;
    t.size = sd.size;
    return t;
}

find_struct(name: int): *StructDef {
    s: *StructDef = struct_defs;
    while (s != 0) {
        if (streq(s.name, name)) {
            return s;
        }
        s = s.next;
    }
    return 0;
}

get_or_create_struct(name: int): *StructDef {
    sd: *StructDef = find_struct(name);
    if (sd != 0) {
        return sd;
    }
    sd = malloc(sizeof(StructDef));
    sd.name = name;
    sd.members = 0;
    sd.size = 0;
    sd.next = struct_defs;
    struct_defs = sd;
    return sd;
}

is_type_name(): int {
    if (equal(TK_IDENT) == 0) {
        return 0;
    }
    name: int = strdup_n(tok.str, tok.len);
    if (find_struct(name) != 0) {
        return 1;
    }
    return 0;
}

starts_type(): int {
    if (equal(TK_INT) || equal(TK_STRING) || is_type_name()) {
        return 1;
    }
    t: *Token = tok;
    while (t.kind == TK_STAR) {
        t = t.next;
    }
    if (t != tok) {
        if (t.kind == TK_INT || t.kind == TK_STRING) {
            return 1;
        }
        if (t.kind == TK_IDENT) {
            if (find_struct(strdup_n(t.str, t.len)) != 0) {
                return 1;
            }
        }
    }
    return 0;
}

find_member(sd: *StructDef, name: int): *Member {
    m: *Member = sd.members;
    while (m != 0) {
        if (streq(m.name, name)) {
            return m;
        }
        m = m.next;
    }
    return 0;
}

is_pointer(t: *Type): int {
    return t != 0 && t.kind == TY_PTR;
}

is_array(t: *Type): int {
    return t != 0 && t.kind == TY_ARRAY;
}

is_struct_ty(t: *Type): int {
    return t != 0 && t.kind == TY_STRUCT;
}

is_string_ty(t: *Type): int {
    return t != 0 && t.kind == TY_STRING;
}

decay(t: *Type): *Type {
    if (is_array(t)) {
        return ptr_to(t.base);
    }
    return t;
}

new_token(kind: int, start: int, len: int): *Token {
    t: *Token = malloc(sizeof(Token));
    t.kind = kind;
    t.str = start;
    t.len = len;
    t.val = 0;
    t.next = 0;
    return t;
}

ident_kind(s: int, n: int): int {
    if (n == 3 && streq_n(s, "int", 3)) { return TK_INT; }
    if (n == 2 && streq_n(s, "if", 2)) { return TK_IF; }
    if (n == 4 && streq_n(s, "else", 4)) { return TK_ELSE; }
    if (n == 5 && streq_n(s, "while", 5)) { return TK_WHILE; }
    if (n == 6 && streq_n(s, "return", 6)) { return TK_RETURN; }
    if (n == 6 && streq_n(s, "struct", 6)) { return TK_STRUCT; }
    if (n == 6 && streq_n(s, "sizeof", 6)) { return TK_SIZEOF; }
    if (n == 6 && streq_n(s, "string", 6)) { return TK_STRING; }
    if (n == 13 && streq_n(s, "uninitialized", 13)) { return TK_UNINITIALIZED; }
    return TK_IDENT;
}

skip_line_comment(): int {
    while (pos < source_len) {
        if (loadb(source + pos) == 10) {
            return 0;
        }
        pos = pos + 1;
    }
    return 0;
}

skip_block_comment(): int {
    while (pos < source_len) {
        if (loadb(source + pos) == 42 && loadb(source + pos + 1) == 47) {
            pos = pos + 2;
            return 0;
        }
        pos = pos + 1;
    }
    return 0;
}

read_number(): int {
    v: int = 0;
    while (pos < source_len) {
        if (is_digit(loadb(source + pos)) == 0) {
            return v;
        }
        v = v * 10 + (loadb(source + pos) - 48);
        pos = pos + 1;
    }
    return v;
}

esc_char(c: int): int {
    if (c == 110) { return 10; }
    if (c == 116) { return 9; }
    if (c == 48) { return 0; }
    if (c == 92) { return 92; }
    if (c == 39) { return 39; }
    if (c == 34) { return 34; }
    return c;
}

scan_string_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (loadb(source + pos) == 34) {
            return pos - start;
        }
        if (loadb(source + pos) == 92) {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    error("unterminated string");
    return 0;
}

scan_ident_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (is_ident2(loadb(source + pos)) == 0) {
            return pos - start;
        }
        pos = pos + 1;
    }
    return pos - start;
}

punct_kind(c: int): int {
    if (c == 43) { return TK_PLUS; }
    if (c == 45) { return TK_MINUS; }
    if (c == 42) { return TK_STAR; }
    if (c == 37) { return TK_PERCENT; }
    if (c == 38) { return TK_AMP; }
    if (c == 46) { return TK_DOT; }
    if (c == 58) { return TK_COLON; }
    if (c == 40) { return TK_LPAREN; }
    if (c == 41) { return TK_RPAREN; }
    if (c == 123) { return TK_LBRACE; }
    if (c == 125) { return TK_RBRACE; }
    if (c == 91) { return TK_LBRACK; }
    if (c == 93) { return TK_RBRACK; }
    if (c == 59) { return TK_SEMI; }
    if (c == 44) { return TK_COMMA; }
    if (c == 47) { return TK_SLASH; }
    return 0 - 1;
}

tokenize(): *Token {
    head: *Token = malloc(sizeof(Token));
    head.next = 0;
    cur: *Token = head;
    pos = 0;
    while (pos < source_len) {
        c: int = loadb(source + pos);
        if (is_space(c)) {
            pos = pos + 1;
        } else {
            if (c == 47 && loadb(source + pos + 1) == 47) {
                pos = pos + 2;
                skip_line_comment();
            } else {
                if (c == 47 && loadb(source + pos + 1) == 42) {
                    pos = pos + 2;
                    skip_block_comment();
                } else {
                    if (is_digit(c)) {
                        s: int = source + pos;
                        v: int = read_number();
                        t: *Token = new_token(TK_NUM, s, (source + pos) - s);
                        t.val = v;
                        cur.next = t;
                        cur = t;
                    } else {
                        if (c == 34) {
                            pos = pos + 1;
                            s = source + pos;
                            n: int = scan_string_len();
                            t = new_token(TK_STR, s, n);
                            cur.next = t;
                            cur = t;
                            pos = pos + 1;
                        } else {
                            if (c == 39) {
                                pos = pos + 1;
                                if (loadb(source + pos) == 92) {
                                    pos = pos + 1;
                                    v = esc_char(loadb(source + pos));
                                    pos = pos + 1;
                                } else {
                                    v = loadb(source + pos);
                                    pos = pos + 1;
                                }
                                if (loadb(source + pos) == 39) {
                                    pos = pos + 1;
                                }
                                t = new_token(TK_NUM, source + pos, 0);
                                t.val = v;
                                cur.next = t;
                                cur = t;
                            } else {
                                if (is_ident1(c)) {
                                    s = source + pos;
                                    n = scan_ident_len();
                                    t = new_token(ident_kind(s, n), s, n);
                                    cur.next = t;
                                    cur = t;
                                } else {
                                    if (c == 61 && loadb(source + pos + 1) == 61) {
                                        t = new_token(TK_EQ, source + pos, 2);
                                        cur.next = t; cur = t; pos = pos + 2;
                                    } else {
                                        if (c == 33 && loadb(source + pos + 1) == 61) {
                                            t = new_token(TK_NE, source + pos, 2);
                                            cur.next = t; cur = t; pos = pos + 2;
                                        } else {
                                            if (c == 60 && loadb(source + pos + 1) == 61) {
                                                t = new_token(TK_LE, source + pos, 2);
                                                cur.next = t; cur = t; pos = pos + 2;
                                            } else {
                                                if (c == 62 && loadb(source + pos + 1) == 61) {
                                                    t = new_token(TK_GE, source + pos, 2);
                                                    cur.next = t; cur = t; pos = pos + 2;
                                                } else {
                                                    if (c == 38 && loadb(source + pos + 1) == 38) {
                                                        t = new_token(TK_AND, source + pos, 2);
                                                        cur.next = t; cur = t; pos = pos + 2;
                                                    } else {
                                                        if (c == 124 && loadb(source + pos + 1) == 124) {
                                                            t = new_token(TK_OR, source + pos, 2);
                                                            cur.next = t; cur = t; pos = pos + 2;
                                                        } else {
                                                                if (c == 61) {
                                                                    t = new_token(TK_ASSIGN, source + pos, 1);
                                                                    cur.next = t; cur = t; pos = pos + 1;
                                                                } else {
                                                                    if (c == 33) {
                                                                        t = new_token(TK_NOT, source + pos, 1);
                                                                        cur.next = t; cur = t; pos = pos + 1;
                                                                    } else {
                                                                        if (c == 60) {
                                                                            t = new_token(TK_LT, source + pos, 1);
                                                                            cur.next = t; cur = t; pos = pos + 1;
                                                                        } else {
                                                                            if (c == 62) {
                                                                                t = new_token(TK_GT, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            } else {
                                                                                pk: int = punct_kind(c);
                                                                                if (pk < 0) {
                                                                                    error("unexpected character");
                                                                                }
                                                                                t = new_token(pk, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    t = new_token(TK_EOF, source + pos, 0);
    cur.next = t;
    return head.next;
}

equal(kind: int): int {
    return tok.kind == kind;
}

skip(kind: int): int {
    if (equal(kind) == 0) {
        error("unexpected token");
    }
    tok = tok.next;
    return 0;
}

cur_tokstr(): int {
    return strdup_n(tok.str, tok.len);
}

add_string(s: int, n: int): int {
    buf: int = malloc(n + 1);
    i: int = 0;
    j: int = 0;
    while (i < n) {
        if (loadb(s + i) == 92 && i + 1 < n) {
            i = i + 1;
            storeb(buf + j, esc_char(loadb(s + i)));
            j = j + 1;
        } else {
            storeb(buf + j, loadb(s + i));
            j = j + 1;
        }
        i = i + 1;
    }
    storeb(buf + j, 0);
    lit: *StrLit = malloc(sizeof(StrLit));
    lit.data = buf;
    lit.len = j;
    lit.label = str_count;
    str_count = str_count + 1;
    lit.next = str_lits;
    str_lits = lit;
    return lit.label;
}

new_node(kind: int): *Node {
    n: *Node = malloc(sizeof(Node));
    n.kind = kind;
    n.next = 0;
    n.lhs = 0;
    n.rhs = 0;
    n.cond = 0;
    n.then = 0;
    n.els = 0;
    n.body = 0;
    n.val = 0;
    n.var = 0;
    n.funcname = 0;
    n.args = 0;
    n.str_label = 0;
    n.ty = 0;
    n.member = 0;
    return n;
}

new_binary(kind: int, lhs: *Node, rhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    n.rhs = rhs;
    return n;
}

new_unary(kind: int, lhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    return n;
}

new_num(v: int): *Node {
    n: *Node = new_node(ND_NUM);
    n.val = v;
    n.ty = ty_int;
    return n;
}

find_obj(list: *Obj, name: int): *Obj {
    o: *Obj = list;
    while (o != 0) {
        if (streq(o.name, name)) {
            return o;
        }
        o = o.next;
    }
    return 0;
}

find_var(name: int): *Obj {
    o: *Obj = find_obj(locals, name);
    if (o != 0) {
        return o;
    }
    return find_obj(globals, name);
}

new_obj(name: int, is_local: int): *Obj {
    o: *Obj = malloc(sizeof(Obj));
    o.name = name;
    o.is_local = is_local;
    o.is_func = 0;
    o.offset = 0;
    o.ty = 0;
    if (is_local) {
        o.next = locals;
        locals = o;
    } else {
        o.next = globals;
        globals = o;
    }
    return o;
}

decl_spec(): *Type {
    if (equal(TK_INT)) {
        tok = tok.next;
        return ty_int;
    }
    if (equal(TK_STRING)) {
        tok = tok.next;
        return ty_string;
    }
    if (equal(TK_IDENT)) {
        name: int = cur_tokstr();
        tok = tok.next;
        sd: *StructDef = get_or_create_struct(name);
        return struct_type(sd);
    }
    error("expected type");
    return 0;
}

parse_type(): *Type {
    if (equal(TK_STAR)) {
        tok = tok.next;
        base: *Type = parse_type();
        return ptr_to(base);
    }
    return decl_spec();
}

parse_expr(): *Node {
    return parse_assign();
}

parse_primary(): *Node {
    if (equal(TK_SIZEOF)) {
        tok = tok.next;
        skip(TK_LPAREN);
        if (starts_type()) {
            ty: *Type = parse_type();
            ty = parse_type_suffix(ty);
            skip(TK_RPAREN);
            return new_num(ty.size);
        }
        n: *Node = parse_expr();
        skip(TK_RPAREN);
        add_type(n);
        return new_num(n.ty.size);
    }
    if (equal(TK_LPAREN)) {
        tok = tok.next;
        n = parse_expr();
        skip(TK_RPAREN);
        return n;
    }
    if (equal(TK_NUM)) {
        n = new_num(tok.val);
        tok = tok.next;
        return n;
    }
    if (equal(TK_STR)) {
        label: int = add_string(tok.str, tok.len);
        tok = tok.next;
        n = new_node(ND_NUM);
        n.str_label = label + 1;
        n.ty = ty_string;
        return n;
    }
    if (equal(TK_IDENT)) {
        name: int = cur_tokstr();
        tok = tok.next;
        if (equal(TK_LPAREN)) {
            n = new_node(ND_FUNCALL);
            n.funcname = name;
            n.ty = ty_int;
            tok = tok.next;
            head: *Node = 0;
            cur: *Node = 0;
            while (equal(TK_RPAREN) == 0) {
                if (cur != 0) {
                    skip(TK_COMMA);
                }
                arg: *Node = parse_expr();
                if (cur == 0) {
                    head = arg;
                    cur = arg;
                } else {
                    cur.next = arg;
                    cur = arg;
                }
            }
            n.args = head;
            skip(TK_RPAREN);
            return n;
        }
        var: *Obj = find_var(name);
        if (var == 0) {
            error("undefined variable");
        }
        n = new_node(ND_VAR);
        n.var = var;
        n.ty = var.ty;
        return n;
    }
    error("expected expression");
    return 0;
}

parse_postfix(): *Node {
    n: *Node = parse_primary();
    while (1) {
        if (equal(TK_LBRACK)) {
            tok = tok.next;
            idx: *Node = parse_expr();
            skip(TK_RBRACK);
            add_type(n);
            t: *Type = decay(n.ty);
            if (is_pointer(t) == 0) {
                error("subscript of non-pointer");
            }
            scaled: *Node = new_binary(ND_MUL, idx, new_num(t.base.size));
            n = new_unary(ND_DEREF, new_binary(ND_ADD, n, scaled));
            n.ty = t.base;
        } else {
            if (equal(TK_DOT)) {
                if (tok.next.kind == TK_STAR) {
                    tok = tok.next;
                    tok = tok.next;
                    n = new_unary(ND_DEREF, n);
                } else {
                    tok = tok.next;
                    if (equal(TK_IDENT) == 0) {
                        error("expected member name");
                    }
                    name: int = cur_tokstr();
                    tok = tok.next;
                    add_type(n);
                    t: *Type = decay(n.ty);
                    sty: *Type = n.ty;
                    if (is_pointer(t) && is_struct_ty(t.base)) {
                        sty = t.base;
                    } else {
                        if (is_struct_ty(n.ty) == 0) {
                            error("member access on non-struct");
                        }
                    }
                    m: *Member = find_member(sty.struct_def, name);
                    if (m == 0) {
                        error("unknown member");
                    }
                    mem: *Node = new_node(ND_MEMBER);
                    mem.lhs = n;
                    mem.member = m;
                    if (m.ty != 0) {
                        mem.ty = m.ty;
                    } else {
                        mem.ty = ty_int;
                    }
                    n = mem;
                }
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_unary(): *Node {
    if (equal(TK_PLUS)) {
        tok = tok.next;
        return parse_unary();
    }
    if (equal(TK_MINUS)) {
        tok = tok.next;
        n: *Node = new_unary(ND_NEG, parse_unary());
        n.ty = ty_int;
        return n;
    }
    if (equal(TK_AMP)) {
        tok = tok.next;
        return new_unary(ND_ADDR, parse_unary());
    }
    if (equal(TK_NOT)) {
        tok = tok.next;
        n = new_unary(ND_NOT, parse_unary());
        n.ty = ty_int;
        return n;
    }
    return parse_postfix();
}

add_type(n: *Node): int {
    if (n == 0 || n.ty != 0) {
        return 0;
    }
    add_type(n.lhs);
    add_type(n.rhs);
    add_type(n.cond);
    add_type(n.then);
    add_type(n.els);
    a: *Node = n.args;
    while (a != 0) {
        add_type(a);
        a = a.next;
    }
    if (n.kind == ND_BLOCK) {
        a = n.body;
        while (a != 0) {
            add_type(a);
            a = a.next;
        }
    }
    if (n.kind == ND_NUM || n.kind == ND_ADD || n.kind == ND_SUB || n.kind == ND_MUL || n.kind == ND_DIV || n.kind == ND_MOD || n.kind == ND_EQ || n.kind == ND_NE || n.kind == ND_LT || n.kind == ND_LE || n.kind == ND_GT || n.kind == ND_GE || n.kind == ND_LOGAND || n.kind == ND_LOGOR || n.kind == ND_NOT || n.kind == ND_NEG || n.kind == ND_ASSIGN || n.kind == ND_FUNCALL) {
        n.ty = ty_int;
        return 0;
    }
    if (n.kind == ND_VAR) {
        n.ty = n.var.ty;
        return 0;
    }
    if (n.kind == ND_ADDR) {
        add_type(n.lhs);
        if (is_array(n.lhs.ty)) {
            n.ty = ptr_to(n.lhs.ty.base);
        } else {
            n.ty = ptr_to(n.lhs.ty);
        }
        return 0;
    }
    if (n.kind == ND_DEREF) {
        add_type(n.lhs);
        t: *Type = decay(n.lhs.ty);
        if (is_pointer(t)) {
            n.ty = t.base;
        } else {
            if (t != 0 && t.kind == TY_INT) {
                n.ty = ty_int;
            } else {
                if (is_string_ty(t)) {
                    n.ty = ty_int;
                } else {
                    error("dereferencing non-pointer");
                }
            }
        }
        return 0;
    }
    if (n.kind == ND_MEMBER) {
        if (n.member.ty != 0) {
            n.ty = n.member.ty;
        } else {
            n.ty = ty_int;
        }
        return 0;
    }
    return 0;
}

parse_mul(): *Node {
    n: *Node = parse_unary();
    while (1) {
        if (equal(TK_STAR)) {
            tok = tok.next;
            n = new_binary(ND_MUL, n, parse_unary());
        } else {
            if (equal(TK_SLASH)) {
                tok = tok.next;
                n = new_binary(ND_DIV, n, parse_unary());
            } else {
                if (equal(TK_PERCENT)) {
                    tok = tok.next;
                    n = new_binary(ND_MOD, n, parse_unary());
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

parse_add(): *Node {
    n: *Node = parse_mul();
    while (1) {
        if (equal(TK_PLUS)) {
            tok = tok.next;
            n = new_binary(ND_ADD, n, parse_mul());
        } else {
            if (equal(TK_MINUS)) {
                tok = tok.next;
                n = new_binary(ND_SUB, n, parse_mul());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_relational(): *Node {
    n: *Node = parse_add();
    while (1) {
        if (equal(TK_LT)) {
            tok = tok.next;
            n = new_binary(ND_LT, n, parse_add());
        } else {
            if (equal(TK_GT)) {
                tok = tok.next;
                n = new_binary(ND_GT, n, parse_add());
            } else {
                if (equal(TK_LE)) {
                    tok = tok.next;
                    n = new_binary(ND_LE, n, parse_add());
                } else {
                    if (equal(TK_GE)) {
                        tok = tok.next;
                        n = new_binary(ND_GE, n, parse_add());
                    } else {
                        return n;
                    }
                }
            }
        }
    }
    return n;
}

parse_equality(): *Node {
    n: *Node = parse_relational();
    while (1) {
        if (equal(TK_EQ)) {
            tok = tok.next;
            n = new_binary(ND_EQ, n, parse_relational());
        } else {
            if (equal(TK_NE)) {
                tok = tok.next;
                n = new_binary(ND_NE, n, parse_relational());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_logand(): *Node {
    n: *Node = parse_equality();
    while (equal(TK_AND)) {
        tok = tok.next;
        n = new_binary(ND_LOGAND, n, parse_equality());
    }
    return n;
}

parse_logor(): *Node {
    n: *Node = parse_logand();
    while (equal(TK_OR)) {
        tok = tok.next;
        n = new_binary(ND_LOGOR, n, parse_logand());
    }
    return n;
}

parse_assign(): *Node {
    n: *Node = parse_logor();
    if (equal(TK_ASSIGN)) {
        tok = tok.next;
        return new_binary(ND_ASSIGN, n, parse_assign());
    }
    return n;
}

parse_type_suffix(ty: *Type): *Type {
    if (equal(TK_LBRACK)) {
        tok = tok.next;
        if (equal(TK_NUM) == 0) {
            error("expected array size");
        }
        ty = array_of(ty, tok.val);
        tok = tok.next;
        skip(TK_RBRACK);
    }
    return ty;
}

parse_decl(is_local: int): *Obj {
    if (equal(TK_IDENT) == 0) {
        error("expected identifier");
    }
    name: int = cur_tokstr();
    tok = tok.next;
    skip(TK_COLON);
    ty: *Type = parse_type();
    ty = parse_type_suffix(ty);
    o: *Obj = new_obj(name, is_local);
    o.ty = ty;
    return o;
}

parse_compound(): *Node {
    n: *Node = new_node(ND_BLOCK);
    skip(TK_LBRACE);
    head: *Node = 0;
    cur: *Node = 0;
    while (equal(TK_RBRACE) == 0) {
        if (equal(TK_EOF)) {
            error("unterminated block");
        }
        s: *Node = parse_stmt();
        if (cur == 0) {
            head = s;
            cur = s;
        } else {
            cur.next = s;
            cur = s;
        }
    }
    n.body = head;
    skip(TK_RBRACE);
    return n;
}

parse_stmt(): *Node {
    if (equal(TK_RETURN)) {
        n: *Node = new_node(ND_RETURN);
        tok = tok.next;
        if (equal(TK_SEMI) == 0) {
            n.lhs = parse_expr();
        }
        skip(TK_SEMI);
        return n;
    }
    if (equal(TK_IF)) {
        n = new_node(ND_IF);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.then = parse_stmt();
        if (equal(TK_ELSE)) {
            tok = tok.next;
            n.els = parse_stmt();
        }
        return n;
    }
    if (equal(TK_WHILE)) {
        n = new_node(ND_WHILE);
        tok = tok.next;
        skip(TK_LPAREN);
        n.cond = parse_expr();
        skip(TK_RPAREN);
        n.body = parse_stmt();
        return n;
    }
    if (equal(TK_LBRACE)) {
        return parse_compound();
    }
    if (equal(TK_IDENT) && tok.next.kind == TK_COLON) {
        o: *Obj = parse_decl(1);
        if (equal(TK_COMMA)) {
            error("only one variable per declaration");
        }
        skip(TK_ASSIGN);
        if (equal(TK_UNINITIALIZED)) {
            tok = tok.next;
            skip(TK_SEMI);
            return new_node(ND_BLOCK);
        }
        rhs: *Node = parse_expr();
        skip(TK_SEMI);
        lhs: *Node = new_node(ND_VAR);
        lhs.var = o;
        lhs.ty = o.ty;
        as: *Node = new_binary(ND_ASSIGN, lhs, rhs);
        es: *Node = new_node(ND_EXPR_STMT);
        es.lhs = as;
        return es;
    }
    n = new_node(ND_EXPR_STMT);
    n.lhs = parse_expr();
    skip(TK_SEMI);
    return n;
}

fn_param(fn: *Function, i: int): *Obj {
    if (i == 0) { return fn.p0; }
    if (i == 1) { return fn.p1; }
    if (i == 2) { return fn.p2; }
    if (i == 3) { return fn.p3; }
    if (i == 4) { return fn.p4; }
    return fn.p5;
}

set_fn_param(fn: *Function, i: int, p: *Obj): int {
    if (i == 0) { fn.p0 = p; }
    if (i == 1) { fn.p1 = p; }
    if (i == 2) { fn.p2 = p; }
    if (i == 3) { fn.p3 = p; }
    if (i == 4) { fn.p4 = p; }
    if (i == 5) { fn.p5 = p; }
    return 0;
}

parse_function(name: int): *Function {
    fn: *Function = malloc(sizeof(Function));
    locals = 0;
    fn.name = name;
    fn.next = 0;
    fn.nparams = 0;
    fn.p0 = 0; fn.p1 = 0; fn.p2 = 0;
    fn.p3 = 0; fn.p4 = 0; fn.p5 = 0;
    skip(TK_LPAREN);
    np: int = 0;
    while (equal(TK_RPAREN) == 0) {
        if (np != 0) {
            skip(TK_COMMA);
        }
        if (np >= 6) {
            error("too many parameters");
        }
        p: *Obj = parse_decl(1);
        set_fn_param(fn, np, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TK_RPAREN);
    skip(TK_COLON);
    parse_type();
    fn.body = parse_compound();
    fn.locals = locals;
    return fn;
}

parse_struct_def(): int {
    tok = tok.next;
    if (equal(TK_IDENT) == 0) {
        error("expected tag");
    }
    name: int = cur_tokstr();
    tok = tok.next;
    sd: *StructDef = get_or_create_struct(name);
    if (sd.members != 0) {
        error("redefinition of struct");
    }
    skip(TK_LBRACE);
    head: *Member = 0;
    cur: *Member = 0;
    offset: int = 0;
    while (equal(TK_RBRACE) == 0) {
        if (equal(TK_IDENT) == 0) {
            error("expected member name");
        }
        m: *Member = malloc(sizeof(Member));
        m.name = cur_tokstr();
        tok = tok.next;
        skip(TK_COLON);
        mty: *Type = parse_type();
        mty = parse_type_suffix(mty);
        m.offset = offset;
        m.ty = mty;
        m.next = 0;
        offset = offset + 8;
        if (cur == 0) {
            head = m;
            cur = m;
        } else {
            cur.next = m;
            cur = m;
        }
        skip(TK_SEMI);
    }
    sd.members = head;
    sd.size = offset;
    skip(TK_RBRACE);
    skip(TK_SEMI);
    return 0;
}

parse_program(): int {
    tail: *Function = 0;
    functions = 0;
    while (equal(TK_EOF) == 0) {
        if (equal(TK_STRUCT) && tok.next.kind == TK_IDENT && tok.next.next.kind == TK_LBRACE) {
            parse_struct_def();
        } else {
            if (equal(TK_IDENT) == 0) {
                error("expected identifier");
            }
            name: int = cur_tokstr();
            tok = tok.next;
            if (equal(TK_LPAREN)) {
                fn: *Function = parse_function(name);
                if (tail == 0) {
                    functions = fn;
                    tail = fn;
                } else {
                    tail.next = fn;
                    tail = fn;
                }
                o: *Obj = new_obj(name, 0);
                o.is_func = 1;
                o.ty = ty_int;
            } else {
                skip(TK_COLON);
                ty: *Type = parse_type();
                ty = parse_type_suffix(ty);
                if (equal(TK_COMMA)) {
                    error("only one variable per declaration");
                }
                o = new_obj(name, 0);
                o.ty = ty;
                skip(TK_SEMI);
            }
        }
    }
    return 0;
}

new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    return l;
}

gen_addr(n: *Node): int {
    add_type(n);
    if (n.kind == ND_VAR) {
        if (n.var.is_local) {
            emit("  lea ");
            emit_num(n.var.offset);
            emit("(%rbp), %rax\n");
        } else {
            emit("  lea ");
            emit(n.var.name);
            emit("(%rip), %rax\n");
        }
        return 0;
    }
    if (n.kind == ND_DEREF) {
        gen_expr(n.lhs);
        return 0;
    }
    if (n.kind == ND_MEMBER) {
        add_type(n.lhs);
        t: *Type = decay(n.lhs.ty);
        if (is_pointer(t) && is_struct_ty(t.base)) {
            gen_expr(n.lhs);
        } else {
            gen_addr(n.lhs);
        }
        if (n.member.offset != 0) {
            emit("  add $");
            emit_num(n.member.offset);
            emit(", %rax\n");
        }
        return 0;
    }
    error("not an lvalue");
    return 0;
}

gen_expr(n: *Node): int {
    k: int = n.kind;
    add_type(n);
    if (k == ND_NUM) {
        if (n.str_label != 0) {
            emit("  lea .L.str");
            emit_num(n.str_label - 1);
            emit("+8(%rip), %rax\n");
        } else {
            emit("  mov $");
            emit_num(n.val);
            emit(", %rax\n");
        }
        return 0;
    }
    if (k == ND_VAR) {
        gen_addr(n);
        if (is_array(n.ty) || is_struct_ty(n.ty)) {
            return 0;
        }
        emit("  mov (%rax), %rax\n");
        return 0;
    }
    if (k == ND_MEMBER) {
        gen_addr(n);
        emit("  mov (%rax), %rax\n");
        return 0;
    }
    if (k == ND_ADDR) {
        gen_addr(n.lhs);
        return 0;
    }
    if (k == ND_DEREF) {
        gen_expr(n.lhs);
        emit("  mov (%rax), %rax\n");
        return 0;
    }
    if (k == ND_ASSIGN) {
        gen_addr(n.lhs);
        emit("  push %rax\n");
        gen_expr(n.rhs);
        emit("  pop %rdi\n");
        emit("  mov %rax, (%rdi)\n");
        return 0;
    }
    if (k == ND_NOT) {
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  sete %al\n");
        emit("  movzb %al, %rax\n");
        return 0;
    }
    if (k == ND_NEG) {
        gen_expr(n.lhs);
        emit("  neg %rax\n");
        return 0;
    }
    if (k == ND_LOGAND) {
        l: int = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    if (k == ND_LOGOR) {
        l = new_label();
        gen_expr(n.lhs);
        emit("  cmp $0, %rax\n");
        emit("  jne .L.true"); emit_num(l); emit("\n");
        gen_expr(n.rhs);
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit(".L.true"); emit_num(l); emit(":\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    if (k == ND_FUNCALL) {
        nargs: int = 0;
        a: *Node = n.args;
        while (a != 0) {
            nargs = nargs + 1;
            a = a.next;
        }
        if (nargs > 6) {
            error("too many arguments");
        }
        a = n.args;
        while (a != 0) {
            gen_expr(a);
            emit("  push %rax\n");
            a = a.next;
        }
        i: int = nargs - 1;
        while (i >= 0) {
            emit("  pop ");
            emit(reg_name(i));
            emit("\n");
            i = i - 1;
        }
        emit("  sub $8, %rsp\n");
        emit("  call ");
        emit(n.funcname);
        emit("\n");
        emit("  add $8, %rsp\n");
        return 0;
    }

    gen_expr(n.lhs);
    emit("  push %rax\n");
    gen_expr(n.rhs);
    emit("  mov %rax, %rdi\n");
    emit("  pop %rax\n");

    if (k == ND_ADD) { emit("  add %rdi, %rax\n"); return 0; }
    if (k == ND_SUB) { emit("  sub %rdi, %rax\n"); return 0; }
    if (k == ND_MUL) { emit("  imul %rdi, %rax\n"); return 0; }
    if (k == ND_DIV) { emit("  cqo\n"); emit("  idiv %rdi\n"); return 0; }
    if (k == ND_MOD) {
        emit("  cqo\n"); emit("  idiv %rdi\n"); emit("  mov %rdx, %rax\n"); return 0;
    }
    if (k == ND_EQ) {
        emit("  cmp %rdi, %rax\n"); emit("  sete %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_NE) {
        emit("  cmp %rdi, %rax\n"); emit("  setne %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_LT) {
        emit("  cmp %rdi, %rax\n"); emit("  setl %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_LE) {
        emit("  cmp %rdi, %rax\n"); emit("  setle %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_GT) {
        emit("  cmp %rdi, %rax\n"); emit("  setg %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    if (k == ND_GE) {
        emit("  cmp %rdi, %rax\n"); emit("  setge %al\n"); emit("  movzb %al, %rax\n"); return 0;
    }
    error("invalid expression");
    return 0;
}

gen_stmt(n: *Node): int {
    k: int = n.kind;
    if (k == ND_RETURN) {
        if (n.lhs != 0) {
            gen_expr(n.lhs);
        } else {
            emit("  mov $0, %rax\n");
        }
        emit("  jmp .L.return.");
        emit(current_fn_name);
        emit("\n");
        return 0;
    }
    if (k == ND_EXPR_STMT) {
        gen_expr(n.lhs);
        return 0;
    }
    if (k == ND_BLOCK) {
        s: *Node = n.body;
        while (s != 0) {
            gen_stmt(s);
            s = s.next;
        }
        return 0;
    }
    if (k == ND_IF) {
        l: int = new_label();
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.else"); emit_num(l); emit("\n");
        gen_stmt(n.then);
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.else"); emit_num(l); emit(":\n");
        if (n.els != 0) {
            gen_stmt(n.els);
        }
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    if (k == ND_WHILE) {
        l = new_label();
        emit(".L.begin"); emit_num(l); emit(":\n");
        gen_expr(n.cond);
        emit("  cmp $0, %rax\n");
        emit("  je .L.end"); emit_num(l); emit("\n");
        gen_stmt(n.body);
        emit("  jmp .L.begin"); emit_num(l); emit("\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return 0;
    }
    error("invalid statement");
    return 0;
}

assign_lvar_offsets(fn: *Function): int {
    off: int = 0;
    v: *Obj = fn.locals;
    while (v != 0) {
        sz: int = v.ty.size;
        if (sz <= 0) {
            sz = 8;
        }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 15) / 16 * 16;
    return 0;
}

emit_data(): int {
    g: *Obj = globals;
    emit(".section .bss\n");
    emit(".align 8\n");
    while (g != 0) {
        if (g.is_func == 0) {
            sz: int = 8;
            if (g.ty != 0) {
                sz = g.ty.size;
            }
            if (sz <= 0) {
                sz = 8;
            }
            emit(g.name);
            emit(": .skip ");
            emit_num(sz);
            emit("\n");
        }
        g = g.next;
    }
    emit(".section .rodata\n");
    emit(".align 8\n");
    i: int = 0;
    while (i < str_count) {
        s: *StrLit = str_lits;
        while (s != 0 && s.label != i) {
            s = s.next;
        }
        if (s != 0) {
            emit(".L.str");
            emit_num(i);
            emit(":\n");
            emit("  .quad ");
            emit_num(s.len);
            emit("\n");
            emit("  .byte ");
            j: int = 0;
            while (j < s.len) {
                if (j != 0) {
                    emit(",");
                }
                emit_num(loadb(s.data + j));
                j = j + 1;
            }
            if (s.len == 0) {
                emit("0");
            } else {
                emit(",0");
            }
            emit("\n");
        }
        i = i + 1;
    }
    return 0;
}

emit_text(): int {
    fn: *Function = functions;
    emit(".section .text\n");
    while (fn != 0) {
        assign_lvar_offsets(fn);
        current_fn_name = fn.name;
        emit(".globl ");
        emit(fn.name);
        emit("\n");
        emit(fn.name);
        emit(":\n");
        emit("  push %rbp\n");
        emit("  mov %rsp, %rbp\n");
        emit("  sub $");
        emit_num(fn.stack_size);
        emit(", %rsp\n");
        i: int = 0;
        while (i < fn.nparams) {
            p: *Obj = fn_param(fn, i);
            emit("  mov ");
            emit(reg_name(i));
            emit(", ");
            emit_num(p.offset);
            emit("(%rbp)\n");
            i = i + 1;
        }
        gen_stmt(fn.body);
        emit(".L.return.");
        emit(fn.name);
        emit(":\n");
        emit("  mov %rbp, %rsp\n");
        emit("  pop %rbp\n");
        emit("  ret\n");
        fn = fn.next;
    }
    return 0;
}

codegen(): int {
    emit_data();
    emit_text();
    return 0;
}

main(argc: int, argv: *int): int {
    if (argc != 2) {
        error("usage: l8c <file.l8>");
    }
    path: int = (argv + 8).*;
    init_kinds();
    source = read_file(path);
    tok = tokenize();
    parse_program();
    codegen();
    return 0;
}
