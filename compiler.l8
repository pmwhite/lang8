// L8 self-hosted compiler → x86-64 Linux GAS
// Uses nominal types for AST; Type is a sum over language types.
//
// Heap ADTs: `new T { fields }`, `new E.V`, `new E.V { fields }`,
//   `new T uninitialized`, or `new T[n]` (heap array → *T).
// Prefer `new E.V { ... }` over allocate-then-assign.
// Aggregates are passed/returned by value via a hidden pointer (sret) ABI.
// Forward `*Name` may later complete as a record or a sum.
// Match arms may end with `_ -> { ... }`. Field lists accept `;` or `,`.
// Sum defs allow a leading `|` before the first variant.
// Null pointers use the `null` literal (only for `?*T`, not integer 0).
// `*T` is non-null; `?*T` is optional. `*T` coerces to `?*T`.
// Flow narrowing (locals only): `if (p != null)` / `while (p != null)` / AND-conjuncts
//   (RHS of `&&` / `||` included); `if (p == null)` else; OR-of-`== null` else.
// No `?*T as *T` — bind a local and narrow, or use expect_*.
// Bindings (locals, match arms) are block-scoped.
// `as`: numeric widen (i8/bool→int, i8↔bool), or `*A as *B`; not `?*T as *T` (narrow a local instead).
// `new T[n]` allocates n·sizeof(T) bytes and yields *T.

type Type =
    | Int
    | I8
    | Bool
    | Ptr { base: *Type; }
    | OptPtr { base: *Type; }
    | Array { base: *Type; len: int; }
    | Record { def: *StructDef; }
    | Enum { def: *EnumDef; };

type Member = {
    name: *i8;
    offset: int;
    ty: ?*Type;
    next: ?*Member;
};

type StructDef = {
    name: *i8;
    members: ?*Member;
    size: int;
    ty: ?*Type;
    next: ?*StructDef;
};

type Variant = {
    name: *i8;
    tag: int;
    fields: ?*Member;
    payload_ty: ?*Type;
    payload_size: int;
    next: ?*Variant;
};

type EnumDef = {
    name: *i8;
    variants: ?*Variant;
    size: int;
    ty: ?*Type;
    next: ?*EnumDef;
};

type TokKind =
    | Eof
    | Num
    | Char
    | Str
    | Ident
    | Int
    | I8
    | Bool
    | True
    | False
    | Null
    | If
    | Else
    | While
    | Return
    | TypeKw
    | Sizeof
    | Uninitialized
    | As
    | Trunc
    | New
    | Eq
    | Ne
    | Le
    | Ge
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Lt
    | Gt
    | Assign
    | Not
    | Amp
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBrack
    | RBrack
    | Semi
    | Comma
    | Colon
    | And
    | Or
    | Dot
    | Match
    | Pipe
    | Arrow
    | Question;

type Token = {
    kind: TokKind;
    val: int;
    str: *i8;
    len: int;
    next: *Token;
};

type Node = {
    kind: int;
    next: ?*Node;
    lhs: ?*Node;
    rhs: ?*Node;
    cond: ?*Node;
    then: ?*Node;
    els: ?*Node;
    body: ?*Node;
    val: int;
    var: ?*Obj;
    funcname: ?*i8;
    args: ?*Node;
    str_label: int;
    ty: ?*Type;
    member: ?*Member;
    variant: ?*Variant;
};

type Obj = {
    name: *i8;
    is_local: int;
    is_func: int;
    offset: int;
    scope_depth: int;
    ty: ?*Type;
    next: ?*Obj;
};

type Function = {
    name: *i8;
    nparams: int;
    p0: ?*Obj;
    p1: ?*Obj;
    p2: ?*Obj;
    p3: ?*Obj;
    p4: ?*Obj;
    p5: ?*Obj;
    locals: ?*Obj;
    body: ?*Node;
    stack_size: int;
    return_ty: ?*Type;
    sret: ?*Obj;
    next: ?*Function;
};

type StrLit = {
    data: *i8;
    len: int;
    label: int;
    next: ?*StrLit;
};

// node kinds
ND_NUM: int; ND_VAR: int; ND_ADD: int; ND_SUB: int; ND_MUL: int; ND_DIV: int; ND_MOD: int;
ND_EQ: int; ND_NE: int; ND_LT: int; ND_LE: int; ND_GT: int; ND_GE: int;
ND_ASSIGN: int; ND_ADDR: int; ND_DEREF: int; ND_NOT: int; ND_NEG: int;
ND_FUNCALL: int; ND_RETURN: int; ND_IF: int; ND_WHILE: int; ND_BLOCK: int; ND_EXPR_STMT: int;
ND_LOGAND: int; ND_LOGOR: int; ND_MEMBER: int; ND_AS: int; ND_TRUNC: int; ND_NEW: int; ND_STRUCT_LIT: int;
ND_VARIANT_LIT: int; ND_MATCH: int; ND_MATCH_ARM: int; ND_NULL: int;

source: *i8; source_len: int; pos: int;
tok: *Token;
globals: ?*Obj;
locals: ?*Obj;
scope_depth: int;
functions: ?*Function;
struct_defs: ?*StructDef;
enum_defs: ?*EnumDef;
field_list_size: int;
ty_int: *Type;
ty_i8: *Type;
ty_bool: *Type;
str_lits: ?*StrLit;
str_count: int;
label_id: int;
current_fn_name: ?*i8;
current_return_ty: ?*Type;
current_sret: ?*Obj;
type NarrowFrame = {
    var: ?*Obj;
    ty: ?*Type;
    next: ?*NarrowFrame;
};

narrow_top: ?*NarrowFrame;
REG0: *i8; REG1: *i8; REG2: *i8; REG3: *i8; REG4: *i8; REG5: *i8;


strlen(s: *i8): int {
    return len(s);
}

streq_n(a: *i8, b: *i8, n: int): bool {
    i: int = 0;
    while (i < n) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

streq(a: *i8, b: *i8): bool {
    i: int = 0;
    while (true) {
        if (a[i] != b[i]) {
            return false;
        }
        if (a[i] == 0 trunc i8) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

memcpy(dst: *i8, src: *i8, n: int): *i8 {
    i: int = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return dst;
}

strdup_n(s: *i8, n: int): *i8 {
    raw: *i8 = new i8[n + 16];
    p: *int = raw as *int;
    p.* = n;
    data: *i8 = raw + 8;
    memcpy(data, s, n);
    data[n] = 0 trunc i8;
    return data;
}

is_space(c: i8): bool {
    return c == ' ' || c == '\n' || c == '\r' || c == '\t';
}

is_digit(c: i8): bool {
    return c >= '0' && c <= '9';
}

is_ident1(c: i8): bool {
    if (c >= 'a' && c <= 'z') { return true; }
    if (c >= 'A' && c <= 'Z') { return true; }
    return c == '_';
}

is_ident2(c: i8): bool {
    return is_ident1(c) || is_digit(c);
}

emit(s: *i8) {
    write(1, s, len(s));
}

emit_ch(c: i8) {
    write(1, &c, 1);
}

emit_num(n: int) {
    buf: i8[32] = uninitialized;
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch('0');
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = (('0' as int) + (n % 10)) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    if (neg != 0) {
        emit_ch('-');
    }
    while (i > 0) {
        i = i - 1;
        emit_ch(buf[i]);
    }
}

error(msg: *i8) {
    write(2, "error: ", len("error: "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
    exit(1);
}

dummy_node: *Node;
dummy_obj: *Obj;
dummy_type: *Type;
dummy_member: *Member;
dummy_variant: *Variant;
dummy_function: *Function;
dummy_i8: *i8;
token_eof: *Token;

init_dummies() {
    dummy_i8 = "";
    dummy_type = ty_int;
    token_eof = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        next: uninitialized
    };
    token_eof.next = token_eof;
    dummy_node = new Node {
        kind: ND_NUM,
        next: null,
        lhs: null,
        rhs: null,
        cond: null,
        then: null,
        els: null,
        body: null,
        val: 0,
        var: null,
        funcname: null,
        args: null,
        str_label: 0,
        ty: null,
        member: null,
        variant: null
    };
    dummy_obj = new Obj {
        name: "",
        is_local: 0,
        is_func: 0,
        offset: 0,
        scope_depth: 0,
        ty: null,
        next: null
    };
    dummy_member = new Member {
        name: "",
        offset: 0,
        ty: null,
        next: null
    };
    dummy_variant = new Variant {
        name: "",
        tag: 0,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        next: null
    };
    dummy_function = new Function {
        name: "",
        nparams: 0,
        p0: null,
        p1: null,
        p2: null,
        p3: null,
        p4: null,
        p5: null,
        locals: null,
        body: null,
        stack_size: 0,
        return_ty: null,
        sret: null,
        next: null
    };
}

expect_node(n: ?*Node, msg: *i8): *Node {
    if (n != null) {
        return n;
    }
    error(msg);
    return dummy_node;
}

expect_obj(o: ?*Obj, msg: *i8): *Obj {
    if (o != null) {
        return o;
    }
    error(msg);
    return dummy_obj;
}

expect_type(t: ?*Type, msg: *i8): *Type {
    if (t != null) {
        return t;
    }
    error(msg);
    return dummy_type;
}

expect_member(m: ?*Member, msg: *i8): *Member {
    if (m != null) {
        return m;
    }
    error(msg);
    return dummy_member;
}

expect_variant(v: ?*Variant, msg: *i8): *Variant {
    if (v != null) {
        return v;
    }
    error(msg);
    return dummy_variant;
}

expect_function(f: ?*Function, msg: *i8): *Function {
    if (f != null) {
        return f;
    }
    error(msg);
    return dummy_function;
}

expect_str(s: ?*i8, msg: *i8): *i8 {
    if (s != null) {
        return s;
    }
    error(msg);
    return dummy_i8;
}


init_kinds() {
    ND_NUM = 0; ND_VAR = 1; ND_ADD = 2; ND_SUB = 3; ND_MUL = 4; ND_DIV = 5; ND_MOD = 6;
    ND_EQ = 7; ND_NE = 8; ND_LT = 9; ND_LE = 10; ND_GT = 11; ND_GE = 12;
    ND_ASSIGN = 13; ND_ADDR = 14; ND_DEREF = 15; ND_NOT = 16; ND_NEG = 17;
    ND_FUNCALL = 18; ND_RETURN = 19; ND_IF = 20; ND_WHILE = 21; ND_BLOCK = 22;
    ND_EXPR_STMT = 23; ND_LOGAND = 24; ND_LOGOR = 25; ND_MEMBER = 26; ND_AS = 27; ND_TRUNC = 28; ND_NEW = 29; ND_STRUCT_LIT = 30;
    ND_VARIANT_LIT = 31; ND_MATCH = 32; ND_MATCH_ARM = 33; ND_NULL = 34;
    REG0 = "%rdi"; REG1 = "%rsi"; REG2 = "%rdx";
    REG3 = "%rcx"; REG4 = "%r8"; REG5 = "%r9";
    ty_int = new Type.Int;
    ty_i8 = new Type.I8;
    ty_bool = new Type.Bool;
}

reg_name(i: int): *i8 {
    if (i == 0) { return REG0; }
    if (i == 1) { return REG1; }
    if (i == 2) { return REG2; }
    if (i == 3) { return REG3; }
    if (i == 4) { return REG4; }
    return REG5;
}

read_file(path: *i8): *i8 {
    fd: int = open(path, 0, 0);
    if (fd < 0) {
        error("cannot open file");
    }
    cap: int = 65536;
    buf: *i8 = new i8[cap];
    n: int = 0;
    while (true) {
        if (n + 4096 > cap) {
            cap = cap * 2;
            tmp: *i8 = new i8[cap];
            memcpy(tmp, buf, n);
            buf = tmp;
        }
        r: int = read(fd, buf + n, 4096);
        if (r <= 0) {
            buf[n] = 0 trunc i8;
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    return buf;
}

type_size(t: ?*Type): int {
    if (t != null) {
        match t.* {
            Int -> { return 8; }
            I8 -> { return 1; }
            Bool -> { return 1; }
            Ptr { base } -> { return 8; }
            OptPtr { base } -> { return 8; }
            Array { base, len } -> { return type_size(base) * len; }
            Record { def } -> { return def.size; }
            Enum { def } -> {
                if (def.size <= 0) {
                    return 8;
                }
                return def.size;
            }
        }
    }
    return 0;
}

type_base(t: ?*Type): *Type {
    if (t != null) {
        match t.* {
            Ptr { base } -> { return base; }
            OptPtr { base } -> { return base; }
            Array { base, len } -> { return base; }
            _ -> { error("not a pointer or array"); return ty_int; }
        }
    }
    error("not a pointer or array");
    return ty_int;
}

type_array_len(t: ?*Type): int {
    if (t != null) {
        match t.* {
            Array { base, len } -> { return len; }
            _ -> { error("not an array"); return 0; }
        }
    }
    error("not an array");
    return 0;
}

type_struct_def(t: ?*Type): *StructDef {
    if (t != null) {
        match t.* {
            Record { def } -> { return def; }
            _ -> { error("not a record type"); return get_or_create_struct("?"); }
        }
    }
    error("not a record type");
    return get_or_create_struct("?");
}

type_enum_def(t: ?*Type): *EnumDef {
    if (t != null) {
        match t.* {
            Enum { def } -> { return def; }
            _ -> { error("not an enum type"); return get_or_create_enum("?"); }
        }
    }
    error("not an enum type");
    return get_or_create_enum("?");
}

ptr_to(base: *Type): *Type {
    return new Type.Ptr { base: base };
}

opt_ptr_to(base: *Type): *Type {
    return new Type.OptPtr { base: base };
}

array_of(base: *Type, len: int): *Type {
    return new Type.Array { base: base, len: len };
}

struct_type(sd: *StructDef): *Type {
    existing: ?*Type = sd.ty;
    if (existing != null) {
        return existing;
    }
    p: *Type = new Type.Record { def: sd };
    sd.ty = p;
    return p;
}

enum_type(ed: *EnumDef): *Type {
    existing: ?*Type = ed.ty;
    if (existing != null) {
        return existing;
    }
    p: *Type = new Type.Enum { def: ed };
    ed.ty = p;
    return p;
}

find_struct(name: *i8): ?*StructDef {
    s: ?*StructDef = struct_defs;
    while (s != null) {
        if (streq(s.name, name)) {
            return s;
        }
        s = s.next;
    }
    return null;
}

find_enum(name: *i8): ?*EnumDef {
    e: ?*EnumDef = enum_defs;
    while (e != null) {
        if (streq(e.name, name)) {
            return e;
        }
        e = e.next;
    }
    return null;
}

remove_struct(name: *i8) {
    prev: ?*StructDef = null;
    s: ?*StructDef = struct_defs;
    while (s != null) {
        if (streq(s.name, name)) {
            if (prev != null) {
                prev.next = s.next;
            } else {
                struct_defs = s.next;
            }
            return;
        }
        prev = s;
        s = s.next;
    }
}

get_or_create_struct(name: *i8): *StructDef {
    sd: ?*StructDef = find_struct(name);
    if (sd != null) {
        return sd;
    }
    created: *StructDef = new StructDef {
        name: name,
        members: null,
        size: 0,
        ty: null,
        next: struct_defs
    };
    struct_defs = created;
    return created;
}

get_or_create_enum(name: *i8): *EnumDef {
    ed: ?*EnumDef = find_enum(name);
    if (ed != null) {
        return ed;
    }
    created: *EnumDef = new EnumDef {
        name: name,
        variants: null,
        size: 0,
        ty: null,
        next: enum_defs
    };
    enum_defs = created;
    return created;
}

rebind_struct_stub_to_enum(sd: *StructDef, ed: *EnumDef) {
    t: ?*Type = sd.ty;
    if (t != null) {
        t.* = Type.Enum { def: ed };
        ed.ty = t;
    }
}

find_variant(ed: *EnumDef, name: *i8): ?*Variant {
    v: ?*Variant = ed.variants;
    while (v != null) {
        if (streq(v.name, name)) {
            return v;
        }
        v = v.next;
    }
    return null;
}

enum_field_offset(m: *Member): int {
    return 8 + m.offset;
}

variant_payload_name(enum_name: *i8, var_name: *i8): *i8 {
    n: int = len(enum_name) + 1 + len(var_name);
    raw: *i8 = new i8[n + 16];
    p: *int = raw as *int;
    p.* = n;
    data: *i8 = raw + 8;
    i: int = 0;
    j: int = 0;
    while (i < len(enum_name)) {
        data[j] = enum_name[i];
        j = j + 1;
        i = i + 1;
    }
    data[j] = '.';
    j = j + 1;
    i = 0;
    while (i < len(var_name)) {
        data[j] = var_name[i];
        j = j + 1;
        i = i + 1;
    }
    return data;
}

is_type_name(): bool {
    if (!equal(TokKind.Ident)) {
        return false;
    }
    name: *i8 = strdup_n(tok.str, tok.len);
    if (find_struct(name) != null) {
        return true;
    }
    if (find_enum(name) != null) {
        return true;
    }
    return false;
}

starts_type(): bool {
    if (equal(TokKind.Int) || equal(TokKind.I8) || equal(TokKind.Bool) || is_type_name()) {
        return true;
    }
    t: ?*Token = tok;
    done: int = 0;
    while (t != null && done == 0) {
        if (t.kind == TokKind.Question) {
            n1: ?*Token = t.next;
            if (n1 != null) {
                if (n1.kind != TokKind.Star) {
                    return false;
                }
                t = n1.next;
            } else {
                return false;
            }
        } else {
            if (t.kind == TokKind.Star) {
                t = t.next;
            } else {
                done = 1;
            }
        }
    }
    if (t != null) {
        if (t != tok) {
            if (t.kind == TokKind.Int || t.kind == TokKind.I8 || t.kind == TokKind.Bool) {
                return true;
            }
            if (t.kind == TokKind.Ident) {
                n: *i8 = strdup_n(t.str, t.len);
                if (find_struct(n) != null || find_enum(n) != null) {
                    return true;
                }
            }
        }
    }
    return false;
}

find_member(sd: *StructDef, name: *i8): ?*Member {
    m: ?*Member = sd.members;
    while (m != null) {
        if (streq(m.name, name)) {
            return m;
        }
        m = m.next;
    }
    return null;
}

is_pointer(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            Ptr { base } -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

is_opt_pointer(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            OptPtr { base } -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

is_any_pointer(t: ?*Type): bool {
    return is_pointer(t) || is_opt_pointer(t);
}

is_array(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            Array { base, len } -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

is_struct_ty(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            Record { def } -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

is_enum_ty(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            Enum { def } -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

is_aggregate(t: ?*Type): bool {
    return is_struct_ty(t) || is_enum_ty(t);
}

passes_by_ref(t: *Type): bool {
    return is_aggregate(t) && type_size(t) > 8;
}


is_null_node(n: ?*Node): bool {
    if (n != null) {
        return n.kind == ND_NULL;
    }
    return false;
}

bind_null_to_pointer(pty: ?*Type, null_n: ?*Node): bool {
    if (!is_opt_pointer(pty) || !is_null_node(null_n)) {
        return false;
    }
    if (null_n != null) {
        null_n.ty = pty;
        return true;
    }
    return false;
}

types_compatible(from: ?*Type, to: ?*Type): bool {
    from = decay(from);
    to = decay(to);
    if (types_equal(from, to)) {
        return true;
    }
    if (is_opt_pointer(to) && is_pointer(from) && types_equal(type_base(from), type_base(to))) {
        return true;
    }
    return false;
}

assignable(to: ?*Type, from_n: ?*Node): bool {
    ft: ?*Type = null;
    if (from_n != null) {
        fty: ?*Type = from_n.ty;
        if (fty != null) {
            ft = decay(fty);
        }
    }
    tt: ?*Type = decay(to);
    if (ft != null && types_compatible(ft, tt)) {
        return true;
    }
    if (bind_null_to_pointer(tt, from_n)) {
        return true;
    }
    return false;
}



is_i8_ty(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            I8 -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

is_int_ty(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            Int -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

is_bool_ty(t: ?*Type): bool {
    if (t != null) {
        match t.* {
            Bool -> { return true; }
            _ -> { return false; }
        }
    }
    return false;
}

types_equal(a: ?*Type, b: ?*Type): bool {
    if (a == b) {
        return true;
    }
    if (a == null || b == null) {
        return false;
    }
    if (is_int_ty(a) && is_int_ty(b)) {
        return true;
    }
    if (is_i8_ty(a) && is_i8_ty(b)) {
        return true;
    }
    if (is_bool_ty(a) && is_bool_ty(b)) {
        return true;
    }
    if (is_pointer(a) && is_pointer(b)) {
        return types_equal(type_base(a), type_base(b));
    }
    if (is_opt_pointer(a) && is_opt_pointer(b)) {
        return types_equal(type_base(a), type_base(b));
    }
    if (is_array(a) && is_array(b)) {
        if (type_array_len(a) != type_array_len(b)) {
            return false;
        }
        return types_equal(type_base(a), type_base(b));
    }
    if (is_struct_ty(a) && is_struct_ty(b)) {
        return type_struct_def(a) == type_struct_def(b);
    }
    if (is_enum_ty(a) && is_enum_ty(b)) {
        return type_enum_def(a) == type_enum_def(b);
    }
    return false;
}

is_numeric_ty(t: ?*Type): bool {
    t = decay(t);
    return is_int_ty(t) || is_i8_ty(t) || is_bool_ty(t);
}

check_as(from: ?*Type, to: ?*Type) {
    from = decay(from);
    to = decay(to);
    if (types_equal(from, to)) {
        return;
    }
    if (is_numeric_ty(from) && is_numeric_ty(to)) {
        if ((is_i8_ty(from) || is_bool_ty(from)) && is_int_ty(to)) {
            return;
        }
        if (type_size(from) == 1 && type_size(to) == 1) {
            return;
        }
        error("invalid as conversion (use trunc to narrow int→i8/bool)");
    }
    if (is_opt_pointer(from) && is_pointer(to)) {
        error("cannot cast ?*T to *T (bind a local and use if (p != null))");
    }
    if (is_pointer(from) && is_pointer(to)) {
        return;
    }
    error("invalid as conversion");
}

check_trunc(from: ?*Type, to: ?*Type) {
    from = decay(from);
    to = decay(to);
    if (is_int_ty(from) && (is_i8_ty(to) || is_bool_ty(to))) {
        return;
    }
    error("invalid trunc conversion");
}

decay(t: ?*Type): ?*Type {
    if (is_array(t)) {
        return ptr_to(type_base(t));
    }
    return t;
}

new_token(kind: TokKind, start: *i8, len: int): *Token {
    return new Token {
        kind: kind,
        val: 0,
        str: start,
        len: len,
        next: token_eof
    };
}

ident_kind(s: *i8, n: int): TokKind {
    if (n == 3 && streq_n(s, "int", 3)) { return TokKind.Int; }
    if (n == 2 && streq_n(s, "i8", 2)) { return TokKind.I8; }
    if (n == 4 && streq_n(s, "bool", 4)) { return TokKind.Bool; }
    if (n == 4 && streq_n(s, "true", 4)) { return TokKind.True; }
    if (n == 5 && streq_n(s, "false", 5)) { return TokKind.False; }
    if (n == 4 && streq_n(s, "null", 4)) { return TokKind.Null; }
    if (n == 2 && streq_n(s, "if", 2)) { return TokKind.If; }
    if (n == 4 && streq_n(s, "else", 4)) { return TokKind.Else; }
    if (n == 5 && streq_n(s, "while", 5)) { return TokKind.While; }
    if (n == 6 && streq_n(s, "return", 6)) { return TokKind.Return; }
    if (n == 4 && streq_n(s, "type", 4)) { return TokKind.TypeKw; }
    if (n == 6 && streq_n(s, "sizeof", 6)) { return TokKind.Sizeof; }
    if (n == 13 && streq_n(s, "uninitialized", 13)) { return TokKind.Uninitialized; }
    if (n == 2 && streq_n(s, "as", 2)) { return TokKind.As; }
    if (n == 5 && streq_n(s, "trunc", 5)) { return TokKind.Trunc; }
    if (n == 3 && streq_n(s, "new", 3)) { return TokKind.New; }
    if (n == 5 && streq_n(s, "match", 5)) { return TokKind.Match; }
    return TokKind.Ident;
}

skip_line_comment() {
    while (pos < source_len) {
        if (source[pos] == '\n') {
            return;
        }
        pos = pos + 1;
    }
}

skip_block_comment() {
    while (pos < source_len) {
        if (source[pos] == '*' && source[pos + 1] == '/') {
            pos = pos + 2;
            return;
        }
        pos = pos + 1;
    }
}

read_number(): int {
    v: int = 0;
    while (pos < source_len) {
        if (!is_digit(source[pos])) {
            return v;
        }
        v = v * 10 + ((source[pos] as int) - ('0' as int));
        pos = pos + 1;
    }
    return v;
}

esc_char(c: i8): i8 {
    if (c == 'n') { return '\n'; }
    if (c == 't') { return '\t'; }
    if (c == 'r') { return '\r'; }
    if (c == '0') { return 0 trunc i8; }
    if (c == '\\') { return '\\'; }
    if (c == '\'') { return '\''; }
    if (c == '"') { return '"'; }
    return c;
}

scan_string_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (source[pos] == '"') {
            return pos - start;
        }
        if (source[pos] == '\\') {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    error("unterminated string");
    return 0;
}

scan_ident_len(): int {
    start: int = pos;
    while (pos < source_len) {
        if (!is_ident2(source[pos])) {
            return pos - start;
        }
        pos = pos + 1;
    }
    return pos - start;
}

punct_kind(c: i8): TokKind {
    if (c == '+') { return TokKind.Plus; }
    if (c == '-') { return TokKind.Minus; }
    if (c == '*') { return TokKind.Star; }
    if (c == '%') { return TokKind.Percent; }
    if (c == '&') { return TokKind.Amp; }
    if (c == '.') { return TokKind.Dot; }
    if (c == ':') { return TokKind.Colon; }
    if (c == '(') { return TokKind.LParen; }
    if (c == ')') { return TokKind.RParen; }
    if (c == '{') { return TokKind.LBrace; }
    if (c == '}') { return TokKind.RBrace; }
    if (c == '[') { return TokKind.LBrack; }
    if (c == ']') { return TokKind.RBrack; }
    if (c == ';') { return TokKind.Semi; }
    if (c == ',') { return TokKind.Comma; }
    if (c == '/') { return TokKind.Slash; }
    if (c == '?') { return TokKind.Question; }
    error("unexpected character");
    return TokKind.Eof;
}

tokenize(): *Token {
    head: *Token = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        next: token_eof
    };
    cur: *Token = head;
    t: *Token = uninitialized;
    s: *i8 = uninitialized;
    n: int = 0;
    v: int = 0;
    c: i8 = 0 trunc i8;
    ch: i8 = 0 trunc i8;
    pk: TokKind = TokKind.Eof;
    pos = 0;
    while (pos < source_len) {
        c = source[pos];
        if (is_space(c)) {
            pos = pos + 1;
        } else {
            if (c == '/' && source[pos + 1] == '/') {
                pos = pos + 2;
                skip_line_comment();
            } else {
                if (c == '/' && source[pos + 1] == '*') {
                    pos = pos + 2;
                    skip_block_comment();
                } else {
                    if (is_digit(c)) {
                        s = source + pos;
                        v = read_number();
                        t = new_token(TokKind.Num, s, (source + pos) - s);
                        t.val = v;
                        cur.next = t;
                        cur = t;
                    } else {
                        if (c == '"') {
                            pos = pos + 1;
                            s = source + pos;
                            n = scan_string_len();
                            t = new_token(TokKind.Str, s, n);
                            cur.next = t;
                            cur = t;
                            pos = pos + 1;
                        } else {
                            if (c == '\'') {
                                pos = pos + 1;
                                if (source[pos] == '\\') {
                                    pos = pos + 1;
                                    ch = esc_char(source[pos]);
                                    pos = pos + 1;
                                } else {
                                    ch = source[pos];
                                    pos = pos + 1;
                                }
                                if (source[pos] == '\'') {
                                    pos = pos + 1;
                                }
                                t = new_token(TokKind.Char, source + pos, 0);
                                t.val = ch as int;
                                cur.next = t;
                                cur = t;
                            } else {
                                if (is_ident1(c)) {
                                    s = source + pos;
                                    n = scan_ident_len();
                                    t = new_token(ident_kind(s, n), s, n);
                                    cur.next = t;
                                    cur = t;
                                } else {
                                    if (c == '=' && source[pos + 1] == '=') {
                                        t = new_token(TokKind.Eq, source + pos, 2);
                                        cur.next = t; cur = t; pos = pos + 2;
                                    } else {
                                        if (c == '!' && source[pos + 1] == '=') {
                                            t = new_token(TokKind.Ne, source + pos, 2);
                                            cur.next = t; cur = t; pos = pos + 2;
                                        } else {
                                            if (c == '<' && source[pos + 1] == '=') {
                                                t = new_token(TokKind.Le, source + pos, 2);
                                                cur.next = t; cur = t; pos = pos + 2;
                                            } else {
                                                if (c == '>' && source[pos + 1] == '=') {
                                                    t = new_token(TokKind.Ge, source + pos, 2);
                                                    cur.next = t; cur = t; pos = pos + 2;
                                                } else {
                                                    if (c == '&' && source[pos + 1] == '&') {
                                                        t = new_token(TokKind.And, source + pos, 2);
                                                        cur.next = t; cur = t; pos = pos + 2;
                                                    } else {
                                                            if (c == '|' && source[pos + 1] == '|') {
                                                            t = new_token(TokKind.Or, source + pos, 2);
                                                            cur.next = t; cur = t; pos = pos + 2;
                                                        } else {
                                                            if (c == '|') {
                                                                t = new_token(TokKind.Pipe, source + pos, 1);
                                                                cur.next = t; cur = t; pos = pos + 1;
                                                            } else {
                                                            if (c == '?') {
                                                                t = new_token(TokKind.Question, source + pos, 1);
                                                                cur.next = t; cur = t; pos = pos + 1;
                                                            } else {
                                                                if (c == '-' && source[pos + 1] == '>') {
                                                                    t = new_token(TokKind.Arrow, source + pos, 2);
                                                                    cur.next = t; cur = t; pos = pos + 2;
                                                                } else {
                                                                    if (c == '=') {
                                                                        t = new_token(TokKind.Assign, source + pos, 1);
                                                                        cur.next = t; cur = t; pos = pos + 1;
                                                                    } else {
                                                                        if (c == '!') {
                                                                            t = new_token(TokKind.Not, source + pos, 1);
                                                                            cur.next = t; cur = t; pos = pos + 1;
                                                                        } else {
                                                                            if (c == '<') {
                                                                                t = new_token(TokKind.Lt, source + pos, 1);
                                                                                cur.next = t; cur = t; pos = pos + 1;
                                                                            } else {
                                                                                if (c == '>') {
                                                                                    t = new_token(TokKind.Gt, source + pos, 1);
                                                                                    cur.next = t; cur = t; pos = pos + 1;
                                                                                } else {
                                                                                    pk = punct_kind(c);
                                                                                    t = new_token(pk, source + pos, 1);
                                                                                    cur.next = t; cur = t; pos = pos + 1;
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    t = new_token(TokKind.Eof, source + pos, 0);
    t.next = t;
    cur.next = t;
    return head.next;
}

equal(kind: TokKind): bool {
    return tok.kind == kind;
}

skip(kind: TokKind) {
    if (!equal(kind)) {
        error("unexpected token");
    }
    tok = tok.next;
}

cur_tokstr(): *i8 {
    return strdup_n(tok.str, tok.len);
}

add_string(s: *i8, n: int): int {
    buf: *i8 = new i8[n + 1];
    i: int = 0;
    j: int = 0;
    while (i < n) {
        if (s[i] == '\\' && i + 1 < n) {
            i = i + 1;
            buf[j] = esc_char(s[i]);
            j = j + 1;
        } else {
            buf[j] = s[i];
            j = j + 1;
        }
        i = i + 1;
    }
    buf[j] = 0 trunc i8;
    lit: *StrLit = new StrLit {
        data: buf,
        len: j,
        label: str_count,
        next: str_lits
    };
    str_count = str_count + 1;
    str_lits = lit;
    return lit.label;
}

new_node(kind: int): *Node {
    return new Node {
        kind: kind,
        next: null,
        lhs: null,
        rhs: null,
        cond: null,
        then: null,
        els: null,
        body: null,
        val: 0,
        var: null,
        funcname: null,
        args: null,
        str_label: 0,
        ty: null,
        member: null,
        variant: null
    };
}

new_binary(kind: int, lhs: *Node, rhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    n.rhs = rhs;
    return n;
}

new_unary(kind: int, lhs: *Node): *Node {
    n: *Node = new_node(kind);
    n.lhs = lhs;
    return n;
}

new_num(v: int): *Node {
    n: *Node = new_node(ND_NUM);
    n.val = v;
    n.ty = ty_int;
    return n;
}

find_function(name: *i8): ?*Function {
    fn: ?*Function = functions;
    while (fn != null) {
        if (streq(fn.name, name)) {
            return fn;
        }
        fn = fn.next;
    }
    return null;
}

find_obj(list: ?*Obj, name: *i8): ?*Obj {
    o: ?*Obj = list;
    while (o != null) {
        if (streq(o.name, name)) {
            return o;
        }
        o = o.next;
    }
    return null;
}

find_local(name: *i8): ?*Obj {
    o: ?*Obj = locals;
    while (o != null) {
        if (o.scope_depth <= scope_depth) {
            if (streq(o.name, name)) {
                return o;
            }
        }
        o = o.next;
    }
    return null;
}

find_var(name: *i8): ?*Obj {
    o: ?*Obj = find_local(name);
    if (o != null) {
        return o;
    }
    return find_obj(globals, name);
}

enter_scope() {
    scope_depth = scope_depth + 1;
}

leave_scope() {
    if (scope_depth <= 0) {
        error("internal: leave_scope");
    }
    scope_depth = scope_depth - 1;
}

new_obj(name: *i8, is_local: int): *Obj {
    o: *Obj = new Obj {
        name: name,
        is_local: is_local,
        is_func: 0,
        offset: 0,
        scope_depth: 0,
        ty: null,
        next: null
    };
    if (is_local != 0) {
        o.scope_depth = scope_depth;
        o.next = locals;
        locals = o;
    } else {
        o.next = globals;
        globals = o;
    }
    return o;
}

var_view_ty(var: ?*Obj): ?*Type {
    f: ?*NarrowFrame = narrow_top;
    while (f != null) {
        if (f.var == var) {
            return f.ty;
        }
        f = f.next;
    }
    if (var != null) {
        return var.ty;
    }
    return null;
}

narrow_push(var: ?*Obj, ty: ?*Type) {
    f: *NarrowFrame = new NarrowFrame {
        var: var,
        ty: ty,
        next: narrow_top
    };
    narrow_top = f;
}

narrow_reset(saved: ?*NarrowFrame) {
    narrow_top = saved;
}

narrow_from_cond(cond: ?*Node, for_else: int): ?*NarrowFrame {
    saved: ?*NarrowFrame = narrow_top;
    if (for_else != 0) {
        narrow_push_eq_nulls(cond);
    } else {
        narrow_push_ne_nulls(cond);
    }
    return saved;
}

opt_local_var(n: ?*Node): ?*Obj {
    if (n != null) {
        if (n.kind != ND_VAR) {
            return null;
        }
        v: ?*Obj = n.var;
        if (v != null) {
            if (v.is_local == 0) {
                return null;
            }
            t: ?*Type = decay(v.ty);
            if (is_opt_pointer(t)) {
                return v;
            }
            return null;
        }
        return null;
    }
    return null;
}

null_check_var(cond: ?*Node): ?*Obj {
    if (cond != null) {
        if (cond.kind == ND_NE) {
            if (is_null_node(cond.rhs)) {
                return opt_local_var(cond.lhs);
            }
            if (is_null_node(cond.lhs)) {
                return opt_local_var(cond.rhs);
            }
            return null;
        }
        return null;
    }
    return null;
}

null_eq_var(cond: ?*Node): ?*Obj {
    if (cond != null) {
        if (cond.kind != ND_EQ) {
            return null;
        }
        if (is_null_node(cond.rhs)) {
            return opt_local_var(cond.lhs);
        }
        if (is_null_node(cond.lhs)) {
            return opt_local_var(cond.rhs);
        }
        return null;
    }
    return null;
}

narrow_push_ne_nulls(cond: ?*Node) {
    if (cond != null) {
        if (cond.kind == ND_LOGAND) {
            narrow_push_ne_nulls(cond.lhs);
            narrow_push_ne_nulls(cond.rhs);
            return;
        }
        v: ?*Obj = null_check_var(cond);
        if (v != null) {
            narrow_push(v, ptr_to(type_base(v.ty)));
        }
    }
}

narrow_push_eq_nulls(cond: ?*Node) {
    if (cond != null) {
        if (cond.kind == ND_LOGOR) {
            narrow_push_eq_nulls(cond.lhs);
            narrow_push_eq_nulls(cond.rhs);
            return;
        }
        v: ?*Obj = null_eq_var(cond);
        if (v != null) {
            narrow_push(v, ptr_to(type_base(v.ty)));
        }
    }
}

decl_spec(): *Type {
    if (equal(TokKind.Int)) {
        tok = tok.next;
        return ty_int;
    }
    if (equal(TokKind.I8)) {
        tok = tok.next;
        return ty_i8;
    }
    if (equal(TokKind.Bool)) {
        tok = tok.next;
        return ty_bool;
    }
    if (equal(TokKind.Ident)) {
        name: *i8 = cur_tokstr();
        ed: ?*EnumDef = find_enum(name);
        if (ed != null) {
            tok = tok.next;
            return enum_type(ed);
        }
        tok = tok.next;
        sd: *StructDef = get_or_create_struct(name);
        return struct_type(sd);
    }
    error("expected type");
    return ty_int;
}

parse_type(): *Type {
    if (equal(TokKind.Question)) {
        tok = tok.next;
        if (!equal(TokKind.Star)) {
            error("expected * after ? in optional pointer type");
        }
        tok = tok.next;
        base: *Type = parse_type();
        return opt_ptr_to(base);
    }
    if (equal(TokKind.Star)) {
        tok = tok.next;
        base: *Type = parse_type();
        return ptr_to(base);
    }
    return decl_spec();
}

parse_expr(): *Node {
    return parse_assign();
}

parse_struct_field_inits(sty: *Type): *Node {
    if (!is_struct_ty(sty)) {
        error("struct literal requires a struct type");
    }
    skip(TokKind.LBrace);
    head: ?*Node = null;
    cur: ?*Node = null;
    m: ?*Member = null;
    i: ?*Node = null;
    while (!equal(TokKind.RBrace)) {
        if (cur != null) {
            skip(TokKind.Comma);
        }
        if (!equal(TokKind.Ident)) {
            error("expected field name in struct literal");
        }
        fname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TokKind.Colon);
        m = find_member(type_struct_def(sty), fname);
        if (m == null) {
            error("unknown field");
        }
        mu: *Member = expect_member(m, "null member");
        i = head;
        while (i != null) {
            if (i.member == mu) {
                error("duplicate field in struct literal");
            }
            i = i.next;
        }
        init: *Node = new_node(ND_EXPR_STMT);
        init.member = mu;
        if (equal(TokKind.Uninitialized)) {
            init.lhs = null;
            tok = tok.next;
        } else {
            init.lhs = parse_expr();
            add_type(init.lhs);
            lt: ?*Type = decay(mu.ty);
            if (!assignable(lt, init.lhs)) {
                error("field initializer type mismatch");
            }
        }
        if (cur != null) {
            cur.next = init;
            cur = init;
        } else {
            head = init;
            cur = init;
        }
    }
    m = type_struct_def(sty).members;
    while (m != null) {
        found: int = 0;
        i = head;
        while (i != null) {
            if (i.member == m) {
                found = 1;
            }
            i = i.next;
        }
        if (found == 0) {
            error("struct literal missing field");
        }
        m = m.next;
    }
    skip(TokKind.RBrace);
    return expect_node(head, "empty list");
}

parse_variant_field_inits(v: *Variant): *Node {
    skip(TokKind.LBrace);
    head: ?*Node = null;
    cur: ?*Node = null;
    m: ?*Member = null;
    i: ?*Node = null;
    while (!equal(TokKind.RBrace)) {
        if (cur != null) {
            skip(TokKind.Comma);
        }
        if (!equal(TokKind.Ident)) {
            error("expected field name in variant literal");
        }
        fname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TokKind.Colon);
        m = null;
        x: ?*Member = v.fields;
        while (x != null) {
            if (streq(x.name, fname)) {
                m = x;
            }
            x = x.next;
        }
        if (m == null) {
            error("unknown field");
        }
        mu: *Member = expect_member(m, "null member");
        i = head;
        while (i != null) {
            if (i.member == mu) {
                error("duplicate field");
            }
            i = i.next;
        }
        init: *Node = new_node(ND_EXPR_STMT);
        init.member = mu;
        if (equal(TokKind.Uninitialized)) {
            init.lhs = null;
            tok = tok.next;
        } else {
            init.lhs = parse_expr();
            add_type(init.lhs);
            lt: ?*Type = decay(mu.ty);
            if (!assignable(lt, init.lhs)) {
                error("field initializer type mismatch");
            }
        }
        if (cur != null) {
            cur.next = init;
            cur = init;
        } else {
            head = init;
            cur = init;
        }
    }
    m = v.fields;
    while (m != null) {
        found: int = 0;
        i = head;
        while (i != null) {
            if (i.member == m) {
                found = 1;
            }
            i = i.next;
        }
        if (found == 0) {
            error("variant literal missing field");
        }
        m = m.next;
    }
    skip(TokKind.RBrace);
    return expect_node(head, "empty list");
}

parse_primary(): *Node {
    n: *Node = uninitialized;
    if (equal(TokKind.New)) {
        tok = tok.next;
        if (is_type_name() && (tok.next).kind == TokKind.Dot) {
            ety: *Type = parse_type();
            if (!is_enum_ty(ety)) {
                error("new Enum.Variant requires an enum type");
            }
            skip(TokKind.Dot);
            if (!equal(TokKind.Ident)) {
                error("expected variant name after new Enum.");
            }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null) {
                error("unknown variant");
            }
            v: *Variant = expect_variant(vo, "null variant");
            n = new_node(ND_NEW);
            n.ty = ptr_to(ety);
            n.variant = v;
            n.val = v.tag;
            if (equal(TokKind.LBrace)) {
                if (v.fields == null) {
                    error("unit variant does not take fields");
                }
                n.args = parse_variant_field_inits(v);
            } else {
                if (v.fields != null) {
                    error("variant requires field initializers");
                }
            }
            return n;
        }
        base: *Type = parse_type();
        if (equal(TokKind.LBrack)) {
            tok = tok.next;
            len: *Node = parse_expr();
            skip(TokKind.RBrack);
            add_type(len);
            if (!is_int_ty(decay(len.ty))) {
                error("array length must be int");
            }
            if (is_pointer(base) || is_opt_pointer(base)) {
                error("new expects a non-pointer type");
            }
            n = new_node(ND_NEW);
            n.ty = ptr_to(base);
            n.lhs = len;
            n.val = 1;
            return n;
        }
        if (is_pointer(base)) {
            error("new expects a non-pointer type");
        }
        n = new_node(ND_NEW);
        n.ty = ptr_to(base);
        if (equal(TokKind.Uninitialized)) {
            n.val = 1;
            tok = tok.next;
            return n;
        }
        if (!equal(TokKind.LBrace)) {
            error("expected uninitialized, {, [, or .Variant after new");
        }
        if (is_enum_ty(base)) {
            error("use new Enum.Variant { ... } for sum types");
        }
        n.args = parse_struct_field_inits(base);
        n.val = 0;
        return n;
    }
    if (equal(TokKind.Sizeof)) {
        tok = tok.next;
        skip(TokKind.LParen);
        if (starts_type()) {
            ty: *Type = parse_type();
            ty = parse_type_suffix(ty);
            skip(TokKind.RParen);
            return new_num(type_size(ty));
        }
        n = parse_expr();
        skip(TokKind.RParen);
        add_type(n);
        return new_num(type_size(n.ty));
    }
    if (equal(TokKind.LParen)) {
        tok = tok.next;
        n = parse_expr();
        skip(TokKind.RParen);
        return n;
    }
    if (equal(TokKind.Num)) {
        n = new_num(tok.val);
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.True) || equal(TokKind.False)) {
        bv: int = 0;
        if (equal(TokKind.True)) {
            bv = 1;
        }
        n = new_num(bv);
        n.ty = ty_bool;
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.Null)) {
        n = new_node(ND_NULL);
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.Char)) {
        n = new_num(tok.val);
        n.ty = ty_i8;
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.Str)) {
        label: int = add_string(tok.str, tok.len);
        tok = tok.next;
        n = new_node(ND_NUM);
        n.str_label = label + 1;
        n.ty = ptr_to(ty_i8);
        return n;
    }
    if (equal(TokKind.Ident)) {
        name: *i8 = cur_tokstr();
        if (is_type_name() && (tok.next).kind == TokKind.Dot) {
            ety: *Type = parse_type();
            if (!is_enum_ty(ety)) {
                error("variant construction requires an enum type");
            }
            skip(TokKind.Dot);
            if (!equal(TokKind.Ident)) {
                error("expected variant name");
            }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            vo: ?*Variant = find_variant(type_enum_def(ety), vname);
            if (vo == null) {
                error("unknown variant");
            }
            v: *Variant = expect_variant(vo, "null variant");
            n = new_node(ND_VARIANT_LIT);
            n.ty = ety;
            n.variant = v;
            n.val = v.tag;
            if (equal(TokKind.LBrace)) {
                if (v.fields == null) {
                    error("unit variant does not take fields");
                }
                n.args = parse_variant_field_inits(v);
            } else {
                if (v.fields != null) {
                    error("variant requires field initializers");
                }
            }
            return n;
        }
        if (is_type_name() && (tok.next).kind == TokKind.LBrace) {
            sty: *Type = parse_type();
            if (!is_struct_ty(sty)) {
                error("struct literal requires a struct type");
            }
            n = new_node(ND_STRUCT_LIT);
            n.ty = sty;
            n.args = parse_struct_field_inits(sty);
            return n;
        }
        tok = tok.next;
        if (equal(TokKind.LParen)) {
            n = new_node(ND_FUNCALL);
            n.funcname = name;
            tok = tok.next;
            head: ?*Node = null;
            cur: ?*Node = null;
            while (!equal(TokKind.RParen)) {
                if (cur != null) {
                    skip(TokKind.Comma);
                }
                arg: *Node = parse_expr();
                if (cur != null) {
                    cur.next = arg;
                    cur = arg;
                } else {
                    head = arg;
                    cur = arg;
                }
            }
            n.args = head;
            skip(TokKind.RParen);
            return n;
        }
        varo: ?*Obj = find_var(name);
        if (varo == null) {
            error("undefined variable");
        }
        var: *Obj = expect_obj(varo, "null var");
        n = new_node(ND_VAR);
        n.var = var;
        n.ty = var.ty;
        return n;
    }
    error("expected expression");
    return new_node(ND_NUM);
}

parse_postfix(): *Node {
    n: *Node = parse_primary();
    while (true) {
        if (equal(TokKind.LBrack)) {
            tok = tok.next;
            idx: *Node = parse_expr();
            skip(TokKind.RBrack);
            add_type(n);
            add_type(idx);
            if (!is_int_ty(decay(idx.ty))) {
                error("array index must be int");
            }
            t: ?*Type = decay(n.ty);
            if (!is_pointer(t)) {
                error("subscript of non-pointer");
            }
            scaled: *Node = new_binary(ND_MUL, idx, new_num(type_size(type_base(t))));
            n = new_unary(ND_DEREF, new_binary(ND_ADD, n, scaled));
            n.ty = type_base(t);
        } else {
            if (equal(TokKind.Dot)) {
                if ((tok.next).kind == TokKind.Star) {
                    tok = tok.next;
                    tok = tok.next;
                    n = new_unary(ND_DEREF, n);
                } else {
                    tok = tok.next;
                    if (!equal(TokKind.Ident)) {
                        error("expected member name");
                    }
                    name: *i8 = cur_tokstr();
                    tok = tok.next;
                    add_type(n);
                    t: ?*Type = decay(n.ty);
                    sty: *Type = expect_type(n.ty, "missing type");
                    if (is_opt_pointer(t)) {
                        error("member access on optional pointer (use if (p != null) / while (p != null) to narrow)");
                    }
                    if (is_pointer(t) && is_struct_ty(type_base(t))) {
                        sty = type_base(t);
                    } else {
                        if (!is_struct_ty(n.ty)) {
                            error("member access on non-struct");
                        }
                    }
                    m: ?*Member = find_member(type_struct_def(sty), name);
                    if (m == null) {
                        error("unknown member");
                    }
                    mu: *Member = expect_member(m, "null member");
                    mem: *Node = new_node(ND_MEMBER);
                    mem.lhs = n;
                    mem.member = mu;
                    if (mu.ty != null) {
                        mem.ty = mu.ty;
                    } else {
                        mem.ty = ty_int;
                    }
                    n = mem;
                }
            } else {
                if (equal(TokKind.As) || equal(TokKind.Trunc)) {
                    is_trunc: bool = equal(TokKind.Trunc);
                    tok = tok.next;
                    ty: *Type = parse_type();
                    ty = parse_type_suffix(ty);
                    add_type(n);
                    if (is_trunc) {
                        check_trunc(n.ty, ty);
                    } else {
                        check_as(n.ty, ty);
                    }
                    if (is_trunc) {
                        n = new_unary(ND_TRUNC, n);
                    } else {
                        n = new_unary(ND_AS, n);
                    }
                    n.ty = ty;
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

parse_unary(): *Node {
    if (equal(TokKind.Plus)) {
        tok = tok.next;
        return parse_unary();
    }
    if (equal(TokKind.Minus)) {
        tok = tok.next;
        n: *Node = new_unary(ND_NEG, parse_unary());
        return n;
    }
    if (equal(TokKind.Amp)) {
        tok = tok.next;
        return new_unary(ND_ADDR, parse_unary());
    }
    if (equal(TokKind.Not)) {
        tok = tok.next;
        n = new_unary(ND_NOT, parse_unary());
        return n;
    }
    return parse_postfix();
}

add_type(n: ?*Node) {
    if (n != null) {
        add_type_node(n);
    }
}

add_type_node(p: *Node) {
    if (p.kind == ND_VAR) {
        p.ty = var_view_ty(p.var);
        return;
    }
    if (p.ty != null) {
        return;
    }
    if (p.kind == ND_IF || p.kind == ND_WHILE) {
        add_type(p.cond);
        ct: ?*Type = null;
        c: ?*Node = p.cond;
        if (c != null) {
            ct = decay(c.ty);
        }
        if (ct == null || !is_bool_ty(ct)) {
            error("condition must be bool");
        }
        save: ?*NarrowFrame = narrow_top;
        if (p.kind == ND_IF) {
            narrow_push_ne_nulls(p.cond);
            add_type(p.then);
            narrow_reset(save);
            narrow_push_eq_nulls(p.cond);
            add_type(p.els);
            narrow_reset(save);
        } else {
            narrow_push_ne_nulls(p.cond);
            add_type(p.body);
            narrow_reset(save);
        }
        return;
    }
    if (p.kind == ND_LOGAND) {
        add_type(p.lhs);
        save_and: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(p.lhs);
        add_type(p.rhs);
        narrow_reset(save_and);
        lhs_a: *Node = expect_node(p.lhs, "missing lhs");
        rhs_a: *Node = expect_node(p.rhs, "missing rhs");
        if (!is_bool_ty(decay(lhs_a.ty)) || !is_bool_ty(decay(rhs_a.ty))) {
            error("&& / || require bool operands");
        }
        p.ty = ty_bool;
        return;
    }
    if (p.kind == ND_LOGOR) {
        add_type(p.lhs);
        save_or: ?*NarrowFrame = narrow_top;
        narrow_push_eq_nulls(p.lhs);
        add_type(p.rhs);
        narrow_reset(save_or);
        lhs_o: *Node = expect_node(p.lhs, "missing lhs");
        rhs_o: *Node = expect_node(p.rhs, "missing rhs");
        if (!is_bool_ty(decay(lhs_o.ty)) || !is_bool_ty(decay(rhs_o.ty))) {
            error("&& / || require bool operands");
        }
        p.ty = ty_bool;
        return;
    }
    add_type(p.lhs);
    add_type(p.rhs);
    add_type(p.cond);
    add_type(p.then);
    add_type(p.els);
    add_type(p.body);
    a: ?*Node = p.args;
    while (a != null) {
        add_type(a);
        a = a.next;
    }
    if (p.kind == ND_BLOCK) {
        a = p.body;
        while (a != null) {
            add_type(a);
            a = a.next;
        }
    }
    if (p.kind == ND_NUM) {
        p.ty = ty_int;
        return;
    }
    if (p.kind == ND_NULL) {
        return;
    }
    if (p.kind == ND_VAR) {
        p.ty = var_view_ty(p.var);
        return;
    }
    if (p.kind == ND_ADD || p.kind == ND_SUB) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        rhs: *Node = expect_node(p.rhs, "missing rhs");
        lt: ?*Type = decay(lhs.ty);
        rt: ?*Type = decay(rhs.ty);
        if (p.kind == ND_ADD && is_pointer(lt) && is_int_ty(rt)) {
            p.ty = lt;
            return;
        }
        if (p.kind == ND_ADD && is_int_ty(lt) && is_pointer(rt)) {
            p.ty = rt;
            return;
        }
        if (p.kind == ND_SUB && is_pointer(lt) && is_int_ty(rt)) {
            p.ty = lt;
            return;
        }
        if (p.kind == ND_SUB && is_pointer(lt) && is_pointer(rt)) {
            if (types_equal(lt, rt)) {
                p.ty = ty_int;
                return;
            }
        }
        if (!is_int_ty(lt) || !is_int_ty(rt)) {
            error("arithmetic requires int operands");
        }
        p.ty = ty_int;
        return;
    }
    if (p.kind == ND_MUL || p.kind == ND_DIV || p.kind == ND_MOD) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        rhs: *Node = expect_node(p.rhs, "missing rhs");
        if (!is_int_ty(decay(lhs.ty)) || !is_int_ty(decay(rhs.ty))) {
            error("arithmetic requires int operands");
        }
        p.ty = ty_int;
        return;
    }
    if (p.kind == ND_EQ || p.kind == ND_NE) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        rhs: *Node = expect_node(p.rhs, "missing rhs");
        lt: ?*Type = decay(lhs.ty);
        rt: ?*Type = decay(rhs.ty);
        if (!types_equal(lt, rt)) {
            if (bind_null_to_pointer(lt, rhs) || bind_null_to_pointer(rt, lhs)) {
            } else {
                if (is_any_pointer(lt) && is_any_pointer(rt) && types_equal(type_base(lt), type_base(rt))) {
                } else {
                    error("comparison type mismatch");
                }
            }
        }
        p.ty = ty_bool;
        return;
    }
    if (p.kind == ND_LT || p.kind == ND_LE || p.kind == ND_GT || p.kind == ND_GE) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        rhs: *Node = expect_node(p.rhs, "missing rhs");
        if (!types_equal(decay(lhs.ty), decay(rhs.ty))) {
            error("comparison type mismatch");
        }
        p.ty = ty_bool;
        return;
    }
    if (p.kind == ND_LOGAND || p.kind == ND_LOGOR) {
        return;
    }
    if (p.kind == ND_NOT) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        if (!is_bool_ty(decay(lhs.ty))) {
            error("! requires bool");
        }
        p.ty = ty_bool;
        return;
    }
    if (p.kind == ND_NEG) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        if (!is_int_ty(decay(lhs.ty))) {
            error("unary - requires int");
        }
        p.ty = ty_int;
        return;
    }
    if (p.kind == ND_ASSIGN) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        rhs: *Node = expect_node(p.rhs, "missing rhs");
        lt: ?*Type = null;
        storage: ?*Type = lhs.ty;
        if (lhs.kind == ND_VAR) {
            lv: ?*Obj = lhs.var;
            if (lv != null) {
                storage = lv.ty;
                lt = decay(lv.ty);
            } else {
                lt = decay(lhs.ty);
            }
        } else {
            lt = decay(lhs.ty);
        }
        if (is_array(storage)) {
            error("cannot assign to array");
        }
        if (!assignable(lt, rhs)) {
            error("assignment type mismatch");
        }
        p.ty = storage;
        return;
    }
    if (p.kind == ND_AS || p.kind == ND_TRUNC) {
        return;
    }
    if (p.kind == ND_ADDR) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        if (is_array(lhs.ty)) {
            p.ty = ptr_to(type_base(lhs.ty));
        } else {
            p.ty = ptr_to(expect_type(lhs.ty, "missing type"));
        }
        return;
    }
    if (p.kind == ND_DEREF) {
        lhs: *Node = expect_node(p.lhs, "missing lhs");
        t: ?*Type = decay(lhs.ty);
        if (is_opt_pointer(t)) {
            error("dereferencing optional pointer (use if (p != null) / while (p != null) to narrow)");
        }
        if (is_pointer(t)) {
            p.ty = type_base(t);
        } else {
            error("dereferencing non-pointer");
        }
        return;
    }
    if (p.kind == ND_MEMBER) {
        mem: ?*Member = p.member;
        if (mem != null) {
            if (mem.ty != null) {
                p.ty = mem.ty;
            } else {
                p.ty = ty_int;
            }
        }
        return;
    }
    if (p.kind == ND_FUNCALL) {
        fo: ?*Obj = find_obj(globals, expect_str(p.funcname, "missing funcname"));
        if (fo != null) {
            if (fo.is_func != 0) {
                p.ty = fo.ty;
            } else {
                p.ty = ty_int;
            }
        } else {
            p.ty = ty_int;
        }
        fno: ?*Function = find_function(expect_str(p.funcname, "missing funcname"));
        if (fno != null) {
            a = p.args;
            ai: int = 0;
            while (a != null) {
                if (ai < fno.nparams) {
                    po: ?*Obj = null;
                    if (ai == 0) { po = fno.p0; }
                    if (ai == 1) { po = fno.p1; }
                    if (ai == 2) { po = fno.p2; }
                    if (ai == 3) { po = fno.p3; }
                    if (ai == 4) { po = fno.p4; }
                    if (ai == 5) { po = fno.p5; }
                    if (po != null) {
                        if (po.ty != null) {
                            pt: ?*Type = decay(po.ty);
                            if (!assignable(pt, a)) {
                                error("argument type mismatch");
                            }
                        }
                    }
                }
                ai = ai + 1;
                a = a.next;
            }
        }
        return;
    }
    if (p.kind == ND_RETURN) {
        if (p.lhs != null) {
            if (current_return_ty == null) {
                error("return with a value in a non-returning function");
            }
            rt: ?*Type = decay(current_return_ty);
            if (!assignable(rt, p.lhs)) {
                error("return type mismatch");
            }
        } else {
            if (current_return_ty != null) {
                error("return missing a value");
            }
        }
        return;
    }
    if (p.kind == ND_IF || p.kind == ND_WHILE) {
        return;
    }
    if (p.kind == ND_VARIANT_LIT) {
        return;
    }
    if (p.kind == ND_MATCH) {
        return;
    }
    if (p.kind == ND_MATCH_ARM) {
        return;
    }
}

parse_mul(): *Node {
    n: *Node = parse_unary();
    while (true) {
        if (equal(TokKind.Star)) {
            tok = tok.next;
            n = new_binary(ND_MUL, n, parse_unary());
        } else {
            if (equal(TokKind.Slash)) {
                tok = tok.next;
                n = new_binary(ND_DIV, n, parse_unary());
            } else {
                if (equal(TokKind.Percent)) {
                    tok = tok.next;
                    n = new_binary(ND_MOD, n, parse_unary());
                } else {
                    return n;
                }
            }
        }
    }
    return n;
}

parse_add(): *Node {
    n: *Node = parse_mul();
    while (true) {
        if (equal(TokKind.Plus)) {
            tok = tok.next;
            n = new_binary(ND_ADD, n, parse_mul());
        } else {
            if (equal(TokKind.Minus)) {
                tok = tok.next;
                n = new_binary(ND_SUB, n, parse_mul());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_relational(): *Node {
    n: *Node = parse_add();
    while (true) {
        if (equal(TokKind.Lt)) {
            tok = tok.next;
            n = new_binary(ND_LT, n, parse_add());
        } else {
            if (equal(TokKind.Gt)) {
                tok = tok.next;
                n = new_binary(ND_GT, n, parse_add());
            } else {
                if (equal(TokKind.Le)) {
                    tok = tok.next;
                    n = new_binary(ND_LE, n, parse_add());
                } else {
                    if (equal(TokKind.Ge)) {
                        tok = tok.next;
                        n = new_binary(ND_GE, n, parse_add());
                    } else {
                        return n;
                    }
                }
            }
        }
    }
    return n;
}

parse_equality(): *Node {
    n: *Node = parse_relational();
    while (true) {
        if (equal(TokKind.Eq)) {
            tok = tok.next;
            n = new_binary(ND_EQ, n, parse_relational());
        } else {
            if (equal(TokKind.Ne)) {
                tok = tok.next;
                n = new_binary(ND_NE, n, parse_relational());
            } else {
                return n;
            }
        }
    }
    return n;
}

parse_logand(): *Node {
    n: *Node = parse_equality();
    while (equal(TokKind.And)) {
        tok = tok.next;
        n = new_binary(ND_LOGAND, n, parse_equality());
    }
    return n;
}

parse_logor(): *Node {
    n: *Node = parse_logand();
    while (equal(TokKind.Or)) {
        tok = tok.next;
        n = new_binary(ND_LOGOR, n, parse_logand());
    }
    return n;
}

parse_assign(): *Node {
    n: *Node = parse_logor();
    if (equal(TokKind.Assign)) {
        tok = tok.next;
        return new_binary(ND_ASSIGN, n, parse_assign());
    }
    return n;
}

parse_type_suffix(ty: *Type): *Type {
    if (equal(TokKind.LBrack)) {
        tok = tok.next;
        if (!equal(TokKind.Num)) {
            error("expected array size");
        }
        ty = array_of(ty, tok.val);
        tok = tok.next;
        skip(TokKind.RBrack);
    }
    return ty;
}

parse_decl(is_local: int): *Obj {
    if (!equal(TokKind.Ident)) {
        error("expected identifier");
    }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Colon);
    ty: *Type = parse_type();
    ty = parse_type_suffix(ty);
    o: *Obj = new_obj(name, is_local);
    o.ty = ty;
    return o;
}

parse_compound(): *Node {
    n: *Node = new_node(ND_BLOCK);
    enter_scope();
    skip(TokKind.LBrace);
    head: ?*Node = null;
    cur: ?*Node = null;
    while (!equal(TokKind.RBrace)) {
        if (equal(TokKind.Eof)) {
            error("unterminated block");
        }
        s: *Node = parse_stmt();
        if (cur != null) {
            cur.next = s;
            cur = s;
        } else {
            head = s;
            cur = s;
        }
    }
    n.body = head;
    skip(TokKind.RBrace);
    leave_scope();
    return n;
}

parse_stmt(): *Node {
    n: *Node = uninitialized;
    if (equal(TokKind.Return)) {
        n = new_node(ND_RETURN);
        tok = tok.next;
        if (!equal(TokKind.Semi)) {
            n.lhs = parse_expr();
        }
        skip(TokKind.Semi);
        return n;
    }
    if (equal(TokKind.If)) {
        n = new_node(ND_IF);
        tok = tok.next;
        skip(TokKind.LParen);
        n.cond = parse_expr();
        skip(TokKind.RParen);
        save: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(n.cond);
        n.then = parse_stmt();
        narrow_reset(save);
        if (equal(TokKind.Else)) {
            tok = tok.next;
            narrow_push_eq_nulls(n.cond);
            n.els = parse_stmt();
            narrow_reset(save);
        }
        return n;
    }
    if (equal(TokKind.While)) {
        n = new_node(ND_WHILE);
        tok = tok.next;
        skip(TokKind.LParen);
        n.cond = parse_expr();
        skip(TokKind.RParen);
        save2: ?*NarrowFrame = narrow_top;
        narrow_push_ne_nulls(n.cond);
        n.body = parse_stmt();
        narrow_reset(save2);
        return n;
    }
    if (equal(TokKind.Match)) {
        n = new_node(ND_MATCH);
        tok = tok.next;
        n.cond = parse_expr();
        add_type(n.cond);
        et: ?*Type = decay((expect_node(n.cond, "missing cond")).ty);
        if (!is_enum_ty(et)) {
            error("match requires an enum value");
        }
        skip(TokKind.LBrace);
        arms: ?*Node = null;
        acur: ?*Node = null;
        while (!equal(TokKind.RBrace)) {
            if (!equal(TokKind.Ident)) {
                error("expected variant name in match arm");
            }
            vname: *i8 = cur_tokstr();
            tok = tok.next;
            arm: *Node = new_node(ND_MATCH_ARM);
            arm.next = null;
            arm.ty = et;
            is_wild: bool = streq(vname, "_");
            b: ?*Node = null;
            if (equal(TokKind.LParen)) {
                if (is_wild) {
                    error("wildcard match arm cannot bind a payload");
                }
                tok = tok.next;
                if (!equal(TokKind.Ident)) {
                    error("expected payload binding name");
                }
                bn: *Node = new_node(ND_VAR);
                bn.funcname = cur_tokstr();
                tok = tok.next;
                skip(TokKind.RParen);
                arm.args = bn;
                arm.val = 1;
            } else {
                if (equal(TokKind.LBrace)) {
                    if (is_wild) {
                        error("wildcard match arm cannot bind fields");
                    }
                    tok = tok.next;
                    bhead: ?*Node = null;
                    bcur: ?*Node = null;
                    while (!equal(TokKind.RBrace)) {
                        if (bcur != null) {
                            skip(TokKind.Comma);
                        }
                        if (!equal(TokKind.Ident)) {
                            error("expected field binding");
                        }
                        bn: *Node = new_node(ND_VAR);
                        bn.funcname = cur_tokstr();
                        tok = tok.next;
                        if (bcur != null) {
                            bcur.next = bn;
                            bcur = bn;
                        } else {
                            bhead = bn;
                            bcur = bn;
                        }
                    }
                    tok = tok.next;
                    arm.args = bhead;
                }
            }
            skip(TokKind.Arrow);
            enter_scope();
            if (is_wild) {
                chk: ?*Node = arms;
                while (chk != null) {
                    if (chk.variant == null) {
                        error("duplicate wildcard match arm");
                    }
                    chk = chk.next;
                }
                arm.variant = null;
            } else {
                vo: ?*Variant = find_variant(type_enum_def(et), vname);
                if (vo == null) {
                    error("unknown variant");
                }
                v: *Variant = expect_variant(vo, "null variant");
                chk: ?*Node = arms;
                while (chk != null) {
                    if (chk.variant == v) {
                        error("duplicate match arm");
                    }
                    chk = chk.next;
                }
                arm.variant = v;
                if (arm.val != 0) {
                    if (v.payload_ty == null) {
                        error("unit variant cannot bind a payload");
                    }
                    args0: *Node = expect_node(arm.args, "missing args");
                    po: *Obj = new_obj(expect_str(args0.funcname, "missing funcname"), 1);
                    po.ty = v.payload_ty;
                    args0.var = po;
                    args0.ty = v.payload_ty;
                    args0.member = null;
                } else {
                    if (v.fields != null) {
                        if (arm.args == null) {
                            error("payload variant requires Name(x) or Name { fields } before ->");
                        }
                        b = arm.args;
                        while (b != null) {
                            m: ?*Member = null;
                            x: ?*Member = v.fields;
                            while (x != null) {
                                if (streq(x.name, expect_str(b.funcname, "missing funcname"))) {
                                    m = x;
                                }
                                x = x.next;
                            }
                            if (m == null) {
                                error("unknown field in variant");
                            }
                            mu: *Member = expect_member(m, "null member");
                            o2: ?*Node = arm.args;
                            while (o2 != null) {
                                if (o2 == b) {
                                    o2 = null;
                                } else {
                                    if (o2.member == mu) {
                                        error("duplicate binding");
                                    }
                                    o2 = o2.next;
                                }
                            }
                            fo: *Obj = new_obj(expect_str(b.funcname, "missing funcname"), 1);
                            fo.ty = mu.ty;
                            b.var = fo;
                            b.member = mu;
                            b.ty = mu.ty;
                            b = b.next;
                        }
                        m2: ?*Member = v.fields;
                        while (m2 != null) {
                            found: int = 0;
                            b = arm.args;
                            while (b != null) {
                                if (b.member == m2) {
                                    found = 1;
                                }
                                b = b.next;
                            }
                            if (found == 0) {
                                error("match arm missing binding");
                            }
                            m2 = m2.next;
                        }
                    } else {
                        if (arm.args != null) {
                            error("unit variant takes no bindings");
                        }
                    }
                }
            }
            arm.body = parse_compound();
            leave_scope();
            if (acur != null) {
                acur.next = arm;
                acur = arm;
            } else {
                arms = arm;
                acur = arm;
            }
            if (is_wild) {
                if (!equal(TokKind.RBrace)) {
                    error("wildcard `_` must be the last match arm");
                }
            }
        }
        has_wild: int = 0;
        walk: ?*Node = arms;
        while (walk != null) {
            if (walk.variant == null) {
                has_wild = 1;
            }
            walk = walk.next;
        }
        if (has_wild == 0) {
            vv: ?*Variant = type_enum_def(et).variants;
            while (vv != null) {
                found2: int = 0;
                walk2: ?*Node = arms;
                while (walk2 != null) {
                    if (walk2.variant == vv) {
                        found2 = 1;
                    }
                    walk2 = walk2.next;
                }
                if (found2 == 0) {
                    error("match not exhaustive");
                }
                vv = vv.next;
            }
        }
        n.body = arms;
        tok = tok.next;
        return n;
    }
    if (equal(TokKind.LBrace)) {
        return parse_compound();
    }
    if (equal(TokKind.Ident) && (tok.next).kind == TokKind.Colon) {
        o: *Obj = parse_decl(1);
        if (equal(TokKind.Comma)) {
            error("only one variable per declaration");
        }
        skip(TokKind.Assign);
        if (equal(TokKind.Uninitialized)) {
            tok = tok.next;
            skip(TokKind.Semi);
            return new_node(ND_BLOCK);
        }
        rhs: *Node = parse_expr();
        skip(TokKind.Semi);
        lhs: *Node = new_node(ND_VAR);
        lhs.var = o;
        lhs.ty = o.ty;
        as_node: *Node = new_binary(ND_ASSIGN, lhs, rhs);
        es: *Node = new_node(ND_EXPR_STMT);
        es.lhs = as_node;
        return es;
    }
    n = new_node(ND_EXPR_STMT);
    n.lhs = parse_expr();
    skip(TokKind.Semi);
    return n;
}

fn_param(fn: *Function, i: int): ?*Obj {
    if (i == 0) { return fn.p0; }
    if (i == 1) { return fn.p1; }
    if (i == 2) { return fn.p2; }
    if (i == 3) { return fn.p3; }
    if (i == 4) { return fn.p4; }
    return fn.p5;
}

set_fn_param(fn: *Function, i: int, p: *Obj) {
    if (i == 0) { fn.p0 = p; }
    if (i == 1) { fn.p1 = p; }
    if (i == 2) { fn.p2 = p; }
    if (i == 3) { fn.p3 = p; }
    if (i == 4) { fn.p4 = p; }
    if (i == 5) { fn.p5 = p; }
}

parse_function(name: *i8): *Function {
    fn: *Function = new Function {
        name: name,
        nparams: 0,
        p0: null,
        p1: null,
        p2: null,
        p3: null,
        p4: null,
        p5: null,
        locals: null,
        body: null,
        stack_size: 0,
        return_ty: null,
        sret: null,
        next: null
    };
    locals = null;
    scope_depth = 0;
    narrow_top = null;
    skip(TokKind.LParen);
    np: int = 0;
    while (!equal(TokKind.RParen)) {
        if (np != 0) {
            skip(TokKind.Comma);
        }
        if (np >= 6) {
            error("too many parameters");
        }
        p: *Obj = parse_decl(1);
        set_fn_param(fn, np, p);
        np = np + 1;
    }
    fn.nparams = np;
    skip(TokKind.RParen);
    if (equal(TokKind.Colon)) {
        tok = tok.next;
        fn.return_ty = parse_type();
    }
    rt: ?*Type = fn.return_ty;
    if (rt != null && passes_by_ref(rt)) {
        if (fn.nparams >= 6) {
            error("too many parameters");
        }
        sret: *Obj = new_obj(".sret", 1);
        sret.ty = ptr_to(rt);
        fn.sret = sret;
    }
    fn.body = parse_compound();
    fn.locals = locals;
    return fn;
}

parse_field_list(base_offset: int): *Member {
    head: ?*Member = null;
    cur: ?*Member = null;
    offset: int = base_offset;
    while (!equal(TokKind.RBrace)) {
        if (!equal(TokKind.Ident)) {
            error("expected field name");
        }
        mname: *i8 = cur_tokstr();
        tok = tok.next;
        skip(TokKind.Colon);
        mty: *Type = parse_type();
        mty = parse_type_suffix(mty);
        m: *Member = new Member {
            name: mname,
            offset: offset,
            ty: mty,
            next: null
        };
        sz: int = type_size(mty);
        if (sz <= 0) {
            sz = 8;
        }
        offset = offset + ((sz + 7) / 8 * 8);
        if (cur != null) {
            cur.next = m;
            cur = m;
        } else {
            head = m;
            cur = m;
        }
        if (equal(TokKind.Semi) || equal(TokKind.Comma)) {
            tok = tok.next;
        } else {
            if (!equal(TokKind.RBrace)) {
                error("expected `;`, `,`, or `}` after field");
            }
        }
    }
    field_list_size = offset - base_offset;
    tok = tok.next;
    return expect_member(head, "empty members");
}

parse_variant(tag: int, enum_name: *i8): *Variant {
    if (!equal(TokKind.Ident)) {
        error("expected variant name");
    }
    v: *Variant = new Variant {
        name: cur_tokstr(),
        tag: tag,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        next: null
    };
    tok = tok.next;
    if (equal(TokKind.LBrace)) {
        tok = tok.next;
        v.fields = parse_field_list(0);
        v.payload_size = field_list_size;
        sd: *StructDef = new StructDef {
            name: variant_payload_name(enum_name, v.name),
            members: v.fields,
            size: field_list_size,
            ty: null,
            next: null
        };
        v.payload_ty = struct_type(sd);
    }
    return v;
}

parse_type_def() {
    tok = tok.next;
    if (!equal(TokKind.Ident)) {
        error("expected type name");
    }
    name: *i8 = cur_tokstr();
    tok = tok.next;
    skip(TokKind.Assign);

    if (equal(TokKind.LBrace)) {
        if (find_enum(name) != null) {
            error("redefinition of type");
        }
        sd: *StructDef = get_or_create_struct(name);
        if (sd.members != null) {
            error("redefinition of type");
        }
        tok = tok.next;
        sd.members = parse_field_list(0);
        sd.size = field_list_size;
        skip(TokKind.Semi);
        return;
    }

    stub: ?*StructDef = find_struct(name);
    if (stub != null) {
        if (stub.members != null) {
            error("redefinition of type");
        }
        remove_struct(name);
    }
    ed: *EnumDef = get_or_create_enum(name);
    if (ed.variants != null) {
        error("redefinition of type");
    }

    if (equal(TokKind.Pipe)) {
        tok = tok.next;
    }

    head: ?*Variant = null;
    cur: ?*Variant = null;
    tag: int = 0;
    max_payload: int = 0;
    done: int = 0;
    while (done == 0) {
        v: *Variant = parse_variant(tag, name);
        x: ?*Variant = head;
        while (x != null) {
            if (streq(x.name, v.name)) {
                error("duplicate variant");
            }
            x = x.next;
        }
        if (v.payload_size > max_payload) {
            max_payload = v.payload_size;
        }
        if (cur != null) {
            cur.next = v;
            cur = v;
        } else {
            head = v;
            cur = v;
        }
        tag = tag + 1;
        if (equal(TokKind.Pipe)) {
            tok = tok.next;
        } else {
            done = 1;
        }
    }
    if (head == null) {
        error("enum type needs at least one variant");
    }
    ed.variants = head;
    ed.size = 8 + max_payload;
    if (stub != null) {
        if (stub.ty != null) {
            rebind_struct_stub_to_enum(stub, ed);
        }
    }
    skip(TokKind.Semi);
}

parse_program() {
    tail: ?*Function = null;
    functions = null;
    while (!equal(TokKind.Eof)) {
        if (equal(TokKind.TypeKw) && (tok.next).kind == TokKind.Ident && ((tok.next).next).kind == TokKind.Assign) {
            parse_type_def();
        } else {
            if (!equal(TokKind.Ident)) {
                error("expected identifier");
            }
            name: *i8 = cur_tokstr();
            tok = tok.next;
            if (equal(TokKind.LParen)) {
                fn: *Function = parse_function(name);
                if (tail != null) {
                    tail.next = fn;
                    tail = fn;
                } else {
                    functions = fn;
                    tail = fn;
                }
                o: *Obj = new_obj(name, 0);
                o.is_func = 1;
                o.ty = fn.return_ty;
            } else {
                skip(TokKind.Colon);
                ty: *Type = parse_type();
                ty = parse_type_suffix(ty);
                if (equal(TokKind.Comma)) {
                    error("only one variable per declaration");
                }
                o2: *Obj = new_obj(name, 0);
                o2.ty = ty;
                skip(TokKind.Semi);
            }
        }
    }
}

new_label(): int {
    l: int = label_id;
    label_id = label_id + 1;
    return l;
}

is_byte_ty(t: ?*Type): bool {
    return t != null && type_size(t) == 1;
}

load_mem(ty: ?*Type) {
    if (is_byte_ty(ty)) {
        emit("  movzb (%rax), %rax\n");
    } else {
        emit("  mov (%rax), %rax\n");
    }
}

store_mem(ty: ?*Type) {
    if (is_byte_ty(ty)) {
        emit("  mov %al, (%rdi)\n");
    } else {
        emit("  mov %rax, (%rdi)\n");
    }
}

emit_memcpy(sz: int) {
    if (sz <= 0) {
        sz = 8;
    }
    i: int = 0;
    while (i < sz) {
        emit("  movzb ");
        emit_num(i);
        emit("(%rsi), %rax\n");
        emit("  mov %al, ");
        emit_num(i);
        emit("(%rdi)\n");
        i = i + 1;
    }
}

gen_struct_inits(inits: ?*Node) {
    init: ?*Node = inits;
    while (init != null) {
        if (init.lhs != null) {
            mem: *Member = expect_member(init.member, "missing member");
            emit("  mov (%rsp), %rax\n");
            if (mem.offset != 0) {
                emit("  add $");
                emit_num(mem.offset);
                emit(", %rax\n");
            }
            emit("  push %rax\n");
            gen_expr(expect_node(init.lhs, "missing lhs"));
            emit("  pop %rdi\n");
            mty: *Type = ty_int;
            if (mem.ty != null) {
                mty = expect_type(mem.ty, "missing type");
            }
            store_mem(mty);
        }
        init = init.next;
    }
}

gen_variant_inits(inits: ?*Node) {
    init: ?*Node = inits;
    while (init != null) {
        if (init.lhs != null) {
            mem: *Member = expect_member(init.member, "missing member");
            emit("  mov (%rsp), %rax\n");
            emit("  add $");
            emit_num(enum_field_offset(mem));
            emit(", %rax\n");
            emit("  push %rax\n");
            gen_expr(expect_node(init.lhs, "missing lhs"));
            emit("  pop %rdi\n");
            mty: *Type = ty_int;
            if (mem.ty != null) {
                mty = expect_type(mem.ty, "missing type");
            }
            store_mem(mty);
        }
        init = init.next;
    }
}

gen_addr(n: *Node) {
    add_type(n);
    if (n.kind == ND_VAR) {
        if ((expect_obj(n.var, "missing var")).is_local != 0) {
            emit("  lea ");
            emit_num((expect_obj(n.var, "missing var")).offset);
            emit("(%rbp), %rax\n");
        } else {
            emit("  lea ");
            emit((expect_obj(n.var, "missing var")).name);
            emit("(%rip), %rax\n");
        }
        return;
    }
    if (n.kind == ND_DEREF) {
        gen_expr(expect_node(n.lhs, "missing lhs"));
        return;
    }
    if (n.kind == ND_MEMBER) {
        add_type(n.lhs);
        t: ?*Type = decay((expect_node(n.lhs, "missing lhs")).ty);
        if (is_pointer(t) && is_struct_ty(type_base(t))) {
            gen_expr(expect_node(n.lhs, "missing lhs"));
        } else {
            gen_addr(expect_node(n.lhs, "missing lhs"));
        }
        if ((expect_member(n.member, "missing member")).offset != 0) {
            emit("  add $");
            emit_num((expect_member(n.member, "missing member")).offset);
            emit(", %rax\n");
        }
        return;
    }
    error("not an lvalue");
}

gen_expr(n: *Node) {
    k: int = n.kind;
    add_type(n);
    if (k == ND_NUM) {
        if (n.str_label != 0) {
            emit("  lea .L.str");
            emit_num(n.str_label - 1);
            emit("+8(%rip), %rax\n");
        } else {
            emit("  mov $");
            emit_num(n.val);
            emit(", %rax\n");
        }
        return;
    }
    if (k == ND_NULL) {
        emit("  mov $0, %rax\n");
        return;
    }
    if (k == ND_VAR) {
        gen_addr(n);
        ty: *Type = expect_type(n.ty, "missing type");
        if (is_array(ty) || passes_by_ref(ty)) {
            return;
        }
        load_mem(ty);
        return;
    }
    if (k == ND_MEMBER) {
        gen_addr(n);
        ty2: *Type = expect_type(n.ty, "missing type");
        if (is_array(ty2) || passes_by_ref(ty2)) {
            return;
        }
        load_mem(ty2);
        return;
    }
    if (k == ND_ADDR) {
        gen_addr(expect_node(n.lhs, "missing lhs"));
        return;
    }
    if (k == ND_AS || k == ND_TRUNC) {
        gen_expr(expect_node(n.lhs, "missing lhs"));
        return;
    }
    if (k == ND_NEW) {
        base: *Type = type_base(n.ty);
        esz: int = type_size(base);
        if (esz <= 0) {
            esz = 8;
        }
        if (n.lhs != null) {
            gen_expr(expect_node(n.lhs, "missing lhs"));
            if (esz != 1) {
                emit("  imul $");
                emit_num(esz);
                emit(", %rax\n");
            }
            emit("  mov %rax, %rdi\n");
            emit("  call malloc\n");
            return;
        }
        emit("  mov $");
        emit_num(esz);
        emit(", %rdi\n");
        emit("  call malloc\n");
        if (n.variant != null) {
            emit("  push %rax\n");
            emit("  mov $");
            emit_num(n.val);
            emit(", %rdi\n");
            emit("  mov %rdi, (%rax)\n");
            gen_variant_inits(n.args);
            emit("  pop %rax\n");
        } else {
            if (n.val == 0) {
                emit("  push %rax\n");
                gen_struct_inits(n.args);
                emit("  pop %rax\n");
            }
        }
        return;
    }
    if (k == ND_STRUCT_LIT) {
        sz: int = type_size(n.ty);
        if (sz <= 0) {
            sz = 8;
        }
        sz = (sz + 15) / 16 * 16;
        emit("  sub $");
        emit_num(sz);
        emit(", %rsp\n");
        emit("  mov %rsp, %rax\n");
        emit("  push %rax\n");
        gen_struct_inits(n.args);
        emit("  pop %rax\n");
        return;
    }
    if (k == ND_VARIANT_LIT) {
        sz: int = type_size(n.ty);
        if (sz <= 0) {
            sz = 8;
        }
        if (sz <= 8) {
            if (n.args == null) {
                emit("  mov $");
                emit_num(n.val);
                emit(", %rax\n");
                return;
            }
            emit("  sub $16, %rsp\n");
            emit("  mov %rsp, %rax\n");
            emit("  push %rax\n");
            emit("  mov $");
            emit_num(n.val);
            emit(", %rdi\n");
            emit("  mov %rdi, (%rax)\n");
            gen_variant_inits(n.args);
            emit("  pop %rax\n");
            emit("  mov (%rax), %rax\n");
            return;
        }
        sz = (sz + 15) / 16 * 16;
        emit("  sub $");
        emit_num(sz);
        emit(", %rsp\n");
        emit("  mov %rsp, %rax\n");
        emit("  push %rax\n");
        emit("  mov $");
        emit_num(n.val);
        emit(", %rdi\n");
        emit("  mov %rdi, (%rax)\n");
        gen_variant_inits(n.args);
        emit("  pop %rax\n");
        return;
    }
    if (k == ND_DEREF) {
        gen_expr(expect_node(n.lhs, "missing lhs"));
        load_mem(expect_type(n.ty, "missing type"));
        return;
    }
    if (k == ND_ASSIGN) {
        add_type(expect_node(n.lhs, "missing lhs"));
        if ((expect_node(n.rhs, "missing rhs")).kind == ND_STRUCT_LIT && is_struct_ty((expect_node(n.lhs, "missing lhs")).ty)) {
            gen_addr(expect_node(n.lhs, "missing lhs"));
            emit("  push %rax\n");
            gen_struct_inits((expect_node(n.rhs, "missing rhs")).args);
            emit("  pop %rax\n");
            return;
        }
        if ((expect_node(n.rhs, "missing rhs")).kind == ND_VARIANT_LIT && is_enum_ty((expect_node(n.lhs, "missing lhs")).ty)) {
            gen_addr(expect_node(n.lhs, "missing lhs"));
            emit("  push %rax\n");
            emit("  mov $");
            emit_num((expect_node(n.rhs, "missing rhs")).val);
            emit(", %rdi\n");
            emit("  mov %rdi, (%rax)\n");
            gen_variant_inits((expect_node(n.rhs, "missing rhs")).args);
            emit("  pop %rax\n");
            return;
        }
        gen_expr(expect_node(n.rhs, "missing rhs"));
        emit("  push %rax\n");
        lhs: *Node = expect_node(n.lhs, "missing lhs");
        gen_addr(lhs);
        emit("  mov %rax, %rdi\n");
        emit("  pop %rsi\n");
        lhs_ty: *Type = expect_type(lhs.ty, "missing lhs type");
        if (passes_by_ref(lhs_ty)) {
            emit_memcpy(type_size(lhs_ty));
            emit("  mov %rdi, %rax\n");
        } else {
            emit("  mov %rsi, %rax\n");
            store_mem(lhs_ty);
        }
        return;
    }
    if (k == ND_NOT) {
        gen_expr(expect_node(n.lhs, "missing lhs"));
        emit("  cmp $0, %rax\n");
        emit("  sete %al\n");
        emit("  movzb %al, %rax\n");
        return;
    }
    if (k == ND_NEG) {
        gen_expr(expect_node(n.lhs, "missing lhs"));
        emit("  neg %rax\n");
        return;
    }
    if (k == ND_LOGAND) {
        l: int = new_label();
        gen_expr(expect_node(n.lhs, "missing lhs"));
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        gen_expr(expect_node(n.rhs, "missing rhs"));
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_LOGOR) {
        l = new_label();
        gen_expr(expect_node(n.lhs, "missing lhs"));
        emit("  cmp $0, %rax\n");
        emit("  jne .L.true"); emit_num(l); emit("\n");
        gen_expr(expect_node(n.rhs, "missing rhs"));
        emit("  cmp $0, %rax\n");
        emit("  je .L.false"); emit_num(l); emit("\n");
        emit(".L.true"); emit_num(l); emit(":\n");
        emit("  mov $1, %rax\n");
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.false"); emit_num(l); emit(":\n");
        emit("  mov $0, %rax\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_FUNCALL) {
        fno: ?*Function = find_function(expect_str(n.funcname, "missing funcname"));
        has_sret: int = 0;
        if (fno != null) {
            if (fno.sret != null) {
                has_sret = 1;
            }
        }
        nargs: int = 0;
        a: ?*Node = n.args;
        while (a != null) {
            nargs = nargs + 1;
            a = a.next;
        }
        nregs: int = nargs + has_sret;
        if (nregs > 6) {
            error("too many arguments");
        }
        if (has_sret != 0) {
            sz: int = type_size((expect_function(fno, "missing function")).return_ty);
            if (sz <= 0) {
                sz = 8;
            }
            sz = (sz + 15) / 16 * 16;
            emit("  sub $");
            emit_num(sz);
            emit(", %rsp\n");
            emit("  mov %rsp, %rax\n");
            emit("  push %rax\n");
        }
        a = n.args;
        while (a != null) {
            gen_expr(a);
            emit("  push %rax\n");
            a = a.next;
        }
        i: int = nregs - 1;
        while (i >= 0) {
            emit("  pop ");
            emit(reg_name(i));
            emit("\n");
            i = i - 1;
        }
        emit("  sub $8, %rsp\n");
        emit("  call ");
        emit(expect_str(n.funcname, "missing funcname"));
        emit("\n");
        emit("  add $8, %rsp\n");
        return;
    }

    gen_expr(expect_node(n.lhs, "missing lhs"));
    emit("  push %rax\n");
    gen_expr(expect_node(n.rhs, "missing rhs"));
    emit("  mov %rax, %rdi\n");
    emit("  pop %rax\n");

    if (k == ND_ADD) { emit("  add %rdi, %rax\n"); return; }
    if (k == ND_SUB) { emit("  sub %rdi, %rax\n"); return; }
    if (k == ND_MUL) { emit("  imul %rdi, %rax\n"); return; }
    if (k == ND_DIV) { emit("  cqo\n"); emit("  idiv %rdi\n"); return; }
    if (k == ND_MOD) {
        emit("  cqo\n"); emit("  idiv %rdi\n"); emit("  mov %rdx, %rax\n"); return;
    }
    if (k == ND_EQ) {
        emit("  cmp %rdi, %rax\n"); emit("  sete %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_NE) {
        emit("  cmp %rdi, %rax\n"); emit("  setne %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_LT) {
        emit("  cmp %rdi, %rax\n"); emit("  setl %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_LE) {
        emit("  cmp %rdi, %rax\n"); emit("  setle %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_GT) {
        emit("  cmp %rdi, %rax\n"); emit("  setg %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    if (k == ND_GE) {
        emit("  cmp %rdi, %rax\n"); emit("  setge %al\n"); emit("  movzb %al, %rax\n"); return;
    }
    error("invalid expression");
}

gen_stmt(n: *Node) {
    add_type(n);
    k: int = n.kind;
    if (k == ND_RETURN) {
        if (n.lhs != null) {
            gen_expr(expect_node(n.lhs, "missing lhs"));
            if (current_sret != null) {
                emit("  mov %rax, %rsi\n");
                emit("  mov ");
                emit_num((expect_obj(current_sret, "missing sret")).offset);
                emit("(%rbp), %rdi\n");
                emit_memcpy(type_size(current_return_ty));
                emit("  mov %rdi, %rax\n");
            }
        } else {
            emit("  mov $0, %rax\n");
        }
        emit("  jmp .L.return.");
        emit(expect_str(current_fn_name, "missing fn name"));
        emit("\n");
        return;
    }
    if (k == ND_EXPR_STMT) {
        gen_expr(expect_node(n.lhs, "missing lhs"));
        return;
    }
    if (k == ND_BLOCK) {
        s: ?*Node = n.body;
        while (s != null) {
            gen_stmt(s);
            s = s.next;
        }
        return;
    }
    if (k == ND_IF) {
        l: int = new_label();
        gen_expr(expect_node(n.cond, "missing cond"));
        emit("  cmp $0, %rax\n");
        emit("  je .L.else"); emit_num(l); emit("\n");
        nd1: ?*NarrowFrame = narrow_from_cond(n.cond, 0);
        gen_stmt(expect_node(n.then, "missing then"));
        narrow_reset(nd1);
        emit("  jmp .L.end"); emit_num(l); emit("\n");
        emit(".L.else"); emit_num(l); emit(":\n");
        if (n.els != null) {
            nd2: ?*NarrowFrame = narrow_from_cond(n.cond, 1);
            gen_stmt(expect_node(n.els, "missing els"));
            narrow_reset(nd2);
        }
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_WHILE) {
        l = new_label();
        emit(".L.begin"); emit_num(l); emit(":\n");
        gen_expr(expect_node(n.cond, "missing cond"));
        emit("  cmp $0, %rax\n");
        emit("  je .L.end"); emit_num(l); emit("\n");
        nd3: ?*NarrowFrame = narrow_from_cond(n.cond, 0);
        gen_stmt(expect_node(n.body, "missing body"));
        narrow_reset(nd3);
        emit("  jmp .L.begin"); emit_num(l); emit("\n");
        emit(".L.end"); emit_num(l); emit(":\n");
        return;
    }
    if (k == ND_MATCH) {
        l = new_label();
        add_type(expect_node(n.cond, "missing cond"));
        if ((expect_node(n.cond, "missing cond")).kind == ND_VAR || (expect_node(n.cond, "missing cond")).kind == ND_MEMBER || (expect_node(n.cond, "missing cond")).kind == ND_DEREF) {
            gen_addr(expect_node(n.cond, "missing cond"));
        } else {
            gen_expr(expect_node(n.cond, "missing cond"));
        }
        emit("  push %rax\n");
        emit("  mov (%rax), %rax\n");
        emit("  push %rax\n");
        arm: ?*Node = n.body;
        while (arm != null) {
            la: int = new_label();
            if (arm.variant != null) {
                emit("  mov (%rsp), %rax\n");
                emit("  cmp $");
                emit_num((expect_variant(arm.variant, "missing variant")).tag);
                emit(", %rax\n");
                emit("  jne .L.arm");
                emit_num(la);
                emit("\n");
            }
            b: ?*Node = arm.args;
            while (b != null) {
                if (b.member == null) {
                    psz: int = (expect_variant(arm.variant, "missing variant")).payload_size;
                    emit("  mov 8(%rsp), %rsi\n");
                    emit("  add $8, %rsi\n");
                    emit("  lea ");
                    emit_num((expect_obj(b.var, "missing bind var")).offset);
                    emit("(%rbp), %rdi\n");
                    emit_memcpy(psz);
                } else {
                    emit("  mov 8(%rsp), %rax\n");
                    emit("  add $");
                    emit_num(enum_field_offset(expect_member(b.member, "missing member")));
                    emit(", %rax\n");
                    bty: *Type = ty_int;
                    if ((expect_member(b.member, "missing member")).ty != null) {
                        bty = expect_type((expect_member(b.member, "missing member")).ty, "missing member type");
                    }
                    load_mem(bty);
                    emit("  mov %rax, ");
                    emit_num((expect_obj(b.var, "missing bind var")).offset);
                    emit("(%rbp)\n");
                }
                b = b.next;
            }
            gen_stmt(expect_node(arm.body, "missing body"));
            emit("  jmp .L.matchend");
            emit_num(l);
            emit("\n");
            if (arm.variant != null) {
                emit(".L.arm");
                emit_num(la);
                emit(":\n");
            }
            arm = arm.next;
        }
        emit("  mov $1, %rdi\n");
        emit("  call exit\n");
        emit(".L.matchend");
        emit_num(l);
        emit(":\n");
        emit("  add $16, %rsp\n");
        return;
    }
    error("invalid statement");
}

assign_lvar_offsets(fn: *Function) {
    off: int = 0;
    v: ?*Obj = fn.locals;
    while (v != null) {
        sz: int = type_size(v.ty);
        if (sz <= 0) {
            sz = 8;
        }
        if (!is_array(v.ty)) {
            if (sz < 8) {
                sz = 8;
            }
        } else {
            sz = (sz + 7) / 8 * 8;
        }
        off = off + sz;
        v.offset = 0 - off;
        v = v.next;
    }
    fn.stack_size = (off + 15) / 16 * 16;
}

emit_data() {
    g: ?*Obj = globals;
    emit(".section .bss\n");
    emit(".align 8\n");
    while (g != null) {
        if (g.is_func == 0) {
            sz: int = 8;
            if (g.ty != null) {
                sz = type_size(g.ty);
            }
            if (sz <= 0) {
                sz = 8;
            }
            emit(g.name);
            emit(": .skip ");
            emit_num(sz);
            emit("\n");
        }
        g = g.next;
    }
    emit(".section .rodata\n");
    emit(".align 8\n");
    i: int = 0;
    while (i < str_count) {
        s: ?*StrLit = str_lits;
        found: ?*StrLit = null;
        while (s != null) {
            if (s.label == i) {
                found = s;
            }
            if (found == null) {
                s = s.next;
            } else {
                s = null;
            }
        }
        if (found != null) {
            emit(".L.str");
            emit_num(i);
            emit(":\n");
            emit("  .quad ");
            emit_num(found.len);
            emit("\n");
            emit("  .byte ");
            j: int = 0;
            while (j < found.len) {
                if (j != 0) {
                    emit(",");
                }
                emit_num(found.data[j] as int);
                j = j + 1;
            }
            if (found.len == 0) {
                emit("0");
            } else {
                emit(",0");
            }
            emit("\n");
        }
        i = i + 1;
    }
}

emit_text() {
    fn: ?*Function = functions;
    emit(".section .text\n");
    while (fn != null) {
        assign_lvar_offsets(fn);
        current_fn_name = fn.name;
        current_return_ty = fn.return_ty;
        current_sret = fn.sret;
        emit(".globl ");
        emit(fn.name);
        emit("\n");
        emit(fn.name);
        emit(":\n");
        emit("  push %rbp\n");
        emit("  mov %rsp, %rbp\n");
        emit("  sub $");
        emit_num(fn.stack_size);
        emit(", %rsp\n");
        ri: int = 0;
        if (fn.sret != null) {
            emit("  mov ");
            emit(reg_name(ri));
            emit(", ");
            emit_num((expect_obj(fn.sret, "missing sret")).offset);
            emit("(%rbp)\n");
            ri = ri + 1;
        }
        i: int = 0;
        while (i < fn.nparams) {
            po: ?*Obj = fn_param(fn, i);
            p: *Obj = expect_obj(po, "null obj");
            pty: *Type = expect_type(p.ty, "missing param type");
            if (passes_by_ref(pty)) {
                emit("  mov ");
                emit(reg_name(ri));
                emit(", %rsi\n");
                emit("  lea ");
                emit_num(p.offset);
                emit("(%rbp), %rdi\n");
                emit_memcpy(type_size(pty));
            } else {
                emit("  mov ");
                emit(reg_name(ri));
                emit(", ");
                emit_num(p.offset);
                emit("(%rbp)\n");
            }
            ri = ri + 1;
            i = i + 1;
        }
        gen_stmt(expect_node(fn.body, "missing body"));
        emit(".L.return.");
        emit(fn.name);
        emit(":\n");
        emit("  mov %rbp, %rsp\n");
        emit("  pop %rbp\n");
        emit("  ret\n");
        fn = fn.next;
    }
}

codegen() {
    emit_data();
    emit_text();
}

main(argc: int, argv: **i8): int {
    if (argc != 2) {
        error("usage: l8c <file.l8>");
    }
    path: *i8 = (argv + 8).*;
    init_kinds();
    init_dummies();
    source = read_file(path);
    tok = tokenize();
    parse_program();
    codegen();
    return 0;
}
