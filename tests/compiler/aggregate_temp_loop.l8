tag example;

import "../../stdlib/print.l8";

/* Aggregate literals evaluated in expressions use fixed frame storage. The
   pending left operand of `+` must survive, and loops must not grow the stack. */
type Big = {
    a: int;
    b: int;
    c: int;
    d: int
}

type Shape =
    | Dot
    | Box { w: int, h: int }

total(x: Big): int {
    x.a + x.b + x.c + x.d
}

area(s: Shape): int {
    match s {
        Dot -> 0;
        Box b -> b.w * b.h
    }
}

main(): int {
    sum: int = 0;
    i: int = 0;
    while (i < 1000000) {
        sum = sum + total(Big {
            a: i,
            b: 1,
            c: 2,
            d: 3
        });
        sum = sum + area(Shape.Box { w: 2, h: 3 });
        row: [4]int = [i, 1, 2, 3];
        sum = sum + row[0] - i;
        i = i + 1
    }
    if (sum != 499999500000 + 12000000) return 1;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
