tag nested_index_test;

import "../../stdlib/print.l8";

ni_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

// Not a constant, so the compiler cannot tell where an index points.
ni_at(i: int): int {
    i
}

// An interpreter's operand addresses are a frame base plus an element read
// from its code, as in vals[fp + code[pc]]. Native code computes such an
// index without spilling the value being stored, and checks both indexes.
// The loop makes pc, fp, vals and code register candidates; pc advances in
// place.
ni_copy(vals: []int, code: []int, fp: int): int {
    pc: int = 0;
    while (pc < len(code)) {
        vals[fp + code[pc + 1]] = vals[fp + code[pc]];
        pc = pc + 2
    }
    vals[fp + code[1]]
}

// Every loop exit leaves the registers it updated in place correct.
ni_steps(limit: int): int {
    total: int = 0;
    step: int = 0;
    while (true) {
        if (step >= limit)
            break;
        step = step + 3;
        if (step == 6)
            continue;
        total = total + step;
        total = total - 1
    }
    total * 100 + step
}

test "copies addressed through an element read" {
    vals: []int = [0, 0, 5, 6, 7, 8];
    // vals[2 + 3] = vals[2 + 0]; vals[2 + 2] = vals[2 + 1].
    code: []int = [0, 3, 1, 2];
    ni_show("ni_copy", ni_copy(vals, code, 2));
    ni_show("vals[4]", vals[4]);
    expect {|
        ni_copy: 5
        vals[4]: 6
    |}
}

test "an assignment's value survives its nested store" {
    vals: []int = [1, 2, 3];
    code: []int = [2, 0];
    base: int = ni_at(0);
    value: int = (vals[base + code[ni_at(1)]] = 40) + 2;
    ni_show("value", value);
    ni_show("vals[0]", vals[0]);
    expect {|
        value: 42
        vals[0]: 40
    |}
}

test "narrow elements store at their width" {
    bytes: []i8 = [1i8, 2i8, 3i8, 4i8];
    code: []int = [2];
    bytes[ni_at(1) + code[0]] = 9i8;
    ni_show("bytes[2]", bytes[2] as int);
    ni_show("bytes[3]", bytes[3] as int);
    expect {|
        bytes[2]: 3
        bytes[3]: 9
    |}
}

test "register steps and loop exits" {
    ni_show("ni_steps(10)", ni_steps(10));
    expect {|
        ni_steps(10): 2112
    |}
}

test "an inner index past the end exits" {
    vals: []int = [1, 2, 3];
    code: []int = [0];
    vals[ni_at(0) + code[ni_at(1)]] = 5;
    expect {|
        [exit 1]
    |}
}

test "an outer index past the end exits" {
    vals: []int = [1, 2, 3];
    code: []int = [3];
    ni_show("load", vals[ni_at(0) + code[0]]);
    expect {|
        [exit 1]
    |}
}
