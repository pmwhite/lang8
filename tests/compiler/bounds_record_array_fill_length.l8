tag bounds_test;

import "../../stdlib/print.l8";

type Cell = {
    value: int
}

type Buffer = {
    data: []Cell;
    used: int
} invariant (0 <= used && used <= len(data))

main(): int {
    capacity: int = 4;
    data: []Cell = new Cell[capacity](Cell { value: 0 });
    buffer: Buffer = Buffer { data: data, used: capacity };
    buffer.data[buffer.used - 1].value
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
