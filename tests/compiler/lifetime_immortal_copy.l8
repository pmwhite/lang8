tag example;

import "../../stdlib/print.l8";

type Box = {
    n: int
}

type Shape =
    | One { item: *Box }
    | None

kept: ?*Box = null;

// Copies of an @immortal parameter (a match's binding, a for's item) may be
// kept somewhere immortal: the bound written is the one they need.
keep_match(shape: Shape@immortal) {
    match shape {
        One found -> kept = found.item;
        None -> { }
    }
}

keep_last(items: []*Box@immortal) {
    for item in items kept = item
}

kept_n(): int {
    k: ?*Box = kept;
    if (k == null) return -1;
    k.n
}

test "copies of an immortal parameter may be kept" {
    keep_match(Shape.One { item: new Box { n: 7 } });
    std::print_int(kept_n());
    keep_last([new Box { n: 1 }, new Box { n: 2 }]);
    std::print_int(kept_n());
    expect {|
        7
        2
    |}
}
