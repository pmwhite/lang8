tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    a: []int = [7];
    total: int = 0;
    for i in 0..len(a) total = total + a[i];
    total
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
