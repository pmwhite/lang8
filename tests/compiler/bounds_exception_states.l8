tag bounds_test;

exception Retry;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

recover(a: []int, i: int): int {
    try {
        if (i < 0 || i >= len(a)) return 0;
        raise Retry
    } with Retry -> {
        return consume(a, i)
    }
}

checked(a: []int, i: int): int {
    try {
        value: int = a![i];
        if (value < 0) return 0
    } with IndexOutOfBounds -> {
        return 0
    }
    consume(a, i)
}

main(): int {
    a: int = recover([7], 0);
    b: int = checked([5], 0);
    c: int = checked([5], 2);
    a + b + c
}

//% test: run
//% stdout: ""
//% exit: 12
//% compiler-warnings: ["unnecessary return in recover"]
