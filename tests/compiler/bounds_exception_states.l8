tag bounds_test;

import "../../stdlib/print.l8";

exception Retry;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

recover(a: []int, i: int): int {
    try {
        if (i < 0 || i >= len(a)) return 0;
        raise Retry
    } with Retry -> {
        return consume(a, i)
    }
}

checked(a: []int, i: int): int {
    if (i < 0 || i >= len(a)) return 0;
    value: int = a[i];
    if (value < 0) return 0;
    consume(a, i)
}

main(): int {
    a: int = recover([7], 0);
    b: int = checked([5], 0);
    c: int = checked([5], 2);
    a + b + c
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 12
    |}
}

/* expect compile {|
warning: bounds_exception_states.l8:16:9: unnecessary return in recover
|} */
