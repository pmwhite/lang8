tag bounds_test;

import "../../stdlib/print.l8";

fetch(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

main(): int {
    a: []int = [7];
    fetch(a, 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
