tag bounds_test;

type Span = {
    start: int;
    end: int
}

type Spans = {
    items: []Span
} invariant (forall span in items (span.start <= span.end))

main(): int {
    zero: Span = Span { start: 0, end: 0 };
    spans: *Spans = new Spans { items: new Span[1](zero) };
    bad: Span = Span { start: 3, end: 2 };
    spans.items[0] = bad;
    0
}

//% test: compile-fail
//% error-contains: "type invariant"
