tag bounds_test;

import "../../stdlib/print.l8";

get(a: []i8, i: int): i8 {
    if (i < 0 || i >= len(a)) return 0i8;
    a[i]
}

main(): int {
    a: []i8 = ['A'];
    get(a, 4) as int
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
