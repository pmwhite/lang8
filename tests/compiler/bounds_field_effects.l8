tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    used: int;
    visits: int
}

visit(b: *Buffer) {
    b.visits = b.visits + 1
}

sum(b: *Buffer): int {
    if (b.used > len(b.data)) return -1;
    total: int = 0;
    for i in 0..b.used {
        visit(b);
        total = total + b.data[i]
    }
    total + b.visits
}

main(): int {
    b: *Buffer = new Buffer { data: [2, 3], used: 2, visits: 0 };
    sum(b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
