tag example;

type Box = {
    n: int
}

type Pair = {
    p: *Box
}

seed: *Box = new Box { n: 1 };

g: ?*Box = null;

keep(p: *Box) {
    box: Pair = Pair { p: seed };
    box.p = p;
    g = box.p
}

main(): int {
    0
}

