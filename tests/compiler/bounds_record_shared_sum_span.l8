tag bounds_test;

type Span = {
    start: int;
    end: int
} invariant (0 <= start && start <= end && end <= 4)

type Frame = {
    start: int;
    end: int
} invariant (0 <= start && start <= end && end <= 16)

frame(cells: []int, row: int, span: *Span): int requires (len(cells) >= 16 && 0 <= row && row < 4) {
    base: int = row * 4;
    view: Frame = Frame { start: base + span.start, end: base + span.end };
    view.end - view.start
}

main(): int {
    cells: []int = new int[16](0);
    span: *Span = new Span { start: 2, end: 4 };
    frame(cells, 3, span)
}

//% test: run
//% stdout: ""
//% exit: 2
