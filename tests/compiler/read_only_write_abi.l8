tag read_only_write_abi;

import "../../stdlib/write.l8";

use_tag std;

extern heap_used(): int = l8_heap_used;

test "native text span ABI and inline number buffer" {
    before: int = heap_used();
    wrote: int = raw::raw_write_text_some(1, "prefix:tail", 7, 4);
    write_byte(1, '\n');
    write_int(1, wrote);
    write_byte(1, '\n');
    write(1, "immutable text\n");
    write_int(1, 0);
    write_byte(1, '\n');
    write_int(1, 9223372036854775807);
    write_byte(1, '\n');
    write_int(1, 0 - 9223372036854775807 - 1);
    write_byte(1, '\n');
    if (heap_used() != before) write(1, "unexpected heap allocation\n");
    expect {|
        tail
        4
        immutable text
        0
        9223372036854775807
        -9223372036854775808
    |}
}

test "text span checks precede the native call" {
    write_int(1, raw::raw_write_text_some(0 - 1, "abc", 3, 0));
    write_byte(1, '\n');
    write_int(1, raw::raw_write_text_some(0 - 1, "abc", 0 - 1, 1));
    write_byte(1, '\n');
    write_int(1, raw::raw_write_text_some(0 - 1, "abc", 2, 2));
    write_byte(1, '\n');
    write_int(1, raw::raw_write_text_some(0 - 1, "abc", 4, 0));
    write_byte(1, '\n');
    expect {|
        0
        -22
        -22
        -22
    |}
}
