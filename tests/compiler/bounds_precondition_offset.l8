tag bounds_test;

import "../../stdlib/print.l8";

sixth_from(a: []int, i: int): int requires (0 <= i && i + 5 < len(a)) {
    a[i + 5]
}

main(): int {
    a: []int = [0, 1, 2, 3, 4, 5, 6];
    sixth_from(a, 1)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 6
    |}
}
