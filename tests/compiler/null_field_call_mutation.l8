tag example;

type Box = {
    value: ?*int
}

clear(box: *Box) {
    box.value = null
}

main(): int {
    x: int = 7;
    box: Box = Box { value: &x };
    if (box.value != null) {
        clear(&box);
        box.value.*
    } else 0
}

//% test: compile-fail
//% error-contains: "pointer use is not proved non-null"
