tag example;

type Box = {
    value: ?*int
}

clear(box: *Box) {
    box.value = null
}

main(): int {
    x: int = 7;
    box: Box = Box { value: &x };
    if (box.value != null) {
        clear(&box);
        box.value.*
    } else 0
}

/* expect compile {|
error: null_field_call_mutation.l8:16:13: dereferencing optional pointer (use if (p != null) / while (p != null) to narrow): ?*int
|} */
