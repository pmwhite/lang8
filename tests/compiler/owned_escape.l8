tag example;

type Box = {
    n: int
}

main(): int {
    box: owned *Box = own {
        new Box { n: 1 }
    };
    holder: *Box = new Box { n: 0 };
    borrow box {
        holder = box
    }
    drop box;
    0
}

/* expect compile {|
error: owned_escape.l8:13:9: arena pointer cannot escape in main
|} */
