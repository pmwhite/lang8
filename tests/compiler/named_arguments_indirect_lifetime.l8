tag named_arguments_rejection;

type Node = {
    child: ?*Node
}

set_child(named parent: *Node, named child: *Node@parent) {
    parent.child = child
}

main(): int {
    callback: fn(named parent: *Node, named child: *Node@parent) = &set_child;
    region {
        outer: *Node = new Node { child: null };
        region {
            inner: *Node = new Node { child: null };
            callback(child: inner, parent: outer)
        }
    }
    0
}

/* expect compile {|
error: named_arguments_indirect_lifetime.l8:17:13: region pointer cannot escape in main
|} */
