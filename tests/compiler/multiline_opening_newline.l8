import "../../stdlib/print.l8";

check_opening(text: str, count: int, opening: int) noregion raises Error: bool {
    data: []i8 = new i8[len(text) + 1](0i8);
    memcpy(data, 0, bytes(text), 0, len(text));
    token: *Token = tokenize(data, len(text));
    token.kind == TokKind.Str && token.len == count && token.pos == opening
}

// Print whether the text tokenizes to a string whose body is count bytes long
// and starts at byte opening.
opening_show(
    label: str,
    text: str,
    count: int,
    opening: int
) noregion raises Error, std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_bool(check_opening(text, count, opening))
}

test "a newline right after the opening quotes is not part of the string" {
    init_dummies();
    init_runtime();
    opening_show("CRLF, body x at 5", "\"\"\"\r\nx\"\"\"", 1, 5);
    opening_show("LF, body x at 4", "\"\"\"\nx\"\"\"", 1, 4);
    expect {|
        CRLF, body x at 5: true
        LF, body x at 4: true
    |}
    opening_show("CRLF, empty body at 5", "\"\"\"\r\n\"\"\"", 0, 5);
    opening_show("CRLF, body x CRLF y at 5", "\"\"\"\r\nx\r\ny\"\"\"", 4, 5);
    expect {|
        CRLF, empty body at 5: true
        CRLF, body x CRLF y at 5: true
    |}
}

test "other openings keep their first byte" {
    init_dummies();
    init_runtime();
    opening_show("no newline, body x at 3", "\"\"\"x\"\"\"", 1, 3);
    opening_show("lone CR, body CR x at 3", "\"\"\"\rx\"\"\"", 2, 3);
    expect {|
        no newline, body x at 3: true
        lone CR, body CR x at 3: true
    |}
}
