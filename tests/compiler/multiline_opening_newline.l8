import "../../stdlib/print.l8";

check_opening(text: str, count: int, opening: int) noregion raises Error: bool {
    data: []i8 = new i8[len(text) + 1](0i8);
    memcpy(data, 0, bytes(text), 0, len(text));
    token: *Token = tokenize(data, len(text));
    token.kind == TokKind.Str && token.len == count && token.pos == opening
}

main() noregion raises Error: int {
    init_dummies();
    init_runtime();
    if (!check_opening("\"\"\"\r\nx\"\"\"", 1, 5)) return 1;
    if (!check_opening("\"\"\"\nx\"\"\"", 1, 4)) return 2;
    if (!check_opening("\"\"\"x\"\"\"", 1, 3)) return 3;
    if (!check_opening("\"\"\"\rx\"\"\"", 2, 3)) return 4;
    if (!check_opening("\"\"\"\r\n\"\"\"", 0, 5)) return 5;
    if (!check_opening("\"\"\"\r\nx\r\ny\"\"\"", 4, 5)) return 6;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
