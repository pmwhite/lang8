tag example;

import "noregion_import/store.l8";

use_tag noregion_shared;

main(): int {
    imported_stash();
    0
}

/* expect compile {|
noregion_import/store.l8:6:13

    saved = new int[1](1)
            ^^^^^^^^^^^^^

imported_stash stores this allocation in global saved, which can outlive
its region.

For retained storage, declare imported_stash and its callers as noregion
(unavailable inside regions), or keep temporary data local to its
region.

Callers also needing noregion: main.

|} */
