tag bounds_test;

import "../../stdlib/print.l8";

pick(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

forward(a: []int, base: int, delta: int): int requires (0 <= base && base <= len(a) && 0 <= delta) {
    if (delta >= len(a) - base) return 0;
    pick(a, base + delta)
}

main(): int {
    a: []int = [3, 5, 7, 11];
    forward(a, 1, 2)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 11
    |}
}
