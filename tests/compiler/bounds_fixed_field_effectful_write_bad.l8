tag bounds_test;

type Fixed = {
    data: []int;
    marker: int
} invariant (4 == len(data))

replacement(value: *Fixed): []int@new {
    value.marker = 1;
    new int[3](0)
}

main(): int {
    value: *Fixed = new Fixed { data: new int[4](0), marker: 0 };
    value.data = replacement(value);
    value.data[0]
}

//% test: compile-fail
//% error-contains: "record invariant is not proved"
