tag example;

import "../../stdlib/print.l8";

extern exit(code: int): noreturn;

/* A persistent global is an ordinary global in a program that is not
   reloaded: initialized once, before main, read and written like any other
   (RELOAD.md). */
type Place = {
    book: int;
    chapter: int;
    note: str
}

type Mark =
    | None
    | At { place: Place, color: i8 }

persistent current: Place = Place { book: 1, chapter: 1, note: "start" };

persistent marks: []Mark = [Mark.None, Mark.At { place: Place { book: 19, chapter: 23, note: "" }, color: 3i8 }];

persistent opened: int = 0;

persistent names: ?*Place = null;

test "persistent globals start from their initializers" {
    std::write(1, "book: ");
    std::print_int(current.book);
    std::write(1, "note: ");
    std::print(current.note);
    std::write(1, "marks: ");
    std::print_int(len(marks));
    std::write(1, "opened: ");
    std::print_int(opened);
    std::write(1, "names null: ");
    std::print(if (names == null) "yes" else "no");
    expect {|
        book: 1
        note: start
        marks: 2
        opened: 0
        names null: yes
    |}
}

test "persistent globals are assignable" {
    opened = opened + 1;
    current = Place { book: 43, chapter: 3, note: "John" };
    names = new Place { book: 2, chapter: 20, note: "Exodus" };
    match marks[1] {
        At k -> {
            std::write(1, "mark book: ");
            std::print_int(k.place.book);
            std::write(1, "color: ");
            std::print_int(k.color as int)
        }
        None -> std::print("none")
    }
    std::write(1, "opened: ");
    std::print_int(opened);
    std::write(1, "current: ");
    std::print(current.note);
    p: *Place = names or error_place();
    std::write(1, "names: ");
    std::print(p.note);
    expect {|
        mark book: 19
        color: 3
        opened: 1
        current: John
        names: Exodus
    |}
}

error_place(): noreturn {
    exit(1)
}
