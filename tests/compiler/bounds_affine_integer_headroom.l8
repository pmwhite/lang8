tag bounds_test;

import "../../stdlib/print.l8";

take(at: int): int requires (0 <= at) {
    at
}

safe(x: int, limit: int): int requires (0 <= x && 0 <= limit && x <= limit - 5) {
    take(x + 1)
}

main(): int {
    safe(0, 5)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 1
    |}
}
