tag bounds_test;

type Window = {
    data: []int;
    size: int;
    pos: int
} invariant (0 <= pos && pos <= size && size <= len(data))

advance(w: *Window) {
    if (w.pos < w.size) w.pos = w.pos + 1
}

main(): int {
    w: *Window = new Window { data: [7, 9], size: 2, pos: 0 };
    advance(w);
    advance(w);
    w.pos
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 2
