tag bounds_test;

import "../../stdlib/print.l8";

type Window = {
    data: []int;
    size: int;
    pos: int
} invariant (0 <= pos && pos <= size && size <= len(data))

advance(w: *Window) {
    if (w.pos < w.size) w.pos = w.pos + 1
}

main(): int {
    w: *Window = new Window { data: [7, 9], size: 2, pos: 0 };
    advance(w);
    advance(w);
    w.pos
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
