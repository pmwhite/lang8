tag example;

import "../../stdlib/print.l8";

mutate(buffer: []i8) {
    buffer[0] = 'x'
}

read_text(text: str): int {
    len(text)
}

test "copy, shared mutation, and read-only text" {
    text: str = "original";
    copy: []i8 = bytes(text);
    mutate(copy);
    std::print(text);
    std::print(cstr(copy));
    shared: []i8 = "shared";
    mutate(shared);
    std::print(cstr(shared));
    std::print_int(read_text(text));
    expect {|
        original
        xriginal
        xhared
        8
    |}
}
