tag bounds_test;

import "../../stdlib/print.l8";

fill(n: int): int {
    if (n < 2) return 0;
    a: []int = new int[n - 2](0);
    for i in 2..n a[i - 2] = i;
    len(a)
}

main(): int {
    fill(5)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
