tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    visits: int
}

visit(b: *Buffer) {
    b.visits = b.visits + 1
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], visits: 0 };
    visit(b);
    b.data[1]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
