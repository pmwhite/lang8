tag example;

import "../../stdlib/raw_write.l8";

/* Checked exceptions: unit + payload, catch, and print.
   `raises` must be exact — listing an exception the body never raises is an error. */
exception Empty;

exception NotFound {
    name: []i8
}

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

puts(s: []i8) {
    raw::raw_write_bytes(1, s)
}

boom() raises Empty {
    raise Empty
}

lookup(want: []i8) noregion raises NotFound: []i8 {
    /* Payload is immortal; copy a self-bound name rather than store it. */
    n: int = len(want);
    copy: []i8 = new i8[n](0i8);
    memcpy(copy, 0, want, 0, n);
    raise NotFound { name: copy }
}

test "exc" {
    try {
        boom();
        putchar('X')
    } with Empty -> {
        /* caught unit */
    }
    try {
        s: []i8 = lookup("Hi");
        puts(s)
    } with NotFound e -> {
        puts(e.name)
    }
    putchar('\n');
    expect {|
        Hi
    |}
}
