tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int
}

first(b: *Buffer): int {
    b.data[0]
}

main(): int {
    b: *Buffer = new Buffer { data: [7] };
    if (len(b.data) < 1) return 1;
    first(b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
