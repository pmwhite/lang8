tag example;

// Odd-sized elements exercise unaligned heap copies and scalar tails.
type Bytes16 = {
    data: [16]i8
}

copy16(value: Bytes16): Bytes16 {
    value
}

type Bytes17 = {
    data: [17]i8
}

copy17(value: Bytes17): Bytes17 {
    value
}

type Bytes31 = {
    data: [31]i8
}

copy31(value: Bytes31): Bytes31 {
    value
}

type Bytes33 = {
    data: [33]i8
}

copy33(value: Bytes33): Bytes33 {
    value
}

type Pair = {
    first: f64;
    second: f64
}

mixed(value: Pair, scale: f64): f64 {
    local: Pair = value;
    local.first * scale + local.second
}

main(): int {
    value16: Bytes16 = Bytes16 { data: [1i8, 2i8, 3i8, 4i8, 5i8, 6i8, 7i8, 8i8, 9i8,
        10i8, 11i8, 12i8, 13i8, 14i8, 15i8, 16i8] };
    xs16: []Bytes16 = new Bytes16[3](value16);
    xs16[1] = copy16(xs16[2]);
    xs16[1] = xs16[1];
    for i in 0..16 {
        if (xs16[0].data[i] as int != i + 1 || xs16[1].data[i] as int != i + 1 || xs16[2].data[i] as int != i + 1) return 16
    }
    value17: Bytes17 = Bytes17 { data: [1i8, 2i8, 3i8, 4i8, 5i8, 6i8, 7i8, 8i8, 9i8,
        10i8, 11i8, 12i8, 13i8, 14i8, 15i8, 16i8, 17i8] };
    xs17: []Bytes17 = new Bytes17[3](value17);
    xs17[1] = copy17(xs17[2]);
    xs17[1] = xs17[1];
    for i in 0..17 {
        if (xs17[0].data[i] as int != i + 1 || xs17[1].data[i] as int != i + 1 || xs17[2].data[i] as int != i + 1) return 17
    }
    value31: Bytes31 = Bytes31 { data: [1i8, 2i8, 3i8, 4i8, 5i8, 6i8, 7i8, 8i8, 9i8,
        10i8, 11i8, 12i8, 13i8, 14i8, 15i8, 16i8, 17i8, 18i8, 19i8, 20i8, 21i8, 22i8,
        23i8, 24i8, 25i8, 26i8, 27i8, 28i8, 29i8, 30i8, 31i8] };
    xs31: []Bytes31 = new Bytes31[3](value31);
    xs31[1] = copy31(xs31[2]);
    xs31[1] = xs31[1];
    for i in 0..31 {
        if (xs31[0].data[i] as int != i + 1 || xs31[1].data[i] as int != i + 1 || xs31[2].data[i] as int != i + 1) return 31
    }
    value33: Bytes33 = Bytes33 { data: [1i8, 2i8, 3i8, 4i8, 5i8, 6i8, 7i8, 8i8, 9i8,
        10i8, 11i8, 12i8, 13i8, 14i8, 15i8, 16i8, 17i8, 18i8, 19i8, 20i8, 21i8, 22i8,
        23i8, 24i8, 25i8, 26i8, 27i8, 28i8, 29i8, 30i8, 31i8, 32i8, 33i8] };
    xs33: []Bytes33 = new Bytes33[3](value33);
    xs33[1] = copy33(xs33[2]);
    xs33[1] = xs33[1];
    for i in 0..33 {
        if (xs33[0].data[i] as int != i + 1 || xs33[1].data[i] as int != i + 1 || xs33[2].data[i] as int != i + 1) return 33
    }
    pair: Pair = Pair { first: 1.25f64, second: -2.0f64 };
    if (mixed(pair, 4.0f64) != 3.0f64) return 1;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
