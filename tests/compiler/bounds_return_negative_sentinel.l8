tag bounds_test;

import "../../stdlib/print.l8";

find_value(a: []int, n: int): int {
    for i in 0..n {
        if (a[i] == 7) return i
    }
    0 - 1
}

main(): int {
    a: []int = [3, 7];
    found: int = find_value(a, len(a));
    if (found < 0) return 0;
    a[found]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
