tag bounds_test;

find_value(a: []int, n: int): int {
    for i in 0..n {
        if (a[check_index(a, i)] == 7) return i
    }
    0 - 1
}

main(): int {
    a: []int = [3, 7];
    found: int = find_value(a, len(a));
    if (found < 0) return 0;
    a[found]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 7
