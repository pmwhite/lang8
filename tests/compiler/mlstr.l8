tag example;

import "../../stdlib/raw_write.l8";

// """...""" keeps newlines; a newline right after the opener is dropped.
test "mlstr" {
    a: []i8 = """
A
B
""";
    b: []i8 = "xy";
    raw::raw_write_bytes(1, a);
    raw::raw_write_bytes(1, b);
    raw::raw_write(1, "\n");
    expect {|
        A
        B
        xy
    |}
}
