tag example;

import "../../programs/stdlib/write.l8";

// """...""" keeps newlines; a newline right after the opener is dropped.
main(): int {
    a: []i8 = """
A
B
""";
    b: []i8 = "xy";
    std::write_bytes(1, a);
    std::write_bytes(1, b);
    std::write(1, "\n");
    0
}

//% test: run
//% stdout: "A\nB\nxy\n"
//% exit: 0
