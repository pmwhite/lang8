tag example;

import "../../stdlib/print.l8";

exception Fail;

// A try expression's value survives leaving the try, even when it is nested
// in other tries.
inner(): int {
    try {
        7
    } with Fail -> {
        1
    }
}

outer(): int {
    try {
        try {
            inner()
        } with Fail -> {
            2
        }
    } with Fail -> {
        3
    }
}

test "a try's value survives leaving nested tries" {
    std::write(1, "inner(): ");
    std::print_int(inner());
    expect {|
        inner(): 7
    |}
    std::write(1, "outer(): ");
    std::print_int(outer());
    expect {|
        outer(): 7
    |}
}
