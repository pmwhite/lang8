tag example;

import "../../stdlib/print.l8";

exception Fail;

// A try expression's value survives leaving the try, even when it is nested
// in other tries.
inner(): int {
    try {
        7
    } with Fail -> {
        1
    }
}

main(): int {
    try {
        try {
            inner()
        } with Fail -> {
            2
        }
    } with Fail -> {
        3
    }
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
