tag bounds_test;

present(p: ?*int): bool {
    if (p != null) return true;
    false
}

read_present(p: ?*int): int {
    available: bool = present(p);
    if (available) p.* else 0
}

main(): int {
    x: int = 9;
    if (read_present(&x) != 9 || read_present(null) != 0) return 1;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
