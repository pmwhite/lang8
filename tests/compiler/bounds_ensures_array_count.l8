tag bounds_test;

produce_count(count: []int, source: []int): int requires (1 <= len(count)) ensures (0 <= count[0] && count[0] <= len(source)) {
    count[0] = len(source);
    0
}

copy_count(dst: []int, source: []int, n: int) requires (0 <= n && n <= len(dst) && n <= len(source)) {
    for i in 0..n dst[i] = source[i]
}

main(): int {
    source: []int = [4, 5, 6];
    count: []int = [0];
    dst: []int = [0, 0, 0];
    result: int = produce_count(count, source);
    if (result != 0) return 1;
    copy_count(dst, source, count[0]);
    dst[2]
}

//% test: run
//% stdout: ""
//% exit: 6
