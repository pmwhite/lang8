tag memory_alias_test;

import "../../stdlib/print.l8";

type Cell = {
    value: int;
    small: i8;
    signed: i32;
    flag: bool
}

nudge(a: int): int {
    a + 7
}

arithmetic_probe(a: int): int {
    x: int = nudge(a);
    x * 3 + x
}

mutate(p: *int, value: int): int {
    p.* = value;
    value
}

indirect_mutation(p: *int): int {
    p.* = 19;
    4
}

alias_probe(a: int): int {
    x: int = a;
    p: *int = &x;
    before: int = x;
    _changed: int = mutate(p, 37);
    before + x
}

join_probe(a: int): int {
    x: int = a;
    if (a < 0) x = 11 else x = 23;
    x + 5
}

register_probe(a: int, b: int): int {
    x: int = a + b;
    y: int = a * b;
    z: int = x - y;
    (x + y) * z + x
}

narrow_probe(a: int): int {
    cell: Cell = Cell {
        value: a,
        small: 255i8,
        signed: -19i32,
        flag: true
    };
    before: int = cell.value;
    cell.small = 7i8;
    cell.signed = -31i32;
    cell.flag = false;
    if (cell.small != 7i8 || cell.signed != -31i32 || cell.flag) return -1;
    before + cell.value
}

ma_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, "=");
    std::write_int(1, value)
}

test "probes over a range of inputs" {
    for a in -10..10 {
        ma_show("a", a);
        ma_show(" arithmetic", arithmetic_probe(a));
        ma_show(" alias", alias_probe(a));
        ma_show(" join", join_probe(a));
        ma_show(" narrow", narrow_probe(a));
        std::write(1, "\n")
    }
    expect {|
        a=-10 arithmetic=-12 alias=27 join=16 narrow=-20
        a=-9 arithmetic=-8 alias=28 join=16 narrow=-18
        a=-8 arithmetic=-4 alias=29 join=16 narrow=-16
        a=-7 arithmetic=0 alias=30 join=16 narrow=-14
        a=-6 arithmetic=4 alias=31 join=16 narrow=-12
        a=-5 arithmetic=8 alias=32 join=16 narrow=-10
        a=-4 arithmetic=12 alias=33 join=16 narrow=-8
        a=-3 arithmetic=16 alias=34 join=16 narrow=-6
        a=-2 arithmetic=20 alias=35 join=16 narrow=-4
        a=-1 arithmetic=24 alias=36 join=16 narrow=-2
        a=0 arithmetic=28 alias=37 join=28 narrow=0
        a=1 arithmetic=32 alias=38 join=28 narrow=2
        a=2 arithmetic=36 alias=39 join=28 narrow=4
        a=3 arithmetic=40 alias=40 join=28 narrow=6
        a=4 arithmetic=44 alias=41 join=28 narrow=8
        a=5 arithmetic=48 alias=42 join=28 narrow=10
        a=6 arithmetic=52 alias=43 join=28 narrow=12
        a=7 arithmetic=56 alias=44 join=28 narrow=14
        a=8 arithmetic=60 alias=45 join=28 narrow=16
        a=9 arithmetic=64 alias=46 join=28 narrow=18
    |}
}

test "register probe" {
    // Each row is register_probe(a, b) for b from -5 to 4.
    for a in -10..10 {
        ma_show("a", a);
        std::write(1, ":");
        for b in -5..5 {
            std::write(1, " ");
            std::write_int(1, register_probe(a, b))
        }
        std::write(1, "\n")
    }
    expect {|
        a=-10: -2290 -1418 -744 -268 10 90 -28 -344 -858 -1570
        a=-9: -1843 -1140 -597 -214 9 72 -25 -282 -699 -1276
        a=-8: -1444 -892 -466 -166 8 56 -22 -226 -556 -1012
        a=-7: -1093 -674 -351 -124 7 42 -19 -176 -429 -778
        a=-6: -790 -486 -252 -88 6 30 -16 -132 -318 -574
        a=-5: -535 -328 -169 -58 5 20 -13 -94 -223 -400
        a=-4: -328 -200 -102 -34 4 12 -10 -62 -144 -256
        a=-3: -169 -102 -51 -16 3 6 -7 -36 -81 -142
        a=-2: -58 -34 -16 -4 2 2 -4 -16 -34 -58
        a=-1: 5 4 3 2 1 0 -1 -2 -3 -4
        a=0: 20 12 6 2 0 0 2 6 12 20
        a=1: -13 -10 -7 -4 -1 2 5 8 11 14
        a=2: -94 -62 -36 -16 -2 6 8 4 -6 -22
        a=3: -223 -144 -81 -34 -3 12 11 -6 -39 -88
        a=4: -400 -256 -142 -58 -4 20 14 -22 -88 -184
        a=5: -625 -398 -219 -88 -5 30 17 -44 -153 -310
        a=6: -898 -570 -312 -124 -6 42 20 -72 -234 -466
        a=7: -1219 -772 -421 -166 -7 56 23 -106 -331 -652
        a=8: -1588 -1004 -546 -214 -8 72 26 -146 -444 -868
        a=9: -2005 -1266 -687 -268 -9 90 29 -192 -573 -1114
    |}
}

test "a callback changes a local between reads" {
    x: int = 5;
    callback: fn(p: *int): int = &indirect_mutation;
    result: int = x + callback(&x) + x;
    ma_show("result", result);
    ma_show(" x", x);
    std::write(1, "\n");
    expect {|
        result=28 x=19
    |}
}

test "values learned in a loop" {
    // A backedge must not reuse a value learned only on the first iteration.
    sum: int = 0;
    for i in 0..100 sum = sum + arithmetic_probe(i);
    ma_show("sum", sum);
    std::write(1, "\n");
    expect {|
        sum=22600
    |}
}
