tag memory_alias_test;

import "../../stdlib/print.l8";

type Cell = {
    value: int;
    small: i8;
    signed: i32;
    flag: bool
}

nudge(a: int): int {
    a + 7
}

arithmetic_probe(a: int): int {
    x: int = nudge(a);
    x * 3 + x
}

mutate(p: *int, value: int): int {
    p.* = value;
    value
}

indirect_mutation(p: *int): int {
    p.* = 19;
    4
}

alias_probe(a: int): int {
    x: int = a;
    p: *int = &x;
    before: int = x;
    _changed: int = mutate(p, 37);
    before + x
}

join_probe(a: int): int {
    x: int = a;
    if (a < 0) x = 11 else x = 23;
    x + 5
}

register_probe(a: int, b: int): int {
    x: int = a + b;
    y: int = a * b;
    z: int = x - y;
    (x + y) * z + x
}

narrow_probe(a: int): int {
    cell: Cell = Cell {
        value: a,
        small: 255i8,
        signed: -19i32,
        flag: true
    };
    before: int = cell.value;
    cell.small = 7i8;
    cell.signed = -31i32;
    cell.flag = false;
    if (cell.small != 7i8 || cell.signed != -31i32 || cell.flag) return -1;
    before + cell.value
}

main(): int {
    for a in -10..10 {
        if (arithmetic_probe(a) != (a + 7) * 4) return 1;
        if (alias_probe(a) != a + 37) return 2;
        if (join_probe(a) != (if (a < 0) 16 else 28)) return 3;
        if (narrow_probe(a) != a * 2) return 4;
        for b in -5..5 {
            x: int = a + b;
            y: int = a * b;
            if (register_probe(a, b) != (x + y) * (x - y) + x) return 5
        }
    }
    x: int = 5;
    callback: fn(p: *int): int = &indirect_mutation;
    result: int = x + callback(&x) + x;
    if (result != 28 || x != 19) return 6;
    // A backedge must not reuse a value learned only on the first iteration.
    sum: int = 0;
    for i in 0..100 sum = sum + arithmetic_probe(i);
    if (sum != 22600) return 7;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
