tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    cursor: int
}

read_at_cursor(b: *Buffer): int {
    if (b.cursor < 0 || b.cursor >= len(b.data)) return -1;
    b.data[b.cursor] + b.data[b.cursor]
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], cursor: 1 };
    read_at_cursor(b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 14
    |}
}
