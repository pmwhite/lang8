tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

read_at_cursor(b: *Buffer): int {
    if (b.cursor < 0 || b.cursor >= len(b.data)) return -1;
    b.data[b.cursor] + b.data[check_index(b.data, b.cursor)]
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], cursor: 1 };
    read_at_cursor(b)
}

//% test: run
//% verify-bounds: true
//% compiler-warnings: ["check_index is redundant: index already proved in bounds"]
//% stdout: ""
//% exit: 14
