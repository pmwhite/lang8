tag bounds_test;

type Counter = {
    count: int
} invariant (0 <= count && count <= 15)

bump(c: *Counter) {
    c.count = 16
}

main(): int {
    c: *Counter = new Counter { count: 0 };
    bump(c);
    c.count
}

/* expect compile {|
error: bounds_record_invariant_count_increment_bad.l8:8:7: record invariant is not proved after construction or field assignment
|} */
