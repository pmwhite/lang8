tag bounds_test;

read_part(out: []i8, fail: bool): int {
    if (fail) return -1;
    len(out)
}

use(data: []i8, count: int): int requires (0 <= count && count <= len(data)) {
    count
}

main(): int {
    data: []i8 = new i8[8](0i8);
    count: int = read_part(data, false);
    if (count < 0) return 1;
    use(data, count)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 8
