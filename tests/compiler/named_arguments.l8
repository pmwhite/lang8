tag named_arguments_test;

import "../../stdlib/print.l8";

extern named_write(named fd: int, named data: str, named count: int): int = l8_std_write;

trace: int = 0;

step(n: int): int {
    trace = trace * 10 + n;
    n
}

combine(named a: int, b: int, named c: int): int {
    a * 100 + b * 10 + c
}

get_combine(): fn(named a: int, value: int, named c: int): int {
    trace = 9;
    &combine
}

digits(named a: int, named b: int): int {
    a * 10 + b
}

mutate(p: *int): int {
    p.* = 23;
    3
}

type Pair = {
    x: int;
    y: int
}

make_pair(named x: int, named y: int): Pair {
    Pair { x: x, y: y }
}

mutate_pair(p: *Pair): int {
    p.x = 9;
    3
}

record_probe(named changed: int, named value: Pair): int {
    value.x * 100 + value.y * 10 + changed
}

record_probe_in_order(named value: Pair, named changed: int): int {
    record_probe(changed: changed, value: value)
}

many(
    named a: int,
    named b: f64,
    named c: int,
    named d: f32,
    named e: int,
    named f: int,
    named g: int,
    named h: int,
    named i: int
): int {
    a + b as int + c + d as int + e + f + g + h + i
}

borrow(named source: []int, named ignored: int): []int@source {
    if (ignored != 0) return source;
    source
}

identity(named value: *int): *int@value {
    value
}

// `named` remains a valid positional parameter and local name.
contextual(named: int): int {
    named
}

exception Failure;

fail() raises Failure: int {
    raise Failure
}

with_failure(named a: int, named b: int): int {
    a + b
}

invoke(cb: fn(named value: int) raises Failure, named value: int) raises Failure {
    cb(value: value)
}

throw_value(named value: int) raises Failure {
    if (value == 0) raise Failure
}

show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "mixed and reordered arguments evaluate in source order" {
    trace = 0;
    show("mixed", combine(c: step(1), step(2), a: step(3)));
    show("trace", trace);
    show("declaration order", combine(a: 1, 2, c: 3));
    show("positional named", contextual(4));
    expect {|
        mixed: 321
        trace: 123
        declaration order: 123
        positional named: 4
    |}
}

test "function values preserve labels and evaluate the callee first" {
    trace = 0;
    show("indirect", get_combine()(c: step(1), step(2), a: step(3)));
    show("trace", trace);
    f: fn(named a: int, other: int, named c: int): int = &combine;
    show("local", f(c: 6, 5, a: 4));
    optional: ?fn(named a: int, other: int, named c: int): int = f;
    if (optional != null) show("optional", optional(c: 9, 8, a: 7));
    expect {|
        indirect: 321
        trace: 9123
        local: 456
        optional: 789
    |}
}

test "earlier argument values survive later mutations" {
    x: int = 7;
    show("scalar", digits(b: x, a: mutate(&x)));
    show("x", x);
    value: Pair = Pair { x: 1, y: 2 };
    show("record", record_probe(value: value, changed: mutate_pair(&value)));
    show("record x", value.x);
    value.x = 1;
    show("record in order", record_probe_in_order(value: value, changed: mutate_pair(&value)));
    expect {|
        scalar: 37
        x: 23
        record: 123
        record x: 9
        record in order: 123
    |}
}

test "aggregate results and nested calls" {
    trace = 0;
    value: Pair = make_pair(y: step(1), x: step(2));
    show("x", value.x);
    show("y", value.y);
    show("trace", trace);
    show("nested", digits(b: digits(b: 4, a: 3), a: digits(b: 2, a: 1)));
    f: fn(named x: int, named y: int): Pair = &make_pair;
    value = f(y: 6, x: 5);
    show("indirect x", value.x);
    show("indirect y", value.y);
    expect {|
        x: 2
        y: 1
        trace: 12
        nested: 154
        indirect x: 5
        indirect y: 6
    |}
}

test "integer floating and stack arguments" {
    show("many", many(i: 9, h: 8, g: 7, f: 6, e: 5, d: 4.0, c: 3, b: 2.0f64, a: 1));
    f: fn(named a: int, named b: f64, named c: int, named d: f32, named e: int, named f: int, named g: int, named h: int, named i: int): int = &many;
    show("indirect many", f(i: 9, h: 8, g: 7, f: 6, e: 5, d: 4.0, c: 3, b: 2.0f64,
        a: 1));
    expect {|
        many: 45
        indirect many: 45
    |}
}

test "lifetime contracts follow parameter bindings" {
    region {
        values: []int = new int[2](7);
        result: []int = borrow(ignored: 0, source: values);
        show("borrow", result[0]);
        f: fn(named source: []int, named ignored: int): []int@source = &borrow;
        result = f(ignored: 1, source: values);
        show("indirect borrow", result[1]);
        x: int = 8;
        id: fn(named value: *int): *int@value = &identity;
        show("pointer", id(value: &x).*)
    }
    expect {|
        borrow: 7
        indirect borrow: 7
        pointer: 8
    |}
}

test "exceptions stop evaluation and labels work after a void callback type" {
    trace = 0;
    try {
        _result: int = with_failure(b: fail(), a: step(1))
    } with Failure -> {
        show("trace", trace)
    }
    try {
        invoke(&throw_value, value: 0)
    } with Failure -> {
        show("callback raised", 1)
    }
    expect {|
        trace: 0
        callback raised: 1
    |}
}

test "extern labels belong to the L8 declaration" {
    _written: int = named_write(count: 6, data: "named\n", fd: 1);
    expect {|
        named
    |}
}

test "aggregate result slots are reused inside loops" {
    value: Pair = Pair { x: 0, y: 0 };
    callback: fn(named x: int, named y: int): Pair = &make_pair;
    for i in 0..1000 {
        value = make_pair(y: i + 1, x: i);
        value = callback(y: value.y + 1, x: value.x + 1)
    }
    show("x", value.x);
    show("y", value.y);
    expect {|
        x: 1000
        y: 1001
    |}
}
