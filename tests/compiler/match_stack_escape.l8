tag example;

type Box = {
    n: int
}

type Shape =
    | One { item: *Box }
    | None

g: ?*Box = null;

main(): int {
    local: Box = Box { n: 4 };
    shape: Shape = Shape.One { item: &local };
    match shape {
        One found -> g = found.item;
        None -> { }
    }
    0
}

