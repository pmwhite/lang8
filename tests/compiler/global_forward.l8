tag example;

/* Globals, including constants, may be used before their declarations.
   Dynamic initializers run after the globals they read, even through calls. */
type Box = {
    data: []i8
} invariant (len(data) == SIZE)

main(): int {
    counter = counter + 1;
    holder.data[0] = 5i8;
    if (first != 7) return 1;
    total: int = counter + len(holder.data) + LIMIT + callback(2);
    if (total != 1 + SIZE + LIMIT + 4) return 2;
    0
}

first: int = read_later();

read_later(): int {
    later.value
}

type Cell = {
    value: int
}

later: *Cell = new Cell { value: 7 };

counter: int = 0;

holder: Box = Box { data: new i8[SIZE](0i8) };

const SIZE: int = LIMIT * 2;

const LIMIT: int = 3;

twice(n: int): int {
    n * 2
}

callback: fn(n: int): int = &twice

//% test: run
//% stdout: ""
//% exit: 0
