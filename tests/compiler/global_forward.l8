tag example;

import "../../stdlib/print.l8";

/* Globals, including constants, may be used before their declarations.
   Dynamic initializers run after the globals they read, even through calls. */
type Box = {
    data: []i8
} invariant (len(data) == SIZE)

test "globals are initialized before use, in dependency order" {
    forward_show("first", first);
    forward_show("counter", counter);
    forward_show("len(holder.data)", len(holder.data));
    forward_show("SIZE", SIZE);
    forward_show("LIMIT", LIMIT);
    forward_show("callback(2)", callback(2));
    expect {|
        first: 7
        counter: 0
        len(holder.data): 6
        SIZE: 6
        LIMIT: 3
        callback(2): 4
    |}
    counter = counter + 1;
    holder.data[0] = 5i8;
    forward_show("counter", counter);
    forward_show("holder.data[0]", holder.data[0] as int);
    expect {|
        counter: 1
        holder.data[0]: 5
    |}
    total: int = counter + len(holder.data) + LIMIT + callback(2);
    forward_show("total", total);
    expect {|
        total: 14
    |}
}

first: int = read_later();

read_later(): int {
    later.value
}

type Cell = {
    value: int
}

later: *Cell = new Cell { value: 7 };

counter: int = 0;

holder: Box = Box { data: new i8[SIZE](0i8) };

const SIZE: int = LIMIT * 2;

const LIMIT: int = 3;

twice(n: int): int {
    n * 2
}

callback: fn(n: int): int = &twice;

forward_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}
