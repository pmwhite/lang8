tag example;

type Bytes = {
    data: []i8;
    size: int
}

bytes_new(capacity: int): *Bytes@new {
    new Bytes { data: new i8[capacity](0i8), size: 0 }
}

// Grows its builder from the call's allocation destination.
bytes_add(builder: *Bytes@new, byte: i8) {
    if (builder.size == len(builder.data)) {
        grown: []i8 = new i8[len(builder.data) * 2](0i8);
        memcpy(grown, 0, builder.data, 0, builder.size);
        builder.data = grown
    }
    builder.data[builder.size] = byte;
    builder.size = builder.size + 1
}

main(): int {
    builder: *Bytes = bytes_new(1);
    // The region would free the storage grown for a builder that outlives it.
    region {
        bytes_add(builder, 65i8)
    }
    builder.size
}

/* expect compile {|
error: lifetime_held_region.l8:27:19: bytes_add stores what it allocates into parameter builder, but this argument outlives those allocations (they end with the region or arena the call allocates in); make the call where the argument was allocated
|} */
