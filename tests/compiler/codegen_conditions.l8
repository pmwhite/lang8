tag condition_test;

import "../../stdlib/print.l8";

calls: int = 0;

tick(value: bool): bool {
    calls = calls + 1;
    value
}

select(a: int, b: int): int {
    if (a < b) 7 else 9
}

check(a: int, b: int): bool {
    if (a < b != !(a >= b)) return false;
    if (a <= b != !(a > b)) return false;
    if (a == b != !(a != b)) return false;
    true
}

main(): int {
    if (tick(false) && tick(true)) return 1;
    if (calls != 1) return 2;
    if (!(tick(true) || tick(false))) return 3;
    if (calls != 2) return 4;
    if (!(tick(false) || tick(true) && !tick(false))) return 5;
    if (calls != 5) return 6;
    i: int = 0;
    while (i < 5 && tick(true)) i = i + 1;
    if (i != 5 || calls != 10) return 7;
    if (select(-1, 0) != 7 || select(2, 1) != 9) return 8;
    if (!check(-1, 1) || !check(0, 0) || !check(9, 2)) return 9;
    u: u32 = 4294967295u32;
    if (u < 1u32 || u <= 1u32 || !(u > 1u32) || !(u >= 1u32)) return 10;
    x: str = "abc";
    if (x != "abc" || x == "def") return 11;
    f: f64 = 1.5f64;
    if (f < 1.0f64 || !(f > 1.0f64)) return 12;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
