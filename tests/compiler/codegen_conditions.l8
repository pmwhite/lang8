tag condition_test;

import "../../stdlib/print.l8";

calls: int = 0;

tick(value: bool): bool {
    calls = calls + 1;
    value
}

select(a: int, b: int): int {
    if (a < b) 7 else 9
}

check(a: int, b: int): bool {
    if (a < b != !(a >= b)) return false;
    if (a <= b != !(a > b)) return false;
    if (a == b != !(a != b)) return false;
    true
}

condition_calls() raises std::IoError {
    std::write(1, "calls: ");
    std::print_int(calls)
}

test "short-circuit conditions call only what they need" {
    if (tick(false) && tick(true)) std::print("false && true: taken") else std::print("false && true: not taken");
    condition_calls();
    expect {|
        false && true: not taken
        calls: 1
    |}
    if (!(tick(true) || tick(false))) std::print("!(true || false): taken") else std::print("!(true || false): not taken");
    condition_calls();
    expect {|
        !(true || false): not taken
        calls: 2
    |}
    if (!(tick(false) || tick(true) && !tick(false))) std::print("!(false || true && !false): taken") else std::print("!(false || true && !false): not taken");
    condition_calls();
    expect {|
        !(false || true && !false): not taken
        calls: 5
    |}
    i: int = 0;
    while (i < 5 && tick(true)) i = i + 1;
    std::write(1, "i after while (i < 5 && tick(true)): ");
    std::print_int(i);
    condition_calls();
    expect {|
        i after while (i < 5 && tick(true)): 5
        calls: 10
    |}
}

test "comparisons choose branches" {
    std::write(1, "select(-1, 0): ");
    std::print_int(select(-1, 0));
    std::write(1, "select(2, 1): ");
    std::print_int(select(2, 1));
    expect {|
        select(-1, 0): 7
        select(2, 1): 9
    |}
    // check compares each comparison with the negation of its opposite.
    std::write(1, "check(-1, 1): ");
    std::print_bool(check(-1, 1));
    std::write(1, "check(0, 0): ");
    std::print_bool(check(0, 0));
    std::write(1, "check(9, 2): ");
    std::print_bool(check(9, 2));
    expect {|
        check(-1, 1): true
        check(0, 0): true
        check(9, 2): true
    |}
}

test "u32 comparisons are unsigned" {
    u: u32 = 4294967295u32;
    if (u < 1u32) std::print("u < 1: taken") else std::print("u < 1: not taken");
    if (u <= 1u32) std::print("u <= 1: taken") else std::print("u <= 1: not taken");
    if (!(u > 1u32)) std::print("!(u > 1): taken") else std::print("!(u > 1): not taken");
    if (!(u >= 1u32)) std::print("!(u >= 1): taken") else std::print("!(u >= 1): not taken");
    expect {|
        u < 1: not taken
        u <= 1: not taken
        !(u > 1): not taken
        !(u >= 1): not taken
    |}
}

test "string and f64 comparisons" {
    x: str = "abc";
    if (x != "abc") std::print("x != \"abc\": taken") else std::print("x != \"abc\": not taken");
    if (x == "def") std::print("x == \"def\": taken") else std::print("x == \"def\": not taken");
    expect {|
        x != "abc": not taken
        x == "def": not taken
    |}
    f: f64 = 1.5f64;
    if (f < 1.0f64) std::print("f < 1.0: taken") else std::print("f < 1.0: not taken");
    if (!(f > 1.0f64)) std::print("!(f > 1.0): taken") else std::print("!(f > 1.0): not taken");
    expect {|
        f < 1.0: not taken
        !(f > 1.0): not taken
    |}
}
