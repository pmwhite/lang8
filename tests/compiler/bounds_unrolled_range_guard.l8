tag bounds_test;

// A guard that holds in some iterations still checks the access there.
last(a: []int): int requires (len(a) == 5) {
    total: int = 0;
    for k in 0..4 {
        if (k >= 3) total = total + a[k + 2]
    }
    total
}

main(): int {
    a: []int = [1, 2, 3, 4, 5];
    last(a)
}

/* expect compile {|
error: bounds_unrolled_range_guard.l8:14:5: call does not prove inferred array bounds requirement for last 5 < len(a)
|} */
