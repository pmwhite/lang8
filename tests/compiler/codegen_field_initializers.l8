tag example;

import "../../stdlib/print.l8";

type Pair = {
    a: int;
    b: int
}

type Fields = {
    first: int;
    byte: i8;
    flag: bool;
    signed: i32;
    unsigned: u32;
    single: f32;
    double: f64;
    large: int;
    pointer: ?*int;
    pair: Pair;
    last: int
}

order: int = 0;

mark(value: int): int {
    order = order * 10 + value;
    value
}

pair(): Pair {
    Pair { a: 7, b: 11 }
}

fi_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

fi_show_fixed(label: str, value: f64) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_fixed(value, 2)
}

test "heap record field initializers" {
    fields: *Fields = new Fields {
        first: mark(1),
        byte: 255i8,
        flag: true,
        signed: -17i32,
        unsigned: 4294967295u32,
        single: 1.5,
        double: 2.5f64,
        large: 9223372036854775807,
        pointer: null,
        pair: pair(),
        last: mark(2)
    };
    // Initializers run in field order.
    fi_show("order", order);
    fi_show("first", fields.first);
    fi_show("last", fields.last);
    expect {|
        order: 12
        first: 1
        last: 2
    |}
    fi_show("byte", fields.byte as int);
    std::write(1, "flag: ");
    std::print_bool(fields.flag);
    fi_show("signed", fields.signed as int);
    fi_show("unsigned", fields.unsigned as int);
    fi_show_fixed("single", fields.single as f64);
    fi_show_fixed("double", fields.double);
    fi_show("large", fields.large);
    std::write(1, "pointer is null: ");
    std::print_bool(fields.pointer == null);
    fi_show("pair.a", fields.pair.a);
    fi_show("pair.b", fields.pair.b);
    expect {|
        byte: 255
        flag: true
        signed: -17
        unsigned: 4294967295
        single: 1.50
        double: 2.50
        large: 9223372036854775807
        pointer is null: true
        pair.a: 7
        pair.b: 11
    |}
}
