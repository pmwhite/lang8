tag example;

import "../../stdlib/print.l8";

type Pair = {
    a: int;
    b: int
}

type Fields = {
    first: int;
    byte: i8;
    flag: bool;
    signed: i32;
    unsigned: u32;
    single: f32;
    double: f64;
    large: int;
    pointer: ?*int;
    pair: Pair;
    last: int
}

order: int = 0;

mark(value: int): int {
    order = order * 10 + value;
    value
}

pair(): Pair {
    Pair { a: 7, b: 11 }
}

main(): int {
    fields: *Fields = new Fields {
        first: mark(1),
        byte: 255i8,
        flag: true,
        signed: -17i32,
        unsigned: 4294967295u32,
        single: 1.5,
        double: 2.5f64,
        large: 9223372036854775807,
        pointer: null,
        pair: pair(),
        last: mark(2)
    };
    if (order != 12 || fields.first != 1 || fields.last != 2) return 1;
    if (fields.byte != 255i8 || !fields.flag || fields.signed != -17i32) return 2;
    if (fields.unsigned != 4294967295u32 || fields.single != 1.5 || fields.double != 2.5f64) return 3;
    if (fields.large != 9223372036854775807 || fields.pointer != null) return 4;
    if (fields.pair.a != 7 || fields.pair.b != 11) return 5;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
