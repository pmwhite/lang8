tag bounds_test;

write_three(a: []int, i: int) {
    a[i] = 3;
    a[i + 1] = 5;
    a[i + 2] = 7
}

main(): int {
    a: []int = new int[2](0);
    write_three(a, 0);
    0
}

/* expect compile {|
error: bounds_affine_call_short.l8:11:5: call does not prove inferred array bounds requirement for write_three 2 < len(a)
|} */
