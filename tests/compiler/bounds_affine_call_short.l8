tag bounds_test;

write_three(a: []int, i: int) {
    a[i] = 3;
    a[i + 1] = 5;
    a[i + 2] = 7
}

main(): int {
    a: []int = new int[2](0);
    write_three(a, 0);
    0
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "call does not prove inferred array bounds requirement"
