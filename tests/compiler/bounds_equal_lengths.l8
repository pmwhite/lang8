tag bounds_test;

import "../../stdlib/print.l8";

same(a: []int, b: []int): int {
    if (len(a) != len(b)) return 0;
    for i in 0..len(a) {
        if (a[i] != b[i] || b[i] != a[i]) return 1
    }
    2
}

main(): int {
    a: []int = [1, 2];
    b: []int = [1, 2];
    same(a, b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
