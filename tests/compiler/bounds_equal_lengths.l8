tag bounds_test;

same(a: []int, b: []int): int {
    if (len(a) != len(b)) return 0;
    for i in 0..len(a) {
        if (a[i] != b[i] || b[check_index(b, i)] != a[i]) return 1
    }
    2
}

main(): int {
    a: []int = [1, 2];
    b: []int = [1, 2];
    same(a, b)
}

//% test: run
//% verify-bounds: true
//% compiler-warnings: ["check_index is redundant: index already proved in bounds"]
//% stdout: ""
//% exit: 2
