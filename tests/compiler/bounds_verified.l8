tag bounds_test;

import "../../stdlib/print.l8";

get(a: []i8, i: int): i8 {
    a[i]
}

forward(a: []i8, i: int): i8 {
    get(a, i)
}

tick() { }

main(): int {
    a: []i8 = ['A', 'B'];
    i: int = 1;
    if (i < 0 || i >= len(a)) return 1;
    tick();
    forward(a, i) as int
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 66
    |}
}
