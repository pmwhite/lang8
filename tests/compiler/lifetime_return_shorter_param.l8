tag example;

import "../../stdlib/print.l8";

type Names = {
    first: str
}

// The result is bound to the shorter-lived parameter (names, which
// fallback outlives), whichever one is returned.
first_or(names: *Names, fallback: str@names, use_names: bool): str@names {
    if (use_names) names.first else fallback
}

test "either parameter may be returned under the shorter bound" {
    region {
        names: *Names = new Names { first: "Ruth" };
        std::print(first_or(names, "Naomi", true));
        std::print(first_or(names, "Naomi", false))
    }
    expect {|
        Ruth
        Naomi
    |}
}
