tag bounds_test;

bad(a: []int, i: int) raises IndexOutOfBounds: int {
    if (i < 0) return -1;
    tail: int = a![i + 1];
    a = new int[0](0);
    a[i] + tail
}

main() raises IndexOutOfBounds: int {
    a: []int = [4, 5];
    bad(a, 0)
}

//% test: compile-fail
//% error-contains: "unproved array access; use ![] for a runtime check"
