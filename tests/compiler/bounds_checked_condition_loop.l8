tag bounds_test;

import "../../stdlib/print.l8";

scan(a: []i8): int {
    cursor: int = 0;
    while (cursor < len(a) && a[cursor] != 'x') cursor = cursor + 1;
    total: int = 0;
    for i in cursor..len(a) total = total + a[i] as int;
    total
}

main(): int {
    scan("abx")
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 120
    |}
}
