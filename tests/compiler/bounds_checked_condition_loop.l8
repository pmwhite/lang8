tag bounds_test;

scan(a: []i8): int {
    cursor: int = 0;
    while (cursor < len(a) && a[check_index(a, cursor)] != 'x') cursor = cursor + 1;
    total: int = 0;
    for i in cursor..len(a) total = total + a[i] as int;
    total
}

main(): int {
    scan("abx")
}

