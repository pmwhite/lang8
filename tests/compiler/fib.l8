tag example;

import "../../stdlib/raw_write.l8";

fib(n: int): int {
    if (n < 2) return n;
    fib(n - 1) + fib(n - 2)
}

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

print_int(n: int) {
    if (n < 0) {
        putchar('-');
        n = 0 - n
    }
    if (n > 9) print_int(n / 10);
    putchar(('0' as int + n % 10) trunc i8)
}

test "fib" {
    print_int(fib(10));
    putchar('\n');
    expect {|
        55
    |}
}
