tag example;

import "../../stdlib/print.l8";

test "cstr rejects bytes with an interior NUL" {
    bytes_with_nul: []i8 = new i8[3](0i8);
    bytes_with_nul[0] = 'a';
    bytes_with_nul[2] = 'b';
    std::print("converting");
    s: str = cstr(bytes_with_nul);
    std::write(1, "len(s): ");
    std::print_int(len(s));
    expect {|
        converting
        [exit 1]
    |}
}
