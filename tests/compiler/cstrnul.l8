tag example;

import "../../stdlib/print.l8";

main(): int {
    bytes_with_nul: []i8 = new i8[3](0i8);
    bytes_with_nul[0] = 'a';
    bytes_with_nul[2] = 'b';
    s: str = cstr(bytes_with_nul);
    len(s)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        [exit 1]
    |}
}
