tag bounds_test;

pick(
    a: []int,
    i: int,
    j: int,
    flag: bool
): int {
    if (i < 0) return 0;
    if (flag) {
        if (i >= j || j >= len(a)) return 0
    } else {
        if (i > len(a)) return 0
    }
    a[i]
}

main(): int {
    a: []int = [1, 2, 3];
    pick(a, 3, 3, false)
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "bounds"
