tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    digits: str = "0123456789abcdef";
    byte: int = -1 & 255;
    digits[byte / 16] as int
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 102
    |}
}
