tag example;

use_tag std;

import "../../stdlib/print.l8";

type Rec = {
    x: int
}

id(n: int): int {
    n
}

// An if expression narrows its branches wherever it is: here, an argument.
in_argument(p: ?*Rec): int {
    id(if (p != null) p.x else 0) + id(if (p == null) 0 else p.x)
}

// The else is checked without what the then assigned.
else_after_then(p: ?*Rec, c: bool): int {
    q: ?*Rec = p;
    n: int = 0;
    if (q != null) {
        if (c) q = null else n = q.x
    }
    n
}

test "an if expression narrows as an if statement does" {
    r: Rec = Rec { x: 5 };
    print_int(in_argument(&r));
    print_int(in_argument(null));
    print_int(else_after_then(&r, false));
    print_int(else_after_then(&r, true));
    expect {|
        10
        0
        5
        0
    |}
}
