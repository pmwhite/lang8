tag example;

import "../../stdlib/print.l8";

type Triple = {
    a: int;
    b: int;
    c: int
}

scale8(value: int): int {
    value * 8
}

scale32(value: int): int {
    32 * value
}

main(): int {
    if (scale8(-3) != -24 || scale32(-3) != -96) return 1;
    // Shift-based multiplication must preserve wrapping integer arithmetic.
    if (scale8(9223372036854775807) != -8) return 2;
    if (scale32(9223372036854775807) != -32) return 3;
    values: []int = [11, 22, 33];
    values[0] = 7;
    values[2] = 19;
    if (values[0] != 7 || values[1] != 22 || values[2] != 19) return 4;
    rows: []Triple = new Triple[3](Triple { a: 1, b: 2, c: 3 });
    rows[2].b = 91;
    if (rows[0].b != 2 || rows[2].b != 91) return 5;
    total: int = 0;
    for value in values total = total + value;
    if (total != 48) return 6;
    for i in -3..3 total = total + i;
    if (total != 45) return 7;
    for _i in 5..2 total = 0;
    if (total != 45) return 8;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
