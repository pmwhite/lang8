tag example;

import "../../stdlib/print.l8";

type Triple = {
    a: int;
    b: int;
    c: int
}

scale8(value: int): int {
    value * 8
}

scale32(value: int): int {
    32 * value
}

so_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "multiplication by powers of two" {
    so_show("scale8(-3)", scale8(-3));
    so_show("scale32(-3)", scale32(-3));
    expect {|
        scale8(-3): -24
        scale32(-3): -96
    |}
    // Shift-based multiplication must preserve wrapping integer arithmetic.
    so_show("scale8(max)", scale8(9223372036854775807));
    so_show("scale32(max)", scale32(9223372036854775807));
    expect {|
        scale8(max): -8
        scale32(max): -32
    |}
}

test "scaled element offsets and loops" {
    values: []int = [11, 22, 33];
    values[0] = 7;
    values[2] = 19;
    so_show("values[0]", values[0]);
    so_show("values[1]", values[1]);
    so_show("values[2]", values[2]);
    expect {|
        values[0]: 7
        values[1]: 22
        values[2]: 19
    |}
    rows: []Triple = new Triple[3](Triple { a: 1, b: 2, c: 3 });
    rows[2].b = 91;
    so_show("rows[0].b", rows[0].b);
    so_show("rows[2].b", rows[2].b);
    expect {|
        rows[0].b: 2
        rows[2].b: 91
    |}
    total: int = 0;
    for value in values total = total + value;
    so_show("total", total);
    expect {|
        total: 48
    |}
    for i in -3..3 total = total + i;
    so_show("after -3..3", total);
    expect {|
        after -3..3: 45
    |}
    // An empty range runs no iterations.
    for _i in 5..2 total = 0;
    so_show("after 5..2", total);
    expect {|
        after 5..2: 45
    |}
}
