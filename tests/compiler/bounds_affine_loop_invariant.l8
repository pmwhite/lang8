tag bounds_test;

scan(data: []int): int {
    i: int = 0;
    total: int = 0;
    while (i < len(data)) invariant (0 <= i && i <= len(data)) {
        total = total + data[i];
        i = i + 1
    }
    total
}

main(): int {
    scan([3, 5, 7])
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 15
