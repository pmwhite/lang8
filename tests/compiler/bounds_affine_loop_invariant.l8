tag bounds_test;

import "../../stdlib/print.l8";

scan(data: []int): int {
    i: int = 0;
    total: int = 0;
    while (i < len(data)) invariant (0 <= i && i <= len(data)) {
        total = total + data[i];
        i = i + 1
    }
    total
}

main(): int {
    scan([3, 5, 7])
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 15
    |}
}
