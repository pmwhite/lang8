tag example;

import "../../stdlib/raw_write.l8";

/* Dynamic ELF: need a shared library and call an undefined extern through the PLT. */
need "libm.so.6";

extern cosf(value: f32): f32;

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

main(): int {
    if (cosf(0.0) == 1.0) putchar('Y');
    putchar('\n');
    0
}

//% test: run
//% stdout: "Y\n"
//% exit: 0
