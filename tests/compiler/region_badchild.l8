tag example;

/* set_child requires the child to outlive the parent. */
type Node = {
    child: ?*Node
}

set_child(parent: *Node, child: *Node@parent) {
    parent.child = child
}

main(): int {
    region {
        outer: *Node = new Node { child: null };
        region {
            inner: *Node = new Node { child: null };
            set_child(outer, inner)
        }
    }
    0
}

/* expect compile {|
error: region_badchild.l8:1:1: region pointer cannot escape in main
|} */
