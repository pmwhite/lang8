tag example;

use_tag std;

import "../../stdlib/print.l8";

type Rec = {
    x: int
}

// A variable given a value that cannot be null is narrowed after it, and
// may still be tested against null, or compared as declared.
stored(r: *Rec): int {
    p: ?*Rec = null;
    p = r;
    n: int = p.x;
    if (p != null) n = n + 1;
    n
}

compared(): int {
    left: ?str = "same";
    right: ?str = "same";
    none: ?str = null;
    n: int = 0;
    if (left == right) n = n + 1;
    if (left != none) n = n + 10;
    if (left != null) n = n + 100;
    n
}

// Its address is of its declared type, so a null stored through it ends
// the narrowing.
through_address(r: *Rec): int {
    p: ?*Rec = r;
    pp: *?*Rec = &p;
    pp.* = null;
    if (p == null) 1 else 0
}

test "a stored value narrows" {
    r: Rec = Rec { x: 5 };
    print_int(stored(&r));
    print_int(compared());
    print_int(through_address(&r));
    expect {|
        6
        111
        1
    |}
}
