tag example;

type Samples = {
    values: []f64
}

first(values: []f64): f64 {
    values[0]
}

// The slices themselves are chosen, and they borrow from two unrelated
// parameters, so their lifetimes are still compared.
first_of_either(left: *Samples, right: *Samples, use_left: bool): f64 {
    first(if (use_left) left.values else right.values)
}

main(): int {
    0
}

/* expect compile {|
incomparable lifetimes in first_of_either
error: lifetime_pointer_choice.l8:14:5: incomparable lifetimes
|} */
