tag bounds_test;

import "../../stdlib/print.l8";

slot(i: int): int ensures (0 <= returned && returned <= 7) {
    remainder: int = i % 8;
    if (remainder < 0) remainder = remainder + 8;
    remainder
}

main(): int {
    if (slot(0 - 1) == 7 && slot(9) == 1) 0 else 1
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
