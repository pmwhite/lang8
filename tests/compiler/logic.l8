tag example;

import "../../stdlib/raw_write.l8";

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

test "logic" {
    if (true && true) putchar('Y');
    if (true && false) putchar('N');
    if (false || true) putchar('Y');
    if (false || false) putchar('N');
    if (true && false || true) putchar('Y');
    if (!false) putchar('Y');
    putchar('\n');
    expect {|
        YYYY
    |}
}
