tag example;

import "../../stdlib/print.l8";

use_tag std;

// A variant small enough to travel in a register (it has no payloads),
// matched as a call returns it.
type Form =
    | Packaged
    | Unpacked
    | Made

form_of(n: int): Form {
    if (n == 0) Form.Packaged else if (n == 1) Form.Unpacked else Form.Made
}

test "a match on a variant a call returns" {
    for n in 0..3 {
        match form_of(n) {
            Packaged -> std::print("packaged");
            Made -> std::print("made");
            _ -> std::print("unpacked")
        }
    }
    expect {|
        packaged
        unpacked
        made
    |}
}
