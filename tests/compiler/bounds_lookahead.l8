tag bounds_test;

import "../../stdlib/print.l8";

peek(s: str, p: int): int {
    if (p < 0 || p >= len(s) || p + 2 >= len(s)) return 0;
    s[p + 2] as int
}

main(): int {
    peek("abcd", 1)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 100
    |}
}
