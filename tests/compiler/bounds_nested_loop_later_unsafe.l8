tag bounds_test;

// The first outer iteration is safe. Reusing loop candidates must still
// analyze the body after the outer header weakens and exposes an unsafe case.
main(): int {
    data: []int = [2, 3];
    total: int = 0;
    outer: int = 0;
    while (outer < 2) invariant (0 <= outer && outer <= 2) {
        for inner in 0..outer + 2 total = total + data[inner];
        outer = outer + 1
    }
    total
}

//% test: compile-fail
//% error-contains: "bounds"
