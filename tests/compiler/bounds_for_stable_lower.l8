tag bounds_test;

import "../../stdlib/print.l8";

offset(start: int, position: int): int requires (start <= position) {
    position - start
}

sum_offsets(start: int, end: int): int requires (0 <= start && start <= end && end <= 20) {
    total: int = 0;
    for position in start..end total = total + offset(start, position);
    total
}

main(): int {
    sum_offsets(2, 5)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
