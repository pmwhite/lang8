tag bulk_assembly_test;

// Exercise all bulk-store encodings through compile/as/elfpack as well as build.
// Full signed/unsigned/floating-point element checks live in codegen_fills.l8.
type Odd = {
    bytes: [17]i8
}

main(): int {
    bytes: []i8 = new i8[3](255i8);
    words: []int = new int[3](-1);
    narrow: []i32 = new i32[3](-17i32);
    empty: []u32 = new u32[0](0u32);
    if (bytes[2] != 255i8 || words[2] != -1) return 1;
    if (len(narrow) != 3 || len(empty) != 0) return 2;
    value: Odd = Odd { bytes: [1i8, 2i8, 3i8, 4i8, 5i8, 6i8, 7i8, 8i8, 9i8, 10i8,
        11i8, 12i8, 13i8, 14i8, 15i8, 16i8, 17i8] };
    copies: []Odd = new Odd[3](value);
    copies[1] = copies[2];
    for i in 0..17 {
        if (copies[0].bytes[i] as int != i + 1 || copies[1].bytes[i] as int != i + 1 || copies[2].bytes[i] as int != i + 1) return 3
    }
    0
}

//% test: run
//% stdout: ""
//% exit: 0
