tag bounds_test;

type Fixed = {
    data: []int;
    marker: int
} invariant (4 == len(data))

main(): int {
    value: *Fixed = new Fixed { data: new int[4](0), marker: 0 };
    value.data = new int[3](0);
    value.data[0]
}

