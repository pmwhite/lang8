tag bounds_test;

import "../../stdlib/print.l8";

type Counter = {
    value: int
}

reset(c: *Counter): int ensures (c.value == 4) {
    c.value = 4;
    0
}

main(): int {
    c: *Counter = new Counter { value: 0 };
    result: int = reset(c);
    if (result != 0) return 1;
    if (c.value != 4) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
