tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

replace_data(b: *Buffer@new) {
    b.data = new int[1](9)
}

read_after_other_write(a: *Buffer, b: *Buffer@new): int {
    if (a.cursor < 0 || a.cursor >= len(a.data)) return -1;
    replace_data(b);
    a.data[a.cursor]
}

main(): int {
    a: *Buffer = new Buffer { data: [7], cursor: 0 };
    b: *Buffer = new Buffer { data: [1], cursor: 0 };
    a = b;
    read_after_other_write(a, b)
}

/* expect compile {|
error: bounds_separate_params_reassigned.l8:22:5: call requires distinct record arguments for bounds proof
|} */
