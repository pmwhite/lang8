tag loop_cleanup_test;

import "../../stdlib/print.l8";

extern l8_heap_mark(): int;

exception Boom;

fail() raises Boom {
    raise Boom
}

test "jumps unwind only regions entered inside the loop" {
    region {
        outer: *int = new int[1](7);
        before: int = l8_heap_mark();
        for index in 0..100 {
            region {
                allocation: []int = new int[1024](index);
                if (allocation[0] < 99)
                    continue;
                break
            }
        }
        after: int = l8_heap_mark();
        std::print_bool(before == after);
        std::print_int(outer.*)
    }
    expect {|
        true
        7
    |}
}

test "jumps remove exited handlers and preserve enclosing handlers" {
    caught: int = 0;
    try {
        for index in 0..3 {
            try {
                region {
                    if (index == 0)
                        continue;
                    break
                }
            } with Boom -> {
                caught = caught + 100
            }
        }
        fail()
    } with Boom -> {
        caught = caught + 1
    }
    std::print_int(caught);
    expect {|
        1
    |}
}

test "jumps from catch arms do not pop the enclosing handler" {
    caught: int = 0;
    try {
        for index in 0..3 {
            try {
                fail()
            } with Boom -> {
                if (index == 0)
                    continue;
                break
            }
        }
        fail()
    } with Boom -> {
        caught = caught + 1
    }
    std::print_int(caught);
    expect {|
        1
    |}
}
