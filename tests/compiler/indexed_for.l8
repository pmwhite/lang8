tag indexed_loop_test;

import "../../stdlib/print.l8";

calls: int = 0;

values(): []int@new {
    calls = calls + 1;
    [10, 20, 30, 40]
}

test "index and value are refreshed copies and evaluate the collection once" {
    total: int = 0;
    for index, value in values() {
        if (index == 1)
            continue;
        if (index == 3)
            break;
        total = total + index + value;
        index = 100;
        value = 100
    }
    std::print_int(total);
    std::print_int(calls);
    expect {|
        42
        1
    |}
}

test "fixed arrays, strings, empty collections and nested scopes" {
    array: [2]int = [7, 8];
    total: int = 0;
    for index, value in array total = total + index + value;
    for index, byte in "ab" total = total + index + byte as int;
    empty: []int = new int[0](0);
    for _index, _value in empty total = -100;
    for index, value in [2, 3] {
        for index, value in [4] total = total + index + value;
        total = total + index + value
    }
    std::print_int(total);
    std::print_int(array[0]);
    expect {|
        226
        7
    |}
}
