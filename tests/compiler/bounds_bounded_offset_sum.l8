tag bounds_test;

import "../../stdlib/print.l8";

write_vertices(a: []int, base: int) requires (0 <= base && base <= len(a) - 2916) {
    for vertex in 0..324 {
        offset: int = vertex * 9 + 8;
        a[base + offset] = 1
    }
}

main(): int {
    a: []int = new int[2916](0);
    write_vertices(a, 0);
    a[2915]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 1
    |}
}
