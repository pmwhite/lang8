tag bounds_test;

write_vertices(a: []int, base: int) requires (0 <= base && base <= len(a) - 2916) {
    for vertex in 0..324 {
        offset: int = vertex * 9 + 8;
        a[base + offset] = 1
    }
}

main(): int {
    a: []int = new int[2916](0);
    write_vertices(a, 0);
    a[2915]
}

//% test: run
//% stdout: ""
//% exit: 1
