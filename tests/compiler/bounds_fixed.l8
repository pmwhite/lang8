tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    a: [3]i8 = ['A', 'B', 'C'];
    total: int = 0;
    for i in 0..len(a) total = total + a[i] as int;
    total % 256
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 198
    |}
}
