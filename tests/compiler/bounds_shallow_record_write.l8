tag bounds_test;

import "../../stdlib/print.l8";

type Entry = {
    value: int;
    next: ?*Entry
}

type Table = {
    rows: []Entry;
    numbers: []int
} invariant (len(rows) == len(numbers))

main(): int {
    table: *Table = new Table { rows: new Entry[2](Entry { value: 0, next: null }), numbers: new int[2](3) };
    i: int = len(table.rows) - 1;
    table.rows[i] = Entry { value: 1, next: null };
    table.numbers[i]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
