tag bounds_test;

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2 };
    used: *int = &b.used;
    used.* = 3;
    b.used
}

/* expect compile {|
error: bounds_record_invariant_field_address.l8:1:1: cannot take the address of a field in a record with an invariant
|} */
