tag bounds_test;

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2 };
    used: *int = &b.used;
    used.* = 3;
    b.used
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "cannot take the address of a field in a record with an invariant"
