tag example;

import "../../stdlib/raw_write.l8";

/* `e or alt` unwraps ?*T to *T (alt is *T or noreturn). */
extern exit(code: int): noreturn;

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

die(): noreturn {
    exit(1)
}

type Box = {
    v: int
}

first(a: ?*int, b: ?*int@a): *int@a {
    a or b or die()
}

field_v(p: ?*Box): int {
    (p or die()).v
}

test "or" {
    x: int = 3;
    y: int = 7;
    p: ?*int = &x;
    q: ?*int = null;
    if ((p or die()).* == 3) putchar('Y');
    if ((q or &y).* == 7) putchar('Y');
    heap: []int = new int[1](3);
    hp: ?*int = &heap[0];
    if (first(q, hp).* == 3) putchar('Y');
    hb: []Box = new Box[1](Box { v: 9 });
    if (field_v(&hb[0]) == 9) putchar('Y');
    putchar('\n');
    expect {|
        YYYY
    |}
}
