tag bounds_test;

import "../../stdlib/print.l8";

sum_prefix(a: []int, count: int): int {
    total: int = 0;
    for i in 0..count total = total + a[i];
    total
}

forward(a: []int, count: int): int {
    sum_prefix(a, count)
}

main(): int {
    a: []int = [3, 5];
    forward(a, 2)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 8
    |}
}
