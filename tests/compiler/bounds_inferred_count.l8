tag bounds_test;

sum_prefix(a: []int, count: int): int {
    total: int = 0;
    for i in 0..count total = total + a[i];
    total
}

forward(a: []int, count: int): int {
    sum_prefix(a, count)
}

main(): int {
    a: []int = [3, 5];
    forward(a, 2)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 8
