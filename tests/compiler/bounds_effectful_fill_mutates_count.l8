tag effectful_fill;

type State = {
    size: int;
    cached: int
}

type Buffer = {
    data: []int;
    size: int
} invariant (0 <= size && size == len(data))

type Pair = {
    first: []int;
    second: []int
} invariant (len(first) == len(second))

fill(s: *State): int {
    s.size = s.size + 1;
    7
}

main(): int {
    s: *State = new State { size: 4, cached: 0 };
    a: Buffer = Buffer { data: new int[s.size](fill(s)), size: s.size };
    len(a.data)
}

//% test: compile-fail
//% error-contains: "record invariant is not proved"
