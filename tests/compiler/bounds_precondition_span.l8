tag bounds_test;

import "../../stdlib/print.l8";

copy_span(
    dst: []int,
    src: []int,
    offset: int,
    count: int
) requires (0 <= offset && offset <= len(dst) && 0 <= count && count <= len(src) && count <= len(dst) - offset) {
    for i in 0..count dst[offset + i] = src[i]
}

copy_if_fits(
    dst: []int,
    src: []int,
    offset: int,
    count: int
): bool {
    if (offset < 0 || offset > len(dst) || count < 0 || count > len(src) || count > len(dst) - offset) return false;
    copy_span(dst, src, offset, count);
    true
}

main(): int {
    dst: []int = [0, 0, 0, 0];
    src: []int = [7, 9];
    if (!copy_if_fits(dst, src, 1, 2)) return 1;
    copy_span(dst, src, 1, len(src));
    dst[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
