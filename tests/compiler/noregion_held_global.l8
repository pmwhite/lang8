tag example;

type Bytes = {
    data: []i8;
    size: int
}

bytes_add(builder: *Bytes@new, byte: i8) {
    if (builder.size == len(builder.data)) {
        grown: []i8 = new i8[len(builder.data) * 2](0i8);
        memcpy(grown, 0, builder.data, 0, builder.size);
        builder.data = grown
    }
    builder.data[builder.size] = byte;
    builder.size = builder.size + 1
}

log: *Bytes = new Bytes { data: new i8[1](0i8), size: 0 };

// Grows a global builder: its storage must come from the process heap.
log_byte(byte: i8) {
    bytes_add(log, byte)
}

main(): int {
    log_byte(65i8);
    log.size
}

/* expect compile {|
noregion_held_global.l8:22:15

    bytes_add(log, byte)
              ^^^

log_byte passes immortal storage to parameter builder of bytes_add,
which stores its allocations there, so they must not belong to a region.

For retained storage, declare log_byte and its callers as noregion
(unavailable inside regions), or keep the storage it grows local to the
region that uses it.

Callers also needing noregion: main.

|} */
