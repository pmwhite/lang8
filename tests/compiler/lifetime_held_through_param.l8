tag example;

type Bytes = {
    data: []i8;
    size: int
}

bytes_new(capacity: int): *Bytes@new {
    new Bytes { data: new i8[capacity](0i8), size: 0 }
}

bytes_add(builder: *Bytes@new, byte: i8) {
    if (builder.size == len(builder.data)) {
        grown: []i8 = new i8[len(builder.data) * 2](0i8);
        memcpy(grown, 0, builder.data, 0, builder.size);
        builder.data = grown
    }
    builder.data[builder.size] = byte;
    builder.size = builder.size + 1
}

// Passes its own builder on at its own allocation destination, so it holds
// what bytes_add allocates as well.
bytes_add_pair(builder: *Bytes@new, byte: i8) {
    bytes_add(builder, byte);
    bytes_add(builder, byte)
}

main(): int {
    builder: *Bytes = bytes_new(1);
    region {
        bytes_add_pair(builder, 65i8)
    }
    builder.size
}

/* expect compile {|
error: lifetime_held_through_param.l8:32:24: bytes_add_pair stores what it allocates into parameter builder, but this argument outlives those allocations (they end with the region or arena the call allocates in); make the call where the argument was allocated
|} */
