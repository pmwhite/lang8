tag bounds_test;

import "../../stdlib/print.l8";

type Pack = {
    data: []int
} invariant (len(data) == 4)

last(a: []int): int {
    a[3]
}

forward(p: *Pack): int {
    last(p.data)
}

main(): int {
    p: *Pack = new Pack { data: new int[4](6) };
    forward(p)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 6
    |}
}
