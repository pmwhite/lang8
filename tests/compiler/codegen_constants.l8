tag constant_test;

import "../../stdlib/print.l8";

const base: int = 7;

constant(): int {
    (3 + 4) * 8
}

compute(a: int, b: int): int {
    (a + b) * 8
}

dead_division(): int {
    if (false) 1 / 0 else 7
}

main(): int {
    if (constant() != compute(3, 4) || base * 8 != 56) return 1;
    x: i32 = 2147483647i32;
    if (2147483647i32 + 1i32 != x + 1i32) return 2;
    u: u32 = 4294967295u32;
    if (4294967295u32 + 2u32 != u + 2u32) return 3;
    b: i8 = 255i8;
    if (255i8 + 3i8 != b + 3i8) return 4;
    if ((-3 + 1) * 8 != -16 || (7 & 3) != 3 || (5 ^ 3) != 6) return 5;
    if (!(3 < 4) || 3 > 4 || !(3 != 4)) return 6;
    f: f64 = -1.5f64;
    if (-1.5f64 < -1.0f64 != f < -1.0f64) return 7;
    count: int = 63;
    if (1 << 63 != 1 << count || 1 << 64 != 0 || 7 / 2 != 3 || dead_division() != 7) return 8;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
