tag constant_test;

import "../../stdlib/print.l8";

const base: int = 7;

constant(): int {
    (3 + 4) * 8
}

compute(a: int, b: int): int {
    (a + b) * 8
}

dead_division(): int {
    if (false) 1 / 0 else 7
}

constant_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

constant_show_bool(label: str, value: bool) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_bool(value)
}

test "folded calls and constants" {
    constant_show("constant()", constant());
    constant_show("compute(3, 4)", compute(3, 4));
    constant_show("base * 8", base * 8);
    expect {|
        constant(): 56
        compute(3, 4): 56
        base * 8: 56
    |}
}

test "folded fixed-width arithmetic wraps like runtime arithmetic" {
    x: i32 = 2147483647i32;
    constant_show("2147483647i32 + 1i32", (2147483647i32 + 1i32) as int);
    constant_show("x + 1i32", (x + 1i32) as int);
    expect {|
        2147483647i32 + 1i32: -2147483648
        x + 1i32: -2147483648
    |}
    u: u32 = 4294967295u32;
    constant_show("4294967295u32 + 2u32", (4294967295u32 + 2u32) as int);
    constant_show("u + 2u32", (u + 2u32) as int);
    expect {|
        4294967295u32 + 2u32: 1
        u + 2u32: 1
    |}
    b: i8 = 255i8;
    constant_show("255i8 + 3i8", (255i8 + 3i8) as int);
    constant_show("b + 3i8", (b + 3i8) as int);
    expect {|
        255i8 + 3i8: 2
        b + 3i8: 2
    |}
}

test "folded integer operators" {
    constant_show("(-3 + 1) * 8", (-3 + 1) * 8);
    constant_show("7 & 3", 7 & 3);
    constant_show("5 ^ 3", 5 ^ 3);
    expect {|
        (-3 + 1) * 8: -16
        7 & 3: 3
        5 ^ 3: 6
    |}
}

test "folded comparisons" {
    constant_show_bool("3 < 4", 3 < 4);
    constant_show_bool("3 > 4", 3 > 4);
    constant_show_bool("3 != 4", 3 != 4);
    expect {|
        3 < 4: true
        3 > 4: false
        3 != 4: true
    |}
    f: f64 = -1.5f64;
    constant_show_bool("-1.5f64 < -1.0f64", -1.5f64 < -1.0f64);
    constant_show_bool("f < -1.0f64", f < -1.0f64);
    expect {|
        -1.5f64 < -1.0f64: true
        f < -1.0f64: true
    |}
}

test "folded shifts and division" {
    count: int = 63;
    constant_show("1 << 63", 1 << 63);
    constant_show("1 << count", 1 << count);
    constant_show("1 << 64", 1 << 64);
    expect {|
        1 << 63: -9223372036854775808
        1 << count: -9223372036854775808
        1 << 64: 0
    |}
    constant_show("7 / 2", 7 / 2);
    constant_show("dead_division()", dead_division());
    expect {|
        7 / 2: 3
        dead_division(): 7
    |}
}
