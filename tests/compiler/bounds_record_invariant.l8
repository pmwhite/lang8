tag bounds_test;

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

sum_used(b: *Buffer): int {
    total: int = 0;
    for i in 0..b.used total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 1 };
    b.used = 2;
    sum_used(b)
}

//% test: run
//% stdout: ""
//% exit: 11
