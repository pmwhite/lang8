tag bounds_test;

import "../../stdlib/print.l8";

bounded_count(a: []int, offset: int, count: int): int requires (0 <= offset && offset <= len(a) && 0 <= count && count <= len(a) - offset) ensures (0 <= returned && returned <= len(a) - offset) {
    count
}

main(): int {
    a: []int = [2, 4, 6, 8];
    count: int = bounded_count(a, 1, 2);
    for i in 0..count a[1 + i] = 9;
    a[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
