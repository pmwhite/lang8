tag example;

/* Storing a parameter in a global infers @immortal; the omitted bound is a lie. */
g: ?*int = null;

stash(p: *int) {
    g = p
}

main(): int {
    x: int = 0;
    stash(&x);
    0
}

/* expect compile {|
error: stash.l8:6:7: use @immortal on p in stash
error: stash.l8:1:1: lifetime marks do not match
|} */
