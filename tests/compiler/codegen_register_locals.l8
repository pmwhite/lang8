tag example;

import "../../stdlib/print.l8";

exception Stop;

// The caller and callee both keep hot locals live across nested calls.
mix(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    value: int = g;
    for i in 0..5 value = value + h + i;
    value + a + b + c + d + e + f
}

// A mutable eighth argument starts on the caller's stack.
stack_parameter(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    for i in 0..20 h = h + i;
    a + b + c + d + e + f + g + h
}

nested(seed: int): int {
    total: int = seed;
    for i in 0..20 total = total + mix(1, 2, 3, 4, 5, 6, i, seed);
    total
}

set(p: *int, value: int) {
    p.* = value
}

aliased(): int {
    value: int = 0;
    total: int = 0;
    for i in 0..20 {
        set(&value, i);
        total = total + value
    }
    total
}

throw_after_work() raises Stop {
    _value: int = nested(3);
    raise Stop
}

caught(): int {
    value: int = 1;
    try {
        for i in 0..10 value = value + i;
        throw_after_work()
    } with Stop -> {
        value = value + 100
    }
    value
}

branching(seed: int): int {
    value: int = seed;
    for i in 0..20 {
        if (i == 9) return value;
        value = value + i
    }
    value
}

main(): int {
    if (stack_parameter(1, 2, 3, 4, 5, 6, 7, 8) != 226) return 5;
    if (nested(3) != 1113) return 1;
    if (aliased() != 190) return 2;
    if (caught() != 146) return 3;
    if (branching(7) != 43) return 4;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
