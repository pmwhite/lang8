tag example;

import "../../stdlib/print.l8";

exception Stop;

// The caller and callee both keep hot locals live across nested calls.
mix(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    value: int = g;
    for i in 0..5 value = value + h + i;
    value + a + b + c + d + e + f
}

// A mutable eighth argument starts on the caller's stack.
stack_parameter(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    for i in 0..20 h = h + i;
    a + b + c + d + e + f + g + h
}

nested(seed: int): int {
    total: int = seed;
    for i in 0..20 total = total + mix(1, 2, 3, 4, 5, 6, i, seed);
    total
}

set(p: *int, value: int) {
    p.* = value
}

aliased(): int {
    value: int = 0;
    total: int = 0;
    for i in 0..20 {
        set(&value, i);
        total = total + value
    }
    total
}

throw_after_work() raises Stop {
    _value: int = nested(3);
    raise Stop
}

caught(): int {
    value: int = 1;
    try {
        for i in 0..10 value = value + i;
        throw_after_work()
    } with Stop -> {
        value = value + 100
    }
    value
}

branching(seed: int): int {
    value: int = seed;
    for i in 0..20 {
        if (i == 9) return value;
        value = value + i
    }
    value
}

register_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "a mutable stack parameter" {
    result: int = stack_parameter(1, 2, 3, 4, 5, 6, 7, 8);
    register_show("stack_parameter(1, 2, 3, 4, 5, 6, 7, 8)", result);
    expect {|
        stack_parameter(1, 2, 3, 4, 5, 6, 7, 8): 226
    |}
}

test "hot locals live across nested calls" {
    register_show("nested(3)", nested(3));
    expect {|
        nested(3): 1113
    |}
}

test "a local whose address is taken" {
    register_show("aliased()", aliased());
    expect {|
        aliased(): 190
    |}
}

test "a local updated before a caught exception" {
    register_show("caught()", caught());
    expect {|
        caught(): 146
    |}
}

test "a local returned from inside a loop" {
    register_show("branching(7)", branching(7));
    expect {|
        branching(7): 43
    |}
}
