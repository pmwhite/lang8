// The runtime gives main argc elements of argv. The fixture checks that main
// verifies with that fact; a test cannot call main without losing it.
main(argc: int, argv: []str): int {
    if (argc < 1) return 1;
    for ch in argv[0] {
        if (ch == 0i8) return 2
    }
    if (len(argv[0]) == 0) return 3;
    0
}
