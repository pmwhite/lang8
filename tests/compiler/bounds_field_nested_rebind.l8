tag bounds_test;

type Inner = {
    data: []int
}

type Outer = {
    child: *Inner
}

main(): int {
    inner: *Inner = new Inner { data: [5, 9] };
    o: *Outer = new Outer { child: inner };
    o.child.data = [4, 7];
    o.child = new Inner { data: new int[0](0) };
    o.child.data[1]
}

/* expect compile {|
error: bounds_field_nested_rebind.l8:16:17: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 1 && 1 < len(o.child.data))
|} */
