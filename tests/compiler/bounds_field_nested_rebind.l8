tag bounds_test;

type Inner = {
    data: []int
}

type Outer = {
    child: *Inner
}

main(): int {
    inner: *Inner = new Inner { data: [5, 9] };
    o: *Outer = new Outer { child: inner };
    o.child.data = [4, 7];
    o.child = new Inner { data: new int[0](0) };
    o.child.data[1]
}

//% test: compile-fail
//% error-contains: "unproved array access requires raises IndexOutOfBounds"
