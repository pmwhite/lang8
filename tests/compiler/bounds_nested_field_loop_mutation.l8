tag bounds_test;

type Inner = {
    values: []int
}

type Outer = {
    inner: *Inner
}

bad(box: *Outer@new) {
    for i in 0..len(box.inner.values) {
        box.inner.values = new int[0](0);
        box.inner.values[i] = 1
    }
}

main() {
    inner: *Inner = new Inner { values: [1] };
    box: *Outer = new Outer { inner: inner };
    bad(box)
}

//% test: compile-fail
//% error-contains: "unproved array access; add a guard, contract, or invariant"
