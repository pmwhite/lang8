tag bounds_test;

type Inner = {
    values: []int
}

type Outer = {
    inner: *Inner
}

bad(box: *Outer@new) {
    for i in 0..len(box.inner.values) {
        box.inner.values = new int[0](0);
        box.inner.values[i] = 1
    }
}

main() {
    inner: *Inner = new Inner { values: [1] };
    box: *Outer = new Outer { inner: inner };
    bad(box)
}

/* expect compile {|
error: bounds_nested_field_loop_mutation.l8:14:25: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= i && i < len(box.inner.values))
|} */
