tag example;

type Shape =
    | 30 Rectangle { width: int, height: int }
    | 10 Circle { radius: int }
    | 20 Empty

main(): int {
    shape: Shape = Shape.Empty;
    match shape {
        Rectangl rectangle -> rectangle.width;
        _ -> 0
    }
}

