tag example;

/* A region pointer cannot be stored in a local that outlives the region. */
type Cell = {
    v: int
}

main(): int {
    p: ?*Cell = null;
    region {
        q: *Cell = new Cell { v: 1 };
        p = q
    }
    0
}

/* expect compile {|
error: region_outer.l8:1:1: region pointer cannot escape in main
|} */
