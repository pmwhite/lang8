tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer): int {
    b.data[b.cursor]
}

forward(b: *Buffer): int {
    get(b)
}

main(): int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    if (b.cursor < 0 || b.cursor >= len(b.data)) return 1;
    forward(b)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 7
