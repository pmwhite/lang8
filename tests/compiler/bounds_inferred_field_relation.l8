tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer) raises IndexOutOfBounds: int {
    b.data![b.cursor]
}

forward(b: *Buffer) raises IndexOutOfBounds: int {
    get(b)
}

main() raises IndexOutOfBounds: int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    if (b.cursor < 0 || b.cursor >= len(b.data)) return 1;
    forward(b)
}

//% test: run
//% stdout: ""
//% exit: 7
