tag example;

/* A region pointer cannot ride an exception past the rewind. */
exception Hold {
    p: *int
}

main() raises Hold: int {
    region {
        p: *int = new int[1](1);
        raise Hold { p: p }
    }
    0
}

/* expect compile {|
error: exc_regionbad.l8:1:1: exception payload cannot hold a region pointer
|} */
