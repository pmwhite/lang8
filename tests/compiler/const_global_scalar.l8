tag bounds_test;

import "../../stdlib/print.l8";

const ENABLED: bool = true;

const RATE: f32 = 0.25;

const OFFSET: f64 = -0.5f64;

const BYTE: i8 = 255i8;

const SIGNED: i32 = -2i32;

const MASK: u32 = 4294967295u32;

main(): int {
    if (ENABLED && RATE * 4.0 == 1.0 && OFFSET + 0.5f64 == 0.0f64 && BYTE == 255i8 && SIGNED == -2i32 && MASK == 4294967295u32) return 7;
    1
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
