tag bounds_test;

import "../../stdlib/print.l8";

const ENABLED: bool = true;

const RATE: f32 = 0.25;

const OFFSET: f64 = -0.5f64;

const BYTE: i8 = 255i8;

const SIGNED: i32 = -2i32;

const MASK: u32 = 4294967295u32;

cgs_show_bool(label: str, value: bool) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_bool(value)
}

cgs_show_int(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "scalar constants" {
    cgs_show_bool("ENABLED", ENABLED);
    cgs_show_bool("RATE * 4.0 == 1.0", RATE * 4.0 == 1.0);
    cgs_show_bool("OFFSET + 0.5 == 0.0", OFFSET + 0.5f64 == 0.0f64);
    expect {|
        ENABLED: true
        RATE * 4.0 == 1.0: true
        OFFSET + 0.5 == 0.0: true
    |}
    cgs_show_int("BYTE", BYTE as int);
    cgs_show_int("SIGNED", SIGNED as int);
    cgs_show_int("MASK", MASK as int);
    expect {|
        BYTE: 255
        SIGNED: -2
        MASK: 4294967295
    |}
}
