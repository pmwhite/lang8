tag bounds_test;

exception Retry;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

recover(i: int): int {
    a: []int = [7];
    try {
        if (i < 0 || i >= len(a)) return 0;
        i = 1;
        raise Retry
    } with Retry -> {
        return consume(a, i)
    }
}

main(): int {
    recover(0)
}

//% test: compile-fail
//% error-contains: "precondition"
