tag bounds_test;

import "../../stdlib/print.l8";

const CAPACITY: int = 4;

take(a: []int, i: int): int requires (0 <= i && i < CAPACITY && CAPACITY <= len(a)) {
    a[i]
}

test "a constant in a requires clause bounds the index" {
    a: []int = [1, 2, 3, 4];
    std::write(1, "take(a, 2): ");
    std::print_int(take(a, 2));
    expect {|
        take(a, 2): 3
    |}
}
