tag bounds_test;

import "../../stdlib/print.l8";

const CAPACITY: int = 4;

take(a: []int, i: int): int requires (0 <= i && i < CAPACITY && CAPACITY <= len(a)) {
    a[i]
}

main(): int {
    a: []int = [1, 2, 3, 4];
    take(a, 2)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
