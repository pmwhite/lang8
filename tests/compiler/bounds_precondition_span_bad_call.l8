tag bounds_test;

copy_span(
    dst: []int,
    src: []int,
    offset: int,
    count: int
) requires (0 <= offset && offset <= len(dst) && 0 <= count && count <= len(src) && count <= len(dst) - offset) {
    for i in 0..count dst[offset + i] = src[i]
}

main(): int {
    dst: []int = [0, 0];
    src: []int = [7, 9];
    copy_span(dst, src, 1, 2);
    0
}

//% test: compile-fail
//% error-contains: "call does not prove function precondition"
