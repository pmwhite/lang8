tag compiler_internal;

import "../../src2/common.l8";

import "../../src2/assembler.l8";

import "../../src2/direct.l8";

import "../../src2/compiler.l8";

import "../../src2/elfpack.l8";

import "../../src2/browse.l8";

import "../../src2/fmt.l8";

import "../../src2/boolint.l8";

import "../../src2/forlint.l8";

import "../../src2/unreachable.l8";

import "../../src2/unusedfields.l8";

import "../../src2/unusedassign.l8";

import "../../src2/bounds_model.l8";

import "../../src2/bounds_terms.l8";

import "../../src2/bounds_state.l8";

import "../../src2/bounds_solver.l8";

import "../../src2/bounds_contracts.l8";

import "../../src2/bounds_effects.l8";

import "../../src2/bounds_records.l8";

import "../../src2/bounds_returns.l8";

import "../../src2/bounds_flow.l8";

import "../../src2/bounds_driver.l8";

// Exercise the proof engine directly against an independent all-pairs
// reference. Feasible graphs include negative edges, cycles, and collisions.
main() noregion raises Error: int {
    init_dummies();
    init_runtime();
    first: *Obj = new_obj("first", true);
    first.ty = ty_int;
    terms: []*Expr = new *Expr[24](bounds_obj_expr(first));
    for i in 1..24 {
        obj: *Obj = new_obj("term", true);
        obj.ty = ty_int;
        // Deliberate hash collisions must not make terms equal.
        obj.browse_id = first.browse_id + i * 256;
        terms[i] = bounds_obj_expr(obj)
    }
    x: *Expr = terms[0];
    y: *Expr = terms[1];
    z: *Expr = terms[2];
    bool_a: *Obj = new_obj("bool_a", true);
    bool_a.ty = ty_bool;
    bool_b: *Obj = new_obj("bool_b", true);
    bool_b.ty = ty_bool;
    a_bool: *Expr = bounds_obj_expr(bool_a);
    b_bool: *Expr = bounds_obj_expr(bool_b);
    yes: *Expr = mk_expr(ExprKind.Num {
        val: 1,
        str_label: 0,
        form: LIT_TRUE,
        spell: ""
    });
    yes.ty = ty_bool;
    no: *Expr = mk_expr(ExprKind.Num {
        val: 0,
        str_label: 0,
        form: LIT_FALSE,
        spell: ""
    });
    no.ty = ty_bool;
    scalar: ?*BoundsState = bounds_add_scalar_relation(null, a_bool, b_bool, BoundsKind.Equal);
    scalar = bounds_add_scalar_relation(scalar, b_bool, yes, BoundsKind.Equal);
    if (!bounds_scalar_proves(scalar, a_bool, yes, BoundsKind.Equal)) return 24;
    if (!bounds_scalar_proves(scalar, a_bool, no, BoundsKind.NotEqual)) return 25;
    if (bounds_scalar_proves(scalar, a_bool, no, BoundsKind.Equal)) return 26;
    if (!bounds_precondition_proved(new_binary(BinOp.Eq, a_bool, yes), scalar)) return 31;
    if (!bounds_precondition_proved(new_binary(BinOp.Ne, a_bool, no), scalar)) return 32;
    scalar = bounds_kill(scalar, bool_b);
    if (bounds_scalar_proves(scalar, a_bool, yes, BoundsKind.Equal)) return 27;
    idle: *Variant = new Variant {
        name: "Idle",
        tag: 0,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        payload_offset: 0,
        next: null,
        lead: null,
        trail: null,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    busy: *Variant = new Variant {
        name: "Busy",
        tag: 1,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        payload_offset: 0,
        next: idle,
        lead: null,
        trail: null,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    enum_def: *EnumDef = new EnumDef {
        name: "State",
        variants: busy,
        size: 1,
        tag_ty: ty_i8,
        min_size: 1,
        align: 1,
        ty: null,
        next: null,
        hash_next: null,
        ptr_walk: false,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    enum_ty: *Type = new Type.Enum { def: enum_def };
    enum_def.ty = enum_ty;
    state_obj: *Obj = new_obj("state", true);
    state_obj.ty = enum_ty;
    state_value: *Expr = bounds_obj_expr(state_obj);
    idle_value: *Expr = new_variant_lit("State", "Idle", idle, 0, null, enum_ty);
    busy_value: *Expr = new_variant_lit("State", "Busy", busy, 1, null, enum_ty);
    variant_facts: ?*BoundsState = bounds_add_scalar_relation(null, state_value, idle_value,
        BoundsKind.Equal);
    if (!bounds_scalar_proves(variant_facts, state_value, idle_value, BoundsKind.Equal)) return 28;
    if (!bounds_scalar_proves(variant_facts, state_value, busy_value, BoundsKind.NotEqual)) return 29;
    if (bounds_scalar_proves(variant_facts, state_value, busy_value, BoundsKind.Equal)) return 30;
    placeholder: *Obj = new_obj("value", true);
    placeholder.ty = ty_int;
    nonnegative: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: placeholder, predicate: new_binary(BinOp.Ge,
        bounds_obj_expr(placeholder), new_num(0)) } };
    nonnegative_fact: ?*BoundsState = bounds_add_order(null, new_num(0), x, false);
    if (!assignable(nonnegative, x)) return 23;
    bounds_require_type_invariant(nonnegative, x, nonnegative_fact);
    if (bounds_precondition_proved(new_binary(BinOp.Ge, x, new_num(0)), null)) return 20;
    other_value: *Obj = new_obj("value", true);
    other_value.ty = ty_int;
    same_invariant: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: other_value, predicate: new_binary(BinOp.Ge,
        bounds_obj_expr(other_value), new_num(0)) } };
    stricter_invariant: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: other_value, predicate: new_binary(BinOp.Gt,
        bounds_obj_expr(other_value), new_num(0)) } };
    if (!types_equal(nonnegative, same_invariant)) return 21;
    if (types_equal(nonnegative, stricter_invariant)) return 22;
    bounded: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: placeholder, predicate: new_logand(new_binary(BinOp.Ge,
        bounds_obj_expr(placeholder), new_num(0)), new_binary(BinOp.Lt, bounds_obj_expr(placeholder),
        new_num(10))) } };
    bounded_fact: ?*BoundsState = bounds_add_order(nonnegative_fact, x, new_num(10),
        true);
    bounds_require_type_invariant(bounded, x, bounded_fact);
    // Equivalent literal spellings produce the same stored row.
    canonical: ?*BoundsState = bounds_add_order(null, x, new_num(8), true);
    canonical = bounds_add_order(canonical, x, new_num(7), false);
    canonical = bounds_insert(canonical, first, null, BoundsKind.Difference, 7, x,
        new_num(0), null);
    if (bounds_count(canonical) != 1) return 14;
    stored: ?*BoundsRow = bounds_row(canonical, 0);
    if (stored == null) return 15;
    if (stored.kind != BoundsKind.Difference || stored.value != 7 || bounds_num(stored.right) != 0) return 16;
    if (!bounds_difference_proves(null, new_num(3), new_num(4), -1)) return 17;
    if (bounds_difference_proves(null, new_num(4), new_num(3), 0)) return 18;
    // Synthesized len must not retain the rest of a call's argument list.
    argument: *Expr = bounds_obj_expr(first);
    argument.next = y;
    length: *Expr = bounds_len_term(argument);
    if (!bounds_term(length)) return 19;
    if (argument.next != y) return 20;
    parent: ?*BoundsState = bounds_add_order(null, new_num(0), x, false);
    left: ?*BoundsState = bounds_add_order(parent, x, y, true);
    if (bounds_difference_proves(parent, x, y, -1)) return 1;
    right: ?*BoundsState = bounds_add_order(parent, y, z, true);
    if (bounds_difference_proves(right, x, y, -1)) return 2;
    if (!bounds_difference_proves(left, x, y, -1)) return 3;
    if (bounds_difference_proves(left, y, z, -1)) return 4;
    // Weakening at a branch and widening at a loop are distinct operations.
    low: ?*BoundsState = bounds_insert(null, first, null, BoundsKind.Difference, 2,
        x, y, null);
    high: ?*BoundsState = bounds_insert(null, first, null, BoundsKind.Difference,
        5, x, y, null);
    joined: ?*BoundsState = bounds_meet(low, high);
    if (!bounds_difference_proves(joined, x, y, 5)) return 5;
    if (bounds_difference_proves(joined, x, y, 4)) return 6;
    widened: ?*BoundsState = bounds_widen(low, high);
    if (bounds_difference_proves(widened, x, y, 5)) return 7;
    // A chain beyond the previous relaxation-round cutoff.
    chain: ?*BoundsState = null;
    for i in 0..23 chain = bounds_insert(chain, first, null, BoundsKind.Difference,
        -1, terms[i], terms[i + 1], null);
    if (!bounds_difference_proves(chain, terms[0], terms[23], -23)) return 8;
    if (bounds_difference_proves(chain, terms[0], terms[23], -24)) return 9;
    // Inconsistent assumptions in a disconnected component must neither
    // spin forever nor manufacture a path to an unrelated target.
    cycle: ?*BoundsState = bounds_add_order(null, x, y, true);
    cycle = bounds_add_order(cycle, y, x, false);
    if (bounds_difference_proves(cycle, z, x, 0)) return 13;
    seed: int = 73;
    for _trial in 0..40 {
        state: ?*BoundsState = null;
        reference: []int = new int[49](1000000);
        potentials: []int = new int[7](0);
        for i in 0..7 {
            seed = (seed * 251 + 17) % 65521;
            potentials[i] = seed % 25 - 12;
            reference[i * 7 + i] = 0
        }
        for _edge in 0..20 {
            seed = (seed * 251 + 17) % 65521;
            a: int = seed % 7;
            seed = (seed * 251 + 17) % 65521;
            b: int = seed % 7;
            seed = (seed * 251 + 17) % 65521;
            weight: int = potentials[check_index(potentials, a)] - potentials[check_index(potentials,
                b)] + seed % 5;
            state = bounds_insert(state, first, null, BoundsKind.Difference, weight,
                terms[a], terms[b], null);
            if (weight < reference[a * 7 + b]) reference[a * 7 + b] = weight
        }
        for via in 0..7 {
            for a in 0..7 {
                for b in 0..7 {
                    if (reference[a * 7 + via] < 1000000 && reference[via * 7 + b] < 1000000) {
                        path: int = reference[a * 7 + via] + reference[via * 7 + b];
                        if (path < reference[a * 7 + b]) reference[a * 7 + b] = path
                    }
                }
            }
        }
        for a in 0..7 {
            for b in 0..7 {
                best: int = reference[a * 7 + b];
                if (best < 1000000) {
                    if (!bounds_difference_proves(state, terms[a], terms[b], best)) return 10;
                    if (bounds_difference_proves(state, terms[a], terms[b], best - 1)) return 11
                } else if (bounds_difference_proves(state, terms[a], terms[b], 1000)) return 12
            }
        }
    }
    0
}

//% test: run
//% stdout: ""
//% exit: 0
