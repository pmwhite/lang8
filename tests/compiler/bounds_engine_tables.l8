tag compiler_internal;

import "../../src2/common.l8";

import "../../src2/assembler.l8";

import "../../src2/direct.l8";

import "../../src2/compiler.l8";

import "../../src2/elfpack.l8";

import "../../src2/browse.l8";

import "../../src2/fmt.l8";

import "../../src2/boolint.l8";

import "../../src2/forlint.l8";

import "../../src2/unreachable.l8";

import "../../src2/unusedfields.l8";

import "../../src2/unusedassign.l8";

import "../../src2/bounds_model.l8";

import "../../src2/bounds_terms.l8";

import "../../src2/bounds_state.l8";

import "../../src2/bounds_solver.l8";

import "../../src2/bounds_contracts.l8";

import "../../src2/bounds_effects.l8";

import "../../src2/bounds_records.l8";

import "../../src2/bounds_returns.l8";

import "../../src2/bounds_flow.l8";

import "../../src2/bounds_driver.l8";

// Exercise the proof engine directly against an independent all-pairs
// reference. Feasible graphs include negative edges, cycles, and collisions.
main() noregion: int {
    init_dummies();
    init_runtime();
    first: *Obj = new_obj("first", true);
    first.ty = ty_int;
    terms: []*Expr = new *Expr[24](bounds_obj_expr(first));
    for i in 1..24 {
        obj: *Obj = new_obj("term", true);
        obj.ty = ty_int;
        // Deliberate hash collisions must not make terms equal.
        obj.browse_id = first.browse_id + i * 256;
        terms[i] = bounds_obj_expr(obj)
    }
    x: *Expr = terms[0];
    y: *Expr = terms[1];
    z: *Expr = terms[2];
    // Equivalent literal spellings produce the same stored row.
    canonical: ?*BoundsState = bounds_add_order(null, x, new_num(8), true);
    canonical = bounds_add_order(canonical, x, new_num(7), false);
    canonical = bounds_insert(canonical, first, null, BoundsKind.Difference, 7, x,
        new_num(0), null);
    if (bounds_count(canonical) != 1) return 14;
    stored: ?*BoundsRow = bounds_row(canonical, 0);
    if (stored == null) return 15;
    if (stored.kind != BoundsKind.Difference || stored.value != 7 || bounds_num(stored.right) != 0) return 16;
    if (!bounds_difference_proves(null, new_num(3), new_num(4), -1)) return 17;
    if (bounds_difference_proves(null, new_num(4), new_num(3), 0)) return 18;
    // Synthesized len must not retain the rest of a call's argument list.
    argument: *Expr = bounds_obj_expr(first);
    argument.next = y;
    length: *Expr = bounds_len_term(argument);
    if (!bounds_term(length)) return 19;
    if (argument.next != y) return 20;
    parent: ?*BoundsState = bounds_add_order(null, new_num(0), x, false);
    left: ?*BoundsState = bounds_add_order(parent, x, y, true);
    if (bounds_difference_proves(parent, x, y, -1)) return 1;
    right: ?*BoundsState = bounds_add_order(parent, y, z, true);
    if (bounds_difference_proves(right, x, y, -1)) return 2;
    if (!bounds_difference_proves(left, x, y, -1)) return 3;
    if (bounds_difference_proves(left, y, z, -1)) return 4;
    // Weakening at a branch and widening at a loop are distinct operations.
    low: ?*BoundsState = bounds_insert(null, first, null, BoundsKind.Difference, 2,
        x, y, null);
    high: ?*BoundsState = bounds_insert(null, first, null, BoundsKind.Difference,
        5, x, y, null);
    joined: ?*BoundsState = bounds_meet(low, high);
    if (!bounds_difference_proves(joined, x, y, 5)) return 5;
    if (bounds_difference_proves(joined, x, y, 4)) return 6;
    widened: ?*BoundsState = bounds_widen(low, high);
    if (bounds_difference_proves(widened, x, y, 5)) return 7;
    // A chain beyond the previous relaxation-round cutoff.
    chain: ?*BoundsState = null;
    for i in 0..23 chain = bounds_insert(chain, first, null, BoundsKind.Difference,
        -1, terms[i], terms[i + 1], null);
    if (!bounds_difference_proves(chain, terms[0], terms[23], -23)) return 8;
    if (bounds_difference_proves(chain, terms[0], terms[23], -24)) return 9;
    // Inconsistent assumptions in a disconnected component must neither
    // spin forever nor manufacture a path to an unrelated target.
    cycle: ?*BoundsState = bounds_add_order(null, x, y, true);
    cycle = bounds_add_order(cycle, y, x, false);
    if (bounds_difference_proves(cycle, z, x, 0)) return 13;
    seed: int = 73;
    for _trial in 0..40 {
        state: ?*BoundsState = null;
        reference: []int = new int[49](1000000);
        potentials: []int = new int[7](0);
        for i in 0..7 {
            seed = (seed * 251 + 17) % 65521;
            potentials[i] = seed % 25 - 12;
            reference[i * 7 + i] = 0
        }
        for _edge in 0..20 {
            seed = (seed * 251 + 17) % 65521;
            a: int = seed % 7;
            seed = (seed * 251 + 17) % 65521;
            b: int = seed % 7;
            seed = (seed * 251 + 17) % 65521;
            weight: int = potentials[check_index(potentials, a)] - potentials[check_index(potentials,
                b)] + seed % 5;
            state = bounds_insert(state, first, null, BoundsKind.Difference, weight,
                terms[a], terms[b], null);
            if (weight < reference[a * 7 + b]) reference[a * 7 + b] = weight
        }
        for via in 0..7 {
            for a in 0..7 {
                for b in 0..7 {
                    if (reference[a * 7 + via] < 1000000 && reference[via * 7 + b] < 1000000) {
                        path: int = reference[a * 7 + via] + reference[via * 7 + b];
                        if (path < reference[a * 7 + b]) reference[a * 7 + b] = path
                    }
                }
            }
        }
        for a in 0..7 {
            for b in 0..7 {
                best: int = reference[a * 7 + b];
                if (best < 1000000) {
                    if (!bounds_difference_proves(state, terms[a], terms[b], best)) return 10;
                    if (bounds_difference_proves(state, terms[a], terms[b], best - 1)) return 11
                } else if (bounds_difference_proves(state, terms[a], terms[b], 1000)) return 12
            }
        }
    }
    0
}

//% test: run
//% stdout: ""
//% exit: 0
