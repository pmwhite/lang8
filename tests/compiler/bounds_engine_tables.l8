tag compiler_internal;

import "../../src2/common.l8";

import "../../src2/assembler.l8";

import "../../src2/direct.l8";

import "../../src2/compiler.l8";

import "../../src2/elfpack.l8";

import "../../src2/browse.l8";

import "../../src2/fmt.l8";

import "../../src2/boolint.l8";

import "../../src2/forlint.l8";

import "../../src2/unreachable.l8";

import "../../src2/unusedfields.l8";

import "../../src2/unusedassign.l8";

import "../../src2/bounds_model.l8";

import "../../src2/bounds_terms.l8";

import "../../src2/bounds_state.l8";

import "../../src2/bounds_solver.l8";

import "../../src2/bounds_contracts.l8";

import "../../src2/bounds_effects.l8";

import "../../src2/bounds_records.l8";

import "../../src2/bounds_implications.l8";

import "../../src2/bounds_returns.l8";

import "../../src2/bounds_flow.l8";

import "../../src2/bounds_driver.l8";

// Exercise the proof engine directly against an independent all-pairs
// reference. Feasible graphs include negative edges, cycles, and collisions.
main() noregion raises Error, IndexOutOfBounds: int {
    init_dummies();
    init_runtime();
    first: *Obj = new_obj("first", true);
    first.ty = ty_int;
    terms: []*Expr = new *Expr[24](bounds_obj_expr(first));
    for i in 1..24 {
        obj: *Obj = new_obj("term", true);
        obj.ty = ty_int;
        // Deliberate hash collisions must not make terms equal.
        obj.browse_id = first.browse_id + i * 256;
        terms[i] = bounds_obj_expr(obj)
    }
    x: *Expr = terms[0];
    y: *Expr = terms[1];
    z: *Expr = terms[2];
    // Endpoints are borrowed from a compact descriptor. Variable ASTs cache
    // object identity, but must still agree with path-only and object-only refs.
    if (sizeof(BoundsTermRef) != 24 || sizeof(BoundsNumericView) != 64) return 168;
    cached_x: BoundsTermRef = bounds_ref_expr(x);
    object_x: BoundsTermRef = bounds_ref_obj(first, false);
    repeated_x: BoundsTermRef = bounds_ref_expr(bounds_obj_expr(first));
    path_x: BoundsTermRef = cached_x;
    path_x.obj = null;
    if (!cached_x.valid || cached_x.obj != first || cached_x.path != x) return 169;
    if (!bounds_ref_same_borrowed(&cached_x, &object_x) || !bounds_ref_same(repeated_x,
        path_x)) return 170;
    if (bounds_term_hash(cached_x) != bounds_term_hash(path_x) || bounds_term_hash_borrowed(&object_x) != bounds_term_hash(repeated_x)) return 171;
    length_x: BoundsTermRef = bounds_ref_obj(first, true);
    if (bounds_ref_same(cached_x, length_x)) return 172;
    collision_ref: BoundsTermRef = bounds_ref_expr(y);
    if (bounds_ref_same_borrowed(&cached_x, &collision_ref)) return 173;
    invalid_left: BoundsNumericView = bounds_numeric_query(null, x, 3);
    invalid_right: BoundsNumericView = bounds_numeric_query(x, null, 3);
    if (invalid_left.left.valid || !invalid_left.right.valid || !invalid_right.left.valid || invalid_right.right.valid) return 174;
    if (bounds_solve(null, &invalid_left, false) != 1000000000000000000 || bounds_solve(null,
        &invalid_right, true) != 1000000000000000000) return 175;
    normalized: BoundsNumericView = bounds_numeric_query(new_num(3), new_num(5), 7);
    if (!normalized.left.valid || !normalized.right.valid || !normalized.left.is_zero || !normalized.right.is_zero || normalized.bound != 9) return 176;
    reference_graph: *BoundsGraph = bounds_graph_new(4);
    cached_id: *BoundsGraphWork = bounds_graph_intern(reference_graph, cached_x);
    path_id: *BoundsGraphWork = bounds_graph_intern(reference_graph, path_x);
    object_id: *BoundsGraphWork = bounds_graph_intern(reference_graph, object_x);
    repeated_id: *BoundsGraphWork = bounds_graph_intern(reference_graph, repeated_x);
    if (path_id != cached_id || object_id != cached_id || repeated_id != cached_id) return 177;
    x_nonnegative: BoundsRow = BoundsRow {
        index: first,
        array: null,
        kind: BoundsKind.Difference,
        value: 0,
        left: new_num(0),
        right: x,
        separation: null
    };
    y_root: ?*Obj = bounds_var(y);
    z_root: ?*Obj = bounds_var(z);
    if (y_root == null || z_root == null) return 33;
    y_nonnegative: BoundsRow = BoundsRow {
        index: y_root,
        array: null,
        kind: BoundsKind.Difference,
        value: 0,
        left: new_num(0),
        right: y,
        separation: null
    };
    z_nonnegative: BoundsRow = BoundsRow {
        index: z_root,
        array: null,
        kind: BoundsKind.Difference,
        value: 0,
        left: new_num(0),
        right: z,
        separation: null
    };
    // Filtering a middle or trailing row must not expose it through shared
    // hash buckets, and later appends must not mutate the original snapshot.
    filter_source: ?*BoundsState = bounds_push(null, x_nonnegative);
    filter_source = bounds_push(filter_source, y_nonnegative);
    filter_source = bounds_push(filter_source, z_nonnegative);
    filter_middle: ?*BoundsState = bounds_kill(filter_source, y_root);
    filter_tail: ?*BoundsState = bounds_kill(filter_source, z_root);
    if (!bounds_has_fact(filter_middle, &x_nonnegative) || !bounds_has_fact(filter_middle,
        &z_nonnegative)) return 116;
    if (bounds_has_fact(filter_middle, &y_nonnegative) || bounds_has_fact(filter_tail,
        &z_nonnegative)) return 117;
    filter_tail = bounds_add_relation(filter_tail, x, z, -1);
    if (!bounds_has_fact(filter_source, &y_nonnegative) || !bounds_has_fact(filter_source,
        &z_nonnegative)) return 118;
    if (bounds_difference_entails(filter_source, x, z, -1) || bounds_difference_entails(filter_middle,
        x, z, -1)) return 119;
    if (!bounds_difference_entails(filter_tail, x, z, -1)) return 120;
    two_premises: *BoundsPremise = new BoundsPremise { fact: x_nonnegative, next: new BoundsPremise { fact: y_nonnegative, next: null } };
    implication: *BoundsImplication = new BoundsImplication { premises: two_premises, consequence: z_nonnegative, next: null };
    conditional: ?*BoundsState = bounds_attach_implication(null, implication);
    conditional = bounds_add_order(conditional, new_num(0), x, false);
    conditional = bounds_close_implications(conditional);
    if (bounds_nonnegative_term(conditional, z)) return 34;
    conditional = bounds_add_order(conditional, new_num(0), y, false);
    conditional = bounds_close_implications(conditional);
    if (!bounds_nonnegative_term(conditional, z)) return 35;
    bool_a: *Obj = new_obj("bool_a", true);
    bool_a.ty = ty_bool;
    bool_b: *Obj = new_obj("bool_b", true);
    bool_b.ty = ty_bool;
    a_bool: *Expr = bounds_obj_expr(bool_a);
    b_bool: *Expr = bounds_obj_expr(bool_b);
    yes: *Expr = mk_expr(ExprKind.Num {
        val: 1,
        str_label: 0,
        form: LIT_TRUE,
        spell: ""
    });
    yes.ty = ty_bool;
    no: *Expr = mk_expr(ExprKind.Num {
        val: 0,
        str_label: 0,
        form: LIT_FALSE,
        spell: ""
    });
    no.ty = ty_bool;
    boolean_premise: BoundsRow = BoundsRow {
        index: bool_a,
        array: null,
        kind: BoundsKind.Equal,
        value: 0,
        left: a_bool,
        right: yes,
        separation: null
    };
    boolean_rule: *BoundsImplication = new BoundsImplication { premises: new BoundsPremise { fact: boolean_premise, next: null }, consequence: x_nonnegative, next: null };
    from_boolean: ?*BoundsState = bounds_attach_implication(null, boolean_rule);
    from_boolean = bounds_add_scalar_relation(from_boolean, a_bool, yes, BoundsKind.Equal);
    from_boolean = bounds_close_implications(from_boolean);
    if (!bounds_nonnegative_term(from_boolean, x)) return 36;
    if (bounds_has_implication(bounds_kill(from_boolean, bool_a), boolean_rule)) return 37;
    scalar: ?*BoundsState = bounds_add_scalar_relation(null, a_bool, b_bool, BoundsKind.Equal);
    scalar = bounds_add_scalar_relation(scalar, b_bool, yes, BoundsKind.Equal);
    if (!bounds_scalar_proves(scalar, a_bool, yes, BoundsKind.Equal)) return 24;
    if (!bounds_scalar_proves(scalar, a_bool, no, BoundsKind.NotEqual)) return 25;
    if (bounds_scalar_proves(scalar, a_bool, no, BoundsKind.Equal)) return 26;
    if (!bounds_precondition_proved(new_binary(BinOp.Eq, a_bool, yes), scalar)) return 31;
    if (!bounds_precondition_proved(new_binary(BinOp.Ne, a_bool, no), scalar)) return 32;
    scalar = bounds_kill(scalar, bool_b);
    if (bounds_scalar_proves(scalar, a_bool, yes, BoundsKind.Equal)) return 27;
    // Reverse insertion order requires several closure passes. A disconnected
    // component and a later shared-storage append must not leak into a class.
    equal_chain: ?*BoundsState = null;
    for i in 0..10 equal_chain = bounds_add_scalar_relation(equal_chain, terms[10 - i],
        terms[9 - i], BoundsKind.Equal);
    equal_chain = bounds_add_scalar_relation(equal_chain, terms[2], terms[8], BoundsKind.Equal);
    equal_chain = bounds_add_scalar_relation(equal_chain, terms[12], terms[13], BoundsKind.Equal);
    extended_chain: ?*BoundsState = bounds_add_scalar_relation(equal_chain, terms[10],
        terms[12], BoundsKind.Equal);
    if (!bounds_scalar_proves(equal_chain, terms[0], terms[10], BoundsKind.Equal)) return 153;
    if (bounds_scalar_proves(equal_chain, terms[0], terms[13], BoundsKind.Equal)) return 154;
    if (!bounds_scalar_proves(extended_chain, terms[0], terms[13], BoundsKind.Equal)) return 155;
    unequal_chain: ?*BoundsState = bounds_add_scalar_relation(equal_chain, terms[9],
        terms[12], BoundsKind.NotEqual);
    if (!bounds_scalar_proves(unequal_chain, terms[0], terms[13], BoundsKind.NotEqual)) return 156;
    if (bounds_scalar_proves(equal_chain, terms[0], terms[13], BoundsKind.NotEqual)) return 157;
    // Compare equality closure with independent all-pairs reachability. Numeric
    // rows between the components are irrelevant to scalar-class membership.
    for trial in 0..12 {
        eq_state: ?*BoundsState = null;
        connected: []bool = new bool[144](false);
        for i in 0..12 connected[i * 12 + i] = true;
        random: int = trial + 1;
        for _edge in 0..24 {
            random = random * 17 + 13 & 65535;
            a: int = random % 12;
            random = random * 29 + 7 & 65535;
            b: int = random % 6 * 2 + a % 2;
            eq_state = bounds_add_scalar_relation(eq_state, terms[a], terms[b], BoundsKind.Equal);
            connected[a * 12 + b] = true;
            connected[b * 12 + a] = true;
            eq_state = bounds_add_relation(eq_state, terms[a], terms[(a + 1) % 12],
                100)
        }
        for k in 0..12 {
            for i in 0..12 {
                for j in 0..12 {
                    if (connected[i * 12 + k] && connected[k * 12 + j]) connected[i * 12 + j] = true
                }
            }
        }
        for i in 0..12 {
            for j in 0..12 {
                if (bounds_scalar_proves(eq_state, terms[i], terms[j], BoundsKind.Equal) != connected[i * 12 + j]) return 158
            }
        }
    }
    idle: *Variant = new Variant {
        name: "Idle",
        tag: 0,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        payload_offset: 0,
        next: null,
        lead: null,
        trail: null,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    busy: *Variant = new Variant {
        name: "Busy",
        tag: 1,
        fields: null,
        payload_ty: null,
        payload_size: 0,
        payload_offset: 0,
        next: idle,
        lead: null,
        trail: null,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    enum_def: *EnumDef = new EnumDef {
        name: "State",
        variants: busy,
        size: 1,
        tag_ty: ty_i8,
        min_size: 1,
        align: 1,
        ty: null,
        next: null,
        hash_next: null,
        ptr_walk: false,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    enum_ty: *Type = new Type.Enum { def: enum_def };
    enum_def.ty = enum_ty;
    state_obj: *Obj = new_obj("state", true);
    state_obj.ty = enum_ty;
    state_value: *Expr = bounds_obj_expr(state_obj);
    idle_value: *Expr = new_variant_lit("State", "Idle", idle, 0, null, enum_ty);
    busy_value: *Expr = new_variant_lit("State", "Busy", busy, 1, null, enum_ty);
    variant_facts: ?*BoundsState = bounds_add_scalar_relation(null, state_value, idle_value,
        BoundsKind.Equal);
    if (!bounds_scalar_proves(variant_facts, state_value, idle_value, BoundsKind.Equal)) return 28;
    if (!bounds_scalar_proves(variant_facts, state_value, busy_value, BoundsKind.NotEqual)) return 29;
    if (bounds_scalar_proves(variant_facts, state_value, busy_value, BoundsKind.Equal)) return 30;
    placeholder: *Obj = new_obj("value", true);
    placeholder.ty = ty_int;
    nonnegative: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: placeholder, predicate: new_binary(BinOp.Ge,
        bounds_obj_expr(placeholder), new_num(0)) } };
    nonnegative_fact: ?*BoundsState = bounds_add_order(null, new_num(0), x, false);
    if (!assignable(nonnegative, x)) return 23;
    bounds_require_type_invariant(nonnegative, x, nonnegative_fact);
    if (bounds_precondition_proved(new_binary(BinOp.Ge, x, new_num(0)), null)) return 20;
    other_value: *Obj = new_obj("value", true);
    other_value.ty = ty_int;
    same_invariant: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: other_value, predicate: new_binary(BinOp.Ge,
        bounds_obj_expr(other_value), new_num(0)) } };
    stricter_invariant: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: other_value, predicate: new_binary(BinOp.Gt,
        bounds_obj_expr(other_value), new_num(0)) } };
    if (!types_equal(nonnegative, same_invariant)) return 21;
    if (types_equal(nonnegative, stricter_invariant)) return 22;
    bounded: *Type = new Type.Refined { base: ty_int, invariant: new TypeInvariant { value: placeholder, predicate: new_logand(new_binary(BinOp.Ge,
        bounds_obj_expr(placeholder), new_num(0)), new_binary(BinOp.Lt, bounds_obj_expr(placeholder),
        new_num(10))) } };
    bounded_fact: ?*BoundsState = bounds_add_order(nonnegative_fact, x, new_num(10),
        true);
    bounds_require_type_invariant(bounded, x, bounded_fact);
    // Equivalent literal spellings produce the same stored row.
    canonical: ?*BoundsState = bounds_add_order(null, x, new_num(8), true);
    canonical = bounds_add_order(canonical, x, new_num(7), false);
    canonical = bounds_insert(canonical, first, null, BoundsKind.Difference, 7, x,
        new_num(0), null);
    if (bounds_count(canonical) != 1) return 14;
    stored: ?*BoundsRow = bounds_row(canonical, 0);
    if (stored == null) return 15;
    if (stored.kind != BoundsKind.Difference || stored.value != 7 || bounds_num(stored.right) != 0) return 16;
    if (!bounds_difference_proves(null, new_num(3), new_num(4), -1)) return 17;
    if (bounds_difference_proves(null, new_num(4), new_num(3), 0)) return 18;
    // Synthesized len must not retain the rest of a call's argument list.
    argument: *Expr = bounds_obj_expr(first);
    argument.next = y;
    length: *Expr = bounds_len_term(argument);
    if (!bounds_term(length)) return 19;
    if (argument.next != y) return 20;
    parent: ?*BoundsState = bounds_add_order(null, new_num(0), x, false);
    left: ?*BoundsState = bounds_add_order(parent, x, y, true);
    if (bounds_difference_proves(parent, x, y, -1)) return 1;
    right: ?*BoundsState = bounds_add_order(parent, y, z, true);
    if (bounds_difference_proves(right, x, y, -1)) return 2;
    if (!bounds_difference_proves(left, x, y, -1)) return 3;
    if (bounds_difference_proves(left, y, z, -1)) return 4;
    // Weakening at a branch and widening at a loop are distinct operations.
    low: ?*BoundsState = bounds_insert(null, first, null, BoundsKind.Difference, 2,
        x, y, null);
    high: ?*BoundsState = bounds_insert(null, first, null, BoundsKind.Difference,
        5, x, y, null);
    joined: ?*BoundsState = bounds_meet(low, high);
    if (!bounds_difference_proves(joined, x, y, 5)) return 5;
    if (bounds_difference_proves(joined, x, y, 4)) return 6;
    widened: ?*BoundsState = bounds_widen(low, high);
    if (bounds_difference_proves(widened, x, y, 5)) return 7;
    // Bottom is no predecessor, not an empty set of facts (top).
    dead: ?*BoundsState = bounds_unreachable();
    if (bounds_reachable(dead) || !bounds_reachable(null)) return 90;
    if (bounds_same(dead, null)) return 91;
    if (!bounds_same(bounds_meet(dead, low), low)) return 92;
    if (!bounds_same(bounds_meet(low, dead), low)) return 93;
    if (!bounds_same(bounds_widen(low, dead), low)) return 94;
    if (bounds_reachable(bounds_add_order(dead, x, y, true))) return 95;
    if (bounds_reachable(bounds_after_call(dead, null, null))) return 96;
    if (!bounds_subset(low, dead) || bounds_subset(dead, low)) return 97;
    // Searching a conditional edge returns its assumptions. Pure lattice
    // entailment cannot use it, and searching does not commit the assumptions.
    separation: *BoundsSeparation = new BoundsSeparation { first: 11, second: 12, next: null };
    dependent: ?*BoundsState = bounds_insert(null, first, null, BoundsKind.Difference,
        2, x, y, separation);
    wanted: BoundsNumericView = bounds_numeric_query(x, y, 2);
    bounds_infer_mode = true;
    bounds_infer_changed = false;
    evidence: BoundsEvidence = bounds_direct_evidence(dependent, &wanted, true);
    if (evidence.bound != 2 || evidence.separation != separation) return 98;
    if (bounds_infer_changed || bounds_direct_bound(dependent, &wanted) <= 2) return 99;
    if (!bounds_difference_entails(dead, x, y, -100)) return 100;
    if (bounds_difference_entails(dependent, x, y, 2)) return 101;
    bounds_infer_mode = false;
    // Call filtering scans only the snapshot prefix, even if shared storage
    // contains a newer sibling's row. An escaped local must still be removed.
    escaped: *Obj = new_obj("escaped", true);
    escaped.ty = ty_int;
    escaped.bounds_addr_taken = true;
    escaped_row: BoundsRow = x_nonnegative;
    escaped_row.index = escaped;
    escaped_row.right = bounds_obj_expr(escaped);
    call_prefix: ?*BoundsState = bounds_push(null, x_nonnegative);
    call_sibling: ?*BoundsState = bounds_push(call_prefix, y_nonnegative);
    prefix_after_call: ?*BoundsState = bounds_after_call(call_prefix, null, null);
    if (bounds_count(prefix_after_call) != 1 || !bounds_has_fact(prefix_after_call,
        &x_nonnegative) || bounds_has_fact(prefix_after_call, &y_nonnegative)) return 186;
    call_sibling = bounds_push(call_sibling, escaped_row);
    call_sibling = bounds_push(call_sibling, z_nonnegative);
    sibling_after_call: ?*BoundsState = bounds_after_call(call_sibling, null, null);
    if (bounds_count(sibling_after_call) != 3 || bounds_has_fact(sibling_after_call,
        &escaped_row) || !bounds_has_fact(sibling_after_call, &z_nonnegative)) return 187;
    // Cached object identity must not cache mutable escape/local flags.
    escaped.bounds_addr_taken = false;
    if (bounds_count(bounds_after_call(call_sibling, null, null)) != 4) return 188;
    escaped.bounds_addr_taken = true;
    if (bounds_count(bounds_after_call(call_sibling, null, null)) != 3) return 189;
    escaped.bounds_addr_taken = false;
    escaped.is_local = false;
    if (bounds_count(bounds_after_call(call_sibling, null, null)) != 3) return 190;
    escaped.is_local = true;
    escaped.bounds_addr_taken = true;
    // Recycling a completed pass must clear its indexes. Exported row values
    // and their terms must survive even when the original buffer is reused.
    arena: *BoundsArena = bounds_arena_new();
    pooled: ?*BoundsState = bounds_add_relation(bounds_arena_state(arena), x, y, 2);
    old_storage: ?*BoundsStorage = if (pooled == null) null else pooled.storage;
    saved_row: ?*BoundsRow = bounds_row(pooled, 0);
    if (saved_row == null) return 102;
    exported: BoundsRow = saved_row.*;
    probe_query: BoundsNumericView = bounds_numeric_query(x, y, 2);
    if (bounds_solve(pooled, &probe_query, false) != 2) return 121;
    bounds_arena_reset(arena);
    fresh: ?*BoundsState = bounds_add_relation(bounds_arena_state(arena), y, z, 3);
    if (fresh == null || fresh.storage != old_storage) return 103;
    if (bounds_difference_entails(fresh, x, y, 2)) return 104;
    if (!bounds_difference_entails(fresh, y, z, 3)) return 105;
    restored: ?*BoundsState = bounds_push(null, exported);
    if (!bounds_difference_entails(restored, x, y, 2)) return 106;
    // Fork an older snapshot after its shared buffer has been extended.
    sibling: ?*BoundsState = bounds_add_relation(fresh, x, y, 4);
    // Borrowed descriptors obey snapshot boundaries even after shared storage
    // grows, and expose the same existing row without copying it.
    borrowed: ?*BoundsNumericView = bounds_numeric_ref(fresh, 0);
    if (borrowed == null || !borrowed.left.valid || !borrowed.right.valid || borrowed.bound != 3) return 148;
    if (borrowed != bounds_numeric_ref(sibling, 0)) return 149;
    if (bounds_numeric_ref(fresh, 1) != null) return 150;
    if (bounds_numeric_ref(fresh, -1) != null || bounds_numeric_ref(null, 0) != null) return 151;
    appended: ?*BoundsNumericView = bounds_numeric_ref(sibling, 1);
    if (appended == null || !appended.left.valid || !appended.right.valid || appended.bound != 4) return 152;
    other: ?*BoundsState = bounds_add_relation(fresh, x, z, 9);
    if (bounds_difference_entails(other, x, y, 4)) return 107;
    if (!bounds_difference_entails(sibling, x, z, 7)) return 108;
    if (bounds_difference_entails(fresh, x, z, 9)) return 109;
    // A cached graph must not pick up rows from a later prefix, another
    // predecessor, or a recycled storage buffer.
    cached_fresh: ?*BoundsGraphCache = bounds_cached_graph(fresh, null, true);
    if (cached_fresh == null) return 122;
    pinned: *BoundsGraph = cached_fresh.graph;
    cached_sibling: ?*BoundsGraphCache = bounds_cached_graph(sibling, pinned, true);
    if (cached_sibling == null || cached_sibling.graph == pinned) return 123;
    x_ref: BoundsTermRef = bounds_ref_expr(x);
    if (bounds_graph_find(pinned, x_ref) != null) return 124;
    sibling_query: BoundsNumericView = bounds_numeric_query(x, z, 7);
    if (bounds_solve(sibling, &sibling_query, false) != 7) return 125;
    fresh_query: BoundsNumericView = bounds_numeric_query(x, z, 7);
    if (bounds_solve(fresh, &fresh_query, false) < 1000000000000000000) return 126;
    // A length absent from the cached graph still has implicit constant and
    // nonnegative bounds even when it is absent from the cached term table.
    fixed: *Obj = new_obj("fixed", true);
    fixed.ty = array_of(ty_int, 5);
    fixed_len: *Expr = bounds_len_term(bounds_obj_expr(fixed));
    fixed_lower_query: BoundsNumericView = bounds_numeric_query(new_num(0), fixed_len,
        -5);
    if (bounds_solve(fresh, &fixed_lower_query, false) != -5) return 127;
    fixed_upper_query: BoundsNumericView = bounds_numeric_query(fixed_len, new_num(0),
        5);
    if (bounds_solve(fresh, &fixed_upper_query, false) != 5) return 128;
    // Missing lengths are virtual endpoints through zero. Compare every
    // combination with a fresh query-local graph, including unknown lengths,
    // two missing endpoints, identical endpoints, and the large-shift fallback.
    length_state: ?*BoundsState = bounds_add_relation(bounds_arena_state(arena), x,
        new_num(0), 12);
    length_state = bounds_add_relation(length_state, x, z, 2);
    length_state = bounds_add_relation(length_state, z, new_num(0), 7);
    length_state = bounds_add_relation(length_state, new_num(0), y, -3);
    length_state = bounds_insert(length_state, first, null, BoundsKind.Difference,
        1, x, new_num(0), separation);
    unknown_array: *Obj = new_obj("unknown_array", true);
    unknown_array.ty = slice_of(ty_int);
    big_array: *Obj = new_obj("big_array", true);
    big_array.ty = array_of(ty_int, 536870912);
    another_array: *Obj = new_obj("another_array", true);
    another_array.ty = array_of(ty_int, 9);
    endpoints: []*Expr = new *Expr[7](new_num(0));
    endpoints[1] = x;
    endpoints[2] = y;
    endpoints[3] = fixed_len;
    endpoints[4] = bounds_len_term(bounds_obj_expr(unknown_array));
    endpoints[5] = bounds_len_term(bounds_obj_expr(big_array));
    endpoints[6] = bounds_len_term(bounds_obj_expr(another_array));
    changing_length: ?*BoundsState = bounds_add_relation(null, endpoints[4], new_num(0),
        7);
    if (bounds_count(bounds_after_call(changing_length, null, null)) != 1) return 191;
    unknown_array.bounds_addr_taken = true;
    if (bounds_count(bounds_after_call(changing_length, null, null)) != 0) return 192;
    unknown_array.bounds_addr_taken = false;
    if (bounds_count(bounds_after_call(changing_length, null, null)) != 1) return 193;
    length_cache: ?*BoundsGraphCache = bounds_cached_graph(length_state, null, true);
    if (length_cache == null) return 159;
    original_nodes: int = length_cache.graph.nodes;
    for from in 0..7 {
        for to in 0..7 {
            query: BoundsNumericView = bounds_numeric_query(endpoints[to], endpoints[from],
                0);
            ref_left: BoundsTermRef = query.left;
            ref_right: BoundsTermRef = query.right;
            reference: *BoundsGraph = bounds_graph_new(bounds_count(length_state));
            ref_target: *BoundsGraphWork = bounds_graph_intern(reference, ref_left);
            ref_source: *BoundsGraphWork = bounds_graph_intern(reference, ref_right);
            bounds_graph_load(reference, length_state);
            expected: int = bounds_graph_distance(reference, ref_source, ref_target,
                0, false);
            if (bounds_solve(length_state, &query, false) != expected) return 160;
            if (expected < 1000000000000000000) {
                query.bound = expected;
                if (bounds_solve(length_state, &query, true) > expected) return 161;
                query.bound = expected - 1;
                if (bounds_solve(length_state, &query, true) <= expected - 1) return 162
            }
        }
    }
    if (length_cache.graph.nodes != original_nodes) return 163;
    // A translated path may cross the sentinel in the unshifted graph.
    // Large weights must retain the original query-local search behavior.
    large_state: ?*BoundsState = bounds_add_relation(bounds_arena_state(arena), x,
        new_num(0), 1000000000000000003);
    large_query: BoundsNumericView = bounds_numeric_query(x, fixed_len, 999999999999999998);
    if (bounds_solve(large_state, &large_query, false) != 999999999999999998) return 166;
    if (bounds_solve(large_state, &large_query, true) > large_query.bound) return 167;
    // A same-size branch copy trims later bucket heads. All these terms
    // deliberately collide, so hidden rows form a multi-link suffix.
    indexed: ?*BoundsState = null;
    indexed_prefix: ?*BoundsState = null;
    copy_zero: *Expr = new_num(0);
    for i in 0..22 {
        indexed = bounds_add_relation(indexed, terms[i], copy_zero, i + 1);
        if (i == 17) indexed_prefix = indexed
    }
    indexed_fork: ?*BoundsState = bounds_add_relation(indexed_prefix, terms[23], copy_zero,
        100);
    for i in 0..22 {
        query: BoundsNumericView = bounds_numeric_query(terms[i], copy_zero, 0);
        expected: int = if (i < 18) i + 1 else 1000000000;
        if (bounds_direct_bound(indexed_fork, &query) != expected) return 164;
        if (bounds_direct_bound(indexed, &query) != i + 1) return 165
    }
    conditional_initial: ?*BoundsState = bounds_arena_state(arena);
    conditional_pooled: ?*BoundsState = bounds_insert(conditional_initial, first,
        null, BoundsKind.Difference, 2, x, y, separation);
    conditional_pooled = bounds_add_relation(conditional_pooled, y, z, 3);
    conditional_query: BoundsNumericView = bounds_numeric_query(x, z, 5);
    if (bounds_solve(conditional_pooled, &conditional_query, false) < 1000000000000000000) return 129;
    // The cache has a fixed memory budget, not a limit on accepted proofs.
    oversized: ?*BoundsState = bounds_arena_state(arena);
    for i in 0..BOUNDS_GRAPH_CACHE_ROWS + 1 oversized = bounds_add_relation(oversized,
        x, y, i);
    oversized = bounds_add_relation(oversized, y, z, 3);
    oversized_query: BoundsNumericView = bounds_numeric_query(x, z, 3);
    if (bounds_solve(oversized, &oversized_query, false) != 3) return 130;
    // The first direct edge is enough for the loose proof, but a tighter or
    // exact query must continue past that partial result to find the detour.
    memo: ?*BoundsState = bounds_arena_state(arena);
    memo = bounds_add_relation(memo, x, y, 4);
    memo = bounds_add_relation(memo, y, z, 3);
    memo = bounds_add_relation(memo, x, z, 10);
    loose_query: BoundsNumericView = bounds_numeric_query(x, z, 10);
    tight_query: BoundsNumericView = bounds_numeric_query(x, z, 7);
    reverse_query: BoundsNumericView = bounds_numeric_query(z, x, 0);
    if (bounds_solve(memo, &loose_query, true) > 10) return 133;
    if (bounds_solve(memo, &tight_query, true) > 7) return 134;
    if (bounds_solve(memo, &tight_query, false) != 7) return 135;
    if (bounds_solve(memo, &reverse_query, false) < 1000000000000000000) return 136;
    if (bounds_solve(memo, &tight_query, false) != 7) return 137;
    extended_memo: ?*BoundsState = bounds_add_relation(memo, x, z, 6);
    if (bounds_solve(extended_memo, &tight_query, false) != 6) return 138;
    if (bounds_solve(memo, &tight_query, false) != 7) return 139;
    // Interval shortcuts must use unconditional evidence, and may not return
    // a loose interval path as the exact graph distance.
    intervals: ?*BoundsState = bounds_arena_state(arena);
    zero: *Expr = new_num(0);
    intervals = bounds_add_relation(intervals, x, zero, 8);
    intervals = bounds_add_relation(intervals, zero, y, -3);
    interval_query: BoundsNumericView = bounds_numeric_query(x, y, 5);
    if (bounds_solve(intervals, &interval_query, true) != 5) return 140;
    intervals = bounds_add_relation(intervals, x, y, 2);
    if (bounds_solve(intervals, &interval_query, false) != 2) return 141;
    alias_intervals: ?*BoundsState = bounds_arena_state(arena);
    alias_intervals = bounds_insert(alias_intervals, first, null, BoundsKind.Difference,
        8, x, zero, separation);
    alias_intervals = bounds_add_relation(alias_intervals, zero, y, -3);
    if (bounds_solve(alias_intervals, &interval_query, true) < 1000000000000000000) return 142;
    // These snapshots share exactly their first row, including branches
    // copied from the same older buffer and a shorter parent snapshot.
    fresh_count: int = bounds_count(fresh);
    sibling_count: int = bounds_count(sibling);
    other_count: int = bounds_count(other);
    if (bounds_common_prefix(fresh, sibling, fresh_count) != 1 || bounds_common_prefix(sibling,
        other, sibling_count) != 1) return 143;
    if (bounds_common_prefix(other, fresh, other_count) != 1) return 144;
    third_branch: ?*BoundsState = bounds_add_relation(fresh, x, z, 8);
    if (bounds_common_prefix(other, third_branch, other_count) != 1) return 145;
    // A reachable negative cycle consumes the work budget. Its finite path
    // bounds remain evidence, but the memo must not mark the search complete.
    budget_cycle: ?*BoundsState = bounds_arena_state(arena);
    budget_cycle = bounds_add_relation(budget_cycle, x, y, -1);
    budget_cycle = bounds_add_relation(budget_cycle, y, x, 0);
    cycle_query: BoundsNumericView = bounds_numeric_query(x, y, -1);
    if (bounds_solve(budget_cycle, &cycle_query, false) > -1) return 146;
    cycle_cache: ?*BoundsGraphCache = bounds_cached_graph(budget_cycle, null, false);
    if (cycle_cache == null || cycle_cache.complete) return 147;
    bounds_arena_reset(arena);
    // A chain beyond the previous relaxation-round cutoff.
    chain: ?*BoundsState = null;
    for i in 0..23 chain = bounds_insert(chain, first, null, BoundsKind.Difference,
        -1, terms[i], terms[i + 1], null);
    if (!bounds_difference_proves(chain, terms[0], terms[23], -23)) return 8;
    if (bounds_difference_proves(chain, terms[0], terms[23], -24)) return 9;
    // Inconsistent assumptions in a disconnected component must neither
    // spin forever nor manufacture a path to an unrelated target.
    cycle: ?*BoundsState = bounds_add_order(null, x, y, true);
    cycle = bounds_add_order(cycle, y, x, false);
    if (bounds_difference_proves(cycle, z, x, 0)) return 13;
    seed: int = 73;
    for _trial in 0..40 {
        bounds_arena_reset(arena);
        state: ?*BoundsState = bounds_arena_state(arena);
        reference: []int = new int[49](1000000);
        potentials: []int = new int[7](0);
        for i in 0..7 {
            seed = (seed * 251 + 17) % 65521;
            potentials[i] = seed % 25 - 12;
            reference[i * 7 + i] = 0
        }
        for _edge in 0..20 {
            seed = (seed * 251 + 17) % 65521;
            a: int = seed % 7;
            seed = (seed * 251 + 17) % 65521;
            b: int = seed % 7;
            if (a < 0 || a >= 7 || b < 0 || b >= 7) return 169;
            seed = (seed * 251 + 17) % 65521;
            weight: int = potentials[a] - potentials[b] + seed % 5;
            state = bounds_insert(state, first, null, BoundsKind.Difference, weight,
                terms[a], terms[b], null);
            if (weight < reference[a * 7 + b]) reference[a * 7 + b] = weight
        }
        for via in 0..7 {
            for a in 0..7 {
                for b in 0..7 {
                    if (reference[a * 7 + via] < 1000000 && reference[via * 7 + b] < 1000000) {
                        path: int = reference[a * 7 + via] + reference[via * 7 + b];
                        if (path < reference[a * 7 + b]) reference[a * 7 + b] = path
                    }
                }
            }
        }
        // Eliminating one scalar preserves every relation between the other
        // values. Compare against closure computed before forgetting it.
        forgotten: ?*BoundsState = bounds_forget_scalar(state, first);
        if (bounds_difference_entails(forgotten, terms[0], terms[1], 1000)) return 112;
        for a in 1..7 {
            for b in 1..7 {
                best: int = reference[a * 7 + b];
                if (best < 1000000) {
                    if (!bounds_difference_entails(forgotten, terms[a], terms[b],
                        best)) return 113;
                    if (bounds_difference_entails(forgotten, terms[a], terms[b], best - 1)) return 114
                } else if (bounds_difference_entails(forgotten, terms[a], terms[b],
                    1000)) return 115
            }
        }
        // Reused search workspace must agree with the independent closure,
        // including when successive sources have different reachable nodes.
        graph: *BoundsGraph = bounds_graph_new(bounds_count(state));
        for i in 0..7 {
            term: BoundsTermRef = bounds_ref_expr(terms[i]);
            node: *BoundsGraphWork = bounds_graph_intern(graph, term);
            if (node.id != i) return 111
        }
        bounds_graph_load(graph, state);
        node_count: int = graph.nodes;
        if (node_count < 7) return 111;
        for source in 0..7 {
            if (!bounds_graph_search(graph, &graph.work[source], &graph.work[0], 0,
                false)) return 132;
            for target in 0..7 {
                expected: int = reference[target * 7 + source];
                if (expected == 1000000) expected = 1000000000000000000;
                if (graph.work[target].distance != expected) return 110
            }
        }
        for a in 0..7 {
            for b in 0..7 {
                best: int = reference[a * 7 + b];
                exact: int = if (best == 1000000) 1000000000000000000 else best;
                exact_query: BoundsNumericView = bounds_numeric_query(terms[a], terms[b],
                    0);
                if (bounds_solve(state, &exact_query, false) != exact) return 131;
                if (best < 1000000) {
                    if (!bounds_difference_proves(state, terms[a], terms[b], best)) return 10;
                    if (bounds_difference_proves(state, terms[a], terms[b], best - 1)) return 11
                } else if (bounds_difference_proves(state, terms[a], terms[b], 1000)) return 12
            }
        }
    }
    // Join projection must recognize a negative closed walk before exporting
    // budget-dependent bounds. The other predecessor, including its rules,
    // survives unchanged; conditional edges cannot establish a contradiction.
    join_arena: *BoundsArena = bounds_arena_new();
    impossible_pair: ?*BoundsState = bounds_arena_state(join_arena);
    impossible_pair = bounds_add_relation(impossible_pair, x, zero, 0);
    impossible_pair = bounds_add_relation(impossible_pair, zero, x, -1);
    live_pair: ?*BoundsState = bounds_arena_state(join_arena);
    live_pair = bounds_add_relation(live_pair, x, zero, 7);
    live_pair = bounds_add_relation(live_pair, y, x, 3);
    live_pair = bounds_attach_implication(live_pair, implication);
    if (bounds_meet(impossible_pair, live_pair) != live_pair) return 178;
    if (bounds_meet(live_pair, impossible_pair) != live_pair) return 179;
    // A three-edge cycle needs transitive reasoning, not just opposite rows.
    open_chain: ?*BoundsState = bounds_arena_state(join_arena);
    open_chain = bounds_add_relation(open_chain, x, y, 1);
    open_chain = bounds_add_relation(open_chain, y, z, 1);
    closed_bad: ?*BoundsState = bounds_add_relation(open_chain, z, x, -3);
    live_chain: ?*BoundsState = bounds_arena_state(join_arena);
    live_chain = bounds_add_relation(live_chain, x, z, 10);
    live_chain = bounds_add_relation(live_chain, z, y, 10);
    live_chain = bounds_add_relation(live_chain, y, x, 10);
    if (bounds_meet(closed_bad, live_chain) != live_chain) return 180;
    if (bounds_meet(live_chain, closed_bad) != live_chain) return 181;
    // The shared older prefix must not see the newer contradictory row.
    impossible_side: int = 99;
    _prefix_projection: ?*BoundsState = bounds_join_project(open_chain, live_chain,
        bounds_empty(open_chain), &impossible_side);
    if (impossible_side != 0) return 182;
    closed_zero: ?*BoundsState = bounds_add_relation(open_chain, z, x, -2);
    _zero_projection: ?*BoundsState = bounds_join_project(closed_zero, live_chain,
        bounds_empty(closed_zero), &impossible_side);
    if (impossible_side != 0) return 183;
    conditional_cycle: ?*BoundsState = bounds_add_relation(bounds_arena_state(join_arena),
        x, zero, 0);
    conditional_cycle = bounds_insert(conditional_cycle, first, null, BoundsKind.Difference,
        -1, zero, x, separation);
    _conditional_projection: ?*BoundsState = bounds_join_project(conditional_cycle,
        live_pair, bounds_empty(conditional_cycle), &impossible_side);
    if (impossible_side != 0) return 184;
    // Implicit fixed-length edges are unconditional and can close a cycle.
    bad_length: ?*BoundsState = bounds_add_relation(bounds_arena_state(join_arena),
        fixed_len, zero, 4);
    live_length: ?*BoundsState = bounds_add_relation(bounds_arena_state(join_arena),
        fixed_len, zero, 5);
    _length_projection: ?*BoundsState = bounds_join_project(bad_length, live_length,
        bounds_empty(bad_length), &impossible_side);
    if (impossible_side != 1) return 185;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
