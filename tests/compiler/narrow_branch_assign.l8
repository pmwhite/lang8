tag example;

/* A variable assigned in a branch that falls through keeps no narrowing
after the if, though the test came before it. */
f(c: bool): int {
    x: int = 1;
    p: ?*int = &x;
    if (p != null) {
        if (c) p = null;
        p.*
    } else 0
}

main(): int {
    f(true)
}

/* expect compile {|
error: narrow_branch_assign.l8:10:9: dereferencing optional pointer (use if (p != null) / while (p != null) to narrow): ?*int
|} */
