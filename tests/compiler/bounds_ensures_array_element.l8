tag bounds_test;

fill(out: []int): int requires (1 <= len(out)) ensures (out[0] == 3) {
    out[0] = 3;
    0
}

read_count(out: []int): int requires (1 <= len(out)) {
    if (fill(out) != 0) return 2;
    if (out[0] != 3) return 1;
    out[out[0] - 3] = 9;
    0
}

main(): int {
    out: []int = [0];
    if (read_count(out) != 0) return 2;
    if (out[0] != 9) return 1;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
