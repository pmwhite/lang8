exception IndexOutOfBounds;

tag bounds_test;

main(): int {
    a: [1]int = [7];
    s: str = "A";
    dst: []int = new int[1](0);
    caught: int = 0;
    try {
        value: int = a[2];
        caught = value
    } with IndexOutOfBounds -> {
        caught = caught + 1
    }
    try {
        value: i8 = s[0 - 1];
        caught = caught + value as int
    } with IndexOutOfBounds -> {
        caught = caught + 1
    }
    try {
        dst[1] = 9
    } with IndexOutOfBounds -> {
        caught = caught + 1
    }
    caught
}

