tag example;

import "../../stdlib/raw_write.l8";

import "../../stdlib/print.l8";

/* noreturn functions must diverge; exit is an extern. */
extern exit(code: int): noreturn;

die(code: int): noreturn {
    exit(code)
}

greet(): noreturn {
    raw::raw_write(1, "Hi\n");
    die(0)
}

main(): int {
    greet()
}

test "main ends the program inside greet" {
    // main's int result comes from greet, which exits instead of returning.
    _status: int = main();
    expect {|
        Hi
        [exit 0]
    |}
}

test "die exits with its code" {
    die(3);
    expect {|
        [exit 3]
    |}
}
