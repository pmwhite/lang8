tag example;

import "../../programs/stdlib/write.l8";

/* noreturn functions must diverge; exit is an extern. */
extern exit(code: int): noreturn;

die(code: int): noreturn {
    exit(code)
}

greet(): noreturn {
    std::write(1, "Hi\n");
    die(0)
}

main(): int {
    greet()
}

//% test: run
//% stdout: "Hi\n"
//% exit: 0
