tag bounds_test;

import "../../stdlib/print.l8";

first(a: []int): int {
    a[0]
}

forward(a: []int): int {
    first(a)
}

main(): int {
    a: []int = [7];
    forward(a)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
