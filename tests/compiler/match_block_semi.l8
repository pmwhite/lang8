tag example;

type Look =
    | Plain
    | Grouped

/* A block arm ends at its brace: no ; follows it. */
pick(l: Look): int {
    n: int = 0;
    match l {
        Plain -> {
            n = 1
        };
        Grouped -> {
            n = 2
        }
    }
    n
}

main(): int {
    pick(Look.Plain)
}

