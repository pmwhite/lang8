tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

replace_data(b: *Buffer@new) {
    b.data = new int[1](9)
}

read_after_other_write(a: *Buffer, b: *Buffer@new): int {
    if (a.cursor < 0 || a.cursor >= len(a.data)) return -1;
    replace_data(b);
    a.data[a.cursor]
}

guarded(a: *Buffer, b: *Buffer@new): int {
    if (a == b) return 5;
    read_after_other_write(a, b)
}

main(): int {
    a: *Buffer = new Buffer { data: [7], cursor: 0 };
    guarded(a, a)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 5
