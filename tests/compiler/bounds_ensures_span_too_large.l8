tag bounds_test;

bounded_count(a: []int, offset: int, count: int): int requires (0 <= offset && offset <= len(a) && 0 <= count && count <= len(a) - offset) ensures (returned <= len(a) - offset) {
    count + 1
}

main(): int {
    a: []int = [2, 4, 6, 8];
    bounded_count(a, 1, 3)
}

