tag bounds_test;

import "../../stdlib/print.l8";

sum(a: []int, n: int): int {
    i: int = 0;
    total: int = 0;
    while (i < n) invariant (0 <= i && i <= n && 0 <= n && n <= len(a)) {
        total = total + a[i];
        i = i + 1
    }
    total
}

main(): int {
    a: []int = [3, 4];
    sum(a, 2)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
