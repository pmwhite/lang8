tag bounds_test;

read_item(a: []int, i: int) raises IndexOutOfBounds: int {
    a[i]
}

main() raises IndexOutOfBounds: int {
    a: []int = [3, 5];
    total: int = 0;
    for i in 0..len(a) {
        match i {
            0 -> total = total + 1;
            _ -> total = total + 2
        }
        total = total + read_item(a, i);
        extra: int = match i {
            0 -> 4;
            _ -> 6
        };
        total = total + a[i] + extra
    }
    total
}

//% test: run
//% stdout: ""
//% exit: 29
