tag bounds_test;

import "../../stdlib/print.l8";

read_item(a: []int, i: int): int {
    a[i]
}

main(): int {
    a: []int = [3, 5];
    total: int = 0;
    for i in 0..len(a) {
        match i {
            0 -> total = total + 1;
            _ -> total = total + 2
        }
        total = total + read_item(a, i);
        extra: int = match i {
            0 -> 4;
            _ -> 6
        };
        total = total + a[i] + extra
    }
    total
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 29
    |}
}
