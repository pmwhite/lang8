tag bounds_test;

import "../../stdlib/print.l8";

before_last(a: []int): int requires (2 <= len(a)) ensures (0 <= returned && returned + 1 < len(a)) {
    0
}

main(): int {
    a: []int = [5, 8];
    at: int = before_last(a);
    a[at + 1]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 8
    |}
}
