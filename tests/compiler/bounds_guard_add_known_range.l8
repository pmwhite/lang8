tag bounds_test;

import "../../stdlib/print.l8";

pick(a: []int, use_two: bool): int {
    start: int = 0;
    if (use_two) start = 2;
    if (len(a) < start + 2) return 0;
    a[start]
}

main(): int {
    a: []int = [1, 2, 3, 4];
    pick(a, false) + pick(a, true)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 4
    |}
}
