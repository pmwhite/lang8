import "../../stdlib/print.l8";

exception IndexOutOfBounds;

tag bounds_test;

second_of_four(a: []int, start: int) raises IndexOutOfBounds: int {
    if (start < 0) return 0;
    if (start + 3 < 0 || start + 3 >= len(a)) raise IndexOutOfBounds;
    a[start + 1]
}

main() raises IndexOutOfBounds: int {
    a: []int = [4, 7, 9, 12];
    second_of_four(a, 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
