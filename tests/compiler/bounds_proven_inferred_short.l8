tag bounds_test;

sixth(a: []int): int {
    a[5]
}

forward(a: []int): int {
    sixth(a)
}

main(): int {
    a: []int = new int[5](7);
    forward(a)
}

/* expect compile {|
error: bounds_proven_inferred_short.l8:13:5: call does not prove inferred array bounds requirement for forward 5 < len(a)
|} */
