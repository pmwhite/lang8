tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 0 };
    if (b.used >= len(b.data)) return 0;
    b.used = b.used + 1;
    total: int = 0;
    for i in 0..b.used total = total + b.data[i];
    total
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 4
    |}
}
