tag bounds_test;

import "../../stdlib/print.l8";

step(a: []int, i: int): int {
    a[i + 1] = 7;
    i + 1
}

choose(a: []int, i: int, first: bool): int {
    a[i + 1] = 9;
    if (first) return i;
    i + 1
}

main(): int {
    a: []int = new int[4](0);
    i: int = 0;
    i = step(a, i);
    i = step(a, i);
    j: int = choose(a, i, true);
    a[j]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
