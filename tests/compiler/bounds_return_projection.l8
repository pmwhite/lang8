tag bounds_test;

step(a: []int, i: int) raises IndexOutOfBounds: int {
    a![i + 1] = 7;
    i + 1
}

choose(a: []int, i: int, first: bool) raises IndexOutOfBounds: int {
    a![i + 1] = 9;
    if (first) return i;
    i + 1
}

main() raises IndexOutOfBounds: int {
    a: []int = new int[4](0);
    i: int = 0;
    i = step(a, i);
    i = step(a, i);
    j: int = choose(a, i, true);
    a![j]
}

//% test: run
//% stdout: ""
//% exit: 7
