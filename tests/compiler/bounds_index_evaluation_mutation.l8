exception IndexOutOfBounds;

tag bounds_test;

type Buffer = {
    data: []int
}

grow(b: *Buffer@new): int {
    b.data = [7];
    0
}

main(): int {
    b: *Buffer = new Buffer { data: new int[0](0) };
    try {
        return b.data[grow(b)]
    } with IndexOutOfBounds -> {
        return 9
    }
}

//% test: compile-fail
//% error-contains: "unproved array access"
