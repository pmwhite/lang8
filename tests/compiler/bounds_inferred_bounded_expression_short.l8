tag bounds_test;

fill(a: []int) {
    for i in 0..8 {
        for axis in 0..3 a[i * 3 + axis] = 1
    }
}

main(): int {
    a: []int = new int[23](0);
    fill(a);
    0
}

/* expect compile {|
error: bounds_inferred_bounded_expression_short.l8:11:5: call does not prove inferred array bounds requirement for fill 23 < len(a)
|} */
