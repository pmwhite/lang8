tag bounds_test;

import "../../stdlib/print.l8";

last_of_three(a: []int, start: int, end: int): int requires (0 <= start && start <= end && end <= len(a)) {
    if (end == start + 3) return a[start + 2];
    0
}

main(): int {
    a: []int = [4, 5, 6];
    end: int = len(a);
    last_of_three(a, 0, end)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 6
    |}
}
