tag bounds_test;

last_of_three(a: []int, start: int, end: int): int requires (0 <= start && start <= end && end <= len(a)) {
    if (end == start + 3) return a[start + 2];
    0
}

main(): int {
    a: []int = [4, 5, 6];
    end: int = len(a);
    last_of_three(a, 0, end)
}

//% test: run
//% stdout: ""
//% exit: 6
