tag bounds_test;

scan(data: []int, last: int): int requires (0 <= last && last <= len(data)) {
    i: int = 0;
    while (data[i] != 0 && i < last) invariant (0 <= i && i <= last) i = i + 1;
    i
}

main(): int {
    data: []int = [1, 1];
    scan(data, 2)
}

