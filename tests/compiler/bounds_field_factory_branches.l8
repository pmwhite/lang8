tag bounds_test;

type Buffer = {
    data: []int
}

make_buffer(empty: bool): *Buffer@new {
    if (empty) return new Buffer { data: new int[0](0) };
    new Buffer { data: [4, 7] }
}

main(): int {
    b: *Buffer = make_buffer(false);
    b.data[1]
}

