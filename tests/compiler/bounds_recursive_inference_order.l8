tag bounds_test;

even(a: []int, n: int) raises IndexOutOfBounds: int {
    if (n <= 0) return odd(a, 0);
    odd(a, n - 1)
}

odd(a: []int, n: int) raises IndexOutOfBounds: int {
    if (n <= 0) return a[0];
    even(a, n - 1)
}

start(a: []int) raises IndexOutOfBounds: int {
    odd(a, 2)
}

main() raises IndexOutOfBounds: int {
    a: []int = new int[1](9);
    start(a)
}

//% test: run
//% stdout: ""
//% exit: 9
