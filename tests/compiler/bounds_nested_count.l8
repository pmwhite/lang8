tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

type Box = {
    buffer: *Buffer
}

sum(box: *Box): int {
    if (box.buffer.used > len(box.buffer.data)) return -1;
    total: int = 0;
    for i in 0..box.buffer.used total = total + box.buffer.data[i];
    total
}

main(): int {
    buffer: *Buffer = new Buffer { data: [2, 3], used: 2 };
    box: *Box = new Box { buffer: buffer };
    sum(box)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 5
