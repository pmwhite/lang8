tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    used: int
}

type Box = {
    buffer: *Buffer;
    visits: int
}

visit_box(box: *Box) {
    box.visits = box.visits + 1
}

sum(box: *Box): int {
    if (box.buffer.used > len(box.buffer.data)) return -1;
    total: int = 0;
    for i in 0..box.buffer.used {
        visit_box(box);
        total = total + box.buffer.data[i]
    }
    total + box.visits
}

main(): int {
    buffer: *Buffer = new Buffer { data: [2, 3], used: 2 };
    box: *Box = new Box { buffer: buffer, visits: 0 };
    sum(box)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
