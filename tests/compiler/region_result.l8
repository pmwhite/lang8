tag region_result;

import "../../stdlib/print.l8";

extern l8_heap_mark(): int;

region_tail(): int {
    region {
        values: []int = new int[8](-17);
        values[0]
    }
}

region_return(): int {
    region {
        outer: []int = new int[8](23);
        region {
            inner: []int = new int[8](19);
            if (inner[0] == 19) return outer[0] + inner[0]
        }
        0
    }
}

region_float(): f64 {
    region {
        values: []f64 = new f64[8](1.25f64);
        values[0]
    }
}

test "region cleanup preserves implicit and explicit results" {
    before: int = l8_heap_mark();
    tail: int = region_tail();
    early: int = region_return();
    floating: f64 = region_float();
    after: int = l8_heap_mark();
    std::print_bool(tail == -17 && early == 42 && floating == 1.25f64);
    std::print_bool(before == after);
    expect {|
        true
        true
    |}
}
