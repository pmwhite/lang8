tag example;

import "../../stdlib/print.l8";

float_zeros_show(label: str, equal: bool) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_bool(equal)
}

test "leading zeros do not change a float literal" {
    float_zeros_show("0.000000000000000000001 == 1e-21", 0.000000000000000000001 == 1e-21);
    float_zeros_show("0.000000000000000000001f64 == 1e-21f64", 0.000000000000000000001f64 == 1e-21f64);
    expect {|
        0.000000000000000000001 == 1e-21: true
        0.000000000000000000001f64 == 1e-21f64: true
    |}
    float_zeros_show("000000000000000000001.25 == 1.25", 000000000000000000001.25 == 1.25);
    float_zeros_show("000000000000000000001.25f64 == 1.25f64", 000000000000000000001.25f64 == 1.25f64);
    expect {|
        000000000000000000001.25 == 1.25: true
        000000000000000000001.25f64 == 1.25f64: true
    |}
    float_zeros_show("0.00000000000000000000125e21 == 1.25", 0.00000000000000000000125e21 == 1.25);
    float_zeros_show("0.000000000000000000000 == 0.0", 0.000000000000000000000 == 0.0);
    expect {|
        0.00000000000000000000125e21 == 1.25: true
        0.000000000000000000000 == 0.0: true
    |}
}
