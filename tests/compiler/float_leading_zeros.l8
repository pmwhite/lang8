tag example;

import "../../stdlib/print.l8";

main(): int {
    if (0.000000000000000000001 != 1e-21) return 1;
    if (0.000000000000000000001f64 != 1e-21f64) return 2;
    if (000000000000000000001.25 != 1.25) return 3;
    if (000000000000000000001.25f64 != 1.25f64) return 4;
    if (0.00000000000000000000125e21 != 1.25) return 5;
    if (0.000000000000000000000 != 0.0) return 6;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
