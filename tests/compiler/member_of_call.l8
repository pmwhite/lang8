tag example;

use_tag std;

import "../../stdlib/print.l8";

// A member read straight from a call's result: records passed by reference
// and records small enough to come back in a register.
type Big = {
    a: int;
    b: f32;
    c: i8
}

type Small = {
    lo: i32;
    hi: i32
}

type Tiny = {
    x: i8;
    y: i8
}

type Halves = {
    left: f32;
    right: f32
}

big(n: int): Big {
    Big { a: n, b: 1.5, c: 7i8 }
}

small(n: i32): Small {
    Small { lo: n, hi: -n }
}

tiny(): Tiny {
    Tiny { x: 3i8, y: 4i8 }
}

halves(): Halves {
    Halves { left: 0.25, right: 2.5 }
}

test "member of a call" {
    write_int(1, big(41).a + 1);
    if (big(0).b == 1.5) write(1, " b");
    write_int(1, big(0).c as int);
    print("");
    expect {|
        42 b7
    |}
    write_int(1, small(5i32).lo as int);
    write(1, " ");
    write_int(1, small(5i32).hi as int);
    print("");
    expect {|
        5 -5
    |}
    write_int(1, tiny().x as int * 10 + tiny().y as int);
    if (halves().right == 2.5 && halves().left < 1.0) write(1, " halves");
    print("");
    expect {|
        34 halves
    |}
}
