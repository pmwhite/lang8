tag call_evaluation_test;

import "../../stdlib/print.l8";

trace: int = 0;

step(n: int): int {
    trace = trace * 10 + n;
    n
}

combine(a: int, b: int): int {
    a * 10 + b
}

increment(a: int): int {
    a + 1
}

call_probe(x: int): int {
    increment(x)
}

clamp(x: int): int {
    if (x < 0) return 0;
    if (x > 9) return 9;
    x
}

mutate(p: *int): int {
    p.* = 23;
    3
}

change_copy(x: int): int {
    x = x + 5;
    x
}

address_copy(x: int): int {
    _changed: int = mutate(&x);
    x
}

capture(a: int, p: *int): int {
    _changed: int = mutate(p);
    a
}

first(a: int, _b: int): int {
    a
}

float_add(a: f64, b: f64): f64 {
    a + b
}

narrow_add(a: i32, b: i32): i32 {
    a + b
}

unsigned_add(a: u32, b: u32): u32 {
    a + b
}

byte_add(a: i8, b: i8): i8 {
    a + b
}

many(
    a: int,
    b: f64,
    c: int,
    d: f32,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    a + c + e + f + g + h + b as int + d as int
}

recursive(n: int): int {
    if (n == 0) return 0;
    recursive(n - 1) + 1
}

odd(n: int): bool {
    if (n == 0) false else even(n - 1)
}

even(n: int): bool {
    if (n == 0) true else odd(n - 1)
}

type Pair = {
    x: int;
    y: int
}

pair(x: int): Pair {
    Pair { x: x, y: x + 1 }
}

exception Failure;

fail() raises Failure: int {
    raise Failure
}

forward_fail() raises Failure: int {
    fail()
}

// Returning from an expression block needs the ordinary frame cleanup.
expression_return(x: int): int {
    10 + ({
        if (x == 0) return 7;
        x
    })
}

exception_probe(): bool {
    caught: bool = false;
    try {
        _failed: int = forward_fail()
    } with Failure -> {
        caught = true
    }
    caught
}

region_probe(): int {
    region {
        y: int = clamp(-1);
        if (y != 0) return 1;
        a: []int = new int[2](7);
        if (a[1] != 7) return 2
    }
    0
}

ce_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

ce_show_bool(label: str, value: bool) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_bool(value)
}

test "arguments are evaluated left to right" {
    ce_show("combine(step(1), step(2))", combine(step(1), step(2)));
    ce_show("trace", trace);
    expect {|
        combine(step(1), step(2)): 12
        trace: 12
    |}
    // An unused argument is still evaluated.
    trace = 0;
    ce_show("first(step(1), step(2))", first(step(1), step(2)));
    ce_show("trace", trace);
    expect {|
        first(step(1), step(2)): 1
        trace: 12
    |}
}

test "nested calls and early returns" {
    ce_show("combine(increment(2), increment(4))", combine(increment(2), increment(4)));
    ce_show("increment(increment(increment(2)))", increment(increment(increment(2))));
    ce_show("call_probe(8)", call_probe(8));
    expect {|
        combine(increment(2), increment(4)): 35
        increment(increment(increment(2))): 5
        call_probe(8): 9
    |}
    ce_show("clamp(-3)", clamp(-3));
    ce_show("clamp(12)", clamp(12));
    ce_show("clamp(5)", clamp(5));
    expect {|
        clamp(-3): 0
        clamp(12): 9
        clamp(5): 5
    |}
}

test "arguments read a variable before a later argument changes it" {
    x: int = 7;
    ce_show("combine(x, mutate(&x))", combine(x, mutate(&x)));
    ce_show("x", x);
    expect {|
        combine(x, mutate(&x)): 73
        x: 23
    |}
    x = 7;
    xp: *int = &x;
    ce_show("capture(x, xp)", capture(x, xp));
    ce_show("x", x);
    expect {|
        capture(x, xp): 7
        x: 23
    |}
    // Parameters are copies of the arguments.
    ce_show("change_copy(x)", change_copy(x));
    ce_show("x", x);
    ce_show("address_copy(x)", address_copy(x));
    ce_show("x", x);
    expect {|
        change_copy(x): 28
        x: 23
        address_copy(x): 23
        x: 23
    |}
    later: int = 4;
    ce_show("combine(later, later = later + 5)", combine(later, later = later + 5));
    ce_show("later", later);
    expect {|
        combine(later, later = later + 5): 49
        later: 9
    |}
    later = 4;
    ce_show("combine(later, later = 9)", combine(later, later = 9));
    ce_show("later", later);
    expect {|
        combine(later, later = 9): 49
        later: 9
    |}
}

test "parameters are copies" {
    independent: int = 5;
    ce_show("address_copy(independent)", address_copy(independent));
    ce_show("independent", independent);
    expect {|
        address_copy(independent): 23
        independent: 5
    |}
}

test "scalar argument and result types" {
    std::write(1, "float_add(1.25, 2.5): ");
    std::print_fixed(float_add(1.25f64, 2.5f64), 2);
    ce_show("narrow_add(-9, 4)", narrow_add(-9i32, 4i32) as int);
    expect {|
        float_add(1.25, 2.5): 3.75
        narrow_add(-9, 4): -5
    |}
    // Narrow unsigned results wrap.
    ce_show("unsigned_add(4294967295, 1)", unsigned_add(4294967295u32, 1u32) as int);
    ce_show("byte_add(255, 1)", byte_add(255i8, 1i8) as int);
    expect {|
        unsigned_add(4294967295, 1): 0
        byte_add(255, 1): 0
    |}
    // Integer and floating arguments interleave.
    ce_show("many(1, 2.0, 3, 4.0, 5, 6, 7, 8)", many(1, 2.0f64, 3, 4.0, 5, 6, 7, 8));
    expect {|
        many(1, 2.0, 3, 4.0, 5, 6, 7, 8): 36
    |}
}

test "recursion and function pointers" {
    ce_show("recursive(12)", recursive(12));
    ce_show_bool("even(12)", even(12));
    ce_show_bool("odd(11)", odd(11));
    expect {|
        recursive(12): 12
        even(12): true
        odd(11): true
    |}
    fp: fn(value: int): int = &increment;
    ce_show("fp(9)", fp(9));
    expect {|
        fp(9): 10
    |}
}

test "aggregate results" {
    p: Pair = pair(40);
    ce_show("p.x", p.x);
    ce_show("p.y", p.y);
    expect {|
        p.x: 40
        p.y: 41
    |}
}

test "calls in a loop" {
    total: int = 0;
    for i in 0..1000 total = total + increment(i);
    ce_show("total", total);
    expect {|
        total: 500500
    |}
}

test "leaving a frame early" {
    ce_show("expression_return(0)", expression_return(0));
    ce_show("expression_return(3)", expression_return(3));
    expect {|
        expression_return(0): 7
        expression_return(3): 13
    |}
    ce_show_bool("exception_probe()", exception_probe());
    ce_show("region_probe()", region_probe());
    expect {|
        exception_probe(): true
        region_probe(): 0
    |}
}
