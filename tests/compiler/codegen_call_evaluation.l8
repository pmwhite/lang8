tag call_evaluation_test;

trace: int = 0;

step(n: int): int {
    trace = trace * 10 + n;
    n
}

combine(a: int, b: int): int {
    a * 10 + b
}

increment(a: int): int {
    a + 1
}

call_probe(x: int): int {
    increment(x)
}

clamp(x: int): int {
    if (x < 0) return 0;
    if (x > 9) return 9;
    x
}

mutate(p: *int): int {
    p.* = 23;
    3
}

change_copy(x: int): int {
    x = x + 5;
    x
}

address_copy(x: int): int {
    _changed: int = mutate(&x);
    x
}

capture(a: int, p: *int): int {
    _changed: int = mutate(p);
    a
}

first(a: int, _b: int): int {
    a
}

float_add(a: f64, b: f64): f64 {
    a + b
}

narrow_add(a: i32, b: i32): i32 {
    a + b
}

unsigned_add(a: u32, b: u32): u32 {
    a + b
}

byte_add(a: i8, b: i8): i8 {
    a + b
}

many(
    a: int,
    b: f64,
    c: int,
    d: f32,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    a + c + e + f + g + h + b as int + d as int
}

recursive(n: int): int {
    if (n == 0) return 0;
    recursive(n - 1) + 1
}

odd(n: int): bool {
    if (n == 0) false else even(n - 1)
}

even(n: int): bool {
    if (n == 0) true else odd(n - 1)
}

type Pair = {
    x: int;
    y: int
}

pair(x: int): Pair {
    Pair { x: x, y: x + 1 }
}

exception Failure;

fail() raises Failure: int {
    raise Failure
}

forward_fail() raises Failure: int {
    fail()
}

// Returning from an expression block needs the ordinary frame cleanup.
expression_return(x: int): int {
    10 + ({
        if (x == 0) return 7;
        x
    })
}

exception_probe(): bool {
    caught: bool = false;
    try {
        _failed: int = forward_fail()
    } with Failure -> {
        caught = true
    }
    caught
}

region_probe(): int {
    region {
        y: int = clamp(-1);
        if (y != 0) return 1;
        a: []int = new int[2](7);
        if (a[1] != 7) return 2
    }
    0
}

main(): int {
    if (combine(step(1), step(2)) != 12 || trace != 12) return 1;
    if (combine(increment(2), increment(4)) != 35) return 2;
    if (increment(increment(increment(2))) != 5) return 3;
    if (call_probe(8) != 9 || clamp(-3) != 0 || clamp(12) != 9 || clamp(5) != 5) return 4;
    x: int = 7;
    if (combine(x, mutate(&x)) != 73 || x != 23) return 5;
    x = 7;
    xp: *int = &x;
    if (capture(x, xp) != 7 || x != 23) return 18;
    independent: int = 5;
    if (address_copy(independent) != 23 || independent != 5) return 19;
    later: int = 4;
    if (combine(later, later = later + 5) != 49 || later != 9) return 20;
    later = 4;
    if (combine(later, later = 9) != 49 || later != 9) return 22;
    trace = 0;
    if (first(step(1), step(2)) != 1 || trace != 12) return 21;
    if (change_copy(x) != 28 || x != 23 || address_copy(x) != 23 || x != 23) return 6;
    if (float_add(1.25f64, 2.5f64) != 3.75f64) return 7;
    if (narrow_add(-9i32, 4i32) != -5i32) return 8;
    if (unsigned_add(4294967295u32, 1u32) != 0u32 || byte_add(255i8, 1i8) != 0i8) return 9;
    if (many(1, 2.0f64, 3, 4.0, 5, 6, 7, 8) != 36) return 10;
    if (recursive(12) != 12 || !even(12) || !odd(11)) return 11;
    fp: fn(value: int): int = &increment;
    if (fp(9) != 10) return 12;
    p: Pair = pair(40);
    if (p.x != 40 || p.y != 41) return 13;
    total: int = 0;
    for i in 0..1000 total = total + increment(i);
    if (total != 500500) return 14;
    if (expression_return(0) != 7 || expression_return(3) != 13) return 15;
    if (!exception_probe()) return 16;
    if (region_probe() != 0) return 17;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
