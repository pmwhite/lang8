tag example;

use_tag std;

import "../../stdlib/write.l8";

/* write/read of *i8 is one byte; a trusted length is not allowed. */
main(): int {
    s: []i8 = new i8[4](0i8);
    p: *i8 = &s[0];
    write_bytes_n(1, p, 4);
    0
}

//% test: compile-fail
//% error-contains: "argument type mismatch"
