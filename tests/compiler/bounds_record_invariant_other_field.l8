tag bounds_test;

type Buffer = {
    data: []int;
    used: int;
    label: int
} invariant (0 <= used && used <= len(data))

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2, label: 0 };
    b.label = 1;
    b.data[b.used - 1]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 7
