tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    used: int;
    label: int
} invariant (0 <= used && used <= len(data))

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2, label: 0 };
    b.label = 1;
    b.data[b.used - 1]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
