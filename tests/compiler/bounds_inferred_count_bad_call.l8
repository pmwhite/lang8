tag bounds_test;

sum_prefix(a: []int, count: int): int {
    total: int = 0;
    for i in 0..count total = total + a[i];
    total
}

main(): int {
    a: []int = [3, 5];
    sum_prefix(a, 3)
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "call does not prove inferred array bounds requirement"
