tag bounds_test;

import "../../stdlib/print.l8";

advance(i: int): int ensures (returned >= i) {
    start: int = i;
    while (i < 5) invariant (start <= i) i = i + 1;
    i
}

always_ready(): bool ensures (returned == true) {
    true
}

clamp_nonnegative(i: int): int ensures (returned >= 0 && returned >= i) {
    if (i < 0) return 0;
    i
}

read_advanced(xs: []int, i: int): int {
    if (i < 0) return 0;
    j: int = advance(i);
    if (j < len(xs)) return xs[j];
    0
}

main(): int {
    xs: []int = [0, 1, 2, 3, 4, 5];
    if (read_advanced(xs, 0) != 5) return 1;
    if (read_advanced(xs, 5) != 5) return 2;
    if (!always_ready()) return 3;
    if (clamp_nonnegative(0 - 3) != 0) return 4;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
