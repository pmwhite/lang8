tag bounds_test;

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2 };
    alias: *Buffer = b;
    alias.used = 3;
    b.used
}

/* expect compile {|
error: bounds_record_invariant_bad_alias_write.l8:11:11: record invariant is not proved after construction or field assignment
|} */
