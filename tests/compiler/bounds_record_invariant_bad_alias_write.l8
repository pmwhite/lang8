tag bounds_test;

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2 };
    alias: *Buffer = b;
    alias.used = 3;
    b.used
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "record invariant is not proved"
