tag bounds_test;

type Bag = {
    table: []int
} invariant (forall entry in table (0 <= entry && entry < 4))

main(): int {
    b: *Bag = new Bag { table: new int[2](0) };
    alias: []int = b.table;
    alias[0] = 5;
    0
}

/* expect compile {|
error: bounds_record_array_forall_alias.l8:9:22: forall array field cannot be aliased; use direct indexing or len
|} */
