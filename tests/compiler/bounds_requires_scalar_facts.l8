tag bounds_test;

need_nonzero(n: int): int requires (n != 0) {
    if (n == 0) return 1;
    0
}

need_true(flag: bool): int requires (flag == true) {
    if (flag) return 0;
    2
}

main(): int {
    n: int = 1;
    flag: bool = true;
    if (need_nonzero(n) != 0) return 1;
    need_true(flag)
}

//% test: run
//% stdout: ""
//% exit: 0
