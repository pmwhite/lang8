tag bounds_test;

import "../../stdlib/print.l8";

need_nonzero(n: int): int requires (n != 0) {
    if (n == 0) return 1;
    0
}

need_true(flag: bool): int requires (flag == true) {
    if (flag) return 0;
    2
}

main(): int {
    n: int = 1;
    flag: bool = true;
    if (need_nonzero(n) != 0) return 1;
    need_true(flag)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
