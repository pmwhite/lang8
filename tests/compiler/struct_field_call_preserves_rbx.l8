tag field_call;

import "../../stdlib/print.l8";

type Inner = {
    value: int
}

type Outer = {
    first: int;
    inner: *Inner;
    last: int
}

make_inner(): *Inner@new {
    new Inner { value: 19 }
}

test "a call inside a struct literal keeps the other fields" {
    outer: *Outer = new Outer { first: 7, inner: make_inner(), last: 11 };
    std::write(1, "first: ");
    std::print_int(outer.first);
    std::write(1, "inner.value: ");
    std::print_int(outer.inner.value);
    std::write(1, "last: ");
    std::print_int(outer.last);
    expect {|
        first: 7
        inner.value: 19
        last: 11
    |}
}
