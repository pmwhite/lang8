tag field_call;

import "../../stdlib/print.l8";

type Inner = {
    value: int
}

type Outer = {
    first: int;
    inner: *Inner;
    last: int
}

make_inner(): *Inner@new {
    new Inner { value: 19 }
}

main(): int {
    outer: *Outer = new Outer { first: 7, inner: make_inner(), last: 11 };
    if (outer.first == 7 && outer.inner.value == 19 && outer.last == 11) 0 else 1
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
