tag bounds_test;

sum_span(data: []int, base: int, count: int): int requires (0 <= base && base <= len(data) && 0 <= count && count <= len(data) - base) {
    total: int = 0;
    for i in 0..count {
        index: int = base + i;
        total = total + data[index]
    }
    total
}

main(): int {
    data: []int = [1, 2, 3, 4];
    sum_span(data, 1, 3)
}

//% test: run
//% stdout: ""
//% exit: 9
