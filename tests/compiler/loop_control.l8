tag loop_control_test;

import "../../stdlib/print.l8";

sum_seven(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int
): int {
    a + b + c + d + e + f + g
}

read_present(pointer: ?*int): int {
    total: int = 0;
    for _index in 0..2 {
        if (pointer == null)
            continue;
        total = total + pointer.*
    }
    while (true) {
        if (pointer == null)
            break;
        return total + pointer.*
    }
    total
}

spin(): noreturn {
    while (true) {
        for _index in 0..1 {
            break
        }
    }
}

test "loop guards narrow nullable values" {
    value: int = 7;
    std::print_int(read_present(null));
    std::print_int(read_present(&value));
    expect {|
        0
        21
    |}
}

test "while and nested range loops" {
    index: int = 0;
    total: int = 0;
    while (true) {
        index = index + 1;
        if (index == 2)
            continue;
        if (index == 5)
            break;
        total = total + index
    }
    std::print_int(total);
    total = 0;
    for outer in 0..4 {
        if (outer == 1)
            continue;
        for inner in 0..5 {
            if (inner == 2)
                break;
            total = total + outer * 10 + inner
        }
    }
    std::print_int(total);
    expect {|
        8
        103
    |}
}

test "continue increments slices, arrays, and strings" {
    slice: []int = [1, 2, 3, 4, 5];
    array: [5]int = [1, 2, 3, 4, 5];
    total: int = 0;
    for value in slice {
        if (value == 2)
            continue;
        if (value == 4)
            break;
        total = total + value
    }
    std::print_int(total);
    total = 0;
    for value in array {
        if (value == 2)
            continue;
        if (value == 4)
            break;
        total = total + value
    }
    std::print_int(total);
    total = 0;
    for byte in "abcde" {
        if (byte == 'b')
            continue;
        if (byte == 'd')
            break;
        total = total + byte as int
    }
    std::print_int(total);
    expect {|
        4
        4
        196
    |}
}

test "loop jumps discard partially evaluated call arguments" {
    total: int = 0;
    for index in 0..5 total = total + sum_seven(1, 2, 3, 4, 5, 6, if (index == 1) {
        continue
    } else if (index == 3) {
        break
    } else index);
    std::print_int(total);
    expect {|
        44
    |}
}

test "break does not make an infinite loop noreturn" {
    while (true) {
        break
    }
    std::print("after loop");
    expect {|
        after loop
    |}
}
