tag noregion_shared;

saved: ?*int = null;

imported_stash() {
    saved = new int[1](1)
}

/* expect compile {|
store.l8:6:13

    saved = new int[1](1)
            ^^^^^^^^^^^^^

imported_stash stores this allocation in global saved, which can outlive
