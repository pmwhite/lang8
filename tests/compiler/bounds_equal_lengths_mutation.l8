tag bounds_test;

same(a: []int, b: []int): int {
    if (len(a) != len(b)) return 0;
    for i in 0..len(a) {
        if (b[i] != 0) return 1;
        b = [0]
    }
    0
}

main(): int {
    a: []int = [0, 0];
    b: []int = [0, 0];
    same(a, b)
}

//% test: compile-fail
//% error-contains: "unproved array access; use ![] for a runtime check"
