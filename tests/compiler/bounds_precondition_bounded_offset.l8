tag bounds_test;

const STRIDE: int = 6;

write_instance(dst: []int, at: int) requires (0 <= at && at <= len(dst) - 6) {
    dst[at] = 1;
    dst[at + 5] = 2
}

write_cell(dst: []int, base: int) requires (0 <= base && base <= len(dst) - 486) {
    for n in 0..81 write_instance(dst, base + n * STRIDE)
}

main(): int {
    dst: []int = new int[486](0);
    write_cell(dst, 0);
    dst[485]
}

//% test: run
//% stdout: ""
//% exit: 2
