tag example;

import "../../stdlib/print.l8";

tick(counter: *int, value: bool): bool {
    counter.* = counter.* + 1;
    value
}

bv_show(label: str, value: bool) raises std::IoError {
    std::write(1, label);
    if (value) std::write(1, "=true") else std::write(1, "=false")
}

bv_show_int(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, "=");
    std::print_int(value)
}

test "conditions as boolean values" {
    count: int = 0;
    for x in -2..6 {
        inside: bool = x >= 0 && x < 4;
        outside: bool = x < 0 || x >= 4;
        a: bool = x >= 0 && x < 4 && tick(&count, true);
        b: bool = x < 0 || x >= 4 || tick(&count, false);
        // Nested negation and unsigned comparison must retain their conditions.
        u: u32 = x trunc u32;
        c: bool = !(u < 4u32) || x == 2;
        d: bool = outside || x == 2;
        std::write(1, "x=");
        std::write_int(1, x);
        bv_show(" inside", inside);
        bv_show(" outside", outside);
        bv_show(" a", a);
        bv_show(" b", b);
        bv_show(" c", c);
        bv_show(" d", d);
        std::write(1, "\n")
    }
    expect {|
        x=-2 inside=false outside=true a=false b=true c=true d=true
        x=-1 inside=false outside=true a=false b=true c=true d=true
        x=0 inside=true outside=false a=true b=false c=false d=false
        x=1 inside=true outside=false a=true b=false c=false d=false
        x=2 inside=true outside=false a=true b=false c=true d=true
        x=3 inside=true outside=false a=true b=false c=false d=false
        x=4 inside=false outside=true a=false b=true c=true d=true
        x=5 inside=false outside=true a=false b=true c=true d=true
    |}
    // Short-circuiting calls tick only when the earlier operands do not decide.
    bv_show_int("count", count);
    expect {|
        count=8
    |}
    // Value-producing strings and floating comparisons use their usual paths.
    text: str = "same";
    f: f64 = 1.5f64;
    mixed: bool = text == "same" && f > 1.0f64 || tick(&count, false);
    bv_show("mixed", mixed);
    std::write(1, "\n");
    bv_show_int("count", count);
    expect {|
        mixed=true
        count=8
    |}
}
