tag bounds_test;

within(limit: int, base: int, count: int): int requires (0 <= base && base <= limit && 0 <= count && count <= limit - base) {
    count
}

forward(limit: int, base: int): int requires (0 <= base && base <= limit) {
    remaining: int = limit - base;
    within(limit, base, remaining + 1)
}

main(): int {
    forward(10, 3)
}

//% test: compile-fail
//% error-contains: "call does not prove function precondition"
