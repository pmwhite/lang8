tag bounds_test;

import "../../stdlib/print.l8";

const CAP: int = 8;

type Ring = {
    slot: int;
    items: []int
} invariant (0 <= slot && slot < CAP && len(items) == CAP)

main(): int {
    ring: *Ring = new Ring { slot: 7, items: new int[CAP](0) };
    ring.slot = (ring.slot + 1) % CAP;
    ring.items[ring.slot] = 5;
    ring.items[0]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 5
    |}
}
