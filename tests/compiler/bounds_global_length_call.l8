tag bounds_test;

import "../../stdlib/print.l8";

import "../../stdlib/raw_write.l8";

buffer: []int = [4, 5];

calls: int = 0;

count() {
    calls = calls + 1
}

total(a: []int): int {
    a[0] = a[0] + 1;
    a[0]
}

// A call keeps what a guard proved about a global slice's length unless it
// may assign a global: an extern, or a function that writes only elements or
// locals, cannot rebind the slice.
last(): int {
    if (len(buffer) < 2) return 0;
    _w: int = raw::raw_text_sys(1, "checked\n", 8);
    _t: int = total(buffer);
    buffer[1] + buffer[0]
}

main(): int {
    count();
    last()
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        checked
        main returned 10
    |}
}
