tag bounds_test;

fetch(a: []int, i: int) raises IndexOutOfBounds: int {
    first: int = a![i];
    first + a![i]
}

main() raises IndexOutOfBounds: int {
    fetch([7], 0)
}

//% test: run
//% stdout: ""
//% exit: 14
//% compiler-warnings: ["checked access is already proved; use [] instead of ![]"]
