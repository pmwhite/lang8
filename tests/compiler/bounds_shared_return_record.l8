tag bounds_test;

import "../../stdlib/print.l8";

type Holder = {
    data: []int;
    count: int
}

make(n: int): *Holder@new {
    new Holder { data: new int[n](7), count: n }
}

forward(n: int): *Holder@new {
    make(n)
}

main(): int {
    h: *Holder = forward(3);
    h.data[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
