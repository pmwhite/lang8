tag bounds_test;

type Holder = {
    data: []int;
    count: int
}

make(n: int): *Holder@new {
    new Holder { data: new int[n](7), count: n }
}

forward(n: int): *Holder@new {
    make(n)
}

main(): int {
    h: *Holder = forward(3);
    h.data[2]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 7
