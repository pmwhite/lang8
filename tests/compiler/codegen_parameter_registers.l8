tag example;

import "../../stdlib/print.l8";

type Pair = {
    first: int;
    second: int
}

// Aggregate copying must preserve both register and stack scalar parameters.
// The floating argument also needs to survive the copy's xmm0 scratch use.
mixed(
    a: int,
    pair: Pair,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    scale: f64
): int {
    for _i in 0..4 {
        a = a + pair.first;
        b = b + pair.second;
        g = g + a + b + f;
        if (scale != 1.5f64) return -1
    }
    a + b + c + d + e + f + g
}

test "a struct argument between scalar arguments keeps every parameter" {
    pair: Pair = Pair { first: 10, second: 20 };
    std::write(1, "mixed: ");
    std::print_int(mixed(1, pair, 2, 3, 4, 5, 6, 7, 1.5f64));
    expect {|
        mixed: 484
    |}
}
