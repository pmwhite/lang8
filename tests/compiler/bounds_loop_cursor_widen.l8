tag bounds_test;

put(a: []int, i: int) raises IndexOutOfBounds: int {
    a[i] = 1;
    i + 1
}

fill(a: []int, n: int) raises IndexOutOfBounds: int {
    i: int = 0;
    for _k in 0..n {
        if (i >= len(a)) return i;
        i = put(a, i)
    }
    i
}

main() raises IndexOutOfBounds: int {
    fill(new int[8](0), 5)
}

//% test: run
//% stdout: ""
//% exit: 5
