tag bounds_test;

import "../../stdlib/print.l8";

put(a: []int, i: int): int {
    a[i] = 1;
    i + 1
}

fill(a: []int, n: int): int {
    i: int = 0;
    for _k in 0..n {
        if (i >= len(a)) return i;
        i = put(a, i)
    }
    i
}

main(): int {
    fill(new int[8](0), 5)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 5
    |}
}
