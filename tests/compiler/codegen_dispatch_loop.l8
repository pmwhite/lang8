tag dispatch_loop_test;

import "../../stdlib/print.l8";

exception DispatchSignal;

dispatch_loop(code: []int, running: bool): int {
    pc: int = 0;
    total: int = 0;
    while (running) {
        operation: int = code[pc];
        pc = pc + 1;
        match operation {
            0 -> total = total + 1;
            1 -> {
                total = total + 10;
                continue
            }
            2 -> {
                for _index in 0..2 total = total + 100
            }
            3 -> {
                try {
                    raise DispatchSignal
                } with DispatchSignal -> {
                    total = total + 1000;
                    continue
                }
            }
            4 -> {
                region {
                    scratch: []int = new int[4](pc);
                    total = total + len(scratch);
                    continue
                }
            }
            5 -> running = false;
            7 -> return total + 7000;
            8 -> {
                break
            }
            _ -> total = total + 10000
        }
    }
    total
}

main(): int {
    // Every header must run once, and the stop operations must not fetch
    // past the final element. Six is a table hole; nine is outside it.
    if (dispatch_loop([0, 1, 2, 3, 4, 6, 9, 5], true) != 21215) return 1;
    if (dispatch_loop([0, 8], true) != 1) return 2;
    if (dispatch_loop([0, 7], true) != 7001) return 3;
    if (dispatch_loop(new int[0](0), false) != 0) return 4;
    0
}

test "dispatch-loop headers preserve exits, cleanup and wildcard targets" {
    std::print_int(main());
    expect {|
        0
    |}
}
