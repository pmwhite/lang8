tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

clear_buffer(b: *Buffer@new) {
    b.data = new int[0](0)
}

read_after_clear(b: *Buffer@new): int {
    if (b.cursor < 0 || b.cursor >= len(b.data)) return -1;
    clear_buffer(b);
    b.data[b.cursor]
}

main(): int {
    b: *Buffer = new Buffer { data: [1], cursor: 0 };
    read_after_clear(b)
}

/* expect compile {|
error: bounds_field_inequality_call.l8:15:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= b.cursor && b.cursor < len(b.data))
|} */
