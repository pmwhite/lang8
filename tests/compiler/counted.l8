tag example;

import "../../stdlib/raw_write.l8";

import "../../stdlib/print.l8";

/* Counted byte slices and counted, zero-terminated strings. */
putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

sum_n(s: []i8): int {
    t: int = 0;
    n: int = len(s);
    for i in 0..n t = t + s[i] as int;
    t
}

program(argc: int, argv: []str): int {
    if (argc < 1) return 1;
    heap: []i8 = new i8[3](0i8);
    heap[0] = 'Y';
    heap[1] = 'Y';
    heap[2] = 'Y';
    if (len(heap) == 3) putchar('Y');
    if (heap[0] == 'Y') putchar('Y');
    buf: []i8 = new i8[2](0i8);
    buf[0] = 'Y';
    buf[1] = 'Y';
    if (len(buf) == 2) putchar('Y');
    if (buf[1] == 'Y') putchar('Y');
    zs: str = argv[0];
    if (len(zs) > 0) putchar('Y');
    if (len(zs) > 0 && zs[0] != 0i8) putchar('Y');
    if (sum_n(heap) == 'Y' as int * 3) putchar('Y');
    0
}

// Like the runtime, pass the program path as argv[0].
test "program" {
    argv: []str = new str[1]("program");
    status: int = program(1, argv);
    std::print("");
    std::write(1, "program returned ");
    std::print_int(status);
    expect {|
        YYYYYYY
        program returned 0
    |}
}
