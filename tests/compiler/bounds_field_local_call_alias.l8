tag bounds_test;

type Buffer = {
    data: []int
}

clear(b: *Buffer@new) {
    b.data = new int[0](0)
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7] };
    alias: *Buffer = b;
    clear(alias);
    b.data[1]
}

/* expect compile {|
error: bounds_field_local_call_alias.l8:15:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 1 && 1 < len(b.data))
|} */
