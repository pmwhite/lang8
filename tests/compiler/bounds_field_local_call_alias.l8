tag bounds_test;

type Buffer = {
    data: []int
}

clear(b: *Buffer@new) {
    b.data = new int[0](0)
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7] };
    alias: *Buffer = b;
    clear(alias);
    b.data[1]
}

//% test: compile-fail
//% error-contains: "array index not proved in bounds"
