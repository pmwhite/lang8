tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    count: int = 4;
    extra: int = count + 1;
    values: []int = new int[extra](0);
    label: str = "hello";
    for i in 0..len(label) values[i] = i;
    // Element writes preserve a slice's fixed length.
    if (values[4] != 4) return 1;
    total: int = 0;
    for _pass in 0..3 {
        local_count: int = count + 2;
        local_values: []int = new int[local_count](7);
        total = total + local_values[5]
    }
    if (total != 21) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
