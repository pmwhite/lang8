tag counted_buffer_fill;

import "../../stdlib/print.l8";

use_tag std;

type Pair = {
    first: int;
    second: int
}

type Three = {
    a: i8;
    b: i8;
    c: i8
}

calls: int = 0;

extern heap_used(): int = l8_heap_used;

numbers: []int = static_buffer(4, -7);

names: []str = static_buffer(3, "kept");

pairs: []Pair = static_buffer(2, Pair { first: 11, second: 13 });

next_fill(): int {
    calls = calls + 1;
    17
}

test "counted buffers evaluate a fill once without allocating" {
    before: int = heap_used();
    local: []int = buffer(4, next_fill());
    odd: []Three = buffer(3, Three { a: 1i8, b: 2i8, c: 3i8 });
    fixed: []i32 = buffer([2]i32, -19i32);
    print_int(numbers[3]);
    print(names[2]);
    print_int(pairs[1].first + pairs[0].second);
    print_int(local[3]);
    print_int(calls);
    print_int(odd[2].a as int + odd[1].b as int + odd[0].c as int);
    print_int(fixed[1] as int);
    print_bool(heap_used() == before);
    expect {|
        -7
        kept
        24
        17
        1
        6
        -19
        true
    |}
}
