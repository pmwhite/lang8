tag bounds_test;

type Leaf = {
    value: int;
    next: ?*Leaf
}

type Entry = {
    leaf: Leaf;
    weight: int
}

main(): int {
    rows: []Entry = new Entry[1](Entry { leaf: Leaf { value: 0, next: null }, weight: 0 });
    data: []int = new int[1](7);
    alias: *Entry = &rows[0];
    if (alias.leaf.value < 0 || alias.leaf.value >= len(data)) return 0;
    rows[0] = Entry { leaf: Leaf { value: 8, next: null }, weight: 0 };
    data[alias.leaf.value]
}

/* expect compile {|
error: bounds_shallow_record_alias_negative.l8:19:9: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= alias.leaf.value && alias.leaf.value < len(data))
|} */
