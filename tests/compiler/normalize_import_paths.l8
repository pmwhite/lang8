tag compiler_internal;

import "../../src2/common.l8";

import "../../src2/assembler.l8";

import "../../src2/direct.l8";

import "../../src2/compiler.l8";

import "../../src2/elfpack.l8";

import "../../src2/browse.l8";

import "../../src2/fmt.l8";

import "../../src2/boolint.l8";

import "../../src2/forlint.l8";

import "../../src2/unreachable.l8";

import "../../src2/unusedfields.l8";

import "../../src2/unusedassign.l8";

import "../../src2/bounds_model.l8";

import "../../src2/bounds_terms.l8";

import "../../src2/bounds_state.l8";

import "../../src2/bounds_solver.l8";

import "../../src2/bounds_contracts.l8";

import "../../src2/bounds_effects.l8";

import "../../src2/bounds_records.l8";

import "../../src2/bounds_implications.l8";

import "../../src2/bounds_returns.l8";

import "../../src2/bounds_flow.l8";

import "../../src2/bounds_driver.l8";

import "../../stdlib/print.l8";

main() noregion raises Error: int {
    init_dummies();
    init_runtime();
    if (!streq(normalize_path("../.."), "../..")) return 1;
    if (!streq(normalize_path("../../file.l8"), "../../file.l8")) return 2;
    if (!streq(normalize_path("../part/../../file.l8"), "../../file.l8")) return 3;
    if (!streq(normalize_path("/../../file.l8"), "/file.l8")) return 4;
    if (!streq(normalize_path("/part/../.."), "/")) return 5;
    if (!streq(normalize_path("part/../file.l8"), "file.l8")) return 6;
    if (!streq(normalize_path("./part//./file.l8"), "part/file.l8")) return 7;
    if (!streq(normalize_path("part/.."), ".")) return 8;
    if (!streq(resolve_import_path("../../part/main.l8", "../unit.l8"), "../../unit.l8")) return 9;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
