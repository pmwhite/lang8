normalize_show(path: []i8) raises Error, std::IoError {
    std::write_bytes(1, path);
    std::write(1, " -> ");
    std::write_bytes(1, normalize_path(path));
    std::write(1, "\n")
}

test "normalize_path keeps leading parent directories" {
    init_dummies();
    init_runtime();
    normalize_show("../..");
    normalize_show("../../file.l8");
    normalize_show("../part/../../file.l8");
    expect {|
        ../.. -> ../..
        ../../file.l8 -> ../../file.l8
        ../part/../../file.l8 -> ../../file.l8
    |}
}

test "normalize_path stops parent directories at the root" {
    init_dummies();
    init_runtime();
    normalize_show("/../../file.l8");
    normalize_show("/part/../..");
    expect {|
        /../../file.l8 -> /file.l8
        /part/../.. -> /
    |}
}

test "normalize_path drops empty, current and cancelled parts" {
    init_dummies();
    init_runtime();
    normalize_show("part/../file.l8");
    normalize_show("./part//./file.l8");
    normalize_show("part/..");
    expect {|
        part/../file.l8 -> file.l8
        ./part//./file.l8 -> part/file.l8
        part/.. -> .
    |}
}

test "resolve_import_path is relative to the importing file" {
    init_dummies();
    init_runtime();
    std::write(1, "../unit.l8 from ../../part/main.l8 -> ");
    std::write_bytes(1, resolve_import_path("../../part/main.l8", "../unit.l8"));
    std::write(1, "\n");
    expect {|
        ../unit.l8 from ../../part/main.l8 -> ../../unit.l8
    |}
}
