tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

make_buffer(): *Buffer@new {
    new Buffer { data: [4, 7], used: 2 }
}

sum_used(b: *Buffer): int {
    total: int = 0;
    for i in 0..b.used total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = make_buffer();
    sum_used(b) + b.data[1]
}

//% test: run
//% stdout: ""
//% exit: 18
