tag bounds_test;

type Buffer = {
    data: []int;
    used: int;
    visits: int
}

sum_used(b: *Buffer): int {
    total: int = 0;
    for i in 0..b.used total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 0, visits: 0 };
    b.used = 2;
    b.visits = 1;
    sum_used(b) + b.data[1]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 18
