tag bounds_test;

import "../../stdlib/print.l8";

set_at(out: []int, at: int): int requires (0 <= at && at < len(out)) ensures (out[at] == 0) {
    out[at] = 0;
    0
}

main(): int {
    out: []int = [2, 3];
    at: int = 1;
    result: int = set_at(out, at);
    if (result != 0) return 1;
    if (out[at] != 0) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
