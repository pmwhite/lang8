tag operand_test;

import "../../stdlib/print.l8";

change(p: *int): int {
    p.* = 9;
    3
}

add(a: int, b: int): int {
    a + b
}

six(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int
): int {
    a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
}

seven(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int
): int {
    six(a, b, c, d, e, f) + g * 7
}

main(): int {
    x: int = 2;
    if (change(&x) + x != 12) return 1;
    if (add(x, change(&x)) != 12) return 2;
    if (six(1, 2, 3, 4, 5, add(3, 3)) != 91) return 3;
    if (seven(1, 2, 3, 4, 5, 6, 7) != 140) return 4;
    a: i32 = -17i32;
    b: i32 = 3i32;
    if (a + b != -14i32 || a / b != -5i32 || a % b != -2i32) return 5;
    u: u32 = 4294967295u32;
    v: u32 = 1u32;
    bits: int = 1;
    if (u + v != 0u32 || u >> bits != 2147483647u32) return 6;
    f: f64 = 1.25f64;
    g: f64 = 2.0f64;
    if (f * g != 2.5f64) return 7;
    byte: i8 = 255i8;
    if (byte + 1i8 != 0i8) return 8;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
