tag operand_test;

import "../../stdlib/print.l8";

change(p: *int): int {
    p.* = 9;
    3
}

add(a: int, b: int): int {
    a + b
}

six(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int
): int {
    a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
}

seven(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int
): int {
    six(a, b, c, d, e, f) + g * 7
}

operand_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "operands are read after earlier calls change them" {
    x: int = 2;
    first: int = change(&x) + x;
    operand_show("change(&x) + x", first);
    expect {|
        change(&x) + x: 12
    |}
    second: int = add(x, change(&x));
    operand_show("add(x, change(&x))", second);
    expect {|
        add(x, change(&x)): 12
    |}
}

test "calls with six and seven arguments" {
    operand_show("six(1, 2, 3, 4, 5, add(3, 3))", six(1, 2, 3, 4, 5, add(3, 3)));
    expect {|
        six(1, 2, 3, 4, 5, add(3, 3)): 91
    |}
    operand_show("seven(1, 2, 3, 4, 5, 6, 7)", seven(1, 2, 3, 4, 5, 6, 7));
    expect {|
        seven(1, 2, 3, 4, 5, 6, 7): 140
    |}
}

test "i32 operands" {
    a: i32 = -17i32;
    b: i32 = 3i32;
    sum: i32 = a + b;
    quotient: i32 = a / b;
    remainder: i32 = a % b;
    operand_show("a + b", sum as int);
    operand_show("a / b", quotient as int);
    operand_show("a % b", remainder as int);
    expect {|
        a + b: -14
        a / b: -5
        a % b: -2
    |}
}

test "u32 operands wrap and shift without sign" {
    u: u32 = 4294967295u32;
    v: u32 = 1u32;
    bits: int = 1;
    sum: u32 = u + v;
    shifted: u32 = u >> bits;
    operand_show("u + v", sum as int);
    operand_show("u >> bits", shifted as int);
    expect {|
        u + v: 0
        u >> bits: 2147483647
    |}
}

test "f64 operands" {
    f: f64 = 1.25f64;
    g: f64 = 2.0f64;
    product: f64 = f * g;
    std::write(1, "f * g: ");
    std::print_fixed(product, 9);
    expect {|
        f * g: 2.500000000
    |}
}

test "i8 operands wrap" {
    byte: i8 = 255i8;
    sum: i8 = byte + 1i8;
    operand_show("byte + 1i8", sum as int);
    expect {|
        byte + 1i8: 0
    |}
}
