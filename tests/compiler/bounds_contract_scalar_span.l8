tag bounds_test;

within(limit: int, base: int, count: int): int requires (0 <= base && base <= limit && 0 <= count && count <= limit - base) ensures (returned <= limit - base) {
    count
}

forward(limit: int, base: int): int requires (0 <= base && base <= limit) {
    remaining: int = limit - base;
    within(limit, base, remaining)
}

main(): int {
    if (forward(10, 3) != 7) return 1;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
