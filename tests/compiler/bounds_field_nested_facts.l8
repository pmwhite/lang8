tag bounds_test;

type Inner = {
    data: []int
}

type Outer = {
    child: *Inner;
    visits: int
}

main(): int {
    inner: *Inner = new Inner { data: new int[0](0) };
    o: *Outer = new Outer { child: inner, visits: 0 };
    o.child.data = [5, 9];
    o.visits = 1;
    o.child.data[1]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 9
