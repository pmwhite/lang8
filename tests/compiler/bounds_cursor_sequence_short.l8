tag bounds_test;

put_two(a: []int, i: int): int {
    a[i] = 1;
    a[i + 1] = 2;
    i + 2
}

put_six(a: []int, i: int): int {
    i = put_two(a, i);
    i = put_two(a, i);
    i = put_two(a, i);
    i
}

main(): int {
    a: []int = new int[5](0);
    put_six(a, 0)
}

//% test: compile-fail
//% error-contains: "call does not prove inferred array bounds requirement"
