tag bounds_test;

put_two(a: []int, i: int): int {
    a[i] = 1;
    a[i + 1] = 2;
    i + 2
}

put_six(a: []int, i: int): int {
    i = put_two(a, i);
    i = put_two(a, i);
    i = put_two(a, i);
    i
}

main(): int {
    a: []int = new int[5](0);
    put_six(a, 0)
}

/* expect compile {|
error: bounds_cursor_sequence_short.l8:18:5: call does not prove inferred array bounds requirement for put_six 5 < len(a)
|} */
