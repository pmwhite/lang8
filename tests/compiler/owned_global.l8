tag example;

use_tag std;

import "../../stdlib/print.l8";

extern l8_arena_live(): int;

type Box = {
    n: int
}

slot: ?owned *Box = null;

relocate(): ?owned *Box {
    move slot
}

borrowed_number(): int {
    borrow slot {
        slot.n
    }
}

test "a borrow keeps its arena when its global owner moves" {
    drop slot;
    slot = own {
        new Box { n: 7 }
    };
    held: ?owned *Box = null;
    borrow slot {
        held = relocate();
        alias: *Box = slot;
        allocate alias {
            extra: *Box = new Box { n: 8 };
            print_int(extra.n)
        }
        print_int(slot.n)
    }
    borrow held {
        print_int(held.n)
    }
    drop held;
    expect {|
        8
        7
        7
    |}
}

test "a global owner is replaced after drop" {
    before: int = l8_arena_live();
    drop slot;
    slot = own {
        new Box { n: 4 }
    };
    print_int(borrowed_number());
    drop slot;
    print_int(l8_arena_live() - before);
    expect {|
        4
        0
    |}
}
