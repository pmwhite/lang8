tag bounds_test;

type Buffer = {
    data: []int;
    visits: int
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7, 9], visits: 0 };
    i: int = 0;
    if (i >= 0 && i <= len(b.data) - 2) {
        b.visits = 1;
        return b.data[i + 1]
    }
    0
}

//% test: run
//% stdout: ""
//% exit: 7
