tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    visits: int
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7, 9], visits: 0 };
    i: int = 0;
    if (i >= 0 && i <= len(b.data) - 2) {
        b.visits = 1;
        return b.data[i + 1]
    }
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
