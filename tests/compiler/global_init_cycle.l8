tag example;

/* Initializers that depend on each other would observe an uninitialized value. */
a: []i8 = new i8[len(b)](0i8);

b: []i8 = make();

make(): []i8@new {
    new i8[len(a) + 1](0i8)
}

main(): int {
    len(a) + len(b)
}

/* expect compile {|
error: global_init_cycle.l8:6:1: global initializers for b and a depend on each other
|} */
