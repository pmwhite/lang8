tag example;

type Box = {
    n: int
}

type Hold = {
    item: *Box
}

main(): int {
    box: owned *Hold = own {
        new Hold { item: new Box { n: 1 } }
    };
    borrow box {
        region {
            tmp: *Box = new Box { n: 2 };
            box.item = tmp
        }
    }
    drop box;
    0
}

/* expect compile {|
error: owned_region.l8:18:17: region pointer cannot escape in main
|} */
