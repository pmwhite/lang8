tag bounds_test;

import "../../stdlib/print.l8";

pick(a: []int, i: int): int {
    if (i < 0 || i >= len(a) - 1) return 0;
    j: int = i + 1;
    a[j]
}

main(): int {
    a: []int = [1, 2, 3];
    pick(a, 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
