tag example;

type Box = {
    n: int
}

type Shape =
    | One { item: *Box }
    | None

main(): int {
    holder: *Box = new Box { n: 0 };
    region {
        box: *Shape = new Shape.One { item: new Box { n: 4 } };
        match box.* {
            One s -> holder = s.item;
            None -> { }
        }
    }
    0
}

/* expect compile {|
error: region_match_escape.l8:16:22: region pointer cannot escape in main
|} */
