tag example;

type Box = {
    n: int
}

type Hold = {
    item: *Box
}

// Indexes are dynamic, so two element borrows may name different arenas.
main(): int {
    holds: []?owned *Hold = new ?owned *Hold[2](null);
    holds[0] = own {
        new Hold { item: new Box { n: 1 } }
    };
    holds[1] = own {
        new Hold { item: new Box { n: 2 } }
    };
    borrow holds[0] as first {
        borrow holds[1] as second {
            first.item = second.item
        }
    }
    drop holds[0];
    drop holds[1];
    0
}

/* expect compile {|
error: owned_slice_cross.l8:22:19: arena pointer cannot escape in main
|} */
