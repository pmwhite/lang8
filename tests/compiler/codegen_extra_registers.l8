tag example;

import "../../stdlib/print.l8";

// All four values stay live across a call which uses the same registers.
four(limit: int): int {
    a: int = 1;
    b: int = 2;
    c: int = 3;
    d: int = 4;
    for i in 0..limit {
        a = a + four(0) - 4320;
        b = b + 2;
        c = c + 3;
        d = d + 4;
        if (i == 4 && limit == 5) return a + b * 10 + c * 100 + d * 1000
    }
    a + b * 10 + c * 100 + d * 1000
}

test "four values live across recursive calls" {
    std::write(1, "four(0): ");
    std::print_int(four(0));
    expect {|
        four(0): 4321
    |}
    std::write(1, "four(10): ");
    std::print_int(four(10));
    expect {|
        four(10): 47531
    |}
    // Returning from inside the loop.
    std::write(1, "four(5): ");
    std::print_int(four(5));
    expect {|
        four(5): 25926
    |}
}
