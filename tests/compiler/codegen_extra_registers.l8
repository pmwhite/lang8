tag example;

import "../../stdlib/print.l8";

// All four values stay live across a call which uses the same registers.
four(limit: int): int {
    a: int = 1;
    b: int = 2;
    c: int = 3;
    d: int = 4;
    for i in 0..limit {
        a = a + four(0) - 4320;
        b = b + 2;
        c = c + 3;
        d = d + 4;
        if (i == 4 && limit == 5) return a + b * 10 + c * 100 + d * 1000
    }
    a + b * 10 + c * 100 + d * 1000
}

main(): int {
    if (four(0) != 4321) return 1;
    if (four(10) != 47531) return 2;
    if (four(5) != 25926) return 3;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
