tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    key: []int = [1, 2, 3, 4];
    total: int = 0;
    for i in 0..8 total = total + key[i % 4];
    total
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 20
    |}
}
