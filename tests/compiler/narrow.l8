tag example;

import "../../stdlib/raw_write.l8";

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

len_ptr(p: ?*int): int {
    if (p != null && p.* >= 0) return p.*;
    -1
}

either_null(a: ?*int, b: ?*int): int {
    if (a == null || b == null) 1 else a.* + b.*
}

test "narrow" {
    x: int = 3;
    p: ?*int = &x;
    if (len_ptr(p) == 3) putchar('Y');
    q: ?*int = null;
    if (len_ptr(q) == -1) putchar('Y');
    if (either_null(null, &x) == 1) putchar('Y');
    if (either_null(&x, &x) == 6) putchar('Y');
    putchar('\n');
    expect {|
        YYYY
    |}
}
