tag bounds_test;

import "../../stdlib/print.l8";

type Counter = {
    count: int
} invariant (0 <= count && count <= 15)

bump(c: *Counter) {
    if (c.count < 15) c.count = c.count + 1
}

main(): int {
    c: *Counter = new Counter { count: 0 };
    bump(c);
    c.count
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 1
    |}
}
