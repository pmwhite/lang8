tag example;

import "../../stdlib/print.l8";

type Copies = {
    texts: []str;
    raw: [][]i8
}

// Many strings and byte copies made in an arena, so that some of them
// need a new chunk: a copy must keep its length across the allocation
// (the runtime's cstr and bytes hold it in a register while they call
// malloc, whose chunk growth is a system call).
copies(count: int, size: int): *Copies@new {
    texts: []str = new str[count]("");
    raw: [][]i8 = new []i8[count](new i8[0](0i8));
    source: []i8 = new i8[size](0i8);
    for i in 0..count {
        for k in 0..size source[k] = (97 + (i + k) % 26) trunc i8;
        texts[i] = cstr(source);
        raw[i] = bytes(texts[i])
    }
    new Copies { texts: texts, raw: raw }
}

test "string copies in an arena keep their lengths" {
    made: owned *Copies = own {
        copies(300, 1000)
    };
    borrow made {
        good: int = 0;
        for i in 0..len(made.texts) {
            text: str = made.texts[i];
            same: bool = len(text) == 1000 && len(made.raw[i]) == 1000;
            if (same) {
                for k in 0..1000
                    if (text[k] as int != 97 + (i + k) % 26 || made.raw[i][k] != text[k]) same = false
            }
            if (same) good = good + 1
        }
        std::print_int(good)
    }
    drop made;
    expect {|
        300
    |}
}
