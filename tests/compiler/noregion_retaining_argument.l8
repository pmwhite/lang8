tag example;

extern save(value: *int@immortal): int;

main(): int {
    save(new int[1](1))
}

/* expect compile {|
noregion_retaining_argument.l8:6:10

    save(new int[1](1))
         ^^^^^^^^^^^^^

main passes this allocation to parameter value of save, whose @immortal
contract allows it to retain the value.

For retained storage, declare main and its callers as noregion
(unavailable inside regions), or use a borrowing parameter if the callee
does not retain the value.

|} */
