tag bounds_test;

skip_spaces(data: []i8, i: int): int ensures (returned >= i) {
    start: int = i;
    while (i < len(data) && data[check_index(data, i)] == ' ') invariant (start <= i) i = i + 1;
    i
}

read_after_spaces(data: []i8, i: int): i8 {
    if (i < 0) return 0i8;
    next: int = skip_spaces(data, i);
    if (next < len(data)) return data[next];
    0i8
}

read_with_cursor(data: []i8): i8 {
    i: int = 0;
    while (i < len(data)) invariant (0 <= i) {
        i = skip_spaces(data, i);
        if (i >= len(data)) return 0i8;
        if (data[i] != ' ') return data[i];
        i = i + 1
    }
    0i8
}

main(): int {
    data: []i8 = [' ', ' ', 'x'];
    if (read_after_spaces(data, 0) != 'x') return 1;
    if (read_with_cursor(data) != 'x') return 2;
    0
}

