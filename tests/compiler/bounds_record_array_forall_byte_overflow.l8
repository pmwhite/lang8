tag bounds_test;

type Bytes = {
    values: []i8
} invariant (forall value in values (value <= 128i8))

main(): int {
    bytes: *Bytes = new Bytes { values: new i8[1](0i8) };
    bytes.values[0] = 255i8;
    0
}

/* expect compile {|
error: bounds_record_array_forall_byte_overflow.l8:1:1: type invariant is not proved
|} */
