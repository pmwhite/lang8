import "../../stdlib/print.l8";

exception IndexOutOfBounds;

tag bounds_test;

sum(a: []int, n: int) raises IndexOutOfBounds: int {
    if (n <= 0) return 0;
    if (n - 1 < 0 || n - 1 >= len(a)) raise IndexOutOfBounds;
    total: int = 0;
    for i in 0..n total = total + a[i];
    total
}

main() raises IndexOutOfBounds: int {
    a: []int = [1, 2, 3];
    sum(a, 3)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 6
    |}
}
