tag bounds_test;

import "../../stdlib/print.l8";

type SignedBag = {
    table: []int
} invariant (len(table) == 2, forall entry in table (0 - 1 <= entry && entry < 4))

main(): int {
    bag: *SignedBag = new SignedBag { table: new int[2](0) };
    bag.table[0] = -1;
    bag.table[1] = 3;
    bag.table[0] + bag.table[1]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
