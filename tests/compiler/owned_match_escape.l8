tag example;

type Box = {
    n: int
}

type Shape =
    | One { item: *Box }
    | None

main(): int {
    holder: *Box = new Box { n: 0 };
    box: owned *Shape = own {
        new Shape.One { item: new Box { n: 4 } }
    };
    borrow box {
        match box.* {
            One s -> holder = s.item;
            None -> { }
        }
    }
    drop box;
    0
}

/* expect compile {|
error: owned_match_escape.l8:18:22: arena pointer cannot escape in main
|} */
