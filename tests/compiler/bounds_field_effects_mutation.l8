tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

shrink(b: *Buffer@new) {
    b.data = new int[0](0)
}

forward_shrink(b: *Buffer@new) {
    shrink(b)
}

sum_after_shrink(b: *Buffer@new): int {
    if (b.used > len(b.data)) return -1;
    for i in 0..b.used {
        forward_shrink(b);
        return b.data[i]
    }
    0
}

main(): int {
    b: *Buffer = new Buffer { data: [1], used: 1 };
    sum_after_shrink(b)
}

//% test: compile-fail
//% error-contains: "unproved array access requires raises IndexOutOfBounds"
