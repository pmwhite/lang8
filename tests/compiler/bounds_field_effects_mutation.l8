tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

shrink(b: *Buffer@new) {
    b.data = new int[0](0)
}

forward_shrink(b: *Buffer@new) {
    shrink(b)
}

sum_after_shrink(b: *Buffer@new): int {
    if (b.used > len(b.data)) return -1;
    for i in 0..b.used {
        forward_shrink(b);
        return b.data[i]
    }
    0
}

main(): int {
    b: *Buffer = new Buffer { data: [1], used: 1 };
    sum_after_shrink(b)
}

/* expect compile {|
error: bounds_field_effects_mutation.l8:20:22: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= i && i < len(b.data))
|} */
