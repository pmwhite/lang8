tag bounds_test;

type Cell = {
    value: int
}

main(): int {
    cells: []Cell = new Cell[1](Cell { value: 0 });
    p: *Cell = &cells[0];
    if (p.value < 0) return 0;
    cells[0] = Cell { value: -1 };
    data: []int = [4];
    data[p.value]
}

//% test: compile-fail
//% error-contains: "unproved array access; use ![] for a runtime check"
