tag bounds_test;

sum_four(a: []int): int {
    if (len(a) < 3) return 0;
    total: int = 0;
    for i in 0..4 total = total + a[i];
    total
}

main(): int {
    a: []int = [1, 2, 3];
    sum_four(a)
}

//% test: compile-fail
//% error-contains: "unproved array access requires raises IndexOutOfBounds"
