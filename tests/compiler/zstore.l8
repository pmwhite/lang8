tag example;

/* str is immutable; use bytes(s) for a mutable copy. */
main(argc: int, argv: []str): int {
    if (argc < 1) return 1;
    s: str = argv[0];
    s[0] = 1i8;
    0
}

/* expect compile {|
error: zstore.l8:7:5: s is immutable str; use bytes(s) for a separate mutable copy or a []i8 buffer for shared changes
|} */
