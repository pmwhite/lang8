tag bounds_test;

step(limit: int): int requires (0 <= limit && limit <= 240) ensures (returned <= 240) {
    x: int = 0;
    right: int = 0;
    while (x < limit) invariant (0 <= x && x <= 240 && 0 <= right && right <= 240) {
        if (x + 1 > right) right = x + 1;
        x = x + 1
    }
    right
}

main(): int {
    step(240)
}

//% test: run
//% stdout: ""
//% exit: 240
