tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

type Outer = {
    child: *Buffer
}

write_next(b: *Buffer) raises IndexOutOfBounds {
    b.data![b.cursor + 1] = 9
}

forward(o: *Outer) raises IndexOutOfBounds {
    write_next(o.child)
}

main() raises IndexOutOfBounds: int {
    b: *Buffer = new Buffer { data: new int[0](0), cursor: 0 };
    o: *Outer = new Outer { child: b };
    o.child.data = [0, 0];
    o.child.cursor = 0;
    forward(o);
    o.child.data[1]
}

//% test: run
//% stdout: ""
//% exit: 9
