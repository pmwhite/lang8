tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    cursor: int
}

type Outer = {
    child: *Buffer
}

write_next(b: *Buffer) {
    b.data[b.cursor + 1] = 9
}

forward(o: *Outer) {
    write_next(o.child)
}

main(): int {
    b: *Buffer = new Buffer { data: new int[0](0), cursor: 0 };
    o: *Outer = new Outer { child: b };
    o.child.data = [0, 0];
    o.child.cursor = 0;
    forward(o);
    o.child.data[1]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
