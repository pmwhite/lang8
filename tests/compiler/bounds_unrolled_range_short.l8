tag bounds_test;

put2(dst: []int, i: int, v: int): int requires (0 <= i && i <= len(dst) - 2) ensures (returned == i + 2) {
    dst[i] = v;
    dst[i + 1] = v;
    i + 2
}

// The fifth iteration has no room left.
fill(dst: []int): int requires (8 <= len(dst)) {
    i: int = 0;
    for k in 0..5 i = put2(dst, i, k);
    i
}

main(): int {
    d: []int = new int[8](0);
    fill(d)
}

/* expect compile {|
error: bounds_unrolled_range_short.l8:12:23: call does not prove function precondition
|} */
