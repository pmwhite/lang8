tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    n: int = 0;
    n = 3;
    a: []int = new int[n](0);
    for i in 0..n a[i] = i;
    a[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
