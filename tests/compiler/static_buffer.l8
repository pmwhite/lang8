tag static_buffer_test;

import "../../stdlib/print.l8";

use_tag std;

extern heap_used(): int = l8_heap_used;

first: []i8 = static_buffer([4096]i8);

second: []int = static_buffer([32]int);

third: []i8 = static_buffer([4096]i8);

literal: []int = [3, 5, 7];

literal_names: []str = ["first", "second"];

named: []i8 = static_buffer(STATIC_CAPACITY * 2, 0i8);

const STATIC_CAPACITY: int = 1024;

static_view(): []i8 {
    first
}

test "static counted storage is distinct and can outlive a call" {
    before: int = heap_used();
    view: []i8 = static_view();
    view[4095] = 7i8;
    second[31] = 11;
    print_int(len(first));
    print_int(len(second));
    print_int(len(named));
    print_int(first[0] as int + first[4095] as int + second[31] + third[4095] as int);
    print_int(literal[2]);
    print(literal_names[1]);
    print_bool(heap_used() == before);
    expect {|
        4096
        32
        2048
        18
        7
        second
        true
    |}
}
