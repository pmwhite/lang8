tag bounds_test;

// Only main proves this access, so the fixture checks that it compiles
// and has no test that would call main.
main(): int {
    n: int = 3;
    a: []int = new int[n](0);
    for i in 0..n {
        // Forgetting n preserves i < len(a) through the old value of n.
        n = 0;
        a[i] = 1
    }
    0
}
