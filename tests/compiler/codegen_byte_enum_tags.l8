tag byte_enum_tag_test;

import "../../stdlib/print.l8";

type Choice: i8 =
    | 0 Empty
    | 1 Value { number: int }
    | 255 High { number: int }

type Tiny: i8, 8 =
    | 0 Zero
    | 255 Byte { number: i8 }

type Envelope = {
    before: int;
    choice: Choice;
    after: int
}

pick(choice: Choice): int {
    match choice {
        Empty -> -1;
        Value payload -> payload.number;
        High payload -> payload.number + 100
    }
}

pick_tiny(choice: Tiny): int {
    match choice {
        Zero -> -1;
        Byte payload -> payload.number as int
    }
}

make_choice(): Choice {
    Choice.High { number: 23 }
}

main(): int {
    choice: Choice = Choice.Value { number: 42 };
    if (pick(choice) != 42) return 1;
    choice = Choice.High { number: 7 };
    if (pick(choice) != 107) return 2;
    choice = Choice.Empty;
    if (pick(choice) != -1) return 3;
    choice = make_choice();
    if (pick(choice) != 123) return 4;
    pointer: *Choice = new Choice.High { number: 19 };
    if (pick(pointer.*) != 119) return 5;
    pointer.* = Choice.Value { number: 29 };
    if (pick(pointer.*) != 29) return 6;
    envelope: Envelope = Envelope { before: 11, choice: Choice.High { number: 37 }, after: 13 };
    if (pick(envelope.choice) != 137 || envelope.before != 11 || envelope.after != 13) return 7;
    tiny: Tiny = Tiny.Byte { number: 255i8 };
    if (pick_tiny(tiny) != 255) return 8;
    tiny = Tiny.Zero;
    if (pick_tiny(tiny) != -1) return 9;
    tiny_pointer: *Tiny = new Tiny.Byte { number: 17i8 };
    if (pick_tiny(tiny_pointer.*) != 17) return 10;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
