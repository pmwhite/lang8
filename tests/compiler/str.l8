tag example;

import "../../stdlib/raw_write.l8";

import "../../stdlib/print.l8";

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

program(argc: int, argv: []str): int requires (argc <= len(argv)) {
    literal: str = "hi";
    if (len(literal) == 2 && literal[0] == 'h' && literal[1] == 'i') putchar('Y');
    if (literal == "hi") putchar('Y');
    if (literal != "ho") putchar('Y');
    raw: []i8 = new i8[2](0i8);
    raw[0] = 'h';
    raw[1] = 'i';
    made: str = cstr(raw);
    if (made == literal) putchar('Y');
    mutable: []i8 = bytes(made);
    if (len(mutable) > 0) mutable[0] = 'Y';
    if (len(mutable) > 0 && len(made) > 0 && mutable[0] == 'Y' && made[0] == 'h') putchar('Y');
    maybe: ?str = made;
    if (maybe != null && maybe == "hi") putchar('Y');
    left: ?str = "same";
    right: ?str = "same";
    if (left == right) putchar('Y');
    empty_left: ?str = null;
    empty_right: ?str = null;
    if (empty_left == empty_right) putchar('Y');
    if (left != empty_left) putchar('Y');
    none: ?str = null;
    fallback: str = none or "Y";
    if (len(fallback) > 0) putchar(fallback[0]);
    for c in "Y" putchar(c);
    if (argc > 0 && len(argv[0]) > 0) putchar('Y');
    putchar('\n');
    0
}

// Like the runtime, pass the program path as argv[0].
test "program" {
    argv: []str = new str[1]("program");
    status: int = program(1, argv);
    std::write(1, "program returned ");
    std::print_int(status);
    expect {|
        YYYYYYYYYYYY
        program returned 0
    |}
}
