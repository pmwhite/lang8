tag example;

import "../../stdlib/raw_write.l8";

/* noregion is exact and transitive: stash stashes new, so main must say so too. */
g: ?*int = null;

stash() noregion {
    g = new int[1](0)
}

main() noregion: int {
    stash();
    raw::raw_write(1, "Y\n");
    0
}

//% test: run
//% stdout: "Y\n"
//% exit: 0
