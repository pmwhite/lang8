tag example;

import "../../stdlib/raw_write.l8";

import "../../stdlib/print.l8";

/* noregion is exact and transitive: stash stashes new, so main must say so too. */
g: ?*int = null;

stash() noregion {
    g = new int[1](0)
}

main() noregion: int {
    stash();
    raw::raw_write(1, "Y\n");
    0
}

test "stash stores a new allocation in g" {
    if (g == null) std::print("before stash: g is null") else std::print("before stash: g is set");
    expect {|
        before stash: g is null
    |}
    stash();
    if (g == null) std::print("after stash: g is null") else std::print("after stash: g is set");
    expect {|
        after stash: g is set
    |}
}

test "main declares noregion because it calls stash" {
    status: int = main();
    expect {|
        Y
    |}
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
