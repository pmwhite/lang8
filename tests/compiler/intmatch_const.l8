tag example;

import "../../stdlib/print.l8";

// Integer match arms may name integer consts, matched as their values.
const OP_LOAD: int = 32;

const OP_STORE: int = 37;

const OP_NEGATIVE: int = 0 - 3;

const LETTER_A: i8 = 'A';

operation_name(op: int): int {
    match op {
        OP_LOAD -> 1;
        OP_STORE -> 2;
        OP_NEGATIVE -> 3;
        4 -> 4;
        _ -> 5
    }
}

letter_case(c: i8): int {
    match c {
        LETTER_A -> 6;
        _ -> 7
    }
}

// (Enough arms to be dispatched by splitting their values: negative,
// large and close together.)
spread_case(n: int): int {
    match n {
        1099511627776 -> 10;
        -5 -> 11;
        OP_LOAD -> 12;
        0 -> 13;
        OP_STORE -> 14;
        33 -> 15;
        -2147483649 -> 16;
        7 -> 17;
        8 -> 18;
        _ -> 19
    }
}

main(): int {
    if (operation_name(32) != 1 || operation_name(37) != 2 || operation_name(-3) != 3 || operation_name(4) != 4 || operation_name(0) != 5) return 1;
    if (letter_case('A') != 6 || letter_case('B') != 7) return 2;
    values: []int = [1099511627776, 0 - 5, 32, 0, 37, 33, 0 - 2147483649, 7, 8];
    for i in 0..len(values)
        if (spread_case(values[i]) != 10 + i) return 3;
    misses: []int = [1099511627775, 0 - 4, 31, 1, 36, 34, 0 - 2147483648, 6, 9, 0 - 9223372036854775807];
    for miss in misses
        if (spread_case(miss) != 19) return 4;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
