tag bounds_test;

type Window = {
    size: int;
    pos: int
} invariant (0 <= pos && pos <= size)

advance(w: *Window) {
    w.pos = w.pos + 1
}

main(): int {
    w: *Window = new Window { size: 1, pos: 0 };
    advance(w);
    w.pos
}

/* expect compile {|
error: bounds_record_invariant_dynamic_increment_unguarded.l8:9:7: record invariant is not proved after construction or field assignment
|} */
