tag bounds_test;

type Window = {
    size: int;
    pos: int
} invariant (0 <= pos && pos <= size)

advance(w: *Window) {
    w.pos = w.pos + 1
}

main(): int {
    w: *Window = new Window { size: 1, pos: 0 };
    advance(w);
    w.pos
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "record invariant is not proved"
