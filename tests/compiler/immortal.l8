tag example;

import "../../programs/stdlib/write.l8";

/* @immortal is process lifetime: the pointer may be stored in a global. */
g: ?*int = null;

stash(p: *int@immortal) {
    g = p
}

main() noregion: int {
    heap: []int = new int[1](3);
    stash(&heap[0]);
    q: ?*int = g;
    if (q != null) {
        if (q.* == 3) std::write(1, "Y\n")
    }
    0
}

//% test: run
//% stdout: "Y\n"
//% exit: 0
