tag example;

import "../../stdlib/raw_write.l8";

/* @immortal is process lifetime: the pointer may be stored in a global. */
g: ?*int = null;

stash(p: *int@immortal) {
    g = p
}

test "immortal" {
    heap: []int = new int[1](3);
    stash(&heap[0]);
    q: ?*int = g;
    if (q != null) {
        if (q.* == 3) raw::raw_write(1, "Y\n")
    }
    expect {|
        Y
    |}
}
