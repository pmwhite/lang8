tag compiler_internal;

import "../../src2/main.l8";

import "../../stdlib/print.l8";

test "AArch64 load/store operation and offset encoding" {
    a64_reset(false);
    assembly: []i8 = """
ldr x0, [x1, #8]
str x0, [x1, #8]
ldur x0, [x1, #8]
stur x0, [x1, #8]
""";
    a64_assemble(assembly, len(assembly));
    // A64 encodings F9400420, F9000420, F8408020 and F8008020.
    expected: []int = [4181722144, 4177527840, 4164976672, 4160782368];
    for index, word in expected {
        actual: int = 0;
        for byte_index in 0..4 actual = actual | (a64_text.data[index * 4 + byte_index] as int & 255) << byte_index * 8;
        std::print_bool(actual == word)
    }
    expect {|
        true
        true
        true
        true
    |}
}
