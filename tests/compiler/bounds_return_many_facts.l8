tag bounds_test;

type Holder = {
    data: []int
}

clamp(b: *Holder, i: int): int {
    if (i < 0) return check_index(b.data, i);
    if (i >= len(b.data)) return check_index(b.data, i);
    // Push the field-length fact beyond the old fixed fact-count cutoff.
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    if (i < 0) return check_index(b.data, i);
    i
}

use(b: *Holder, i: int): int {
    j: int = clamp(b, i);
    b.data[j]
}

main(): int {
    b: *Holder = new Holder { data: [1, 2, 3] };
    i: int = b.data[0];
    use(b, i)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 2
