exception IndexOutOfBounds;

tag bounds_test;

type Holder = {
    data: []int
}

clamp(b: *Holder, i: int) raises IndexOutOfBounds: int {
    if (i < 0) raise IndexOutOfBounds;
    if (i >= len(b.data)) raise IndexOutOfBounds;
    // Push the field-length fact beyond the old fixed fact-count cutoff.
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    if (i < 0) raise IndexOutOfBounds;
    i
}

use(b: *Holder, i: int) raises IndexOutOfBounds: int {
    j: int = clamp(b, i);
    b.data[j]
}

main() raises IndexOutOfBounds: int {
    b: *Holder = new Holder { data: [1, 2, 3] };
    i: int = b.data[0];
    use(b, i)
}

//% test: run
//% stdout: ""
//% exit: 2
