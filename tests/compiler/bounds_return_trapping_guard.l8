exception IndexOutOfBounds;

tag bounds_test;

step(a: []int, i: int) raises IndexOutOfBounds: int {
    if (i < 0) raise IndexOutOfBounds;
    if (i > len(a) - 2) raise IndexOutOfBounds;
    a[i + 1] = 7;
    i + 1
}

main() raises IndexOutOfBounds: int {
    a: []int = new int[3](0);
    i: int = 0;
    i = step(a, i);
    a[i]
}

//% test: run
//% stdout: ""
//% exit: 7
