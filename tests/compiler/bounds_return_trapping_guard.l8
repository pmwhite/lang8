tag bounds_test;

step(a: []int, i: int): int {
    if (i < 0) return check_index(a, i);
    if (i > len(a) - 2) return check_index(a, i + 1);
    a[i + 1] = 7;
    i + 1
}

main(): int {
    a: []int = new int[3](0);
    i: int = 0;
    i = step(a, i);
    a[i]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 7
