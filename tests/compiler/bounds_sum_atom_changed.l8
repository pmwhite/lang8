tag bounds_test;

// Changing either operand ends what a guard proved about their sum.
bad(dst: []int, to: int, f: int): int {
    if (to + f >= 0 && to + f < len(dst)) {
        f = f + 1;
        return dst[to + f]
    }
    0
}

main(): int {
    bad([1, 2], 0, 1)
}

/* expect compile {|
error: bounds_sum_atom_changed.l8:7:19: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= (to + f) && (to + f) < len(dst))
|} */
