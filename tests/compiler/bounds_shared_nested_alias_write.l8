tag bounds_test;

type Holder = {
    data: []int
}

type Parent = {
    child: *Holder
}

main(): int {
    h: *Holder = new Holder { data: new int[3](0) };
    p: *Parent = new Parent { child: h };
    q: *Parent = new Parent { child: h };
    if (len(p.child.data) < 3) return 0;
    q.child.data = new int[0](0);
    p.child.data[2]
}

//% test: compile-fail
//% error-contains: "bounds"
