tag bounds_test;

type Copies = {
    first: int;
    second: int;
    third: int;
    data: []int
}

copies(n: int): Copies@new requires (0 < n) {
    Copies {
        first: n,
        second: n,
        third: n,
        data: new int[n](0)
    }
}

main(): int {
    result: Copies = copies(4);
    result.second = 5;
    result.data[result.second - 1] = 7;
    result.data[result.third - 1]
}

//% test: compile-fail
//% error-contains: "unproved array access"
