tag bounds_test;

const CAP: int = 8;

type Bag = {
    table: []int;
    data: []int
} invariant (len(table) == 2 && len(data) == CAP, forall entry in table (0 <= entry && entry <= CAP))

main(): int {
    b: *Bag = new Bag { table: new int[2](0), data: new int[CAP](3) };
    b.table[0] = CAP;
    entry: int = b.table[0];
    if (entry == 0) return 0;
    b.data[entry - 1]
}

//% test: run
//% stdout: ""
//% exit: 3
