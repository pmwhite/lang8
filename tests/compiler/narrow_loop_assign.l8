tag example;

/* A variable a loop assigns keeps no narrowing from before the loop: a
later turn comes after the assignment. */
f(c: bool): int {
    x: int = 1;
    p: ?*int = &x;
    n: int = 0;
    if (p != null) {
        while (n < 2) {
            n = n + p.*;
            p = null
        }
    }
    n
}

main(): int {
    f(true)
}

/* expect compile {|
error: narrow_loop_assign.l8:11:21: p may be null; check for null before dereferencing it
|} */
