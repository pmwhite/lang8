tag bounds_test;

choose(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    if (true) return i else return len(a)
}

main(): int {
    a: []int = [9];
    i: int = choose(a, 0);
    a[i]
}

//% test: run
//% stdout: ""
//% exit: 9
//% compiler-warnings: ["unnecessary return in choose", "unnecessary return in choose"]
