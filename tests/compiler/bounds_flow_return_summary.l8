tag bounds_test;

import "../../stdlib/print.l8";

choose(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    if (true) return i else return len(a)
}

main(): int {
    a: []int = [9];
    i: int = choose(a, 0);
    a[i]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}

