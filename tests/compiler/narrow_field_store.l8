tag example;

type Rec = {
    x: int
}

type Holder = {
    p: ?*Rec
}

/* A store into memory ends a field path's narrowing: g may be h. */
f(h: *Holder, g: *Holder): int {
    if (h.p != null) {
        g.p = null;
        return h.p.x
    }
    0
}

main(): int {
    r: Rec = Rec { x: 1 };
    h: Holder = Holder { p: &r };
    f(&h, &h)
}

/* expect compile {|
error: narrow_field_store.l8:15:18: member access on optional pointer (use if (p != null) / while (p != null) to narrow): ?*Rec
|} */
