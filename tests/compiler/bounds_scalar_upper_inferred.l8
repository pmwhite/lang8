tag bounds_test;

import "../../stdlib/print.l8";

limited(n: int): int requires (n <= 4) {
    n
}

forward(n: int): int {
    limited(n)
}

main(): int {
    forward(4)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 4
    |}
}
