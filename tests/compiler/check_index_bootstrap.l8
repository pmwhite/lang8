import "../../stdlib/print.l8";

exception IndexOutOfBounds;

tag bounds_test;

test "an explicit range check before an index" {
    a: []i8 = ['A', 'B'];
    i: int = 1;
    if (i < 0 || i >= len(a)) raise IndexOutOfBounds;
    std::write(1, "a[1]: ");
    std::print_int(a[i] as int);
    expect {|
        a[1]: 66
    |}
}
