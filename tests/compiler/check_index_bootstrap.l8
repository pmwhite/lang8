import "../../stdlib/print.l8";

exception IndexOutOfBounds;

tag bounds_test;

main() raises IndexOutOfBounds: int {
    a: []i8 = ['A', 'B'];
    i: int = 1;
    if (i < 0 || i >= len(a)) raise IndexOutOfBounds;
    a[i] as int
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 66
    |}
}
