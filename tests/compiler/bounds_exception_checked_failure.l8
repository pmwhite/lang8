exception IndexOutOfBounds;

tag bounds_test;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

recover(a: []int, i: int): int {
    try {
        if (i < 0 || i >= len(a)) raise IndexOutOfBounds;
        return a[i]
    } with IndexOutOfBounds -> {
        return consume(a, i)
    }
}

main(): int {
    recover([7], 1)
}

