tag example;

import "../../stdlib/print.l8";

type Input = {
    number: int;
    pointer: *int
}

type Snapshot =
    | Number { value: int, label: str }

saved: Snapshot = Snapshot.Number { value: 0, label: "initial" };

saved_number: int = 0;

save_number(value: int) {
    saved_number = value
}

capture(input: *Input) {
    saved = Snapshot.Number { value: input.number, label: "captured" };
    save_number(input.pointer.*)
}

test "copying scalars does not retain their borrowed source" {
    number: int = 42;
    input: Input = Input { number: 17, pointer: &number };
    capture(&input);
    match saved {
        Number result -> std::print_int(result.value)
    }
    std::print_int(saved_number);
    expect {|
        17
        42
    |}
}
