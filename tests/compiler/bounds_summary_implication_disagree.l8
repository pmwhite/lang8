tag bounds_test;

sometimes_nonnegative(i: int): bool {
    if (i >= 0) return true;
    true
}

read_when_true(xs: []int, i: int): int {
    result: bool = sometimes_nonnegative(i);
    if (result == true && i < len(xs)) return xs[i];
    0
}

main(): int {
    xs: []int = [7];
    read_when_true(xs, 0 - 1)
}

//% test: compile-fail
//% error-contains: "unproved array access requires raises IndexOutOfBounds"
