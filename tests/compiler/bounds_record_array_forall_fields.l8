tag bounds_test;

import "../../stdlib/print.l8";

type Span = {
    start: int;
    end: int
}

type Spans = {
    items: []Span
} invariant (len(items) == 2, forall span in items (span.start <= span.end))

take(span: Span): int requires (span.start <= span.end) {
    span.end - span.start
}

main(): int {
    zero: Span = Span { start: 0, end: 0 };
    spans: *Spans = new Spans { items: new Span[2](zero) };
    good: Span = Span { start: 2, end: 5 };
    spans.items[1] = good;
    take(spans.items[1])
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
