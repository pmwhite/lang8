tag bounds_test;

same_at(a: []i8, i: int, w: []i8): bool requires (0 <= i && i <= len(a)) {
    wn: int = len(w);
    if (len(w) > len(a) - i) return false;
    for k in 0..wn {
        if (a[i + k] != w[k]) return false
    }
    true
}

read_if_present(a: []i8, i: int) raises IndexOutOfBounds: i8 {
    if (i >= len(a)) return 0i8;
    a[i]
}

read_after_match(a: []i8, i: int) raises IndexOutOfBounds: i8 requires (0 <= i && i <= len(a)) {
    if (same_at(a, i, "bc")) return a[i + 1];
    if (same_at(a, i, "loose")) return read_if_present(a, i + 5);
    0i8
}

main() raises IndexOutOfBounds: int {
    a: []i8 = ['a', 'b', 'c'];
    b: []i8 = ['l', 'o', 'o', 's', 'e', 'x'];
    if (!same_at(a, 1, "bc")) return 1;
    if (same_at(a, 2, "bc")) return 2;
    if (read_after_match(b, 0) != 'x') return 3;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
