tag bounds_test;

import "../../stdlib/print.l8";

digit(x: int, choose: bool): int {
    alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    a: int = x & 255;
    b: int = 0;
    c: int = 0;
    if (choose) b = x & 255;
    if (choose) c = x & 255;
    first: i8 = alphabet[a >> 2];
    second: i8 = alphabet[(a & 3) << 4 | b >> 4];
    third: i8 = alphabet[(b & 15) << 2 | c >> 6];
    fourth: i8 = alphabet[c & 63];
    if (first == '/' && second == '/' && third == '/' && fourth == '/') return 7;
    0
}

main(): int {
    digit(255, true)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
