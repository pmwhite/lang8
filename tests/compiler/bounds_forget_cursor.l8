tag bounds_test;

import "../../stdlib/print.l8";

scan(s: str): int {
    p: int = 0;
    while (p < len(s)) invariant (0 <= p && p <= len(s)) {
        start: int = p;
        next: int = p + 1;
        if (next < len(s)) p = next + 1;
        while (p < len(s)) invariant (start <= p && p <= len(s)) p = p + 1
    }
    p
}

main(): int {
    scan("abc")
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
