tag bounds_test;

write_vertices(a: []int, base: int) requires (0 <= base && base <= len(a) - 2915) {
    for vertex in 0..324 {
        offset: int = vertex * 9 + 8;
        a[base + offset] = 1
    }
}

main() {
    a: []int = new int[2916](0);
    write_vertices(a, 1)
}

/* expect compile {|
error: bounds_bounded_offset_sum_short.l8:6:10: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= (base + offset) && (base + offset) < len(a))
|} */
