tag example;

import "../../stdlib/print.l8";

type Bytes = {
    data: []i8;
    size: int
}

bytes_new(capacity: int): *Bytes@new {
    new Bytes { data: new i8[capacity](0i8), size: 0 }
}

// Grows its builder from the call's allocation destination, so a builder
// is grown where it was allocated: in its own region or arena, or through
// a caller's parameter at that caller's destination.
bytes_add(builder: *Bytes@new, byte: i8) {
    if (builder.size == len(builder.data)) {
        grown: []i8 = new i8[len(builder.data) * 2](0i8);
        memcpy(grown, 0, builder.data, 0, builder.size);
        builder.data = grown
    }
    builder.data[builder.size] = byte;
    builder.size = builder.size + 1
}

bytes_add_word(builder: *Bytes@new, word: str) {
    for byte in word bytes_add(builder, byte)
}

bytes_show(builder: *Bytes) raises std::IoError {
    std::write_bytes_n(1, builder.data, builder.size);
    std::print("")
}

log: *Bytes = new Bytes { data: new i8[1](0i8), size: 0 };

log_word(word: str) noregion {
    bytes_add_word(log, word)
}

type Page = {
    words: *Bytes
}

test "a builder grows where it was allocated" {
    builder: *Bytes = bytes_new(1);
    bytes_add_word(builder, "outer");
    bytes_show(builder);
    region {
        scratch: *Bytes = bytes_new(1);
        bytes_add_word(scratch, "scratch");
        bytes_show(scratch)
    }
    log_word("log");
    bytes_show(log);
    page: owned *Page = own {
        new Page { words: bytes_new(1) }
    };
    borrow page {
        allocate page {
            bytes_add_word(page.words, "arena")
        }
        bytes_show(page.words)
    }
    drop page;
    expect {|
        outer
        scratch
        log
        arena
    |}
}
