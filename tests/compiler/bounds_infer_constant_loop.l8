tag bounds_test;

sum_pair(a: []int, b: []int) raises IndexOutOfBounds: int {
    total: int = 0;
    for i in 0..4 total = total + a[i] + b[i];
    total
}

forward(a: []int, b: []int) raises IndexOutOfBounds: int {
    sum_pair(a, b)
}

main() raises IndexOutOfBounds: int {
    a: []int = [1, 2, 3, 4];
    b: []int = [5, 6, 7, 8];
    forward(a, b)
}

//% test: run
//% stdout: ""
//% exit: 36
