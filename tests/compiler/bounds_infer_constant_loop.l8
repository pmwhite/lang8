tag bounds_test;

import "../../stdlib/print.l8";

sum_pair(a: []int, b: []int): int {
    total: int = 0;
    for i in 0..4 total = total + a[i] + b[i];
    total
}

forward(a: []int, b: []int): int {
    sum_pair(a, b)
}

main(): int {
    a: []int = [1, 2, 3, 4];
    b: []int = [5, 6, 7, 8];
    forward(a, b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 36
    |}
}
