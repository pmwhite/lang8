import "../../stdlib/print.l8";

exception IndexOutOfBounds;

tag bounds_test;

tick(): int {
    1
}

get(a: []i8, i: index_for(a), ignored: int): i8 {
    if (ignored < 0) return 0i8;
    a[i]
}

main() raises IndexOutOfBounds: int {
    a: []i8 = ['A', 'B'];
    i: int = 1;
    if (i < 0 || i >= len(a)) raise IndexOutOfBounds;
    get(a, i, tick()) as int
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 66
    |}
}
