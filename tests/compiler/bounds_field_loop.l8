tag bounds_test;

type Box = {
    items: []int
}

has_nonzero(b: *Box): bool {
    for i in 0..len(b.items) {
        if (b.items[i] != 0 || b.items[i] != 0) return true
    }
    false
}

main(): int {
    b: *Box = new Box { items: [0, 1] };
    if (has_nonzero(b)) return 2;
    1
}

//% test: run
//% stdout: ""
//% exit: 2
