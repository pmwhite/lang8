tag bounds_test;

import "../../stdlib/print.l8";

type Box = {
    items: []int
}

has_nonzero(b: *Box): bool {
    for i in 0..len(b.items) {
        if (b.items[i] != 0 || b.items[i] != 0) return true
    }
    false
}

main(): int {
    b: *Box = new Box { items: [0, 1] };
    if (has_nonzero(b)) return 2;
    1
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
