tag example;

import "../../stdlib/print.l8";

// Records smaller than 8 bytes travel in a register. Stored into a field,
// one must write only its own bytes, not the field after it.
type Three = {
    a: bool;
    b: bool;
    c: bool
}

type Seven = {
    a: bool;
    b: bool;
    c: bool;
    d: bool;
    e: bool;
    f: bool;
    g: bool
}

type Holder = {
    flag: bool;
    seven: Seven;
    count: int;
    three: Three;
    tail: i8
}

keep_seven(holder: *Holder, seven: Seven) {
    holder.seven = seven
}

keep_three(holder: *Holder, three: Three) {
    holder.three = three
}

test "a small record stored through a pointer keeps its neighbours" {
    holder: Holder = Holder {
        flag: true,
        seven: Seven {
            a: false,
            b: false,
            c: false,
            d: false,
            e: false,
            f: false,
            g: false
        },
        count: 5,
        three: Three { a: false, b: false, c: false },
        tail: 9i8
    };
    keep_seven(&holder, Seven {
        a: true,
        b: true,
        c: true,
        d: true,
        e: true,
        f: true,
        g: true
    });
    keep_three(&holder, Three { a: true, b: false, c: true });
    std::print_int(holder.count);
    std::print_int(holder.tail as int);
    std::print_bool(holder.flag);
    std::print_bool(holder.seven.g);
    std::print_bool(holder.three.c);
    expect {|
        5
        9
        true
        true
        true
    |}
}
