tag bounds_test;

import "../../stdlib/print.l8";

previous(a: []int, i: int): int {
    a[i - 1]
}

main(): int {
    a: []int = [4, 7];
    previous(a, 1)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 4
    |}
}
