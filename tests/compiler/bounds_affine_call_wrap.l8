tag bounds_test;

write_three(a: []int, i: int) {
    a[i] = 3;
    a[i + 1] = 5;
    a[i + 2] = 7
}

main(): int {
    a: []int = new int[3](0);
    i: int = 9223372036854775807;
    if (i + 3 <= len(a)) write_three(a, i);
    0
}

