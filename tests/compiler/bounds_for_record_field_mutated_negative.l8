tag bounds_test;

type Range = {
    start: int;
    stop: int
} invariant (0 <= start && stop <= 10)

offset(start: int, position: int): int requires (start <= position) {
    position - start
}

run(range: Range): int {
    scratch: []int = [0];
    total: int = 0;
    for position in range.start..range.stop {
        scratch[0] = position;
        range.start = 9;
        total = total + offset(range.start, position)
    }
    total
}

main(): int {
    run(Range { start: 2, stop: 5 })
}

