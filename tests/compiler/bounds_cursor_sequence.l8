tag bounds_test;

put_two(a: []int, i: int): int {
    a[i] = 1;
    a[i + 1] = 2;
    i + 2
}

put_six(a: []int, i: int): int {
    i = put_two(a, i);
    i = put_two(a, i);
    i = put_two(a, i);
    i
}

main(): int {
    a: []int = new int[6](0);
    end: int = put_six(a, 0);
    if (end != 6) return 1;
    a[5]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 2
