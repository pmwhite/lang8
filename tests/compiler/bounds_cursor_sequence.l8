tag bounds_test;

import "../../stdlib/print.l8";

put_two(a: []int, i: int): int {
    a[i] = 1;
    a[i + 1] = 2;
    i + 2
}

put_six(a: []int, i: int): int {
    i = put_two(a, i);
    i = put_two(a, i);
    i = put_two(a, i);
    i
}

main(): int {
    a: []int = new int[6](0);
    end: int = put_six(a, 0);
    if (end != 6) return 1;
    a[5]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
