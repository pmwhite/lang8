tag bounds_test;

import "../../stdlib/print.l8";

pick(
    a: []int,
    i: int,
    j: int,
    k: int,
    flag: bool
): int {
    if (i < 0) return 0;
    if (flag) {
        if (i >= j || j >= len(a)) return 0
    } else {
        if (i >= k || k >= len(a)) return 0
    }
    a[i]
}

main(): int {
    a: []int = [1, 2, 3];
    pick(a, 3, 3, 3, true)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
