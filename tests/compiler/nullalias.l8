tag example;

/* Taking &p aliases the slot, so p cannot be narrowed. */
main(): int {
    x: int = 1;
    p: ?*int = &x;
    r: *?*int = &p;
    if (p != null) {
        r.* = null;
        p.*
    }
    0
}

/* expect compile {|
warning: nullalias.l8:10:9: ignored return value in main
error: nullalias.l8:10:9: pointer use is not proved non-null
|} */
