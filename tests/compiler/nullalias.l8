tag example;

/* Taking &p aliases the slot, so p cannot be narrowed. */
main(): int {
    x: int = 1;
    p: ?*int = &x;
    r: *?*int = &p;
    if (p != null) {
        r.* = null;
        p.*
    }
    0
}

/* expect compile {|
error: nullalias.l8:10:9: dereferencing optional pointer (use if (p != null) / while (p != null) to narrow): ?*int
|} */
