tag bounds_test;

import "../../stdlib/print.l8";

version(s: str): int {
    if (len(s) != 8 || s[7] != '1') return 0;
    s[5] as int
}

main(): int {
    version("HTTP/1.1")
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 49
    |}
}
