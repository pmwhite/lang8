tag bounds_test;

choose(a: []int, i: int, end: bool): int {
    if (end) return len(a);
    if (i < 0) return check_index(a, i);
    if (i >= len(a)) return check_index(a, i);
    i
}

main(): int {
    a: []int = [3, 5];
    j: int = choose(a, 0, true);
    a[j]
}

