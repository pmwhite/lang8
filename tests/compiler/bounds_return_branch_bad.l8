tag bounds_test;

choose(a: []int, i: int, end: bool): int {
    if (end) return len(a);
    if (i < 0) raise IndexOutOfBounds;
    if (i >= len(a)) raise IndexOutOfBounds;
    i
}

main(): int {
    a: []int = [3, 5];
    j: int = choose(a, 0, true);
    a[j]
}

//% test: compile-fail
//% error-contains: "exception IndexOutOfBounds is not in raises"
