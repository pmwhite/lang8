tag bounds_test;

import "../../stdlib/print.l8";

type Holder = {
    data: []int
}

main(): int {
    h: *Holder = new Holder { data: new int[3](7) };
    other: *Holder = h;
    h = new Holder { data: new int[0](0) };
    other.data[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
