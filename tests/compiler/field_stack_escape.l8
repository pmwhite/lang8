tag example;

type Box = {
    n: int
}

type Pair = {
    p: *Box
}

seed: *Box = new Box { n: 1 };

g: ?*Box = null;

main(): int {
    local: Box = Box { n: 4 };
    box: Pair = Pair { p: seed };
    box.p = &local;
    g = box.p;
    0
}

/* expect compile {|
error: field_stack_escape.l8:19:5: address of local cannot escape in main
|} */
