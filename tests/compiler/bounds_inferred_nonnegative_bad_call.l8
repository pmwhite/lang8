tag bounds_test;

scan(a: []int, p: int): int {
    while (p < len(a)) {
        if (a[p] == 7) return p;
        p = p + 1
    }
    -1
}

main(): int {
    a: []int = [7, 9];
    scan(a, -1)
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "call does not prove inferred nonnegative requirement"
