tag bounds_test;

buffer: []int = [4, 5];

empty: []int = new int[0](0);

shrink(): int {
    buffer = empty;
    0
}

// A function value's type says nothing about the globals it assigns.
first(f: fn(): int): int {
    if (len(buffer) < 1) return 0;
    _r: int = f();
    buffer[0]
}

main(): int {
    first(&shrink)
}

/* expect compile {|
error: bounds_indirect_call_global.l8:16:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 0 && 0 < len(buffer))
|} */
