tag bounds_test;

unproved_last(a: []int, start: int, end: int): int requires (0 <= start && end <= len(a)) {
    if (end == start + 3) return a[start + 2];
    0
}

main(): int {
    a: []int = [4, 5, 6];
    unproved_last(a, 2, 1)
}

//% test: compile-fail
//% error-contains: "call does not prove inferred array bounds requirement"
