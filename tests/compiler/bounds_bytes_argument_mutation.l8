tag bounds_test;

set_text(p: *str): int {
    p.* = "abc";
    0
}

read_data(data: []i8, marker: int, count: int): int requires (count <= len(data)) {
    if (marker != 0) return 0;
    data[count - 1] as int
}

main(): int {
    text: str = "";
    read_data(bytes(text), set_text(&text), 3)
}

//% test: compile-fail
//% error-contains: "bounds requirement arguments must be simple"
