tag bounds_test;

const CAP: int = 8;

next(i: int): int requires (0 <= i && i < CAP) ensures (0 <= returned && returned < CAP) {
    (i + 1) % CAP
}

main(): int {
    data: []int = new int[CAP](0);
    slot: int = next(7);
    data[slot] = 6;
    data[0]
}

//% test: run
//% stdout: ""
//% exit: 6
