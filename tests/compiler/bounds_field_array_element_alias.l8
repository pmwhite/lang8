tag bounds_test;

type Buffer = {
    data: []int
}

main(): int {
    a: []Buffer = [Buffer { data: new int[0](0) }];
    b: *Buffer = &a[0];
    b.data = [4, 7];
    a[0] = Buffer { data: new int[0](0) };
    b.data[1]
}

