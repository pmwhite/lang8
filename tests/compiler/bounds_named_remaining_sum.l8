tag bounds_test;

// A named sum retains the non-strict bound supplied by a remaining span.
end_of_span(a: []int, start: int, count: int): int requires (0 <= start && start <= len(a) && 0 <= count && count <= len(a) - start) ensures (0 <= returned && returned <= len(a)) {
    end: int = start + count;
    end
}

main(): int {
    a: []int = [1, 2, 3, 4];
    end_of_span(a, 2, 2)
}

//% test: run
//% stdout: ""
//% exit: 4
