tag example;

type Box = {
    n: int
}

main(): int {
    boxes: []?owned *Box = new ?owned *Box[1](null);
    boxes[0] = own {
        new Box { n: 1 }
    };
    copy: ?owned *Box = boxes[0];
    drop copy;
    0
}

