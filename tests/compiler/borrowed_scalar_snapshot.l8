tag scalar_snapshot;

import "../../stdlib/print.l8";

type Positioned = {
    position: int
}

type SavedPosition = {
    position: int
}

saved: ?*SavedPosition = null;

save_position(position: int) noregion {
    saved = new SavedPosition { position: position }
}

snapshot_position(value: *Positioned) noregion {
    save_position(value.position)
}

test "a scalar snapshot does not retain its borrowed record" {
    value: Positioned = Positioned { position: 17 };
    snapshot_position(&value);
    value.position = 23;
    snapshot: ?*SavedPosition = saved;
    if (snapshot != null) std::print_int(snapshot.position) else std::print_int(-1);
    expect {|
        17
    |}
}
