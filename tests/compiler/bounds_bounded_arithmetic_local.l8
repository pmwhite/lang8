tag bounds_test;

import "../../stdlib/print.l8";

pick(a: []i8, x: int): int requires (len(a) >= 28) {
    if (x < 0 || x > 7) return 0;
    at: int = 8 + x * 2;
    a[at] = 1i8;
    a[at] as int
}

main(): int {
    a: []i8 = new i8[28](0i8);
    pick(a, 7)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 1
    |}
}
