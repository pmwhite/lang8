exception IndexOutOfBounds;

tag bounds_test;

fetch(a: []int, i: int) raises IndexOutOfBounds: int {
    first: int = a[0];
    first + a[i]
}

main() raises IndexOutOfBounds: int {
    a: []int = [7];
    fetch(a, 1)
}

