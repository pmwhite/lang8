tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

sum_used(b: *Buffer): int {
    total: int = 0;
    for i in 0..b.used total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2 };
    sum_used(b) + b.data[0]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 15
