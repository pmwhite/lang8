tag example;

import "../../stdlib/print.l8";

use_pointer(p: *int): int {
    p.*
}

test "a nullable local known non-null passes as a pointer" {
    x: int = 7;
    p: ?*int = &x;
    std::write(1, "use_pointer(p): ");
    std::print_int(use_pointer(p));
    expect {|
        use_pointer(p): 7
    |}
}
