tag example;

import "../../stdlib/print.l8";

use_pointer(p: *int): int {
    p.*
}

main(): int {
    x: int = 7;
    p: ?*int = &x;
    use_pointer(p)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
