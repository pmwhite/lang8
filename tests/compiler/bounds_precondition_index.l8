tag bounds_test;

choose(a: []int, n: int, first: bool): int requires (0 <= n && n < len(a)) {
    if (first && len(a) > 0) return n;
    0
}

main(): int {
    a: []int = [1, 4];
    n: int = a[0];
    if (n < 0 || n >= len(a)) return 0;
    i: int = choose(a, n, false);
    a[i]
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 1
