tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    count: int
}

sum_prefix(b: *Buffer): int {
    total: int = 0;
    for i in 0..b.count total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [3, 5, 7], count: 2 };
    if (b.count > len(b.data)) return 1;
    sum_prefix(b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 8
    |}
}
