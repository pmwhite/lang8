tag bounds_test;

type Buffer = {
    data: []int;
    count: int
}

sum_prefix(b: *Buffer): int {
    total: int = 0;
    for i in 0..b.count total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [3, 5, 7], count: 2 };
    if (b.count > len(b.data)) return 1;
    sum_prefix(b)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 8
