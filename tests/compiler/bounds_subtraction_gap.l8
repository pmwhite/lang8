tag bounds_test;

read_after_gap(a: []int, first: int, end: int): int {
    if (first < 0 || first > end || end > len(a)) return -1;
    if (end - first > 1) return a[first + 1];
    -1
}

read_at_exact_gap(a: []int, first: int, end: int): int {
    if (first < 0 || first > end || end > len(a)) return -1;
    if (end - first == 3) return a[first + 2];
    -1
}

main(): int {
    a: []int = [3, 7, 11];
    if (read_after_gap(a, 0, 3) != 7) return 1;
    if (read_after_gap(a, 1, 2) != -1) return 2;
    if (read_at_exact_gap(a, 0, 3) != 11) return 3;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
