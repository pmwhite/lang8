tag bounds_test;

find(a: []int, input: int): int {
    j: int = input;
    if (j < 0) return check_index(a, j);
    if (j >= len(a)) return check_index(a, j);
    j
}

main(): int {
    a: []int = [3, 5, 7];
    i: int = 1;
    j: int = find(a, i);
    a[j]
}

