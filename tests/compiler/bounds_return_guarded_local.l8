import "../../stdlib/print.l8";

exception IndexOutOfBounds;

tag bounds_test;

find(a: []int, input: int) raises IndexOutOfBounds: int {
    j: int = input;
    if (j < 0) raise IndexOutOfBounds;
    if (j >= len(a)) raise IndexOutOfBounds;
    j
}

main() raises IndexOutOfBounds: int {
    a: []int = [3, 5, 7];
    i: int = 1;
    j: int = find(a, i);
    a[j]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 5
    |}
}
