tag bounds_test;

import "../../stdlib/print.l8";

last(data: []i8, count: int): int requires (0 < count && count <= len(data)) {
    data[count - 1] as int
}

main(): int {
    literal: int = last(bytes("abc"), 3);
    text: str = "abc";
    direct: int = last(bytes(text), len(text));
    data: []i8 = bytes(text);
    indexed: int = data[len(text) - 1] as int;
    literal + direct + indexed - 297
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
