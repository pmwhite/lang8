tag bounds_test;

fill_pair(out: []int, value: int): int requires (len(out) >= 2 && 0 <= value && value <= 10) ensures (out[0] <= 10 && out[1] <= 10) {
    alias: []int = out;
    out[0] = value;
    out[1] = value;
    alias[0] = 11;
    0
}

main(): int {
    pair: []int = [0, 0];
    fill_pair(pair, 7)
}

//% test: compile-fail
//% error-contains: "function guarantee is not proved"
