tag bounds_test;

import "../../stdlib/print.l8";

branch(first: bool, i: int): int {
    a: []int = [7];
    if (first) i = 0 else return 0;
    a[i]
}

selection(choice: int, i: int): int {
    a: []int = [5];
    match choice {
        0 -> i = 0;
        1 -> return 0;
        _ -> i = 0
    }
    a[i]
}

loop(enter: bool): int {
    a: []int = [3];
    i: int = 0;
    while (enter) invariant (0 <= i && i < len(a)) {
        i = -1;
        return 0
    }
    a[i]
}

main(): int {
    branch(true, 10) + selection(2, 10) + loop(false)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 15
    |}
}
