tag bounds_test;

import "../../stdlib/print.l8";

type Indexed = {
    items: []int;
    count: int
} invariant (0 <= count && count <= len(items))

filled(n: int): Indexed@new requires (0 <= n) ensures (returned.count == n) {
    Indexed { items: new int[n](0), count: n }
}

main(): int {
    data: Indexed = filled(3);
    if (data.count != 3) return 1;
    data.items[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
