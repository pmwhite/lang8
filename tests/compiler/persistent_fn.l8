tag example;

/* A persistent value may hold only data: a function value names code, which
   a reload replaces. */
type Handler = {
    run: fn(n: int): int
}

twice(n: int): int {
    n * 2
}

persistent handler: Handler = Handler { run: &twice };

main(): int {
    handler.run(2)
}

/* expect compile {|
error: persistent_fn.l8:13:12: persistent global handler holds a function value, which a reload cannot keep
|} */
