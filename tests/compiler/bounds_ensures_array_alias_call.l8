tag bounds_test;

zero(out: []int): int requires (1 <= len(out)) ensures (out[0] == 0) {
    out[0] = 0;
    0
}

write_one(out: []int) requires (1 <= len(out)) {
    out[0] = 1
}

main(): int {
    a: []int = [0];
    b: []int = a;
    if (zero(a) != 0) return 1;
    write_one(b);
    a[a[0]]
}

//% test: compile-fail
//% error-contains: "unproved array access"
