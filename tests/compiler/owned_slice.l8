tag example;

use_tag std;

import "../../stdlib/print.l8";

extern l8_arena_live(): int;

type Text = {
    words: int
}

make_text(words: int): owned *Text {
    own {
        new Text { words: words }
    }
}

shelf: []?owned *Text = new ?owned *Text[2](null);

calls: int = 0;

counted_index(i: int): int {
    calls = calls + 1;
    i
}

words_at(texts: []?owned *Text, i: int): int {
    borrow texts[i] as text {
        text.words
    }
}

test "elements start empty and take handles by move" {
    before: int = l8_arena_live();
    texts: []?owned *Text = new ?owned *Text[3](null);
    print_bool(texts[0] == null);
    first: ?owned *Text = make_text(4);
    texts[0] = move first;
    texts[1] = make_text(5);
    texts[2] = own {
        new Text { words: 6 }
    };
    print_bool(texts[0] != null);
    print_int(words_at(texts, 0) + words_at(texts, 1) + words_at(texts, 2));
    print_int(l8_arena_live() - before);
    expect {|
        true
        true
        15
        3
    |}
    held: ?owned *Text = move texts[counted_index(1)];
    print_int(calls);
    print_bool(texts[1] == null);
    borrow held {
        print_int(held.words)
    }
    drop held;
    drop texts[0];
    drop texts[1];
    drop texts[counted_index(2)];
    print_int(calls);
    print_bool(texts[2] == null);
    print_int(l8_arena_live() - before);
    expect {|
        1
        true
        5
        2
        true
        0
    |}
}

test "an element borrow allocates in the element's arena" {
    texts: []?owned *Text = new ?owned *Text[1](null);
    texts[0] = make_text(1);
    borrow texts[counted_index(0)] as text {
        alias: *Text = text;
        allocate alias {
            extra: *Text = new Text { words: 2 };
            alias.words = alias.words + extra.words
        }
    }
    print_int(calls);
    print_int(words_at(texts, 0));
    drop texts[0];
    expect {|
        1
        3
    |}
}

test "an element is replaced by dropping it and moving in another" {
    before: int = l8_arena_live();
    drop shelf[0];
    shelf[0] = make_text(7);
    drop shelf[0];
    shelf[0] = move shelf[1];
    print_bool(shelf[0] == null);
    shelf[1] = make_text(8);
    shelf[0] = move shelf[1];
    print_int(words_at(shelf, 0));
    print_bool(shelf[1] == null);
    drop shelf[0];
    print_int(l8_arena_live() - before);
    expect {|
        true
        8
        true
        0
    |}
}

test "a borrow keeps its arena when its element moves" {
    texts: []?owned *Text = new ?owned *Text[2](null);
    texts[0] = make_text(9);
    borrow texts[0] as text {
        texts[1] = move texts[0];
        print_int(text.words)
    }
    print_bool(texts[0] == null);
    print_int(words_at(texts, 1));
    drop texts[1];
    expect {|
        9
        true
        9
    |}
}
