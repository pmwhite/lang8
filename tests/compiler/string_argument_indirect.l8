tag example;

mutate(buffer: []i8) {
    buffer[0] = 'x'
}

main(): int {
    callback: fn(buffer: []i8) = &mutate;
    text: str = "original";
    callback(text);
    0
}

/* expect compile {|
string_argument_indirect.l8:10:14

    callback(text);
             ^^^^

text is immutable str; parameter buffer of this function value requires
mutable []i8.

bytes(text) makes a separate mutable copy. For shared changes, pass a
[]i8 buffer; for read-only use, change the parameter to str.

|} */
