tag example;

type Choice =
    | Pair { a: int, b: int }
    | Single { value: int }
    | Empty

calls: int = 0;

make(): Choice {
    calls = calls + 1;
    Choice.Pair { a: 7, b: 11 }
}

replace(p: *Choice): int {
    p.* = Choice.Single { value: 100 };
    3
}

nested(p: *Choice): int {
    match p.* {
        Pair pair -> {
            // The binder is a value copy and survives mutation of the source.
            extra: int = replace(p);
            inner: int = match p.* {
                Single single -> single.value;
                _ -> -1
            };
            pair.a + pair.b + extra + inner
        }
        _ -> -1
    }
}

sum8(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    a + b + c + d + e + f + g + h
}

main(): int {
    total: int = match make() {
        Pair pair -> sum8(pair.a, pair.b, 1, 2, 3, 4, 5, 6);
        _ -> -1
    };
    if (total != 39 || calls != 1) return 1;
    value: Choice = Choice.Pair { a: 13, b: 17 };
    if (nested(&value) != 133) return 2;
    match value {
        Single single -> {
            if (single.value != 100) return 3
        }
        _ -> return 4
    }
    // An enum match inside an integer match still unwinds its own state.
    answer: int = match 2 {
        2 -> {
            inner: int = match make() {
                Pair pair -> pair.a + pair.b;
                _ -> 0
            };
            inner
        }
        _ -> 0
    };
    if (answer != 18 || calls != 2) return 5;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
