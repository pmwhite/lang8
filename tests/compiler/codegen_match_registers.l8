tag example;

import "../../stdlib/print.l8";

type Choice =
    | Pair { a: int, b: int }
    | Single { value: int }
    | Empty

calls: int = 0;

make(): Choice {
    calls = calls + 1;
    Choice.Pair { a: 7, b: 11 }
}

replace(p: *Choice): int {
    p.* = Choice.Single { value: 100 };
    3
}

nested(p: *Choice): int {
    match p.* {
        Pair pair -> {
            // The binder is a value copy and survives mutation of the source.
            extra: int = replace(p);
            inner: int = match p.* {
                Single single -> single.value;
                _ -> -1
            };
            pair.a + pair.b + extra + inner
        }
        _ -> -1
    }
}

sum8(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int
): int {
    a + b + c + d + e + f + g + h
}

mr_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "a match arm passes its binder to an eight-argument call" {
    total: int = match make() {
        Pair pair -> sum8(pair.a, pair.b, 1, 2, 3, 4, 5, 6);
        _ -> -1
    };
    mr_show("total", total);
    mr_show("calls", calls);
    expect {|
        total: 39
        calls: 1
    |}
}

test "a binder survives mutation of the matched value" {
    value: Choice = Choice.Pair { a: 13, b: 17 };
    mr_show("nested(&value)", nested(&value));
    expect {|
        nested(&value): 133
    |}
    match value {
        Single single -> mr_show("value is Single", single.value);
        _ -> std::print("value is not Single")
    }
    expect {|
        value is Single: 100
    |}
}

test "an enum match inside an integer match" {
    // The inner match still unwinds its own state.
    answer: int = match 2 {
        2 -> {
            inner: int = match make() {
                Pair pair -> pair.a + pair.b;
                _ -> 0
            };
            inner
        }
        _ -> 0
    };
    mr_show("answer", answer);
    mr_show("calls", calls);
    expect {|
        answer: 18
        calls: 1
    |}
}
