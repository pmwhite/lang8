tag bounds_test;

fetch(a: []int, repeat: bool) raises IndexOutOfBounds: int requires (len(a) > 0) {
    value: int = 0;
    while (repeat) {
        value = a![0];
        repeat = false
    }
    value
}

main() raises IndexOutOfBounds: int {
    a: []int = [7];
    fetch(a, true)
}

//% test: run
//% stdout: ""
//% exit: 7
//% compiler-warnings: ["checked access is already proved; use [] instead of ![]"]
