tag bounds_test;

type Input = {
    n: int
}

type Output = {
    index: int;
    ignored: int
}

change(input: *Input): int {
    input.n = 0;
    0
}

main(): int {
    input: *Input = new Input { n: 3 };
    output: *Output = new Output { index: input.n, ignored: change(input) };
    a: []int = [7];
    a[output.index]
}

