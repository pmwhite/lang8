tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

replace_data(b: *Buffer@new) {
    b.data = new int[1](9)
}

replace_data_again(b: *Buffer@new) {
    replace_data(b)
}

read_after_other_write(a: *Buffer, b: *Buffer@new) raises IndexOutOfBounds: int {
    if (a.cursor < 0 || a.cursor >= len(a.data)) return -1;
    replace_data_again(b);
    a.data![a.cursor]
}

forward(a: *Buffer, b: *Buffer@new) raises IndexOutOfBounds: int {
    read_after_other_write(a, b)
}

main() raises IndexOutOfBounds: int {
    a: *Buffer = new Buffer { data: [7], cursor: 0 };
    b: *Buffer = new Buffer { data: [1], cursor: 0 };
    forward(a, b)
}

//% test: run
//% stdout: ""
//% exit: 7
