tag forward_layout;

use_tag std;

import "../../stdlib/print.l8";

type Envelope = {
    prefix: i8;
    values: [2]Pair;
    choice: Choice;
    tail: int
}

type Choice: i8, 24 =
    | Empty
    | Value { prefix: i8, pair: Pair }

exception Wrapped {
    prefix: i8;
    pair: Pair;
    tail: int
}

type Pair = {
    byte: i8;
    number: int
}

make_envelope(): Envelope {
    Envelope {
        prefix: 1i8,
        values: [Pair { byte: 2i8, number: 3 }, Pair { byte: 4i8, number: 5 }],
        choice: Choice.Value { prefix: 6i8, pair: Pair { byte: 7i8, number: 8 } },
        tail: 9
    }
}

test "forward layouts include array strides, alignment and enum payloads" {
    print_int(sizeof(Pair));
    print_int(sizeof(Choice));
    print_int(sizeof(Envelope));
    print_int(sizeof(Wrapped));
    value: Envelope = make_envelope();
    print_int(value.prefix as int);
    print_int(value.values[0].number);
    print_int(value.values[1].byte as int);
    print_int(value.values[1].number);
    match value.choice {
        Value payload -> {
            print_int(payload.prefix as int);
            print_int(payload.pair.byte as int);
            print_int(payload.pair.number)
        }
        Empty -> print_int(-1)
    }
    value.values[1].number = 15;
    print_int(value.values[0].number);
    print_int(value.values[1].number);
    print_int(value.tail);
    expect {|
        16
        32
        80
        32
        1
        3
        4
        5
        6
        7
        8
        3
        15
        9
    |}
}

test "forward exception payload layout" {
    try {
        raise Wrapped { prefix: 1i8, pair: Pair { byte: 2i8, number: 3 }, tail: 4 }
    } with Wrapped payload -> {
        print_int(payload.prefix as int);
        print_int(payload.pair.byte as int);
        print_int(payload.pair.number);
        print_int(payload.tail)
    }
    expect {|
        1
        2
        3
        4
    |}
}

// Recursion through pointers and slices has finite layout.
type Node = {
    next: ?*Node;
    children: []Node;
    value: int
}

test "indirect recursive records remain valid" {
    print_int(sizeof(Node));
    expect {|
        24
    |}
}
