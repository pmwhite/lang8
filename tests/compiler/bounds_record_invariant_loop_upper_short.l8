tag bounds_test;

type Buffer = {
    data: []int;
    count: int
} invariant (len(data) >= 15 && 0 <= count && count <= 15)

sum(b: *Buffer): int {
    i: int = 0;
    total: int = 0;
    while (i <= b.count) {
        total = total + b.data[i];
        i = i + 1
    }
    total
}

main(): int {
    b: *Buffer = new Buffer { data: new int[15](1), count: 15 };
    sum(b)
}

/* expect compile {|
error: bounds_record_invariant_loop_upper_short.l8:20:5: call does not prove inferred array bounds requirement for sum 15 < len(b.data)
|} */
