tag bounds_test;

import "../../stdlib/print.l8";

fill(a: []int) {
    for i in 16..80 a[i - 16] = i
}

main(): int {
    a: []int = new int[64](0);
    fill(a);
    a[63]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 79
    |}
}
