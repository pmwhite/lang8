tag bounds_test;

import "../../stdlib/print.l8";

copy(source: []?str@new): []?str@new {
    result: []?str = new ?str[len(source) + 2](null);
    i: int = 0;
    while (i < len(source)) invariant (0 <= i && i <= len(source) && len(source) < len(result)) {
        result[i] = source[i];
        i = i + 1
    }
    result[i] = "end";
    result
}

main(): int {
    source: []?str = new ?str[2](null);
    source[0] = "one";
    source[1] = "two";
    result: []?str = copy(source);
    if (len(result) == 4) 0 else 1
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
