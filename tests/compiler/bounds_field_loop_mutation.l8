tag bounds_test;

type Box = {
    items: []int
}

bad(b: *Box@new): bool {
    for i in 0..len(b.items) {
        b.items = new int[1](0);
        if (b.items[i] != 0) return true
    }
    false
}

main(): int {
    b: *Box = new Box { items: [0] };
    if (bad(b)) return 1;
    0
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "array index not proved in bounds"
