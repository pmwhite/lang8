tag bounds_test;

type Box = {
    items: []int
}

bad(b: *Box@new): bool {
    for i in 0..len(b.items) {
        b.items = new int[1](0);
        if (b.items[i] != 0) return true
    }
    false
}

main(): int {
    b: *Box = new Box { items: [0] };
    if (bad(b)) return 1;
    0
}

/* expect compile {|
error: bounds_field_loop_mutation.l8:10:20: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= i && i < len(b.items))
|} */
