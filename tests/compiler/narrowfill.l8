tag example;

import "../../stdlib/raw_write.l8";

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

asgn_then(p: ?*int): int {
    if (p != null) {
        q: *int = p;
        q.*
    } else 0
}

asgn_after_ret(p: ?*int): int {
    if (p == null) return 0;
    q: *int = p;
    q.*
}

asgn_after_fill(p: ?*int, other: *int): int {
    if (p == null) p = other;
    q: *int = p;
    q.*
}

asgn_while(p: ?*int): int {
    n: int = 0;
    while (p != null) {
        q: *int = p;
        n = q.*;
        p = null
    }
    n
}

test "narrowfill" {
    x: int = 3;
    if (asgn_then(&x) == 3) putchar('Y');
    if (asgn_after_ret(&x) == 3) putchar('Y');
    if (asgn_after_fill(null, &x) == 3) putchar('Y');
    if (asgn_while(&x) == 3) putchar('Y');
    putchar('\n');
    expect {|
        YYYY
    |}
}
