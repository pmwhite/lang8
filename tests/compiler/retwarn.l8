tag example;

import "../../stdlib/raw_write.l8";

/* Warnings: unnecessary tail `return`, and ignored values in returning functions. */
putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

id(n: int): int {
    return n
}

id2(n: int): int {
    n
}

drop(n: int): int {
    n;
    0
}

side(n: int): int {
    n = n + 1;
    n
}

proc() { }

callp(n: int): int {
    proc();
    n
}

early(n: int): int {
    if (n < 0) return 0 - n;
    n
}

both(n: int): int {
    if (n < 0) return 0 - n else return n
}

test "retwarn" {
    if (id(1) == 1) putchar('Y');
    if (id2(1) == 1) putchar('Y');
    if (drop(3) == 0) putchar('Y');
    if (side(1) == 2) putchar('Y');
    if (callp(1) == 1) putchar('Y');
    if (early(0 - 3) == 3) putchar('Y');
    if (both(2) == 2) putchar('Y');
    putchar('\n');
    expect {|
        YYYYYYY
    |}
}

/* expect compile {|
warning: retwarn.l8:11:5: unnecessary return in id
warning: retwarn.l8:19:5: ignored return value in drop
warning: retwarn.l8:41:16: unnecessary return in both
warning: retwarn.l8:41:34: unnecessary return in both
|} */
