tag bounds_test;

type Holder = {
    items: []int
}

empty: []int = new int[0](0);

shrink(h: *Holder): int {
    h.items = empty;
    0
}

// A function value's type says nothing about the fields it writes.
first(h: *Holder, f: fn(h: *Holder): int): int {
    if (len(h.items) < 1) return 0;
    _r: int = f(h);
    h.items[0]
}

main(): int {
    h: *Holder = new Holder { items: [1] };
    first(h, &shrink)
}

/* expect compile {|
error: bounds_indirect_call_field.l8:18:12: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 0 && 0 < len(h.items))
|} */
