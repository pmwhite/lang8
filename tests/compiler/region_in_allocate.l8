tag example;

import "../../stdlib/print.l8";

// A region inside `allocate p` is scratch: what it allocates is let go at
// its end. What an `allocate p` inside that region adds to p's arena is
// p's, and outlives the region.
type Pile = {
    data: []i8;
    size: int
}

// Grows the pile in the caller's destination.
pile_add(pile: *Pile@new, byte: i8, count: int) {
    grown: []i8 = new i8[pile.size + count](0i8);
    memcpy(grown, 0, pile.data, 0, pile.size);
    for i in 0..count grown[pile.size + i] = byte;
    pile.data = grown;
    pile.size = pile.size + count
}

test "an allocate inside a region inside an allocate keeps what it adds" {
    pile: owned *Pile = own {
        new Pile { data: new i8[0](0i8), size: 0 }
    };
    borrow pile as p {
        allocate p {
            region {
                scratch: []i8 = new i8[1000](1i8);
                // (Large enough to grow the arena by a chunk of its own.)
                allocate p {
                    pile_add(p, 7i8, 3000000)
                }
                std::print_int(len(scratch))
            }
        }
        // (Allocated after the region, where its scratch was.)
        fresh: []i8 = new i8[3000000](9i8);
        std::print_int(p.data[0] as int);
        std::print_int(p.data[2999999] as int);
        std::print_int(len(fresh))
    }
    drop pile;
    expect {|
        1000
        7
        7
        3000000
    |}
}
