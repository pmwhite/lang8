tag bounds_test;

import "../../stdlib/print.l8";

read_tail(a: []int, offset: int): int requires (0 <= offset && offset <= len(a) && 1 <= len(a) - offset) {
    a[offset]
}

read_known_tail(a: []int, offset: int): int requires (0 <= offset && offset < len(a)) {
    read_tail(a, offset)
}

main(): int {
    a: []int = [3, 7];
    read_known_tail(a, 1)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
