tag bounds_test;

step(a: []int, i: int): int {
    a[i + 1] = 7;
    i + 1
}

main(): int {
    a: []int = new int[2](0);
    i: int = 0;
    i = step(a, i);
    i = step(a, i);
    a[i]
}

