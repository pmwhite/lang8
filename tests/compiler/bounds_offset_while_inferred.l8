tag bounds_test;

import "../../stdlib/print.l8";

copy(
    dst: []int,
    offset: int,
    src: []int,
    n: int
) {
    i: int = 0;
    while (i < n) {
        dst[offset + i] = src[i];
        i = i + 1
    }
}

main(): int {
    dst: []int = new int[5](0);
    src: []int = new int[3](9);
    copy(dst, 2, src, 3);
    dst[4]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
