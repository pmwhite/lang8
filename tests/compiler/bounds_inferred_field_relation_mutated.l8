tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer@new): int {
    b.data = new int[0](0);
    b.data[b.cursor]
}

main(): int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    get(b)
}

/* expect compile {|
error: bounds_inferred_field_relation_mutated.l8:10:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= b.cursor && b.cursor < len(b.data))
|} */
