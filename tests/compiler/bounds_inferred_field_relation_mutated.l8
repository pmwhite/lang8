tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer@new): int {
    b.data = new int[0](0);
    b.data[b.cursor]
}

main(): int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    get(b)
}

//% test: compile-fail
//% error-contains: "array index not proved in bounds"
