tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    used: int
}

sum(b: *Buffer): int {
    if (b.used > len(b.data)) return -1;
    total: int = 0;
    for i in 0..b.used total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [1, 2, 3], used: 2 };
    sum(b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
