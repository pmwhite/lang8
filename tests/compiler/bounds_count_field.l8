tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

sum(b: *Buffer): int {
    if (b.used > len(b.data)) return -1;
    total: int = 0;
    for i in 0..b.used total = total + b.data[i];
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [1, 2, 3], used: 2 };
    sum(b)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 3
