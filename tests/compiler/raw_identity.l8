tag example;

use_tag std;

import "../../stdlib/print.l8";

// Raw runtime aliases preserve an address within the same address space.
// The counted slice header is explicitly adjacent to its fixed backing array.
type ByteSlot = {
    count: int;
    data: [16]i8
}

slot: ByteSlot = ByteSlot { count: 5, data: zeroed([16]i8) };

extern counted_at(p: *i8): []i8 = l8_as_int;

test "raw address identity preserves counted backing" {
    slot.data[0] = 'A';
    value: []i8 = counted_at(&slot.data[0]);
    write_int(1, len(value));
    write(1, " ");
    write_int(1, value[0] as int);
    value[4] = 'Z';
    write(1, " ");
    write_int(1, slot.data[4] as int);
    print("");
    expect {|
        5 65 90
    |}
}
