tag example;

import "../../stdlib/print.l8";

use_pointer(p: ?*int): int {
    p.*
}

test "a dereferenced parameter accepts an address" {
    x: int = 7;
    value: int = use_pointer(&x);
    std::write(1, "use_pointer(&x): ");
    std::print_int(value);
    expect {|
        use_pointer(&x): 7
    |}
}
