tag bounds_test;

write_pair(a: []int, i: int) {
    a[i + 1] = 1;
    a[i + 2] = 2
}

main(): int {
    a: []int = [0];
    i: int = 0 - 2;
    write_pair(a, i);
    0
}

/* expect compile {|
error: bounds_cursor_offset_minimum.l8:11:5: call does not prove inferred array bounds requirement for write_pair (i + 1) < len(a)
|} */
