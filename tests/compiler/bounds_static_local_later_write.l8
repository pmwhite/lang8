tag bounds_test;

main(): int {
    values: []int = [1, 2, 3];
    index: int = 1;
    for _pass in 0..2 {
        // The second iteration must not reuse the initializer's value.
        value: int = values[index];
        if (value == 0) return 0;
        index = 3
    }
    0
}

//% test: compile-fail
//% error-contains: "bounds"
