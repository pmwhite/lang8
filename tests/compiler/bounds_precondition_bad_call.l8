tag bounds_test;

choose(a: []int, n: int, first: bool): int requires (0 <= n && n < len(a)) {
    if (first && len(a) > 0) return n;
    0
}

main(): int {
    a: []int = [0, 4];
    n: int = a[0];
    if (n < 0 || n >= len(a)) return 0;
    good: int = choose(a, n, true);
    a[good] = 1;
    bad: int = choose(a, 99, true);
    a[bad]
}

/* expect compile {|
error: bounds_precondition_bad_call.l8:14:16: call does not prove function precondition
|} */
