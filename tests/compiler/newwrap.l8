tag example;

import "../../stdlib/print.l8";

/* new T[n] rejects a negative or wrapping count. */
test "a negative count exits" {
    n: int = 0 - 1;
    std::write(1, "n: ");
    std::print_int(n);
    expect {|
        n: -1
    |}
    s: []i8 = new i8[n](0i8);
    s[0] = 'X';
    expect {|
        [exit 1]
    |}
}
