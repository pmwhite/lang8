tag example;

import "../../stdlib/print.l8";

/* new T[n] rejects a negative or wrapping count. */
main(): int {
    n: int = 0 - 1;
    s: []i8 = new i8[n](0i8);
    s[0] = 'X';
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        [exit 1]
    |}
}
