tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2 };
    alias: *Buffer = b;
    alias.data = new int[0](0);
    b.data[1]
}

/* expect compile {|
error: bounds_field_local_alias.l8:12:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 1 && 1 < len(b.data))
|} */
