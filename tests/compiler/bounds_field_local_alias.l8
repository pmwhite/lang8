tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7], used: 2 };
    alias: *Buffer = b;
    alias.data = new int[0](0);
    b.data[1]
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "array index not proved in bounds"
