tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    a: []int = [3, 5, 7];
    i: int = 2;
    if (i > 0 && i < len(a)) return a[i - 1];
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 5
    |}
}
