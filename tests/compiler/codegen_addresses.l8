tag address_codegen_test;

import "../../stdlib/print.l8";

type Fields = {
    byte: i8;
    signed: i32;
    unsigned: u32;
    single: f32;
    wide: f64;
    word: int
}

type Holder = {
    fields: Fields;
    ptr: *Fields;
    data: []int
}

trace: int = 0;

global_fields: Fields = Fields {
    byte: 0i8,
    signed: 0i32,
    unsigned: 0u32,
    single: 0.0,
    wide: 0.0f64,
    word: 0
};

value(): int {
    trace = trace * 10 + 1;
    73
}

destination(p: *Fields): *Fields@p {
    trace = trace * 10 + 2;
    p
}

change(p: *Fields): int {
    p.word = 19;
    2
}

redirect(h: *Holder, p: *Fields@h): int {
    h.ptr = p;
    91
}

main(): int {
    fields: Fields = Fields {
        byte: 255i8,
        signed: -17i32,
        unsigned: 4294967295u32,
        single: 1.25,
        wide: 2.5f64,
        word: 11
    };
    p: *Fields = &fields;
    h: Holder = Holder { fields: fields, ptr: p, data: [4, 5, 6] };
    hp: *Holder = &h;
    hp.fields.byte = 254i8;
    hp.fields.signed = -123i32;
    hp.fields.unsigned = 4000000000u32;
    hp.fields.single = 3.5;
    hp.fields.wide = -7.25f64;
    if (h.fields.byte != 254i8 || h.fields.signed != -123i32 || h.fields.unsigned != 4000000000u32) return 1;
    if (h.fields.single != 3.5 || h.fields.wide != -7.25f64) return 2;
    if (2.0 + hp.fields.single != 5.5 || 1.0f64 + hp.fields.wide != -6.25f64) return 3;
    if (1i32 + hp.fields.signed != -122i32 || 1u32 + hp.fields.unsigned != 4000000001u32) return 4;
    hp.ptr.word = 37;
    if (p.word != 37 || 5 + hp.ptr.word != 42) return 5;
    if (change(p) + hp.ptr.word != 21) return 6;
    destination(p).word = value();
    if (trace != 12 || p.word != 73) return 7;
    trace = 0;
    a: []int = [0, 0];
    at: int = 0;
    a[at + 0] = value();
    if (trace != 1 || a[0] != 73) return 8;
    for i in 0..len(a) a[i] = i + 10;
    if (a[0] != 10 || a[1] != 11) return 9;
    fixed: [2]Fields = [fields, fields];
    for i in 0..2 fixed[i].word = i + 20;
    if (fixed[0].word != 20 || fixed[1].word != 21) return 10;
    for i in 0..2
        if (5 + fixed[i].word != i + 25) return 15;
    hp.ptr.word = redirect(hp, &hp.fields);
    if (hp.fields.word != 91 || fields.word != 73) return 11;
    global_fields.word = 81;
    if (global_fields.word != 81) return 12;
    x: int = 0;
    xp: *int = &x;
    xp.* = 83;
    if (x != 83) return 13;
    // Aggregate stores retain the copy path.
    h.fields = fields;
    if (h.fields.word != 73 || h.fields.byte != 255i8) return 14;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
