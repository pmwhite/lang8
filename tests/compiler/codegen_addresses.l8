tag address_codegen_test;

import "../../stdlib/print.l8";

type Fields = {
    byte: i8;
    signed: i32;
    unsigned: u32;
    single: f32;
    wide: f64;
    word: int
}

type Holder = {
    fields: Fields;
    ptr: *Fields;
    data: []int
}

trace: int = 0;

global_fields: Fields = Fields {
    byte: 0i8,
    signed: 0i32,
    unsigned: 0u32,
    single: 0.0,
    wide: 0.0f64,
    word: 0
};

value(): int {
    trace = trace * 10 + 1;
    73
}

destination(p: *Fields): *Fields@p {
    trace = trace * 10 + 2;
    p
}

change(p: *Fields): int {
    p.word = 19;
    2
}

redirect(h: *Holder, p: *Fields@h): int {
    h.ptr = p;
    91
}

address_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

address_show_float(label: str, value: f64) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_fixed(value, 3)
}

test "stores and loads through pointers to fields" {
    fields: Fields = Fields {
        byte: 255i8,
        signed: -17i32,
        unsigned: 4294967295u32,
        single: 1.25,
        wide: 2.5f64,
        word: 11
    };
    p: *Fields = &fields;
    h: Holder = Holder { fields: fields, ptr: p, data: [4, 5, 6] };
    hp: *Holder = &h;
    hp.fields.byte = 254i8;
    hp.fields.signed = -123i32;
    hp.fields.unsigned = 4000000000u32;
    hp.fields.single = 3.5;
    hp.fields.wide = -7.25f64;
    address_show("h.fields.byte", h.fields.byte as int);
    address_show("h.fields.signed", h.fields.signed as int);
    address_show("h.fields.unsigned", h.fields.unsigned as int);
    address_show_float("h.fields.single", h.fields.single as f64);
    address_show_float("h.fields.wide", h.fields.wide);
    expect {|
        h.fields.byte: 254
        h.fields.signed: -123
        h.fields.unsigned: 4000000000
        h.fields.single: 3.500
        h.fields.wide: -7.250
    |}
    // Fields read through a pointer as arithmetic operands.
    address_show_float("2.0 + hp.fields.single", (2.0 + hp.fields.single) as f64);
    address_show_float("1.0f64 + hp.fields.wide", 1.0f64 + hp.fields.wide);
    address_show("1i32 + hp.fields.signed", (1i32 + hp.fields.signed) as int);
    address_show("1u32 + hp.fields.unsigned", (1u32 + hp.fields.unsigned) as int);
    expect {|
        2.0 + hp.fields.single: 5.500
        1.0f64 + hp.fields.wide: -6.250
        1i32 + hp.fields.signed: -122
        1u32 + hp.fields.unsigned: 4000000001
    |}
    hp.ptr.word = 37;
    address_show("p.word", p.word);
    address_show("5 + hp.ptr.word", 5 + hp.ptr.word);
    expect {|
        p.word: 37
        5 + hp.ptr.word: 42
    |}
    address_show("change(p) + hp.ptr.word", change(p) + hp.ptr.word);
    expect {|
        change(p) + hp.ptr.word: 21
    |}
    // The destination address is computed before the stored value.
    destination(p).word = value();
    address_show("trace", trace);
    address_show("p.word", p.word);
    expect {|
        trace: 12
        p.word: 73
    |}
    hp.ptr.word = redirect(hp, &hp.fields);
    address_show("hp.fields.word", hp.fields.word);
    address_show("fields.word", fields.word);
    expect {|
        hp.fields.word: 91
        fields.word: 73
    |}
    // Aggregate stores retain the copy path.
    h.fields = fields;
    address_show("h.fields.word", h.fields.word);
    address_show("h.fields.byte", h.fields.byte as int);
    expect {|
        h.fields.word: 73
        h.fields.byte: 255
    |}
}

test "stores to array elements" {
    a: []int = [0, 0];
    at: int = 0;
    a[at + 0] = value();
    address_show("trace", trace);
    address_show("a[0]", a[0]);
    expect {|
        trace: 1
        a[0]: 73
    |}
    for i in 0..len(a) a[i] = i + 10;
    address_show("a[0]", a[0]);
    address_show("a[1]", a[1]);
    expect {|
        a[0]: 10
        a[1]: 11
    |}
    fields: Fields = Fields {
        byte: 255i8,
        signed: -17i32,
        unsigned: 4294967295u32,
        single: 1.25,
        wide: 2.5f64,
        word: 73
    };
    fixed: [2]Fields = [fields, fields];
    for i in 0..2 fixed[i].word = i + 20;
    address_show("fixed[0].word", fixed[0].word);
    address_show("fixed[1].word", fixed[1].word);
    expect {|
        fixed[0].word: 20
        fixed[1].word: 21
    |}
    for i in 0..2 {
        std::write(1, "5 + fixed[");
        std::write_int(1, i);
        address_show("].word", 5 + fixed[i].word)
    }
    expect {|
        5 + fixed[0].word: 25
        5 + fixed[1].word: 26
    |}
}

test "stores to a global field and through a local pointer" {
    global_fields.word = 81;
    address_show("global_fields.word", global_fields.word);
    expect {|
        global_fields.word: 81
    |}
    x: int = 0;
    xp: *int = &x;
    xp.* = 83;
    address_show("x", x);
    expect {|
        x: 83
    |}
}
