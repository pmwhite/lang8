tag example;

/* A pointer from a region opened in this function cannot be returned. */
type Cell = {
    v: int
}

f(): *Cell {
    region {
        p: *Cell = new Cell { v: 1 };
        return p
    }
}

main(): int {
    f();
    0
}

/* expect compile {|
warning: region_ret.l8:16:5: ignored return value in main
|} */

// Compile-only compatibility fixture: lifetime analysis has been removed.
