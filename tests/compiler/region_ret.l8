tag example;

/* A pointer from a region opened in this function cannot be returned. */
type Cell = {
    v: int
}

f(): *Cell {
    region {
        p: *Cell = new Cell { v: 1 };
        return p
    }
}

main(): int {
    f();
    0
}

/* expect compile {|
error: region_ret.l8:1:1: region pointer cannot escape in f
|} */
