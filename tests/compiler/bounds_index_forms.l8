tag bounds_test;

read_text(a: str, i: int): int {
    if (i < 0 || i >= len(a)) return -1;
    a[i] as int
}

read_fixed(a: [2]int, i: int): int {
    if (i < 0 || i >= len(a)) return -1;
    a[i]
}

read_nested(a: [][]int, i: int, j: int): int {
    if (i < 0 || i >= len(a)) return -1;
    row: []int = a[i];
    if (j < 0 || j >= len(row)) return -1;
    row[j]
}

write_slot(a: []int, i: int) {
    if (i < 0 || i >= len(a)) return;
    slot: *int = &a[i];
    slot.* = 8;
    a[i] = a[i] + 1
}

main(): int {
    a: []int = [1];
    write_slot(a, 0);
    if (a[0] != 9) return 1;
    fixed: [2]int = [3, 4];
    if (read_fixed(fixed, 1) != 4) return 2;
    if (read_text("ab", 1) != 98) return 3;
    if (read_nested([a], 0, 0) != 9) return 4;
    write_slot(a, 1);
    if (a[0] != 9) return 5;
    result: int = -1;
    if (read_text("a", -1) == -1) result = 0;
    result
}

//% test: run
//% stdout: ""
//% exit: 0
