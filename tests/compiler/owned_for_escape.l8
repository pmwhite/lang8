tag example;

type Box = {
    n: int
}

type Bag = {
    items: []*Box
}

main(): int {
    holder: *Box = new Box { n: 0 };
    bag: owned *Bag = own {
        new Bag { items: new *Box[1](new Box { n: 4 }) }
    };
    borrow bag {
        for item in bag.items holder = item
    }
    drop bag;
    0
}

/* expect compile {|
error: owned_for_escape.l8:17:31: arena pointer cannot escape in main
|} */
