tag inferred_locals_test;

import "../../stdlib/print.l8";

type Point = {
    x: int;
    y: int
}

type Choice =
    | Empty
    | Value { point: Point }

global_value: int = 7;

maybe(flag: bool): ?*int {
    if (flag) &global_value else null
}

twice(named value: int): int {
    value * 2
}

borrow(named value: *int): *int@value {
    value
}

exception Failed;

make_point() raises Failed: Point {
    raise Failed
}

show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "inference uses literal defaults and retains explicit widths" {
    count := 3;
    enabled := true;
    text := "hello";
    narrow := 4i32;
    single := 1.25;
    double := 1.25f64;
    byte := 'A';
    count = count + 2;
    show("count", count);
    std::print_bool(enabled);
    show("text length", len(text));
    show("int bytes", sizeof(count));
    show("i32 bytes", sizeof(narrow));
    show("f32 bytes", sizeof(single));
    show("f64 bytes", sizeof(double));
    show("byte bytes", sizeof(byte));
    expect {|
        count: 5
        true
        text length: 5
        int bytes: 8
        i32 bytes: 4
        f32 bytes: 4
        f64 bytes: 8
        byte bytes: 1
    |}
}

test "records arrays slices and collection elements retain their types" {
    point := Point { x: 2, y: 3 };
    pointer := &point;
    pointer.x = pointer.x + 1;
    fixed: [2]int = [1, 2];
    copy := fixed;
    copy[0] = 9;
    values := [4, 5];
    values[0] = values[0] + 1;
    sum := 0;
    for item in [Point { x: 1, y: 2 }, point] {
        x := item.x;
        sum = sum + x
    }
    show("point", point.x);
    show("original array", fixed[0]);
    show("copied array", copy[0]);
    show("slice", values[0]);
    show("sum", sum);
    expect {|
        point: 3
        original array: 1
        copied array: 9
        slice: 5
        sum: 4
    |}
}

test "function values retain labels and lifetimes" {
    callback := &twice;
    show("callback", callback(value: 6));
    region {
        values := new int[2](8);
        pointer := borrow(value: &values[0]);
        show("borrow", pointer.*)
    }
    pointer := maybe(true);
    if (pointer != null) show("optional", pointer.*);
    pointer = null;
    show("is null", if (pointer == null) 1 else 0);
    expect {|
        callback: 12
        borrow: 8
        optional: 7
        is null: 1
    |}
}

test "block conditional and match expressions infer values" {
    choice := Choice.Value { point: Point { x: 3, y: 4 } };
    value := match choice {
        Empty -> 0;
        Value payload -> payload.point.x + payload.point.y
    };
    result := if (value > 0) value else 1;
    block := {
        local := result + 1;
        local
    };
    show("match", value);
    show("if", result);
    show("block", block);
    match choice {
        Empty -> show("statement", 0);
        Value payload -> {
            x := payload.point.x;
            show("statement", x)
        }
    }
    expect {|
        match: 7
        if: 7
        block: 8
        statement: 3
    |}
}

test "inference respects exception context and lexical scope" {
    try {
        point := make_point();
        show("unreached", point.x)
    } with Failed -> {
        show("caught", 1)
    }
    value := 3;
    {
        value := value + 1;
        show("inner", value)
    }
    show("outer", value);
    expect {|
        caught: 1
        inner: 4
        outer: 3
    |}
}

type Box = {
    value: ?*int
}

type Holder = {
    pointer: *int;
    number: int
}

load_value(pointer: *int): int {
    pointer.*
}

test "inference checks a narrowed initializer only once" {
    x := 7;
    box := Box { value: &x };
    if (box.value != null) {
        holder := Holder { pointer: box.value, number: load_value(&x) };
        show("pointer", holder.pointer.*);
        show("number", holder.number)
    }
    expect {|
        pointer: 7
        number: 7
    |}
}
