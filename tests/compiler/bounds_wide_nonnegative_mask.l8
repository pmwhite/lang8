tag bounds_test;

import "../../stdlib/print.l8";

masked_index(a: []int, raw: int): int {
    index: int = raw & 4294967295;
    if (index >= len(a)) return -1;
    a[index]
}

main(): int {
    a: []int = [7];
    masked_index(a, 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
