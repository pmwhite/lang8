tag bounds_test;

type Buffer = {
    data: []int;
    index: int
}

change(b: *Buffer): bool {
    b.index = 1;
    true
}

main(): int {
    b: *Buffer = new Buffer { data: [7], index: 0 };
    if (0 <= b.index && b.index < len(b.data) && change(b)) return b.data[b.index];
    0
}

//% test: compile-fail
//% error-contains: "array index not proved in bounds"
