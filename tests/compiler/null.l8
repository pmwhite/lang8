tag example;

import "../../stdlib/raw_write.l8";

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

test "null" {
    p: ?*int = null;
    if (p == null) putchar('Y');
    q: ?*int = null;
    if (p == q) putchar('Y');
    x: int = 0;
    p = &x;
    if (p != null) {
        if (p.* == 0) putchar('Y')
    }
    p = null;
    if (p == null) putchar('Y');
    putchar('\n');
    expect {|
        YYYY
    |}
}
