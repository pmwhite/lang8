exception IndexOutOfBounds;

tag bounds_test;

type Buffer = {
    data: []int
}

first(b: *Buffer@new) raises IndexOutOfBounds: int {
    b.data = new int[0](0);
    b.data[0]
}

main() raises IndexOutOfBounds: int {
    b: *Buffer = new Buffer { data: [7] };
    first(b)
}

//% test: compile-fail
//% error-contains: "unproved array access"
