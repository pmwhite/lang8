exception IndexOutOfBounds;

tag bounds_test;

type Buffer = {
    data: []int
}

first(b: *Buffer@new) raises IndexOutOfBounds: int {
    b.data = new int[0](0);
    b.data[0]
}

main() raises IndexOutOfBounds: int {
    b: *Buffer = new Buffer { data: [7] };
    first(b)
}

/* expect compile {|
error: bounds_check_migration_keep.l8:11:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 0 && 0 < len(b.data))
|} */
