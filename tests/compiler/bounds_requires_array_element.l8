tag bounds_test;

import "../../stdlib/print.l8";

read_position(a: []int): int requires (1 <= len(a) && 0 <= a[0] && a[0] < len(a)) {
    a[a[0]]
}

main(): int {
    a: []int = [0, 7];
    a[0] = 1;
    read_position(a)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
