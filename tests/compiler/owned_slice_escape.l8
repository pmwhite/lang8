tag example;

type Box = {
    n: int
}

main(): int {
    boxes: []?owned *Box = new ?owned *Box[1](null);
    boxes[0] = own {
        new Box { n: 1 }
    };
    holder: *Box = new Box { n: 0 };
    borrow boxes[0] as box {
        holder = box
    }
    drop boxes[0];
    0
}

/* expect compile {|
error: owned_slice_escape.l8:14:9: arena pointer cannot escape in main
|} */
