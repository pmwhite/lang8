tag fill_test;

calls: int = 0;

fill(): i32 {
    calls = calls + 1;
    -17i32
}

main(): int {
    empty: []i32 = new i32[0](fill());
    one: []i32 = new i32[1](fill());
    odd: []u32 = new u32[3](4294967295u32);
    floats: []f32 = new f32[257](-1.5);
    if (len(empty) != 0 || len(one) != 1 || calls != 2) return 1;
    if (one[0] != -17i32) return 2;
    for x in odd
        if (x != 4294967295u32) return 3;
    for f in floats
        if (f != -1.5) return 4;
    bytes: []i8 = new i8[3](255i8);
    words: []int = new int[3](-1);
    if (bytes[2] != 255i8 || words[2] != -1) return 5;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
