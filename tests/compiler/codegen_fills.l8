tag fill_test;

import "../../stdlib/print.l8";

calls: int = 0;

fill(): i32 {
    calls = calls + 1;
    -17i32
}

fl_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "array fills" {
    empty: []i32 = new i32[0](fill());
    one: []i32 = new i32[1](fill());
    odd: []u32 = new u32[3](4294967295u32);
    floats: []f32 = new f32[257](-1.5);
    // The fill expression is evaluated once, even for an empty array.
    fl_show("len(empty)", len(empty));
    fl_show("len(one)", len(one));
    fl_show("calls", calls);
    fl_show("one[0]", one[0] as int);
    expect {|
        len(empty): 0
        len(one): 1
        calls: 2
        one[0]: -17
    |}
    std::write(1, "odd:");
    for x in odd {
        std::write(1, " ");
        std::write_int(1, x as int)
    }
    std::write(1, "\n");
    expect {|
        odd: 4294967295 4294967295 4294967295
    |}
    // Every element of the long fill, summarized by its extremes.
    low: f32 = floats[0];
    high: f32 = floats[0];
    for f in floats {
        if (f < low) low = f;
        if (f > high) high = f
    }
    fl_show("len(floats)", len(floats));
    std::write(1, "floats from ");
    std::write_fixed(1, low as f64, 2);
    std::write(1, " to ");
    std::write_fixed(1, high as f64, 2);
    std::write(1, "\n");
    expect {|
        len(floats): 257
        floats from -1.50 to -1.50
    |}
    bytes: []i8 = new i8[3](255i8);
    words: []int = new int[3](-1);
    fl_show("bytes[2]", bytes[2] as int);
    fl_show("words[2]", words[2]);
    expect {|
        bytes[2]: 255
        words[2]: -1
    |}
}
