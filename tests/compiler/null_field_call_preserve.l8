tag example;

import "../../stdlib/print.l8";

type Box = {
    value: ?*int;
    count: int
}

count(box: *Box) {
    box.count = box.count + 1
}

main(): int {
    values: []int = new int[1](7);
    box: *Box = new Box { value: &values[0], count: 0 };
    if (box.value != null) {
        count(box);
        box.value.*
    } else 0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
