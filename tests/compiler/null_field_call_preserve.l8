tag example;

import "../../stdlib/print.l8";

type Box = {
    value: ?*int;
    count: int
}

count(box: *Box) {
    box.count = box.count + 1
}

test "a call that does not write a field keeps its non-null fact" {
    values: []int = new int[1](7);
    box: *Box = new Box { value: &values[0], count: 0 };
    result: int = if (box.value != null) {
        count(box);
        box.value.*
    } else 0;
    std::write(1, "result: ");
    std::print_int(result);
    std::write(1, "box.count: ");
    std::print_int(box.count);
    expect {|
        result: 7
        box.count: 1
    |}
}
