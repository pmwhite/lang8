tag example;

use_tag std;

import "../../../stdlib/write.l8";

use_tag native_test;

import "helper.l8";

import "./helper.l8";

import "../../../stdlib/print.l8";

test "a native function is callable" {
    write(1, "native_answer(): ");
    print_int(native_answer());
    expect {|
        native_answer(): 42
    |}
}
