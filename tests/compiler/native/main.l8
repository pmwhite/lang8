tag example;

use_tag std;

import "../../../stdlib/write.l8";

use_tag native_test;

import "helper.l8";

import "./helper.l8";

import "../../../stdlib/print.l8";

main() raises IoError: int {
    if (native_answer() != 42) return 1;
    write(1, "Y\n");
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        Y
        main returned 0
    |}
}
