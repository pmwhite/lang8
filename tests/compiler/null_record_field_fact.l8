tag example;

import "../../stdlib/print.l8";

type Box = {
    value: *int
}

test "a pointer known to be non-null initializes a non-null field" {
    values: []int = new int[1](7);
    p: ?*int = &values[0];
    box: Box = Box { value: p };
    std::write(1, "box.value.*: ");
    std::print_int(box.value.*);
    expect {|
        box.value.*: 7
    |}
}
