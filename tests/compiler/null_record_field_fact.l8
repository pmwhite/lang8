tag example;

import "../../stdlib/print.l8";

type Box = {
    value: *int
}

main(): int {
    values: []int = new int[1](7);
    p: ?*int = &values[0];
    box: Box = Box { value: p };
    box.value.*
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
