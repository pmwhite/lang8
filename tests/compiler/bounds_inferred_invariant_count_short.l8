tag bounds_test;

sum(a: []int, n: int): int {
    i: int = 0;
    total: int = 0;
    while (i < n) invariant (0 <= i && i <= n && 0 <= n && n <= len(a)) {
        total = total + a[i];
        i = i + 1
    }
    total
}

main(): int {
    a: []int = [3, 4];
    sum(a, 3)
}

