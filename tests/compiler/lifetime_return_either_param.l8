tag example;

type Names = {
    first: str
}

// Either parameter can be the result, so the result is bound to one and
// the other must outlive it: written as just @fallback, a caller could
// keep the result as long as fallback lives though it is names's.
first_or(names: *Names, fallback: str, use_names: bool): str@fallback {
    if (use_names) names.first else fallback
}

main(): int {
    len(first_or(new Names { first: "Ruth" }, "Naomi", true))
}

/* expect compile {|
error: lifetime_return_either_param.l8:10:25: use @names on fallback in first_or
error: lifetime_return_either_param.l8:10:1: use @names on first_or
|} */
