tag bounds_test;

import "../../stdlib/print.l8";

sum_neighbors(a: []int): int {
    total: int = 0;
    for i in 0..8 {
        bit: int = 1;
        while (bit <= 4) {
            if (i / bit % 2 == 0) total = total + a[i ^ bit];
            bit = bit * 2
        }
    }
    total
}

main(): int {
    a: []int = [1, 1, 1, 1, 1, 1, 1, 1];
    sum_neighbors(a)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 12
    |}
}
