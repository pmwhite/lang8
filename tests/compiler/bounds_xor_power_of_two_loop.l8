tag bounds_test;

sum_neighbors(a: []int) raises IndexOutOfBounds: int {
    total: int = 0;
    for i in 0..8 {
        bit: int = 1;
        while (bit <= 4) {
            if (i / bit % 2 == 0) total = total + a![i ^ bit];
            bit = bit * 2
        }
    }
    total
}

main() raises IndexOutOfBounds: int {
    a: []int = [1, 1, 1, 1, 1, 1, 1, 1];
    sum_neighbors(a)
}

//% test: run
//% stdout: ""
//% exit: 12
