tag bounds_test;

import "../../stdlib/print.l8";

copy_span(dst: []int, offset: int, count: int) requires (0 <= offset && 0 <= count && count <= len(dst) - offset) {
    for i in 0..count dst[offset + i] = 1
}

main(): int {
    dst: []int = [0, 0];
    copy_span(dst, 0, 1);
    dst[0]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 1
    |}
}
