tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    data: []int = new int[4](0);
    value: u32 = 2u32;
    index: int = value as int;
    if (index >= len(data)) return 1;
    data[index]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
