tag bounds_test;

import "../../stdlib/print.l8";

// A guard on the sum of two variables proves an index by the same sum, in
// either order, while neither variable changes.
put(dst: []int, to: int, f: int): int {
    if (to + f >= 0 && to + f < len(dst)) {
        dst[f + to] = dst[to + f] + 1;
        return 1
    }
    0
}

copy(
    dst: []int,
    src: []int,
    to: int,
    from: int
): int {
    copied: int = 0;
    for f in 0..4 {
        if (to + f >= 0 && to + f < len(dst) && from + f >= 0 && from + f < len(src)) {
            dst[to + f] = src[from + f];
            copied = copied + 1
        }
    }
    copied
}

main(): int {
    a: []int = new int[4](0);
    b: []int = [5, 6, 7, 8];
    if (put(a, 2, 1) != 1 || a[3] != 1) return 1;
    if (put(a, 5, -1) != 0 || put(a, -3, 2) != 0) return 2;
    if (copy(a, b, 1, 0) != 3 || a[1] != 5 || a[3] != 7) return 3;
    if (copy(a, b, -2, 1) != 1 || a[0] != 8 || a[1] != 5) return 4;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
