tag dense_match_test;

import "../../stdlib/print.l8";

dense_choice(value: int): int {
    match value {
        -4 -> 11;
        -3 -> 12;
        -1 -> 13;
        0 -> 14;
        2 -> 15;
        3 -> 16;
        5 -> 17;
        6 -> 18;
        _ -> 99
    }
}

dense_limit(value: int): int {
    match value {
        -2147483648 -> 21;
        -2147483647 -> 22;
        -2147483646 -> 23;
        -2147483645 -> 24;
        -2147483644 -> 25;
        -2147483643 -> 26;
        -2147483642 -> 27;
        -2147483641 -> 28;
        _ -> 99
    }
}

// A table for values starting just above zero also spans zero and below.
dense_from_three(value: int): int {
    match value {
        3 -> 1;
        4 -> 2;
        5 -> 3;
        6 -> 4;
        7 -> 5;
        8 -> 6;
        9 -> 7;
        10 -> 8;
        _ -> 0
    }
}

main(): int {
    expected: []int = [99, 11, 12, 99, 13, 14, 99, 15, 16, 99, 17, 18, 99];
    for index, result in expected {
        if (dense_choice(index - 5) != result) return 1
    }
    for offset in 0..8 {
        if (dense_limit(0 - 2147483648 + offset) != 21 + offset) return 2
    }
    if (dense_limit(0 - 2147483649) != 99 || dense_limit(0 - 2147483640) != 99) return 3;
    if (dense_choice(0 - 9223372036854775807 - 1) != 99 || dense_choice(9223372036854775807) != 99) return 4;
    if (dense_from_three(0 - 1) != 0 || dense_from_three(0) != 0 || dense_from_three(2) != 0) return 5;
    if (dense_from_three(3) != 1 || dense_from_three(10) != 8 || dense_from_three(11) != 0) return 6;
    0
}

test "dense integer dispatch preserves holes and signed range boundaries" {
    std::print_int(main());
    expect {|
        0
    |}
}

test "dense match arms preserve surrounding expressions and loop exits" {
    total: int = 100;
    for value in 0..10 total = total + 2 * (match value {
        0 -> dense_choice(0);
        1 -> {
            continue
        }
        2 -> 3;
        3 -> 4;
        4 -> {
            break
        }
        5 -> 6;
        6 -> 7;
        7 -> 8;
        _ -> 99
    });
    std::print_int(total);
    expect {|
        142
    |}
}
