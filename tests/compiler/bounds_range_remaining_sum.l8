tag bounds_test;

import "../../stdlib/print.l8";

fill(left: int, right: int, a: []int) requires (0 <= left && left < right && right <= 240 && len(a) >= 241) {
    for i in 1..right - left a[left + i] = 7
}

main(): int {
    a: []int = new int[241](0);
    fill(2, 5, a);
    a[3] + a[4]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 14
    |}
}
