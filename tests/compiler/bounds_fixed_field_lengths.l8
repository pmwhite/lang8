tag bounds_test;

import "../../stdlib/print.l8";

type Fixed = {
    data: []int;
    marker: int
} invariant (4 == len(data))

replacement(value: *Fixed): []int@new {
    value.marker = 1;
    new int[4](7)
}

read_fixed(value: *Fixed): int {
    value.data[3]
}

main(): int {
    value: *Fixed = new Fixed { data: new int[4](0), marker: 0 };
    for i in 0..4 value.data[i] = i;
    copied: []int = value.data;
    value.data = new int[4](5);
    value.data = replacement(value);
    read_fixed(value) + copied[3]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 10
    |}
}
