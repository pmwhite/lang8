tag bounds_test;

copy(
    dst: []int,
    doff: int,
    src: []int,
    soff: int,
    n: int
) {
    for i in 0..n dst[doff + i] = src[soff + i]
}

main(): int {
    dst: []int = new int[2](0);
    src: []int = new int[4](3);
    copy(dst, 1, src, 1, 2);
    0
}

/* expect compile {|
error: bounds_offset_inferred_bad_call.l8:16:5: call does not prove function precondition
|} */
