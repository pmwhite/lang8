tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    words: []int = [1, 2, 3, 4, 5];
    bytes: []int = new int[20](0);
    for i in 0..len(words) bytes[i * 4 + 3] = words[i];
    bytes[19]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 5
    |}
}
