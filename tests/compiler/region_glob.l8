tag example;

/* A region pointer cannot be stored in a global. */
type Cell = {
    v: int
}

g: ?*Cell = null;

main(): int {
    region {
        p: *Cell = new Cell { v: 1 };
        g = p
    }
    0
}

/* expect compile {|
error: region_glob.l8:13:9: region pointer cannot escape in main
|} */
