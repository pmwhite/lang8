tag bounds_test;

scan(a: []int, p: int) raises IndexOutOfBounds: int {
    while (p < len(a)) {
        if (a[p] == 7) return p;
        p = p + 1
    }
    -1
}

forward(a: []int, p: int) raises IndexOutOfBounds: int {
    scan(a, p)
}

main() raises IndexOutOfBounds: int {
    a: []int = [7, 9];
    if (forward(a, len(a)) != -1) return 1;
    forward(a, 0)
}

//% test: run
//% stdout: ""
//% exit: 0
