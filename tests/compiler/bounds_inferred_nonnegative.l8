tag bounds_test;

import "../../stdlib/print.l8";

scan(a: []int, p: int): int {
    while (p < len(a)) {
        if (a[p] == 7) return p;
        p = p + 1
    }
    -1
}

forward(a: []int, p: int): int {
    scan(a, p)
}

main(): int {
    a: []int = [7, 9];
    if (forward(a, len(a)) != -1) return 1;
    forward(a, 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
