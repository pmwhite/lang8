tag index_checks_test;

import "../../stdlib/print.l8";

// a[i] checks 0 <= i < len(a) at run time. A failed check exits with status 1.
const SLOTS: int = 3;

type Ring = {
    items: [4]int;
    data: []int
}

ic_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

// Not a constant, so the compiler cannot tell where an index points.
ic_at(i: int): int {
    i
}

test "indexes inside each kind of array" {
    fixed: [3]int = [1, 2, 3];
    slice: []int = [4, 5, 6];
    text: str = "abc";
    ring: Ring = Ring { items: [7, 8, 9, 10], data: slice };
    total: int = 0;
    for i in 0..SLOTS {
        total = total + fixed[i] + slice[ic_at(i)] + text[i] as int;
        total = total + ring.items[i + 1] + ring.data[i]
    }
    ic_show("total", total);
    p: *int = &slice[ic_at(2)];
    p.* = 60;
    ic_show("slice[2]", slice[2]);
    ic_show("fixed[SLOTS - 1]", fixed[SLOTS - 1]);
    expect {|
        total: 357
        slice[2]: 60
        fixed[SLOTS - 1]: 3
    |}
}

test "a fixed array index past the end" {
    fixed: [3]int = [1, 2, 3];
    ic_show("fixed[3]", fixed[ic_at(3)]);
    expect {|
        [exit 1]
    |}
}

test "a constant fixed array index past the end" {
    fixed: [3]int = [1, 2, 3];
    ic_show("fixed[SLOTS]", fixed[SLOTS]);
    expect {|
        [exit 1]
    |}
}

test "a negative slice index" {
    slice: []int = [4, 5, 6];
    ic_show("slice[-1]", slice[ic_at(0 - 1)]);
    expect {|
        [exit 1]
    |}
}

test "a slice write past the end" {
    slice: []i8 = new i8[1](0i8);
    slice[ic_at(1)] = 'X';
    ic_show("unreachable", 0);
    expect {|
        [exit 1]
    |}
}

test "the hidden str sentinel" {
    text: str = "hidden";
    ic_show("text[len(text)]", text[len(text)] as int);
    expect {|
        [exit 1]
    |}
}

test "taking the address of an element past the end" {
    slice: []int = [4, 5, 6];
    p: *int = &slice[ic_at(3)];
    ic_show("p.*", p.*);
    expect {|
        [exit 1]
    |}
}

test "an index past the end of a record field" {
    ring: Ring = Ring { items: [7, 8, 9, 10], data: [1] };
    ic_show("ring.items[0]", ring.items[0]);
    ic_show("ring.data[1]", ring.data[ic_at(1)]);
    expect {|
        ring.items[0]: 7
        [exit 1]
    |}
}
