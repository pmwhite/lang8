tag bounds_test;

import "../../stdlib/print.l8";

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

read_twice(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    first: int = a[i];
    first + consume(a, i)
}

main(): int {
    a: []int = [6];
    read_twice(a, 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 12
    |}
}
