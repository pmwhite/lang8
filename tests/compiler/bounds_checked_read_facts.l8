tag bounds_test;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

read_twice(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    first: int = a[i];
    first + consume(a, i)
}

main(): int {
    a: []int = [6];
    read_twice(a, 0)
}

//% test: run
//% stdout: ""
//% exit: 12
