tag bounds_test;

import "../../stdlib/print.l8";

sum_four(a: []int): int {
    if (len(a) < 4) return 0;
    total: int = 0;
    for i in 0..4 total = total + a[i];
    total
}

main(): int {
    sum_four([1, 2, 3, 4])
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 10
    |}
}
