tag example;

type Box = {
    n: int
}

type Pair = {
    p: *Box
}

seed: *Box = new Box { n: 1 };

g: ?*Box = null;

main(): int {
    region {
        box: Pair = Pair { p: seed };
        box.p = new Box { n: 4 };
        g = box.p
    }
    0
}

/* expect compile {|
error: region_field_escape.l8:19:9: region pointer cannot escape in main
|} */
