tag example;

/* A function that stores ambient new into a global cannot be called from a region. */
g: ?*int = null;

alloc() noregion {
    g = new int[1](0)
}

main(): int {
    region {
        alloc()
    }
    0
}

/* expect compile {|
error: region_callimm.l8:1:1: cannot call from a region
|} */
