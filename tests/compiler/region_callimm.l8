tag example;

/* A function that stores ambient new into a global cannot be called from a region. */
g: ?*int = null;

alloc() noregion {
    g = new int[1](0)
}

main(): int {
    region {
        alloc()
    }
    0
}

/* expect compile {|
error: region_callimm.l8:12:9: alloc requires noregion; move the call outside this region or use a function without that requirement
|} */
