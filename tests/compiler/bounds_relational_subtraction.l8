tag bounds_test;

main(): int {
    a: []int = [7, 2, 0, 0, 0, 42, 0, 0];
    high: int = a[0];
    low: int = a[1];
    if (high < 0 || high >= 8 || low < 0 || low >= high) return 1;
    gap: int = high - low;
    if (a[gap] != 42 || a[high - low] != 42) return 2;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
