tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    a: []int = [7, 2, 0, 0, 0, 42, 0, 0];
    high: int = a[0];
    low: int = a[1];
    if (high < 0 || high >= 8 || low < 0 || low >= high) return 1;
    gap: int = high - low;
    if (a[gap] != 42 || a[high - low] != 42) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
