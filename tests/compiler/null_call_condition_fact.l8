tag example;

import "../../stdlib/print.l8";

predicate(): bool {
    true
}

read_pointer(p: ?*int): int {
    if (p != null && predicate()) p.* else 0
}

test "a null check followed by a call keeps the pointer non-null" {
    x: int = 7;
    std::write(1, "read_pointer(&x): ");
    std::print_int(read_pointer(&x));
    expect {|
        read_pointer(&x): 7
    |}
    std::write(1, "read_pointer(null): ");
    std::print_int(read_pointer(null));
    expect {|
        read_pointer(null): 0
    |}
}
