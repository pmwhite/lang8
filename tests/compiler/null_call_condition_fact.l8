tag example;

import "../../stdlib/print.l8";

predicate(): bool {
    true
}

read_pointer(p: ?*int): int {
    if (p != null && predicate()) p.* else 0
}

main(): int {
    x: int = 7;
    read_pointer(&x)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
