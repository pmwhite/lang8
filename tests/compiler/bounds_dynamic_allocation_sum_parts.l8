tag bounds_test;

copy_with_space(source: []int, extra: u32): int {
    source_len: int = len(source);
    space: int = extra as int;
    output: []int = new int[source_len + space](0);
    for i in 0..source_len output[i] = source[i];
    if (source_len > 0) return output[source_len - 1];
    0
}

main(): int {
    copy_with_space([3, 4], 1u32)
}

//% test: run
//% stdout: ""
//% exit: 4
