tag example;

import "../../stdlib/print.l8";

exponent_show(label: str, value: bool) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_bool(value)
}

test "huge exponents overflow to large values" {
    exponent_show("1e999999999999999999999 > 1e30", 1e999999999999999999999 > 1e30);
    exponent_show("1e999999999999999999999f64 > 1e308f64", 1e999999999999999999999f64 > 1e308f64);
    exponent_show("1e1000000000f64 > 1e308f64", 1e1000000000f64 > 1e308f64);
    expect {|
        1e999999999999999999999 > 1e30: true
        1e999999999999999999999f64 > 1e308f64: true
        1e1000000000f64 > 1e308f64: true
    |}
}

test "huge negative exponents underflow to zero" {
    exponent_show("1e-999999999999999999999 == 0.0", 1e-999999999999999999999 == 0.0);
    exponent_show("1e-999999999999999999999f64 == 0.0f64", 1e-999999999999999999999f64 == 0.0f64);
    exponent_show("1e-1000000000f64 == 0.0f64", 1e-1000000000f64 == 0.0f64);
    expect {|
        1e-999999999999999999999 == 0.0: true
        1e-999999999999999999999f64 == 0.0f64: true
        1e-1000000000f64 == 0.0f64: true
    |}
    // A small exponent that is still in range does not.
    exponent_show("1e-300f64 > 0.0f64", 1e-300f64 > 0.0f64);
    expect {|
        1e-300f64 > 0.0f64: true
    |}
}

test "zero with a huge exponent is zero" {
    exponent_show("0e999999999999999999999 == 0.0", 0e999999999999999999999 == 0.0);
    exponent_show("0e-999999999999999999999f64 == 0.0f64", 0e-999999999999999999999f64 == 0.0f64);
    expect {|
        0e999999999999999999999 == 0.0: true
        0e-999999999999999999999f64 == 0.0f64: true
    |}
}

test "leading zeros in an exponent" {
    std::write(1, "1e000000000000000000003: ");
    std::print_fixed(1e000000000000000000003 as f64, 3);
    exponent_show("1e000000000000000000003 == 1000.0", 1e000000000000000000003 == 1000.0);
    expect {|
        1e000000000000000000003: 1000.000
        1e000000000000000000003 == 1000.0: true
    |}
}
