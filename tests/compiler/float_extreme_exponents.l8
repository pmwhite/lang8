tag example;

import "../../stdlib/print.l8";

main(): int {
    if (!(1e999999999999999999999 > 1e30)) return 1;
    if (!(1e999999999999999999999f64 > 1e308f64)) return 2;
    if (1e-999999999999999999999 != 0.0) return 3;
    if (1e-999999999999999999999f64 != 0.0f64) return 4;
    if (0e999999999999999999999 != 0.0) return 5;
    if (0e-999999999999999999999f64 != 0.0f64) return 6;
    if (1e000000000000000000003 != 1000.0) return 7;
    if (!(1e-300f64 > 0.0f64)) return 8;
    if (!(1e1000000000f64 > 1e308f64)) return 9;
    if (1e-1000000000f64 != 0.0f64) return 10;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
