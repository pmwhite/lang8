tag example;

import "../../stdlib/raw_write.l8";

/* A parameter with no @ is borrowed for the call, so &local is allowed. */
type Box = {
    p: *int
}

type Ts = {
    sec: int;
    nsec: int
}

extern clock_gettime(clk: int, ts: *Ts): int;

putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

id(x: int): int {
    x
}

load(p: *int): int {
    p.*
}

loadb(b: Box): int {
    b.p.*
}

fwd(p: *int): int {
    load(p)
}

test "local" {
    x: int = 3;
    if (id(3) == 3) putchar('Y');
    if (load(&x) == 3) putchar('Y');
    b: Box = Box { p: &x };
    if (loadb(b) == 3) putchar('Y');
    if (fwd(&x) == 3) putchar('Y');
    ts: Ts = Ts { sec: 0, nsec: 0 };
    if (clock_gettime(1, &ts) == 0) putchar('Y');
    putchar('\n');
    expect {|
        YYYYY
    |}
}
