tag fixed_buffer;

import "../../stdlib/print.l8";

use_tag std;

extern heap_used(): int = l8_heap_used;

borrow(data: []i8): []i8@data {
    data
}

recursive(depth: int): int {
    data: []i8 = buffer([16]i8);
    data[0] = depth trunc i8;
    if (depth > 0) {
        nested: int = recursive(depth - 1);
        return nested + data[0] as int
    }
    data[0] as int
}

test "fixed counted buffers borrow the function frame" {
    before: int = heap_used();
    data: []i8 = buffer([4096]i8);
    words: []int = buffer(2 * 2, 0);
    data[4095] = 71i8;
    alias: []i8 = borrow(data);
    alias[1] = 11i8;
    words[3] = 13;
    print_int(len(data));
    print_int(data[0] as int + data[1] as int + data[4095] as int + words[3]);
    print_int(recursive(3));
    print_bool(heap_used() == before);
    expect {|
        4096
        95
        6
        true
    |}
}
