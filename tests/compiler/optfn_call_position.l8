tag example;

type Handlers = {
    picked: ?fn(row: int): int
}

/* An optional function value is narrowed before it is called; the error is
at the call. */
main(): int {
    h: Handlers = Handlers { picked: null };
    h.picked(1)
}

/* expect compile {|
error: optfn_call_position.l8:11:5: optional function must be narrowed before calling
|} */
