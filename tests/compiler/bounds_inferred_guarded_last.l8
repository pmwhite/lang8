tag bounds_test;

import "../../stdlib/print.l8";

last_or_zero(a: []int, n: int): int {
    if (n <= 0) return 0;
    a[n - 1]
}

main(): int {
    empty: []int = new int[0](0);
    full: []int = [9];
    last_or_zero(empty, 0) + last_or_zero(full, 1)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
