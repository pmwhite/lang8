tag bounds_test;

sixth_from(a: []int, i: int): int requires (0 <= i && i + 5 < len(a)) {
    a[i + 5]
}

main(): int {
    a: []int = [0, 1, 2, 3, 4, 5];
    sixth_from(a, 1)
}

/* expect compile {|
error: bounds_precondition_offset_bad_call.l8:9:5: call does not prove inferred array bounds requirement for sixth_from 6 < len(a)
|} */
