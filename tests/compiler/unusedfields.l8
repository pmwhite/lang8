tag example;

type Inner = {
    value: int;
    spare_inner: int
}

type Foreign = {
    layout: int
}

extern foreign_layout(value: *Foreign): int;

type Flags = {
    enabled: int;
    count: int;
    spare: int;
    write_only: int;
    nested: Inner
}

main(): int {
    flags: Flags = Flags {
        enabled: 1,
        count: 5,
        spare: 0,
        write_only: 0,
        nested: Inner { value: 2, spare_inner: 3 }
    };
    flags.write_only = 7;
    if (flags.enabled != 0) return flags.count + flags.nested.value;
    0
}
