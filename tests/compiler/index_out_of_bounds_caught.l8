import "../../stdlib/print.l8";

exception IndexOutOfBounds;

tag bounds_test;

get(a: []int, i: int) raises IndexOutOfBounds: int {
    if (i < 0 || i >= len(a)) raise IndexOutOfBounds;
    a[i]
}

main(): int {
    a: []int = new int[1](7);
    try {
        return get(a, 2)
    } with IndexOutOfBounds -> {
        return 42
    }
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 42
    |}
}
