tag static_exception_payload;

import "../../stdlib/print.l8";

use_tag std;

exception Payload {
    first: int;
    second: int
}

extern heap_used(): int = l8_heap_used;

nested() raises Payload {
    raise Payload { first: 3, second: 4 }
}

nested_value(): int {
    try {
        nested()
    } with Payload inner -> {
        return inner.first + inner.second
    }
    0
}

outer() raises Payload {
    raise Payload { first: 71, second: nested_value() }
}

test "payload construction and nested catches use fixed storage" {
    before: int = heap_used();
    total: int = 0;
    for _i in 0..1000 {
        try {
            outer()
        } with Payload saved -> {
            // Another raise uses the transfer slot while saved stays local.
            total = total + nested_value() + saved.first + saved.second
        }
    }
    print_int(total);
    print_bool(heap_used() == before);
    expect {|
        85000
        true
    |}
}
