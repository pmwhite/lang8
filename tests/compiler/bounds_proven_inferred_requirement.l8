tag bounds_test;

import "../../stdlib/print.l8";

sixth(a: []int): int {
    a[5]
}

forward(a: []int): int {
    sixth(a)
}

main(): int {
    a: []int = new int[6](7);
    forward(a)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
