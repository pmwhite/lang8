tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer): int {
    b.data[b.cursor]
}

call_after_write(b: *Buffer): int {
    if (b.cursor < 0 || b.cursor >= len(b.data)) return 1;
    b.cursor = 3;
    get(b)
}

main(): int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    call_after_write(b)
}

/* expect compile {|
error: bounds_inferred_field_relation_stale.l8:15:5: call does not prove inferred array bounds requirement for get b.cursor < len(b.data)
|} */
