tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer): int {
    b.data[b.cursor]
}

call_after_write(b: *Buffer): int {
    if (b.cursor < 0 || b.cursor >= len(b.data)) return 1;
    b.cursor = 3;
    get(b)
}

main(): int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    call_after_write(b)
}

//% test: compile-fail
//% error-contains: "unproved array access requires raises IndexOutOfBounds"
