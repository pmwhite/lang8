tag zeroed_array;

import "../../stdlib/print.l8";

use_tag std;

type Cell = {
    count: int;
    flags: [3]bool
}

extern heap_used(): int = l8_heap_used;

make_array(): [3]int {
    zeroed([3]int)
}

cells: [4]Cell = zeroed([4]Cell);

test "zeroed arrays have fixed inline storage" {
    before: int = heap_used();
    data: [4096]i8 = zeroed([4096]i8);
    nested: [2][3]int = zeroed([2][3]int);
    floats: [2]f64 = zeroed([2]f64);
    total: int = 0;
    for b in data total = total + b as int;
    data[4095] = 7i8;
    nested[1][2] = 11;
    copy: [3]int = make_array();
    copy[2] = 13;
    print_int(total + data[4095] as int + nested[1][2] + copy[2] + cells[3].count);
    print_bool(floats[1] == 0.0f64 && !cells[0].flags[2]);
    print_bool(heap_used() == before);
    expect {|
        31
        true
        true
    |}
}
