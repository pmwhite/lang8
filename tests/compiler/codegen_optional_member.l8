tag optional_member_test;

import "../../stdlib/print.l8";

type Item = {
    value: int;
    flag: bool
}

type Holder = {
    item: ?*Item
}

read_item(h: *Holder): int {
    if (h.item == null) return -1;
    h.item.value
}

write_item(h: *Holder): int {
    if (h.item == null) return -1;
    h.item.value = 43;
    p: *int = &h.item.value;
    p.* = 44;
    if (h.item == null) return -2;
    if (h.item.flag) return 2 + h.item.value;
    0
}

om_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "members through an optional pointer" {
    item: Item = Item { value: 31, flag: true };
    holder: Holder = Holder { item: &item };
    om_show("read_item", read_item(&holder));
    expect {|
        read_item: 31
    |}
    om_show("write_item", write_item(&holder));
    om_show("item.value", item.value);
    expect {|
        write_item: 46
        item.value: 44
    |}
    holder.item = null;
    om_show("read_item", read_item(&holder));
    om_show("write_item", write_item(&holder));
    expect {|
        read_item: -1
        write_item: -1
    |}
}
