tag optional_member_test;

type Item = {
    value: int;
    flag: bool
}

type Holder = {
    item: ?*Item
}

read_item(h: *Holder): int {
    if (h.item == null) return -1;
    h.item.value
}

write_item(h: *Holder): int {
    if (h.item == null) return -1;
    h.item.value = 43;
    p: *int = &h.item.value;
    p.* = 44;
    if (h.item == null) return -2;
    if (h.item.flag) return 2 + h.item.value;
    0
}

main(): int {
    item: Item = Item { value: 31, flag: true };
    holder: Holder = Holder { item: &item };
    if (read_item(&holder) != 31) return 1;
    if (write_item(&holder) != 46 || item.value != 44) return 2;
    holder.item = null;
    if (read_item(&holder) != -1 || write_item(&holder) != -1) return 3;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
