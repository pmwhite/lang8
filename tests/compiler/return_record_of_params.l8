tag example;

import "../../stdlib/print.l8";

// A new record that keeps two parameters, each its own: both need only
// outlive the record (@new), not each other.
type Decoding = {
    source: []i8;
    output: []i8;
    table: []int
}

decoding_new(source: []i8@new, output: []i8@new): Decoding@new {
    Decoding { source: source, output: output, table: new int[4](0) }
}

test "a new record keeps two parameters" {
    source: []i8 = new i8[3](1i8);
    region {
        // (Scratch for the output alone: a shorter life than the source.)
        window: []i8 = new i8[5](2i8);
        decoding: Decoding = decoding_new(source, window);
        std::print_int(len(decoding.source) + len(decoding.output) + len(decoding.table))
    }
    expect {|
        12
    |}
}
