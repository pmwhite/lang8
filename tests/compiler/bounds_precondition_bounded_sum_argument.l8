tag bounds_test;

import "../../stdlib/print.l8";

pick(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

forward(a: []int, base: int, part: int): int requires (0 <= base && base <= 4 && 0 <= part && part < 4 && len(a) >= 8) {
    pick(a, base + part)
}

main(): int {
    a: []int = [0, 1, 2, 3, 4, 5, 6, 7];
    forward(a, 4, 3)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
