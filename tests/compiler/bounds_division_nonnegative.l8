tag bounds_test;

import "../../stdlib/print.l8";

nonnegative(n: int): int requires (0 <= n) {
    n
}

halve(n: int): int requires (0 <= n) {
    half: int = n / 2;
    nonnegative(half)
}

main(): int {
    halve(8)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 4
    |}
}
