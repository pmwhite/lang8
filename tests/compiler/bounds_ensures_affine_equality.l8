tag bounds_test;

import "../../stdlib/print.l8";

advance(i: int): int requires (0 <= i && i <= 2) ensures (returned == i + 6) {
    result: int = i + 6;
    result
}

main(): int {
    data: []int = [0, 1, 2, 3, 4, 5, 6, 7, 8];
    start: int = 2;
    at: int = advance(start);
    data[at]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 8
    |}
}
