tag bounds_test;

import "../../stdlib/print.l8";

type Grid = {
    cells: []int;
    cols: int;
    rows: int
} invariant (len(cells) == 28800 && 2 <= cols && cols <= 240 && 2 <= rows && rows <= 120)

fill(grid: *Grid) {
    y: int = 0;
    while (y < grid.rows) {
        x: int = 0;
        while (x < grid.cols) {
            grid.cells[y * 240 + x] = x + y;
            x = x + 1
        }
        y = y + 1
    }
}

main(): int {
    grid: *Grid = new Grid { cells: new int[28800](0), cols: 240, rows: 120 };
    fill(grid);
    grid.cells[119 * 240 + 239] % 100
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 58
    |}
}
