tag bounds_test;

type Cell = {
    index: int
}

change(cells: []Cell): bool requires (1 <= len(cells)) {
    cells[0] = Cell { index: 1 };
    true
}

forward(cells: []Cell): bool requires (1 <= len(cells)) {
    change(cells)
}

main(): int {
    a: []int = [7];
    cells: []Cell = [Cell { index: 0 }];
    p: *Cell = &cells[0];
    if (0 <= p.index && p.index < len(a) && forward(cells)) return a[p.index];
    0
}

//% test: compile-fail
//% error-contains: "array index not proved in bounds"
