exception IndexOutOfBounds;

tag bounds_test;

fetch(a: []int, i: int): int {
    try {
        return a[i]
    } with IndexOutOfBounds -> {
        return 0
    }
}

main(): int {
    a: []int = [7];
    fetch(a, 1)
}

