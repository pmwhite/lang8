tag bounds_test;

import "../../stdlib/print.l8";

find(a: []int, n: int): int {
    for i in 0..n {
        if (a[i] == 7) return i
    }
    0 - 1
}

choose(a: []int, first: bool): int {
    x: int = find(a, len(a));
    y: int = find(a, len(a));
    if (first) {
        if (x < 0) return 0
    } else {
        if (y < 0) return 0;
        x = y
    }
    copied: int = x;
    a[copied]
}

main(): int {
    choose([3, 7], false)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
