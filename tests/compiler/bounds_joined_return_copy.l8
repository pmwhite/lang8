tag bounds_test;

find(a: []int, n: int) raises IndexOutOfBounds: int {
    for i in 0..n {
        if (a[i] == 7) return i
    }
    0 - 1
}

choose(a: []int, first: bool) raises IndexOutOfBounds: int {
    x: int = find(a, len(a));
    y: int = find(a, len(a));
    if (first) {
        if (x < 0) return 0
    } else {
        if (y < 0) return 0;
        x = y
    }
    copied: int = x;
    a[copied]
}

main() raises IndexOutOfBounds: int {
    choose([3, 7], false)
}

//% test: run
//% stdout: ""
//% exit: 7
