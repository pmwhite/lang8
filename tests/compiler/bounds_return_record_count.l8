tag bounds_test;

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

advance(a: []int, n: int): int {
    if (n < 0 || n >= len(a)) return 0;
    n + 1
}

main(): int {
    b: *Buffer = new Buffer { data: new int[4](0), used: 0 };
    next: int = advance(b.data, b.used);
    b.used = next;
    b.used
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 1
