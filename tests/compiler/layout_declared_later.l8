tag example;

import "../../stdlib/print.l8";

// A record that holds by value a record and a variant declared after it
// is laid out with their sizes: storing either keeps its neighbours.
type Holder = {
    inner: Inner;
    block: BlockState;
    last: bool;
    ended: bool
}

type Inner = {
    a: int;
    b: int
}

type BlockState =
    | Between
    | Stored { left: int }

set_stored(holder: *Holder, n: int) {
    holder.block = BlockState.Stored { left: n }
}

test "types held by value before they are declared" {
    holder: Holder = Holder {
        inner: Inner { a: 1, b: 2 },
        block: BlockState.Between,
        last: false,
        ended: false
    };
    set_stored(&holder, 65531);
    holder.inner = Inner { a: 3, b: 4 };
    std::print_int(sizeof(Holder));
    std::print_bool(holder.last);
    std::print_bool(holder.ended);
    std::print_int(holder.inner.a + holder.inner.b);
    match holder.block {
        Between -> std::print("between");
        Stored s -> std::print_int(s.left)
    }
    expect {|
        40
        false
        false
        7
        65531
    |}
}
