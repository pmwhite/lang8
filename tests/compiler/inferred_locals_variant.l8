tag inferred_local_rejection;

type Shape =
    | Rectangle { width: int, height: int }
    | Circle { radius: int }

main(): int {
    shape := Shape.Circle { radius: 2 };
    match shape {
        Circle circle -> circle.radius;
        Rectangl rectangle -> rectangle.width
    }
}

