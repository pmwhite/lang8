tag bounds_test;

import "../../stdlib/print.l8";

fill(a: []int, n: int) {
    for i in 0..n a[i] = 7
}

last(n: int): int {
    a: []int = new int[n](0);
    fill(a, n);
    if (n > 0) return a[n - 1];
    0
}

main(): int {
    last(3)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
