tag bounds_test;

fill(a: []int, n: int) raises IndexOutOfBounds {
    for i in 0..n a[i] = 7
}

last(n: int) raises IndexOutOfBounds: int {
    a: []int = new int[n](0);
    fill(a, n);
    if (n > 0) return a[n - 1];
    0
}

main() raises IndexOutOfBounds: int {
    last(3)
}

//% test: run
//% stdout: ""
//% exit: 7
