tag bounds_test;

import "../../stdlib/print.l8";

type Inner = {
    values: []int
}

type Outer = {
    inner: *Inner
}

clear(box: *Outer) {
    for i in 0..len(box.inner.values) box.inner.values[i] = 0
}

main(): int {
    inner: *Inner = new Inner { values: [1, 2, 3] };
    box: *Outer = new Outer { inner: inner };
    clear(box);
    box.inner.values[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
