tag bounds_test;

type Inner = {
    values: []int
}

type Outer = {
    inner: *Inner
}

clear(box: *Outer) {
    for i in 0..len(box.inner.values) box.inner.values[i] = 0
}

main(): int {
    inner: *Inner = new Inner { values: [1, 2, 3] };
    box: *Outer = new Outer { inner: inner };
    clear(box);
    box.inner.values[2]
}

//% test: run
//% stdout: ""
//% exit: 0
