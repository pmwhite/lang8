tag bounds_test;

import "../../stdlib/print.l8";

make(n: int): []int@new {
    new int[n](0)
}

main(): int {
    a: []int = make(3);
    a[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
