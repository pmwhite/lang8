tag bounds_test;

read_item(choice: int): int {
    a: []int = [7];
    result: int = match choice {
        0 -> {
            a = new int[0](0);
            1
        }
        _ -> 2
    };
    a[0] + result
}

main(): int {
    read_item(1)
}

