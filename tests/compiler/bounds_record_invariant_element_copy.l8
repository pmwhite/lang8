tag bounds_test;

import "../../stdlib/print.l8";

type Cell = {
    value: int
}

type Bag = {
    cells: []Cell;
    count: int
} invariant (0 <= count && count <= len(cells))

append(b: *Bag) {
    i: int = b.count;
    if (i >= len(b.cells)) return;
    b.cells[i] = Cell { value: 7 };
    b.count = i + 1
}

main(): int {
    b: *Bag = new Bag { cells: new Cell[2](Cell { value: 0 }), count: 0 };
    first: int = b.count;
    append(b);
    b.count = first;
    append(b);
    b.cells[0].value
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
