tag example;

/* wrap's @new is the immortal heap here; a stack address does not outlive it. */
type Box = {
    p: *int
}

wrap(p: *int@new): *Box@new {
    new Box { p: p }
}

main(): int {
    x: int = 1;
    wrap(&x);
    0
}

//% test: compile-fail
//% error-contains: "address of local cannot escape"
