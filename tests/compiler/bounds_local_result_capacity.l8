tag bounds_test;

import "../../stdlib/print.l8";

count(a: []int): int ensures (returned <= len(a)) {
    len(a)
}

copy(
    dst: []int,
    doff: int,
    src: []int,
    soff: int,
    n: int
) {
    for i in 0..n dst[doff + i] = src[soff + i]
}

relay(dst: []int) {
    src: []int = new int[4](9);
    n: int = count(src);
    if (n < 0) return;
    copy(dst, 0, src, 0, n)
}

main(): int {
    dst: []int = new int[4](0);
    relay(dst);
    dst[3]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
