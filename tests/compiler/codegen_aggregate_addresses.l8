tag example;

type Pair = {
    a: int;
    b: int
}

type Holder = {
    pair: Pair
}

order: int = 0;

source(): Pair {
    order = order * 10 + 1;
    Pair { a: 7, b: 11 }
}

destination(p: *Pair): *Pair@p {
    order = order * 10 + 2;
    p
}

sum(p: Pair): int {
    p.a + p.b
}

main(): int {
    original: Pair = Pair { a: 3, b: 5 };
    local: Pair = original;
    holder: Holder = Holder { pair: original };
    hp: *Holder = &holder;
    values: []Pair = new Pair[3](original);
    for i in 0..3 {
        values[i] = local;
        if (sum(values[i]) != 8) return 1
    }
    hp.pair = values[1];
    if (sum(hp.pair = source()) != 18) return 2;
    if (hp.pair.a != 7 || hp.pair.b != 11) return 3;
    local = hp.pair;
    p: *Pair = &local;
    p.* = original;
    if (sum(local) != 8) return 4;
    order = 0;
    destination(p).* = source();
    if (order != 12 || sum(local) != 18) return 5;
    if (sum(original) != 8) return 6;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
