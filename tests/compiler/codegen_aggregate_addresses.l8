tag example;

import "../../stdlib/print.l8";

type Pair = {
    a: int;
    b: int
}

type Holder = {
    pair: Pair
}

order: int = 0;

source(): Pair {
    order = order * 10 + 1;
    Pair { a: 7, b: 11 }
}

destination(p: *Pair): *Pair@p {
    order = order * 10 + 2;
    p
}

sum(p: Pair): int {
    p.a + p.b
}

aa_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "aggregate copies through locals, fields, elements and pointers" {
    original: Pair = Pair { a: 3, b: 5 };
    local: Pair = original;
    holder: Holder = Holder { pair: original };
    hp: *Holder = &holder;
    values: []Pair = new Pair[3](original);
    for i in 0..3 {
        values[i] = local;
        aa_show("sum(values[i])", sum(values[i]))
    }
    expect {|
        sum(values[i]): 8
        sum(values[i]): 8
        sum(values[i]): 8
    |}
    hp.pair = values[1];
    // The value of an assignment is the stored aggregate.
    aa_show("sum(hp.pair = source())", sum(hp.pair = source()));
    aa_show("hp.pair.a", hp.pair.a);
    aa_show("hp.pair.b", hp.pair.b);
    expect {|
        sum(hp.pair = source()): 18
        hp.pair.a: 7
        hp.pair.b: 11
    |}
    local = hp.pair;
    p: *Pair = &local;
    p.* = original;
    aa_show("sum(local)", sum(local));
    expect {|
        sum(local): 8
    |}
    // The destination address is evaluated before the stored value.
    order = 0;
    destination(p).* = source();
    aa_show("order", order);
    aa_show("sum(local)", sum(local));
    aa_show("sum(original)", sum(original));
    expect {|
        order: 12
        sum(local): 18
        sum(original): 8
    |}
}
