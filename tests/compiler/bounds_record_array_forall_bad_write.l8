tag bounds_test;

type Bag = {
    table: []int
} invariant (forall entry in table (0 <= entry && entry < 4))

main(): int {
    b: *Bag = new Bag { table: new int[2](0) };
    b.table[0] = 4;
    0
}

/* expect compile {|
error: bounds_record_array_forall_bad_write.l8:1:1: type invariant is not proved
|} */
