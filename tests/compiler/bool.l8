tag example;

import "../../programs/stdlib/write.l8";

putchar(c: i8) {
    std::write_byte(1, &c)
}

main(): int {
    t: bool = true;
    f: bool = false;
    if (t) putchar('T');
    if (f) putchar('N');
    if (t == true) putchar('Y');
    n: int = t as int;
    if (n == 1) putchar('1');
    b: bool = 0 trunc bool;
    if (!b) putchar('0');
    putchar('\n');
    0
}

//% test: run
//% stdout: "TY10\n"
//% exit: 0
//% bootstrap: true
