tag match_dispatch_test;

type Choice =
    | 63 Last { value: int }
    | 0 Zero { ignored: int }
    | 15 Middle { value: int }
    | 2 Two
    | 128 Far
    | 7 Seven
    | 31 ThirtyOne

type Signed =
    | -9 Negative
    | -1 MinusOne
    | 0 Zero
    | 2 Two
    | 9 Positive

type Wide =
    | -9223372036854775807 Low
    | -2 Negative
    | 0 Zero
    | 2 Two
    | 9223372036854775807 High

pick(c: Choice): int {
    match c {
        Middle k -> k.value;
        Two -> 2;
        Last k -> k.value;
        Zero _ -> 0;
        Far -> 128;
        ThirtyOne -> 31;
        Seven -> 7
    }
}

partial(c: Choice): int {
    match c {
        Last k -> k.value;
        Far -> 128;
        Two -> 2;
        Middle k -> k.value;
        _ -> -1
    }
}

signed_pick(s: Signed): int {
    match s {
        Positive -> 9;
        Two -> 2;
        MinusOne -> -1;
        Zero -> 0;
        Negative -> -9
    }
}

wide_pick(s: Wide): int {
    match s {
        Low -> -10;
        Negative -> -2;
        Zero -> 0;
        Two -> 2;
        High -> 10
    }
}

snapshot(p: *Choice): int {
    match p.* {
        Last k -> {
            p.* = Choice.Last { value: 99 };
            k.value
        }
        _ -> 0
    }
}

main(): int {
    if (pick(Choice.Last { value: 63 }) != 63) return 1;
    if (pick(Choice.Zero { ignored: 91 }) != 0) return 2;
    if (pick(Choice.Middle { value: 15 }) != 15) return 3;
    if (pick(Choice.Two) != 2 || pick(Choice.Far) != 128) return 4;
    if (pick(Choice.Seven) != 7 || pick(Choice.ThirtyOne) != 31) return 5;
    if (partial(Choice.Seven) != -1 || partial(Choice.Zero { ignored: 9 }) != -1) return 6;
    if (partial(Choice.Last { value: 4 }) != 4 || partial(Choice.Far) != 128) return 7;
    if (signed_pick(Signed.Negative) != -9 || signed_pick(Signed.Positive) != 9) return 8;
    if (signed_pick(Signed.MinusOne) != -1 || signed_pick(Signed.Zero) != 0 || signed_pick(Signed.Two) != 2) return 9;
    if (wide_pick(Wide.Low) != -10 || wide_pick(Wide.High) != 10) return 10;
    if (wide_pick(Wide.Negative) != -2 || wide_pick(Wide.Zero) != 0 || wide_pick(Wide.Two) != 2) return 11;
    original: Choice = Choice.Last { value: 23 };
    if (snapshot(&original) != 23 || pick(original) != 99) return 12;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
