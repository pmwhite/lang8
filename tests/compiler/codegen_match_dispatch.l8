tag match_dispatch_test;

import "../../stdlib/print.l8";

type Choice =
    | 63 Last { value: int }
    | 0 Zero { ignored: int }
    | 15 Middle { value: int }
    | 2 Two
    | 128 Far
    | 7 Seven
    | 31 ThirtyOne

type Signed =
    | -9 Negative
    | -1 MinusOne
    | 0 Zero
    | 2 Two
    | 9 Positive

type Wide =
    | -9223372036854775807 Low
    | -2 Negative
    | 0 Zero
    | 2 Two
    | 9223372036854775807 High

pick(c: Choice): int {
    match c {
        Middle k -> k.value;
        Two -> 2;
        Last k -> k.value;
        Zero _ -> 0;
        Far -> 128;
        ThirtyOne -> 31;
        Seven -> 7
    }
}

partial(c: Choice): int {
    match c {
        Last k -> k.value;
        Far -> 128;
        Two -> 2;
        Middle k -> k.value;
        _ -> -1
    }
}

signed_pick(s: Signed): int {
    match s {
        Positive -> 9;
        Two -> 2;
        MinusOne -> -1;
        Zero -> 0;
        Negative -> -9
    }
}

wide_pick(s: Wide): int {
    match s {
        Low -> -10;
        Negative -> -2;
        Zero -> 0;
        Two -> 2;
        High -> 10
    }
}

snapshot(p: *Choice): int {
    match p.* {
        Last k -> {
            p.* = Choice.Last { value: 99 };
            k.value
        }
        _ -> 0
    }
}

dispatch_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "a match over sparse tags" {
    dispatch_show("pick(Last { value: 63 })", pick(Choice.Last { value: 63 }));
    dispatch_show("pick(Zero { ignored: 91 })", pick(Choice.Zero { ignored: 91 }));
    dispatch_show("pick(Middle { value: 15 })", pick(Choice.Middle { value: 15 }));
    dispatch_show("pick(Two)", pick(Choice.Two));
    dispatch_show("pick(Far)", pick(Choice.Far));
    dispatch_show("pick(Seven)", pick(Choice.Seven));
    dispatch_show("pick(ThirtyOne)", pick(Choice.ThirtyOne));
    expect {|
        pick(Last { value: 63 }): 63
        pick(Zero { ignored: 91 }): 0
        pick(Middle { value: 15 }): 15
        pick(Two): 2
        pick(Far): 128
        pick(Seven): 7
        pick(ThirtyOne): 31
    |}
}

test "a match with a wildcard" {
    dispatch_show("partial(Seven)", partial(Choice.Seven));
    dispatch_show("partial(Zero { ignored: 9 })", partial(Choice.Zero { ignored: 9 }));
    dispatch_show("partial(Last { value: 4 })", partial(Choice.Last { value: 4 }));
    dispatch_show("partial(Far)", partial(Choice.Far));
    expect {|
        partial(Seven): -1
        partial(Zero { ignored: 9 }): -1
        partial(Last { value: 4 }): 4
        partial(Far): 128
    |}
}

test "a match over negative tags" {
    dispatch_show("signed_pick(Negative)", signed_pick(Signed.Negative));
    dispatch_show("signed_pick(MinusOne)", signed_pick(Signed.MinusOne));
    dispatch_show("signed_pick(Zero)", signed_pick(Signed.Zero));
    dispatch_show("signed_pick(Two)", signed_pick(Signed.Two));
    dispatch_show("signed_pick(Positive)", signed_pick(Signed.Positive));
    expect {|
        signed_pick(Negative): -9
        signed_pick(MinusOne): -1
        signed_pick(Zero): 0
        signed_pick(Two): 2
        signed_pick(Positive): 9
    |}
}

test "a match over tags at the ends of the int range" {
    dispatch_show("wide_pick(Low)", wide_pick(Wide.Low));
    dispatch_show("wide_pick(Negative)", wide_pick(Wide.Negative));
    dispatch_show("wide_pick(Zero)", wide_pick(Wide.Zero));
    dispatch_show("wide_pick(Two)", wide_pick(Wide.Two));
    dispatch_show("wide_pick(High)", wide_pick(Wide.High));
    expect {|
        wide_pick(Low): -10
        wide_pick(Negative): -2
        wide_pick(Zero): 0
        wide_pick(Two): 2
        wide_pick(High): 10
    |}
}

test "a match binds the payload before the arm overwrites it" {
    original: Choice = Choice.Last { value: 23 };
    dispatch_show("snapshot(&original)", snapshot(&original));
    expect {|
        snapshot(&original): 23
    |}
    dispatch_show("pick(original)", pick(original));
    expect {|
        pick(original): 99
    |}
}
