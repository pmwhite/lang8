tag bounds_test;

import "../../stdlib/print.l8";

same(a: []i8, b: []i8): bool {
    i: int = 0;
    while (true) {
        ae: bool = i >= len(a) || a[i] == 0i8;
        be: bool = i >= len(b) || b[i] == 0i8;
        if (ae || be) return ae && be;
        if (a[i] != b[i]) return false;
        i = i + 1
    }
}

main(): int {
    if (!same("abc", "abc")) return 1;
    if (same("abc", "abd")) return 2;
    if (same("abc", "ab")) return 3;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
