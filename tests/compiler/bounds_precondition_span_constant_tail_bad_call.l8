tag bounds_test;

read_tail(a: []int, offset: int): int requires (0 <= offset && offset <= len(a) && 1 <= len(a) - offset) {
    a[offset]
}

main(): int {
    a: []int = [3, 7];
    read_tail(a, len(a))
}

/* expect compile {|
error: bounds_precondition_span_constant_tail_bad_call.l8:9:5: call does not prove function precondition
|} */
