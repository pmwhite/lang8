tag bounds_test;

type Span = {
    first: int;
    last: int
}

type CopiedSpan = {
    left: Span;
    right: Span
} invariant (left.first <= right.first && right.last <= left.last)

copy(span: Span): int {
    pair: CopiedSpan = CopiedSpan { left: span, right: span };
    pair.right.last
}

main(): int {
    copy(Span { first: 3, last: 3 })
}

//% test: run
//% stdout: ""
//% exit: 3
