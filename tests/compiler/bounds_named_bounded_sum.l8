tag bounds_test;

import "../../stdlib/print.l8";

make(n: int): []int@new ensures (n <= len(returned)) {
    new int[n](0)
}

fill(start: int, count: int): int {
    if (start < 0 || count < 0 || count > 100 || start > 100 - count) return 0;
    end: int = start + count;
    data: []int = make(end);
    for i in 0..count data[start + i] = i;
    if (end == 0) return 0;
    data[end - 1]
}

main(): int {
    fill(1, 3)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
