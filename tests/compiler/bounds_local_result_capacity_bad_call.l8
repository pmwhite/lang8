tag bounds_test;

count(a: []int): int ensures (returned <= len(a)) {
    len(a)
}

copy(
    dst: []int,
    doff: int,
    src: []int,
    soff: int,
    n: int
) {
    for i in 0..n dst[doff + i] = src[soff + i]
}

relay(dst: []int) {
    src: []int = new int[4](9);
    n: int = count(src);
    if (n < 0) return;
    copy(dst, 0, src, 0, n)
}

main(): int {
    dst: []int = new int[3](0);
    relay(dst);
    0
}

//% test: compile-fail
//% error-contains: "call does not prove inferred array bounds requirement"
