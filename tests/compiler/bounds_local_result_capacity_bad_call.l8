tag bounds_test;

count(a: []int): int ensures (returned <= len(a)) {
    len(a)
}

copy(
    dst: []int,
    doff: int,
    src: []int,
    soff: int,
    n: int
) {
    for i in 0..n dst[doff + i] = src[soff + i]
}

relay(dst: []int) {
    src: []int = new int[4](9);
    n: int = count(src);
    if (n < 0) return;
    copy(dst, 0, src, 0, n)
}

main(): int {
    dst: []int = new int[3](0);
    relay(dst);
    0
}

/* expect compile {|
error: bounds_local_result_capacity_bad_call.l8:26:5: call does not prove inferred array bounds requirement for relay 4 <= len(dst)
|} */
