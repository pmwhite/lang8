tag example;

exception Hold {
    value: *int
}

main() raises Hold: int {
    raise Hold { value: new int[1](1) }
}

/* expect compile {|
noregion_payload.l8:8:25

    raise Hold { value: new int[1](1) }
                        ^^^^^^^^^^^^^

main puts this allocation in an exception payload, which can outlive its
region.

For retained storage, declare main and its callers as noregion
(unavailable inside regions), or keep temporary data local instead of in
the exception payload.

|} */
