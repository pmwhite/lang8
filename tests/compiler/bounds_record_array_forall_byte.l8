tag bounds_test;

import "../../stdlib/print.l8";

type Bytes = {
    values: []i8;
    cells: []int
} invariant (len(values) == 2 && len(cells) == 129, forall value in values (value <= 128i8))

write_value(bytes: *Bytes, value: int) requires (0 <= value && value <= 128) {
    narrowed: i8 = value trunc i8;
    bytes.values[0] = narrowed
}

read_value(bytes: *Bytes): int {
    widened: int = bytes.values[0] as int;
    bytes.cells[widened]
}

main(): int {
    bytes: *Bytes = new Bytes { values: new i8[2](0i8), cells: new int[129](0) };
    write_value(bytes, 128);
    read_value(bytes)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
