tag bounds_test;

type Buffer = {
    data: []int;
    count: int
}

sum_prefix(b: *Buffer@new): int {
    total: int = 0;
    for i in 0..b.count {
        total = total + b.data[i];
        b.data = new int[0](0)
    }
    total
}

main(): int {
    b: *Buffer = new Buffer { data: [3, 5], count: 2 };
    if (b.count > len(b.data)) return 1;
    sum_prefix(b)
}

//% test: compile-fail
//% error-contains: "unproved array access; use ![] for a runtime check"
