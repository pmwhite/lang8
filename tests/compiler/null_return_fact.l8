tag example;

import "../../stdlib/print.l8";

identity(p: ?*int): *int@p {
    return p
}

main(): int {
    x: int = 7;
    identity(&x).*
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}

/* expect compile {|
warning: null_return_fact.l8:6:5: unnecessary return in identity
|} */
