tag example;

import "../../stdlib/print.l8";

identity(p: ?*int): *int@p {
    return p
}

test "identity returns a non-null pointer for an address" {
    x: int = 7;
    value: int = identity(&x).*;
    std::write(1, "identity(&x).*: ");
    std::print_int(value);
    expect {|
        identity(&x).*: 7
    |}
}

/* expect compile {|
warning: null_return_fact.l8:6:5: unnecessary return in identity
|} */
