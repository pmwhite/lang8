tag bounds_test;

type Span = {
    start: int;
    end: int
} invariant (0 <= start && start <= end && end <= 2)

type Pair = {
    start: int;
    end: int
} invariant (start <= end)

make(base: int, span: *Span): Pair {
    Pair { start: base + span.start, end: base + span.end }
}

main(): int {
    span: *Span = new Span { start: 0, end: 1 };
    pair: Pair = make(9223372036854775807, span);
    pair.start
}

/* expect compile {|
error: bounds_record_shared_sum_overflow.l8:14:5: record invariant is not proved after construction or field assignment
|} */
