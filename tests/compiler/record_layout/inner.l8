tag record_layout;

use_tag std;

import "../../../stdlib/print.l8";

import "outer.l8";

// Starting here loads Outer before Inner. Starting at outer.l8 reverses it.
type Inner = {
    a: int;
    b: int;
    c: int
}

make_outer(): Outer {
    Outer { inner: Inner { a: 11, b: 22, c: 33 }, tail: 44 }
}

test "cyclic imports preserve nested record layout and returns" {
    print_int(sizeof(Outer));
    value: Outer = make_outer();
    print_int(value.inner.a);
    print_int(value.inner.b);
    print_int(value.inner.c);
    print_int(value.tail);
    value.inner.b = 55;
    print_int(value.inner.b);
    print_int(value.tail);
    expect {|
        32
        11
        22
        33
        44
        55
        44
    |}
}
