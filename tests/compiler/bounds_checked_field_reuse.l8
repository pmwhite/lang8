exception IndexOutOfBounds;

tag bounds_test;

type Box = {
    data: []int
}

read_at(box: *Box, i: int) raises IndexOutOfBounds: int {
    if (i < 0 || i >= len(box.data)) raise IndexOutOfBounds;
    box.data[i]
}

main() raises IndexOutOfBounds: int {
    box: *Box = new Box { data: [4, 7] };
    read_at(box, 1)
}

//% test: run
//% stdout: ""
//% exit: 7
