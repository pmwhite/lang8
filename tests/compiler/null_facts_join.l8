tag example;

import "../../stdlib/print.l8";

// p may be null after the first if; q is non-null after either branch of the
// second, so reading through it needs no check.
join_read(argc: int): int {
    x: int = 7;
    p: ?*int = &x;
    if (argc > 1) p = null;
    q: ?*int = null;
    if (p == null) q = &x else q = p;
    q.*
}

test "a pointer set non-null on both branches can be read" {
    std::write(1, "p kept: ");
    std::print_int(join_read(1));
    expect {|
        p kept: 7
    |}
    std::write(1, "p cleared: ");
    std::print_int(join_read(2));
    expect {|
        p cleared: 7
    |}
}
