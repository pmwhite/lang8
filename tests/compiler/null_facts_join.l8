tag example;

import "../../stdlib/print.l8";

main(argc: int, _argv: []str): int {
    x: int = 7;
    p: ?*int = &x;
    if (argc > 1) p = null;
    q: ?*int = null;
    if (p == null) q = &x else q = p;
    q.*
}

// The runtime passes the program path as argv[0].
test "main" {
    argv: []str = new str[1]("program");
    status: int = main(1, argv);
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
