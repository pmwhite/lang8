tag example;

import "../../programs/stdlib/write.l8";

type Flags = {
    enabled: int;
    count: int
}

choose(on: int): int {
    result: int = 0;
    if (on != 0) result = 1;
    result
}

main(): int {
    flags: Flags = Flags { enabled: 1, count: 2 };
    active: int = choose(flags.enabled);
    if (active != 0) std::write(1, "Y\n");
    flags.count
}
