tag bounds_test;

fill(pixels: []i8) {
    for z in 0..512 {
        for x in 0..512 pixels[z * 512 + x] = 1i8
    }
}

main(): int {
    pixels: []i8 = new i8[8](0i8);
    fill(pixels);
    0
}

/* expect compile {|
error: bounds_flat_grid_inferred_short.l8:11:5: call does not prove inferred array bounds requirement for fill 262143 < len(pixels)
|} */
