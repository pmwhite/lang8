tag bounds_test;

fill(pixels: []i8) {
    for z in 0..512 {
        for x in 0..512 pixels[z * 512 + x] = 1i8
    }
}

main(): int {
    pixels: []i8 = new i8[8](0i8);
    fill(pixels);
    0
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "call does not prove inferred array bounds requirement"
