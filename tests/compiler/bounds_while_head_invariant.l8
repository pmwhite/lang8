tag bounds_test;

import "../../stdlib/print.l8";

scan(data: []int, last: int): int requires (0 <= last && last < len(data)) {
    i: int = 0;
    while (data[i] != 0 && i < last) invariant (0 <= i && i <= last) i = i + 1;
    i
}

main(): int {
    data: []int = [1, 1, 0];
    scan(data, 2)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 2
    |}
}
