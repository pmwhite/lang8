tag bounds_test;

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer): int {
    b.data[b.cursor]
}

main(): int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    get(b)
}

//% test: compile-fail
//% verify-bounds: true
//% error-contains: "call does not prove inferred array bounds requirement"
