tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    cursor: int
}

get(b: *Buffer): int {
    b.data[b.cursor]
}

main(): int {
    b: *Buffer = new Buffer { data: [7], cursor: 0 };
    get(b)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
