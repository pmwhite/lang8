tag bounds_test;

import "../../stdlib/print.l8";

lookup(a: []int, i: int): int requires (0 <= i && 0 < len(a)) {
    slot: int = i % len(a);
    a[slot]
}

main(): int {
    a: []int = [2, 3, 5, 7];
    lookup(a, 6)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 5
    |}
}
