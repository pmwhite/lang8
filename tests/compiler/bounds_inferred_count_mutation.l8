tag bounds_test;

sum_prefix(a: []int, count: int): int {
    total: int = 0;
    for i in 0..count {
        total = total + a[i];
        a = new int[0](0)
    }
    total
}

main(): int {
    a: []int = [3, 5];
    sum_prefix(a, 2)
}

//% test: compile-fail
//% error-contains: "unproved array access requires raises IndexOutOfBounds"
