exception IndexOutOfBounds;

tag bounds_test;

bad(a: []int, i: int) raises IndexOutOfBounds: int {
    tail: int = a[i + 1];
    a[i] + tail
}

main() raises IndexOutOfBounds: int {
    a: []int = [4];
    bad(a, -1)
}

