tag bounds_test;

import "../../stdlib/print.l8";

sum_middle(a: []int, skip_first: bool): int {
    start: int = 0;
    if (skip_first) start = 2;
    if (len(a) < start + 2) return 0;
    total: int = 0;
    for i in start + 1..len(a) - 1 total = total + a[i];
    total
}

main(): int {
    a: []int = [1, 2, 3, 4, 5];
    sum_middle(a, false) + sum_middle(a, true)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 13
    |}
}
