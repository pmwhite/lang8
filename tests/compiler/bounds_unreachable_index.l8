tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    a: []int = [7];
    if (false) return a[0];
    if (false) return a[100];
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
