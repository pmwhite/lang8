tag bounds_test;

main(): int {
    a: [2]i8 = ['A', 'B'];
    s: str = "AB";
    i: int = 1;
    check_index(a, i);
    check_index(s, i);
    if (a[i] != s[i]) return 1;
    a[i] as int
}

