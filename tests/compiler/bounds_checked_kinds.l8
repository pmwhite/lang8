tag bounds_test;

main() raises IndexOutOfBounds: int {
    a: [2]i8 = ['A', 'B'];
    s: str = "AB";
    i: int = 1;
    if (i < 0 || i >= len(a)) raise IndexOutOfBounds;
    if (i < 0 || i >= len(s)) raise IndexOutOfBounds;
    if (a[i] != s[i]) return 1;
    a[i] as int
}

//% test: run
//% stdout: ""
//% exit: 66
