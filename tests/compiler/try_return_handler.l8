tag example;

import "../../stdlib/print.l8";

exception Missing {
    code: int
}

exception Later {
    code: int
}

find(present: bool) raises Missing: int {
    if (!present) raise Missing { code: 1 };
    7
}

// Returns from inside its try: the try's handler must be gone after, or
// the next exception would be sent to a frame that no longer exists.
found_or_zero(present: bool): int {
    try {
        value: int = find(present);
        if (value > 0) return value;
        value + 1
    } with Missing _error -> {
        0
    }
}

fail_later() raises Later {
    raise Later { code: 2 }
}

test "a return from inside a try lets its handler go" {
    try {
        std::print_int(found_or_zero(true));
        std::print_int(found_or_zero(false));
        fail_later()
    } with Later error -> {
        std::print_int(error.code)
    }
    expect {|
        7
        0
        2
    |}
}
