tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

adjust(a: []int, n: int, noise: int): int requires (0 <= n && n <= len(a)) {
    if (noise == 1000) return n;
    if (n >= len(a)) return n;
    a[n] = 1;
    n + 1
}

main(): int {
    b: *Buffer = new Buffer { data: new int[4](0), used: 0 };
    noise: int = 0;
    first: int = adjust(b.data, b.used, noise);
    b.used = first;
    noise = 1000;
    second: int = adjust(b.data, b.used, noise);
    b.used = second;
    third: int = adjust(b.data, b.used, noise);
    b.used = third;
    b.used
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 1
    |}
}
