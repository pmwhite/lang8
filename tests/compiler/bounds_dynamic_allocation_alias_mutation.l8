tag bounds_test;

bump(n: *int) {
    n.* = n.* + 1
}

main(): int {
    n: int = 3;
    a: []int = new int[n](0);
    bump(&n);
    a[n - 1]
}

/* expect compile {|
error: bounds_dynamic_allocation_alias_mutation.l8:11:6: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= (n - 1) && (n - 1) < len(a))
|} */
