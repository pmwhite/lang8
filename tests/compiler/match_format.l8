tag example;

type Choice =
    | Value { data: int }
    | Empty

value(c: Choice): int {
    match c {
        Value v -> v.data;
        Empty -> 0
    }
}

early(n: int): int {
    match n {
        1 -> return 9;
        _ -> return 10
    }
    0
}

scoped(c: Choice): int {
    match c {
        Value v -> {
            v: int = 7
        }
        Empty -> { }
    }
    0
}

commented(n: int): int {
    match n {
        1 -> {
            // Keep this comment with its block.
            3
        }
        _ -> 4
    }
}

main(): int {
    c: Choice = Choice.Value { data: 5 };
    if (value(c) != 5 || early(1) != 9 || early(2) != 10 || scoped(c) != 0 || commented(1) != 3 || commented(2) != 4) return 1;
    0
}

