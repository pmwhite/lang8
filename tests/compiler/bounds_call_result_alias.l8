tag bounds_test;

put2(dst: []int, i: int, v: int): int requires (0 <= i && i <= len(dst) - 2) ensures (returned == i + 2) {
    dst[i] = v;
    dst[i + 1] = v;
    i + 2
}

// In i = put2(dst, i, v), the guarantee returned == i + 2 is about the old i.
// Read as the new one, it contradicted itself and proved the second call.
fill(dst: []int): int requires (8 <= len(dst)) {
    i: int = 6;
    i = put2(dst, i, 0);
    i = put2(dst, i, 1);
    i
}

main(): int {
    d: []int = new int[8](0);
    fill(d)
}

/* expect compile {|
error: bounds_call_result_alias.l8:14:9: call does not prove function precondition
|} */
