tag bounds_test;

import "../../stdlib/print.l8";

read_at(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

forward(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    read_at(a, i)
}

main(): int {
    a: []int = [7, 9];
    forward(a, 1)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
