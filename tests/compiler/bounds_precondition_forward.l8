tag bounds_test;

read_at(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

forward(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    read_at(a, i)
}

main(): int {
    a: []int = [7, 9];
    forward(a, 1)
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 9
