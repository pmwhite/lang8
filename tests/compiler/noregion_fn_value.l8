tag example;

use_tag std;

import "../../stdlib/print.l8";

/* A function stored as a noregion fn value may say noregion, though it
needs none itself: another stored the same way may need it. */
type Host = {
    load: fn(t: int) noregion: bool
}

none(_t: int) noregion: bool {
    false
}

kept: []int = new int[1](0);

remember(t: int) noregion: bool {
    kept = new int[t](0);
    true
}

host: Host = Host { load: &none };

ask(t: int) noregion: bool {
    load: fn(t: int) noregion: bool = host.load;
    load(t)
}

test "noregion function values" {
    print_bool(ask(3));
    host = Host { load: &remember };
    print_bool(ask(3));
    print_int(len(kept));
    expect {|
        false
        true
        3
    |}
}
