tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    cells: []int = new int[12](1);
    total: int = 0;
    for row in 0..3 {
        for col in 0..4 total = total + cells[row * 4 + col]
    }
    total
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 12
    |}
}
