tag bounds_test;

fill(n: int): int {
    if (n < 2) return 0;
    a: []int = new int[n - 2](0);
    n = n + 1;
    for i in 2..n a[i - 2] = i;
    0
}

main(): int {
    fill(5)
}

/* expect compile {|
error: bounds_dynamic_allocation_offset_changed.l8:7:20: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= (i - 2) && (i - 2) < len(a))
|} */
