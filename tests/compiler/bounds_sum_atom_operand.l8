tag bounds_test;

// The sum may be in bounds while neither operand is.
bad(dst: []int, to: int, f: int): int {
    if (to + f >= 0 && to + f < len(dst)) return dst[to];
    0
}

main(): int {
    d: []int = [1, 2];
    bad(d, 100, -99)
}

/* expect compile {|
error: bounds_sum_atom_operand.l8:11:5: array index not proved in bounds
|} */
