tag bounds_test;

copy(
    dst: []int,
    doff: int,
    src: []int,
    soff: int,
    n: int
) {
    for i in 0..n dst[doff + i] = src[soff + i]
}

relay(dst: []int, src: []int, n: int) {
    copy(dst, 2, src, 0, n)
}

main(): int {
    dst: []int = new int[5](0);
    src: []int = new int[3](7);
    relay(dst, src, 3);
    dst[4]
}

//% test: run
//% stdout: ""
//% exit: 7
