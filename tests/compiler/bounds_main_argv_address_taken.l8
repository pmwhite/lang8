tag bounds_test;

use_tag bounds_test;

main(argc: int, argv: []str): int {
    if (argc < 2) return 0;
    pointer: fn(argc: int, argv: []str): int = &main;
    if (argc == 2) return len(argv[1]);
    pointer(argc, argv)
}

//% test: compile-fail
//% error-contains: "main cannot require unproved array bounds at entry"
