tag bounds_test;

import "../../stdlib/print.l8";

fill(a: []int) {
    for i in 0..8 {
        for axis in 0..3 a[i * 3 + axis] = i * 3 + axis
    }
}

main(): int {
    a: []int = new int[24](0);
    fill(a);
    a[23]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 23
    |}
}
