tag example;

import "../../stdlib/print.l8";

type Cell = {
    value: int;
    byte: i8;
    signed: i32;
    unsigned: u32;
    flag: bool
}

fields(p: *Cell): int {
    for i in 0..10 {
        p.value = p.value + i;
        p.byte = 255i8;
        p.signed = -31i32;
        p.unsigned = 4294967295u32;
        p.flag = true;
        if (p.byte != 255i8 || p.signed != -31i32 || p.unsigned != 4294967295u32 || !p.flag) return -1
    }
    p.value
}

// Comparisons must read their operands in order, even when assigning to the
// same allocated local. Cover both branch conditions and boolean values.
comparisons(): int {
    x: int = 0;
    for i in 0..10 {
        x = i;
        first: bool = x < (x = x + 1);
        if (!first) return 1;
        if ((x = x + 1) != x) return 2;
        if (x < 0 || x >= 20 || x == 1000000000000) return 3;
        if (x != i + 2) return 4
    }
    0
}

test "narrow fields stored and read in a loop" {
    cell: Cell = Cell {
        value: 7,
        byte: 0i8,
        signed: 0i32,
        unsigned: 0u32,
        flag: false
    };
    result: int = fields(&cell);
    std::write(1, "fields(&cell): ");
    std::print_int(result);
    expect {|
        fields(&cell): 52
    |}
    std::write(1, "cell: value ");
    std::write_int(1, cell.value);
    std::write(1, ", byte ");
    std::write_int(1, cell.byte as int);
    std::write(1, ", signed ");
    std::write_int(1, cell.signed as int);
    std::write(1, ", unsigned ");
    std::write_int(1, cell.unsigned as int);
    std::write(1, ", flag ");
    std::print_bool(cell.flag);
    expect {|
        cell: value 52, byte 255, signed -31, unsigned 4294967295, flag true
    |}
}

test "comparisons read operands in order" {
    // 0 means every check passed; otherwise the number of the failed check.
    std::write(1, "comparisons(): ");
    std::print_int(comparisons());
    expect {|
        comparisons(): 0
    |}
}
