tag example;

type Cell = {
    value: int;
    byte: i8;
    signed: i32;
    unsigned: u32;
    flag: bool
}

fields(p: *Cell): int {
    for i in 0..10 {
        p.value = p.value + i;
        p.byte = 255i8;
        p.signed = -31i32;
        p.unsigned = 4294967295u32;
        p.flag = true;
        if (p.byte != 255i8 || p.signed != -31i32 || p.unsigned != 4294967295u32 || !p.flag) return -1
    }
    p.value
}

// Comparisons must read their operands in order, even when assigning to the
// same allocated local. Cover both branch conditions and boolean values.
comparisons(): int {
    x: int = 0;
    for i in 0..10 {
        x = i;
        first: bool = x < (x = x + 1);
        if (!first) return 1;
        if ((x = x + 1) != x) return 2;
        if (x < 0 || x >= 20 || x == 1000000000000) return 3;
        if (x != i + 2) return 4
    }
    0
}

main(): int {
    cell: Cell = Cell {
        value: 7,
        byte: 0i8,
        signed: 0i32,
        unsigned: 0u32,
        flag: false
    };
    if (fields(&cell) != 52) return 1;
    if (comparisons() != 0) return 2;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
