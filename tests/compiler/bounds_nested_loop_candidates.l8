tag bounds_test;

import "../../stdlib/print.l8";

sum_prefixes(data: []int): int {
    total: int = 0;
    for outer in 0..len(data) {
        for inner in 0..outer + 1 total = total + data[inner]
    }
    total
}

main(): int {
    sum_prefixes([2, 3, 5])
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 17
    |}
}
