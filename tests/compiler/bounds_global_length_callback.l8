tag bounds_test;

extern register_callback(f: fn(): int): int;

extern poll_events(): int;

buffer: []int = [4, 5];

empty: []int = new int[0](0);

shrink(): int {
    buffer = empty;
    0
}

// Once a function that assigns a global is passed to C, any extern call may
// run it.
last(): int {
    if (len(buffer) < 2) return 0;
    _events: int = poll_events();
    buffer[1]
}

main(): int {
    _registered: int = register_callback(&shrink);
    last()
}

/* expect compile {|
error: bounds_global_length_callback.l8:21:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 1 && 1 < len(buffer))
|} */
