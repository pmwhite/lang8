tag bounds_test;

import "../../stdlib/print.l8";

const CELLS: int = 4;

const DOUBLE_CELLS: int = CELLS * 2;

copied: int = DOUBLE_CELLS;

type Buffer = {
    data: []int
} invariant (len(data) == DOUBLE_CELLS)

main(): int {
    copied = copied + 1;
    b: *Buffer = new Buffer { data: new int[DOUBLE_CELLS](3) };
    total: int = 0;
    for i in 0..DOUBLE_CELLS total = total + b.data[i];
    if (b.data[CELLS] != 3) return 2;
    if (copied != 9) return 1;
    total
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 24
    |}
}
