tag bounds_test;

import "../../stdlib/print.l8";

const CELLS: int = 4;

const DOUBLE_CELLS: int = CELLS * 2;

copied: int = DOUBLE_CELLS;

type Buffer = {
    data: []int
}

test "a constant derived from a constant sizes globals and invariants" {
    std::write(1, "copied: ");
    std::print_int(copied);
    expect {|
        copied: 8
    |}
    copied = copied + 1;
    std::write(1, "copied + 1: ");
    std::print_int(copied);
    expect {|
        copied + 1: 9
    |}
    b: *Buffer = new Buffer { data: new int[DOUBLE_CELLS](3) };
    std::write(1, "len: ");
    std::print_int(len(b.data));
    std::write(1, "b.data[CELLS]: ");
    std::print_int(b.data[CELLS]);
    expect {|
        len: 8
        b.data[CELLS]: 3
    |}
    total: int = 0;
    for i in 0..DOUBLE_CELLS total = total + b.data[i];
    std::write(1, "total: ");
    std::print_int(total);
    expect {|
        total: 24
    |}
}
