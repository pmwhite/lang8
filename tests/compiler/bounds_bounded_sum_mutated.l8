tag bounds_test;

bad(a: []i8, i: int, w: []i8): i8 requires (0 <= i && i <= len(a)) {
    if (len(w) > len(a) - i) return 0i8;
    i = i + 1;
    for k in 0..len(w) return a[i + k];
    0i8
}

main(): int {
    a: []i8 = ['a'];
    bad(a, 0, "a") as int
}

//% test: compile-fail
//% error-contains: "unproved array access; use ![] for a runtime check"
