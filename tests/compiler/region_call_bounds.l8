tag example;

use_tag std;

import "../../stdlib/print.l8";

type Box = {
    n: int
}

type Hold = {
    item: *Box
}

retain(item: *Box@new): *Hold@new {
    new Hold { item: item }
}

inspect(item: *Box) raises IoError {
    region {
        hold: *Hold = retain(item);
        print_int(hold.item.n)
    }
}

test "scratch calls do not require caller allocation bounds" {
    region {
        inspect(new Box { n: 12 })
    }
    expect {|
        12
    |}
}
