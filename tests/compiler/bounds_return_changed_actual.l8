tag bounds_test;

type Holder = {
    data: []int
}

replace(a: []int, h: *Holder@new): int {
    if (len(a) == 0) return 0;
    h.data = new int[0](0);
    len(a) - 1
}

main(): int {
    h: *Holder = new Holder { data: new int[4](0) };
    i: int = replace(h.data, h);
    h.data[i]
}

//% test: compile-fail
//% error-contains: "unproved array access requires raises IndexOutOfBounds"
