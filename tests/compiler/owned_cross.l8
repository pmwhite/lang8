tag example;

type Box = {
    n: int
}

type Hold = {
    item: *Box
}

main(): int {
    box: owned *Hold = own {
        new Hold { item: new Box { n: 1 } }
    };
    other: owned *Box = own {
        new Box { n: 2 }
    };
    borrow box {
        borrow other {
            box.item = other
        }
    }
    drop box;
    drop other;
    0
}

/* expect compile {|
error: owned_cross.l8:20:17: arena pointer cannot escape in main
|} */
