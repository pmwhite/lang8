tag bounds_test;

import "../../stdlib/print.l8";

fetch(a: []int, repeat: bool): int requires (len(a) > 0) {
    value: int = 0;
    while (repeat) {
        value = a[0];
        repeat = false
    }
    value
}

main(): int {
    a: []int = [7];
    fetch(a, true)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
