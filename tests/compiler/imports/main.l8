tag example;

import "../../../stdlib/raw_write.l8";

import "a.l8";

import "./b.l8";

import "../../../stdlib/print.l8";

main(): int {
    raw::raw_write(1, "Hi\n");
    from_a() - 42
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        Hi
        main returned 0
    |}
}
