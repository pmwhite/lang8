tag example;

import "../../../stdlib/raw_write.l8";

import "a.l8";

import "./b.l8";

import "../../../stdlib/print.l8";

test "an imported raw_write" {
    raw::raw_write(1, "Hi\n");
    expect {|
        Hi
    |}
}

test "functions from files that import each other" {
    std::write(1, "from_a(): ");
    std::print_int(from_a());
    std::write(1, "from_b(): ");
    std::print_int(from_b());
    expect {|
        from_a(): 42
        from_b(): 42
    |}
}
