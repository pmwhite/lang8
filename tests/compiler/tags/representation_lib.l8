tag opaque_internal;

tag opaque_api
type OpaqueValue = tag opaque_internal {
    value: int
}

tag opaque_api
type OpaqueChoice = tag opaque_internal
    | Empty
    | Value { value: int }

tag opaque_api
make_opaque(value: int): OpaqueValue {
    OpaqueValue { value: value }
}

tag opaque_api
read_opaque(value: OpaqueValue): int {
    value.value
}

tag opaque_api
make_choice(): OpaqueChoice {
    OpaqueChoice.Value { value: 9 }
}

tag opaque_api
read_choice(choice: OpaqueChoice): int {
    match choice {
        Empty -> 0;
        Value value -> value.value
    }
}
