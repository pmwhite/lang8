tag representation_client;

use_tag opaque_api;

import "representation_lib.l8";

import "../../../stdlib/print.l8";

tag opaque_internal
read_with_representation_tag(): int {
    value: OpaqueValue = opaque_api::OpaqueValue { value: 13 };
    value.value
}

test "abstract values pass and copy through their API" {
    original: OpaqueValue = make_opaque(7);
    copy: OpaqueValue = original;
    values: []OpaqueValue = new OpaqueValue[2](copy);
    std::print_int(read_opaque(values[1]));
    std::print_int(read_choice(make_choice()));
    expect {|
        7
        9
    |}
}

test "qualified access deliberately selects the complete representation" {
    value: OpaqueValue = opaque_internal::OpaqueValue { value: 11 };
    std::print_int(value.opaque_internal::value);
    std::print_int(read_with_representation_tag());
    expect {|
        11
        13
    |}
}
