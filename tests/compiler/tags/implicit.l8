import "../../../stdlib/raw_write.l8";

import "lib.l8";

tag parser_alias;

import "../../../stdlib/print.l8";

main(): int {
    box: TagBox = TagBox { value: tag_count };
    if (box.value != 7) return 1;
    raw::raw_write(1, "implicit\n");
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        implicit
        main returned 0
    |}
}
