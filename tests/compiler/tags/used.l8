tag tag_test;

import "../../../stdlib/raw_write.l8";

import "lib.l8";

import "../../../stdlib/print.l8";

main(): int {
    box: TagBox = TagBox { value: tag_count };
    if (box.value != 7 || parser::tag_parse() != 17) return 1;
    raw::raw_write(1, "used\n");
    0
}

// A use activates either tag independently and applies to the whole file.
use_tag parser_alias, unused_tag;

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        used
        main returned 0
    |}
}
