tag tag_test;

import "../../../stdlib/raw_write.l8";

import "../../../stdlib/print.l8";

import "lib.l8";

tag parser_alias
tag_copy: TagBox = TagBox { value: tag_count };

main(): int {
    if (parser_alias::tag_copy.value != 7) return 1;
    raw::raw_write(1, "global\n");
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        global
        main returned 0
    |}
}
