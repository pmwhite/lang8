import "../../../stdlib/raw_write.l8";

import "../../../stdlib/print.l8";

tag app
main(): int {
    raw::raw_write(1, "declaration\n");
    0
}

test "main" {
    status: int = app::main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        declaration
        main returned 0
    |}
}
