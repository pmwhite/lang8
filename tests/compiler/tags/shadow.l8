tag tag_test;

import "../../../stdlib/raw_write.l8";

import "lib.l8";

import "../../../stdlib/print.l8";

main(): int {
    // A local may shadow a tagged global without bringing its tags into scope.
    tag_count: int = 3;
    TagBox: parser::TagBox = parser::TagBox { value: tag_count };
    if (TagBox.value != 3 || parser_alias::tag_count != 7) return 1;
    raw::raw_write(1, "shadow\n");
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        shadow
        main returned 0
    |}
}
