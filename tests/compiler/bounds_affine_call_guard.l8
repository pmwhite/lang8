tag bounds_test;

write_three(a: []int, i: int) {
    a[i] = 3;
    a[i + 1] = 5;
    a[i + 2] = 7
}

guarded(a: []int, i: int) {
    if (i >= 0 && i <= len(a) - 3) write_three(a, i)
}

main(): int {
    a: []int = new int[3](0);
    guarded(a, 0);
    a[2]
}

//% test: run
//% stdout: ""
//% exit: 7
