tag example;

mutate(bytes: []i8) {
    bytes[0] = 'x'
}

main(): int {
    s: str = "immutable";
    mutate(s);
    0
}

/* expect compile {|
strbytes.l8:9:12

    mutate(s);
           ^

s is immutable str; parameter bytes of mutate requires mutable []i8.

bytes(s) makes a separate mutable copy. For shared changes, pass a []i8
buffer; for read-only use, change the parameter to str.

|} */
