tag bounds_test;

make(n: int): []int@new ensures (n <= len(returned)) {
    new int[n](0)
}

main(): int {
    start: int = 1;
    count: int = 2;
    target: int = start + count;
    data: []int = make(target);
    start = 2;
    for i in 0..count data[start + i] = i;
    0
}

//% test: compile-fail
//% error-contains: "unproved array access"
