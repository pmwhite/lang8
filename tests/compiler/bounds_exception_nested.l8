tag bounds_test;

exception Retry;

exception Done;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

recover(a: []int, i: int): int {
    try {
        try {
            if (i < 0 || i >= len(a)) return 0;
            raise Retry
        } with Retry -> {
            raise Done
        }
    } with Done -> {
        return consume(a, i)
    }
}

main(): int {
    recover([8], 0)
}

//% test: run
//% stdout: ""
//% exit: 8
//% compiler-warnings: ["unnecessary return in recover"]
