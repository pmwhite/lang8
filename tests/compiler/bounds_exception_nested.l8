tag bounds_test;

import "../../stdlib/print.l8";

exception Retry;

exception Done;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

recover(a: []int, i: int): int {
    try {
        try {
            if (i < 0 || i >= len(a)) return 0;
            raise Retry
        } with Retry -> {
            raise Done
        }
    } with Done -> {
        return consume(a, i)
    }
}

main(): int {
    recover([8], 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 8
    |}
}

/* expect compile {|
warning: bounds_exception_nested.l8:22:9: unnecessary return in recover
|} */
