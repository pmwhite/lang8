tag example;

use_tag std;

import "../../stdlib/print.l8";

type Rec = {
    x: int;
    next: ?*Rec
}

type Holder = {
    p: ?*Rec;
    f: ?fn(n: int): int
}

twice(n: int): int {
    n * 2
}

// A field path (fields read from a local or a parameter) tested against
// null is narrowed as a variable is, until a call or a store.
first(h: *Holder): int {
    if (h.p != null) h.p.x else 0
}

called(h: *Holder): int {
    if (h.f != null) h.f(4) else 0
}

second(h: *Holder): int {
    if (h.p == null) return 0;
    if (h.p.next != null && h.p.next.x > 0) h.p.next.x else -1
}

test "field paths narrow" {
    b: Rec = Rec { x: 7, next: null };
    a: Rec = Rec { x: 5, next: &b };
    h: Holder = Holder { p: &a, f: &twice };
    print_int(first(&h));
    print_int(called(&h));
    print_int(second(&h));
    e: Holder = Holder { p: null, f: null };
    print_int(first(&e) + called(&e) + second(&e));
    expect {|
        5
        8
        7
        0
    |}
}
