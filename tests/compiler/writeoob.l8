tag example;

use_tag std;

import "../../stdlib/write.l8";

/* An invalid byte range is rejected before the program runs. */
main() raises IoError: int {
    s: []i8 = new i8[2](0i8);
    if (write_some(1, s, 0, 3) >= 0) return 1;
    0
}

/* expect compile {|
error: writeoob.l8:10:9: call does not prove function precondition
|} */
