tag example;

use_tag std;

import "../../stdlib/write.l8";

/* An invalid byte range raises without touching the buffer. */
main() raises IoError: int {
    s: []i8 = new i8[2](0i8);
    try {
        if (write_some(1, s, 0, 3) >= 0) return 1
    } with InvalidRange e -> {
        if (e.offset != 0 || e.count != 3 || e.length != 2) return 2
    }
    0
}

//% test: run
//% stdout: ""
//% exit: 0
