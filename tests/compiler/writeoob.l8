tag example;

use_tag std;

import "../../stdlib/print.l8";

test "an invalid byte range is rejected before the write" {
    s: []i8 = new i8[2](0i8);
    try {
        written: int = write_some(1, s, 0, 3);
        print_int(written)
    } with IoError e -> {
        write(1, "IoError ");
        print_int(e.code)
    }
    expect {|
        IoError 22
    |}
}
