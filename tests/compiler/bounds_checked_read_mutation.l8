exception IndexOutOfBounds;

tag bounds_test;

consume(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    a[i]
}

read_twice(a: []int, i: int) raises IndexOutOfBounds: int {
    first: int = a[i];
    i = i + 1;
    first + consume(a, i)
}

main() raises IndexOutOfBounds: int {
    read_twice([6], 0)
}

/* expect compile {|
error: bounds_checked_read_mutation.l8:12:13: call does not prove function precondition
|} */
