tag bounds_test;

import "../../stdlib/print.l8";

pick(a: []int, i: int): int requires (0 < len(a)) {
    j: int = i & len(a) - 1;
    a[j]
}

main(): int {
    a: []int = [1, 2, 3];
    pick(a, 8)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 1
    |}
}
