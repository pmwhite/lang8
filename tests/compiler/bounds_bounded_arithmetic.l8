tag bounds_test;

const STRIDE: int = 8;

bounded_index(i: int, slot: int): int requires (0 <= i && i < 2048 && 0 <= slot && slot < STRIDE) ensures (0 <= returned && returned < 16384) {
    i * STRIDE + slot
}

main(): int {
    data: []int = new int[16384](0);
    position: int = bounded_index(2, 3);
    data[position] = 7;
    data[position]
}

//% test: run
//% stdout: ""
//% exit: 7
