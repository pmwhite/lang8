tag bounds_test;

type Fixed = {
    data: []int;
    marker: int
} invariant (4 == len(data))

type Outer = {
    fixed: Fixed
}

main(): int {
    value: Outer = Outer { fixed: Fixed { data: new int[3](0), marker: 0 } };
    value.fixed.data[0]
}

//% test: compile-fail
//% error-contains: "record invariant is not proved"
