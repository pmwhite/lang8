tag bounds_test;

type Fixed = {
    data: []int;
    marker: int
} invariant (4 == len(data))

type Outer = {
    fixed: Fixed
}

main(): int {
    value: Outer = Outer { fixed: Fixed { data: new int[3](0), marker: 0 } };
    value.fixed.data[0]
}

/* expect compile {|
error: bounds_fixed_field_nested_constructor_bad.l8:13:35: record invariant is not proved after construction or field assignment
|} */
