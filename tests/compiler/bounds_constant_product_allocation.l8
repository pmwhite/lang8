tag bounds_test;

import "../../stdlib/print.l8";

last(data: []int): int requires (len(data) == 16) {
    data[15]
}

main(): int {
    data: []int = new int[4 * 4](7);
    last(data)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
