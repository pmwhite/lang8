tag bounds_test;

exception Retry;

type Buffer = {
    data: []int
}

replace(b: *Buffer@new) raises Retry {
    b.data = new int[0](0);
    raise Retry
}

recover(b: *Buffer@new): int {
    if (len(b.data) == 0) return 0;
    try {
        replace(b)
    } with Retry -> {
        return b.data[0]
    }
    0
}

main(): int {
    b: *Buffer = new Buffer { data: [7] };
    recover(b)
}

//% test: compile-fail
//% error-contains: "unproved array access; add a guard, contract, or invariant"
