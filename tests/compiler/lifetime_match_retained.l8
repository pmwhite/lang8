tag example;

type Box = {
    n: int
}

type Shape =
    | One { item: *Box }
    | None

g: ?*Box = null;

peek(shape: Shape) {
    match shape {
        One found -> g = found.item;
        None -> { }
    }
}

main(): int {
    0
}

