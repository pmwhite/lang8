tag example;

use_tag std;

import "../../stdlib/print.l8";

type Text = {
    words: int
}

make_text(named words: int): owned *Text {
    own {
        new Text { words: words }
    }
}

test "inferred owners and borrowed elements" {
    text := make_text(words: 3);
    borrow text {
        print_int(text.words)
    }
    texts := new ?owned *Text[2](null);
    texts[1] = make_text(words: 7);
    borrow texts[1] as element {
        count := element.words;
        print_int(count)
    }
    drop texts[1];
    drop text;
    expect {|
        3
        7
    |}
}
