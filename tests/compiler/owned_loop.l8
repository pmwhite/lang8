tag example;

type Box = {
    n: int
}

main(): int {
    a: ?owned *Box = null;
    i: int = 0;
    while (i < 2) {
        a = own {
            new Box { n: 1 }
        };
        i = i + 1
    }
    drop a;
    0
}

/* expect compile {|
error: owned_loop.l8:11:9: drop a before assigning it
|} */
