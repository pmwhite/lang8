tag bounds_test;

import "../../stdlib/print.l8";

step(start: int, end: int): int requires (0 <= start && start < end && end <= 240) ensures (returned <= end) {
    first: int = start;
    limit: int = end;
    right: int = first;
    y: int = 0;
    while (y < 2) invariant (0 <= right && right <= limit) {
        x: int = first;
        while (x < limit) invariant (0 <= right && right <= limit && 0 <= x && x <= 240) {
            if (x + 1 > right) right = x + 1;
            x = x + 1
        }
        y = y + 1
    }
    right
}

main(): int {
    step(2, 5)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 5
    |}
}
