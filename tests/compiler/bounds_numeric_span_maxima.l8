tag bounds_test;

import "../../stdlib/print.l8";

copy(
    dst: []int,
    doff: int,
    src: []int,
    soff: int,
    n: int
) {
    for i in 0..n dst[doff + i] = src[soff + i]
}

store(dst: []int, src: []int, n: int) requires (0 <= n && n <= 4 && n <= len(src) && len(dst) >= 16) {
    slot: int = n + 1 & 3;
    copy(dst, slot * 4, src, 0, n)
}

main(): int {
    dst: []int = new int[16](0);
    src: []int = new int[4](9);
    store(dst, src, 4);
    dst[7]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
