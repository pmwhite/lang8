tag example;

/* Stashing new into a global requires noregion. */
g: ?*int = null;

stash() {
    g = new int[1](0)
}

main(): int {
    stash();
    0
}

/* expect compile {|
error: immheapmiss.l8:6:1: missing noregion on stash
error: immheapmiss.l8:10:1: missing noregion on main
error: immheapmiss.l8:1:1: lifetime marks do not match
|} */
