tag bounds_test;

import "../../stdlib/print.l8";

previous_in_row(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    if (i % 4 > 0) return a[i - 1];
    0
}

main(): int {
    a: []int = [2, 4, 6, 8];
    previous_in_row(a, 2)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 4
    |}
}
