tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    cursor: int
}

replace_data(b: *Buffer@new) {
    b.data = new int[1](9)
}

read_after_other_write(a: *Buffer, b: *Buffer@new): int {
    if (a.cursor < 0 || a.cursor >= len(a.data)) return -1;
    replace_data(b);
    if (a.cursor >= len(a.data)) return -1;
    a.data[a.cursor]
}

main(): int {
    a: *Buffer = new Buffer { data: [7], cursor: 0 };
    read_after_other_write(a, a)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
