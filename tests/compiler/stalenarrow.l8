tag example;

/* Assignment kills ?*T narrowing. */
main(): int {
    x: int = 1;
    p: ?*int = &x;
    if (p != null) {
        p = null;
        p.*
    }
    0
}

/* expect compile {|
warning: stalenarrow.l8:9:9: ignored return value in main
error: stalenarrow.l8:9:9: pointer use is not proved non-null
|} */
