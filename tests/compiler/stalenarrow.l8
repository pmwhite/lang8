tag example;

/* Assignment kills ?*T narrowing. */
main(): int {
    x: int = 1;
    p: ?*int = &x;
    if (p != null) {
        p = null;
        p.*
    }
    0
}

/* expect compile {|
error: stalenarrow.l8:9:9: dereferencing optional pointer (use if (p != null) / while (p != null) to narrow): ?*int
|} */
