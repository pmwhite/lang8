tag example;

import "../../stdlib/print.l8";

main(): int {
    value: int = 0;
    if (true) value = 1 else value = 2;
    while (false) value = 9;
    for i in 0..1 value = value + i;
    if (false) {
        if (true) value = 9
    } else value = value + 1;
    if (true) local: int = value;
    if (true) {
        // Keep this comment with its block.
        value = value + 1
    }
    if (value != 3) return 1;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}

