tag bounds_test;

read_text(a: str, i: int) raises IndexOutOfBounds: int {
    a![i] as int
}

read_fixed(a: [2]int, i: int) raises IndexOutOfBounds: int {
    a![i]
}

read_nested(a: [][]int, i: int, j: int) raises IndexOutOfBounds: int {
    a![i]![j]
}

write_slot(a: []int, i: int) raises IndexOutOfBounds {
    slot: *int = &a![i];
    slot.* = 8;
    a[i] = a[i] + 1
}

main() raises IndexOutOfBounds: int {
    a: []int = [1];
    write_slot(a, 0);
    if (a[0] != 9) return 1;
    fixed: [2]int = [3, 4];
    if (read_fixed(fixed, 1) != 4) return 2;
    if (read_text("ab", 1) != 98) return 3;
    if (read_nested([a], 0, 0) != 9) return 4;
    try {
        write_slot(a, 1)
    } with IndexOutOfBounds -> {
        if (a[0] != 9) return 5
    }
    result: int = -1;
    try {
        result = read_text("a", -1)
    } with IndexOutOfBounds -> {
        result = 0
    }
    result
}

//% test: run
//% stdout: ""
//% exit: 0
