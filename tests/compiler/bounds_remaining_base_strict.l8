tag bounds_test;

// A nonnegative part fitting strictly leaves the base in bounds.
first_of_span(a: []int, start: int, count: int): int requires (0 <= start && start <= len(a) && 0 <= count && count < len(a) - start) ensures (returned < len(a)) {
    start
}

main(): int {
    a: []int = [1, 2, 3, 4];
    first_of_span(a, 2, 1)
}

//% test: run
//% stdout: ""
//% exit: 2
