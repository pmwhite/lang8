exception IndexOutOfBounds;

tag bounds_test;

change(p: *int): int {
    p.* = 2;
    0
}

get(a: []i8, i: index_for(a), ignored: int): i8 {
    if (ignored < 0) return 0i8;
    a[i]
}

main(): int {
    a: []i8 = ['A', 'B'];
    i: int = 1;
    if (i < 0 || i >= len(a)) raise IndexOutOfBounds;
    get(a, i, change(&i)) as int
}

