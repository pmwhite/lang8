tag bounds_test;

change(p: *int): int {
    p.* = 2;
    0
}

get(a: []i8, i: index_for(a), ignored: int): i8 {
    if (ignored < 0) return 0i8;
    a[i]
}

main(): int {
    a: []i8 = ['A', 'B'];
    i: int = 1;
    check_index(a, i);
    get(a, i, change(&i)) as int
}

//% test: compile-fail
//% error-contains: "array index not proved in bounds"
