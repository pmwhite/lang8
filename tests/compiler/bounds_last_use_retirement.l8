tag bounds_test;

exercise(
    data: []int,
    flag: bool,
    index: int,
    middle: int
): int requires (3 <= len(data)) ensures (0 <= returned && returned <= 3) {
    // Cross the lazy preparation threshold before exercising control flow.
    _setup0: int = 0;
    _setup1: int = 1;
    _setup2: int = 2;
    _setup3: int = 3;
    _setup4: int = 4;
    _setup5: int = 5;
    _setup6: int = 6;
    _setup7: int = 7;
    _setup8: int = 8;
    _setup9: int = 9;
    _setup10: int = 10;
    _setup11: int = 11;
    _setup12: int = 12;
    _setup13: int = 13;
    _setup14: int = 14;
    _setup15: int = 15;
    _setup16: int = 16;
    _setup17: int = 17;
    _setup18: int = 18;
    _setup19: int = 19;
    _setup20: int = 20;
    _setup21: int = 21;
    _setup22: int = 22;
    _setup23: int = 23;
    _setup24: int = 24;
    _setup25: int = 25;
    _setup26: int = 26;
    _setup27: int = 27;
    _setup28: int = 28;
    _setup29: int = 29;
    _setup30: int = 30;
    _setup31: int = 31;
    limit: int = 3;
    total: int = 0;
    i: int = 0;
    // Uses in the body and condition must survive every backedge.
    while (i < limit) invariant (0 <= i && i <= limit) {
        total = total + data[i];
        i = i + 1
    }
    if (total != 10) return 1;
    // A temporary declared in the outer loop still crosses the inner
    // backedge. Its bound must survive until that inner loop has finished.
    outer: int = 0;
    while (outer < 2) invariant (0 <= outer && outer <= 2) {
        local_limit: int = 3;
        for _pass in 0..2 {
            inner: int = 0;
            while (inner < local_limit) invariant (0 <= inner && inner <= local_limit) {
                total = total + data[inner];
                inner = inner + 1
            }
        }
        outer = outer + 1
    }
    if (total != 50) return 1;
    selected: int = 2;
    value: int = 0;
    if (flag) value = data[selected] else {
        value = data[selected];
        value = value + data[selected - 1]
    }
    if (value != (if (flag) 5 else 8)) return 2;
    // middle's final syntactic use leaves a bridge to a later proof.
    if (index < 0 || index >= middle || middle > len(data)) return 3;
    if (data[index] != 5) return 3;
    // Fallthrough guarantees are checked after the final statement transfer.
    result: int = 0;
    result
}

main(): int {
    data: []int = [2, 3, 5];
    if (exercise(data, true, 2, 3) != 0) return 1;
    if (exercise(data, false, 2, 3) != 0) return 2;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
