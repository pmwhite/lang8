tag example;

import "../../stdlib/print.l8";

type Samples = {
    values: []f64
}

type Point = {
    x: int;
    y: int
}

type Shape = {
    corner: Point
}

halved(value: f64): f64 {
    value / 2.0f64
}

x_of(point: Point): int {
    point.x
}

// Each choice reads a number (or a record of numbers) through one of two
// unrelated parameters and passes the copy on, so no lifetime is compared.
first_halved(left: *Samples, right: *Samples, use_left: bool): f64 {
    halved(if (use_left) left.values[0] else right.values[0])
}

nth_halved(left: *Samples, right: *Samples, side: int): f64 {
    halved(match side {
        0 -> left.values[0];
        _ -> right.values[0]
    })
}

corner_x(left: *Shape, right: *Shape, use_left: bool): int {
    x_of(if (use_left) left.corner else right.corner)
}

test "a number chosen from either of two borrowed records passes on" {
    left: Samples = Samples { values: new f64[1](3.0f64) };
    right: Samples = Samples { values: new f64[1](5.0f64) };
    std::print_int((first_halved(&left, &right, true) * 2.0f64) as int);
    std::print_int((first_halved(&left, &right, false) * 2.0f64) as int);
    std::print_int((nth_halved(&left, &right, 1) * 2.0f64) as int);
    expect {|
        3
        5
        5
    |}
    near: Shape = Shape { corner: Point { x: 1, y: 2 } };
    far: Shape = Shape { corner: Point { x: 7, y: 8 } };
    std::print_int(corner_x(&near, &far, false));
    expect {|
        7
    |}
}
