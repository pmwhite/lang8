tag bounds_test;

import "../../stdlib/print.l8";

copy(s: str): int {
    out: []i8 = new i8[2 + len(s)](0i8);
    out[0] = 'a';
    out[1] = 'b';
    for i in 0..len(s) out[2 + i] = s[i];
    out[len(out) - 1] as int
}

main(): int {
    copy("xyz")
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 122
    |}
}
