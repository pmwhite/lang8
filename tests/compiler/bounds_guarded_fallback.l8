tag bounds_test;

import "../../stdlib/print.l8";

get(a: []int, i: int): int {
    if (i < 0 || i >= len(a)) return 9;
    a[i]
}

main(): int {
    get([7], 2)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 9
    |}
}
