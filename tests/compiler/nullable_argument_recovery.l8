tag example;

import "../../stdlib/print.l8";

exception Missing;

read_value(pointer: *int): int {
    pointer.*
}

skip_missing(pointer: ?*int): int {
    result: int = 0;
    if (pointer != null) result = read_value(pointer);
    result
}

require_value(pointer: ?*int) raises Missing: int {
    if (pointer == null) raise Missing;
    read_value(pointer)
}

read_optional(pointer: ?*int): int {
    if (pointer == null) return -1;
    pointer.*
}

test "the caller or callee can decide what a missing value means" {
    value: int = 7;
    std::print_int(skip_missing(null));
    std::print_int(skip_missing(&value));
    try {
        std::print_int(require_value(null))
    } with Missing -> {
        std::print("missing")
    }
    std::print_int(require_value(&value));
    std::print_int(read_optional(null));
    std::print_int(read_optional(&value));
    expect {|
        0
        7
        missing
        7
        -1
        7
    |}
}
