tag bounds_test;

import "../../stdlib/print.l8";

type Range = {
    start: int;
    stop: int
} invariant (0 <= start && stop <= 10)

offset(start: int, position: int): int requires (start <= position) {
    position - start
}

run(range: Range): int {
    scratch: []int = [0];
    total: int = 0;
    for position in range.start..range.stop {
        scratch[0] = position;
        total = total + offset(range.start, position)
    }
    total
}

main(): int {
    run(Range { start: 2, stop: 5 })
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 3
    |}
}
