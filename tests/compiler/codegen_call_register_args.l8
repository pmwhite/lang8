tag example;

import "../../stdlib/print.l8";

six(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int
): int {
    a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000
}

narrow(
    a: i8,
    b: i32,
    c: u32,
    d: int,
    e: bool,
    f: ?*int
): int {
    if (a != 255i8 || b != -31i32 || c != 4294967295u32) return 1;
    if (d != -9000000000000 || !e || f != null) return 2;
    0
}

three(a: int, b: int, c: int): int {
    a + b * 10 + c * 100
}

test "six register arguments in either order" {
    a: int = 1;
    b: int = 2;
    c: int = 3;
    d: int = 4;
    e: int = 5;
    f: int = 6;
    for i in 0..10 {
        a = i;
        std::write_int(1, i);
        std::write(1, ": ");
        std::write_int(1, six(a, b, c, d, e, f));
        std::write(1, " ");
        std::print_int(six(f, e, d, c, b, a))
    }
    expect {|
        0: 654320 23456
        1: 654321 123456
        2: 654322 223456
        3: 654323 323456
        4: 654324 423456
        5: 654325 523456
        6: 654326 623456
        7: 654327 723456
        8: 654328 823456
        9: 654329 923456
    |}
}

test "narrow and nullable arguments arrive intact" {
    byte: i8 = 255i8;
    signed: i32 = -31i32;
    unsigned: u32 = 4294967295u32;
    wide: int = -9000000000000;
    flag: bool = true;
    missing: ?*int = null;
    std::write(1, "narrow: ");
    std::print_int(narrow(byte, signed, unsigned, wide, flag, missing));
    expect {|
        narrow: 0
    |}
}

test "arguments are evaluated left to right" {
    // A later argument changes the local: the first argument keeps its old value.
    x: int = 2;
    std::write(1, "three(x, x = 9, x): ");
    std::print_int(three(x, x = 9, x));
    expect {|
        three(x, x = 9, x): 992
    |}
}
