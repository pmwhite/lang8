tag example;

import "../../stdlib/print.l8";

six(
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int
): int {
    a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000
}

narrow(
    a: i8,
    b: i32,
    c: u32,
    d: int,
    e: bool,
    f: ?*int
): int {
    if (a != 255i8 || b != -31i32 || c != 4294967295u32) return 1;
    if (d != -9000000000000 || !e || f != null) return 2;
    0
}

three(a: int, b: int, c: int): int {
    a + b * 10 + c * 100
}

main(): int {
    a: int = 1;
    b: int = 2;
    c: int = 3;
    d: int = 4;
    e: int = 5;
    f: int = 6;
    for i in 0..10 {
        a = i;
        if (six(a, b, c, d, e, f) != 654320 + i) return 1;
        if (six(f, e, d, c, b, a) != 23456 + i * 100000) return 2
    }
    byte: i8 = 255i8;
    signed: i32 = -31i32;
    unsigned: u32 = 4294967295u32;
    wide: int = -9000000000000;
    flag: bool = true;
    missing: ?*int = null;
    if (narrow(byte, signed, unsigned, wide, flag, missing) != 0) return 3;
    // A later argument changes the local: the first argument keeps its old value.
    x: int = 2;
    if (three(x, x = 9, x) != 992) return 4;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
