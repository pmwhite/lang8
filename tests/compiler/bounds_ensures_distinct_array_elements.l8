tag bounds_test;

import "../../stdlib/print.l8";

fill_pair(out: []int, value: int): int requires (len(out) >= 2 && 0 <= value && value <= 10) ensures (0 <= out[0] && out[0] <= 10 && 0 <= out[1] && out[1] <= 10) {
    out[0] = value;
    out[1] = value;
    0
}

main(): int {
    pair: []int = [0, 0];
    if (fill_pair(pair, 7) != 0) return 1;
    if (pair[0] != 7 || pair[1] != 7) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
