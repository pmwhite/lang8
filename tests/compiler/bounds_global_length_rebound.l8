tag bounds_test;

buffer: []int = [4, 5];

empty: []int = new int[0](0);

shrink() {
    buffer = empty
}

reset() {
    shrink()
}

// A call that may assign the global, even indirectly, ends the guard.
last(): int {
    if (len(buffer) < 2) return 0;
    reset();
    buffer[1]
}

main(): int {
    last()
}

/* expect compile {|
error: bounds_global_length_rebound.l8:19:11: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= 1 && 1 < len(buffer))
|} */
