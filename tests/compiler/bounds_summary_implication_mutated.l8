tag bounds_test;

nonnegative(i: int): bool {
    if (i >= 0) return true;
    false
}

read_after_change(xs: []int, i: int): int {
    result: bool = nonnegative(i);
    i = 0 - 1;
    if (result == true && i < len(xs)) return xs[i];
    0
}

main(): int {
    xs: []int = [7];
    read_after_change(xs, 0)
}

//% test: compile-fail
//% error-contains: "unproved array access; use ![] for a runtime check"
