tag codegen_test;

calls: int = 0;

type Holder = {
    data: []int
}

make_slice(): []int@new {
    calls = calls + 1;
    [10, 20, 30]
}

make_text(): str@immortal {
    calls = calls + 1;
    "abc"
}

simple(a: []int, i: int): int {
    if (i >= 0 && i < len(a)) return a[i];
    -1
}

complex(h: *Holder, i: int): int {
    if (len(h.data) > 1 && i == 0) return h.data[i + 1];
    -1
}

fixed(i: int): int {
    a: [3]int = [10, 20, 30];
    if (i >= 0 && i < 3) return a[i * 1];
    -1
}

bounded(a: []int, i: int): int {
    if (i < 0 || i >= len(a)) return -1;
    a[i]
}

main(): int {
    if (len(make_slice()) != 3 || calls != 1) return 1;
    if (len(make_text()) != 3 || calls != 2) return 2;
    empty: []int = new int[0](0);
    if (len(empty) != 0 || len("") != 0) return 3;
    a: []int = make_slice();
    h: *Holder = new Holder { data: a };
    if (simple(a, 2) != 30 || complex(h, 0) != 20 || fixed(1) != 20) return 4;
    if (bounded(a, 3) != -1) return 5;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
