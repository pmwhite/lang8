tag codegen_test;

import "../../stdlib/print.l8";

calls: int = 0;

type Holder = {
    data: []int
}

make_slice(): []int@new {
    calls = calls + 1;
    [10, 20, 30]
}

make_text(): str@immortal {
    calls = calls + 1;
    "abc"
}

simple(a: []int, i: int): int {
    if (i >= 0 && i < len(a)) return a[i];
    -1
}

complex(h: *Holder, i: int): int {
    if (len(h.data) > 1 && i == 0) return h.data[i + 1];
    -1
}

fixed(i: int): int {
    a: [3]int = [10, 20, 30];
    if (i >= 0 && i < 3) return a[i * 1];
    -1
}

bounded(a: []int, i: int): int {
    if (i < 0 || i >= len(a)) return -1;
    a[i]
}

test "len of a call evaluates the call once" {
    std::write(1, "len(make_slice()): ");
    std::print_int(len(make_slice()));
    std::write(1, "calls: ");
    std::print_int(calls);
    expect {|
        len(make_slice()): 3
        calls: 1
    |}
    std::write(1, "len(make_text()): ");
    std::print_int(len(make_text()));
    std::write(1, "calls: ");
    std::print_int(calls);
    expect {|
        len(make_text()): 3
        calls: 2
    |}
}

test "empty lengths" {
    empty: []int = new int[0](0);
    std::write(1, "len(empty): ");
    std::print_int(len(empty));
    std::write(1, "len(\"\"): ");
    std::print_int(len(""));
    expect {|
        len(empty): 0
        len(""): 0
    |}
}

test "indexing guarded by lengths" {
    a: []int = make_slice();
    h: *Holder = new Holder { data: a };
    std::write(1, "simple(a, 2): ");
    std::print_int(simple(a, 2));
    std::write(1, "complex(h, 0): ");
    std::print_int(complex(h, 0));
    std::write(1, "fixed(1): ");
    std::print_int(fixed(1));
    expect {|
        simple(a, 2): 30
        complex(h, 0): 20
        fixed(1): 20
    |}
    std::write(1, "bounded(a, 3): ");
    std::print_int(bounded(a, 3));
    expect {|
        bounded(a, 3): -1
    |}
}
