tag bounds_test;

import "../../stdlib/print.l8";

type Box = {
    data: []i8
}

main(): int {
    box: Box = Box { data: ['A', 'B'] };
    i: int = 1;
    box.data[i] as int
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 66
    |}
}
