tag bounds_test;

import "../../stdlib/print.l8";

type Copies = {
    first: int;
    second: int;
    third: int;
    data: []int
}

copies(n: int): Copies@new requires (0 < n) {
    Copies {
        first: n,
        second: n,
        third: n,
        data: new int[n](0)
    }
}

main(): int {
    result: Copies = copies(4);
    result.first = 1;
    result.data[result.second - 1] = 7;
    result.data[result.third - 1]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
