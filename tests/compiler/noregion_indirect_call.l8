tag example;

saved: ?*int = null;

stash() noregion {
    saved = new int[1](1)
}

main(): int {
    callback: fn() noregion = &stash;
    callback();
    0
}

/* expect compile {|
noregion_indirect_call.l8:11:5

    callback();
    ^^^^^^^^

main calls a function value, which requires noregion and cannot run
inside a region.

Declare main and its callers as noregion (unavailable inside regions),
or use a callee that can run inside a region.

|} */
