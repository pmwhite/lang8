tag effectful_fill;

import "../../stdlib/print.l8";

type State = {
    size: int;
    cached: int
}

type Buffer = {
    data: []int;
    size: int
} invariant (0 <= size && size == len(data))

type Pair = {
    first: []int;
    second: []int
} invariant (len(first) == len(second))

fill(s: *State): int {
    s.cached = s.cached + 1;
    7
}

main(): int {
    s: *State = new State { size: 4, cached: 0 };
    a: Buffer = Buffer { data: new int[s.size](fill(s)), size: s.size };
    b: Pair = Pair { first: new int[s.size](0), second: new int[s.size](fill(s)) };
    if (len(a.data) != 4 || len(b.second) != 4 || s.cached != 2) return 1;
    for i in 0..len(a.data)
        if (a.data[i] != 7) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
