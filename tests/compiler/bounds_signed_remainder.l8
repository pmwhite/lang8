tag bounds_test;

import "../../stdlib/print.l8";

type Weekday = {
    index: int
} invariant (0 <= index && index < 7)

weekday(days: int): Weekday {
    remainder: int = days % 7;
    shifted: int = remainder + 7;
    index: int = shifted % 7;
    Weekday { index: index }
}

main(): int {
    day: Weekday = weekday(-8);
    day.index
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 6
    |}
}
