tag bounds_test;

type Weekday = {
    index: int
} invariant (0 <= index && index < 7)

weekday(days: int): Weekday {
    remainder: int = days % 7;
    shifted: int = remainder + 7;
    index: int = shifted % 7;
    Weekday { index: index }
}

main(): int {
    day: Weekday = weekday(-8);
    day.index
}

//% test: run
//% verify-bounds: true
//% stdout: ""
//% exit: 6
