tag bounds_test;

import "../../stdlib/print.l8";

type Status =
    | Ready
    | Missing

nonnegative_bool(i: int): bool {
    if (i >= 0) return true;
    false
}

nonnegative_int(i: int): int {
    if (i >= 0) return 1;
    0
}

nonnegative_status(i: int): Status {
    if (i >= 0) return Status.Ready;
    Status.Missing
}

identity_if_nonnegative(i: int): int {
    if (i >= 0) return i;
    0
}

read_identity(xs: []int, i: int): int {
    if (i >= 0 && i < len(xs)) {
        result: int = identity_if_nonnegative(i);
        return xs[result]
    }
    0
}

read_when_bool(xs: []int, i: int): int {
    a: bool = nonnegative_bool(i);
    if (a && i < len(xs)) return xs[i];
    0
}

read_when_int(xs: []int, i: int): int {
    b: int = nonnegative_int(i);
    if (b == 1 && i < len(xs)) return xs[i];
    0
}

read_when_status(xs: []int, i: int): int {
    c: Status = nonnegative_status(i);
    if (c == Status.Ready && i < len(xs)) return xs[i];
    0
}

main(): int {
    xs: []int = [7];
    if (read_when_bool(xs, 0) != 7 || read_when_int(xs, 0) != 7 || read_when_status(xs,
        0) != 7) return 1;
    if (read_when_bool(xs, 0 - 1) != 0 || read_when_int(xs, 0 - 1) != 0 || read_when_status(xs,
        0 - 1) != 0) return 2;
    if (read_identity(xs, 0) != 7 || read_identity(xs, 0 - 1) != 0) return 3;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
