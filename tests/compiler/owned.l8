tag example;

use_tag std;

import "../../stdlib/print.l8";

extern l8_arena_live(): int;

extern l8_heap_mark(): int;

type Box = {
    n: int
}

type Hold = {
    item: *Box
}

type Shape =
    | One { item: *Box }
    | None

type Bag = {
    items: []*Box
}

test "owned arena drop" {
    before: int = l8_arena_live();
    box: owned *Box = own {
        new Box { n: 1 }
    };
    print_int(l8_arena_live() - before);
    borrow box {
        print_int(box.n);
        box.n = 2;
        allocate box {
            extra: *Box = new Box { n: 3 };
            print_int(extra.n)
        }
        print_int(box.n)
    }
    drop box;
    print_int(l8_arena_live() - before);
    expect {|
        1
        1
        3
        2
        0
    |}
}

test "move transfers the owner" {
    before: int = l8_arena_live();
    a: owned *Box = own {
        new Box { n: 4 }
    };
    b: owned *Box = move a;
    drop a;
    borrow b {
        print_int(b.n)
    }
    drop b;
    print_int(l8_arena_live() - before);
    expect {|
        4
        0
    |}
}

exception Boom;

make_box(bad: bool) raises Boom: *Box@new {
    if (bad) raise Boom;
    new Box { n: 5 }
}

test "a failed own frees its arena" {
    before: int = l8_arena_live();
    try {
        lost: owned *Box = own {
            make_box(true)
        };
        drop lost
    } with Boom -> { }
    print_int(l8_arena_live() - before);
    kept: owned *Box = own {
        make_box(false)
    };
    borrow kept {
        print_int(kept.n)
    }
    drop kept;
    print_int(l8_arena_live() - before);
    expect {|
        0
        5
        0
    |}
}

test "an empty owner can be assigned" {
    before: int = l8_arena_live();
    box: ?owned *Box = null;
    box = own {
        new Box { n: 6 }
    };
    borrow box {
        print_int(box.n)
    }
    drop box;
    print_int(l8_arena_live() - before);
    expect {|
        6
        0
    |}
}

test "drop then assign in a loop" {
    before: int = l8_arena_live();
    box: owned *Box = own {
        new Box { n: 1 }
    };
    i: int = 0;
    while (i < 3) {
        drop box;
        box = own {
            new Box { n: i }
        };
        i = i + 1
    }
    borrow box {
        print_int(box.n)
    }
    drop box;
    print_int(l8_arena_live() - before);
    expect {|
        2
        0
    |}
}

test "an immortal pointer outlives the arena" {
    outer: *Box = new Box { n: 9 };
    fresh: *Box = new Box { n: 8 };
    held: owned *Hold = own {
        new Hold { item: outer }
    };
    borrow held {
        print_int(held.item.n);
        held.item = fresh;
        print_int(held.item.n)
    }
    drop held;
    print_int(outer.n);
    print_int(fresh.n);
    expect {|
        9
        8
        9
        8
    |}
}

grow_box() raises IoError {
    box: owned *Box = own {
        new Box { n: 11 }
    };
    borrow box {
        alias: *Box = box;
        allocate alias {
            before: int = l8_heap_mark();
            for _iteration in 0..100 {
                region {
                    scratch: []i8 = new i8[200000](17i8);
                    if (scratch[199999] != 17i8) box.n = -1
                }
            }
            after: int = l8_heap_mark();
            print_bool(before == after);
            retained: []i8 = new i8[300000](23i8);
            print_bool(retained[299999] == 23i8 && box.n == 11)
        }
    }
    drop box
}

test "arena regions rewind across chunks and aliases select their owner" {
    grow_box();
    expect {|
        true
        true
    |}
}

test "match reads an arena payload" {
    box: owned *Shape = own {
        new Shape.One { item: new Box { n: 4 } }
    };
    borrow box {
        match box.* {
            One s -> print_int(s.item.n);
            None -> { }
        }
    }
    drop box;
    expect {|
        4
    |}
}

same_box(p: *Box): *Box@p {
    p
}

test "call reads an arena pointer inside the borrow" {
    box: owned *Box = own {
        new Box { n: 4 }
    };
    borrow box {
        alias: *Box = same_box(box);
        print_int(alias.n)
    }
    drop box;
    expect {|
        4
    |}
}

test "match reads a copied arena payload" {
    box: owned *Box = own {
        new Box { n: 4 }
    };
    borrow box {
        shape: Shape = Shape.One { item: box };
        match shape {
            One found -> print_int(found.item.n);
            None -> { }
        }
    }
    drop box;
    expect {|
        4
    |}
}

test "for reads an arena element" {
    bag: owned *Bag = own {
        new Bag { items: new *Box[1](new Box { n: 4 }) }
    };
    borrow bag {
        for item in bag.items print_int(item.n)
    }
    drop bag;
    expect {|
        4
    |}
}
