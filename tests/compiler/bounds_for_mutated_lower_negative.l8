tag bounds_test;

offset(start: int, position: int): int requires (start <= position) {
    position - start
}

sum_offsets(start: int, end: int): int requires (0 <= start && start <= end && end <= 20) {
    total: int = 0;
    for position in start..end {
        start = start + 1;
        total = total + offset(start, position)
    }
    total
}

main(): int {
    sum_offsets(2, 5)
}

//% test: compile-fail
//% error-contains: "call does not prove function precondition"
