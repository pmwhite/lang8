tag example;

import "../../stdlib/print.l8";

test "a pointer known to be non-null is stored as non-null" {
    values: []int = new int[1](7);
    p: ?*int = &values[0];
    pointers: []*int = new *int[1](&values[0]);
    pointers[0] = p;
    std::write(1, "pointers[0].*: ");
    std::print_int(pointers[0].*);
    expect {|
        pointers[0].*: 7
    |}
}
