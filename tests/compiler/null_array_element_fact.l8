tag example;

import "../../stdlib/print.l8";

main(): int {
    values: []int = new int[1](7);
    p: ?*int = &values[0];
    pointers: []*int = new *int[1](&values[0]);
    pointers[0] = p;
    pointers[0].*
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
