tag example;

/* An aggregate stored past the call must be @immortal; interiors of a
   stack box are not. */
g: ?*int = null;

type Box = {
    p: *int
}

stash(b: Box@immortal) {
    g = b.p
}

main(): int {
    x: int = 0;
    stash(Box { p: &x });
    0
}

/* expect compile {|
error: localbox.l8:1:1: address of local cannot escape in main
|} */
