tag bounds_test;

import "../../stdlib/print.l8";

put2(dst: []int, i: int, v: int): int requires (0 <= i && i <= len(dst) - 2) ensures (returned == i + 2) {
    dst[i] = v;
    dst[i + 1] = v;
    i + 2
}

// A range over a few constant values is checked one iteration at a time, so
// a cursor advanced a fixed amount per iteration keeps its bound.
fill(dst: []int): int requires (24 <= len(dst)) ensures (returned == 24) {
    i: int = 0;
    for k in 0..4 {
        i = put2(dst, i, k);
        i = put2(dst, i, k + 10);
        i = put2(dst, i, k + 20)
    }
    i
}

// Each iteration knows its index, so a guard that cannot hold in one of them
// rules its branch out there.
pairs(a: []int, w: int): int requires (len(a) == 6 && 1 <= w && w < 3) {
    total: int = 0;
    for z in 0..3 {
        if (z > 0) total = total + a[(z - 1) * 3 + w]
    }
    total
}

main(): int {
    d: []int = new int[24](0);
    if (fill(d) != 24 || d[0] != 0 || d[5] != 20 || d[23] != 23) return 1;
    a: []int = [1, 2, 3, 4, 5, 6];
    if (pairs(a, 2) != 9) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
