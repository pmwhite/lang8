tag bounds_test;

import "../../stdlib/print.l8";

type Buffer = {
    data: []int;
    used: int
} invariant (0 <= used && used <= len(data))

make_buffer(size: int): *Buffer@new {
    new Buffer { data: new int[size](0), used: 0 }
}

main(): int {
    b: *Buffer = make_buffer(3);
    b.used
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
