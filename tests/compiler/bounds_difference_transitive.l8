tag bounds_test;

import "../../stdlib/print.l8";

main(): int {
    a: []int = [3, 5, 7, 11, 13];
    i: int = 1;
    n: int = 2;
    if (i >= 0 && i <= n && n < len(a) - 2) return a[i + 2];
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 11
    |}
}
