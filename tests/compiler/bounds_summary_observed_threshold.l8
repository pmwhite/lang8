tag bounds_test;

at_least_five(i: int): bool {
    if (i >= 5) return true;
    false
}

at_most_two(i: int): bool {
    if (i <= 2) return true;
    false
}

read_after_five(xs: []int, i: int): int {
    ok: bool = at_least_five(i);
    if (ok && i < len(xs)) return xs[i - 5];
    0
}

read_at_most_two(i: int): int {
    xs: []int = [7, 8, 9];
    ok: bool = at_most_two(i);
    if (ok && i >= 0) return xs[i];
    0
}

main(): int {
    xs: []int = [7, 8, 9, 10, 11, 12];
    if (read_after_five(xs, 5) != 7) return 1;
    if (read_after_five(xs, 4) != 0) return 2;
    if (read_at_most_two(2) != 9) return 3;
    if (read_at_most_two(3) != 0) return 4;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
