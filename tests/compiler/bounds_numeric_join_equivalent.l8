tag bounds_test;

joined_value(a: []int, choose: bool): int {
    if (len(a) < 4) return 0;
    if (choose) {
        if (len(a) < 4) return 0
    } else {
        seen: int = a[3];
        if (seen < 0) return 0
    }
    a[3]
}

main(): int {
    joined_value(new int[4](7), true)
}

//% test: run
//% stdout: ""
//% exit: 7
