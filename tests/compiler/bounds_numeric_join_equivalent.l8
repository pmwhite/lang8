tag bounds_test;

import "../../stdlib/print.l8";

joined_value(a: []int, choose: bool): int {
    if (len(a) < 4) return 0;
    if (choose) {
        if (len(a) < 4) return 0
    } else {
        seen: int = a[3];
        if (seen < 0) return 0
    }
    a[3]
}

main(): int {
    joined_value(new int[4](7), true)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
