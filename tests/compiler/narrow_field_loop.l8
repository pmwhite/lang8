tag example;

type Rec = {
    x: int
}

type Holder = {
    p: ?*Rec
}

clear(h: *Holder) {
    h.p = null
}

/* A loop's later turn may follow a call in it: no field path narrowed
before the loop stays narrowed in it. */
f(h: *Holder): int {
    n: int = 0;
    if (h.p != null) {
        while (n < 2) {
            n = n + h.p.x;
            clear(h)
        }
    }
    n
}

main(): int {
    r: Rec = Rec { x: 1 };
    h: Holder = Holder { p: &r };
    f(&h)
}

/* expect compile {|
error: narrow_field_loop.l8:21:26: member access on optional pointer (use if (p != null) / while (p != null) to narrow): ?*Rec
|} */
