tag compound_test;

import "../../stdlib/print.l8";

data: []int = [10, 20];

trace: int = 0;

slot(): int {
    trace = trace * 10 + 1;
    0
}

replacement(): int {
    trace = trace * 10 + 2;
    data[0] = 100;
    5
}

type Counter = {
    count: int
}

seed: int = 3;

initialized: int = seed += 2;

test "destination is evaluated once and read before rhs" {
    result: int = data[slot()] += replacement();
    std::print_int(trace);
    std::print_int(result);
    std::print_int(data[0]);
    counter: Counter = Counter { count: 7 };
    pointer: *int = &counter.count;
    pointer.* *= 3;
    counter.count -= 1;
    std::print_int(counter.count);
    expect {|
        12
        15
        15
        20
    |}
}

test "operators preserve numeric types and assignment expressions associate right" {
    value: int = 10;
    value += 2;
    value -= 3;
    value *= 4;
    value /= 3;
    value %= 7;
    value <<= 3;
    value >>= 1;
    value |= 3;
    value &= 7;
    value ^= 1;
    std::print_int(value);
    outer: int = 2;
    inner: int = 4;
    outer += inner *= 3;
    std::print_int(outer);
    std::print_int(inner);
    small: i8 = 2i8;
    small += 3i8;
    signed: i32 = -4i32;
    signed >>= 1;
    unsigned: u32 = 4294967295u32;
    unsigned >>= 31;
    real: f64 = 1.5f64;
    real *= 2.0f64;
    std::print_int(small as int);
    std::print_int(signed as int);
    std::print_int(unsigned as int);
    std::print_bool(real == 3.0f64);
    std::print_int(initialized);
    std::print_int(seed);
    expect {|
        6
        14
        12
        5
        -2
        1
        true
        5
        5
    |}
}

exception Stop;

fail() raises Stop: int {
    raise Stop
}

test "an exiting rhs leaves the destination unchanged" {
    value: int = 10;
    try {
        value += fail()
    } with Stop -> { }
    for index in 0..3 value += (if (index == 0) {
        continue
    } else if (index == 2) {
        break
    } else 4);
    std::print_int(value);
    expect {|
        14
    |}
}
