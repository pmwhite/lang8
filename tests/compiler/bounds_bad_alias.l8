tag bounds_test;

change(p: *int) {
    p.* = 4
}

main(): int {
    a: []i8 = ['A', 'B'];
    i: int = 0;
    if (i < 0 || i >= len(a)) return 1;
    change(&i);
    a[i] as int
}

/* expect compile {|
error: bounds_bad_alias.l8:12:6: unproved array access; add a guard, contract, or invariant (cannot prove 0 <= i && i < len(a))
|} */
