tag example;

import "../../stdlib/print.l8";

// Declarations in blocks and in the bodies of if, while and for shadow the
// outer value only inside that body.
main() raises std::IoError: int {
    value: int = 10;
    {
        value: int = 20;
        std::write(1, "inside the block: ");
        std::print_int(value)
    }
    if (true) value: int = 30;
    if (false) value: int = 40 else value: int = 50;
    while (false) value: int = 60;
    for value in 0..1 value: int = 70;
    std::write(1, "after the control bodies: ");
    std::print_int(value);
    0
}

test "declarations in control bodies shadow only inside them" {
    status: int = main();
    expect {|
        inside the block: 20
        after the control bodies: 10
    |}
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}

