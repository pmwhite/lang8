tag example;

import "../../stdlib/print.l8";

main(): int {
    value: int = 10;
    {
        value: int = 20;
        if (value != 20) return 1
    }
    if (true) value: int = 30;
    if (false) value: int = 40 else value: int = 50;
    while (false) value: int = 60;
    for value in 0..1 value: int = 70;
    if (value != 10) return 2;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}

