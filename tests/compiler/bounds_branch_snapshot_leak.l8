exception IndexOutOfBounds;

tag bounds_test;

main(argc: int): int {
    a: []int = [7];
    i: int = argc;
    // argc == 1 reaches the unchecked arm with an invalid index.
    if (argc > 1) {
        if (i < 0 || i >= len(a)) raise IndexOutOfBounds
    } else {
        if (i < 0) return 0
    }
    a[i]
}

