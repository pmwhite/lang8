tag index_operands_test;

import "../../stdlib/print.l8";

type Holder = {
    data: []int
}

sum(
    a: []int,
    b: []int,
    i: int,
    j: int
): int {
    if (i < 0 || j < 0 || i >= len(a) || i >= len(b) || j >= len(a) - i || j >= len(b) - i) return -1;
    left: int = a[i + j];
    left + b[i + j]
}

lookup(h: *Holder, i: int): int requires (0 <= i && i < len(h.data)) {
    p: *int = &h.data[i];
    p.*
}

main(): int {
    a: []int = [10, 11, 12];
    b: []int = [30, 31, 32];
    h: Holder = Holder { data: b };
    if (sum(a, b, 0, 1) != 42) return 1;
    if (sum(a, b, 1, 1) != 44) return 2;
    hp: *Holder = &h;
    if (len(hp.data) <= 2) return 4;
    if (lookup(hp, 2) != 32) return 3;
    0
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
