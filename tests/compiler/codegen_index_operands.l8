tag index_operands_test;

import "../../stdlib/print.l8";

type Holder = {
    data: []int
}

sum(
    a: []int,
    b: []int,
    i: int,
    j: int
): int {
    if (i < 0 || j < 0 || i >= len(a) || i >= len(b) || j >= len(a) - i || j >= len(b) - i) return -1;
    left: int = a[i + j];
    left + b[i + j]
}

lookup(h: *Holder, i: int): int {
    p: *int = &h.data[i];
    p.*
}

io_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "computed indexes" {
    a: []int = [10, 11, 12];
    b: []int = [30, 31, 32];
    io_show("sum(a, b, 0, 1)", sum(a, b, 0, 1));
    io_show("sum(a, b, 1, 1)", sum(a, b, 1, 1));
    expect {|
        sum(a, b, 0, 1): 42
        sum(a, b, 1, 1): 44
    |}
}

test "address of an element through a pointer" {
    b: []int = [30, 31, 32];
    h: Holder = Holder { data: b };
    hp: *Holder = &h;
    io_show("len(hp.data)", len(hp.data));
    expect {|
        len(hp.data): 3
    |}
    if (len(hp.data) > 2) io_show("lookup(hp, 2)", lookup(hp, 2));
    expect {|
        lookup(hp, 2): 32
    |}
}
