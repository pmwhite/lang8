tag bounds_test;

write_three(a: []int, i: int) raises IndexOutOfBounds {
    a![i] = 3;
    a![i + 1] = 5;
    a![i + 2] = 7
}

forward(a: []int, i: int) raises IndexOutOfBounds {
    write_three(a, i)
}

main() raises IndexOutOfBounds: int {
    a: []int = new int[3](0);
    forward(a, 0);
    a[2]
}

//% test: run
//% stdout: ""
//% exit: 7
