tag bounds_test;

import "../../stdlib/print.l8";

first(a: []int, i: int): int {
    if (i < 0) return -1;
    tail: int = a[i + 2];
    a[i] + tail
}

main(): int {
    a: []int = [4, 5, 6];
    first(a, 0) - 10
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
