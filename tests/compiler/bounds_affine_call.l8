tag bounds_test;

import "../../stdlib/print.l8";

write_three(a: []int, i: int) {
    a[i] = 3;
    a[i + 1] = 5;
    a[i + 2] = 7
}

main(): int {
    a: []int = new int[3](0);
    write_three(a, 0);
    a[2]
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 7
    |}
}
