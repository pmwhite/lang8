tag bounds_test;

fetch(a: []int, i: int) raises IndexOutOfBounds: int requires (0 <= i && i < len(a)) {
    a![i]
}

main() raises IndexOutOfBounds: int {
    a: []int = [7];
    fetch(a, 0)
}

//% test: run
//% stdout: ""
//% exit: 7
//% compiler-warnings: ["checked access is already proved; use [] instead of ![]"]
