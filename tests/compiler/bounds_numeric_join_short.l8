tag bounds_test;

joined_value(a: []int, choose: bool): int {
    if (choose) {
        if (len(a) < 4) return 0
    } else {
        seen: int = a[check_index(a, 2)];
        if (seen < 0) return 0
    }
    a[3]
}

main(): int {
    joined_value(new int[4](7), true)
}

//% test: compile-fail
//% error-contains: "bounds requirement arguments must be simple"
