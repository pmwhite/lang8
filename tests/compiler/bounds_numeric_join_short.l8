tag bounds_test;

joined_value(a: []int, choose: bool): int {
    if (choose) {
        if (len(a) < 4) return 0
    } else {
        seen: int = a[2];
        if (seen < 0) return 0
    }
    a[3]
}

main(): int {
    a: []int = new int[3](7);
    joined_value(a, false)
}

