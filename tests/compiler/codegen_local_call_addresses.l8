tag example;

import "../../stdlib/print.l8";

type Pair = {
    left: int;
    right: int
}

type Box = {
    pair: Pair;
    number: int
}

forward(box: *Box, out: *int): int {
    combine(box.pair, box.pair, &box.pair, out, box.number, 4)
}

combine(
    a: Pair,
    b: Pair,
    original: *Pair,
    out: *int,
    e: int,
    f: int
): int {
    // Value arguments are copied by the callee, even when another argument
    // points to the caller's original object.
    a.left = 90;
    out.* = b.right + e + f;
    a.left + b.left + original.left
}

change(p: *Pair): int {
    p.left = 41;
    7
}

observe(a: Pair, value: int): int {
    a.left + value
}

call_address_show(label: str, value: int) raises std::IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(value)
}

test "value arguments are copies of the caller's object" {
    first: Pair = Pair { left: 2, right: 3 };
    second: Pair = Pair { left: 5, right: 11 };
    output: int = 0;
    result: int = combine(first, second, &first, &output, 13, 17);
    call_address_show("combine(first, second, &first, &output, 13, 17)", result);
    call_address_show("first.left", first.left);
    call_address_show("output", output);
    expect {|
        combine(first, second, &first, &output, 13, 17): 97
        first.left: 2
        output: 41
    |}
}

test "a value argument is copied after later arguments run" {
    first: Pair = Pair { left: 2, right: 3 };
    // The existing ABI passes the object's address before evaluating the
    // later argument; the callee copies it after that argument has run.
    call_address_show("observe(first, change(&first))", observe(first, change(&first)));
    expect {|
        observe(first, change(&first)): 48
    |}
}

test "fields passed by value and by address" {
    second: Pair = Pair { left: 5, right: 11 };
    output: int = 0;
    box: Box = Box { pair: second, number: 13 };
    result: int = forward(&box, &output);
    call_address_show("forward(&box, &output)", result);
    call_address_show("output", output);
    call_address_show("box.pair.left", box.pair.left);
    expect {|
        forward(&box, &output): 100
        output: 28
        box.pair.left: 5
    |}
}
