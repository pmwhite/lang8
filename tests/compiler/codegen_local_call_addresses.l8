tag example;

type Pair = {
    left: int;
    right: int
}

type Box = {
    pair: Pair;
    number: int
}

forward(box: *Box, out: *int): int {
    combine(box.pair, box.pair, &box.pair, out, box.number, 4)
}

combine(
    a: Pair,
    b: Pair,
    original: *Pair,
    out: *int,
    e: int,
    f: int
): int {
    // Value arguments are copied by the callee, even when another argument
    // points to the caller's original object.
    a.left = 90;
    out.* = b.right + e + f;
    a.left + b.left + original.left
}

change(p: *Pair): int {
    p.left = 41;
    7
}

observe(a: Pair, value: int): int {
    a.left + value
}

main(): int {
    first: Pair = Pair { left: 2, right: 3 };
    second: Pair = Pair { left: 5, right: 11 };
    output: int = 0;
    if (combine(first, second, &first, &output, 13, 17) != 97) return 1;
    if (first.left != 2 || output != 41) return 2;
    // The existing ABI passes the object's address before evaluating the
    // later argument; the callee copies it after that argument has run.
    if (observe(first, change(&first)) != 48) return 3;
    box: Box = Box { pair: second, number: 13 };
    if (forward(&box, &output) != 100) return 4;
    if (output != 28 || box.pair.left != 5) return 5;
    0
}

//% test: run
//% stdout: ""
//% exit: 0
