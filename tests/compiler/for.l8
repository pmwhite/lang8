tag example;

import "../../stdlib/raw_write.l8";

/* for x in xs walks []T; x is a per-iteration copy. */
putchar(c: i8) {
    raw::raw_write_byte(1, c)
}

type Pair = {
    value: i8
}

once(): []i8@new {
    a: []i8 = new i8[1]('Y');
    a
}

main(): int {
    xs: []i8 = new i8[3](0i8);
    xs[0] = 'Y';
    xs[1] = 'Y';
    xs[2] = 'Y';
    for c in xs putchar(c);
    nums: []int = new int[2](0);
    nums[0] = 1;
    nums[1] = 2;
    t: int = 0;
    for n in nums t = t + n;
    if (t == 3) putchar('Y');
    empty: []i8 = new i8[0](0i8);
    for _c in empty putchar('X');
    one: []i8 = new i8[1]('Y');
    for _d in one _d = 'N';
    if (one[check_index(one, 0)] == 'Y') putchar('Y');
    for c4 in once() putchar(c4);
    pairs: []Pair = new Pair[1](Pair { value: 'Y' });
    for pair in pairs putchar(pair.value);
    outer: []i8 = new i8[1]('Y');
    for outer in outer putchar(outer);
    putchar('\n');
    0
}

//% test: run
//% stdout: "YYYYYYYY\n"
//% exit: 0
