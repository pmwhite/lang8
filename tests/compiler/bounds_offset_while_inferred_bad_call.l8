tag bounds_test;

copy(
    dst: []int,
    offset: int,
    src: []int,
    n: int
) {
    i: int = 0;
    while (i < n) {
        dst[offset + i] = src[i];
        i = i + 1
    }
}

main(): int {
    dst: []int = new int[4](0);
    src: []int = new int[3](9);
    copy(dst, 2, src, 3);
    0
}

/* expect compile {|
error: bounds_offset_while_inferred_bad_call.l8:19:5: call does not prove function precondition
|} */
