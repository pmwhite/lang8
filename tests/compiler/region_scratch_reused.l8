tag example;

use_tag std;

import "../../stdlib/print.l8";

type Kept = {
    pieces: [][]i8;
    count: int
}

// A step repeated many times, as a program working through a document
// does: a large scratch slice in a region, and something kept in an arena
// that needs a new chunk each time. The memory the region gives back must
// be used again whatever size is asked for next: as the arena's small
// chunk, then as the next region's large scratch. (Under Wasm, chunks were
// once handed out whole: each small chunk took a freed large one, each
// region grew memory anew, and 1200 steps of 4 MiB exhausted Wasm's 4 GiB.)
steps(kept: *Kept@new, count: int, scratch: int): int {
    total: int = 0;
    for step in 0..count {
        region {
            work: []i8 = new i8[scratch](0i8);
            work[step % scratch] = 1i8;
            total = total + work[step % scratch] as int
        }
        kept.pieces[step] = new i8[65536](0i8);
        kept.count = kept.count + 1
    }
    total
}

test "a region's memory is used again by an arena and the next region" {
    owner: owned *Kept = own {
        new Kept { pieces: new []i8[1200](new i8[0](0i8)), count: 0 }
    };
    total: int = 0;
    borrow owner as kept {
        allocate kept {
            total = steps(kept, 1200, 4194304)
        }
        print_int(kept.count)
    }
    print_int(total);
    drop owner;
    expect {|
        1200
        1200
    |}
}
