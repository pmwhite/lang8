tag bounds_test;

type Buffer = {
    data: []int
}

main(): int {
    b: *Buffer = new Buffer { data: [4, 7, 9] };
    i: int = 0;
    if (i >= 0 && i <= len(b.data) - 2) {
        b.data = new int[0](0);
        return b.data[i + 1]
    }
    0
}

