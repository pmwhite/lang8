tag bounds_test;

type Buffer = {
    data: []int;
    used: int
}

first(b: *Buffer@new): int {
    if (b.used > len(b.data)) return -1;
    b.data = new int[0](0);
    for i in 0..b.used return b.data[i];
    0
}

main(): int {
    b: *Buffer = new Buffer { data: [1], used: 1 };
    first(b)
}

//% test: compile-fail
//% error-contains: "unproved array access; use ![] for a runtime check"
