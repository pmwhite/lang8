tag bounds_test;

choose(a: []int, i: int): int requires (0 <= i && i < len(a)) {
    i
}

main() raises IndexOutOfBounds: int {
    a: []int = [7];
    i: int = choose(a, 0);
    a![i]
}

//% test: run
//% stdout: ""
//% exit: 7
//% compiler-warnings: ["checked access is already proved; use [] instead of ![]"]
