tag bounds_test;

sum_neighbors(a: []int): int {
    total: int = 0;
    for i in 0..8 {
        bit: int = 1;
        while (bit <= 4) {
            if (i / bit % 2 == 0) total = total + a[i ^ bit];
            bit = bit * 2
        }
    }
    total
}

main(): int {
    a: []int = new int[7](0);
    sum_neighbors(a)
}

