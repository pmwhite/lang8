tag function_test;

import "../../stdlib/raw_write.l8";

import "../../stdlib/print.l8";

exception E;

exception F;

saved: ?*int = null;

stash() noregion {
    saved = new int[1](42)
}

thrower(n: int) raises E, F {
    if (n == 0) raise E;
    raise F
}

apply(cb: fn(n: int) raises E, F, n: int) raises E, F {
    cb(n)
}

exit_success(): noreturn {
    l8_exit(0)
}

extern l8_exit(code: int): noreturn;

main() noregion: int {
    store: fn() noregion = &stash;
    store();
    p: *int = saved or l8_exit(1);
    if (p.* != 42) return 2;
    cb: fn(value: int) raises F, E = &thrower;
    count: int = 0;
    try {
        apply(cb, 0)
    } with E -> {
        count = count + 1
    } with F -> {
        return 3
    }
    try {
        cb(1)
    } with E -> {
        return 4
    } with F -> {
        count = count + 1
    }
    if (count != 2) return 5;
    done: fn(): noreturn = &exit_success;
    optional: ?*int = null;
    raw::raw_write(1, "fn effects OK\n");
    value: *int = optional or done();
    value.*
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        fn effects OK
        [exit 0]
    |}
}
