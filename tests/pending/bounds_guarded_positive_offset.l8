tag bounds_test;

import "../../stdlib/print.l8";

// The shared domain does not yet infer the no-wrap range needed here.
peek(s: str, p: int) raises IndexOutOfBounds: int {
    if (p < 0 || p >= len(s) || p + 2 >= len(s)) return 0;
    s[p + 1] as int
}

main() raises IndexOutOfBounds: int {
    peek("a", 0)
}

test "main" {
    status: int = main();
    std::write(1, "main returned ");
    std::print_int(status);
    expect {|
        main returned 0
    |}
}
