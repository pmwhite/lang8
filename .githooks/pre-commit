#!/usr/bin/env bash
set -euo pipefail

repo=$(git rev-parse --show-toplevel)
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/lang8-pre-commit.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT

# Build the exact staged tree. The self-host build formats src2 in place, so
# compare it with the index below before accepting the result.
git -C "$repo" checkout-index --all --prefix="$snapshot/"
cd "$snapshot"
echo 'pre-commit: building staged tree'
if ! ./build.sh; then
    echo 'pre-commit: staged build failed' >&2
    exit 1
fi

failed=0
echo 'pre-commit: checking formatted L8 sources'
while IFS= read -r -d '' path; do
    case "$path" in
        src2/*.l8|programs/*.l8|tests/*.l8) ;;
        *) continue ;;
    esac
    if grep -Fxq "$path" .githooks/format-excludes; then
        continue
    fi
    if [[ "$path" == src2/* ]] && ! git -C "$repo" show ":$path" | cmp -s - "$path"; then
        echo "unformatted staged source: $path" >&2
        failed=1
        continue
    fi
    if ! ./l8c3 fmt "$path" > .build/pre-commit-format.l8; then
        echo "formatter failed: $path" >&2
        failed=1
    elif ! cmp -s "$path" .build/pre-commit-format.l8; then
        echo "unformatted staged source: $path" >&2
        failed=1
    fi
done < <(git -C "$repo" ls-files -z -- 'src2/*.l8' 'programs/*.l8' 'tests/*.l8')

if (( failed )); then
    echo 'Format the listed files with: ./l8c3 fmt -w <file>, then stage them.' >&2
    exit 1
fi
echo 'pre-commit: build and formatting passed'
