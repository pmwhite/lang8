// Copy a C-string into a counted []i8 so later indexes use len, not a guessed n.
zslice(s: [z]i8): []i8 {
    n: int = 0;
    while (s[n] != 0i8) { n = n + 1; }
    out: []i8 = new i8[n];
    i: int = 0;
    while (s[i] != 0i8) {
        out[i] = s[i];
        i = i + 1;
    }
    out;
}

/* Remaining args of a counted argv. New length prefix; pointers are copied. */
argv_span(argv: [][z]i8, off: int): [][z]i8 {
    n: int = len(argv) - off;
    if (n < 0) { n = 0; }
    raw: []i8 = new i8[n * 8 + 16];
    plen: *int = raw as *int;
    plen.* = n;
    dst: [][z]i8 = (&raw[8]) as [][z]i8;
    i: int = 0;
    while (i < n) {
        dst[i] = argv[off + i];
        i = i + 1;
    }
    dst;
}

cli_streq(a: [z]i8, b: [z]i8): bool {
    i: int = 0;
    while (true) {
        if (a[i] != b[i]) { return false; }
        if (a[i] == 0i8) { return true; }
        i = i + 1;
    }
    false;
}
