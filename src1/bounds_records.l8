tag compiler_internal;

// Quantified array clauses are closed over the element and constants. A
// successful element read can instantiate one clause; a write proves it for
// the replacement value while the other elements retain their old facts.
bounds_array_invariant(sd: *StructDef, member: *Member): ?*ArrayInvariant@sd {
    q: ?*ArrayInvariant = sd.array_invariants;
    while (q != null) {
        if (q.member == member) return q;
        q = q.next
    }
    null
}

bounds_array_field(e: *Expr) raises Error: ?*ArrayInvariant {
    match e.kind {
        MemberAccess k -> {
            member: ?*Member = k.member;
            if (member == null || !member.quantified) return null;
            sd: ?*StructDef = bounds_record_def(k.lhs.ty);
            if (sd == null) return null;
            bounds_array_invariant(sd, member)
        }
        _ -> null
    }
}

bounds_array_predicate(q: *ArrayInvariant@new, value: *Expr) raises Error: *Expr@new {
    bounds_type_invariant_at(q.predicate, q.value, value) or error("internal: invalid forall predicate")
}

bounds_require_array_element(q: *ArrayInvariant@new, value: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds {
    predicate: *Expr = bounds_array_predicate(q, value);
    bounds_require_type_predicate(predicate, f, value.file, value.pos)
}

bounds_require_array_fill(member: *Member, value: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds {
    if (!member.quantified) return;
    q: ?*ArrayInvariant = null;
    sd: ?*StructDef = struct_defs;
    while (sd != null && q == null) {
        q = bounds_array_invariant(sd, member);
        sd = sd.next
    }
    if (q == null) error("internal: missing forall clause");
    match value.kind {
        New k -> {
            fill: ?*Expr = k.fill;
            if (fill == null) error_at_file(value.file, value.pos, "forall array field requires a fill value");
            bounds_require_array_element(q, fill, f)
        }
        ArrayLit k -> {
            item: ?*Expr = k.elems;
            while (item != null) {
                bounds_require_array_element(q, item, f);
                item = item.next
            }
        }
        _ -> error_at_file(value.file, value.pos, "forall array field requires a new or literal array; mutable aliases are not supported")
    }
}

// Two nonnegative sums with the same bounded prefix preserve the order of
// their suffixes. Record constructors can use this when storing both ends of
// a span, including frame addresses with a fixed row stride.
bounds_record_sum_order(
    f: ?*BoundsState@new,
    base: *Expr@new,
    first: *FieldInit@new,
    second: *FieldInit@new
) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    left_member: ?*Member = first.member;
    right_member: ?*Member = second.member;
    left: ?*Expr = first.lhs;
    right: ?*Expr = second.lhs;
    if (left_member == null || right_member == null || left == null || right == null) return f;
    if (!is_int_ty(left_member.ty) || !is_int_ty(right_member.ty) || !bounds_value_stable(left) || !bounds_value_stable(right)) return f;
    match left.kind {
        Binary a -> {
            if (a.op != BinOp.Add) return f;
            match right.kind {
                Binary b -> {
                    if (b.op != BinOp.Add || !bounds_same_term(a.lhs, b.lhs)) return f;
                    if (bounds_small_upper(left, f) < 0 || bounds_small_upper(right,
                        f) < 0 || !bounds_difference_proves(f, a.rhs, b.rhs, 0)) return f;
                    lhs: *Expr = new_member_access(base, left_member.name, left_member);
                    rhs: *Expr = new_member_access(base, right_member.name, right_member);
                    bounds_add_order(f, lhs, rhs, false)
                }
                _ -> f
            }
        }
        _ -> f
    }
}

// Record invariants are obligations at construction and every field write.
bounds_record_facts(base: *Expr@new, inits: ?*FieldInit@new, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@f {
    last_write: ?*FieldInit = null;
    scan: ?*FieldInit = inits;
    while (scan != null) {
        value: ?*Expr = scan.lhs;
        if (value != null && !bounds_value_stable(value)) last_write = scan;
        scan = scan.next
    }
    stable: bool = last_write == null;
    q: ?*FieldInit = inits;
    while (q != null) {
        if (q == last_write) stable = true;
        member: ?*Member = q.member;
        value: ?*Expr = q.lhs;
        if (member != null && value != null) {
            path: *Expr = new_member_access(base, member.name, member);
            if (stable) f = bounds_value_facts(path, value, f) else f = bounds_constant_value(path,
                value, f);
            if (stable && (is_slice(member.ty) || is_array(member.ty)) && bounds_pure_condition(value)) {
                target_length: *Expr = bounds_len_term(path);
                source_length: *Expr = bounds_len_term(value);
                f = bounds_add_relation(f, target_length, source_length, 0);
                f = bounds_add_relation(f, source_length, target_length, 0)
            }
            // A value-record field is copied, so each scalar subfield has the
            // same value as its source at construction.
            nested: ?*StructDef = bounds_record_def(member.ty);
            if (stable && nested != null && bounds_pure_condition(value)) {
                field: ?*Member = nested.members;
                while (field != null) {
                    if (is_int_ty(field.ty)) {
                        target: *Expr = new_member_access(path, field.name, field);
                        source: *Expr = new_member_access(value, field.name, field);
                        f = bounds_add_relation(f, target, source, 0);
                        f = bounds_add_relation(f, source, target, 0)
                    }
                    field = field.next
                }
            }
        }
        q = q.next
    }
    if (last_write == null) {
        first: ?*FieldInit = inits;
        while (first != null) {
            second: ?*FieldInit = inits;
            while (second != null) {
                if (first != second) f = bounds_record_sum_order(f, base, first, second);
                second = second.next
            }
            first = first.next
        }
    }
    f
}

bounds_record_def(t: ?*Type) raises Error: ?*StructDef {
    if (t == null) return null;
    ty: *Type = t;
    if (is_pointer(ty)) ty = type_base(ty);
    match ty.* {
        Record k -> k.def;
        _ -> null
    }
}

bounds_invariant_member(sd: *StructDef, v: *Obj): ?*Member@sd {
    m: ?*Member = sd.members;
    while (m != null) {
        if (m.invariant_var == v) return m;
        m = m.next
    }
    null
}

// Field names in a type invariant are placeholders for paths through the
// record being checked. Reject globals and expressions outside the small
// difference-constraint language rather than silently dropping a promise.
bounds_invariant_map_with(
    e: *Expr@new,
    sd: *StructDef@new,
    base: *Expr@new,
    changed: ?*Member,
    value: ?*Expr
) raises IndexOutOfBounds: ?*Expr@new {
    match e.kind {
        Num k -> new_num(k.val);
        Var k -> {
            v: ?*Obj = k.var;
            if (v == null) return null;
            if (v.is_const && v.const_state == 2 && is_int_ty(v.ty)) return new_num(v.const_val);
            m: ?*Member = bounds_invariant_member(sd, v);
            if (m == null) return null;
            if (m == changed && value != null) return value;
            new_member_access(base, m.name, m)
        }
        MemberAccess k -> {
            lhs: ?*Expr = bounds_invariant_map_with(k.lhs, sd, base, changed, value);
            if (lhs == null) return null;
            mapped: *Expr = mk_expr(ExprKind.MemberAccess { lhs: lhs, name: k.name, member: k.member });
            mapped.ty = e.ty;
            mapped
        }
        Funcall k -> {
            if (!streq(k.funcname, "len") || k.target != null) return null;
            a: ?*Expr = k.args;
            if (a == null) return null;
            if (a.next != null) return null;
            mapped: ?*Expr = bounds_invariant_map_with(a, sd, base, changed, value);
            if (mapped == null) return null;
            bounds_len_term(mapped)
        }
        Binary k -> {
            lhs: ?*Expr = bounds_invariant_map_with(k.lhs, sd, base, changed, value);
            rhs: ?*Expr = bounds_invariant_map_with(k.rhs, sd, base, changed, value);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = new_binary(k.op, lhs, rhs);
            mapped.ty = e.ty;
            mapped
        }
        LogAnd k -> {
            lhs: ?*Expr = bounds_invariant_map_with(k.lhs, sd, base, changed, value);
            rhs: ?*Expr = bounds_invariant_map_with(k.rhs, sd, base, changed, value);
            if (lhs == null || rhs == null) return null;
            mapped: *Expr = mk_expr(ExprKind.LogAnd { lhs: lhs, rhs: rhs });
            mapped.ty = e.ty;
            mapped
        }
        _ -> null
    }
}

bounds_invariant_map(e: *Expr@new, sd: *StructDef@new, base: *Expr@new) raises IndexOutOfBounds: ?*Expr@new {
    bounds_invariant_map_with(e, sd, base, null, null)
}

bounds_record_invariant_facts(sd: *StructDef@new, base: *Expr@new, f: ?*BoundsState@new) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    inv: ?*Expr = sd.invariant;
    if (inv == null) return f;
    mapped: ?*Expr = bounds_invariant_map(inv, sd, base);
    if (mapped == null) return f;
    bounds_condition(mapped, true, f)
}

bounds_record_upper_for_term(whole: *Expr, term: *Expr@new, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    match whole.kind {
        LogAnd k -> bounds_record_upper_for_term(k.lhs, term, f) || bounds_record_upper_for_term(k.rhs,
            term, f);
        Binary k -> {
            if (k.op != BinOp.Le) return false;
            first: ?*BoundsAffine = bounds_affine(k.lhs, true);
            second: ?*BoundsAffine = bounds_affine(term, true);
            if (first == null || second == null) return false;
            if (first.offset != second.offset || !bounds_same_term(first.base, second.base)) return false;
            constant: int = bounds_num(k.rhs);
            if (constant >= 0 && first.offset >= 0) {
                upper: int = bounds_term_numeric_upper(f, first.base);
                return upper >= 0 && upper <= constant - first.offset
            }
            match k.rhs.kind {
                Funcall call -> {
                    a: ?*Expr = call.args;
                    if (!streq(call.funcname, "len") || a == null) return false;
                    if (!bounds_difference_proves(f, first.base, bounds_len_term(a),
                        0 - first.offset)) return false;
                    bounds_difference_proves(f, new_num(0), first.base, first.offset)
                }
                _ -> false
            }
        }
        _ -> false
    }
}

bounds_record_invariant_proved_with(e: *Expr, whole: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    match e.kind {
        LogAnd k -> bounds_record_invariant_proved_with(k.lhs, whole, f) && bounds_record_invariant_proved_with(k.rhs,
            whole, f);
        Binary k -> {
            if (k.op == BinOp.Le && bounds_affine_le_proves(f, k.lhs, k.rhs)) return true;
            if (k.op == BinOp.Le && bounds_num(k.rhs) >= 0) {
                affine_upper: ?*BoundsAffine = bounds_affine(k.lhs, true);
                if (affine_upper != null) {
                    au: *BoundsAffine = affine_upper;
                    upper: int = bounds_term_numeric_upper(f, au.base);
                    if (au.offset >= 0 && upper >= 0 && upper <= bounds_num(k.rhs) - au.offset) return true
                }
            }
            if (k.op == BinOp.Le && bounds_num(k.lhs) == 0 && (bounds_term_numeric_lower(f,
                k.rhs) >= 0 || bounds_difference_proves(f, new_num(0), k.rhs, 0))) return true;
            if (k.op == BinOp.Le && bounds_num(k.lhs) == 0) {
                affine: ?*BoundsAffine = bounds_affine(k.rhs, true);
                if (affine != null) {
                    if (affine.offset >= 0 && bounds_term_numeric_lower(f, affine.base) >= 0 && bounds_record_upper_for_term(whole,
                        k.rhs, f)) return true
                }
            }
            if (k.op == BinOp.Le) {
                match k.rhs.kind {
                    Funcall call -> {
                        a: ?*Expr = call.args;
                        if (streq(call.funcname, "len") && a != null) {
                            if (bounds_count_fits(a, k.lhs, f)) return true;
                            return bounds_record_upper_for_term(whole, k.lhs, f)
                        }
                    }
                    _ -> { }
                }
            }
            bounds_invariant_proved(e, f)
        }
        _ -> false
    }
}

bounds_record_invariant_proved(e: *Expr, f: ?*BoundsState) raises Error, IndexOutOfBounds: bool {
    bounds_record_invariant_proved_with(e, e, f)
}

bounds_record_write_preproved(
    sd: *StructDef@new,
    base: *Expr@new,
    member: *Member,
    value: *Expr,
    f: ?*BoundsState@new
) raises Error, IndexOutOfBounds: bool {
    if (!bounds_pure_condition(value)) return false;
    inv: ?*Expr = sd.invariant;
    if (inv == null) return false;
    mapped: ?*Expr = bounds_invariant_map_with(inv, sd, base, member, value);
    if (mapped == null) return false;
    bounds_record_invariant_proved(mapped, bounds_record_invariant_facts(sd, base,
        f))
}

bounds_verify_record_invariant(
    sd: *StructDef@new,
    base: *Expr@new,
    f: ?*BoundsState@new,
    file: int,
    pos: int
) raises Error, IndexOutOfBounds: ?*BoundsState@new {
    inv: ?*Expr = sd.invariant;
    if (inv == null) return f;
    mapped: ?*Expr = bounds_invariant_map(inv, sd, base);
    if (mapped == null) error_at_file(file, pos, "record invariant requires stable field paths and supported comparisons");
    if (!bounds_infer_mode && !bounds_record_invariant_proved(mapped, f)) error_at_file(file,
        pos, "record invariant is not proved after construction or field assignment");
    bounds_condition(mapped, true, f)
}

bounds_verify_record_constructor(e: *Expr@new, inits: ?*FieldInit@new, f: ?*BoundsState@new) noregion raises Error, IndexOutOfBounds {
    sd: ?*StructDef = bounds_record_def(e.ty);
    if (sd == null) return;
    if (sd.invariant == null) return;
    saved_locals: ?*Obj = locals;
    saved_scope: ?*Obj = scope_locals;
    temp: *Obj = new_obj(".record-invariant", true);
    temp.ty = e.ty;
    base: *Expr = bounds_obj_expr(temp);
    facts: ?*BoundsState = bounds_record_facts(base, inits, f);
    _verified: ?*BoundsState = bounds_verify_record_invariant(sd, base, facts, e.file,
        e.pos);
    locals = saved_locals;
    scope_locals = saved_scope
}
