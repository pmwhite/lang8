// L8 self-hosted compiler â†’ x86-64 Linux GAS
// Nominal AST; Type is a sum; Expr/Stmt are typed envelopes.
// Heap ADTs via new; aggregates by sret; *T vs ?*T with flow narrowing; `e or alt` unwraps ?*T and ?[]T.
// Assignment and taking a name's address kill narrowing and [z]T walk facts for that name.
// Strings: "..." or """...""" (newlines kept; a newline right after """ is dropped).
// Same escapes in both. Byte literals: 'A' and Ni8 (0..255); i8 arithmetic wraps, no mixed promotion.
// *T is one object: p.* only, no p[i]. []T is a thin pointer with len at -8.
// ?*T / ?[]T are null or the non-optional form; `if (x != null)` and `x or y` unwrap.
// [z]T is a read-only C-string; s[i] only if walked from 0. &s[i] on [z]T stays [z]T.
// `as` only forgets a claim (same pointee): []T/*T â†’ *T or ?*T. It cannot invent or strip [z].
// A span of an existing []T is the array plus a start index.
// Globals: `name: type = e` is required. Constants go in .data; other inits run once before main.
// write/read take []i8 (optional off/n, checked) or *i8 (exactly one byte).
// Each function is analyzed in isolation to a lifetime signature: the
// minimum each parameter must last, and the longest the return may be
// relied upon. `@` marks document that signature and must match it.
// An omitted parameter bound means the value need only last the call
// (same as `T@` / `T@p`). `@immortal` is process lifetime. `@new` is the
// heap generation at the call. A name `@q` means the parameter outlives `q`.
// An omitted return bound means immortal. Address of a local cannot be
// stored, returned, or passed except to write/read or a self-bound parameter.
// `region { }` saves the bump pointer and restores it on exit, return, and
// exception unwind. `new` inside is in that heap generation. Nested regions nest.
// Exception payloads are allocated off the rewindable heap. A payload may hold
// immortal pointers, or heaptop pointers. A function that stashes `new` into
// immortal storage (a global, exception payload, or immortal parameter) must be
// marked `noregion` after `)`. Returning `new` is not a stash: the return type
// must say `@new`. Writing `noregion` is exact and transitive: a caller of a
// `noregion` function must be `noregion` too. Those functions cannot be
// called from a region.
// Region pointers and `&local` cannot be raised.
// Long-lived storage cannot hold a shorter pointer.
// Unknown names are an error. OS functions are `extern name(params): T` backed by runtime.s.
// Shared libraries: top-level `need "libfoo.so";` plus `extern` names not defined in runtime.s.
// Bitwise: `~ & ^ | << >>` on int/i8 (same type; >> is arithmetic; shift count is int).
// `for i in a..b` is exclusive over int; `for x in xs` walks `[]T` (not `[z]T`).
// The item is a per-iteration copy (array) or the induction variable (range).
// `if`/`match`/`{ }` are expressions; a block's last statement is its value (`;` does not discard).
// Function body uses that rule when a return type is declared; last-statement and `return` share assignable.
// `return expr` in tail position and ignored values in returning functions are warnings.
// Semicolon after statements and non-brace decls; not after `}`.
// noreturn return type; checked exceptions (exception/raises/raise/try/with).
// Locals: `x: T;` is unassigned; use before assign on all paths is an error. No `uninitialized`.
// `new T[n](v)` fills every slot with v (evaluated once). No implicit element default.
// n must fit the 64MiB heap: negative or wrapping n * size is rejected.
// Calls follow SysV: six argument registers, then the stack. Hidden sret is the first incoming slot.
// Pipeline: parse (syntax, including comments) â†’ typecheck (fills Obj/Member/Function) â†’
// unused fn/local + raises/noreturn checks â†’ codegen.
// Parse does not load imports or require types; a later pass follows imports for compile.
// Fmt prints the same tree with one canonical layout.
// This compiler reports failures via `exception Error` (caught in main).
type Type =
    | Int
    | I8
    | Bool
    | Noreturn
    | Ptr { base: *Type }
    | OptPtr { base: *Type }
    | Slice { base: *Type }
    | OptSlice { base: *Type }
    | ZPtr { base: *Type }
    | Record { def: *StructDef }
    | Enum { def: *EnumDef }
    | Exn { def: *ExnDef };

type Com = {
    text: []i8;
    pos: int;
    nls: int;
    next: ?*Com;
};

type Member = {
    name: []i8;
    offset: int;
    ty: *Type;
    next: ?*Member;
    lead: ?*Com;
    trail: ?*Com;
    browse_id: int;
    browse_pos: int;
    browse_file: int;
    browse_len: int;
};

type StructDef = {
    name: []i8;
    members: ?*Member;
    size: int;
    ty: ?*Type;
    next: ?*StructDef;
    hash_next: ?*StructDef;
    ptr_walk: int;
    lead: ?*Com;
    trail: ?*Com;
    browse_id: int;
    browse_pos: int;
    browse_file: int;
    browse_len: int;
};

type Variant = {
    name: []i8;
    tag: int;
    fields: ?*Member;
    payload_ty: ?*Type;
    payload_size: int;
    next: ?*Variant;
    lead: ?*Com;
    trail: ?*Com;
    browse_id: int;
    browse_pos: int;
    browse_file: int;
    browse_len: int;
};

type EnumDef = {
    name: []i8;
    variants: ?*Variant;
    size: int;
    ty: ?*Type;
    next: ?*EnumDef;
    hash_next: ?*EnumDef;
    ptr_walk: int;
    lead: ?*Com;
    trail: ?*Com;
    browse_id: int;
    browse_pos: int;
    browse_file: int;
    browse_len: int;
};

type ExnDef = {
    name: []i8;
    tag: int;
    members: ?*Member;
    size: int;
    ty: ?*Type;
    next: ?*ExnDef;
    hash_next: ?*ExnDef;
    lead: ?*Com;
    trail: ?*Com;
    browse_id: int;
    browse_pos: int;
    browse_file: int;
    browse_len: int;
};

type ExnList = {
    exn: *ExnDef;
    seen: int;
    next: ?*ExnList;
};

type ImportedFile = {
    path: []i8;
    src: []i8;
    src_len: int;
    id: int;
    next: ?*ImportedFile;
};

type BrowseOcc = {
    file: int;
    pos: int;
    len: int;
    sym: int;
    is_def: int;
    cls: int;
    typ: []i8;
    next: ?*BrowseOcc;
    hash_next: ?*BrowseOcc;
};

type BrowseBucket = {
    head: ?*BrowseOcc;
};

type TokKind =
    | Eof
    | Num
    | Char
    | Str
    | Ident
    | Int
    | I8
    | Bool
    | True
    | False
    | Null
    | Noreturn
    | If
    | Else
    | While
    | For
    | In
    | Return
    | TypeKw
    | Sizeof
    | As
    | Trunc
    | New
    | Eq
    | Ne
    | Le
    | Ge
    | Shl
    | Shr
    | Caret
    | Tilde
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Lt
    | Gt
    | Assign
    | Not
    | Amp
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBrack
    | RBrack
    | Semi
    | Comma
    | Colon
    | And
    | Or
    | OrKw
    | Dot
    | DotDot
    | Match
    | Pipe
    | Arrow
    | Question
    | Exception
    | Raises
    | Raise
    | Try
    | With
    | Import
    | Extern
    | Region
    | At
    | Comment;

type Token = {
    kind: TokKind;
    val: int;
    str: *i8;
    len: int;
    pos: int;
    next: *Token;
};

type FieldInit = {
    name: []i8;
    member: ?*Member;
    lhs: ?*Expr;
    next: ?*FieldInit;
    lead: ?*Com;
    trail: ?*Com;
    pos: int;
    file: int;
    toklen: int;
};

type MatchArm = {
    name: []i8;
    variant: ?*Variant;
    binder: ?*Obj;
    binder_name: []i8;
    paren: int;
    body: *Stmt;
    next: ?*MatchArm;
    lead: ?*Com;
    trail: ?*Com;
    pos: int;
    file: int;
    toklen: int;
};

type CatchArm = {
    name: []i8;
    exn: ?*ExnDef;
    binder: ?*Obj;
    binder_name: []i8;
    paren: int;
    body: *Stmt;
    next: ?*CatchArm;
    lead: ?*Com;
    trail: ?*Com;
    pos: int;
    file: int;
    toklen: int;
};

type BinOp =
    | Add
    | Sub
    | Mul
    | Div
    | Mod
    | Shl
    | Shr
    | And
    | Xor
    | Or
    | Eq
    | Ne
    | Lt
    | Le
    | Gt
    | Ge;

type ExprKind =
    | Num { val: int, str_label: int, form: int }
    | Null
    | Var { var: ?*Obj, name: []i8, member: ?*Member }
    | Binary { op: BinOp, lhs: *Expr, rhs: *Expr }
    | Assign { lhs: *Expr, rhs: *Expr }
    | Addr { lhs: *Expr }
    | Deref { lhs: *Expr }
    | Index { lhs: *Expr, idx: *Expr }
    | Not { lhs: *Expr }
    | Neg { lhs: *Expr }
    | BitNot { lhs: *Expr }
    | LogAnd { lhs: *Expr, rhs: *Expr }
    | LogOr { lhs: *Expr, rhs: *Expr }
    | OrElse { lhs: *Expr, rhs: *Expr }
    | Funcall { funcname: []i8, args: ?*Expr, fn: ?*Function }
    | MemberAccess { lhs: *Expr, name: []i8, member: ?*Member }
    | As { lhs: *Expr }
    | Trunc { lhs: *Expr }
    | New {
        lhs: ?*Expr,
        val: int,
        inits: ?*FieldInit,
        variant: ?*Variant,
        fill: ?*Expr,
        vname: []i8
    }
    | StructLit { name: []i8, inits: ?*FieldInit }
    | VariantLit {
        tyname: []i8,
        name: []i8,
        variant: ?*Variant,
        val: int,
        inits: ?*FieldInit
    }
    | If { cond: *Expr, then: *Expr, els: *Expr }
    | Match { cond: *Expr, arms: ?*MatchArm }
    | Block { body: ?*Stmt }
    | Sizeof { ty: ?*Type, e: ?*Expr };

type Expr = {
    kind: ExprKind;
    next: ?*Expr;
    ty: ?*Type;
    pos: int;
    file: int;
    toklen: int;
};

type StmtKind =
    | Return { lhs: ?*Expr }
    | If { cond: *Expr, then: *Stmt, els: ?*Stmt }
    | While { cond: *Expr, body: *Stmt }
    | For {
        item: *Obj,
        coll: ?*Obj,
        idx: ?*Obj,
        n: *Obj,
        iter: *Expr,
        hi: ?*Expr,
        body: *Stmt
    }
    | Block { body: ?*Stmt }
    | ExprStmt { lhs: *Expr }
    | Decl {
        name: []i8,
        ty: *Type,
        init: ?*Expr,
        var: ?*Obj
    }
    | Match { cond: *Expr, arms: ?*MatchArm }
    | Raise {
        name: []i8,
        exn: ?*ExnDef,
        inits: ?*FieldInit,
        has: int
    }
    | Try { body: *Stmt, arms: ?*CatchArm, buf: *Obj }
    | Region { body: *Stmt, mark: *Obj }
    | Comment { text: []i8 };

type Stmt = {
    kind: StmtKind;
    next: ?*Stmt;
    lead: ?*Com;
    trail: ?*Com;
    pos: int;
    end: int;
};

type Obj = {
    name: []i8;
    is_local: int;
    is_func: int;
    offset: int;
    scope_depth: int;
    ty: ?*Type;
    used: int;
    init: ?*Expr;
    next: ?*Obj;
    param_next: ?*Obj;
    hash_next: ?*Obj;
    escape_walk: int;
    life: int;
    storage_life: int;
    life_bound: []i8;
    bound_need_imm: int;
    bound_need_new: int;
    bound_named: ?*Obj;
    browse_id: int;
    browse_pos: int;
    browse_file: int;
    browse_len: int;
    lead: ?*Com;
    trail: ?*Com;
};

type BoundCall = {
    caller_param: *Obj;
    callee_param: *Obj;
    next: ?*BoundCall;
};

type CallEdge = {
    callee: *Function;
    next: ?*CallEdge;
};

type Function = {
    name: []i8;
    nparams: int;
    params: ?*Obj;
    locals: ?*Obj;
    body: ?*Stmt;
    stack_size: int;
    return_ty: ?*Type;
    sret: ?*Obj;
    raises_list: ?*ExnList;
    used: int;
    is_extern: int;
    next: ?*Function;
    hash_next: ?*Function;
    ret_bound: []i8;
    ret_life: int;
    need_imm_heap: int;
    imm_heap_direct: int;
    decl_imm_heap: int;
    bound_ret_need_new: int;
    bound_ret_param: ?*Obj;
    bound_calls: ?*BoundCall;
    callees: ?*CallEdge;
    browse_id: int;
    browse_pos: int;
    browse_file: int;
    browse_len: int;
    lead: ?*Com;
    trail: ?*Com;
};

type ItemKind =
    | Import { path: []i8, tag: int }
    | Need { name: []i8 }
    | Struct { def: *StructDef }
    | Enum { def: *EnumDef }
    | Exn { def: *ExnDef }
    | Func { fn: *Function }
    | Global { var: *Obj }
    | Comment { text: []i8 };

type NeedLib = {
    name: []i8;
    next: ?*NeedLib;
};

type Item = {
    kind: ItemKind;
    next: ?*Item;
    lead: ?*Com;
    trail: ?*Com;
    pos: int;
};

type FnBucket = {
    head: ?*Function;
};

type ObjBucket = {
    head: ?*Obj;
};

type StructBucket = {
    head: ?*StructDef;
};

type EnumBucket = {
    head: ?*EnumDef;
};

type ExnBucket = {
    head: ?*ExnDef;
};

type StrLit = {
    data: []i8;
    len: int;
    label: int;
    next: ?*StrLit;
};

type InternEnt = {
    s: []i8;
    n: int;
    next: ?*InternEnt;
};

type InternBucket = {
    head: ?*InternEnt;
};

type TyEnt = {
    base: *Type;
    ty: *Type;
    next: ?*TyEnt;
};

source: []i8 = "";

source_len: int = 0;

pos: int = 0;

source_path: []i8 = "";

token_eof: *Token = new Token {
    kind: TokKind.Eof,
    val: 0,
    str: "",
    len: 0,
    pos: 0,
    next: token_eof
};

tok: *Token = new Token {
    kind: TokKind.Eof,
    val: 0,
    str: "",
    len: 0,
    pos: 0,
    next: token_eof
};

parse_follow_imports: int = 1;

parse_resolve: int = 1;

file_items: ?*Item = null;

file_items_tail: ?*Item = null;

g_need: ?*NeedLib = null;

g_need_tail: ?*NeedLib = null;

file_coms: ?*Com = null;

file_coms_tail: ?*Com = null;

com_cur: ?*Com = null;

file_trail: ?*Com = null;

last_close_pos: int = 0;

LIT_INT: int = 0;

LIT_I8: int = 1;

LIT_CHAR: int = 2;

LIT_TRUE: int = 3;

LIT_FALSE: int = 4;

globals: ?*Obj = null;

locals: ?*Obj = null;

scope_locals: ?*Obj = null;

scope_depth: int = 0;

region_depth: int = 0;

functions: ?*Function = null;

LIFE_IMM: int = 0;

LIFE_HEAPTOP: int = 1;

LIFE_SELF: int = 2;

LIFE_MAX: int = 256;

LIFE_KIND_PARAM: int = 3;

life_n: int = 3;

life_heap: int = 0;

life_cur: int = 2;

life_region_tc: int = 1;

life_parent: []int = new int[0](0);

life_kind: []int = new int[0](0);

life_depth_frames: []int = new int[0](0);

life_edge_long: []int = new int[0](0);

life_edge_short: []int = new int[0](0);

life_edge_n: int = 0;

function_tail: ?*Function = null;

imported_files: ?*ImportedFile = null;

current_file_id: int = 0;

browse_file_n: int = 0;

browse_next_id: int = 1;

browse_tok_pos: int = 0;

browse_tok_len: int = 0;

browse_tok_file: int = 0;

browse_occs: ?*BrowseOcc = null;

BROWSE_BUCK: int = 4096;

browse_buckets: []BrowseBucket = new BrowseBucket[0](BrowseBucket { head: null });

BROWSE_VAR: int = 0;

BROWSE_FN: int = 1;

BROWSE_TY: int = 2;

BROWSE_FIELD: int = 3;

struct_defs: ?*StructDef = null;

enum_defs: ?*EnumDef = null;

exn_defs: ?*ExnDef = null;

SYM_SIZE: int = 1024;

fn_buckets: []FnBucket = new FnBucket[0](FnBucket { head: null });

global_buckets: []ObjBucket = new ObjBucket[0](ObjBucket { head: null });

struct_buckets: []StructBucket = new StructBucket[0](StructBucket { head: null });

enum_buckets: []EnumBucket = new EnumBucket[0](EnumBucket { head: null });

exn_buckets: []ExnBucket = new ExnBucket[0](ExnBucket { head: null });

intern_buckets: []InternBucket = new InternBucket[0](InternBucket { head: null });

ptr_cache: ?*TyEnt = null;

opt_ptr_cache: ?*TyEnt = null;

slice_cache: ?*TyEnt = null;

opt_slice_cache: ?*TyEnt = null;

zptr_cache: ?*TyEnt = null;

oob_lab: int = 0;

next_exn_tag: int = 0;

field_list_size: int = 0;

ty_int: *Type = new Type.Int;

ty_i8: *Type = new Type.I8;

ty_bool: *Type = new Type.Bool;

ty_noreturn: *Type = new Type.Noreturn;

ty_jmpbuf: *Type = new Type.Int;

str_lits: ?*StrLit = null;

str_lit_tail: ?*StrLit = null;

str_count: int = 0;

label_id: int = 0;

cg_region_depth: int = 0;

emit_buf: []i8 = "";

emit_len: int = 0;

emit_cap: int = 65536;

do_profile: int = 0;

mark_nerr: int = 0;

current_fn_name: []i8 = "";

current_return_lab: int = 0;

current_return_ty: ?*Type = null;

current_sret: ?*Obj = null;

current_fn: ?*Function = null;

count_var_use: int = 1;

type NarrowFrame = {
    var: ?*Obj;
    ty: ?*Type;
    next: ?*NarrowFrame;
};

narrow_top: ?*NarrowFrame = null;

type WalkFrame = {
    str: ?*Obj;
    hi: int;
    cursor: ?*Obj;
    next: ?*WalkFrame;
};

walk_top: ?*WalkFrame = null;

zero_top: ?*WalkFrame = null;

type CatchFrame = {
    exn: *ExnDef;
    next: ?*CatchFrame;
};

catch_top: ?*CatchFrame = null;

type InitFrame = {
    var: *Obj;
    next: ?*InitFrame;
};

init_top: ?*InitFrame = null;

taint_top: ?*InitFrame = null;

addr_top: ?*InitFrame = null;

L8_JMP_BUF_SIZE: int = 72;

exception Error {
    msg: []i8;
    pos: int;
    path: []i8;
    src: []i8;
    src_len: int;
};

streq_n(
    a: []i8,
    ai: int,
    b: []i8,
    bi: int,
    n: int
): bool {
    for i in 0..n {
        if (a[ai + i] != b[bi + i]) {
            return false;
        }
    }
    true;
}

streq(a: []i8, b: []i8): bool {
    if (a == b) {
        return true;
    }
    if (len(a) != len(b)) {
        return false;
    }
    streq_n(a, 0, b, 0, len(a));
}

add_need(name: []i8@new) noregion {
    p: ?*NeedLib = g_need;
    while (p != null) {
        if (streq(p.name, name)) {
            return;
        }
        p = p.next;
    }
    n: *NeedLib = new NeedLib {
        name: name,
        next: null
    };
    t: ?*NeedLib = g_need_tail;
    if (t != null) {
        t.next = n;
    } else {
        g_need = n;
    }
    g_need_tail = n;
}

name_eq_span(
    name: []i8,
    s: []i8,
    off: int,
    n: int
): bool {
    if (len(name) != n) {
        false;
    } else {
        streq_n(name, 0, s, off, n);
    }
}

hash_n(s: []i8, off: int, n: int): int {
    h: int = 5381;
    i: int = 0;
    while (i < n) {
        h = (h << 5) + h + s[off + i] as int;
        i = i + 1;
    }
    h;
}

hash_str(s: []i8): int {
    h: int = 5381;
    for c in s {
        h = (h << 5) + h + c as int;
    }
    h;
}

sym_bucket(h: int): int {
    if (h < 0) {
        h = 0 - h;
    }
    h & SYM_SIZE - 1;
}

clear_sym_tables() {
    for i in 0..SYM_SIZE {
        fn_buckets[i].head = null;
        global_buckets[i].head = null;
        struct_buckets[i].head = null;
        enum_buckets[i].head = null;
        exn_buckets[i].head = null;
    }
}

strdup_n(s: []i8, off: int, n: int): []i8@new {
    p: []i8 = new i8[n](0i8);
    memcpy(p, 0, s, off, n);
    p;
}

emit_flush() {
    if (emit_len > 0) {
        write(1, emit_buf, emit_len);
        emit_len = 0;
    }
}

emit(s: []i8) {
    n: int = len(s);
    if (n <= 0) {
        return;
    }
    if (n > emit_cap) {
        emit_flush();
        write(1, s, n);
        return;
    }
    if (emit_len + n > emit_cap) {
        emit_flush();
    }
    memcpy(emit_buf, emit_len, s, 0, n);
    emit_len = emit_len + n;
}

emit_ch(c: i8) {
    if (emit_len >= emit_cap) {
        emit_flush();
    }
    emit_buf[emit_len] = c;
    emit_len = emit_len + 1;
}

emit_num(n: int) {
    buf: []i8 = new i8[32](0i8);
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        emit_ch('0');
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = '0' + (n % 10) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    need: int = i + neg;
    if (emit_len + need > emit_cap) {
        emit_flush();
    }
    if (neg != 0) {
        emit_buf[emit_len] = '-';
        emit_len = emit_len + 1;
    }
    while (i > 0) {
        i = i - 1;
        emit_buf[emit_len] = buf[i];
        emit_len = emit_len + 1;
    }
}

error(msg: []i8@immortal) raises Error: noreturn {
    raise Error {
        msg: msg,
        pos: tok.pos,
        path: source_path,
        src: source,
        src_len: source_len
    };
}

error_at(p: int, msg: []i8@immortal) raises Error: noreturn {
    raise Error {
        msg: msg,
        pos: p,
        path: source_path,
        src: source,
        src_len: source_len
    };
}

print_error_at(
    path: []i8,
    src: []i8,
    src_len: int,
    pos: int,
    msg: []i8
) {
    line: int = 1;
    col: int = 1;
    i: int = 0;
    while (i < pos && i < src_len) {
        if (src[i] == '\n') {
            line = line + 1;
            col = 1;
        } else {
            col = col + 1;
        }
        i = i + 1;
    }
    write(2, "error: ", len("error: "));
    write(2, path, len(path));
    write(2, ":", len(":"));
    emit_num_fd(2, line);
    write(2, ":", len(":"));
    emit_num_fd(2, col);
    write(2, ": ", len(": "));
    write(2, msg, len(msg));
    write(2, "\n", len("\n"));
}

warn_unused_function(name: []i8) {
    write(2, "warning: unused function ", len("warning: unused function "));
    write(2, name, len(name));
    write(2, "\n", len("\n"));
}

warn_unused_local(fn_name: []i8, name: []i8) {
    write(2, "warning: unused local ", len("warning: unused local "));
    write(2, name, len(name));
    write(2, " in ", len(" in "));
    write(2, fn_name, len(fn_name));
    write(2, "\n", len("\n"));
}

warn_unnecessary_return(fn_name: []i8) {
    write(2, "warning: unnecessary return in ", len("warning: unnecessary return in "));
    write(2, fn_name, len(fn_name));
    write(2, "\n", len("\n"));
}

warn_ignored_value(fn_name: []i8) {
    write(2, "warning: ignored return value in ", len("warning: ignored return value in "));
    write(2, fn_name, len(fn_name));
    write(2, "\n", len("\n"));
}

ignore_unused_local_name(name: []i8): bool {
    if (len(name) == 0) {
        return false;
    }
    c: i8 = name[0];
    c == '.' || c == '_';
}

type StrBuf = {
    data: []i8;
    len: int;
    cap: int;
};

sb_new(): *StrBuf@new {
    new StrBuf { data: new i8[64](0i8), len: 0, cap: 64 };
}

sb_grow(sb: *StrBuf@new, need: int) {
    if (sb.len + need <= sb.cap) {
        return;
    }
    ncap: int = sb.cap;
    while (ncap < sb.len + need) {
        ncap = ncap * 2;
    }
    nd: []i8 = new i8[ncap](0i8);
    memcpy(nd, 0, sb.data, 0, sb.len);
    sb.data = nd;
    sb.cap = ncap;
}

sb_putc(sb: *StrBuf@new, c: i8) {
    sb_grow(sb, 1);
    sb.data[sb.len] = c;
    sb.len = sb.len + 1;
}

sb_puts(sb: *StrBuf@new, s: []i8) {
    n: int = len(s);
    sb_grow(sb, n);
    memcpy(sb.data, sb.len, s, 0, n);
    sb.len = sb.len + n;
}

sb_finish(sb: *StrBuf): []i8@new {
    strdup_n(sb.data, 0, sb.len);
}

browse_fresh(): int {
    id: int = browse_next_id;
    browse_next_id = browse_next_id + 1;
    id;
}

browse_note() {
    browse_tok_pos = tok.pos;
    browse_tok_len = tok.len;
    browse_tok_file = current_file_id;
}

browse_hash(file: int, pos: int): int {
    h: int = file * 1000003 + pos;
    if (h < 0) {
        h = 0 - h;
    }
    h % BROWSE_BUCK;
}

browse_find(file: int, pos: int): ?*BrowseOcc {
    if (len(browse_buckets) == 0) {
        return null;
    }
    o: ?*BrowseOcc = browse_buckets[browse_hash(file, pos)].head;
    while (o != null) {
        if (o.file == file && o.pos == pos) {
            return o;
        }
        o = o.hash_next;
    }
    null;
}

browse_add(
    file: int,
    pos: int,
    n: int,
    sym: int,
    is_def: int,
    cls: int,
    typ: []i8@new
) noregion {
    if (n <= 0) {
        return;
    }
    if (browse_find(file, pos) != null) {
        return;
    }
    if (len(browse_buckets) == 0) {
        browse_buckets = new BrowseBucket[4096](BrowseBucket { head: null });
    }
    o: *BrowseOcc = new BrowseOcc {
        file: file,
        pos: pos,
        len: n,
        sym: sym,
        is_def: is_def,
        cls: cls,
        typ: typ,
        next: browse_occs,
        hash_next: browse_buckets[browse_hash(file, pos)].head
    };
    browse_occs = o;
    browse_buckets[browse_hash(file, pos)].head = o;
}

browse_type_str(t: ?*Type) noregion raises Error: []i8@new {
    sb: *StrBuf = sb_new();
    append_type(sb, t);
    sb_finish(sb);
}

browse_fn_str(fn: *Function) noregion raises Error: []i8@new {
    sb: *StrBuf = sb_new();
    sb_puts(sb, "fn ");
    sb_puts(sb, fn.name);
    sb_putc(sb, '(');
    p: ?*Obj = fn.params;
    first: int = 1;
    while (p != null) {
        if (first == 0) {
            sb_puts(sb, ", ");
        }
        first = 0;
        sb_puts(sb, p.name);
        sb_puts(sb, ": ");
        append_type(sb, p.ty);
        p = p.param_next;
    }
    sb_putc(sb, ')');
    if (fn.decl_imm_heap != 0) {
        sb_puts(sb, " noregion");
    }
    if (fn.return_ty != null) {
        sb_puts(sb, ": ");
        append_type(sb, fn.return_ty);
    }
    sb_finish(sb);
}

browse_reset() noregion {
    browse_occs = null;
    browse_next_id = 1;
    browse_file_n = 0;
    current_file_id = 0;
    browse_tok_pos = 0;
    browse_tok_len = 0;
    browse_tok_file = 0;
    browse_buckets = new BrowseBucket[4096](BrowseBucket { head: null });
}

append_type(sb: *StrBuf@immortal, t: ?*Type) raises Error {
    if (t == null) {
        sb_puts(sb, "<unknown>");
        return;
    }
    match t.* {
        Int -> {
            sb_puts(sb, "int");
            return;
        }
        I8 -> {
            sb_puts(sb, "i8");
            return;
        }
        Bool -> {
            sb_puts(sb, "bool");
            return;
        }
        Noreturn -> {
            sb_puts(sb, "noreturn");
            return;
        }
        Ptr k -> {
            sb_putc(sb, '*');
            append_type(sb, k.base);
            return;
        }
        OptPtr k -> {
            sb_puts(sb, "?*");
            append_type(sb, k.base);
            return;
        }
        Slice k -> {
            sb_puts(sb, "[]");
            append_type(sb, k.base);
            return;
        }
        OptSlice k -> {
            sb_puts(sb, "?[]");
            append_type(sb, k.base);
            return;
        }
        ZPtr k -> {
            sb_puts(sb, "[z]");
            append_type(sb, k.base);
            return;
        }
        Record k -> {
            sb_puts(sb, k.def.name);
            return;
        }
        Enum k -> {
            sb_puts(sb, k.def.name);
            return;
        }
        Exn k -> {
            sb_puts(sb, k.def.name);
            return;
        }
    }
}

error_ty(msg: []i8, t: ?*Type) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": ");
    append_type(sb, t);
    error(sb_finish(sb));
}

error_ty_vs(msg: []i8, a: ?*Type, b: ?*Type) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": ");
    append_type(sb, a);
    sb_puts(sb, " vs ");
    append_type(sb, b);
    error(sb_finish(sb));
}

error_have_want(msg: []i8, have: ?*Type, want: ?*Type) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_type(sb, have);
    sb_puts(sb, ", want ");
    append_type(sb, want);
    error(sb_finish(sb));
}

error_have_and(msg: []i8, a: ?*Type, b: ?*Type) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_type(sb, a);
    sb_puts(sb, " and ");
    append_type(sb, b);
    error(sb_finish(sb));
}

append_expr_ty(sb: *StrBuf@immortal, e: ?*Expr) raises Error {
    if (e == null) {
        append_type(sb, null);
        return;
    }
    if (e.ty != null) {
        append_type(sb, decay(e.ty));
        return;
    }
    if (is_null_expr(e)) {
        sb_puts(sb, "null");
        return;
    }
    append_type(sb, null);
}

error_have_expr_want(msg: []i8, have: ?*Expr, want: ?*Type) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, msg);
    sb_puts(sb, ": have ");
    append_expr_ty(sb, have);
    sb_puts(sb, ", want ");
    append_type(sb, want);
    error(sb_finish(sb));
}

emit_num_fd(fd: int, n: int) {
    buf: []i8 = new i8[32](0i8);
    neg: int = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    if (n == 0) {
        z: i8 = '0';
        write(fd, &z, 1);
        return;
    }
    i: int = 0;
    while (n > 0) {
        buf[i] = '0' + (n % 10) trunc i8;
        n = n / 10;
        i = i + 1;
    }
    if (neg != 0) {
        m: i8 = '-';
        write(fd, &m, 1);
    }
    while (i > 0) {
        i = i - 1;
        ch: i8 = buf[i];
        write(fd, &ch, 1);
    }
}

init_dummies() noregion {
    token_eof = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        pos: 0,
        next: token_eof
    };
    token_eof.next = token_eof;
}

init_runtime() noregion {
    ty_int = new Type.Int;
    ty_i8 = new Type.I8;
    ty_bool = new Type.Bool;
    ty_noreturn = new Type.Noreturn;
    jd: *StructDef = new StructDef {
        name: ".jmpbuf",
        members: null,
        size: L8_JMP_BUF_SIZE,
        ty: null,
        next: null,
        hash_next: null,
        ptr_walk: 0,
        lead: null,
        trail: null,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    ty_jmpbuf = struct_type(jd);
    exn_defs = null;
    next_exn_tag = 1;
    catch_top = null;
    current_fn = null;
    emit_buf = new i8[emit_cap](0i8);
    emit_len = 0;
    fn_buckets = new FnBucket[1024](FnBucket { head: null });
    global_buckets = new ObjBucket[1024](ObjBucket { head: null });
    struct_buckets = new StructBucket[1024](StructBucket { head: null });
    enum_buckets = new EnumBucket[1024](EnumBucket { head: null });
    exn_buckets = new ExnBucket[1024](ExnBucket { head: null });
    intern_buckets = new InternBucket[4096](InternBucket { head: null });
    life_parent = new int[256](0 - 1);
    life_kind = new int[256](0);
    life_depth_frames = new int[256](0);
    life_edge_long = new int[256](0);
    life_edge_short = new int[256](0);
    ptr_cache = null;
    opt_ptr_cache = null;
    slice_cache = null;
    opt_slice_cache = null;
    zptr_cache = null;
    walk_top = null;
    zero_top = null;
    cg_labbuf = new i8[64](0i8);
    str_lits = null;
    str_lit_tail = null;
    str_count = 0;
}

read_file(path: []i8) raises Error: []i8@new {
    fd: int = open_path(path, 0, 0);
    if (fd < 0) {
        error("cannot open file");
    }
    cap: int = 524288;
    buf: []i8 = new i8[cap](0i8);
    n: int = 0;
    while (true) {
        room: int = cap - n;
        if (room <= 1) {
            cap = cap * 2;
            tmp: []i8 = new i8[cap](0i8);
            memcpy(tmp, 0, buf, 0, n);
            buf = tmp;
            room = cap - n;
        }
        r: int = read(fd, buf, n, room - 1);
        if (r <= 0) {
            buf[n] = 0i8;
            close(fd);
            source_len = n;
            return buf;
        }
        n = n + r;
    }
    buf;
}

normalize_path(path: []i8): []i8@new {
    p: []i8 = path;
    n: int = len(p);
    out: []i8 = new i8[n + 2](0i8);
    starts: []int = new int[n + 1](0);
    out_len: int = 0;
    nseg: int = 0;
    absolute: bool = n > 0 && p[0] == '/';
    if (absolute) {
        out[0] = '/';
        out_len = 1;
    }
    i: int = 0;
    while (i < n) {
        while (i < n && p[i] == '/') {
            i = i + 1;
        }
        if (i >= n) {
            i = n;
        } else {
            start: int = i;
            while (i < n && p[i] != '/') {
                i = i + 1;
            }
            part_len: int = i - start;
            is_dot: bool = part_len == 1 && p[start] == '.';
            is_dotdot: bool = part_len == 2 && p[start] == '.' && p[start + 1] == '.';
            if (is_dot) {
                /* nothing */
            } else if (is_dotdot && nseg > 0) {
                nseg = nseg - 1;
                out_len = starts[nseg];
            } else {
                starts[nseg] = out_len;
                nseg = nseg + 1;
                if (out_len > 0 && out[out_len - 1] != '/') {
                    out[out_len] = '/';
                    out_len = out_len + 1;
                }
                j: int = 0;
                while (j < part_len) {
                    out[out_len] = p[start + j];
                    out_len = out_len + 1;
                    j = j + 1;
                }
            }
        }
    }
    if (out_len == 0) {
        out[0] = '.';
        out_len = 1;
    }
    result: []i8 = new i8[out_len](0i8);
    memcpy(result, 0, out, 0, out_len);
    result;
}

resolve_import_path(base: []i8, imported: []i8): []i8@new {
    if (len(imported) > 0 && imported[0] == '/') {
        return normalize_path(imported);
    }
    base_len: int = len(base);
    slash: int = 0 - 1;
    i: int = 0;
    while (i < base_len) {
        if (base[i] == '/') {
            slash = i;
        }
        i = i + 1;
    }
    if (slash < 0) {
        return normalize_path(imported);
    }
    ilen: int = len(imported);
    joined: []i8 = new i8[slash + 1 + ilen](0i8);
    j: int = 0;
    while (j <= slash) {
        joined[j] = base[j];
        j = j + 1;
    }
    memcpy(joined, j, imported, 0, ilen);
    normalize_path(joined);
}

mark_imported(path: []i8@immortal) noregion: bool {
    f: ?*ImportedFile = imported_files;
    while (f != null) {
        if (streq(f.path, path)) {
            return false;
        }
        f = f.next;
    }
    imported_files = new ImportedFile {
        path: path,
        src: "",
        src_len: 0,
        id: browse_file_n,
        next: imported_files
    };
    browse_file_n = browse_file_n + 1;
    true;
}

type_size(t: *Type): int {
    match t.* {
        Int -> {
            8;
        }
        I8 -> {
            1;
        }
        Bool -> {
            1;
        }
        Ptr _p -> {
            8;
        }
        OptPtr _p -> {
            8;
        }
        Slice _p -> {
            8;
        }
        OptSlice _p -> {
            8;
        }
        ZPtr _p -> {
            8;
        }
        Record k -> {
            k.def.size;
        }
        Enum k -> {
            if (k.def.size <= 0) {
                8;
            } else {
                k.def.size;
            }
        }
        Exn k -> {
            k.def.size;
        }
        Noreturn -> {
            0;
        }
    }
}

type_base(t: *Type) raises Error: *Type {
    match t.* {
        Ptr k -> {
            k.base;
        }
        OptPtr k -> {
            k.base;
        }
        Slice k -> {
            k.base;
        }
        OptSlice k -> {
            k.base;
        }
        ZPtr k -> {
            k.base;
        }
        _ -> {
            error("not a pointer or slice");
        }
    }
}

type_struct_def(t: *Type) raises Error: *StructDef {
    match t.* {
        Record k -> {
            k.def;
        }
        _ -> {
            error("not a record type");
        }
    }
}

type_enum_def(t: *Type) raises Error: *EnumDef {
    match t.* {
        Enum k -> {
            k.def;
        }
        _ -> {
            error("not an enum type");
        }
    }
}

type_exn_def(t: *Type) raises Error: *ExnDef {
    match t.* {
        Exn k -> {
            k.def;
        }
        _ -> {
            error("not an exception type");
        }
    }
}

ptr_to(base: *Type@immortal) noregion: *Type@new {
    e: ?*TyEnt = ptr_cache;
    while (e != null) {
        if (e.base == base) {
            return e.ty;
        }
        e = e.next;
    }
    t: *Type = new Type.Ptr { base: base };
    ptr_cache = new TyEnt { base: base, ty: t, next: ptr_cache };
    t;
}

opt_ptr_to(base: *Type@immortal) noregion: *Type@new {
    e: ?*TyEnt = opt_ptr_cache;
    while (e != null) {
        if (e.base == base) {
            return e.ty;
        }
        e = e.next;
    }
    t: *Type = new Type.OptPtr { base: base };
    opt_ptr_cache = new TyEnt { base: base, ty: t, next: opt_ptr_cache };
    t;
}

slice_of(base: *Type@immortal) noregion: *Type@new {
    e: ?*TyEnt = slice_cache;
    while (e != null) {
        if (e.base == base) {
            return e.ty;
        }
        e = e.next;
    }
    t: *Type = new Type.Slice { base: base };
    slice_cache = new TyEnt { base: base, ty: t, next: slice_cache };
    t;
}

opt_slice_of(base: *Type@immortal) noregion: *Type@new {
    e: ?*TyEnt = opt_slice_cache;
    while (e != null) {
        if (e.base == base) {
            return e.ty;
        }
        e = e.next;
    }
    t: *Type = new Type.OptSlice { base: base };
    opt_slice_cache = new TyEnt { base: base, ty: t, next: opt_slice_cache };
    t;
}

zptr_of(base: *Type@immortal) noregion: *Type@new {
    e: ?*TyEnt = zptr_cache;
    while (e != null) {
        if (e.base == base) {
            return e.ty;
        }
        e = e.next;
    }
    t: *Type = new Type.ZPtr { base: base };
    zptr_cache = new TyEnt { base: base, ty: t, next: zptr_cache };
    t;
}

struct_type(sd: *StructDef@new): *Type@new {
    existing: ?*Type = sd.ty;
    if (existing != null) {
        existing;
    } else {
        p: *Type = new Type.Record { def: sd };
        sd.ty = p;
        p;
    }
}

enum_type(ed: *EnumDef@new): *Type@new {
    existing: ?*Type = ed.ty;
    if (existing != null) {
        existing;
    } else {
        p: *Type = new Type.Enum { def: ed };
        ed.ty = p;
        p;
    }
}

exn_type(ed: *ExnDef@new): *Type@new {
    existing: ?*Type = ed.ty;
    if (existing != null) {
        existing;
    } else {
        p: *Type = new Type.Exn { def: ed };
        ed.ty = p;
        p;
    }
}

find_struct_span(s: []i8, off: int, n: int): ?*StructDef {
    b: int = sym_bucket(hash_n(s, off, n));
    sd: ?*StructDef = struct_buckets[b].head;
    while (sd != null) {
        if (name_eq_span(sd.name, s, off, n)) {
            return sd;
        }
        sd = sd.hash_next;
    }
    null;
}

find_struct(name: []i8): ?*StructDef {
    find_struct_span(name, 0, len(name));
}

find_enum_span(s: []i8, off: int, n: int): ?*EnumDef {
    b: int = sym_bucket(hash_n(s, off, n));
    e: ?*EnumDef = enum_buckets[b].head;
    while (e != null) {
        if (name_eq_span(e.name, s, off, n)) {
            return e;
        }
        e = e.hash_next;
    }
    null;
}

find_enum(name: []i8): ?*EnumDef {
    find_enum_span(name, 0, len(name));
}

find_exn_span(s: []i8, off: int, n: int): ?*ExnDef {
    b: int = sym_bucket(hash_n(s, off, n));
    e: ?*ExnDef = exn_buckets[b].head;
    while (e != null) {
        if (name_eq_span(e.name, s, off, n)) {
            return e;
        }
        e = e.hash_next;
    }
    null;
}

find_exn(name: []i8): ?*ExnDef {
    find_exn_span(name, 0, len(name));
}

hash_put_struct(sd: *StructDef@immortal) {
    b: int = sym_bucket(hash_str(sd.name));
    sd.hash_next = struct_buckets[b].head;
    struct_buckets[b].head = sd;
}

hash_put_enum(ed: *EnumDef@immortal) {
    b: int = sym_bucket(hash_str(ed.name));
    ed.hash_next = enum_buckets[b].head;
    enum_buckets[b].head = ed;
}

hash_put_exn(ed: *ExnDef@immortal) {
    b: int = sym_bucket(hash_str(ed.name));
    ed.hash_next = exn_buckets[b].head;
    exn_buckets[b].head = ed;
}

hash_put_fn(fn: *Function@immortal) {
    b: int = sym_bucket(hash_str(fn.name));
    fn.hash_next = fn_buckets[b].head;
    fn_buckets[b].head = fn;
}

hash_put_global(o: *Obj@immortal) {
    b: int = sym_bucket(hash_str(o.name));
    o.hash_next = global_buckets[b].head;
    global_buckets[b].head = o;
}

hash_remove_struct(name: []i8) {
    b: int = sym_bucket(hash_str(name));
    prev: ?*StructDef = null;
    s: ?*StructDef = struct_buckets[b].head;
    while (s != null) {
        if (streq(s.name, name)) {
            if (prev != null) {
                prev.hash_next = s.hash_next;
            } else {
                struct_buckets[b].head = s.hash_next;
            }
            return;
        }
        prev = s;
        s = s.hash_next;
    }
}

remove_struct(name: []i8) {
    hash_remove_struct(name);
    prev: ?*StructDef = null;
    s: ?*StructDef = struct_defs;
    while (s != null) {
        if (streq(s.name, name)) {
            if (prev != null) {
                prev.next = s.next;
            } else {
                struct_defs = s.next;
            }
            return;
        }
        prev = s;
        s = s.next;
    }
}

get_or_create_struct(name: []i8@new) noregion: *StructDef@new {
    sd: ?*StructDef = find_struct(name);
    if (sd != null) {
        return sd;
    }
    created: *StructDef = new StructDef {
        name: name,
        members: null,
        size: 0,
        ty: null,
        next: struct_defs,
        hash_next: null,
        ptr_walk: 0,
        lead: null,
        trail: null,
        browse_id: browse_fresh(),
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    struct_defs = created;
    hash_put_struct(created);
    created;
}

get_or_create_enum(name: []i8@new) noregion: *EnumDef@new {
    ed: ?*EnumDef = find_enum(name);
    if (ed != null) {
        return ed;
    }
    created: *EnumDef = new EnumDef {
        name: name,
        variants: null,
        size: 0,
        ty: null,
        next: enum_defs,
        hash_next: null,
        ptr_walk: 0,
        lead: null,
        trail: null,
        browse_id: browse_fresh(),
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
    enum_defs = created;
    hash_put_enum(created);
    created;
}

rebind_struct_stub_to_enum(sd: *StructDef@ed, ed: *EnumDef@sd) {
    t: ?*Type = sd.ty;
    if (t != null) {
        t.* = Type.Enum { def: ed };
        ed.ty = t;
    }
}

find_variant(ed: *EnumDef, name: []i8): ?*Variant@ed {
    v: ?*Variant = ed.variants;
    while (v != null) {
        if (streq(v.name, name)) {
            return v;
        }
        v = v.next;
    }
    null;
}

variant_payload_name(enum_name: []i8, var_name: []i8): []i8@new {
    ea: int = len(enum_name);
    va: int = len(var_name);
    n: int = ea + 1 + va;
    raw: []i8 = new i8[n](0i8);
    memcpy(raw, 0, enum_name, 0, ea);
    raw[ea] = '.';
    memcpy(raw, ea + 1, var_name, 0, va);
    raw;
}

is_type_name(): bool {
    if (tok.kind != TokKind.Ident) {
        false;
    } else {
        find_struct_span(source, tok.pos, tok.len) != null || find_enum_span(source,
            tok.pos, tok.len) != null || find_exn_span(source, tok.pos, tok.len) != null;
    }
}

is_named_type(name: []i8): bool {
    find_struct(name) != null || find_enum(name) != null || find_exn(name) != null;
}

/* Ident.Ident { field: expr } even when the type is not in this file. */
syntax_variant_fields(): bool {
    if (parse_resolve != 0) {
        return false;
    }
    d: *Token = tok.next;
    if (d.kind != TokKind.Dot) {
        return false;
    }
    id: *Token = d.next;
    if (id.kind != TokKind.Ident) {
        return false;
    }
    b: *Token = id.next;
    if (b.kind != TokKind.LBrace) {
        return false;
    }
    syntax_fields_after_brace(b.next);
}

/* Ident { field: expr }. Not `for x in xs { y: T = e; }` or `match x {`. */
syntax_struct_lit(): bool {
    if (parse_resolve != 0) {
        return false;
    }
    b: *Token = tok.next;
    if (b.kind != TokKind.LBrace) {
        return false;
    }
    syntax_fields_after_brace(b.next);
}

syntax_fields_after_brace(inner: *Token): bool {
    if (inner.kind != TokKind.Ident) {
        return false;
    }
    if (inner.next.kind != TokKind.Colon) {
        return false;
    }
    v: *Token = inner.next.next;
    if (v.kind == TokKind.Int || v.kind == TokKind.I8 || v.kind == TokKind.Bool || v.kind == TokKind.Noreturn) {
        return false;
    }
    if (v.kind == TokKind.Star || v.kind == TokKind.Question || v.kind == TokKind.LBrack) {
        return false;
    }
    if (v.kind == TokKind.Ident) {
        n: TokKind = v.next.kind;
        if (n == TokKind.Assign || n == TokKind.Semi) {
            return false;
        }
    }
    true;
}

exn_stub(name: []i8@new): *ExnDef@new {
    new ExnDef {
        name: name,
        tag: 0,
        members: null,
        size: 0,
        ty: null,
        next: null,
        hash_next: null,
        lead: null,
        trail: null,
        browse_id: 0,
        browse_pos: 0,
        browse_file: 0,
        browse_len: 0
    };
}

starts_type(): bool {
    if (tok.kind == TokKind.LBrack) {
        return true;
    }
    if (tok.kind == TokKind.Int || tok.kind == TokKind.I8 || tok.kind == TokKind.Bool || is_type_name()) {
        return true;
    }
    t: ?*Token = tok;
    done: int = 0;
    while (t != null && done == 0) {
        if (t.kind == TokKind.Question) {
            n1: ?*Token = t.next;
            if (n1 != null) {
                if (n1.kind == TokKind.Star) {
                    t = n1.next;
                } else {
                    if (n1.kind == TokKind.LBrack) {
                        n2: ?*Token = n1.next;
                        if (n2 != null) {
                            if (n2.kind != TokKind.RBrack) {
                                return false;
                            }
                            t = n2.next;
                        } else {
                            return false;
                        }
                    } else {
                        return false;
                    }
                }
            } else {
                return false;
            }
        } else {
            if (t.kind == TokKind.Star) {
                t = t.next;
            } else {
                done = 1;
            }
        }
    }
    if (t != null) {
        if (t != tok) {
            if (t.kind == TokKind.Int || t.kind == TokKind.I8 || t.kind == TokKind.Bool) {
                return true;
            }
            if (t.kind == TokKind.Ident) {
                if (find_struct_span(source, t.pos, t.len) != null) {
                    return true;
                }
                if (find_enum_span(source, t.pos, t.len) != null) {
                    return true;
                }
                if (find_exn_span(source, t.pos, t.len) != null) {
                    return true;
                }
            }
        }
    }
    false;
}

find_field(members: ?*Member, name: []i8): ?*Member@members {
    m: ?*Member = members;
    while (m != null) {
        if (streq(m.name, name)) {
            return m;
        }
        m = m.next;
    }
    null;
}

find_member(sd: *StructDef, name: []i8): ?*Member@sd {
    find_field(sd.members, name);
}

find_exn_member(ed: *ExnDef, name: []i8): ?*Member@ed {
    find_field(ed.members, name);
}

exn_in_list(list: ?*ExnList, ed: *ExnDef): bool {
    e: ?*ExnList = list;
    while (e != null) {
        if (e.exn == ed) {
            return true;
        }
        e = e.next;
    }
    false;
}

exn_is_caught(ed: *ExnDef): bool {
    f: ?*CatchFrame = catch_top;
    while (f != null) {
        if (f.exn == ed) {
            return true;
        }
        f = f.next;
    }
    false;
}

mark_raises_seen(ed: *ExnDef): bool {
    fn: ?*Function = current_fn;
    if (fn != null) {
        e: ?*ExnList = fn.raises_list;
        while (e != null) {
            if (e.exn == ed) {
                e.seen = 1;
                return true;
            }
            e = e.next;
        }
    }
    false;
}

check_exn_allowed(ed: *ExnDef, _what: []i8) raises Error {
    if (exn_is_caught(ed)) {
        return;
    }
    if (mark_raises_seen(ed)) {
        return;
    }
    error("exception not in raises and not caught");
}

catch_push(ed: *ExnDef@new) noregion {
    f: *CatchFrame = new CatchFrame { exn: ed, next: catch_top };
    catch_top = f;
}

catch_reset(saved: ?*CatchFrame@immortal) {
    catch_top = saved;
}

is_pointer(t: *Type): bool {
    match t.* {
        Ptr _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_opt_pointer(t: *Type): bool {
    match t.* {
        OptPtr _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_any_pointer(t: *Type): bool {
    is_pointer(t) || is_opt_pointer(t);
}

is_slice(t: *Type): bool {
    match t.* {
        Slice _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_opt_slice(t: *Type): bool {
    match t.* {
        OptSlice _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_optional(t: *Type): bool {
    is_opt_pointer(t) || is_opt_slice(t);
}

unwrap_optional(t: *Type) noregion raises Error: *Type@new {
    if (is_opt_slice(t)) {
        return slice_of(type_base(t));
    }
    if (!is_opt_pointer(t)) {
        error("internal: unwrap_optional");
    }
    ptr_to(type_base(t));
}

is_zptr(t: *Type): bool {
    match t.* {
        ZPtr _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_indexable(t: *Type): bool {
    is_slice(t) || is_zptr(t);
}

type_is_ref(t: ?*Type): bool {
    if (t == null) {
        return false;
    }
    is_any_pointer(t) || is_slice(t) || is_opt_slice(t) || is_zptr(t);
}

is_struct_ty(t: *Type): bool {
    match t.* {
        Record _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_enum_ty(t: *Type): bool {
    match t.* {
        Enum _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

/* Syntax-only parse: a forward/imported name was a struct stub; treat as enum. */
syntax_as_enum(t: *Type) noregion raises Error: *Type@t {
    if (is_enum_ty(t)) {
        return t;
    }
    if (parse_resolve == 0 && is_struct_ty(t)) {
        sd: *StructDef = type_struct_def(t);
        if (sd.members == null) {
            ed: *EnumDef = get_or_create_enum(sd.name);
            rebind_struct_stub_to_enum(sd, ed);
            return t;
        }
    }
    error("variant construction requires an enum type");
    t;
}

is_exn_ty(t: *Type): bool {
    match t.* {
        Exn _p -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

passes_by_ref(t: *Type): bool {
    (is_struct_ty(t) || is_enum_ty(t) || is_exn_ty(t)) && type_size(t) > 8;
}

is_null_expr(n: ?*Expr): bool {
    if (n != null) {
        match n.kind {
            Null -> {
                true;
            }
            _ -> {
                false;
            }
        }
    } else {
        false;
    }
}

bind_null_to_pointer(pty: ?*Type@null_n, null_n: ?*Expr): bool {
    if (pty == null) {
        false;
    } else if (!is_optional(pty) || !is_null_value_expr(null_n)) {
        false;
    } else if (null_n != null) {
        null_n.ty = pty;
        true;
    } else {
        false;
    }
}

assignable(to: ?*Type@from_n, from_n: ?*Expr) raises Error: bool {
    ft: ?*Type = null;
    if (from_n != null) {
        fty: ?*Type = from_n.ty;
        if (fty != null) {
            ft = decay(fty);
        }
    }
    tt: ?*Type = decay(to);
    if (ft != null) {
        from2: ?*Type = decay(ft);
        to2: ?*Type = decay(tt);
        if (from2 != null && to2 != null) {
            if (types_equal(from2, to2)) {
                return true;
            }
            if (is_opt_pointer(to2) && (is_pointer(from2) || is_slice(from2)) && types_equal(type_base(from2),
                type_base(to2))) {
                return true;
            }
            if (is_opt_slice(to2) && is_slice(from2) && types_equal(type_base(from2),
                type_base(to2))) {
                return true;
            }
            if (is_pointer(to2) && is_slice(from2)) {
                if (types_equal(type_base(from2), type_base(to2))) {
                    return true;
                }
            }
        }
    }
    bind_null_to_pointer(tt, from_n);
}

is_i8_ty(t: *Type): bool {
    match t.* {
        I8 -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_int_ty(t: *Type): bool {
    match t.* {
        Int -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_bool_ty(t: *Type): bool {
    match t.* {
        Bool -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

is_noreturn_ty(t: *Type): bool {
    match t.* {
        Noreturn -> {
            true;
        }
        _ -> {
            false;
        }
    }
}

members_have_pointers(m: ?*Member): bool {
    while (m != null) {
        if (type_has_pointers(m.ty)) {
            return true;
        }
        m = m.next;
    }
    false;
}

struct_has_pointers(d: *StructDef): bool {
    if (d.ptr_walk != 0) {
        return false;
    }
    d.ptr_walk = 1;
    r: bool = members_have_pointers(d.members);
    d.ptr_walk = 0;
    r;
}

enum_has_pointers(d: *EnumDef): bool {
    if (d.ptr_walk != 0) {
        return false;
    }
    d.ptr_walk = 1;
    r: bool = false;
    v: ?*Variant = d.variants;
    while (v != null) {
        if (type_has_pointers(v.payload_ty)) {
            r = true;
        }
        v = v.next;
    }
    d.ptr_walk = 0;
    r;
}

type_has_pointers(t: ?*Type): bool {
    if (t == null) {
        return false;
    }
    match t.* {
        Ptr _p -> {
            true;
        }
        OptPtr _p -> {
            true;
        }
        Slice _p -> {
            true;
        }
        OptSlice _p -> {
            true;
        }
        ZPtr _p -> {
            true;
        }
        Record k -> {
            struct_has_pointers(k.def);
        }
        Enum k -> {
            enum_has_pointers(k.def);
        }
        Exn k -> {
            members_have_pointers(k.def.members);
        }
        _ -> {
            false;
        }
    }
}

types_equal(a: *Type, b: *Type) raises Error: bool {
    if (a == b) {
        true;
    } else if (is_int_ty(a) && is_int_ty(b)) {
        true;
    } else if (is_i8_ty(a) && is_i8_ty(b)) {
        true;
    } else if (is_bool_ty(a) && is_bool_ty(b)) {
        true;
    } else if (is_noreturn_ty(a) && is_noreturn_ty(b)) {
        true;
    } else if (is_pointer(a) && is_pointer(b)) {
        types_equal(type_base(a), type_base(b));
    } else if (is_opt_pointer(a) && is_opt_pointer(b)) {
        types_equal(type_base(a), type_base(b));
    } else if (is_slice(a) && is_slice(b)) {
        types_equal(type_base(a), type_base(b));
    } else if (is_opt_slice(a) && is_opt_slice(b)) {
        types_equal(type_base(a), type_base(b));
    } else if (is_zptr(a) && is_zptr(b)) {
        types_equal(type_base(a), type_base(b));
    } else if (is_struct_ty(a) && is_struct_ty(b)) {
        type_struct_def(a) == type_struct_def(b);
    } else if (is_enum_ty(a) && is_enum_ty(b)) {
        type_enum_def(a) == type_enum_def(b);
    } else if (is_exn_ty(a) && is_exn_ty(b)) {
        type_exn_def(a) == type_exn_def(b);
    } else {
        false;
    }
}

is_numeric_ty(t: *Type): bool {
    is_int_ty(t) || is_i8_ty(t) || is_bool_ty(t);
}

check_as(from: ?*Type, to: ?*Type) noregion raises Error {
    from = decay(from);
    to = decay(to);
    if (from == null) {
        error("invalid as conversion");
    }
    if (to == null) {
        error("invalid as conversion");
    }
    if (types_equal(from, to)) {
        return;
    }
    if (is_numeric_ty(from) && is_numeric_ty(to)) {
        if ((is_i8_ty(from) || is_bool_ty(from)) && is_int_ty(to)) {
            return;
        }
        if (type_size(from) == 1 && type_size(to) == 1) {
            return;
        }
        error_have_want("invalid as conversion (use trunc to narrow int\â\†\’i8/bool)",
            from, to);
    }
    if (is_opt_pointer(from) && is_pointer(to)) {
        error_have_want("cannot cast optional pointer to non-optional (bind a local and use if (p != null))",
            from, to);
    }
    if (is_opt_slice(from) && is_slice(to)) {
        error_have_want("cannot cast optional slice to non-optional (bind a local and use if (s != null))",
            from, to);
    }
    if ((is_pointer(to) || is_opt_pointer(to)) && (is_pointer(from) || is_slice(from) || is_opt_pointer(from) || is_opt_slice(from))) {
        if (is_pointer(to) && is_opt_slice(from)) {
            error_have_want("cannot cast optional slice to non-optional (bind a local and use if (s != null))",
                from, to);
        }
        if (types_equal(type_base(from), type_base(to))) {
            return;
        }
    }
    if ((is_slice(to) || is_opt_slice(to)) && (is_slice(from) || is_opt_slice(from))) {
        if (types_equal(type_base(from), type_base(to))) {
            return;
        }
    }
    error_have_want("invalid as conversion", from, to);
}

is_const_one(n: ?*Expr): bool {
    if (n == null) {
        return false;
    }
    match n.kind {
        Num k -> {
            k.str_label == 0 && k.val == 1;
        }
        _ -> {
            false;
        }
    }
}

io_err(name: []i8, rest: []i8) noregion raises Error: noreturn {
    sb: *StrBuf = sb_new();
    sb_puts(sb, name);
    sb_puts(sb, rest);
    error(sb_finish(sb));
}

check_io_args(name: []i8, args: ?*Expr) noregion raises Error {
    a0: ?*Expr = args;
    if (a0 == null) {
        io_err(name, " takes fd and a buffer");
    }
    a0u: *Expr = a0;
    a1: ?*Expr = a0u.next;
    if (a1 == null) {
        io_err(name, " takes fd and a buffer");
    }
    a1u: *Expr = a1;
    t0: ?*Type = decay(a0u.ty);
    t1: ?*Type = decay(a1u.ty);
    if (t0 == null || !is_int_ty(t0)) {
        error_ty("fd must be int", t0);
    }
    if (t1 == null) {
        io_err(name, " buf must be []i8 or *i8");
    }
    a2: ?*Expr = a1u.next;
    if (is_slice(t1) && is_i8_ty(type_base(t1))) {
        if (a2 == null) {
            return;
        }
        a2u: *Expr = a2;
        t2: ?*Type = decay(a2u.ty);
        if (t2 == null || !is_int_ty(t2)) {
            error_ty("I/O count must be int", t2);
        }
        a3: ?*Expr = a2u.next;
        if (a3 == null) {
            return;
        }
        a3u: *Expr = a3;
        t3: ?*Type = decay(a3u.ty);
        if (t3 == null || !is_int_ty(t3)) {
            error_ty("I/O count must be int", t3);
        }
        if (a3u.next != null) {
            io_err(name, " takes at most fd, []i8, off, n");
        }
        return;
    }
    if (is_pointer(t1) && is_i8_ty(type_base(t1))) {
        if (a2 == null) {
            return;
        }
        a2p: *Expr = a2;
        if (a2p.next != null) {
            io_err(name, " of *i8 is one byte");
        }
        t2p: ?*Type = decay(a2p.ty);
        if (t2p == null || !is_int_ty(t2p)) {
            error_ty("I/O count must be int", t2p);
        }
        if (!is_const_one(a2p)) {
            io_err(name, " of *i8 is one byte");
        }
        return;
    }
    error_have_want("I/O buf must be []i8 or *i8", t1, slice_of(ty_i8));
}

check_memcpy_args(args: ?*Expr) noregion raises Error {
    a0: ?*Expr = args;
    if (a0 == null) {
        error("memcpy takes five arguments");
    }
    a0u: *Expr = a0;
    a1: ?*Expr = a0u.next;
    if (a1 == null) {
        error("memcpy takes five arguments");
    }
    a1u: *Expr = a1;
    a2: ?*Expr = a1u.next;
    if (a2 == null) {
        error("memcpy takes five arguments");
    }
    a2u: *Expr = a2;
    a3: ?*Expr = a2u.next;
    if (a3 == null) {
        error("memcpy takes five arguments");
    }
    a3u: *Expr = a3;
    a4: ?*Expr = a3u.next;
    if (a4 == null) {
        error("memcpy takes five arguments");
    }
    a4u: *Expr = a4;
    if (a4u.next != null) {
        error("memcpy takes five arguments");
    }
    t0: ?*Type = decay(a0u.ty);
    t1: ?*Type = decay(a1u.ty);
    t2: ?*Type = decay(a2u.ty);
    t3: ?*Type = decay(a3u.ty);
    t4: ?*Type = decay(a4u.ty);
    if (t0 == null || !is_slice(t0) || !is_i8_ty(type_base(t0))) {
        error_have_want("memcpy dst must be []i8", t0, slice_of(ty_i8));
    }
    if (t1 == null || !is_int_ty(t1)) {
        error_ty("memcpy di must be int", t1);
    }
    if (t2 == null || !is_slice(t2) || !is_i8_ty(type_base(t2))) {
        error_have_want("memcpy src must be []i8", t2, slice_of(ty_i8));
    }
    if (t3 == null || !is_int_ty(t3)) {
        error_ty("memcpy si must be int", t3);
    }
    if (t4 == null || !is_int_ty(t4)) {
        error_ty("memcpy n must be int", t4);
    }
}

check_trunc(from: ?*Type, to: ?*Type) noregion raises Error {
    from = decay(from);
    to = decay(to);
    if (from == null) {
        error("invalid trunc conversion");
    }
    if (to == null) {
        error("invalid trunc conversion");
    }
    if (is_int_ty(from) && (is_i8_ty(to) || is_bool_ty(to))) {
        return;
    }
    error_have_want("invalid trunc conversion", from, to);
}

decay(t: ?*Type): ?*Type@t {
    t;
}

is_byte_ty(t: *Type): bool {
    type_size(t) == 1;
}

profile_t0: int = 0;

profile_prev: int = 0;

profile_cyc0: int = 0;

profile_cyc_prev: int = 0;

profile_flt0: int = 0;

profile_flt_prev: int = 0;

profile_rbuf: []i8 = "";

rd_u64(b: []i8, o: int): int {
    (b[o] as int & 255) + ((b[o + 1] as int & 255) << 8) + ((b[o + 2] as int & 255) << 16) + ((b[o + 3] as int & 255) << 24) + ((b[o + 4] as int & 255) << 32) + ((b[o + 5] as int & 255) << 40) + ((b[o + 6] as int & 255) << 48) + ((b[o + 7] as int & 255) << 56);
}

profile_faults(): int {
    getrusage(profile_rbuf);
    rd_u64(profile_rbuf, 64);
}

profile_rss_kb(): int {
    rd_u64(profile_rbuf, 32);
}

profile_print(
    label: []i8,
    dt_ns: int,
    dt_cyc: int,
    dt_flt: int
) {
    write(2, "profile: ", len("profile: "));
    write(2, label, len(label));
    write(2, " ", len(" "));
    ms: int = dt_ns / 1000000;
    us: int = dt_ns / 1000 % 1000;
    emit_num_fd(2, ms);
    write(2, ".", len("."));
    if (us < 100) {
        write(2, "0", len("0"));
    }
    if (us < 10) {
        write(2, "0", len("0"));
    }
    emit_num_fd(2, us);
    write(2, " ms  ", len(" ms  "));
    emit_num_fd(2, dt_cyc);
    write(2, " cyc  ", len(" cyc  "));
    emit_num_fd(2, dt_flt);
    write(2, " flt\n", len(" flt\n"));
}

profile_start() noregion {
    if (do_profile == 0) {
        return;
    }
    profile_rbuf = new i8[256](0i8);
    profile_t0 = mono_ns();
    profile_prev = profile_t0;
    profile_cyc0 = rdtsc();
    profile_cyc_prev = profile_cyc0;
    profile_flt0 = profile_faults();
    profile_flt_prev = profile_flt0;
}

profile_mark(label: []i8) {
    if (do_profile == 0) {
        return;
    }
    t: int = mono_ns();
    c: int = rdtsc();
    profile_print(label, t - profile_prev, c - profile_cyc_prev, 0);
    profile_prev = t;
    profile_cyc_prev = c;
}

profile_end() {
    if (do_profile == 0) {
        return;
    }
    profile_print("TOTAL", profile_prev - profile_t0, profile_cyc_prev - profile_cyc0,
        profile_flt_prev - profile_flt0);
    write(2, "profile: rss ", len("profile: rss "));
    emit_num_fd(2, profile_rss_kb());
    write(2, " kb\n", len(" kb\n"));
}

is_profile_flag(s: [z]i8): bool {
    if (s[0] == '-' && s[1] == 'p' && s[2] == 0i8) {
        return true;
    }
    if (s[0] == '-' && s[1] == '-' && s[2] == 'p' && s[3] == 'r' && s[4] == 'o' && s[5] == 'f' && s[6] == 'i' && s[7] == 'l' && s[8] == 'e' && s[9] == 0i8) {
        return true;
    }
    false;
}

compiler_analyze(src_path: []i8@immortal) noregion raises Error {
    profile_start();
    as_init();
    init_runtime();
    init_dummies();
    profile_mark("init");
    source = "";
    source_len = 0;
    source_path = src_path;
    tok = token_eof;
    parse_program(src_path);
    profile_mark("load_parse");
    typecheck_program();
    profile_mark("typecheck");
    check_unused_functions();
    profile_mark("unused_fns");
    check_unused_locals();
    profile_mark("unused_locals");
    check_return_style();
    check_raises_functions();
    check_imm_heap_functions();
    check_written_bounds();
    profile_mark("raises");
    check_noreturn_functions();
    profile_mark("noreturn");
}

compiler_frontend(src_path: []i8@immortal) noregion raises Error {
    compiler_analyze(src_path);
    codegen();
    profile_mark("codegen");
}

compiler_build_direct(src_path: []i8@immortal) noregion: int {
    try {
        cg_direct_mode = 1;
        compiler_frontend(src_path);
        as_assemble_file_append("runtime.s");
        profile_mark("runtime");
        0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1;
    }
}

compiler_main(argc: int, argv: [][z]i8) noregion: int {
    try {
        cg_direct_mode = 0;
        do_profile = 0;
        have: int = 0;
        if (argc < 1) {
            write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
            return 1;
        }
        path: [z]i8 = argv[0];
        ai: int = 1;
        while (ai < argc) {
            arg: [z]i8 = argv[ai];
            if (is_profile_flag(arg)) {
                do_profile = 1;
            } else {
                if (have != 0) {
                    write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n",
                        len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
                    return 1;
                }
                path = arg;
                have = 1;
            }
            ai = ai + 1;
        }
        if (have == 0) {
            write(2, "error: usage: l8 compile [--profile|-p] <file.l8>\n", len("error: usage: l8 compile [--profile|-p] <file.l8>\n"));
            return 1;
        }
        compiler_frontend(zslice(path));
        profile_end();
        0;
    } with Error e -> {
        print_error_at(e.path, e.src, e.src_len, e.pos, e.msg);
        1;
    }
}

// Parsed after this file's types so TokKind and the AST are already in scope.
import "parse.l8";

import "check.l8";

import "codegen.l8";
