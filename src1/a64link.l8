tag compiler_internal;

// Linking what a64asm.l8 assembled into an executable, with no other
// toolchain: a static ELF for Linux (`l8 arm64 --target linux --exe`), or
// a Mach-O for iOS or its simulator (`--target ios|ios-sim --exe`).
//
// The Mach-O is what Apple's linker makes of the same code (see
// tools/ios/macho.py, which reads both): __PAGEZERO; __TEXT with the
// header, __text at 16 KiB, __stubs (adrp, ldr, br through the GOT) and
// __const; __DATA_CONST with the GOT; __DATA; and __LINKEDIT with chained
// fixups (DYLD_CHAINED_PTR_64_OFFSET: a bind per GOT slot, a rebase or
// bind per pointer in data), an exports trie of __mh_execute_header, the
// symbol table, the indirect symbols, and an ad hoc code signature (the
// linker's own kind, SHA-256 per 4 KiB page), which the kernel requires of
// arm64 code; a bundle's signature replaces it (tools/ios/build-linux.sh,
// sign.sh). Each imported symbol is bound to the library tools/ios/
// imports.txt names for it (two-level, as Apple's linker binds it), or else
// looked up in every library (flat), with a warning.
const A64_BASE: int = 4294967296;

// v's n low bytes, appended.
a64_wle(sb: *StrBuf@new, v: int, n: int) raises Error {
    for k in 0..n sb_putc(sb, (v >> 8 * k & 255) trunc i8)
}

a64_wappend(out: *StrBuf@new, src: *StrBuf) {
    old: int = out.used;
    dst: []i8 = sb_grow(out, old + src.used);
    memcpy(dst, old, src.data, 0, src.used);
    out.* = StrBuf { data: dst, used: old + src.used }
}

// A file in memory (memfd_create), and what was written to it.
extern a64_sys_memfd(nr: int, name: str, flags: int): int = syscall;

extern a64_sys_lseek(
    nr: int,
    fd: int,
    off: int,
    whence: int
): int = syscall;

a64_memfd(): int {
    a64_sys_memfd(319, "l8-arm64", 0)
}

a64_read_fd(fd: int): []i8@new {
    _rewind: int = a64_sys_lseek(8, fd, 0, 0);
    sb: *StrBuf = sb_new();
    chunk: []i8 = new i8[65536](0i8);
    more: bool = true;
    while (more) {
        n: int = read(fd, chunk, 0, len(chunk));
        if (n <= 0) more = false else {
            old: int = sb.used;
            data: []i8 = sb_grow(sb, old + n);
            memcpy(data, old, chunk, 0, n);
            sb.* = StrBuf { data: data, used: old + n }
        }
    }
    sb_finish(sb)
}

const A64_PAGE: int = 16384;

a64_put(
    b: []i8,
    off: int,
    v: int,
    n: int
) {
    for k in 0..n b[off + k] = (v >> 8 * k & 255) trunc i8
}

a64_get32(b: []i8, off: int): int {
    b[off] as int & 255 | (b[off + 1] as int & 255) << 8 | (b[off + 2] as int & 255) << 16 | (b[off + 3] as int & 255) << 24
}

a64_align_up(v: int, a: int): int {
    (v + a - 1) / a * a
}

a64_link_fail(msg: []i8, name: []i8): noreturn {
    raw::raw_write(2, "error: arm64 linker: ");
    raw::raw_write_bytes(2, msg);
    if (len(name) > 0) {
        raw::raw_write(2, ": ");
        raw::raw_write_bytes(2, name)
    }
    raw::raw_write(2, "\n");
    exit(1)
}

// Each section's address once laid out.
a64_sec_addr: []int = new int[4](0);

// A section's bytes (bss has none).
a64_sec_bytes(sec: int): []i8 {
    a64_buf(sec).data
}

a64_sym_addr(sym: *A64Sym): int {
    a64_sec_addr[sym.sec] + sym.off
}

// Patch the instruction at rel for a target address (and the GOT slot's
// address for GOT relocations, already in target).
a64_patch(rel: *A64Rel, target: int) {
    if (rel.sec == A64_BSS) a64_link_fail("a relocation in .bss", rel.sym.name);
    b: []i8 = a64_sec_bytes(rel.sec);
    p: int = a64_sec_addr[rel.sec] + rel.off;
    s: int = target + rel.addend;
    k: int = rel.kind;
    if (k == A64R_ABS64) {
        a64_put(b, rel.off, s, 8);
        return
    }
    w: int = a64_get32(b, rel.off);
    if (k == A64R_BRANCH26) {
        d: int = s - p;
        if ((d & 3) != 0 || d < -134217728 || d >= 134217728) a64_link_fail("a branch out of range",
            rel.sym.name);
        w = w | d >> 2 & 67108863
    } else if (k == A64R_COND19) {
        d: int = s - p;
        if ((d & 3) != 0 || d < -1048576 || d >= 1048576) a64_link_fail("a conditional branch out of range",
            rel.sym.name);
        w = w | (d >> 2 & 524287) << 5
    } else if (k == A64R_PAGE21 || k == A64R_GOTPAGE21 || k == A64R_ADR21) {
        d: int = if (k == A64R_ADR21) s - p else (s & ~4095) - (p & ~4095) >> 12;
        if (d < -1048576 || d >= 1048576) a64_link_fail("an address out of adrp's range",
            rel.sym.name);
        w = w | (d & 3) << 29 | (d >> 2 & 524287) << 5
    } else if (k == A64R_PAGEOFF12 || k == A64R_GOTPAGEOFF12) {
        lo: int = s & 4095;
        if ((lo & (1 << rel.scale) - 1) != 0) a64_link_fail("a misaligned page offset",
            rel.sym.name);
        w = w | lo >> rel.scale << 10
    } else a64_link_fail("an unknown relocation", rel.sym.name);
    a64_put(b, rel.off, w, 4)
}

// ---- files ----
a64_read_file(path: []i8): ?[]i8@new {
    fd: int = open_path(path, 0, 0);
    if (fd < 0) return null;
    sb: *StrBuf = sb_new();
    chunk: []i8 = new i8[65536](0i8);
    more: bool = true;
    while (more) {
        n: int = read(fd, chunk, 0, len(chunk));
        if (n <= 0) more = false else {
            try {
                for i in 0..n sb_putc(sb, chunk[i])
            } with Error _e -> {
                a64_link_fail("out of memory", "")
            }
        }
    }
    close(fd);
    sb_finish(sb)
}

a64_write_file(path: []i8, data: []i8, n: int) {
    fd: int = open_path(path, 577, 493);
    if (fd < 0) a64_link_fail("cannot write", path);
    off: int = 0;
    while (off < n) {
        w: int = raw::raw_write_some(fd, data, off, n - off);
        if (w <= 0) a64_link_fail("cannot write", path);
        off = off + w
    }
    close(fd)
}

// ---- ELF, for Linux ----
// A static executable: one read-execute segment (the headers, .text and
// .rodata) and one read-write one (.data and .bss).
a64_write_elf(path: []i8) {
    base: int = 4194304;
    tsz: int = a64_text.used;
    csz: int = a64_const.used;
    dsz: int = a64_data.used;
    text_off: int = a64_align_up(64 + 3 * 56, 16);
    const_off: int = a64_align_up(text_off + tsz, a64_align[A64_CONST]);
    rx_end: int = const_off + csz;
    data_off: int = a64_align_up(rx_end, if (a64_align[A64_DATA] > 16) a64_align[A64_DATA] else 16);
    data_addr: int = base + a64_align_up(data_off, 65536) + data_off % 65536;
    bss_addr: int = a64_align_up(data_addr + dsz, if (a64_align[A64_BSS] > 16) a64_align[A64_BSS] else 16);
    a64_sec_addr[A64_TEXT] = base + text_off;
    a64_sec_addr[A64_CONST] = base + const_off;
    a64_sec_addr[A64_DATA] = data_addr;
    a64_sec_addr[A64_BSS] = bss_addr;
    rel: ?*A64Rel = a64_rels;
    while (rel != null) {
        sym: *A64Sym = rel.sym;
        target: int = 0;
        if (sym.sec >= 0) target = a64_sym_addr(sym) else {
            // (A library's function a test does not call: as ld.lld's
            // --warn-unresolved-symbols leaves it, at 0.)
            if (sym.imp < 0) {
                raw::raw_write(2, "warning: arm64 linker: undefined: ");
                raw::raw_write_bytes(2, sym.name);
                raw::raw_write(2, "\n");
                sym.imp = 0
            }
        }
        // (A call to one goes on to the next instruction, as ld.lld makes
        // it.)
        if (sym.sec < 0 && rel.kind == A64R_BRANCH26) target = a64_sec_addr[rel.sec] + rel.off + 4;
        if (rel.kind == A64R_GOTPAGE21 || rel.kind == A64R_GOTPAGEOFF12) a64_link_fail("a GOT relocation in a static executable",
            sym.name);
        a64_patch(rel, target);
        rel = rel.next
    }
    start: *A64Sym = a64_find("_start", 0, 6) or a64_link_fail("no _start", "");
    if (start.sec < 0) a64_link_fail("no _start", "");
    // Section headers and a symbol table after the data (for debuggers,
    // and tools/arm64/check.py).
    strtab: *StrBuf = sb_new();
    symtab: *StrBuf = sb_new();
    try {
        sb_putc(strtab, 0i8);
        for _k in 0..24 sb_putc(symtab, 0i8);
        nlocal: int = 1;
        for pass in 0..2 {
            s: ?*A64Sym = a64_syms;
            while (s != null) {
                if (s.sec >= 0 && !s.temp && s.global == (pass == 1)) {
                    a64_wle(symtab, strtab.used, 4);
                    sb_puts(strtab, s.name);
                    sb_putc(strtab, 0i8);
                    kind: int = if (s.sec == A64_TEXT) 2 else 1;
                    sb_putc(symtab, ((if (s.global) 16 else 0) | kind) trunc i8);
                    sb_putc(symtab, 0i8);
                    a64_wle(symtab, s.sec + 1, 2);
                    a64_wle(symtab, a64_sym_addr(s), 8);
                    a64_wle(symtab, 0, 8);
                    if (pass == 0) nlocal = nlocal + 1
                }
                s = s.next
            }
        }
        a64_elf_nlocal = nlocal
    } with Error _e -> {
        a64_link_fail("out of memory", "")
    }
    // (Section names at 1, 7, 15, 21, 26, 34, 42.)
    shstr: []i8 = bytes(" .text .rodata .data .bss .symtab .strtab .shstrtab ");
    for k in 0..len(shstr) {
        if (shstr[k] == ' ') shstr[k] = 0i8
    }
    symtab_off: int = a64_align_up(data_off + dsz, 8);
    strtab_off: int = symtab_off + symtab.used;
    shstr_off: int = strtab_off + strtab.used;
    sh_off: int = a64_align_up(shstr_off + len(shstr), 8);
    total: int = sh_off + 8 * 64;
    out: []i8 = new i8[total](0i8);
    memcpy(out, symtab_off, symtab.data, 0, symtab.used);
    memcpy(out, strtab_off, strtab.data, 0, strtab.used);
    memcpy(out, shstr_off, shstr, 0, len(shstr));
    a64_put(out, 40, sh_off, 8);
    a64_put(out, 60, 8, 2);
    a64_put(out, 62, 7, 2);
    // (name offset in shstr, type, flags, address, offset, size, link,
    // info, alignment, entry size)
    a64_elf_shdr(out, sh_off + 64, 1, 1, 6, base + text_off, text_off, tsz, 0, 0,
        a64_align[A64_TEXT], 0);
    a64_elf_shdr(out, sh_off + 128, 7, 1, 2, base + const_off, const_off, csz, 0,
        0, a64_align[A64_CONST], 0);
    a64_elf_shdr(out, sh_off + 192, 15, 1, 3, data_addr, data_off, dsz, 0, 0, a64_align[A64_DATA],
        0);
    a64_elf_shdr(out, sh_off + 256, 21, 8, 3, bss_addr, data_off + dsz, a64_bss_size,
        0, 0, a64_align[A64_BSS], 0);
    a64_elf_shdr(out, sh_off + 320, 26, 2, 0, 0, symtab_off, symtab.used, 6, a64_elf_nlocal,
        8, 24);
    a64_elf_shdr(out, sh_off + 384, 34, 3, 0, 0, strtab_off, strtab.used, 0, 0, 1,
        0);
    a64_elf_shdr(out, sh_off + 448, 42, 3, 0, 0, shstr_off, len(shstr), 0, 0, 1, 0);
    // e_ident, then the header's fields.
    a64_put(out, 0, 1179403647, 4);
    out[4] = 2i8;
    out[5] = 1i8;
    out[6] = 1i8;
    a64_put(out, 16, 2, 2);
    a64_put(out, 18, 183, 2);
    a64_put(out, 20, 1, 4);
    a64_put(out, 24, a64_sym_addr(start), 8);
    a64_put(out, 32, 64, 8);
    a64_put(out, 52, 64, 2);
    a64_put(out, 54, 56, 2);
    a64_put(out, 56, 3, 2);
    a64_put(out, 58, 64, 2);
    // PT_LOAD r-x, PT_LOAD rw-, PT_GNU_STACK.
    a64_elf_phdr(out, 64, 1, 5, 0, base, rx_end, rx_end);
    a64_elf_phdr(out, 120, 1, 6, data_off, data_addr, dsz, bss_addr + a64_bss_size - data_addr);
    a64_elf_phdr(out, 176, 1685382481, 6, 0, 0, 0, 0);
    memcpy(out, text_off, a64_text.data, 0, tsz);
    memcpy(out, const_off, a64_const.data, 0, csz);
    memcpy(out, data_off, a64_data.data, 0, dsz);
    a64_write_file(path, out, total)
}

a64_elf_nlocal: int = 0;

a64_elf_shdr(
    out: []i8,
    at: int,
    name: int,
    kind: int,
    flags: int,
    addr: int,
    off: int,
    size: int,
    link: int,
    info: int,
    align: int,
    entsize: int
) {
    a64_put(out, at, name, 4);
    a64_put(out, at + 4, kind, 4);
    a64_put(out, at + 8, flags, 8);
    a64_put(out, at + 16, addr, 8);
    a64_put(out, at + 24, off, 8);
    a64_put(out, at + 32, size, 8);
    a64_put(out, at + 40, link, 4);
    a64_put(out, at + 44, info, 4);
    a64_put(out, at + 48, align, 8);
    a64_put(out, at + 56, entsize, 8)
}

a64_elf_phdr(
    out: []i8,
    at: int,
    kind: int,
    flags: int,
    off: int,
    addr: int,
    filesz: int,
    memsz: int
) {
    a64_put(out, at, kind, 4);
    a64_put(out, at + 4, flags, 4);
    a64_put(out, at + 8, off, 8);
    a64_put(out, at + 16, addr, 8);
    a64_put(out, at + 24, addr, 8);
    a64_put(out, at + 32, filesz, 8);
    a64_put(out, at + 40, memsz, 8);
    a64_put(out, at + 48, if (kind == 1) 65536 else 16, 8)
}

// ---- SHA-256 ----
a64_sha_k: []int = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993,
    2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388,
    2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628,
    770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808,
    3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912,
    1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921,
    2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063,
    1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187,
    3204031479, 3329325298];

a64_sha_init: []int = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119,
    2600822924, 528734635, 1541459225];

a64_sha_w: []int = new int[64](0);

a64_sha_h: []int = new int[8](0);

a64_sha_block: []i8 = new i8[64](0i8);

a64_rotr(x: int, n: int): int {
    (x >> n | x << 32 - n) & 4294967295
}

a64_sha_compress(b: []i8, off: int) {
    w: []int = a64_sha_w;
    for t in 0..16 {
        o: int = off + 4 * t;
        w[t] = (b[o] as int & 255) << 24 | (b[o + 1] as int & 255) << 16 | (b[o + 2] as int & 255) << 8 | b[o + 3] as int & 255
    }
    for t in 16..64 {
        x: int = w[t - 15];
        y: int = w[t - 2];
        s0: int = a64_rotr(x, 7) ^ a64_rotr(x, 18) ^ x >> 3;
        s1: int = a64_rotr(y, 17) ^ a64_rotr(y, 19) ^ y >> 10;
        w[t] = w[t - 16] + s0 + w[t - 7] + s1 & 4294967295
    }
    h: []int = a64_sha_h;
    a: int = h[0];
    bb: int = h[1];
    c: int = h[2];
    d: int = h[3];
    e: int = h[4];
    f: int = h[5];
    g: int = h[6];
    hh: int = h[7];
    for t in 0..64 {
        s1: int = a64_rotr(e, 6) ^ a64_rotr(e, 11) ^ a64_rotr(e, 25);
        ch: int = e & f ^ ~e & 4294967295 & g;
        t1: int = hh + s1 + ch + a64_sha_k[t] + w[t] & 4294967295;
        s0: int = a64_rotr(a, 2) ^ a64_rotr(a, 13) ^ a64_rotr(a, 22);
        maj: int = a & bb ^ a & c ^ bb & c;
        t2: int = s0 + maj & 4294967295;
        hh = g;
        g = f;
        f = e;
        e = d + t1 & 4294967295;
        d = c;
        c = bb;
        bb = a;
        a = t1 + t2 & 4294967295
    }
    h[0] = h[0] + a & 4294967295;
    h[1] = h[1] + bb & 4294967295;
    h[2] = h[2] + c & 4294967295;
    h[3] = h[3] + d & 4294967295;
    h[4] = h[4] + e & 4294967295;
    h[5] = h[5] + f & 4294967295;
    h[6] = h[6] + g & 4294967295;
    h[7] = h[7] + hh & 4294967295
}

// The SHA-256 of data[off, off + n), written to out[at, at + 32).
a64_sha256(
    data: []i8,
    off: int,
    n: int,
    out: []i8,
    at: int
) {
    for k in 0..8 a64_sha_h[k] = a64_sha_init[k];
    full: int = n / 64;
    for blk in 0..full a64_sha_compress(data, off + 64 * blk);
    rest: int = n - 64 * full;
    pad: []i8 = a64_sha_block;
    for k in 0..64 pad[k] = 0i8;
    for k in 0..rest pad[k] = data[off + 64 * full + k];
    pad[rest] = 128 trunc i8;
    if (rest >= 56) {
        a64_sha_compress(pad, 0);
        for k in 0..64 pad[k] = 0i8
    }
    bits: int = n * 8;
    for k in 0..8 pad[63 - k] = (bits >> 8 * k & 255) trunc i8;
    a64_sha_compress(pad, 0);
    for k in 0..8 {
        v: int = a64_sha_h[k];
        out[at + 4 * k] = (v >> 24 & 255) trunc i8;
        out[at + 4 * k + 1] = (v >> 16 & 255) trunc i8;
        out[at + 4 * k + 2] = (v >> 8 & 255) trunc i8;
        out[at + 4 * k + 3] = (v & 255) trunc i8
    }
}

// ---- Mach-O, for iOS and its simulator ----
type A64Lib = {
    name: []i8;
    path: []i8;
    current: int;
    compat: int;
    // Its ordinal once linked (1...), or 0 while not.
    ordinal: int;
    next: ?*A64Lib
}

// What tools/ios/imports.txt says: the libraries, and each symbol's.
type A64ImportName = {
    name: []i8;
    lib: *A64Lib;
    next: ?*A64ImportName
}

a64_libs: ?*A64Lib = null;

a64_import_names: []?*A64ImportName = new ?*A64ImportName[4096](null);

// The libraries linked, in order.
a64_linked: []?*A64Lib = new ?*A64Lib[64](null);

a64_nlinked: int = 0;

// X.Y.Z as Mach-O packs a version.
a64_version(s: []i8, b: int, e: int): int {
    parts: []int = new int[3](0);
    k: int = 0;
    for i in b..e {
        c: i8 = s[i];
        if (c == '.') {
            k = k + 1;
            if (k > 2) a64_link_fail("a bad version", "")
        } else if (c >= '0' && c <= '9') parts[k] = parts[k] * 10 + (c as int - '0' as int) else a64_link_fail("a bad version",
            "")
    }
    parts[0] << 16 | parts[1] << 8 | parts[2]
}

a64_find_lib(name: []i8): ?*A64Lib {
    l: ?*A64Lib = a64_libs;
    while (l != null) {
        if (streq(l.name, name)) return l;
        l = l.next
    }
    null
}

// A framework's library, known or not (then version 1.0.0).
a64_framework(name: []i8@new) noregion: *A64Lib@new {
    found: ?*A64Lib = a64_find_lib(name);
    if (found != null) return found;
    sb: *StrBuf = sb_new();
    try {
        sb_puts(sb, "/System/Library/Frameworks/");
        sb_puts(sb, name);
        sb_puts(sb, ".framework/");
        sb_puts(sb, name)
    } with Error _e -> {
        a64_link_fail("out of memory", "")
    }
    lib: *A64Lib = new A64Lib {
        name: name,
        path: sb_finish(sb),
        current: 65536,
        compat: 65536,
        ordinal: 0,
        next: a64_libs
    };
    a64_libs = lib;
    lib
}

// The fields of a line of imports.txt: "NAME PATH CURRENT COMPAT" for a
// library, "SYMBOL NAME" for a symbol (# starts a comment).
a64_load_imports(text: []i8) noregion {
    n: int = len(text);
    p: int = 0;
    while (p < n) {
        e: int = p;
        while (e < n && text[e] != '\n') e = e + 1;
        fb: []int = new int[4](0);
        fe: []int = new int[4](0);
        nf: int = 0;
        q: int = p;
        while (q < e && text[q] != '#') {
            while (q < e && a64_is_space(text[q])) q = q + 1;
            if (q < e && text[q] != '#') {
                b: int = q;
                while (q < e && !a64_is_space(text[q]) && text[q] != '#') q = q + 1;
                if (nf < 4) {
                    fb[nf] = b;
                    fe[nf] = q
                }
                nf = nf + 1
            }
        }
        if (nf == 4 && text[fb[1]] == '/') a64_libs = new A64Lib {
            name: strdup_n(text, fb[0], fe[0] - fb[0]),
            path: strdup_n(text, fb[1], fe[1] - fb[1]),
            current: a64_version(text, fb[2], fe[2]),
            compat: a64_version(text, fb[3], fe[3]),
            ordinal: 0,
            next: a64_libs
        } else if (nf == 2) {
            lib: ?*A64Lib = a64_find_lib(strdup_n(text, fb[1], fe[1] - fb[1]));
            if (lib == null) a64_link_fail("imports: a symbol's library is not listed before it",
                strdup_n(text, fb[1], fe[1] - fb[1]));
            h: int = a64_hash(text, fb[0], fe[0] - fb[0]) & 4095;
            a64_import_names[h] = new A64ImportName { name: strdup_n(text, fb[0],
                fe[0] - fb[0]), lib: lib, next: a64_import_names[h] }
        } else if (nf != 0) a64_link_fail("imports: a bad line", strdup_n(text, p,
            e - p));
        p = e + 1
    }
}

a64_import_lib(name: []i8): ?*A64Lib {
    e: ?*A64ImportName = a64_import_names[a64_hash(name, 0, len(name)) & 4095];
    while (e != null) {
        if (streq(e.name, name)) return e.lib;
        e = e.next
    }
    null
}

a64_link_lib(lib: *A64Lib@immortal) {
    if (lib.ordinal > 0) return;
    if (a64_nlinked >= len(a64_linked)) a64_link_fail("too many libraries", lib.name);
    a64_linked[a64_nlinked] = lib;
    a64_nlinked = a64_nlinked + 1;
    lib.ordinal = a64_nlinked
}

// Sort symbols by name (merge sort).
// (When set, by library first, as Apple's linker orders its imports: the
// unknown ones, looked up flat, last.)
a64_by_lib: bool = false;

a64_name_less(a: *A64Sym, b: *A64Sym): bool {
    if (a64_by_lib && a.lib != b.lib) {
        x: int = if (a.lib < 0) 255 else a.lib;
        y: int = if (b.lib < 0) 255 else b.lib;
        return x < y
    }
    n: int = if (len(a.name) < len(b.name)) len(a.name) else len(b.name);
    for i in 0..n {
        x: int = a.name[i] as int & 255;
        y: int = b.name[i] as int & 255;
        if (x != y) return x < y
    }
    len(a.name) < len(b.name)
}

a64_sort(xs: []*A64Sym, n: int) {
    // (Heapsort: in place.)
    k: int = n / 2;
    while (k > 0) {
        k = k - 1;
        a64_sift(xs, k, n)
    }
    end: int = n;
    while (end > 1) {
        end = end - 1;
        top: *A64Sym = xs[0];
        xs[0] = xs[end];
        xs[end] = top;
        a64_sift(xs, 0, end)
    }
}

a64_sift(xs: []*A64Sym, start: int, n: int) {
    root: int = start;
    while (2 * root + 1 < n) {
        child: int = 2 * root + 1;
        if (child + 1 < n && a64_name_less(xs[child], xs[child + 1])) child = child + 1;
        if (!a64_name_less(xs[root], xs[child])) return;
        swap: *A64Sym = xs[root];
        xs[root] = xs[child];
        xs[child] = swap;
        root = child
    }
}

// Sort ints ascending (insertion: the lists here are nearly in order).
a64_sort_ints(xs: []int, n: int) {
    for i in 1..n {
        v: int = xs[i];
        j: int = i - 1;
        while (j >= 0 && xs[j] > v) {
            xs[j + 1] = xs[j];
            j = j - 1
        }
        xs[j + 1] = v
    }
}

// A chain of fixups in one segment: offsets (from the segment's start)
// and their values before the chain's next fields are set.
type A64Fixups = {
    offs: []int;
    vals: []int;
    count: int
}

a64_fixups_new(cap: int): *A64Fixups@new {
    new A64Fixups { offs: new int[cap + 1](0), vals: new int[cap + 1](0), count: 0 }
}

a64_fixup(f: *A64Fixups, off: int, val: int) {
    if (f.count >= len(f.offs)) a64_link_fail("too many fixups", "");
    f.offs[f.count] = off;
    f.vals[f.count] = val;
    f.count = f.count + 1
}

// A bind (to import i) and a rebase (to an address), as
// DYLD_CHAINED_PTR_64_OFFSET packs them, without their next fields.
a64_bind_value(i: int): int {
    1 << 63 | i
}

a64_rebase_value(addr: int): int {
    addr - A64_BASE
}

// The fixups written into seg (its bytes, from file offset seg_off) as
// chains, a chain a page; and the dyld_chained_starts_in_segment.
a64_chain(
    f: *A64Fixups,
    seg: []i8,
    seg_off: int,
    seg_vm_off: int,
    seg_size: int,
    starts: *StrBuf@new
) raises Error {
    // (Sorted by offset: pairs sorted together.)
    order: []int = new int[f.count + 1](0);
    for k in 0..f.count {
        if ((f.offs[k] & 3) != 0) a64_link_fail("a pointer not 4-byte aligned", "");
        order[k] = f.offs[k] * 65536 + k
    }
    a64_sort_ints(order, f.count);
    pages: int = a64_align_up(seg_size, A64_PAGE) / A64_PAGE;
    page_start: []int = new int[pages + 1](65535);
    for k in 0..f.count {
        i: int = order[k] & 65535;
        off: int = f.offs[i];
        page: int = off / A64_PAGE;
        if (page_start[page] == 65535) page_start[page] = off % A64_PAGE;
        v: int = f.vals[i];
        if (k + 1 < f.count) {
            noff: int = f.offs[order[k + 1] & 65535];
            if (noff / A64_PAGE == page) {
                stride: int = (noff - off) / 4;
                if (stride > 4095) a64_link_fail("fixups too far apart", "");
                v = v | stride << 51
            }
        }
        a64_put(seg, seg_off + off, v, 8)
    }
    a64_wle(starts, 22 + 2 * pages, 4);
    a64_wle(starts, A64_PAGE, 2);
    a64_wle(starts, 6, 2);
    a64_wle(starts, seg_vm_off, 8);
    a64_wle(starts, 0, 4);
    a64_wle(starts, pages, 2);
    for p in 0..pages a64_wle(starts, page_start[p], 2)
}

a64_pad(sb: *StrBuf@new, a: int) raises Error {
    while (sb.used % a != 0) sb_putc(sb, 0i8)
}

a64_seg_cmd(
    out: []i8,
    at: int,
    name: []i8,
    nsects: int,
    vm: int,
    vmsize: int,
    off: int,
    filesize: int,
    prot: int,
    flags: int
): int {
    a64_put(out, at, 25, 4);
    a64_put(out, at + 4, 72 + 80 * nsects, 4);
    for k in 0..len(name) out[at + 8 + k] = name[k];
    a64_put(out, at + 24, vm, 8);
    a64_put(out, at + 32, vmsize, 8);
    a64_put(out, at + 40, off, 8);
    a64_put(out, at + 48, filesize, 8);
    a64_put(out, at + 56, prot, 4);
    a64_put(out, at + 60, prot, 4);
    a64_put(out, at + 64, nsects, 4);
    a64_put(out, at + 68, flags, 4);
    at + 72
}

a64_sect(
    out: []i8,
    at: int,
    name: []i8,
    seg: []i8,
    addr: int,
    size: int,
    align: int,
    flags: int,
    r1: int,
    r2: int
): int {
    for k in 0..len(name) out[at + k] = name[k];
    for k in 0..len(seg) out[at + 16 + k] = seg[k];
    a64_put(out, at + 32, addr, 8);
    a64_put(out, at + 40, size, 8);
    a64_put(out, at + 48, if (size > 0 || flags != 1) addr - A64_BASE else 0, 4);
    p2: int = 0;
    while (1 << p2 < align) p2 = p2 + 1;
    a64_put(out, at + 52, p2, 4);
    a64_put(out, at + 64, flags, 4);
    a64_put(out, at + 68, r1, 4);
    a64_put(out, at + 72, r2, 4);
    at + 80
}

a64_cmd(
    out: []i8,
    at: int,
    cmd: int,
    size: int
): int {
    a64_put(out, at, cmd, 4);
    a64_put(out, at + 4, size, 4);
    at + size
}

// The Mach-O executable: platform 2 (iOS) or 7 (the simulator); the SDK's
// version (as Mach-O packs one, X << 16 | Y << 8 | Z);
// encrypt for an App Store build's LC_ENCRYPTION_INFO_64 (cryptid 0);
// frameworks to link (a name each); the imports table's text, if any; ident
// names the code signature.
a64_write_macho(
    path: []i8,
    platform: int,
    sdk: int,
    encrypt: bool,
    frameworks: [][]i8@new,
    nframeworks: int,
    imports_text: ?[]i8,
    ident: []i8
) noregion raises Error {
    if (imports_text != null) a64_load_imports(imports_text);
    for k in 0..nframeworks a64_link_lib(a64_framework(frameworks[k]));
    objc: ?*A64Lib = a64_find_lib("libobjc");
    if (objc == null) objc = new A64Lib {
        name: "libobjc",
        path: "/usr/lib/libobjc.A.dylib",
        current: 65536,
        compat: 65536,
        ordinal: 0,
        next: null
    };
    a64_link_lib(objc or a64_link_fail("internal", ""));
    system: ?*A64Lib = a64_find_lib("libSystem");
    if (system == null) system = new A64Lib {
        name: "libSystem",
        path: "/usr/lib/libSystem.B.dylib",
        current: 65536,
        compat: 65536,
        ordinal: 0,
        next: null
    };
    a64_link_lib(system or a64_link_fail("internal", ""));
    // The imports, the GOT's symbols and the stubs'.
    nimports: int = 0;
    ngot: int = 0;
    ndata_ptrs: int = 0;
    rel: ?*A64Rel = a64_rels;
    while (rel != null) {
        sym: *A64Sym = rel.sym;
        k: int = rel.kind;
        if (sym.sec < 0 && sym.imp < 0) {
            sym.imp = 0;
            nimports = nimports + 1
        }
        if ((k == A64R_GOTPAGE21 || k == A64R_GOTPAGEOFF12 || sym.sec < 0) && sym.got < 0) {
            sym.got = 0;
            ngot = ngot + 1
        }
        if (k == A64R_ABS64) {
            if (rel.sec != A64_DATA) a64_link_fail("a pointer outside __DATA (it would need a fixup in read-only memory)",
                sym.name);
            ndata_ptrs = ndata_ptrs + 1
        }
        if (sym.sec < 0 && k != A64R_BRANCH26 && k != A64R_GOTPAGE21 && k != A64R_GOTPAGEOFF12 && k != A64R_ABS64) a64_link_fail("an imported symbol's address not through the GOT (use @GOTPAGE)",
            sym.name);
        rel = rel.next
    }
    dummy: *A64Sym = a64_new_sym("");
    imports: []*A64Sym = new *A64Sym[nimports + 1](dummy);
    gots: []*A64Sym = new *A64Sym[ngot + 1](dummy);
    ni: int = 0;
    ng: int = 0;
    s: ?*A64Sym = a64_syms;
    while (s != null) {
        if (s.imp == 0 && s.sec < 0) {
            imports[ni] = s;
            ni = ni + 1
        }
        if (s.got == 0) {
            gots[ng] = s;
            ng = ng + 1
        }
        s = s.next
    }
    a64_sort(imports, ni);
    for k in 0..ni {
        imp: *A64Sym = imports[k];
        imp.imp = k;
        lib: ?*A64Lib = a64_import_lib(imp.name);
        if (lib == null) {
            raw::raw_write(2, "warning: arm64 linker: not in the imports table, so looked up in every library: ");
            raw::raw_write_bytes(2, imp.name);
            raw::raw_write(2, "\n");
            imp.lib = 0 - 2
        } else {
            a64_link_lib(lib);
            imp.lib = lib.ordinal
        }
    }
    // (The stubs in the names' order, then imports and the GOT in the
    // libraries', as Apple's linker orders them.)
    by_name: []*A64Sym = new *A64Sym[ni + 1](dummy);
    for k in 0..ni by_name[k] = imports[k];
    a64_by_lib = true;
    a64_sort(imports, ni);
    for k in 0..ni imports[k].imp = k;
    ng = 0;
    for k in 0..ni {
        if (imports[k].got == 0) {
            gots[ng] = imports[k];
            ng = ng + 1
        }
    }
    s = a64_syms;
    while (s != null) {
        if (s.got == 0 && s.sec >= 0) {
            gots[ng] = s;
            ng = ng + 1
        }
        s = s.next
    }
    a64_by_lib = false;
    for k in 0..ng gots[k].got = k;
    // Stubs: the imports called.
    nstubs: int = 0;
    rel = a64_rels;
    while (rel != null) {
        sym: *A64Sym = rel.sym;
        if (sym.sec < 0 && rel.kind == A64R_BRANCH26 && sym.stub < 0) {
            sym.stub = 0;
            nstubs = nstubs + 1
        }
        rel = rel.next
    }
    stubs: []*A64Sym = new *A64Sym[nstubs + 1](dummy);
    nst: int = 0;
    for k in 0..ni {
        if (by_name[k].stub == 0) {
            by_name[k].stub = nst;
            stubs[nst] = by_name[k];
            nst = nst + 1
        }
    }
    // The load commands' size.
    nlibs: int = a64_nlinked;
    lib_cmds: int = 0;
    for k in 0..nlibs {
        lib: *A64Lib = a64_linked[k] or a64_link_fail("internal", "");
        lib_cmds = lib_cmds + a64_align_up(24 + len(lib.path) + 1, 8)
    }
    csz: int = a64_const.used;
    has_const: bool = csz > 0;
    has_got: bool = ngot > 0;
    ntext_sects: int = if (has_const) 3 else 2;
    cmds_size: int = 72 + (72 + 80 * ntext_sects) + (if (has_got) 152 else 0) + 152 + 72 + 16 + 16 + 16 + 24 + 80 + 32 + 24 + 24 + 16 + 24 + (if (encrypt) 24 else 0) + lib_cmds + 16;
    ncmds: int = 15 + (if (has_got) 1 else 0) + (if (encrypt) 1 else 0) + nlibs;
    if (32 + cmds_size > A64_PAGE) a64_link_fail("load commands past the first page",
        "");
    // Layout: file offsets, and addresses A64_BASE above them.
    tsz: int = a64_text.used;
    text_off: int = A64_PAGE;
    stubs_off: int = a64_align_up(text_off + tsz, 4);
    const_align: int = if (a64_align[A64_CONST] > 8) a64_align[A64_CONST] else 8;
    const_off: int = a64_align_up(stubs_off + 12 * nstubs, const_align);
    text_end: int = if (has_const) const_off + csz else stubs_off + 12 * nstubs;
    text_seg: int = a64_align_up(text_end, A64_PAGE);
    dc_off: int = text_seg;
    got_size: int = 8 * ngot;
    dc_seg: int = if (has_got) a64_align_up(got_size, A64_PAGE) else 0;
    data_off: int = dc_off + dc_seg;
    data_align: int = if (a64_align[A64_DATA] > 8) a64_align[A64_DATA] else 8;
    // (bss, if any, after the data, in the file: zeros.)
    bss_off: int = a64_align_up(data_off + a64_data.used, if (a64_align[A64_BSS] > 8) a64_align[A64_BSS] else 8);
    data_size: int = bss_off + a64_bss_size - data_off;
    data_seg: int = a64_align_up(if (data_size > 0) data_size else 1, A64_PAGE);
    le_off: int = data_off + data_seg;
    a64_sec_addr[A64_TEXT] = A64_BASE + text_off;
    a64_sec_addr[A64_CONST] = A64_BASE + const_off;
    a64_sec_addr[A64_DATA] = A64_BASE + data_off;
    a64_sec_addr[A64_BSS] = A64_BASE + bss_off;
    got_addr: int = A64_BASE + dc_off;
    stubs_addr: int = A64_BASE + stubs_off;
    // Relocations; pointers in data become fixups.
    data_fix: *A64Fixups = a64_fixups_new(ndata_ptrs);
    rel = a64_rels;
    while (rel != null) {
        sym: *A64Sym = rel.sym;
        k: int = rel.kind;
        if (k == A64R_GOTPAGE21 || k == A64R_GOTPAGEOFF12) a64_patch(rel, got_addr + 8 * sym.got) else if (k == A64R_BRANCH26 && sym.sec < 0) a64_patch(rel,
            stubs_addr + 12 * sym.stub) else if (k == A64R_ABS64) {
            off: int = a64_sec_addr[A64_DATA] + rel.off - A64_BASE - data_off;
            if (sym.sec < 0) {
                if (rel.addend < 0 || rel.addend > 255) a64_link_fail("an import's addend past 255",
                    sym.name);
                a64_fixup(data_fix, off, a64_bind_value(sym.imp) | rel.addend << 24)
            } else a64_fixup(data_fix, off, a64_rebase_value(a64_sym_addr(sym) + rel.addend))
        } else a64_patch(rel, a64_sym_addr(sym));
        rel = rel.next
    }
    // __LINKEDIT's parts: chained fixups, the exports trie, the symbol table
    // and its strings, the indirect symbols.
    fixups: *StrBuf = sb_new();
    nsegs: int = if (has_got) 5 else 4;
    // (Filled into the file's buffer once it is made; first the header and
    // the starts in the image.)
    seg_bytes: []i8 = new i8[le_off](0i8);
    got_fix: *A64Fixups = a64_fixups_new(ngot);
    for k in 0..ng {
        g: *A64Sym = gots[k];
        if (g.sec < 0) a64_fixup(got_fix, 8 * k, a64_bind_value(g.imp)) else a64_fixup(got_fix,
            8 * k, a64_rebase_value(a64_sym_addr(g)))
    }
    starts_dc: *StrBuf = sb_new();
    if (has_got) a64_chain(got_fix, seg_bytes, dc_off, dc_off, got_size, starts_dc);
    starts_data: *StrBuf = sb_new();
    if (data_fix.count > 0) a64_chain(data_fix, seg_bytes, data_off, data_off, data_size,
        starts_data);
    // The starts in the image: one offset a segment (0 for none).
    image: *StrBuf = sb_new();
    a64_wle(image, nsegs, 4);
    first: int = 4 + 4 * nsegs;
    dc_start: int = first;
    data_start: int = first + starts_dc.used;
    for k in 0..nsegs {
        v: int = 0;
        if (has_got && k == 2 && starts_dc.used > 0) v = dc_start;
        if (k == nsegs - 2 && starts_data.used > 0) v = data_start;
        a64_wle(image, v, 4)
    }
    a64_wappend(image, starts_dc);
    a64_wappend(image, starts_data);
    names: *StrBuf = sb_new();
    sb_putc(names, 0i8);
    import_words: *StrBuf = sb_new();
    for k in 0..ni {
        imp: *A64Sym = imports[k];
        if (names.used >= 8388608) a64_link_fail("import names too long", "");
        a64_wle(import_words, imp.lib & 255 | names.used << 9, 4);
        sb_puts(names, imp.name);
        sb_putc(names, 0i8)
    }
    starts_at: int = 32;
    imports_at: int = a64_align_up(starts_at + image.used, 4);
    symbols_at: int = imports_at + import_words.used;
    a64_wle(fixups, 0, 4);
    a64_wle(fixups, starts_at, 4);
    a64_wle(fixups, imports_at, 4);
    a64_wle(fixups, symbols_at, 4);
    a64_wle(fixups, ni, 4);
    a64_wle(fixups, 1, 4);
    a64_wle(fixups, 0, 4);
    a64_pad(fixups, 8);
    a64_wappend(fixups, image);
    a64_pad(fixups, 4);
    a64_wappend(fixups, import_words);
    a64_wappend(fixups, names);
    a64_pad(fixups, 8);
    // The exports trie: __mh_execute_header, at offset 0.
    trie: *StrBuf = sb_new();
    sb_putc(trie, 0i8);
    sb_putc(trie, 1i8);
    sb_puts(trie, "__mh_execute_header");
    sb_putc(trie, 0i8);
    sb_putc(trie, (trie.used + 1) trunc i8);
    sb_putc(trie, 2i8);
    sb_putc(trie, 0i8);
    sb_putc(trie, 0i8);
    sb_putc(trie, 0i8);
    a64_pad(trie, 8);
    // Function starts (for debuggers and crash reports): each function's
    // address in __text, as ULEB128 steps from __TEXT's.
    starts: *StrBuf = sb_new();
    ntext: int = 0;
    s = a64_syms;
    while (s != null) {
        if (s.sec == A64_TEXT && !s.temp && len(s.name) > 0) ntext = ntext + 1;
        s = s.next
    }
    text_addrs: []int = new int[ntext + 1](0);
    ntext = 0;
    s = a64_syms;
    while (s != null) {
        if (s.sec == A64_TEXT && !s.temp && len(s.name) > 0) {
            text_addrs[ntext] = a64_sym_addr(s);
            ntext = ntext + 1
        }
        s = s.next
    }
    // (Newest first, so nearly in descending order: reversed, then sorted.)
    for k in 0..ntext / 2 {
        x: int = text_addrs[k];
        text_addrs[k] = text_addrs[ntext - 1 - k];
        text_addrs[ntext - 1 - k] = x
    }
    a64_sort_ints(text_addrs, ntext);
    last: int = A64_BASE;
    for k in 0..ntext {
        delta: int = text_addrs[k] - last;
        if (delta > 0) {
            while (delta >= 128) {
                sb_putc(starts, (delta & 127 | 128) trunc i8);
                delta = delta >> 7
            }
            sb_putc(starts, delta trunc i8);
            last = text_addrs[k]
        }
    }
    sb_putc(starts, 0i8);
    a64_pad(starts, 8);
    // The symbol table: locals, defined globals (and __mh_execute_header),
    // then the imports, each group by name.
    locals: []*A64Sym = new *A64Sym[a64_nsyms + 1](dummy);
    globals: []*A64Sym = new *A64Sym[a64_nsyms + 2](dummy);
    nl: int = 0;
    ngl: int = 0;
    header_sym: *A64Sym = a64_new_sym("__mh_execute_header");
    header_sym.global = true;
    s = a64_syms;
    while (s != null) {
        // (Local names starting with l are the linker's to drop.)
        if (s.sec >= 0 && !s.temp && len(s.name) > 0 && (s.global || s.name[0] != 'l')) {
            if (s.global) {
                globals[ngl] = s;
                ngl = ngl + 1
            } else {
                locals[nl] = s;
                nl = nl + 1
            }
        }
        s = s.next
    }
    globals[ngl] = header_sym;
    ngl = ngl + 1;
    a64_sort(locals, nl);
    a64_sort(globals, ngl);
    strtab: *StrBuf = sb_new();
    sb_putc(strtab, 32i8);
    sb_putc(strtab, 0i8);
    symtab: *StrBuf = sb_new();
    sect_text: int = 1;
    sect_const: int = 3;
    sect_data: int = ntext_sects + (if (has_got) 2 else 1);
    for k in 0..nl + ngl + ni {
        sym: *A64Sym = if (k < nl) locals[k] else if (k < nl + ngl) globals[k - nl] else imports[k - nl - ngl];
        sym.index = k;
        a64_wle(symtab, strtab.used, 4);
        sb_puts(strtab, sym.name);
        sb_putc(strtab, 0i8);
        if (k >= nl + ngl) {
            // N_UNDF | N_EXT, its library's ordinal in n_desc's high byte.
            sb_putc(symtab, 1i8);
            sb_putc(symtab, 0i8);
            a64_wle(symtab, (sym.lib & 255) << 8, 2);
            a64_wle(symtab, 0, 8)
        } else if (sym == header_sym) {
            sb_putc(symtab, 15i8);
            sb_putc(symtab, 1i8);
            a64_wle(symtab, 16, 2);
            a64_wle(symtab, A64_BASE, 8)
        } else {
            sb_putc(symtab, (if (sym.global) 15 else 14) trunc i8);
            sect: int = if (sym.sec == A64_TEXT) sect_text else if (sym.sec == A64_CONST) sect_const else sect_data;
            sb_putc(symtab, sect trunc i8);
            a64_wle(symtab, 0, 2);
            a64_wle(symtab, a64_sym_addr(sym), 8)
        }
    }
    a64_pad(strtab, 8);
    indirect: *StrBuf = sb_new();
    for k in 0..nst a64_wle(indirect, stubs[k].index, 4);
    for k in 0..ng {
        g: *A64Sym = gots[k];
        a64_wle(indirect, if (g.sec < 0) g.index else 2147483648, 4)
    }
    // __LINKEDIT's layout, and the code signature last.
    fixups_off: int = le_off;
    trie_off: int = fixups_off + fixups.used;
    starts_off: int = trie_off + trie.used;
    symtab_off: int = starts_off + starts.used;
    indirect_off: int = symtab_off + symtab.used;
    strtab_off: int = indirect_off + indirect.used;
    sig_off: int = a64_align_up(strtab_off + strtab.used, 16);
    npages: int = a64_align_up(sig_off, 4096) / 4096;
    cd_size: int = 88 + len(ident) + 1 + 32 * npages;
    sig_size: int = 20 + cd_size;
    total: int = sig_off + sig_size;
    out: []i8 = new i8[total](0i8);
    memcpy(out, 0, seg_bytes, 0, le_off);
    // The header.
    a64_put(out, 0, 4277009103, 4);
    a64_put(out, 4, 16777228, 4);
    a64_put(out, 8, 0, 4);
    a64_put(out, 12, 2, 4);
    a64_put(out, 16, ncmds, 4);
    a64_put(out, 20, cmds_size, 4);
    // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    a64_put(out, 24, 2097285, 4);
    at: int = 32;
    at = a64_seg_cmd(out, at, "__PAGEZERO", 0, 0, A64_BASE, 0, 0, 0, 0);
    at = a64_seg_cmd(out, at, "__TEXT", ntext_sects, A64_BASE, text_seg, 0, text_seg,
        5, 0);
    at = a64_sect(out, at, "__text", "__TEXT", A64_BASE + text_off, tsz, 4, 2147484672,
        0, 0);
    at = a64_sect(out, at, "__stubs", "__TEXT", stubs_addr, 12 * nstubs, 4, 2147484680,
        0, 12);
    if (has_const) at = a64_sect(out, at, "__const", "__TEXT", A64_BASE + const_off,
        csz, const_align, 0, 0, 0);
    if (has_got) {
        at = a64_seg_cmd(out, at, "__DATA_CONST", 1, A64_BASE + dc_off, dc_seg, dc_off,
            dc_seg, 3, 16);
        at = a64_sect(out, at, "__got", "__DATA_CONST", got_addr, got_size, 8, 6,
            nst, 0)
    }
    at = a64_seg_cmd(out, at, "__DATA", 1, A64_BASE + data_off, data_seg, data_off,
        data_seg, 3, 0);
    at = a64_sect(out, at, "__data", "__DATA", A64_BASE + data_off, data_size, data_align,
        0, 0, 0);
    le_size: int = total - le_off;
    at = a64_seg_cmd(out, at, "__LINKEDIT", 0, A64_BASE + le_off, a64_align_up(le_size,
        A64_PAGE), le_off, le_size, 1, 0);
    a64_put(out, at + 8, fixups_off, 4);
    a64_put(out, at + 12, fixups.used, 4);
    at = a64_cmd(out, at, 2147483700, 16);
    a64_put(out, at + 8, trie_off, 4);
    a64_put(out, at + 12, trie.used, 4);
    at = a64_cmd(out, at, 2147483699, 16);
    a64_put(out, at + 8, starts_off, 4);
    a64_put(out, at + 12, starts.used, 4);
    at = a64_cmd(out, at, 38, 16);
    a64_put(out, at + 8, symtab_off, 4);
    a64_put(out, at + 12, nl + ngl + ni, 4);
    a64_put(out, at + 16, strtab_off, 4);
    a64_put(out, at + 20, strtab.used, 4);
    at = a64_cmd(out, at, 2, 24);
    a64_put(out, at + 8, 0, 4);
    a64_put(out, at + 12, nl, 4);
    a64_put(out, at + 16, nl, 4);
    a64_put(out, at + 20, ngl, 4);
    a64_put(out, at + 24, nl + ngl, 4);
    a64_put(out, at + 28, ni, 4);
    a64_put(out, at + 56, indirect_off, 4);
    a64_put(out, at + 60, nst + ng, 4);
    at = a64_cmd(out, at, 11, 80);
    a64_put(out, at + 8, 12, 4);
    dyld: []i8 = "/usr/lib/dyld";
    for k in 0..len(dyld) out[at + 12 + k] = dyld[k];
    at = a64_cmd(out, at, 14, 32);
    uuid_at: int = at + 8;
    at = a64_cmd(out, at, 27, 24);
    // LC_BUILD_VERSION: minos 16.0, the sdk, no tools.
    a64_put(out, at + 8, platform, 4);
    a64_put(out, at + 12, 1048576, 4);
    a64_put(out, at + 16, sdk, 4);
    a64_put(out, at + 20, 0, 4);
    at = a64_cmd(out, at, 50, 24);
    at = a64_cmd(out, at, 42, 16);
    main: *A64Sym = a64_find("_main", 0, 5) or a64_link_fail("no _main", "");
    if (main.sec != A64_TEXT) a64_link_fail("no _main", "");
    a64_put(out, at + 8, a64_sym_addr(main) - A64_BASE, 8);
    at = a64_cmd(out, at, 2147483688, 24);
    if (encrypt) {
        a64_put(out, at + 8, text_off, 4);
        a64_put(out, at + 12, text_seg - text_off, 4);
        at = a64_cmd(out, at, 44, 24)
    }
    for k in 0..nlibs {
        lib: *A64Lib = a64_linked[k] or a64_link_fail("internal", "");
        size: int = a64_align_up(24 + len(lib.path) + 1, 8);
        a64_put(out, at + 8, 24, 4);
        a64_put(out, at + 12, 2, 4);
        a64_put(out, at + 16, lib.current, 4);
        a64_put(out, at + 20, lib.compat, 4);
        for i in 0..len(lib.path) out[at + 24 + i] = lib.path[i];
        at = a64_cmd(out, at, 12, size)
    }
    a64_put(out, at + 8, sig_off, 4);
    a64_put(out, at + 12, sig_size, 4);
    at = a64_cmd(out, at, 29, 16);
    if (at != 32 + cmds_size) a64_link_fail("internal: the load commands' size", "");
    // The sections' bytes, and the stubs.
    memcpy(out, text_off, a64_text.data, 0, tsz);
    for k in 0..nst {
        slot: int = got_addr + 8 * stubs[k].got;
        here: int = stubs_addr + 12 * k;
        pages: int = (slot & ~4095) - (here & ~4095) >> 12;
        o: int = stubs_off + 12 * k;
        // adrp x16, slot@PAGE; ldr x16, [x16, slot@PAGEOFF]; br x16
        a64_put(out, o, 2415919120 | (pages & 3) << 29 | (pages >> 2 & 524287) << 5,
            4);
        a64_put(out, o + 4, 4181721616 | (slot & 4095) / 8 << 10, 4);
        a64_put(out, o + 8, 3592356352, 4)
    }
    if (has_const) memcpy(out, const_off, a64_const.data, 0, csz);
    memcpy(out, data_off, a64_data.data, 0, a64_data.used);
    // (The data's fixups were written into seg_bytes; put them over the
    // data again.)
    for k in 0..data_fix.count {
        o: int = data_off + data_fix.offs[k];
        for i in 0..8 out[o + i] = seg_bytes[o + i]
    }
    memcpy(out, fixups_off, fixups.data, 0, fixups.used);
    memcpy(out, trie_off, trie.data, 0, trie.used);
    memcpy(out, starts_off, starts.data, 0, starts.used);
    memcpy(out, symtab_off, symtab.data, 0, symtab.used);
    memcpy(out, indirect_off, indirect.data, 0, indirect.used);
    memcpy(out, strtab_off, strtab.data, 0, strtab.used);
    // The UUID: from the SHA-256 of everything before the signature.
    hash: []i8 = new i8[32](0i8);
    a64_sha256(out, 0, sig_off, hash, 0);
    for k in 0..16 out[uuid_at + k] = hash[k];
    out[uuid_at + 6] = (hash[6] as int & 15 | 64) trunc i8;
    out[uuid_at + 8] = (hash[8] as int & 63 | 128) trunc i8;
    // The code signature: a SuperBlob of one CodeDirectory (version
    // 0x20400), ad hoc and linker-signed, hashing each 4 KiB page.
    a64_be(out, sig_off, 4208856256);
    a64_be(out, sig_off + 4, sig_size);
    a64_be(out, sig_off + 8, 1);
    a64_be(out, sig_off + 12, 0);
    a64_be(out, sig_off + 16, 20);
    cd: int = sig_off + 20;
    hash_off: int = 88 + len(ident) + 1;
    a64_be(out, cd, 4208856066);
    a64_be(out, cd + 4, cd_size);
    a64_be(out, cd + 8, 132096);
    a64_be(out, cd + 12, 131074);
    a64_be(out, cd + 16, hash_off);
    a64_be(out, cd + 20, 88);
    a64_be(out, cd + 24, 0);
    a64_be(out, cd + 28, npages);
    a64_be(out, cd + 32, sig_off);
    out[cd + 36] = 32i8;
    out[cd + 37] = 2i8;
    out[cd + 38] = 0i8;
    out[cd + 39] = 12i8;
    // (execSegBase 0, execSegLimit, execSegFlags CS_EXECSEG_MAIN_BINARY)
    a64_be(out, cd + 76, text_seg);
    a64_be(out, cd + 84, 1);
    for k in 0..len(ident) out[cd + 88 + k] = ident[k];
    for p in 0..npages {
        start: int = 4096 * p;
        n: int = if (start + 4096 <= sig_off) 4096 else sig_off - start;
        a64_sha256(out, start, n, out, cd + hash_off + 32 * p)
    }
    a64_write_file(path, out, total)
}

// A big-endian 32-bit value (code signatures are big-endian).
a64_be(b: []i8, off: int, v: int) {
    b[off] = (v >> 24 & 255) trunc i8;
    b[off + 1] = (v >> 16 & 255) trunc i8;
    b[off + 2] = (v >> 8 & 255) trunc i8;
    b[off + 3] = (v & 255) trunc i8
}
