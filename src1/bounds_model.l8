tag compiler_internal;

const BOUNDS_JOIN_TERMS: int = 8;

BOUNDS_SUMMARY_DEPTH: int = 3;

BOUNDS_SUMMARY_INPUT_GUARDS: int = 16;

BOUNDS_SUMMARY_FACTS_PER_GUARD: int = 16;

BOUNDS_SUMMARY_IMPLICATIONS: int = 32;

// Shared data schemas for the bounds checker.
type BoundsKind =
    | Difference
    | SumUpper
    | Separate
    | Fresh
    | Cursor
    | Equal
    | NotEqual

type BoundsRow = {
    index: *Obj;
    array: ?*Obj;
    kind: BoundsKind;
    value: int;
    left: ?*Expr;
    right: ?*Expr;
    separation: ?*BoundsSeparation
}

// Bucket chains are persistent across snapshots of a fact table.
type BoundsLinkNode = {
    position: int;
    next: ?*BoundsLinkNode
} invariant (0 <= position)

// A bounded pair of scratch graphs and search workspaces. Keys identify
// immutable storage prefixes; neither cache owns the source fact buffers.
BOUNDS_GRAPH_CACHE_ROWS: int = 1024;

type BoundsGraphCache = {
    graph: *BoundsGraph;
    // Distances from one source; partial results remain valid upper bounds.
    source: ?*BoundsGraphWork;
    complete: bool;
    storage: ?*BoundsStorage;
    count: int
}

// Fact buffers are recycled only after the entire function pass ends.
// Exported summaries copy rows by value and retain independently owned terms.
type BoundsArena = {
    first_graph: *BoundsGraphCache;
    second_graph: *BoundsGraphCache;
    free: []?*BoundsStorage;
    active: ?*BoundsStorage
}

type BoundsStorage = {
    // Exact copied prefix provenance, valid until the arena is reset.
    prefix_source: ?*BoundsStorage;
    prefix_count: int;
    pool_next: ?*BoundsStorage;
    rows: []BoundsRow;
    // Decoded once when a fact is inserted; graph and direct queries reuse it.
    numeric: []BoundsNumericView;
    buckets: []?*BoundsLinkNode;
    links: []BoundsLinkNode;
    used: int
} invariant (0 <= prefix_count && prefix_count <= len(rows) && 0 < len(rows) && len(rows) == len(numeric) && len(rows) == len(links) && 0 < len(buckets) && 0 <= used && used <= len(rows))

// Immutable prefix of append-only storage. Extending the latest prefix uses
// spare capacity. Extending an older branch copies that prefix exactly once.
// Readers must only inspect count rows, not the storage's high-water mark.
type BoundsState = {
    arena: ?*BoundsArena;
    // Bottom is distinct from null (reachable with no known facts).
    unreachable: bool;
    storage: ?*BoundsStorage;
    rows_view: []BoundsRow;
    numeric_view: []BoundsNumericView;
    count: int;
    sum_count: int;
    implications: ?*BoundsImplication
} invariant (0 <= count && count <= len(numeric_view) && count <= len(rows_view))

// A summary and a live flow state use the same fact language. Premises form
// a conjunction; an empty premise list means the consequence is unconditional.
type BoundsPremise = {
    fact: BoundsRow;
    next: ?*BoundsPremise
}

type BoundsImplication = {
    premises: ?*BoundsPremise;
    consequence: BoundsRow;
    next: ?*BoundsImplication
}

type BoundsSummaryFact = {
    fact: BoundsRow;
    next: ?*BoundsSummaryFact
}

type BoundsGuardFacts = {
    premise: BoundsRow;
    literal: ?*Expr;
    facts: ?*BoundsSummaryFact;
    seen: bool;
    next: ?*BoundsGuardFacts
}

type BoundsScalarClass = {
    reachable: []bool;
    rows: []int;
    count: int
} invariant (0 <= count && count <= len(rows) && 0 < len(rows))

// Relaxation reads all three fields together from a proven row access.
type BoundsGraphWork = {
    id: int;
    term: *BoundsTermRef;
    head: ?*BoundsGraphEdge;
    distance: int;
    queued: bool
}

type BoundsGraphEdge = {
    target: *BoundsGraphWork;
    weight: int;
    next: ?*BoundsGraphEdge
}

type BoundsGraphImplicitEdges = {
    nonnegative: BoundsGraphEdge;
    known_lower: BoundsGraphEdge;
    known_upper: BoundsGraphEdge
}

type BoundsGraph = {
    terms: []BoundsTermRef;
    slots: []?*BoundsGraphWork;
    occupied_slots: []*?*BoundsGraphWork;
    row_edges: []BoundsGraphEdge;
    implicit_edges: []BoundsGraphImplicitEdges;
    work: []BoundsGraphWork;
    queue: []*BoundsGraphWork;
    // Bound virtual-endpoint arithmetic away from the search sentinel.
    small_weights: bool;
    nodes: int;
    edges: int
} invariant (len(occupied_slots) == len(terms) && len(implicit_edges) == len(work) && len(terms) < len(queue) && 0 <= nodes && nodes <= len(terms) && nodes <= len(work) && 0 < len(work) && 0 < len(slots))

type BoundsAffine = {
    base: *Expr;
    offset: int
}

// A numeric term is zero, a path, or the length of a path. A path is either
// already an AST expression or a compact object reference from a fact row.
// A variable path also caches its Obj for hashing and identity comparisons.
// valid occupies existing term padding; an invalid endpoint rejects a query.
// These views do not allocate or outlive the fact from which they were read.
type BoundsTermRef = {
    path: ?*Expr;
    obj: ?*Obj;
    is_len: bool;
    is_zero: bool;
    valid: bool
}

// Embedded endpoints can be borrowed directly. Two 24-byte terms plus the
// bound and separation occupy 64 bytes, with no separate validity field.
type BoundsNumericView = {
    left: BoundsTermRef;
    right: BoundsTermRef;
    bound: int;
    separation: ?*BoundsSeparation
}

// Search returns evidence; only an obligation consumer may commit assumptions.
type BoundsEvidence = {
    bound: int;
    separation: ?*BoundsSeparation
}

type BoundsReturnFact = {
    // Null means the scalar result; otherwise a path rooted at bounds_result.
    projection: ?*Expr;
    term: *Expr;
    result_left: bool;
    bound: int;
    next: ?*BoundsReturnFact
}

type BoundsTodo = {
    fn: *Function;
    next: ?*BoundsTodo
}

type BoundsComponent = {
    members: ?*BoundsTodo;
    next: ?*BoundsComponent
}

bounds_infer_mode: bool = false;

bounds_infer_changed: bool = false;

bounds_input_changed: bool = false;

bounds_scc_counter: int = 0;

bounds_scc_stack: ?*BoundsTodo = null;

bounds_scc_first: ?*BoundsComponent = null;

bounds_scc_last: ?*BoundsComponent = null;

bounds_current_fn: ?*Function = null;

bounds_return_accum: ?*BoundsReturnFact = null;

bounds_return_seen: bool = false;

bounds_guards: ?*BoundsGuardFacts = null;

// Reverse call-site incidence table for the effect work queue.
type BoundsEffectSite = {
    caller: ?*Function;
    callee: ?*Function;
    args: ?*Expr;
    next: ?*BoundsEffectSite
}

type BoundsEffectSites = {
    write_buckets: []?*BoundsWrite
} invariant (0 < len(write_buckets))

type BoundsEffectQueue = {
    head: ?*Function;
    tail: ?*Function
}

// Each handler collects only exceptional predecessors. Normal states continue
// through the AST; return states are projected by bounds_return_visit.
type BoundsHandler = {
    arm: *CatchArm;
    incoming: ?*BoundsState;
    next: ?*BoundsHandler
}

bounds_handlers: ?*BoundsHandler = null;

// Collect reachable access sites during final validation. Loop revisits must
// all prove an access before a redundant-check diagnostic is justified.
type BoundsAccess = {
    file: int;
    pos: int;
    array: *Expr;
    index: *Expr;
    required: bool;
    next: ?*BoundsAccess
}

bounds_accesses: ?*BoundsAccess = null
