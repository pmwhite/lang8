tag compiler_internal;

BOUNDS_JOIN_TERMS: int = 8;

BOUNDS_SUMMARY_DEPTH: int = 3;

BOUNDS_SUMMARY_INPUT_GUARDS: int = 16;

BOUNDS_SUMMARY_FACTS_PER_GUARD: int = 16;

BOUNDS_SUMMARY_IMPLICATIONS: int = 32;

// Shared data schemas for the bounds checker.
type BoundsKind =
    | Difference
    | SumUpper
    | Separate
    | Fresh
    | Cursor
    | Equal
    | NotEqual

type BoundsRow = {
    index: *Obj;
    array: ?*Obj;
    kind: BoundsKind;
    value: int;
    left: ?*Expr;
    right: ?*Expr;
    separation: ?*BoundsSeparation
}

type BoundsStorage = {
    rows: []BoundsRow;
    buckets: []int;
    links: []int;
    used: int
}

// Immutable prefix of append-only storage. Extending the latest prefix uses
// spare capacity. Extending an older branch copies that prefix exactly once.
// Readers must only inspect count rows, not the storage's high-water mark.
type BoundsState = {
    storage: *BoundsStorage;
    count: int;
    sum_count: int;
    implications: ?*BoundsImplication
}

// A summary and a live flow state use the same fact language. Premises form
// a conjunction; an empty premise list means the consequence is unconditional.
type BoundsPremise = {
    fact: BoundsRow;
    next: ?*BoundsPremise
}

type BoundsImplication = {
    premises: ?*BoundsPremise;
    consequence: BoundsRow;
    next: ?*BoundsImplication
}

type BoundsSummaryFact = {
    fact: BoundsRow;
    next: ?*BoundsSummaryFact
}

type BoundsGuardFacts = {
    premise: BoundsRow;
    literal: ?*Expr;
    facts: ?*BoundsSummaryFact;
    seen: bool;
    next: ?*BoundsGuardFacts
}

type BoundsScalarClass = {
    reachable: []bool
}

type BoundsGraph = {
    terms: []BoundsTermRef;
    slots: []int;
    heads: []int;
    targets: []int;
    weights: []int;
    links: []int;
    nodes: int;
    edges: int
}

type BoundsAffine = {
    base: *Expr;
    offset: int
}

// A numeric term is zero, a path, or the length of a path. A path is either
// already an AST expression or a compact object reference from a fact row.
// These views do not allocate or outlive the fact from which they were read.
type BoundsTermRef = {
    path: ?*Expr;
    obj: ?*Obj;
    is_len: bool;
    is_zero: bool
}

type BoundsNumericView = {
    left_path: ?*Expr;
    left_obj: ?*Obj;
    left_len: bool;
    left_zero: bool;
    right_path: ?*Expr;
    right_obj: ?*Obj;
    right_len: bool;
    right_zero: bool;
    bound: int;
    separation: ?*BoundsSeparation;
    valid: bool
}

type BoundsReturnFact = {
    // Null means the scalar result; otherwise a path rooted at bounds_result.
    projection: ?*Expr;
    term: *Expr;
    result_left: bool;
    bound: int;
    next: ?*BoundsReturnFact
}

type BoundsTodo = {
    fn: *Function;
    next: ?*BoundsTodo
}

type BoundsComponent = {
    members: ?*BoundsTodo;
    next: ?*BoundsComponent
}

bounds_infer_mode: bool = false;

bounds_infer_changed: bool = false;

bounds_input_changed: bool = false;

bounds_scc_counter: int = 0;

bounds_scc_stack: ?*BoundsTodo = null;

bounds_scc_first: ?*BoundsComponent = null;

bounds_scc_last: ?*BoundsComponent = null;

bounds_current_fn: ?*Function = null;

bounds_return_accum: ?*BoundsReturnFact = null;

bounds_return_seen: bool = false;

bounds_guards: ?*BoundsGuardFacts = null;

// Reverse call-site incidence table for the effect work queue.
type BoundsEffectSite = {
    caller: ?*Function;
    callee: ?*Function;
    args: ?*Expr;
    next: int
}

type BoundsEffectSites = {
    rows: []BoundsEffectSite;
    count: int;
    heads: []int;
    write_buckets: []?*BoundsWrite
}
