import "common.l8";

import "assembler.l8";

import "direct.l8";

import "compiler.l8";

import "elfpack.l8";

import "browse.l8";

import "fmt.l8";

build_usage(): int {
    write(2, "error: usage: l8 build [--profile|-p] <source.l8> -o <executable>\n",
        len("error: usage: l8 build [--profile|-p] <source.l8> -o <executable>\n"));
    1;
}

build_main(argc: int, argv: [][z]i8) noregion: int {
    do_profile = 0;
    have_s: int = 0;
    have_o: int = 0;
    if (argc < 1) {
        return build_usage();
    }
    source: [z]i8 = argv[0];
    output: [z]i8 = argv[0];
    want_o: int = 0;
    ai: int = 1;
    while (ai < argc) {
        arg: [z]i8 = argv[ai];
        if (want_o != 0) {
            if (have_o != 0) {
                return build_usage();
            }
            output = arg;
            have_o = 1;
            want_o = 0;
        } else {
            if (is_profile_flag(arg)) {
                do_profile = 1;
            } else {
                if (cli_streq(arg, "-o")) {
                    want_o = 1;
                } else {
                    if (have_s != 0) {
                        return build_usage();
                    }
                    source = arg;
                    have_s = 1;
                }
            }
        }
        ai = ai + 1;
    }
    if (have_s == 0) {
        return build_usage();
    }
    if (have_o == 0) {
        return build_usage();
    }
    if (want_o != 0) {
        return build_usage();
    }
    rc: int = compiler_build_direct(zslice(source));
    if (rc != 0) {
        return rc;
    }
    pack_assembler_exec(output);
    profile_mark("pack");
    profile_end();
    0;
}

main(argc: int, argv: [][z]i8@new) noregion: int {
    if (argc < 2) {
        write(2, "usage: l8 <compile|as|elfpack|build|browse|fmt> ...\n", len("usage: l8 <compile|as|elfpack|build|browse|fmt> ...\n"));
        return 1;
    }
    command: [z]i8 = argv[1];
    if (cli_streq(command, "compile")) {
        return compiler_main(argc - 1, argv_span(argv, 1));
    }
    if (cli_streq(command, "as")) {
        return assembler_main(argc - 1, argv_span(argv, 1));
    }
    if (cli_streq(command, "elfpack")) {
        return elfpack_main(argc - 1, argv_span(argv, 1));
    }
    if (cli_streq(command, "build")) {
        return build_main(argc - 1, argv_span(argv, 1));
    }
    if (cli_streq(command, "browse")) {
        return compiler_browse_main(argc - 1, argv_span(argv, 1));
    }
    if (cli_streq(command, "fmt")) {
        return compiler_fmt_main(argc - 1, argv_span(argv, 1));
    }
    write(2, "error: unknown subcommand\n", len("error: unknown subcommand\n"));
    1;
}
