import "common.l8";
import "assembler.l8";
import "direct.l8";
import "compiler.l8";
import "elfpack.l8";

build_main(argc: int, argv: **i8): int {
    if (argc != 4) {
        write(2, "error: usage: l8 build <source.l8> -o <executable>\n", len("error: usage: l8 build <source.l8> -o <executable>\n"));
        return 1;
    }
    source: *i8 = (argv + 8).*;
    dash_o: *i8 = (argv + 16).*;
    output: *i8 = (argv + 24).*;
    if (!cli_streq(dash_o, "-o")) {
        write(2, "error: usage: l8 build <source.l8> -o <executable>\n", len("error: usage: l8 build <source.l8> -o <executable>\n"));
        return 1;
    }
    rc: int = compiler_build_direct(source);
    if (rc != 0) { return rc; }
    pack_assembler_exec(output);
    return 0;
}

main(argc: int, argv: **i8): int {
    if (argc < 2) {
        write(2, "usage: l8 <compile|as|elfpack|build> ...\n", len("usage: l8 <compile|as|elfpack|build> ...\n"));
        return 1;
    }
    command: *i8 = (argv + 8).*;
    if (cli_streq(command, "compile")) {
        return compiler_main(argc - 1, argv + 8);
    }
    if (cli_streq(command, "as")) {
        return assembler_main(argc - 1, argv + 8);
    }
    if (cli_streq(command, "elfpack")) {
        return elfpack_main(argc - 1, argv + 8);
    }
    if (cli_streq(command, "build")) {
        return build_main(argc - 1, argv + 8);
    }
    write(2, "error: unknown subcommand\n", len("error: unknown subcommand\n"));
    return 1;
}
