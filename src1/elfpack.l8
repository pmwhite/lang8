// elfpack: one fully-resolved ELF64 .o → static ET_EXEC (no ld).
// Supports R_X86_64_PC32 and R_X86_64_PLT32 only.
// Usage: elfpack <in.o> -o <out>

pack_PAGE: int = 4096;
pack_LOAD_BASE: int = 4194304;
pack_O_RDONLY: int = 0;
pack_O_WRONLY: int = 1;
pack_O_CREAT: int = 64;
pack_O_TRUNC: int = 512;
pack_MODE_755: int = 493;
pack_SHN_UNDEF: int = 0;
pack_SHN_ABS: int = 65521;
pack_SHT_NULL: int = 0;
pack_ET_REL: int = 1;
pack_ET_EXEC: int = 2;
pack_EM_X86_64: int = 62;
pack_R_X86_64_PC32: int = 2;
pack_R_X86_64_PLT32: int = 4;
pack_PT_LOAD: int = 1;
pack_PF_X: int = 1;
pack_PF_W: int = 2;
pack_PF_R: int = 4;
pack_STB_GLOBAL: int = 1;

pack_fail(pack_msg: []i8): noreturn {
    write(2, "elfpack: ", len("elfpack: "));
    write(2, pack_msg, len(pack_msg));
    write(2, "\n", len("\n"));
    exit(1);
}

pack_memset0(pack_dst: []i8, pack_off: int, pack_n: int) {
    pack_i: int = 0;
    while (pack_i < pack_n) {
        pack_dst[pack_off + pack_i] = 0i8;
        pack_i = pack_i + 1;
    }
}

pack_streq(pack_a: []i8, pack_b: []i8): bool {
    if (pack_a == pack_b) { return true; }
    pack_i: int = 0;
    while (true) {
        pack_ae: bool = pack_i >= len(pack_a) || pack_a[pack_i] == 0i8;
        pack_be: bool = pack_i >= len(pack_b) || pack_b[pack_i] == 0i8;
        if (pack_ae || pack_be) { return pack_ae && pack_be; }
        if (pack_a[pack_i] != pack_b[pack_i]) { return false; }
        pack_i = pack_i + 1;
    }
    false;
}

pack_streq_at(pack_buf: []i8, pack_off: int, pack_lit: []i8): bool {
    pack_n: int = len(pack_lit);
    pack_i: int = 0;
    while (pack_i < pack_n) {
        if (pack_off + pack_i >= len(pack_buf) || pack_buf[pack_off + pack_i] != pack_lit[pack_i]) { return false; }
        pack_i = pack_i + 1;
    }
    if (pack_off + pack_n >= len(pack_buf)) { return false; }
    pack_buf[pack_off + pack_n] == 0i8;
}

pack_align_up(pack_x: int, pack_a: int): int {
    ((pack_x + pack_a - 1) / pack_a) * pack_a;
}

pack_rd_le(pack_b: []i8, pack_o: int, pack_n: int): int {
    pack_v: int = 0;
    pack_i: int = 0;
    while (pack_i < pack_n) {
        pack_c: int = (pack_b[pack_o + pack_i] as int) & 255;
        pack_v = pack_v + (pack_c << (pack_i * 8));
        pack_i = pack_i + 1;
    }
    pack_v;
}

pack_wr_le(pack_b: []i8, pack_o: int, pack_v: int, pack_n: int) {
    pack_i: int = 0;
    pack_x: int = pack_v;
    while (pack_i < pack_n) {
        pack_b[pack_o + pack_i] = (pack_x & 255) trunc i8;
        pack_x = pack_x >> 8;
        pack_i = pack_i + 1;
    }
}

pack_rd16(pack_b: []i8, pack_o: int): int { pack_rd_le(pack_b, pack_o, 2); }

pack_rd32(pack_b: []i8, pack_o: int): int { pack_rd_le(pack_b, pack_o, 4); }

pack_rd64(pack_b: []i8, pack_o: int): int { pack_rd_le(pack_b, pack_o, 8); }

pack_wr16(pack_b: []i8, pack_o: int, pack_v: int) { pack_wr_le(pack_b, pack_o, pack_v, 2); }

pack_wr32(pack_b: []i8, pack_o: int, pack_v: int) { pack_wr_le(pack_b, pack_o, pack_v, 4); }

pack_wr64(pack_b: []i8, pack_o: int, pack_v: int) { pack_wr_le(pack_b, pack_o, pack_v, 8); }

pack_in_len: int = 0;
pack_in_buf: []i8 = "";

pack_load_file(pack_path: [z]i8) {
    pack_fd: int = open(pack_path, pack_O_RDONLY, 0);
    if (pack_fd < 0) { pack_fail("cannot open input"); }
    pack_cap: int = 262144;
    pack_buf: []i8 = new i8[pack_cap](0i8);
    pack_n: int = 0;
    while (true) {
        pack_room: int = pack_cap - pack_n;
        if (pack_room <= 0) {
            pack_cap = pack_cap * 2;
            pack_tmp: []i8 = new i8[pack_cap](0i8);
            memcpy(pack_tmp, 0, pack_buf, 0, pack_n);
            pack_buf = pack_tmp;
            pack_room = pack_cap - pack_n;
        }
        pack_r: int = read(pack_fd, pack_buf, pack_n, pack_room);
        if (pack_r <= 0) {
            close(pack_fd);
            pack_in_buf = pack_buf;
            pack_in_len = pack_n;
            return;
        }
        pack_n = pack_n + pack_r;
    }
}

pack_is_dash_o(pack_s: [z]i8): bool {
    pack_s[0] == '-' && pack_s[1] == 'o' && pack_s[2] == 0i8;
}

// Pack the assembler builder directly. No ET_REL bytes are produced or parsed.
pack_assembler_exec(pack_out_p: [z]i8) {
    pack_rx_off: int = pack_PAGE;
    pack_text_off: int = pack_rx_off;
    pack_rodata_off: int = pack_align_up(pack_text_off + as_text_len, 16);
    pack_rx_end: int = pack_rodata_off + as_rodata_len;
    pack_data_off: int = pack_align_up(pack_rx_end, pack_PAGE);
    pack_file_end: int = pack_data_off + as_data_len;

    pack_text_vma: int = pack_LOAD_BASE + pack_text_off;
    pack_rodata_vma: int = pack_LOAD_BASE + pack_rodata_off;
    pack_data_vma: int = pack_LOAD_BASE + pack_data_off;
    pack_bss_vma: int = pack_align_up(pack_data_vma + as_data_len, 8);

    pack_sym_addr: []int = new int[as_nsyms + 1](0);
    pack_entry: int = 0;
    pack_i: int = 0;
    while (pack_i < as_nsyms) {
        if (as_syms[pack_i].as_defined == 0) {
            write(2, "elfpack: undefined symbol: ", len("elfpack: undefined symbol: "));
            write(2, as_syms[pack_i].as_name, len(as_syms[pack_i].as_name));
            write(2, "\n", len("\n"));
            exit(1);
        }
        pack_addr: int = as_syms[pack_i].as_val;
        if (as_syms[pack_i].as_sec == as_SEC_TEXT) { pack_addr = pack_addr + pack_text_vma; }
        else {
            if (as_syms[pack_i].as_sec == as_SEC_RODATA) { pack_addr = pack_addr + pack_rodata_vma; }
            else {
                if (as_syms[pack_i].as_sec == as_SEC_DATA) { pack_addr = pack_addr + pack_data_vma; }
                else {
                    if (as_syms[pack_i].as_sec == as_SEC_BSS) { pack_addr = pack_addr + pack_bss_vma; }
                    else {
                        if (as_syms[pack_i].as_sec != as_SEC_ABS) { pack_fail("bad symbol section"); }
                    }
                }
            }
        }
        pack_sym_addr[pack_i] = pack_addr;
        if (pack_streq(as_syms[pack_i].as_name, "_start")) { pack_entry = pack_addr; }
        pack_i = pack_i + 1;
    }
    if (pack_entry == 0) { pack_fail("missing _start"); }

    pack_text: []i8 = new i8[as_text_len + 1](0i8);
    memcpy(pack_text, 0, as_text_buf, 0, as_text_len);
    pack_i = 0;
    while (pack_i < as_nrels) {
        pack_rel: *as_Rel = &as_rels[pack_i];
        if (pack_rel.as_typ != as_R_X86_64_PC32 && pack_rel.as_typ != as_R_X86_64_PLT32) {
            pack_fail("unsupported reloc type");
        }
        if (pack_rel.as_off < 0 || pack_rel.as_off + 4 > as_text_len) { pack_fail("reloc out of range"); }
        if (pack_rel.as_sym < 0 || pack_rel.as_sym >= as_nsyms) { pack_fail("bad reloc symbol"); }
        pack_S: int = pack_sym_addr[pack_rel.as_sym];
        pack_P: int = pack_text_vma + pack_rel.as_off;
        pack_wr32(pack_text, pack_rel.as_off, pack_S + pack_rel.as_addend - pack_P);
        pack_i = pack_i + 1;
    }

    pack_out: []i8 = new i8[pack_file_end](0i8);
    pack_memset0(pack_out, 0, pack_file_end);
    pack_out[0] = 127i8;
    pack_out[1] = 'E';
    pack_out[2] = 'L';
    pack_out[3] = 'F';
    pack_out[4] = 2i8;
    pack_out[5] = 1i8;
    pack_out[6] = 1i8;
    pack_wr16(pack_out, 16, pack_ET_EXEC);
    pack_wr16(pack_out, 18, pack_EM_X86_64);
    pack_wr32(pack_out, 20, 1);
    pack_wr64(pack_out, 24, pack_entry);
    pack_wr64(pack_out, 32, 64);
    pack_wr16(pack_out, 52, 64);
    pack_wr16(pack_out, 54, 56);
    pack_nph: int = 1;
    if (as_data_len > 0 || as_bss_size > 0) { pack_nph = 2; }
    pack_wr16(pack_out, 56, pack_nph);

    pack_ph0: int = 64;
    pack_wr32(pack_out, pack_ph0 + 0, pack_PT_LOAD);
    pack_wr32(pack_out, pack_ph0 + 4, pack_PF_R + pack_PF_X);
    pack_wr64(pack_out, pack_ph0 + 8, pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 16, pack_LOAD_BASE + pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 24, pack_LOAD_BASE + pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 32, pack_rx_end - pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 40, pack_rx_end - pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 48, pack_PAGE);

    if (pack_nph == 2) {
        pack_ph1: int = 120;
        pack_wr32(pack_out, pack_ph1 + 0, pack_PT_LOAD);
        pack_wr32(pack_out, pack_ph1 + 4, pack_PF_R + pack_PF_W);
        pack_wr64(pack_out, pack_ph1 + 8, pack_data_off);
        pack_wr64(pack_out, pack_ph1 + 16, pack_data_vma);
        pack_wr64(pack_out, pack_ph1 + 24, pack_data_vma);
        pack_wr64(pack_out, pack_ph1 + 32, as_data_len);
        pack_wr64(pack_out, pack_ph1 + 40, (pack_bss_vma + as_bss_size) - pack_data_vma);
        pack_wr64(pack_out, pack_ph1 + 48, pack_PAGE);
    }

    memcpy(pack_out, pack_text_off, pack_text, 0, as_text_len);
    if (as_rodata_len > 0) { memcpy(pack_out, pack_rodata_off, as_rodata_buf, 0, as_rodata_len); }
    if (as_data_len > 0) { memcpy(pack_out, pack_data_off, as_data_buf, 0, as_data_len); }

    pack_fd: int = open(pack_out_p, pack_O_WRONLY + pack_O_CREAT + pack_O_TRUNC, pack_MODE_755);
    if (pack_fd < 0) { pack_fail("cannot create output"); }
    pack_w: int = 0;
    while (pack_w < pack_file_end) {
        pack_n: int = write(pack_fd, pack_out, pack_w, pack_file_end - pack_w);
        if (pack_n <= 0) { pack_fail("write failed"); }
        pack_w = pack_w + pack_n;
    }
    close(pack_fd);
}

elfpack_main(pack_argc: int, pack_argv: [][z]i8): int {
    if (pack_argc != 4) { pack_fail("usage: l8 elfpack <in.o> -o <out>"); }
    pack_arg1: [z]i8 = pack_argv[1];
    pack_arg2: [z]i8 = pack_argv[2];
    pack_arg3: [z]i8 = pack_argv[3];
    if (!pack_is_dash_o(pack_arg2)) { pack_fail("usage: l8 elfpack <in.o> -o <out>"); }
    pack_in_p: [z]i8 = pack_arg1;
    pack_out_p: [z]i8 = pack_arg3;

    pack_load_file(pack_in_p);
    pack_b: []i8 = pack_in_buf;
    if (pack_in_len < 64) { pack_fail("input too small"); }
    if (pack_b[0] != 127i8 || pack_b[1] != 'E' || pack_b[2] != 'L' || pack_b[3] != 'F') { pack_fail("not ELF"); }
    if (pack_b[4] != 2i8 || pack_b[5] != 1i8) { pack_fail("need ELF64 LE"); }
    if (pack_rd16(pack_b, 16) != pack_ET_REL) { pack_fail("need relocatable ET_REL"); }
    if (pack_rd16(pack_b, 18) != pack_EM_X86_64) { pack_fail("need EM_X86_64"); }

    pack_e_shoff: int = pack_rd64(pack_b, 40);
    pack_e_shentsize: int = pack_rd16(pack_b, 58);
    pack_e_shnum: int = pack_rd16(pack_b, 60);
    pack_e_shstrndx: int = pack_rd16(pack_b, 62);
    if (pack_e_shentsize != 64 || pack_e_shnum == 0) { pack_fail("bad section headers"); }

    pack_shstr_off: int = pack_rd64(pack_b, pack_e_shoff + pack_e_shstrndx * 64 + 24);
    pack_shstr_base: int = pack_shstr_off;

    pack_text_i: int = 0 - 1;
    pack_rodata_i: int = 0 - 1;
    pack_data_i: int = 0 - 1;
    pack_bss_i: int = 0 - 1;
    pack_symtab_i: int = 0 - 1;
    pack_rela_text_i: int = 0 - 1;

    pack_si: int = 0;
    while (pack_si < pack_e_shnum) {
        pack_sh: int = pack_e_shoff + pack_si * 64;
        pack_name_off: int = pack_shstr_base + pack_rd32(pack_b, pack_sh + 0);
        if (pack_streq_at(pack_b, pack_name_off, ".text")) { pack_text_i = pack_si; }
        if (pack_streq_at(pack_b, pack_name_off, ".rodata")) { pack_rodata_i = pack_si; }
        if (pack_streq_at(pack_b, pack_name_off, ".data")) { pack_data_i = pack_si; }
        if (pack_streq_at(pack_b, pack_name_off, ".bss")) { pack_bss_i = pack_si; }
        if (pack_streq_at(pack_b, pack_name_off, ".symtab")) { pack_symtab_i = pack_si; }
        if (pack_streq_at(pack_b, pack_name_off, ".rela.text")) { pack_rela_text_i = pack_si; }
        if (pack_name_off + 6 < len(pack_b)
            && pack_b[pack_name_off] == '.' && pack_b[pack_name_off + 1] == 'r' && pack_b[pack_name_off + 2] == 'e'
            && pack_b[pack_name_off + 3] == 'l' && pack_b[pack_name_off + 4] == 'a' && pack_b[pack_name_off + 5] == '.'
            && !pack_streq_at(pack_b, pack_name_off, ".rela.text")) {
            pack_fail("unsupported relocation section");
        }
        pack_si = pack_si + 1;
    }
    if (pack_text_i < 0) { pack_fail("missing .text"); }
    if (pack_symtab_i < 0) { pack_fail("missing .symtab"); }

    pack_text_sh: int = pack_e_shoff + pack_text_i * 64;
    pack_text_fileoff: int = pack_rd64(pack_b, pack_text_sh + 24);
    pack_text_sz: int = pack_rd64(pack_b, pack_text_sh + 32);

    pack_rodata_sz: int = 0;
    pack_rodata_fileoff: int = 0;
    if (pack_rodata_i >= 0) {
        pack_rsh: int = pack_e_shoff + pack_rodata_i * 64;
        pack_rodata_fileoff = pack_rd64(pack_b, pack_rsh + 24);
        pack_rodata_sz = pack_rd64(pack_b, pack_rsh + 32);
    }

    pack_data_sz: int = 0;
    pack_data_fileoff: int = 0;
    if (pack_data_i >= 0) {
        pack_dsh: int = pack_e_shoff + pack_data_i * 64;
        pack_data_fileoff = pack_rd64(pack_b, pack_dsh + 24);
        pack_data_sz = pack_rd64(pack_b, pack_dsh + 32);
    }

    pack_bss_sz: int = 0;
    if (pack_bss_i >= 0) {
        pack_bsh: int = pack_e_shoff + pack_bss_i * 64;
        pack_bss_sz = pack_rd64(pack_b, pack_bsh + 32);
    }

    pack_sym_sh: int = pack_e_shoff + pack_symtab_i * 64;
    pack_sym_off: int = pack_rd64(pack_b, pack_sym_sh + 24);
    pack_sym_sz: int = pack_rd64(pack_b, pack_sym_sh + 32);
    pack_sym_link: int = pack_rd32(pack_b, pack_sym_sh + 40);
    pack_str_sh: int = pack_e_shoff + pack_sym_link * 64;
    pack_str_off: int = pack_rd64(pack_b, pack_str_sh + 24);
    pack_str_base: int = pack_str_off;
    pack_nsym: int = pack_sym_sz / 24;

    /* reject undefined globals */
    pack_zi: int = 0;
    while (pack_zi < pack_nsym) {
        pack_so: int = pack_sym_off + pack_zi * 24;
        pack_st_name: int = pack_rd32(pack_b, pack_so + 0);
        pack_st_info: int = pack_b[pack_so + 4] as int;
        if (pack_st_info < 0) { pack_st_info = pack_st_info + 256; }
        pack_st_shndx: int = pack_rd16(pack_b, pack_so + 6);
        pack_bind: int = pack_st_info / 16;
        if (pack_st_shndx == pack_SHN_UNDEF && pack_bind == pack_STB_GLOBAL && pack_st_name != 0) {
            pack_fail("undefined symbol");
        }
        pack_zi = pack_zi + 1;
    }

    pack_rx_off: int = pack_PAGE;
    pack_text_off: int = pack_rx_off;
    pack_rodata_off: int = pack_align_up(pack_text_off + pack_text_sz, 16);
    pack_rx_end: int = pack_rodata_off + pack_rodata_sz;
    pack_data_off: int = pack_align_up(pack_rx_end, pack_PAGE);
    pack_file_end: int = pack_data_off + pack_data_sz;

    pack_text_vma: int = pack_LOAD_BASE + pack_text_off;
    pack_rodata_vma: int = pack_LOAD_BASE + pack_rodata_off;
    pack_data_vma: int = pack_LOAD_BASE + pack_data_off;
    pack_bss_vma: int = pack_align_up(pack_data_vma + pack_data_sz, 8);

    pack_sec_vma: []int = new int[pack_e_shnum](0);
    pack_sj: int = 0;
    while (pack_sj < pack_e_shnum) {
        pack_sec_vma[pack_sj] = 0;
        pack_sj = pack_sj + 1;
    }
    pack_sec_vma[pack_text_i] = pack_text_vma;
    if (pack_rodata_i >= 0) { pack_sec_vma[pack_rodata_i] = pack_rodata_vma; }
    if (pack_data_i >= 0) { pack_sec_vma[pack_data_i] = pack_data_vma; }
    if (pack_bss_i >= 0) { pack_sec_vma[pack_bss_i] = pack_bss_vma; }

    pack_text: []i8 = new i8[pack_text_sz + 1](0i8);
    memcpy(pack_text, 0, pack_b, pack_text_fileoff, pack_text_sz);
    pack_rodata_ptr: []i8 = pack_text;
    if (pack_rodata_sz > 0) {
        pack_rodata_ptr = new i8[pack_rodata_sz](0i8);
        memcpy(pack_rodata_ptr, 0, pack_b, pack_rodata_fileoff, pack_rodata_sz);
    }
    pack_data_ptr: []i8 = pack_text;
    if (pack_data_sz > 0) {
        pack_data_ptr = new i8[pack_data_sz](0i8);
        memcpy(pack_data_ptr, 0, pack_b, pack_data_fileoff, pack_data_sz);
    }

    pack_sym_addr: []int = new int[pack_nsym](0);
    pack_zi = 0;
    while (pack_zi < pack_nsym) {
        pack_sy: int = pack_sym_off + pack_zi * 24;
        pack_st_shndx2: int = pack_rd16(pack_b, pack_sy + 6);
        pack_st_value: int = pack_rd64(pack_b, pack_sy + 8);
        if (pack_st_shndx2 == pack_SHN_UNDEF) {
            pack_sym_addr[pack_zi] = 0;
        } else {
            if (pack_st_shndx2 == pack_SHN_ABS) {
                pack_sym_addr[pack_zi] = pack_st_value;
            } else {
                if (pack_st_shndx2 < pack_e_shnum) {
                    pack_sym_addr[pack_zi] = pack_sec_vma[pack_st_shndx2] + pack_st_value;
                } else { pack_fail("bad symbol shndx"); }
            }
        }
        pack_zi = pack_zi + 1;
    }

    pack_entry: int = 0;
    pack_zi = 0;
    while (pack_zi < pack_nsym) {
        pack_so2: int = pack_sym_off + pack_zi * 24;
        pack_st_name2: int = pack_rd32(pack_b, pack_so2 + 0);
        if (pack_st_name2 != 0) {
            if (pack_streq_at(pack_b, pack_str_base + pack_st_name2, "_start")) {
                pack_entry = pack_sym_addr[pack_zi];
            }
        }
        pack_zi = pack_zi + 1;
    }
    if (pack_entry == 0) { pack_fail("missing _start"); }

    if (pack_rela_text_i >= 0) {
        pack_rsh2: int = pack_e_shoff + pack_rela_text_i * 64;
        pack_rela_off: int = pack_rd64(pack_b, pack_rsh2 + 24);
        pack_rela_sz: int = pack_rd64(pack_b, pack_rsh2 + 32);
        pack_nrela: int = pack_rela_sz / 24;
        pack_ri: int = 0;
        while (pack_ri < pack_nrela) {
            pack_ro: int = pack_rela_off + pack_ri * 24;
            pack_r_offset: int = pack_rd64(pack_b, pack_ro + 0);
            pack_r_type: int = pack_rd32(pack_b, pack_ro + 8);
            pack_r_sym: int = pack_rd32(pack_b, pack_ro + 12);
            pack_r_addend: int = pack_rd64(pack_b, pack_ro + 16);
            if (pack_r_type != pack_R_X86_64_PC32 && pack_r_type != pack_R_X86_64_PLT32) {
                pack_fail("unsupported reloc type");
            }
            if (pack_r_sym >= pack_nsym) { pack_fail("bad reloc symbol"); }
            if (pack_r_offset + 4 > pack_text_sz) { pack_fail("reloc out of range"); }
            pack_S: int = pack_sym_addr[pack_r_sym];
            pack_P: int = pack_text_vma + pack_r_offset;
            pack_disp: int = pack_S + pack_r_addend - pack_P;
            pack_wr32(pack_text, pack_r_offset, pack_disp);
            pack_ri = pack_ri + 1;
        }
    }

    pack_out: []i8 = new i8[pack_file_end](0i8);
    pack_memset0(pack_out, 0, pack_file_end);

    pack_elf_mag: i8 = 127i8;
    pack_out[0] = pack_elf_mag;
    pack_out[1] = 'E';
    pack_out[2] = 'L';
    pack_out[3] = 'F';
    pack_two: i8 = 2i8;
    pack_one: i8 = 1i8;
    pack_out[4] = pack_two;
    pack_out[5] = pack_one;
    pack_out[6] = pack_one;
    pack_wr16(pack_out, 16, pack_ET_EXEC);
    pack_wr16(pack_out, 18, pack_EM_X86_64);
    pack_wr32(pack_out, 20, 1);
    pack_wr64(pack_out, 24, pack_entry);
    pack_wr64(pack_out, 32, 64);
    pack_wr64(pack_out, 40, 0);
    pack_wr32(pack_out, 48, 0);
    pack_wr16(pack_out, 52, 64);
    pack_wr16(pack_out, 54, 56);
    pack_nph: int = 1;
    if (pack_data_sz > 0 || pack_bss_sz > 0) { pack_nph = 2; }
    pack_wr16(pack_out, 56, pack_nph);
    pack_wr16(pack_out, 58, 0);
    pack_wr16(pack_out, 60, 0);
    pack_wr16(pack_out, 62, 0);

    /* phdr 0: RX text+rodata */
    pack_ph0: int = 64;
    pack_wr32(pack_out, pack_ph0 + 0, pack_PT_LOAD);
    pack_wr32(pack_out, pack_ph0 + 4, pack_PF_R + pack_PF_X);
    pack_wr64(pack_out, pack_ph0 + 8, pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 16, pack_LOAD_BASE + pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 24, pack_LOAD_BASE + pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 32, pack_rx_end - pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 40, pack_rx_end - pack_rx_off);
    pack_wr64(pack_out, pack_ph0 + 48, pack_PAGE);

    if (pack_nph == 2) {
        pack_ph1: int = 64 + 56;
        pack_wr32(pack_out, pack_ph1 + 0, pack_PT_LOAD);
        pack_wr32(pack_out, pack_ph1 + 4, pack_PF_R + pack_PF_W);
        pack_wr64(pack_out, pack_ph1 + 8, pack_data_off);
        pack_wr64(pack_out, pack_ph1 + 16, pack_data_vma);
        pack_wr64(pack_out, pack_ph1 + 24, pack_data_vma);
        pack_wr64(pack_out, pack_ph1 + 32, pack_data_sz);
        pack_wr64(pack_out, pack_ph1 + 40, (pack_bss_vma + pack_bss_sz) - pack_data_vma);
        pack_wr64(pack_out, pack_ph1 + 48, pack_PAGE);
    }

    memcpy(pack_out, pack_text_off, pack_text, 0, pack_text_sz);
    if (pack_rodata_sz > 0) { memcpy(pack_out, pack_rodata_off, pack_rodata_ptr, 0, pack_rodata_sz); }
    if (pack_data_sz > 0) { memcpy(pack_out, pack_data_off, pack_data_ptr, 0, pack_data_sz); }

    pack_flags: int = pack_O_WRONLY + pack_O_CREAT + pack_O_TRUNC;
    pack_ofd: int = open(pack_out_p, pack_flags, pack_MODE_755);
    if (pack_ofd < 0) { pack_fail("cannot create output"); }
    pack_w: int = 0;
    while (pack_w < pack_file_end) {
        pack_chunk: int = pack_file_end - pack_w;
        if (pack_chunk > 65536) { pack_chunk = 65536; }
        pack_wn: int = write(pack_ofd, pack_out, pack_w, pack_chunk);
        if (pack_wn <= 0) { pack_fail("write failed"); }
        pack_w = pack_w + pack_wn;
    }
    close(pack_ofd);
    0;
}
