// Tokenize, attach comments, and parse a source file into the AST.
new_token(
    kind: TokKind,
    start: *i8@new,
    len: int,
    tokpos: int
): *Token@new {
    new Token {
        kind: kind,
        val: 0,
        str: start,
        len: len,
        pos: tokpos,
        next: token_eof
    };
}

ident_kind(s: []i8, off: int, n: int): TokKind {
    if (n < 2 || n == 7 || n > 9) {
        return TokKind.Ident;
    }
    if (n == 2) {
        if (s[off + 0] == 'i') {
            if (s[off + 1] == 'f') {
                return TokKind.If;
            }
            if (s[off + 1] == '8') {
                return TokKind.I8;
            }
            if (s[off + 1] == 'n') {
                return TokKind.In;
            }
        }
        if (s[off + 0] == 'a' && s[off + 1] == 's') {
            return TokKind.As;
        }
        if (s[off + 0] == 'o' && s[off + 1] == 'r') {
            return TokKind.OrKw;
        }
        return TokKind.Ident;
    }
    if (n == 3) {
        if (s[off + 0] == 'i' && s[off + 1] == 'n' && s[off + 2] == 't') {
            return TokKind.Int;
        }
        if (s[off + 0] == 'i' && s[off + 1] == '3' && s[off + 2] == '2') {
            return TokKind.I32;
        }
        if (s[off + 0] == 'u' && s[off + 1] == '3' && s[off + 2] == '2') {
            return TokKind.U32;
        }
        if (s[off + 0] == 'f' && s[off + 1] == '3' && s[off + 2] == '2') {
            return TokKind.F32;
        }
        if (s[off + 0] == 'f' && s[off + 1] == '6' && s[off + 2] == '4') {
            return TokKind.F64;
        }
        if (s[off + 0] == 'n' && s[off + 1] == 'e' && s[off + 2] == 'w') {
            return TokKind.New;
        }
        if (s[off + 0] == 't' && s[off + 1] == 'r' && s[off + 2] == 'y') {
            return TokKind.Try;
        }
        if (s[off + 0] == 'f' && s[off + 1] == 'o' && s[off + 2] == 'r') {
            return TokKind.For;
        }
        return TokKind.Ident;
    }
    if (n == 4) {
        c0: i8 = s[off + 0];
        if (c0 == 'b' && s[off + 1] == 'o' && s[off + 2] == 'o' && s[off + 3] == 'l') {
            return TokKind.Bool;
        }
        if (c0 == 't') {
            if (s[off + 1] == 'r' && s[off + 2] == 'u' && s[off + 3] == 'e') {
                return TokKind.True;
            }
            if (s[off + 1] == 'y' && s[off + 2] == 'p' && s[off + 3] == 'e') {
                return TokKind.TypeKw;
            }
        }
        if (c0 == 'n' && s[off + 1] == 'u' && s[off + 2] == 'l' && s[off + 3] == 'l') {
            return TokKind.Null;
        }
        if (c0 == 'e' && s[off + 1] == 'l' && s[off + 2] == 's' && s[off + 3] == 'e') {
            return TokKind.Else;
        }
        if (c0 == 'w' && s[off + 1] == 'i' && s[off + 2] == 't' && s[off + 3] == 'h') {
            return TokKind.With;
        }
        return TokKind.Ident;
    }
    if (n == 5) {
        c1: i8 = s[off + 0];
        if (c1 == 'f' && s[off + 1] == 'a' && s[off + 2] == 'l' && s[off + 3] == 's' && s[off + 4] == 'e') {
            return TokKind.False;
        }
        if (c1 == 'w' && s[off + 1] == 'h' && s[off + 2] == 'i' && s[off + 3] == 'l' && s[off + 4] == 'e') {
            return TokKind.While;
        }
        if (c1 == 't' && s[off + 1] == 'r' && s[off + 2] == 'u' && s[off + 3] == 'n' && s[off + 4] == 'c') {
            return TokKind.Trunc;
        }
        if (c1 == 'm' && s[off + 1] == 'a' && s[off + 2] == 't' && s[off + 3] == 'c' && s[off + 4] == 'h') {
            return TokKind.Match;
        }
        if (c1 == 'r' && s[off + 1] == 'a' && s[off + 2] == 'i' && s[off + 3] == 's' && s[off + 4] == 'e') {
            return TokKind.Raise;
        }
        return TokKind.Ident;
    }
    if (n == 6) {
        c2: i8 = s[off + 0];
        if (c2 == 'r') {
            if (s[off + 1] == 'e') {
                if (s[off + 2] == 't' && s[off + 3] == 'u' && s[off + 4] == 'r' && s[off + 5] == 'n') {
                    return TokKind.Return;
                }
                if (s[off + 2] == 'g' && s[off + 3] == 'i' && s[off + 4] == 'o' && s[off + 5] == 'n') {
                    return TokKind.Region;
                }
            }
            if (s[off + 1] == 'a' && s[off + 2] == 'i' && s[off + 3] == 's' && s[off + 4] == 'e' && s[off + 5] == 's') {
                return TokKind.Raises;
            }
        }
        if (c2 == 's' && s[off + 1] == 'i' && s[off + 2] == 'z' && s[off + 3] == 'e' && s[off + 4] == 'o' && s[off + 5] == 'f') {
            return TokKind.Sizeof;
        }
        if (c2 == 'i' && s[off + 1] == 'm' && s[off + 2] == 'p' && s[off + 3] == 'o' && s[off + 4] == 'r' && s[off + 5] == 't') {
            return TokKind.Import;
        }
        if (c2 == 'e' && s[off + 1] == 'x' && s[off + 2] == 't' && s[off + 3] == 'e' && s[off + 4] == 'r' && s[off + 5] == 'n') {
            return TokKind.Extern;
        }
        return TokKind.Ident;
    }
    if (n == 8) {
        if (s[off] == 'n' && streq_n(s, off, "noreturn", 0, 8)) {
            return TokKind.Noreturn;
        }
        return TokKind.Ident;
    }
    if (n == 9) {
        if (s[off] == 'e' && streq_n(s, off, "exception", 0, 9)) {
            return TokKind.Exception;
        }
        return TokKind.Ident;
    }
    TokKind.Ident;
}

skip_line_comment() {
    while (pos < source_len) {
        if (source[pos] == '\n') {
            return;
        }
        pos = pos + 1;
    }
}

skip_block_comment() {
    while (pos < source_len) {
        if (source[pos] == '*' && source[pos + 1] == '/') {
            pos = pos + 2;
            return;
        }
        pos = pos + 1;
    }
}

nls_since(at: int): int {
    i: int = at - 1;
    n: int = 0;
    while (i >= 0) {
        ch: i8 = source[i];
        if (ch == '\n') {
            n = n + 1;
        } else {
            if (ch != ' ' && ch != '\t' && ch != '\r') {
                return n;
            }
        }
        i = i - 1;
    }
    n;
}

append_file_com(text: []i8@new, cpos: int, nls: int) noregion {
    c: *Com = new Com {
        text: text,
        pos: cpos,
        nls: nls,
        next: null
    };
    t: ?*Com = file_coms_tail;
    if (t != null) {
        t.next = c;
    } else {
        file_coms = c;
    }
    file_coms_tail = c;
}

com_take_until(lim: int) raises Error: ?*Com {
    head: ?*Com = null;
    tail: ?*Com = null;
    while (com_cur != null) {
        c: *Com = com_cur or error("internal");
        if (c.pos >= lim) {
            return head;
        }
        nxt: ?*Com = c.next;
        c.next = null;
        if (tail != null) {
            tail.next = c;
            tail = c;
        } else {
            head = c;
            tail = c;
        }
        com_cur = nxt;
    }
    head;
}

com_take_trail(lim: int) raises Error: ?*Com {
    head: ?*Com = null;
    tail: ?*Com = null;
    while (com_cur != null) {
        c: *Com = com_cur or error("internal");
        if (c.pos >= lim) {
            return head;
        }
        if (c.nls != 0) {
            return head;
        }
        nxt: ?*Com = c.next;
        c.next = null;
        if (tail != null) {
            tail.next = c;
            tail = c;
        } else {
            head = c;
            tail = c;
        }
        com_cur = nxt;
    }
    head;
}

com_last(h: ?*Com): ?*Com@h {
    c: ?*Com = h;
    last: ?*Com = null;
    while (c != null) {
        last = c;
        c = c.next;
    }
    last;
}

com_concat(a: ?*Com, b: ?*Com@a) raises Error: ?*Com@b {
    if (a == null) {
        return b;
    }
    t: *Com = com_last(a) or error("internal");
    t.next = b;
    a;
}

read_number(): int {
    v: int = 0;
    while (pos < source_len) {
        d: i8 = source[pos];
        if (d < '0' || d > '9') {
            return v;
        }
        v = v * 10 + (d - '0') as int;
        pos = pos + 1;
    }
    v;
}

/* Integer-only decimal → IEEE bits. wide=0 is f32, wide=1 is f64. */
parse_dec_ieee(
    s: []i8,
    off: int,
    n: int,
    wide: int
): int {
    i: int = 0;
    sig: int = 0;
    ndig: int = 0;
    nfrac: int = 0;
    saw_dot: int = 0;
    extra_int: int = 0;
    done: int = 0;
    while (i < n && done == 0) {
        ch: i8 = s[off + i];
        if (ch == '.') {
            saw_dot = 1;
            i = i + 1;
        } else {
            if (ch >= '0' && ch <= '9') {
                if (ndig < 18) {
                    sig = sig * 10 + (ch - '0') as int;
                    ndig = ndig + 1;
                    if (saw_dot != 0) {
                        nfrac = nfrac + 1;
                    }
                } else {
                    if (saw_dot == 0) {
                        extra_int = extra_int + 1;
                    }
                }
                i = i + 1;
            } else {
                done = 1;
            }
        }
    }
    exp10: int = extra_int - nfrac;
    if (i < n) {
        ech: i8 = s[off + i];
        if (ech == 'e' || ech == 'E') {
            i = i + 1;
            esign: int = 1;
            if (i < n) {
                sch: i8 = s[off + i];
                if (sch == '+') {
                    i = i + 1;
                } else {
                    if (sch == '-') {
                        esign = 0 - 1;
                        i = i + 1;
                    }
                }
            }
            ev: int = 0;
            while (i < n) {
                dch: i8 = s[off + i];
                if (dch < '0' || dch > '9') {
                    i = n;
                } else {
                    ev = ev * 10 + (dch - '0') as int;
                    i = i + 1;
                }
            }
            exp10 = exp10 + esign * ev;
        }
    }
    if (sig == 0) {
        return 0;
    }
    maxpos: int = 1;
    mi: int = 0;
    while (mi < 62) {
        maxpos = maxpos + maxpos;
        mi = mi + 1;
    }
    maxpos = maxpos - 1 + maxpos;
    max5: int = maxpos / 5;
    max2: int = maxpos / 2;
    m: int = sig;
    b: int = exp10;
    if (exp10 > 0) {
        k: int = 0;
        while (k < exp10) {
            while (m > max5) {
                rem: int = m & 1;
                m = m >> 1;
                b = b + 1;
                if (rem != 0) {
                    m = m + 1;
                }
            }
            m = m * 5;
            k = k + 1;
        }
    } else {
        if (exp10 < 0) {
            k2: int = 0;
            nneg: int = 0 - exp10;
            while (k2 < nneg) {
                while (m % 5 != 0 && m <= max2) {
                    m = m + m;
                    b = b - 1;
                }
                rem2: int = m % 5;
                m = m / 5;
                if (rem2 > 2) {
                    m = m + 1;
                } else {
                    if (rem2 == 2) {
                        if ((m & 1) != 0) {
                            m = m + 1;
                        }
                    }
                }
                k2 = k2 + 1;
            }
        }
    }
    mb: int = 23;
    bias: int = 127;
    emax: int = 255;
    if (wide != 0) {
        mb = 52;
        bias = 1023;
        emax = 2047;
    }
    hid: int = 1;
    hi: int = 0;
    while (hi < mb) {
        hid = hid + hid;
        hi = hi + 1;
    }
    top: int = hid + hid;
    while (m >= top) {
        rem3: int = m & 1;
        m = m >> 1;
        b = b + 1;
        if (rem3 != 0) {
            m = m + 1;
        }
    }
    while (m > 0 && m < hid) {
        m = m + m;
        b = b - 1;
    }
    if (m >= top) {
        m = m >> 1;
        b = b + 1;
    }
    e: int = b + bias + mb;
    if (e <= 0) {
        return 0;
    }
    if (e >= emax) {
        return emax << mb;
    }
    (e << mb) + (m - hid);
}

esc_char(c: i8): i8 {
    if (c == 'n') {
        return '\n';
    }
    if (c == 't') {
        return '\t';
    }
    if (c == 'r') {
        return '\r';
    }
    if (c == '0') {
        return 0i8;
    }
    if (c == '\\') {
        return '\\';
    }
    if (c == '\'') {
        return '\'';
    }
    if (c == '"') {
        return '"';
    }
    c;
}

is_triple_quote(at: int): bool {
    at + 2 < source_len && source[at] == '"' && source[at + 1] == '"' && source[at + 2] == '"';
}

scan_string_len() raises Error: int {
    start: int = pos;
    while (pos < source_len) {
        if (source[pos] == '"') {
            return pos - start;
        }
        if (source[pos] == '\\') {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    error("unterminated string");
}

scan_ml_string_len() raises Error: int {
    start: int = pos;
    while (pos < source_len) {
        if (is_triple_quote(pos)) {
            return pos - start;
        }
        if (source[pos] == '\\') {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    error("unterminated string");
}

scan_ident_len(): int {
    start: int = pos;
    while (pos < source_len) {
        d: i8 = source[pos];
        if (d >= 'a' && d <= 'z' || d >= 'A' && d <= 'Z' || d == '_' || d >= '0' && d <= '9') {
            pos = pos + 1;
        } else {
            return pos - start;
        }
    }
    pos - start;
}

punct_kind(c: i8) raises Error: TokKind {
    if (c == '+') {
        return TokKind.Plus;
    }
    if (c == '-') {
        return TokKind.Minus;
    }
    if (c == '*') {
        return TokKind.Star;
    }
    if (c == '%') {
        return TokKind.Percent;
    }
    if (c == '&') {
        return TokKind.Amp;
    }
    if (c == '.') {
        return TokKind.Dot;
    }
    if (c == ':') {
        return TokKind.Colon;
    }
    if (c == '(') {
        return TokKind.LParen;
    }
    if (c == ')') {
        return TokKind.RParen;
    }
    if (c == '{') {
        return TokKind.LBrace;
    }
    if (c == '}') {
        return TokKind.RBrace;
    }
    if (c == '[') {
        return TokKind.LBrack;
    }
    if (c == ']') {
        return TokKind.RBrack;
    }
    if (c == ';') {
        return TokKind.Semi;
    }
    if (c == ',') {
        return TokKind.Comma;
    }
    if (c == '/') {
        return TokKind.Slash;
    }
    if (c == '?') {
        return TokKind.Question;
    }
    if (c == '^') {
        return TokKind.Caret;
    }
    if (c == '~') {
        return TokKind.Tilde;
    }
    if (c == '@') {
        return TokKind.At;
    }
    error_at(pos, "unexpected character");
    TokKind.Eof;
}

tokenize() noregion raises Error: *Token@new {
    head: *Token = new Token {
        kind: TokKind.Eof,
        val: 0,
        str: "",
        len: 0,
        pos: 0,
        next: token_eof
    };
    cur: *Token = head;
    t: *Token;
    s: *i8;
    n: int = 0;
    v: int = 0;
    c: i8 = 0i8;
    ch: i8 = 0i8;
    pk: TokKind = TokKind.Eof;
    pos = 0;
    file_coms = null;
    file_coms_tail = null;
    while (pos < source_len) {
        c = source[pos];
        if (c == ' ' || c == '\n' || c == '\t' || c == '\r') {
            pos = pos + 1;
            more: int = 1;
            while (pos < source_len && more != 0) {
                c = source[pos];
                if (c == ' ' || c == '\n' || c == '\t' || c == '\r') {
                    pos = pos + 1;
                } else {
                    more = 0;
                }
            }
        } else if (c == '/' && source[pos + 1] == '/') {
            cstart: int = pos;
            cnls: int = nls_since(cstart);
            pos = pos + 2;
            skip_line_comment();
            append_file_com(intern(source, cstart, pos - cstart), cstart, cnls);
        } else if (c == '/' && source[pos + 1] == '*') {
            bstart: int = pos;
            bnls: int = nls_since(bstart);
            pos = pos + 2;
            skip_block_comment();
            append_file_com(intern(source, bstart, pos - bstart), bstart, bnls);
        } else if (c >= '0' && c <= '9') {
            s = &source[pos];
            n = pos;
            v = read_number();
            is_fl: int = 0;
            if (pos < source_len && source[pos] == '.') {
                if (pos + 1 < source_len) {
                    d2: i8 = source[pos + 1];
                    if (d2 >= '0' && d2 <= '9') {
                        is_fl = 1;
                        pos = pos + 1;
                        v = read_number();
                    }
                }
            }
            if (pos < source_len && (source[pos] == 'e' || source[pos] == 'E')) {
                is_fl = 1;
                pos = pos + 1;
                if (pos < source_len && (source[pos] == '+' || source[pos] == '-')) {
                    pos = pos + 1;
                }
                if (pos >= source_len || source[pos] < '0' || source[pos] > '9') {
                    error("expected exponent digits");
                }
                v = read_number();
            }
            if (is_fl != 0) {
                t = new_token(TokKind.Float, s, pos - n, n);
                t.val = parse_dec_ieee(source, n, pos - n, 0);
            } else {
                t = new_token(TokKind.Num, s, pos - n, n);
                t.val = v;
            }
            cur.next = t;
            cur = t;
        } else if (c == '"') {
            if (is_triple_quote(pos)) {
                pos = pos + 3;
                v = 1;
                if (pos < source_len && source[pos] == '\n') {
                    pos = pos + 1;
                    v = 2;
                }
                s = &source[pos];
                n = pos;
                t = new_token(TokKind.Str, s, scan_ml_string_len(), n);
                t.val = v;
                cur.next = t;
                cur = t;
                pos = pos + 3;
            } else {
                pos = pos + 1;
                s = &source[pos];
                n = pos;
                t = new_token(TokKind.Str, s, scan_string_len(), n);
                cur.next = t;
                cur = t;
                pos = pos + 1;
            }
        } else if (c == '\'') {
            n = pos;
            pos = pos + 1;
            if (source[pos] == '\\') {
                pos = pos + 1;
                ch = esc_char(source[pos]);
                pos = pos + 1;
            } else {
                ch = source[pos];
                pos = pos + 1;
            }
            if (source[pos] == '\'') {
                pos = pos + 1;
            }
            t = new_token(TokKind.Char, &source[pos], 0, n);
            t.val = ch as int;
            cur.next = t;
            cur = t;
        } else if (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_') {
            s = &source[pos];
            n = scan_ident_len();
            t = new_token(ident_kind(source, pos - n, n), s, n, pos - n);
            cur.next = t;
            cur = t;
        } else if (c == '=' && source[pos + 1] == '=') {
            t = new_token(TokKind.Eq, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '!' && source[pos + 1] == '=') {
            t = new_token(TokKind.Ne, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '<' && source[pos + 1] == '<') {
            t = new_token(TokKind.Shl, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '<' && source[pos + 1] == '=') {
            t = new_token(TokKind.Le, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '>' && source[pos + 1] == '>') {
            t = new_token(TokKind.Shr, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '>' && source[pos + 1] == '=') {
            t = new_token(TokKind.Ge, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '&' && source[pos + 1] == '&') {
            t = new_token(TokKind.And, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '|' && source[pos + 1] == '|') {
            t = new_token(TokKind.Or, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '-' && source[pos + 1] == '>') {
            t = new_token(TokKind.Arrow, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '.' && source[pos + 1] == '.') {
            t = new_token(TokKind.DotDot, &source[pos], 2, pos);
            cur.next = t;
            cur = t;
            pos = pos + 2;
        } else if (c == '|') {
            t = new_token(TokKind.Pipe, &source[pos], 1, pos);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        } else if (c == '<') {
            t = new_token(TokKind.Lt, &source[pos], 1, pos);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        } else if (c == '>') {
            t = new_token(TokKind.Gt, &source[pos], 1, pos);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        } else if (c == '=') {
            t = new_token(TokKind.Assign, &source[pos], 1, pos);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        } else if (c == '!') {
            t = new_token(TokKind.Not, &source[pos], 1, pos);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        } else {
            pk = punct_kind(c);
            t = new_token(pk, &source[pos], 1, pos);
            cur.next = t;
            cur = t;
            pos = pos + 1;
        }
    }
    t = new_token(TokKind.Eof, &source[pos], 0, pos);
    t.next = t;
    cur.next = t;
    head.next;
}

skip(kind: TokKind) raises Error {
    if (tok.kind != kind) {
        error("unexpected token");
    }
    tok = tok.next;
}

skip_optional_semi() {
    if (tok.kind == TokKind.Semi) {
        tok = tok.next;
    }
}

new_item(k: ItemKind@new, ipos: int): *Item@new {
    new Item {
        kind: k,
        next: null,
        lead: null,
        trail: null,
        pos: ipos
    };
}

append_item(it: *Item@immortal) {
    t: ?*Item = file_items_tail;
    if (t != null) {
        t.next = it;
    } else {
        file_items = it;
    }
    file_items_tail = it;
}

attach_stmt_inner(s: *Stmt, end_pos: int) raises Error {
    match s.kind {
        Block k -> {
            lim: int = end_pos;
            if (s.end != 0) {
                lim = s.end;
            }
            k.body = attach_stmts(k.body, lim);
            s.trail = com_concat(s.trail, com_take_until(lim));
            return;
        }
        If k -> {
            k.then = attach_one_stmt(k.then, end_pos);
            els: ?*Stmt = k.els;
            if (els != null) {
                k.els = attach_one_stmt(els, end_pos);
            }
            return;
        }
        While k -> {
            k.body = attach_one_stmt(k.body, end_pos);
            return;
        }
        For k -> {
            k.body = attach_one_stmt(k.body, end_pos);
            return;
        }
        Match k -> {
            arm: ?*MatchArm = k.arms;
            while (arm != null) {
                arm.lead = com_concat(arm.lead, com_take_until(arm.pos));
                nxt: ?*MatchArm = arm.next;
                np: int = end_pos;
                if (nxt != null) {
                    np = nxt.pos;
                }
                arm.body = attach_one_stmt(arm.body, np);
                arm.trail = com_concat(arm.trail, com_take_trail(np));
                arm = nxt;
            }
            return;
        }
        Try k -> {
            k.body = attach_one_stmt(k.body, end_pos);
            a: ?*CatchArm = k.arms;
            while (a != null) {
                a.lead = com_concat(a.lead, com_take_until(a.pos));
                nxt2: ?*CatchArm = a.next;
                np2: int = end_pos;
                if (nxt2 != null) {
                    np2 = nxt2.pos;
                }
                a.body = attach_one_stmt(a.body, np2);
                a.trail = com_concat(a.trail, com_take_trail(np2));
                a = nxt2;
            }
            return;
        }
        Region k -> {
            k.body = attach_one_stmt(k.body, end_pos);
            return;
        }
        _ -> {
            return;
        }
    }
}

attach_one_stmt(s: *Stmt, end_pos: int) raises Error: *Stmt@s {
    nxt: ?*Stmt = s.next;
    s.next = null;
    s.lead = com_concat(s.lead, com_take_until(s.pos));
    lim: int = end_pos;
    if (s.end != 0) {
        lim = s.end;
    }
    attach_stmt_inner(s, lim);
    s.trail = com_concat(s.trail, com_take_trail(lim));
    s.next = nxt;
    s;
}

attach_stmts(head: ?*Stmt, end_pos: int) raises Error: ?*Stmt@head {
    s: ?*Stmt = head;
    while (s != null) {
        cur: *Stmt = s;
        nxt: ?*Stmt = cur.next;
        next_pos: int = end_pos;
        if (nxt != null) {
            next_pos = nxt.pos;
        }
        cur.lead = com_concat(cur.lead, com_take_until(cur.pos));
        attach_stmt_inner(cur, next_pos);
        cur.trail = com_concat(cur.trail, com_take_trail(next_pos));
        s = nxt;
    }
    head;
}

attach_members(head: ?*Member, end_pos: int) raises Error {
    m: ?*Member = head;
    while (m != null) {
        nxt: ?*Member = m.next;
        np: int = end_pos;
        if (nxt != null) {
            np = nxt.browse_pos;
        }
        m.lead = com_concat(m.lead, com_take_until(m.browse_pos));
        m.trail = com_concat(m.trail, com_take_trail(np));
        m = nxt;
    }
}

attach_variants(head: ?*Variant, end_pos: int) raises Error {
    v: ?*Variant = head;
    while (v != null) {
        nxt: ?*Variant = v.next;
        np: int = end_pos;
        if (nxt != null) {
            np = nxt.browse_pos;
        }
        v.lead = com_concat(v.lead, com_take_until(v.browse_pos));
        attach_members(v.fields, np);
        v.trail = com_concat(v.trail, com_take_trail(np));
        v = nxt;
    }
}

attach_items(head: ?*Item@immortal, end_pos: int) raises Error: ?*Item@head {
    it: ?*Item = head;
    while (it != null) {
        cur: *Item = it;
        nxt: ?*Item = cur.next;
        next_pos: int = end_pos;
        if (nxt != null) {
            next_pos = nxt.pos;
        }
        lead: ?*Com = com_take_until(cur.pos);
        cur.lead = lead;
        match cur.kind {
            Func k -> {
                k.fn.lead = lead;
                b: ?*Stmt = k.fn.body;
                if (b != null) {
                    _b: *Stmt = attach_one_stmt(b, next_pos);
                }
            }
            Struct k -> {
                k.def.lead = lead;
                attach_members(k.def.members, next_pos);
            }
            Enum k -> {
                k.def.lead = lead;
                attach_variants(k.def.variants, next_pos);
            }
            Exn k -> {
                k.def.lead = lead;
                attach_members(k.def.members, next_pos);
            }
            Global k -> {
                k.var.lead = lead;
            }
            _ -> { }
        }
        cur.trail = com_take_trail(next_pos);
        match cur.kind {
            Func k2 -> {
                k2.fn.trail = cur.trail;
            }
            Struct k2 -> {
                k2.def.trail = cur.trail;
            }
            Enum k2 -> {
                k2.def.trail = cur.trail;
            }
            Exn k2 -> {
                k2.def.trail = cur.trail;
            }
            Global k2 -> {
                k2.var.trail = cur.trail;
            }
            _ -> { }
        }
        it = nxt;
    }
    file_trail = com_take_until(end_pos);
    head;
}

attach_parsed_file() raises Error {
    com_cur = file_coms;
    file_trail = null;
    file_items = attach_items(file_items, source_len);
}

cur_tokstr() noregion: []i8@new {
    intern(source, tok.pos, tok.len);
}

intern(s: []i8, off: int, n: int) noregion: []i8@new {
    b: int = hash_n(s, off, n) & 4095;
    e: ?*InternEnt = intern_buckets[b].head;
    while (e != null) {
        if (e.n == n) {
            if (streq_n(e.s, 0, s, off, n)) {
                return e.s;
            }
        }
        e = e.next;
    }
    d: []i8 = strdup_n(s, off, n);
    ne: *InternEnt = new InternEnt { s: d, n: n, next: intern_buckets[b].head };
    intern_buckets[b].head = ne;
    d;
}

add_string(s: []i8, off: int, n: int) noregion: int {
    buf: []i8 = new i8[n + 1](0i8);
    i: int = 0;
    j: int = 0;
    while (i < n) {
        if (s[off + i] == '\\' && i + 1 < n) {
            i = i + 1;
            buf[j] = esc_char(s[off + i]);
            j = j + 1;
        } else {
            buf[j] = s[off + i];
            j = j + 1;
        }
        i = i + 1;
    }
    buf[j] = 0i8;
    lit: *StrLit = new StrLit {
        data: buf,
        len: j,
        label: str_count,
        next: null
    };
    str_count = str_count + 1;
    t: ?*StrLit = str_lit_tail;
    if (t != null) {
        t.next = lit;
    } else {
        str_lits = lit;
    }
    str_lit_tail = lit;
    lit.label;
}

mk_expr(k: ExprKind@new): *Expr@new {
    new Expr {
        kind: k,
        next: null,
        ty: null,
        pos: 0,
        file: 0,
        toklen: 0
    };
}

mk_stmt(k: StmtKind@new): *Stmt@new {
    new Stmt {
        kind: k,
        next: null,
        lead: null,
        trail: null,
        pos: 0,
        end: 0
    };
}

new_num(v: int): *Expr@new {
    n: *Expr = mk_expr(ExprKind.Num {
