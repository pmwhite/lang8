        str_label: 0,
        form: LIT_INT,
        spell: ""
    });
    n.ty = ty_int;
    n;
}

new_str_num(label: int) noregion: *Expr@new {
    n: *Expr = mk_expr(ExprKind.Num {
        val: 0,
        str_label: label,
        form: LIT_INT,
        spell: ""
    });
    n.ty = slice_of(ty_i8);
