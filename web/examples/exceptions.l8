// Exceptions are checked: a function lists what it may raise, and the
// compiler rejects a list that is missing one or names one never raised.
tag exceptions;

use_tag std;

import "stdlib/print.l8";

exception ParseError {
    at: int
}

// Parse a decimal number, raising ParseError at the first bad character.
parse(text: str) raises ParseError: int {
    if (len(text) == 0) raise ParseError { at: 0 };
    value: int = 0;
    for i in 0..len(text) {
        c: i8 = text[i];
        if (c < '0' || c > '9') raise ParseError { at: i };
        value = value * 10 + (c - '0') as int
    }
    value
}

try_parse(text: str) raises IoError {
    write(1, text);
    write(1, " -> ");
    try {
        print_int(parse(text))
    } with ParseError e -> {
        write(1, "error at column ");
        print_int(e.at + 1)
    }
}

main() raises IoError: int {
    try_parse("2026");
    try_parse("12x4");
    try_parse("");
    0
}
