// Records, enums with payloads, and match.
tag shapes;

use_tag std;

import "stdlib/print.l8";

type Point = {
    x: f64;
    y: f64
}

type Shape =
    | Circle { center: Point, radius: f64 }
    | Rect { corner: Point, width: f64, height: f64 }
    | Segment { from: Point, to: Point }

area(s: *Shape): f64 {
    match s.* {
        Circle c -> 3.14159265f64 * c.radius * c.radius;
        Rect r -> r.width * r.height;
        Segment _ -> 0.0f64
    }
}

name(s: *Shape): str {
    match s.* {
        Circle _ -> "circle";
        Rect _ -> "rectangle";
        Segment _ -> "segment"
    }
}

main() raises IoError: int {
    origin: Point = Point { x: 0.0f64, y: 0.0f64 };
    shapes: []Shape = [Shape.Circle { center: origin, radius: 2.0f64 }, Shape.Rect { corner: origin, width: 3.0f64, height: 4.5f64 },
        Shape.Segment { from: origin, to: Point { x: 1.0f64, y: 1.0f64 } }];
    total: f64 = 0.0f64;
    for i in 0..len(shapes) {
        s: *Shape = &shapes[i];
        write(1, name(s));
        write(1, ": ");
        print_fixed(area(s), 2);
        total = total + area(s)
    }
    write(1, "total: ");
    print_fixed(total, 2);
    0
}
