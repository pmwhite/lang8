// The Mandelbrot set in ASCII, with f64 arithmetic.
tag mandelbrot;

use_tag std;

import "stdlib/print.l8";

escape_time(cx: f64, cy: f64, limit: int): int {
    x: f64 = 0.0f64;
    y: f64 = 0.0f64;
    n: int = 0;
    while (n < limit && x * x + y * y <= 4.0f64) {
        t: f64 = x * x - y * y + cx;
        y = 2.0f64 * x * y + cy;
        x = t;
        n = n + 1
    }
    n
}

main() raises IoError: int {
    shades: str = " .:-=+*#%@";
    line: []i8 = new i8[72](' ');
    for row in 0..30 {
        cy: f64 = (row as f64 - 15.0f64) / 13.0f64;
        for col in 0..len(line) {
            cx: f64 = (col as f64 - 48.0f64) / 24.0f64;
            n: int = escape_time(cx, cy, 36);
            line[col] = shades[n / 4]
        }
        write_bytes(1, line);
        write(1, "\n")
    }
    0
}
