// Welcome to L8! Edit this program and press Run (or Ctrl+Enter).
// The compiler itself is running in your browser as WebAssembly.
tag hello;

use_tag std;

import "stdlib/print.l8";

greet(name: str) raises IoError {
    write(1, "Hello, ");
    write(1, name);
    write(1, "!\n")
}

main() raises IoError: int {
    greet("WebAssembly");
    for i in 1..6 {
        write_int(1, i);
        write(1, " squared is ");
        print_int(i * i)
    }
    0
}
