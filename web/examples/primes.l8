// The sieve of Eratosthenes. Every a[i] needs a compile-time proof that
// 0 <= i < len(a): here the loop bounds provide it.
tag primes;

use_tag std;

import "stdlib/print.l8";

sieve(limit: int): []bool@new {
    composite: []bool = new bool[limit + 1](false);
    for i in 2..len(composite) {
        if (!composite[i]) {
            j: int = i * i;
            while (j >= 0 && j < len(composite)) {
                composite[j] = true;
                j = j + i
            }
        }
    }
    composite
}

main() raises IoError: int {
    limit: int = 100;
    composite: []bool = sieve(limit);
    count: int = 0;
    for n in 2..len(composite) {
        if (!composite[n]) {
            write_int(1, n);
            write(1, " ");
            count = count + 1
        }
    }
    write(1, "\n");
    write_int(1, count);
    print(" primes below 100");
    0
}
