// The sieve of Eratosthenes.
tag primes;

use_tag std;

import "stdlib/print.l8";

const PRIME_CAP: int = 10001;

type PrimeSlot = {
    count: int;
    data: [10001]bool
}

prime_slot: PrimeSlot = PrimeSlot { count: 0, data: zeroed([10001]bool) };

extern prime_as_bools(p: *bool): []bool = l8_as_int;

sieve(limit: int): []bool@new {
    if (limit < 1 || limit + 1 > PRIME_CAP) return prime_as_bools(&prime_slot.data[0]);
    for i in 0..limit + 1 prime_slot.data[i] = false;
    prime_slot.count = limit + 1;
    composite: []bool = prime_as_bools(&prime_slot.data[0]);
    for i in 2..len(composite) {
        if (!composite[i]) {
            j: int = i * i;
            while (j < len(composite)) {
                composite[j] = true;
                j = j + i
            }
        }
    }
    composite
}

main() raises IoError: int {
    limit: int = 100;
    composite: []bool = sieve(limit);
    count: int = 0;
    for n in 2..len(composite) {
        if (!composite[n]) {
            write_int(1, n);
            write(1, " ");
            count = count + 1
        }
    }
    write(1, "\n");
    write_int(1, count);
    print(" primes below 100");
    0
}
