// Every a[i] is checked at run time. This loop reads one element past the
// end, so the program stops with status 1 before printing anything. Press
// Run to see it, then fix it by changing `<=` to `<` in the loop.
tag bounds;

use_tag std;

import "stdlib/print.l8";

sum(values: []int): int {
    total: int = 0;
    i: int = 0;
    while (i <= len(values)) {
        total = total + values[i];
        i = i + 1
    }
    total
}

main() raises IoError: int {
    digits: []int = [3, 1, 4, 1, 5, 9, 2, 6];
    print_int(sum(digits));
    0
}
