// L8 is memory safe without run-time index checks: the compiler must prove
// every a[i] is in bounds. This program does not compile. Press Run to see
// why, then fix it, for example by changing `<=` to `<` in the loop.
tag bounds;

use_tag std;

import "stdlib/print.l8";

sum(values: []int): int {
    total: int = 0;
    i: int = 0;
    while (i <= len(values)) {
        total = total + values[i];
        i = i + 1
    }
    total
}

main() raises IoError: int {
    digits: []int = [3, 1, 4, 1, 5, 9, 2, 6];
    print_int(sum(digits));
    0
}
