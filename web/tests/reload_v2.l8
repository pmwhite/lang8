tag reload_test;

use_tag std;

import "../../stdlib/print.l8";

// The second build (reload.mjs): the same program edited. Node has a new
// field, Place is reordered with a new field and an optional note, Mark has
// a new first variant (its tags renumbered) and reordered fields, Settings
// a new optional pointer; `gone` is gone, `changes_type` is now a str and
// `added` is new. It prints what it was given and pauses, then ends.
extern l8_pause(): int;

type Node = {
    value: int;
    label: str;
    next: ?*Node;
    back: ?*Node
}

type Place = {
    chapter: int;
    book: int;
    verse: int;
    note: ?str
}

type Mark =
    | Hidden
    | None
    | At { color: i8, place: Place }

type Settings = {
    size: f64;
    dark: bool;
    faces: []str;
    counts: [3]int;
    extra: ?*Node
}

persistent list: ?*Node = null;

persistent shared: ?*Node = null;

persistent place: Place = Place {
    chapter: 1,
    book: 1,
    verse: 0,
    note: null
};

persistent marks: []Mark = [Mark.None];

persistent settings: Settings = Settings {
    size: 1.0f64,
    dark: false,
    faces: ["None"],
    counts: [0, 0, 0],
    extra: null
};

persistent opened: int = 0;

persistent counter: int = 0;

persistent changes_type: str = "fresh";

persistent added: int = 77;

persistent small: i8 = 3i8;

persistent ratio: f32 = 1.5;

persistent maybe: ?str = null;

persistent word: str = "first";

persistent flag: bool = true;

say(label: str, n: int) raises IoError {
    std::write(1, label);
    std::write(1, ": ");
    std::print_int(n)
}

main() raises IoError: int {
    n1: ?*Node = list;
    while (n1 != null) {
        say("node", n1.value);
        std::write(1, "label: [");
        std::write(1, n1.label);
        std::print("]");
        n1 = n1.next
    }
    first: *Node = list or missing();
    second: *Node = first.next or missing();
    third: *Node = second.next or missing();
    std::print(if (shared == second) "shared: yes" else "shared: no");
    std::print(if (third.back == first) "cycle: yes" else "cycle: no");
    say("book", place.book);
    say("chapter", place.chapter);
    say("verse", place.verse);
    note: str = place.note or "(none)";
    std::print(note);
    say("marks", len(marks));
    for m in marks {
        match m {
            Hidden -> std::print("hidden");
            None -> std::print("none");
            At k -> {
                say("at book", k.place.book);
                say("color", k.color as int)
            }
        }
    }
    std::write(1, "size x4: ");
    std::print_int((settings.size * 4.0f64) as int);
    std::print_bool(settings.dark);
    for f in settings.faces std::print(f);
    say("counts", settings.counts[0] + settings.counts[1] + settings.counts[2]);
    std::print(if (settings.extra == null) "extra: null" else "extra: set");
    say("opened", opened);
    say("counter", counter);
    std::print(changes_type);
    say("added", added);
    say("small", small as int);
    std::write(1, "ratio x2: ");
    std::print_int((ratio * 2.0) as int);
    std::print(maybe or "(none)");
    std::print(word);
    std::print_bool(flag);
    std::print("v2 ready");
    _p: int = l8_pause();
    std::print("v2 resumed");
    7
}

missing(): noreturn {
    exit(3)
}

extern exit(code: int): noreturn
