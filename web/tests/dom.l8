tag dom_test;

use_tag std, dom;

// Every call of the page bridge (programs/web/dom.l8), in a browser: each
// check pushes "ok NAME" or "FAIL NAME" onto window.l8_results, and
// window.l8_done is set once the timers, frames, fetches, storage and audio
// have answered. web/tests/dom.html runs it; dom.mjs (beside it) drives it
// in Chromium over CDP and clicks, types and emulates what it needs.
import "../../programs/web/dom.l8";

results: int = 0;

buf: []i8 = new i8[256](0i8);

out4: []int = new int[4](0);

box: []f64 = new f64[6](0.0f64);

pending: int = 0;

check(name: str, ok: bool) {
    if (ok) dom_call_s(results, "push", name) else {
        dom_call_s(results, "push", "FAIL");
        dom_call_s(results, "push", name)
    }
}

// Whether the first n bytes of buf are s.
is(n: int, s: str): bool {
    if (n != len(s)) return false;
    for i in 0..n {
        if (buf[i] != s[i]) return false
    }
    true
}

done_one() {
    pending = pending - 1;
    if (pending == 0) dom_set_prop(DOM_WINDOW, "l8_done", 1.0f64)
}

text_node: int = 0;

field: int = 0;

clicks: int = 0;

main(): int {
    dom_start();
    dom_set_prop_s(DOM_WINDOW, "l8_name", "dom");
    results = dom_prop_handle(DOM_WINDOW, "l8_results");
    check("results", results != 0);
    tree();
    content();
    geometry();
    selection();
    storage();
    additions();
    pending = 6;
    timers();
    fetches();
    media();
    audio();
    events();
    0
}

tree() {
    root: int = dom_by_id("root");
    check("by_id", root != 0);
    p: int = dom_create("p");
    dom_set_attr(p, "id", "para");
    dom_append(root, p);
    check("query", dom_query(DOM_DOCUMENT, "#root > p#para") == p);
    check("parent", dom_parent(p) == root);
    a: int = dom_create("span");
    b: int = dom_text("b");
    dom_append(p, b);
    dom_insert(p, a, b);
    dom_set_text(a, "a");
    n: int = dom_get_text(p, buf);
    check("insert", is(n, "ab"));
    frag: int = dom_fragment();
    for _i in 0..3 {
        s: int = dom_create("i");
        dom_set_text(s, "x");
        dom_append(frag, s);
        dom_free(s)
    }
    dom_append(p, frag);
    dom_free(frag);
    check("fragment", is(dom_get_text(p, buf), "abxxx"));
    dom_remove(a);
    check("remove", is(dom_get_text(p, buf), "bxxx"));
    dom_append(root, a);
    held: int = dom_handles();
    dom_clear(p);
    check("clear", dom_get_text(p, buf) == 0 && dom_handles() == held - 1);
    dom_free_tree(a);
    check("free_tree", dom_handles() == held - 2);
    svg: int = dom_create_svg("svg");
    check("svg", dom_get_prop_s(svg, "namespaceURI", buf) == 26)
}

content() {
    root: int = dom_by_id("root");
    d: int = dom_create("div");
    dom_append(root, d);
    words: []i8 = new i8[16](0i8);
    for i in 0..5 words[i] = (104 + i) trunc i8;
    dom_set_text_of(d, words, 1, 4);
    check("text_of", is(dom_get_text(d, buf), "ijk"));
    dom_set_html(d, "<b>bold</b> &amp; <i>it</i>");
    check("html", is(dom_get_text(d, buf), "bold & it") && dom_query(d, "b") != 0);
    dom_set_attr(d, "data-x", "1");
    dom_set_attr_int(d, "data-n", -42);
    dom_set_attr_of(d, "title", words, 0, 2);
    check("attr", is(dom_get_attr(d, "data-n", buf), "-42") && is(dom_get_attr(d,
        "title", buf), "hi"));
    dom_remove_attr(d, "data-x");
    check("remove_attr", dom_get_attr(d, "data-x", buf) == -1);
    dom_set_class(d, "one two");
    dom_add_class(d, "three");
    dom_remove_class(d, "one");
    dom_toggle_class(d, "four", 1);
    dom_toggle_class(d, "two", 0);
    check("class", is(dom_get_prop_s(d, "className", buf), "three four"));
    dom_set_style(d, "color", "rgb(1, 2, 3)");
    dom_set_style(d, "--gap", "4px");
    check("style", is(dom_get_attr(d, "style", buf), "color: rgb(1, 2, 3); --gap: 4px;"));
    dom_set_style(d, "color", "");
    check("style removed", is(dom_get_attr(d, "style", buf), "--gap: 4px;"));
    dom_set_prop(d, "hidden", 1.0f64);
    check("prop bool", dom_get_prop(d, "hidden") == 1.0f64);
    dom_set_prop(d, "hidden", 0.0f64);
    dom_set_prop(d, "tabIndex", 3.0f64);
    check("prop", dom_get_prop(d, "tabIndex") == 3.0f64);
    dom_set_prop_of(DOM_DOCUMENT, "title", words, 0, 3);
    check("title", is(dom_get_prop_s(DOM_DOCUMENT, "title", buf), "hij"));
    check("prop_s none", dom_get_prop_s(d, "tabIndex", buf) == -1);
    small: []i8 = new i8[2](0i8);
    check("long text", dom_get_prop_s(DOM_DOCUMENT, "title", small) == 3 && small[1] as int == 105);
    // (A missing node: the call fails, logged, and answers -1.)
    check("bad handle", dom_set_text(999999, "x") == -1);
    field = dom_create("input");
    dom_append(root, field);
    dom_call(field, "focus");
    check("call", dom_prop_handle(DOM_DOCUMENT, "activeElement") == field);
    dom_set_prop_s(field, "value", "typed");
    check("value", is(dom_get_prop_s(field, "value", buf), "typed"));
    dom_set_prop_s(field, "value", "");
    check("call_s", dom_call_s(d, "hasAttribute", "data-n") == 1.0f64)
}

geometry() {
    root: int = dom_by_id("root");
    tall: int = dom_create("div");
    dom_set_style(tall, "height", "3000px");
    dom_set_style(tall, "width", "200px");
    dom_append(root, tall);
    dom_rect(tall, box);
    check("rect", box[2] == 200.0f64 && box[3] == 3000.0f64);
    dom_scroll_to(DOM_WINDOW, 0.0f64, 500.0f64, 0);
    dom_scroll(DOM_WINDOW, box);
    check("scroll window", box[1] == 500.0f64 && box[3] > 3000.0f64 && box[5] > 0.0f64);
    pane: int = dom_create("div");
    dom_set_style(pane, "height", "100px");
    dom_set_style(pane, "overflow", "auto");
    inner: int = dom_create("div");
    dom_set_style(inner, "height", "1000px");
    dom_append(pane, inner);
    dom_append(root, pane);
    dom_scroll_to(pane, 0.0f64, 250.0f64, 0);
    dom_scroll(pane, box);
    check("scroll element", box[1] == 250.0f64 && box[3] == 1000.0f64 && box[5] == 100.0f64);
    dom_scroll_into_view(tall, 0, 0);
    dom_rect(tall, box);
    check("into view", box[1] == 0.0f64);
    dom_scroll_to(DOM_WINDOW, 0.0f64, 0.0f64, 0)
}

selection() {
    root: int = dom_by_id("root");
    p: int = dom_create("p");
    dom_append(root, p);
    // "Î±Î²" is four bytes; "gamma" follows in a span of its own.
    t: int = dom_text("\Î\±\Î\² ");
    dom_append(p, t);
    g: int = dom_create("span");
    dom_set_text(g, "gamma");
    dom_append(p, g);
    dom_select(p, 2, p, 7);
    check("select", is(dom_selection_text(buf), "\Î\² ga"));
    kind: int = dom_selection(out4);
    check("selection", kind == 2 && out4[0] == t && out4[1] == 2 && out4[2] == g && out4[3] == 2);
    dom_select(p, 3, p, 3);
    check("caret", dom_selection(out4) == 1);
    dom_select_none();
    check("select_none", dom_selection(out4) == 0);
    text_node = p
}

storage() {
    dom_store_set_s("l8:test", "one");
    check("store", is(dom_store_get("l8:test", buf), "one"));
    v: []i8 = new i8[4](0i8);
    v[0] = 116i8;
    v[1] = 119i8;
    v[2] = 111i8;
    dom_store_set("l8:test", v, 3);
    check("store bytes", is(dom_store_get("l8:test", buf), "two"));
    n: int = dom_store_count();
    found: bool = false;
    for i in 0..n {
        if (is(dom_store_key(i, buf), "l8:test")) found = true
    }
    check("store keys", found && dom_store_key(n, buf) == -1);
    dom_store_remove("l8:test");
    check("store remove", dom_store_get("l8:test", buf) == -1 && dom_store_count() == n - 1)
}

// What phase (a) of the web app added (WEB.md SW1.3).
additions() {
    root: int = dom_by_id("root");
    box2: int = dom_create("div");
    dom_append(root, box2);
    html: []i8 = new i8[128](0i8);
    n: int = 0;
    for c in "<p class=\"x\" data-act=\"go\">one <b>two</b></p><p class=\"x\">three</p>" {
        html[n] = c;
        n = n + 1
    }
    first: int = dom_insert_html_of(box2, 2, html, 0, n);
    check("insert_html", first == dom_query(box2, "p") && dom_count(box2, "p.x") == 2);
    before: int = dom_insert_html_of(first, 0, html, n - 22, n);
    check("insert_html before", before != 0 && dom_count(box2, "p") == 3 && dom_query(box2,
        "p") == before);
    check("class_all", dom_class_all(box2, "p.x", "y", 1) == 3 && dom_count(box2,
        ".y") == 3);
    dom_class_all(box2, "p", "y", 0);
    check("class_all off", dom_count(box2, ".y") == 0);
    check("has_prop", dom_has_prop(DOM_WINDOW, "onclick") == 1 && dom_has_prop(DOM_WINDOW,
        "no_such_thing") == 0);
    // (Two lines' boxes for a span that wraps.)
    narrow: int = dom_create("p");
    dom_set_style(narrow, "width", "60px");
    s: int = dom_create("span");
    dom_set_text(s, "one two three four");
    dom_append(narrow, s);
    dom_append(root, narrow);
    rects: []f64 = new f64[32](0.0f64);
    check("rects", dom_rects(s, rects) >= 2 && rects[1] < rects[5]);
    dom_scroll_into_view(narrow, 0, 0);
    dom_rect(s, box);
    check("point", dom_point(box[0] + 2.0f64, box[1] + 2.0f64, "p") == narrow && dom_point(box[0] + 2.0f64,
        box[1] + 2.0f64, "") == s);
    dom_listen(box2, "click", 0, &on_act, 0);
    dom_set_prop(DOM_WINDOW, "l8_acts", 0.0f64);
    state: []i8 = new i8[16](0i8);
    for i in 0..5 state[i] = (97 + i) trunc i8;
    url: []i8 = new i8[16](0i8);
    url[0] = 63i8;
    url[1] = 115i8;
    dom_push(url, 2, state, 5);
    check("push state", is(dom_state(buf), "abcde") && is(dom_get_prop_s(DOM_LOCATION,
        "search", buf), "?s"));
    dom_replace(url, 2, state, 2);
    check("replace state", is(dom_state(buf), "ab"));
    w: int = dom_wake_lock(1);
    dom_wake_lock(0);
    check("wake_lock", w == 0 || w == 1)
}

// A click inside the inserted HTML: the attribute from the element clicked.
on_act(_data: int) {
    n: int = dom_event_attr("data-act", buf);
    p: int = dom_event_closest("p");
    check("event_attr", is(n, "go") && p != 0 && dom_event_attr("data-none", buf) == -1);
    dom_set_prop(DOM_WINDOW, "l8_acts", 1.0f64)
}

t_set: f64 = 0.0f64;

cancelled: int = 0;

ticks: int = 0;

interval: int = 0;

timers() {
    t_set = dom_now();
    check("now", t_set > 0.0f64 && dom_date_now() > 1700000000000.0f64);
    cancelled = dom_timeout(10.0f64, &on_cancelled, 0);
    dom_timeout(30.0f64, &on_timeout, 7);
    dom_cancel(cancelled);
    interval = dom_interval(5.0f64, &on_tick, 0);
    dom_frame(&on_frame, 0)
}

on_cancelled(_data: int) {
    check("cancel", false)
}

on_timeout(data: int) {
    check("timeout", data == 7 && dom_now() - t_set >= 29.0f64 && dom_ev[DE_ID] > 0);
    done_one()
}

on_tick(_data: int) {
    ticks = ticks + 1;
    if (ticks == 3) {
        dom_cancel(interval);
        check("interval", dom_ev[DE_ID] == interval);
        done_one()
    }
}

on_frame(_data: int) {
    check("frame", dom_evf[DF_VALUE] > 0.0f64);
    done_one()
}

fetches() {
    dom_fetch("dom.html", &on_fetched, 1);
    dom_fetch("missing.txt", &on_fetched, 2);
    dom_fetch_gz("dom.html.gz", &on_unzipped, 0)
}

on_unzipped(_data: int) {
    b: []i8 = dom_fetch_body(dom_ev[DE_ID]);
    check("fetch_gz", dom_ev[DE_STATUS] == 200 && len(b) == dom_ev[DE_SIZE] && b[0] as int == 60 && b[1] as int == 33);
    done_one()
}

fetched: int = 0;

on_fetched(data: int) {
    if (data == 1) {
        n: int = dom_ev[DE_SIZE];
        b: []i8 = dom_fetch_body(dom_ev[DE_ID]);
        check("fetch", dom_ev[DE_STATUS] == 200 && n > 100 && len(b) == n && b[0] as int == 60)
    } else {
        check("fetch 404", dom_ev[DE_STATUS] == 404);
        part: []i8 = new i8[4](0i8);
        check("fetch_take", dom_fetch_take(dom_ev[DE_ID], part, 1) == 3)
    }
    fetched = fetched + 1;
    if (fetched == 2) done_one()
}

media() {
    dark: int = dom_media("(prefers-color-scheme: dark)");
    dom_set_prop(DOM_WINDOW, "l8_dark", dark as f64);
    check("media", dom_media("(min-width: 1px)") == 1 && dom_media("(max-width: 1px)") == 0);
    dom_media_listen("(prefers-color-scheme: dark)", &on_scheme, 0);
    dom_set_prop(DOM_WINDOW, "l8_listening", 1.0f64)
}

on_scheme(_data: int) {
    dom_set_prop(DOM_WINDOW, "l8_dark", dom_ev[DE_STATUS] as f64)
}

player: int = 0;

audio() {
    player = dom_create("audio");
    dom_listen(player, "loadedmetadata", DOM_ONCE, &on_audio, 0);
    dom_listen(player, "ended", 0, &on_audio, 1);
    // (A quarter second's tone the page made, as a blob: URL.)
    n: int = dom_get_prop_s(DOM_WINDOW, "l8_tone", buf);
    dom_set_prop_of(player, "src", buf, 0, n);
    dom_append(dom_by_id("root"), player)
}

on_audio(data: int) {
    if (data == 0) {
        d: f64 = dom_get_prop(player, "duration");
        check("audio duration", d > 0.2f64 && d < 0.3f64);
        dom_set_prop(player, "currentTime", 0.15f64);
        t: f64 = dom_get_prop(player, "currentTime");
        check("audio seek", t > 0.14f64 && t < 0.16f64);
        dom_call(player, "play")
    } else {
        check("audio ended", dom_get_prop(player, "paused") == 1.0f64 && dom_event_is("ended"));
        done_one()
    }
}

// Clicks, keys and wheel come from the driver (dom.mjs), after l8_done.
events() {
    root: int = dom_by_id("root");
    dom_listen(text_node, "click", 0, &on_click, 5);
    dom_listen(DOM_WINDOW, "keydown", 0, &on_key, 0);
    dom_listen(root, "wheel", DOM_PREVENT, &on_wheel, 0);
    once: int = dom_listen(root, "custom", DOM_ONCE, &on_click, 6);
    dom_set_prop(DOM_WINDOW, "l8_once", once as f64);
    dom_push_state("?a=1");
    dom_replace_state("?b=2");
    check("location", is(dom_get_prop_s(DOM_LOCATION, "search", buf), "?b=2"));
    dom_listen(DOM_WINDOW, "popstate", 0, &on_pop, 0)
}

on_click(data: int) {
    if (data == 6) {
        dom_set_prop(DOM_WINDOW, "l8_custom", dom_get_prop(DOM_WINDOW, "l8_custom") + 1.0f64);
        return
    }
    clicks = clicks + 1;
    // The target is the span clicked (gamma), the listener its paragraph.
    span: int = dom_query(text_node, "span");
    check("click", dom_event_is("click") && dom_ev[DE_TARGET] == span && dom_ev[DE_CURRENT] == text_node && dom_evf[DF_X] > 0.0f64 && dom_ev[DE_DETAIL] == 1 && (dom_ev[DE_MODS] & DOM_SHIFT) != 0);
    dom_set_prop(DOM_WINDOW, "l8_clicks", clicks as f64)
}

on_key(_data: int) {
    if (dom_key_is("ArrowDown")) {
        dom_prevent_default();
        check("key", dom_event_is("keydown") && (dom_ev[DE_MODS] & DOM_CTRL) != 0)
    } else if (dom_key_is("\Ã\©")) check("key text", true);
    dom_set_prop(DOM_WINDOW, "l8_keys", dom_get_prop(DOM_WINDOW, "l8_keys") + 1.0f64)
}

on_wheel(_data: int) {
    check("wheel", dom_evf[DF_DY] == 120.0f64);
    dom_set_prop(DOM_WINDOW, "l8_wheel", 1.0f64)
}

on_pop(_data: int) {
    check("popstate", is(dom_get_prop_s(DOM_LOCATION, "search", buf), "?s") && is(dom_state(buf), "ab"));
    dom_set_prop(DOM_WINDOW, "l8_popped", 1.0f64)
}
