// Built with `l8 wasm --async l8_pause`, every l8_pause call pauses the module
// and resumes it: inside match arms, a region, ranged and collection loops,
// while and if/else, and a resumable helper. The output must match a build in
// which l8_pause is an ordinary import. See resume.mjs.
tag pausetest;

use_tag std;

import "../../stdlib/print.l8";

extern l8_pause(n: int): int;

type Shape =
    | Dot
    | Line { length: int }
    | Box { w: int, h: int }

counter: int = 0;

// Resumable: its locals and position survive pauses.
step(label: str, n: int) raises IoError: int {
    total: int = n;
    for i in 0..3 {
        total = total + i;
        got: int = l8_pause(total);
        write(1, label);
        write(1, " ");
        write_int(1, i);
        write(1, " -> ");
        print_int(got + total)
    }
    total
}

main() raises IoError: int {
    shapes: []Shape = [Shape.Dot, Shape.Line { length: 4 }, Shape.Box { w: 2, h: 3 }];
    sum: int = 0;
    for s in shapes {
        match s {
            Dot -> {
                l8_pause(1);
                print("dot")
            }
            Line l -> {
                counter = counter + l.length;
                x: int = l8_pause(2);
                print_int(x + l.length)
            }
            Box b -> {
                if (b.w > 1) {
                    region {
                        tmp: []int = new int[8](b.h);
                        l8_pause(3);
                        print_int(tmp[7] * b.w)
                    }
                } else l8_pause(4)
            }
        }
    }
    i: int = 0;
    while (i < 3) {
        if (i % 2 == 0) {
            even: int = step("even", i);
            sum = sum + even
        } else {
            odd: int = step("odd", i);
            sum = sum + odd
        }
        i = i + 1
    }
    print_int(sum);
    print_int(counter);
    7
}
