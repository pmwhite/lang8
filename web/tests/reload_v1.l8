tag reload_test;

use_tag std;

import "../../stdlib/print.l8";

// The first build of a program that is reloaded (reload.mjs): it makes its
// persistent state, says it is ready and pauses; the reload happens there.
extern l8_pause(): int;

type Node = {
    value: int;
    next: ?*Node;
    back: ?*Node
}

type Place = {
    book: int;
    chapter: int;
    note: str
}

type Mark =
    | None
    | At { place: Place, color: i8 }

type Settings = {
    size: f64;
    dark: bool;
    faces: []str;
    counts: [3]int
}

persistent list: ?*Node = null;

persistent shared: ?*Node = null;

persistent place: Place = Place { book: 1, chapter: 1, note: "start" };

persistent marks: []Mark = [Mark.None];

persistent settings: Settings = Settings {
    size: 1.0f64,
    dark: false,
    faces: ["None"],
    counts: [0, 0, 0]
};

persistent opened: int = 0;

persistent counter: int = 0;

persistent gone: int = 5;

persistent changes_type: int = 9;

persistent small: i8 = 3i8;

persistent ratio: f32 = 1.5;

persistent maybe: ?str = null;

persistent word: str = "first";

persistent flag: bool = true;

main() noregion raises IoError: int {
    n3: *Node = new Node { value: 3, next: null, back: null };
    n2: *Node = new Node { value: 2, next: n3, back: null };
    n1: *Node = new Node { value: 1, next: n2, back: null };
    n3.back = n1;
    list = n1;
    shared = n2;
    place = Place { book: 43, chapter: 3, note: "John 3" };
    marks = [Mark.At { place: Place { book: 19, chapter: 23, note: "psalm" }, color: 3i8 },
        Mark.None];
    settings = Settings {
        size: 1.25f64,
        dark: true,
        faces: ["Serif", "Charis"],
        counts: [7, 8, 9]
    };
    opened = 2;
    counter = 41;
    changes_type = 10;
    small = 5i8;
    ratio = 2.5;
    maybe = "yes";
    word = "second";
    flag = false;
    std::print("v1 ready");
    _p: int = l8_pause();
    std::print("v1 resumed");
    1
}
