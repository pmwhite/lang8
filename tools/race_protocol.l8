tag race_protocol_tool;

import "../programs/race/protocol.l8";

import "../stdlib/print.l8";

main() raises std::IoError: int {
    std::write(1, "// Generated from programs/race/protocol.l8 by tools/race_protocol.l8.\n");
    std::write(1, "export const HUMAN_SEATS = ");
    std::write_int(1, race_protocol::HUMAN_SEATS);
    std::write(1, ";\n");
    0
}
