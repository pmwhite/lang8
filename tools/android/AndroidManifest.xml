<?xml version="1.0" encoding="utf-8"?>
<!-- Better on Android (see build.sh; versionCode is filled in there). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="space.trailingwhite.better">
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
  <uses-feature android:name="android.hardware.location.gps" android:required="false" />
  <application android:label="Better" android:icon="@mipmap/icon"
      android:theme="@style/Better" android:allowBackup="false"
      android:hasCode="true">
    <activity android:name=".Better" android:exported="true"
        android:launchMode="singleTask" android:screenOrientation="portrait"
        android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden|keyboard|density"
        android:windowSoftInputMode="adjustNothing">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="better" android:host="link" />
      </intent-filter>
    </activity>
    <service android:name=".Recording" android:exported="false"
        android:foregroundServiceType="location" />
  </application>
</manifest>
