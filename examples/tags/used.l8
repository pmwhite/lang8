import "lib.l8";

main(): int {
    box: TagBox = TagBox { value: tag_count };
    if (box.value != 7 || parser::tag_parse() != 17) {
        return 1;
    }
    write(1, "used\n");
    0;
}

// A use activates either tag independently and applies to the whole file.
use_tag parser_alias, unused_tag;
