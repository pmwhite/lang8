import "lib.l8";

import "./peer.l8";

// Qualifiers work without use_tag, including when a local shadows the global.
qualified_access(): int {
    tag_count: int = 3;
    box: parser::TagBox = parser_alias::TagBox { value: parser::tag_count };
    ptr: *parser::TagBox = new parser::TagBox { value: box.value };
    choice: parser::TagChoice = parser::TagChoice.Value { value: ptr.value };
    heap_choice: *parser::TagChoice = new parser::TagChoice.Empty;
    size: int = sizeof(parser::TagBox);
    ffi::rdtsc();
    matched: int = match choice {
        Empty -> {
            0;
        }
        Value v -> {
            v.value;
        }
    };
    empty: int = match heap_choice.* {
        Empty -> {
            1;
        }
        Value _v -> {
            0;
        }
    };
    tag_count + matched + empty + size + late_internal::tag_helper();
}

// Each additional declaration tag is also usable in its signature and body.
tag unrelated, parser, parser_alias
local_access(box: *TagBox): int {
    tag_count + tag_parse() + box.value;
}

qualified_raises() raises parser::TagOops {
    raise parser::TagOops { code: 4 };
}

main(): int {
    if (qualified_access() != 29) {
        return 1;
    }
    box: parser_alias::TagBox = parser_alias::TagBox { value: 5 };
    if (unrelated::local_access(&box) != 29) {
        return 2;
    }
    try {
        parser::tag_raise();
    } with parser::TagOops e -> {
        if (e.code != 9) {
            return 3;
        }
    }
    try {
        qualified_raises();
    } with parser::TagOops e -> {
        if (e.code != 4) {
            return 4;
        }
    }
    write(1, "tags\n");
    0;
}
