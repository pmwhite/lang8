/* Checked exceptions: unit + payload, catch, and print.
   `raises` must be exact — listing an exception the body never raises is an error. */
exception Empty;
exception NotFound { name: []i8 };

putchar(c: i8) {
    write(1, &c, 1);
}

puts(s: []i8) {
    write(1, s, len(s));
}

boom() raises Empty {
    raise Empty;
}

lookup(want: []i8) @immortal raises NotFound: []i8 {
    /* Payload is immortal; copy a self-bound name rather than store it. */
    n: int = len(want);
    copy: []i8 = new i8[n](0i8);
    memcpy(copy, 0, want, 0, n);
    raise NotFound { name: copy };
}

main() @immortal: int {
    try {
        boom();
        putchar('X');
    } with Empty -> {
        /* caught unit */
    }

    try {
        s: []i8 = lookup("Hi");
        puts(s);
    } with NotFound(e) -> {
        puts(e.name);
    }
    putchar('\n');
    0;
}
