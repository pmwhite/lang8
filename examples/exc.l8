/* Checked exceptions: unit + payload, catch, and print.
   `raises` must be exact — listing an exception the body never raises is an error. */
exception Empty;
exception NotFound { name: *i8 };

putchar(c: i8) {
    write(1, &c, 1);
}

puts(s: *i8) {
    write(1, s, len(s));
}

boom() raises Empty {
    raise Empty;
}

lookup(want: *i8) raises NotFound: *i8 {
    raise NotFound { name: want };
}

main(): int {
    try {
        boom();
        putchar('X');
    } with Empty -> {
        /* caught unit */
    }

    try {
        s: *i8 = lookup("Hi");
        puts(s);
    } with NotFound(e) -> {
        puts(e.name);
    }
    putchar('\n');
    return 0;
}
