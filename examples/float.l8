/* f32/f64: same-type arithmetic, as convert, xmm call ABI. */
putchar(c: i8) {
    write(1, &c, 1);
}

addf(a: f32, b: f32): f32 {
    a + b;
}

addd(a: f64, b: f64): f64 {
    a + b;
}

mix(n: int, x: f32, m: int, y: f32): f32 {
    x + y + (n + m) as f32 * 0.0;
}

main(): int {
    if (1.0 + 0.5 == 1.5) {
        putchar('Y');
    }
    if (0.8 == 0.8) {
        putchar('Y');
    }
    if (1.0 * 2.0 == 2.0) {
        putchar('Y');
    }
    if (1.0 / 2.0 == 0.5) {
        putchar('Y');
    }
    if (0.5 < 1.0) {
        putchar('Y');
    }
    if (0.0 - 0.5 + 0.5 == 0.0) {
        putchar('Y');
    }
    if (addf(1.0, 2.0) == 3.0) {
        putchar('Y');
    }
    if (1.0f64 + 0.5f64 == 1.5f64) {
        putchar('Y');
    }
    if (addd(1.0f64, 2.0f64) == 3.0f64) {
        putchar('Y');
    }
    if (mix(1, 0.5, 2, 0.5) == 1.0) {
        putchar('Y');
    }
    if ((3 as f32) == 3.0) {
        putchar('Y');
    }
    if ((1.5 as int) == 1) {
        putchar('Y');
    }
    if ((1.0 as f64) + 0.5f64 == 1.5f64) {
        putchar('Y');
    }
    xs: []f32 = new f32[2](0.5);
    if (xs[0] + xs[1] == 1.0) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
