/* `local T` lets a callee take addresses inside T for the duration of the call. */

type Box = { p: *int; }

type Ts = { sec: int; nsec: int; }

extern clock_gettime(clk: int, ts: local *Ts): int;

putchar(c: i8) {
    write(1, &c, 1);
}

id(x: local int): int {
    x;
}

load(p: local *int): int {
    p.*;
}

loadb(b: local Box): int {
    b.p.*;
}

fwd(p: local *int): int {
    load(p);
}

main(): int {
    x: int = 3;
    if (id(3) == 3) { putchar('Y'); }
    if (load(&x) == 3) { putchar('Y'); }
    b: Box = Box { p: &x };
    if (loadb(b) == 3) { putchar('Y'); }
    if (fwd(&x) == 3) { putchar('Y'); }
    ts: Ts = Ts { sec: 0, nsec: 0 };
    if (clock_gettime(1, &ts) == 0) { putchar('Y'); }
    putchar('\n');
    0;
}
