/* Raise rewinds regions the unwind passes; catch inside a region does not. */

exception Boom;
exception Note { name: []i8 };

putchar(c: i8) {
    write(1, &c, 1);
}

from_callee() raises Boom {
    raise Boom;
}

main(): int {
    region {
        p: *int = new int[1](7);
        try {
            raise Boom;
        } with Boom -> {
            if (p.* == 7) { putchar('Y'); }
        }
    }

    try {
        raise Note { name: "Y" };
    } with Note(e) -> {
        putchar(e.name[0]);
    }

    try {
        region {
            a: []i8 = new i8[41943040](0i8);
            a[0] = 'x';
            from_callee();
        }
    } with Boom -> {
    }
    b: []i8 = new i8[41943040](0i8);
    if (b[0] == 0i8) { putchar('Y'); }

    putchar('\n');
    0;
}
