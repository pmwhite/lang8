/* Index the original []T. Interior *T from &e[i] is not indexable. */

putchar(c: i8) {
    write(1, &c, 1);
}

main(): int {
    buf: []i8 = new i8[3];
    buf[0] = 'Y';
    buf[1] = 'Y';
    buf[2] = 'Y';
    if (buf[1] == 'Y') {
        putchar(buf[0]);
    }
    if (buf[0] == 'Y') {
        putchar(buf[1]);
    }
    if (buf[2] == 'Y') {
        putchar(buf[2]);
    }
    putchar('\n');
    0;
}
