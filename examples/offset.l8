/* Pointer offsets are p[i] and &p[i]; p+i is a type error. */

putchar(c: i8) {
    write(1, &c, 1);
}

main(): int {
    buf: *i8 = new i8[3];
    buf[0] = 'Y';
    buf[1] = 'Y';
    buf[2] = 'Y';
    q: *i8 = &buf[1];
    if (q[0] == 'Y') {
        putchar(buf[0]);
    }
    if ((&buf[0])[1] == 'Y') {
        putchar(q[0]);
    }
    if (q[1] == 'Y') {
        putchar(buf[2]);
    }
    putchar('\n');
    0;
}
