/* Large sum as a field of `new T { ... }` — must memcpy, not bury dest under stack temp.
   Also covers by-ref sum params stored into `new` fields (mk_expr-style). */
type Big =
    | Triple { x: int; y: int; z: int; }
    | One { n: int; };

type Box = {
    k: Big;
    n: int;
};

putchar(c: i8) {
    write(1, &c, 1);
}

print_int(v: int) {
    if (v < 0) {
        putchar('-');
        v = 0 - v;
    }
    if (v > 9) {
        print_int(v / 10);
    }
    putchar((('0' as int) + (v % 10)) trunc i8);
}

mk(k: Big, n: int) @immortal: *Box {
    new Box {
        k: k,
        n: n
    };
}

main() @immortal: int {
    p: *Box = new Box {
        k: Big.Triple { x: 1, y: 2, z: 3 },
        n: 9
    };
    match p.k {
        Triple(t) -> {
            print_int(t.x);
            putchar(' ');
            print_int(t.y);
            putchar(' ');
            print_int(t.z);
        }
        One(o) -> {
            print_int(o.n);
        }
    }
    putchar(' ');
    print_int(p.n);
    putchar(' ');
    q: *Box = mk(Big.Triple { x: 4, y: 5, z: 6 }, 7);
    match q.k {
        Triple(t) -> {
            print_int(t.x);
            putchar(' ');
            print_int(t.y);
            putchar(' ');
            print_int(t.z);
        }
        One(o) -> {
            print_int(o.n);
        }
    }
    putchar(' ');
    print_int(q.n);
    putchar('\n');
    0;
}
