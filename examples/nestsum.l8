/* Large sum as a field of `new T { ... }` — must memcpy, not bury dest under stack temp. */
type Big =
    | Triple { x: int; y: int; z: int; }
    | One { n: int; };

type Box = {
    k: Big;
    n: int;
};

putchar(c: i8) {
    write(1, &c, 1);
}

print_int(v: int) {
    if (v < 0) {
        putchar('-');
        v = 0 - v;
    }
    if (v > 9) {
        print_int(v / 10);
    }
    putchar((('0' as int) + (v % 10)) trunc i8);
}

main(): int {
    p: *Box = new Box {
        k: Big.Triple { x: 1, y: 2, z: 3 },
        n: 9
    };
    match p.k {
        Triple { x, y, z } -> {
            print_int(x);
            putchar(' ');
            print_int(y);
            putchar(' ');
            print_int(z);
        }
        One { n } -> {
            print_int(n);
        }
    }
    putchar(' ');
    print_int(p.n);
    putchar('\n');
    return 0;
}
