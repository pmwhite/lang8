/* Warnings: unnecessary tail `return`, and ignored values in returning functions. */
putchar(c: i8) {
    write(1, &c, 1);
}

id(n: int): int {
    return n;
}

id2(n: int): int {
    n;
}

drop(n: int): int {
    n;
    0;
}

side(n: int): int {
    n = n + 1;
    n;
}

proc() { }

callp(n: int): int {
    proc();
    n;
}

early(n: int): int {
    if (n < 0) {
        return 0 - n;
    }
    n;
}

both(n: int): int {
    if (n < 0) {
        return 0 - n;
    } else {
        return n;
    }
}

main(): int {
    if (id(1) == 1) {
        putchar('Y');
    }
    if (id2(1) == 1) {
        putchar('Y');
    }
    if (drop(3) == 0) {
        putchar('Y');
    }
    if (side(1) == 2) {
        putchar('Y');
    }
    if (callp(1) == 1) {
        putchar('Y');
    }
    if (early(0 - 3) == 3) {
        putchar('Y');
    }
    if (both(2) == 2) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
