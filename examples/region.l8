/* region rewinds the bump heap; @ bounds and the store rule allow
   stack addresses into a same-function inner new, and outer into inner. */

type Box = { p: *int; }
type Node = { child: ?*Node; }
type Ts = { sec: int; nsec: int; }

extern clock_gettime(clk: int, ts: *Ts@): int;

putchar(c: i8) {
    write(1, &c, 1);
}

id(p: *int@): *int@p {
    p;
}

wrap(p: *int@new): *Box@new {
    new Box { p: p };
}

set_child(parent: *Node@, child: *Node@parent) {
    parent.child = child;
}

main(): int {
    region {
        a: []i8 = new i8[41943040](0i8);
        a[0] = 'x';
    }
    b: []i8 = new i8[41943040](0i8);
    if (b[0] == 0i8) { putchar('Y'); }

    x: int = 7;
    region {
        bx: *Box = wrap(&x);
        if (bx.p.* == 7) { putchar('Y'); }
        q: *int = id(&x);
        if (q.* == 7) { putchar('Y'); }
        hp: *int = new int[1](9);
        if (id(hp).* == 9) { putchar('Y'); }
    }

    region {
        outer: *Node = new Node { child: null };
        region {
            inner: *Node = new Node { child: null };
            set_child(inner, outer);
            if (inner.child == outer) { putchar('Y'); }
        }
    }

    ts: Ts = Ts { sec: 0, nsec: 0 };
    if (clock_gettime(1, &ts) == 0) { putchar('Y'); }
    region {
        tsheap: *Ts = new Ts { sec: 0, nsec: 0 };
        if (clock_gettime(1, tsheap) == 0) { putchar('Y'); }
    }

    putchar('\n');
    0;
}
