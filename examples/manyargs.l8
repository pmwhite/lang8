/* More than six incoming slots: extra args and hidden sret go on the stack. */

putchar(c: i8) {
    write(1, &c, 1);
}

add7(a: int, b: int, c: int, d: int, e: int, f: int, g: int): int {
    a + b + c + d + e + f + g;
}

type Pair = { x: int; y: int; }

make6(a: int, b: int, c: int, d: int, e: int, f: int): Pair {
    Pair { x: a + b + c, y: d + e + f };
}

sump(a: int, b: int, c: int, d: int, e: int, f: int, p: Pair): int {
    a + b + c + d + e + f + p.x + p.y;
}

main(): int {
    if (add7(1, 2, 3, 4, 5, 6, 7) == 28) { putchar('Y'); }
    p: Pair = make6(1, 2, 3, 10, 20, 30);
    if (p.x == 6) { putchar('Y'); }
    if (p.y == 60) { putchar('Y'); }
    if (sump(1, 1, 1, 1, 1, 1, p) == 72) { putchar('Y'); }
    putchar('\n');
    0;
}
