type Point = {
    x: int;
    y: int;
};

putchar(c: i8) {
    write(1, &c, 1);
}

print_int(n: int) {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    putchar((('0' as int) + (n % 10)) trunc i8);
}

origin(): *Point {
    return new Point { x: 3, y: uninitialized };
}

main(): int {
    local: Point = Point { x: 1, y: 2 };
    print_int(local.x + local.y);
    putchar(' ');
    p: *Point = origin();
    p.y = 4;
    print_int(p.x * p.y);
    putchar('\n');
    return 0;
}
