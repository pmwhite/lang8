struct Point {
    x: int;
    y: int;
};

putchar(c: i8): int {
    write(1, &c, 1);
    return 0;
}

print_int(n: int): int {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    putchar((('0' as int) + (n % 10)) trunc i8);
    return 0;
}

origin(): *Point {
    p: *Point = malloc(sizeof(Point)) as *Point;
    p.x = 3;
    p.y = 4;
    return p;
}

main(): int {
    local: Point = uninitialized;
    local.x = 1;
    local.y = 2;
    print_int(local.x + local.y);
    putchar(' ');
    p: *Point = origin();
    print_int(p.x * p.y);
    putchar('\n');
    return 0;
}
