type Point = {
    x: int,
    y: int
};

putchar(c: i8) {
    write(1, &c, 1);
}

print_int(n: int) {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    putchar((('0' as int) + (n % 10)) trunc i8);
}

origin(): *Point {
    new Point { x: 3, y: 0 };
}

/* By-value aggregate param + return (hidden pointer ABI). */
bump(p: Point, dy: int): Point {
    Point { x: p.x, y: p.y + dy };
}

main(): int {
    local: Point = Point { x: 1, y: 2 };
    print_int(local.x + local.y);
    putchar(' ');
    p: *Point = origin();
    p.y = 4;
    print_int(p.x * p.y);
    putchar(' ');
    q: Point = bump(local, 10);
    print_int(q.x + q.y);
    putchar('\n');
    0;
}
