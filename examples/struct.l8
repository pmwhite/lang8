struct Point {
    int x;
    int y;
};

int putchar(int c) {
    int ch;
    ch = c;
    write(1, &ch, 1);
    return c;
}

int print_int(int n) {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    putchar('0' + (n % 10));
    return 0;
}

Point *origin() {
    Point *p;
    p = malloc(sizeof(Point));
    p.x = 3;
    p.y = 4;
    return p;
}

int main() {
    Point local;
    Point *p;
    local.x = 1;
    local.y = 2;
    print_int(local.x + local.y);
    putchar(' ');
    p = origin();
    print_int(p.x * p.y);
    putchar('\n');
    return 0;
}
