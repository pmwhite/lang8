fib(n: int): int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

putchar(c: i8): int {
    write(1, &c, 1);
    return 0;
}

print_int(n: int): int {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    putchar((('0' as int) + (n % 10)) trunc i8);
    return 0;
}

main(): int {
    print_int(fib(10));
    putchar('\n');
    return 0;
}
