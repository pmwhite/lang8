fib(n: int): int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

putchar(c: int): int {
    ch: int = c;
    write(1, &ch, 1);
    return 0;
}

print_int(n: int): int {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    q: int = n % 10;
    putchar(q + '0');
    return 0;
}

main(): int {
    print_int(fib(10));
    putchar('\n');
    return 0;
}
