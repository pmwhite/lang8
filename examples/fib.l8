int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

int putchar(int c) {
    int ch;
    ch = c;
    write(1, &ch, 1);
    return 0;
}

int print_int(int n) {
    int q;
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    q = n % 10;
    putchar(q + '0');
    return 0;
}

int main() {
    print_int(fib(10));
    putchar('\n');
    return 0;
}
