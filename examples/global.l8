/* Globals may be given a constant at the declaration. */

putchar(c: i8) {
    write(1, &c, 1);
}

n: int = 3 + 4;
flag: bool = true;
ch: i8 = 'Y';
p: ?*int = null;
neg: int = 0 - 1;

main(): int {
    if (n == 7) {
        putchar('Y');
    }
    if (flag) {
        putchar('Y');
    }
    if (ch == 'Y') {
        putchar(ch);
    }
    if (p == null) {
        putchar('Y');
    }
    if (neg == 0 - 1) {
        putchar('Y');
    }
    n = n + 1;
    if (n == 8) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
