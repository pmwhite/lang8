putchar(c: i8) {
    write(1, &c, 1);
}

len_ptr(p: ?*int): int {
    if (p != null && p.* >= 0) {
        return p.*;
    }
    return -1;
}

either_null(a: ?*int, b: ?*int): int {
    if (a == null || b == null) {
        return 1;
    } else {
        return a.* + b.*;
    }
}

main(): int {
    x: int = 3;
    p: ?*int = &x;
    if (len_ptr(p) == 3) {
        putchar('Y');
    }
    q: ?*int = null;
    if (len_ptr(q) == -1) {
        putchar('Y');
    }
    if (either_null(null, &x) == 1) {
        putchar('Y');
    }
    if (either_null(&x, &x) == 6) {
        putchar('Y');
    }
    putchar('\n');
    return 0;
}
