/* By-ref aggregates (>8 bytes) loaded from index/deref must stay addresses. */
type Cell = {
    a: int;
    b: int;
    c: int;
};

putchar(c: i8) {
    write(1, &c, 1);
}

sum(c: Cell): int {
    c.a + c.b + c.c;
}

main(): int {
    xs: []Cell = new Cell[2](Cell { a: 0, b: 0, c: 0 });
    xs[0] = Cell { a: 1, b: 2, c: 3 };
    xs[1] = Cell { a: 4, b: 5, c: 6 };
    y: Cell = xs[0];
    if (y.a == 1 && y.b == 2 && y.c == 3) {
        putchar('Y');
    }
    xs[0] = xs[1];
    if (xs[0].a == 4 && xs[0].b == 5 && xs[0].c == 6) {
        putchar('Y');
    }
    if (sum(xs[1]) == 15) {
        putchar('Y');
    }
    p: *Cell = new Cell { a: 7, b: 8, c: 9 };
    z: Cell = p.*;
    if (z.a == 7 && z.b == 8 && z.c == 9) {
        putchar('Y');
    }
    ys: []Cell = new Cell[1](xs[1]);
    if (ys[0].a == 4 && ys[0].b == 5 && ys[0].c == 6) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
