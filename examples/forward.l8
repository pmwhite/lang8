/* Forward *Shape stub is later completed as a sum type. */
type Box = {
    s: *Shape
};

type Shape =
    | Dot
    | Mark { x: int };

putchar(c: i8) {
    write(1, &c, 1);
}

print_int(n: int) {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    putchar((('0' as int) + (n % 10)) trunc i8);
}

main(): int {
    m: Shape = Shape.Mark { x: 7 };
    b: Box = Box { s: &m };
    match b.s.* {
        Mark(p) -> {
            print_int(p.x);
        }
        _ -> {
            print_int(0);
        }
    }
    putchar('\n');
    0;
}
