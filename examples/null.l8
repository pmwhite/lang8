putchar(c: i8) {
    write(1, &c, 1);
}

main(): int {
    p: *int = null;
    if (p == null) {
        putchar('Y');
    }
    q: *int = null;
    if (p == q) {
        putchar('Y');
    }
    x: int = 0;
    p = &x;
    if (p != null) {
        putchar('Y');
    }
    p = null;
    if (p == null) {
        putchar('Y');
    }
    putchar('\n');
    return 0;
}
