/* []T length prefix, T[n] checks, [:0]T walk, T[n] view. */

putchar(c: i8) {
    write(1, &c, 1);
}

cstr_len(s: [:0]i8): int {
    n: int = 0;
    while (s[n] != 0i8) { n = n + 1; }
    n;
}

is_yp(s: [:0]i8): bool {
    s[0] == 'Y' && s[1] == 'P' && s[2] == 0i8;
}

sum_n(n: int, s: i8[n]): int {
    i: int = 0;
    t: int = 0;
    while (i < n) {
        t = t + (s[i] as int);
        i = i + 1;
    }
    t;
}

main(): int {
    heap: []i8 = new i8[3];
    heap[0] = 'Y';
    heap[1] = 'Y';
    heap[2] = 'Y';
    if (len(heap) == 3) { putchar('Y'); }
    if (heap[0] == 'Y') { putchar('Y'); }

    buf: i8[2] = uninitialized;
    buf[0] = 'Y';
    buf[1] = 'Y';
    if (len(buf) == 2) { putchar('Y'); }
    if (buf[1] == 'Y') { putchar('Y'); }

    zs: [:0]i8 = "YP";
    if (cstr_len(zs) == 2) { putchar('Y'); }
    if (is_yp(zs)) { putchar('Y'); }

    if (sum_n(3, heap) == ('Y' as int) * 3) { putchar('Y'); }
    0;
}
