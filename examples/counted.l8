/* []T length prefix and [z]T walk. String literals are []i8, not [z]. */

putchar(c: i8) {
    write(1, &c, 1);
}

cstr_len(s: [z]i8): int {
    n: int = 0;
    while (s[n] != 0i8) { n = n + 1; }
    n;
}

sum_n(s: []i8): int {
    i: int = 0;
    t: int = 0;
    n: int = len(s);
    while (i < n) {
        t = t + (s[i] as int);
        i = i + 1;
    }
    t;
}

main(argc: int, argv: [][z]i8): int {
    if (argc < 1) { return 1; }
    heap: []i8 = new i8[3];
    heap[0] = 'Y';
    heap[1] = 'Y';
    heap[2] = 'Y';
    if (len(heap) == 3) { putchar('Y'); }
    if (heap[0] == 'Y') { putchar('Y'); }

    buf: []i8 = new i8[2];
    buf[0] = 'Y';
    buf[1] = 'Y';
    if (len(buf) == 2) { putchar('Y'); }
    if (buf[1] == 'Y') { putchar('Y'); }

    zs: [z]i8 = argv[0];
    if (cstr_len(zs) > 0) { putchar('Y'); }
    if (zs[0] != 0i8) { putchar('Y'); }

    if (sum_n(heap) == ('Y' as int) * 3) { putchar('Y'); }
    0;
}
