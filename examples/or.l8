/* `e or alt` unwraps ?*T to *T (alt is *T or noreturn). */

putchar(c: i8) {
    write(1, &c, 1);
}

die(): noreturn {
    exit(1);
}

type Box = { v: int; };

first(a: ?*int, b: ?*int): *int {
    a or b or die();
}

field_v(p: ?*Box): int {
    (p or die()).v;
}

main(): int {
    x: int = 3;
    y: int = 7;
    p: ?*int = &x;
    q: ?*int = null;
    if ((p or die()).* == 3) {
        putchar('Y');
    }
    if ((q or &y).* == 7) {
        putchar('Y');
    }
    if (first(q, p).* == 3) {
        putchar('Y');
    }
    b: Box = Box { v: 9 };
    bp: ?*Box = &b;
    if (field_v(bp) == 9) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
