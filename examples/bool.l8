putchar(c: i8) {
    write(1, &c, 1);
}

main(): int {
    t: bool = true;
    f: bool = false;
    if (t) {
        putchar('T');
    }
    if (f) {
        putchar('N');
    }
    if (t == true) {
        putchar('Y');
    }
    n: int = t as int;
    if (n == 1) {
        putchar('1');
    }
    b: bool = 0 trunc bool;
    if (!b) {
        putchar('0');
    }
    putchar('\n');
    return 0;
}
