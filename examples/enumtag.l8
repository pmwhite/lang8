/* Tag type, explicit numbers, C payload layout, and a minimum size. */
putchar(c: i8) {
    write(1, &c, 1);
}

type Color =
    | 10 Red
    | 20 Blue;

type Tiny: i32 =
    | A
    | B;

type Pair: i32 =
    | 1 P { x: i32, y: i32 };

type Wide: i32 =
    | 7 W { n: int };

type Pad: i32, 32 =
    | 1 A;

type ByteTag: i8 =
    | 0 Z
    | 255 Hi;

type Signed: i32 =
    | -1 Neg
    | 1 Pos;

type Box = {
    t: Tiny;
    n: i32;
};

color_tag(c: Color): int {
    match c {
        Red -> {
            10;
        }
        Blue -> {
            20;
        }
    }
}

tiny_is_b(t: Tiny): int {
    match t {
        B -> {
            1;
        }
        _ -> {
            0;
        }
    }
}

pair_sum(p: Pair): i32 {
    match p {
        P q -> {
            q.x + q.y;
        }
    }
}

wide_n(w: Wide): int {
    match w {
        W q -> {
            q.n;
        }
    }
}

byte_is_hi(b: ByteTag): int {
    match b {
        Hi -> {
            1;
        }
        _ -> {
            0;
        }
    }
}

signed_is_neg(s: Signed): int {
    match s {
        Neg -> {
            1;
        }
        _ -> {
            0;
        }
    }
}

main(): int {
    if (sizeof(Color) == 8) {
        putchar('Y');
    }
    if (color_tag(Color.Red) == 10 && color_tag(Color.Blue) == 20) {
        putchar('Y');
    }
    if (sizeof(Tiny) == 4) {
        putchar('Y');
    }
    if (tiny_is_b(Tiny.B) == 1 && tiny_is_b(Tiny.A) == 0) {
        putchar('Y');
    }
    if (sizeof(Pair) == 12) {
        putchar('Y');
    }
    if (pair_sum(Pair.P { x: 3i32, y: 4i32 }) == 7i32) {
        putchar('Y');
    }
    if (sizeof(Wide) == 16) {
        putchar('Y');
    }
    if (wide_n(Wide.W { n: 42 }) == 42) {
        putchar('Y');
    }
    if (sizeof(Pad) == 32) {
        putchar('Y');
    }
    if (sizeof(ByteTag) == 1) {
        putchar('Y');
    }
    if (byte_is_hi(ByteTag.Hi) == 1 && byte_is_hi(ByteTag.Z) == 0) {
        putchar('Y');
    }
    if (signed_is_neg(Signed.Neg) == 1 && signed_is_neg(Signed.Pos) == 0) {
        putchar('Y');
    }
    b: Box = Box { t: Tiny.B, n: 9i32 };
    if (tiny_is_b(b.t) == 1 && b.n == 9i32) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
