/* `if` / `match` / `{ }` as expressions; last statement is the value. */

putchar(c: i8) {
    write(1, &c, 1);
}

type Color =
    | Red
    | Blue;

abs(n: int): int {
    if (n < 0) { 0 - n; } else { n; }
}

pick(c: Color): int {
    match c {
        Red -> { 1; }
        Blue -> { 2; }
    }
}

blk(): int {
    x: int = 3;
    { x + 1; }
}

main(): int {
    if (abs(0 - 3) == 3) {
        putchar('Y');
    }
    if (pick(Color.Red) == 1) {
        putchar('Y');
    }
    if ((if (true) { 4; } else { 5; }) == 4) {
        putchar('Y');
    }
    if (blk() == 4) {
        putchar('Y');
    }
    v: int = { 7; };
    if (v == 7) {
        putchar('Y');
    }
    c2: Color = Color.Blue;
    m: int = match c2 {
        Red -> { 1; }
        Blue -> { 2; }
    };
    if (m == 2) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
