type Shape = Circle { r: int; } | Rect { w: int; h: int; } | Dot;

putchar(c: i8) {
    write(1, &c, 1);
}

print_int(n: int) {
    if (n < 0) {
        putchar('-');
        n = 0 - n;
    }
    if (n > 9) {
        print_int(n / 10);
    }
    putchar((('0' as int) + (n % 10)) trunc i8);
}

area(s: *Shape): int {
    match s.* {
        Circle { r } -> {
            return r * r;
        }
        Rect { w, h } -> {
            return w * h;
        }
        Dot -> {
            return 0;
        }
    }
}

main(): int {
    a: Shape = Shape.Circle { r: 3 };
    b: Shape = Shape.Rect { w: 2, h: 5 };
    c: Shape = Shape.Dot;
    print_int(area(&a));
    putchar(' ');
    print_int(area(&b));
    putchar(' ');
    print_int(area(&c));
    putchar('\n');
    return 0;
}
