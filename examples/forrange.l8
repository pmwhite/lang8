/* for i in a..b is exclusive; bounds are evaluated once. */

putchar(c: i8) {
    write(1, &c, 1);
}

once(): int {
    3;
}

main(): int {
    for _i in 0..3 {
        putchar('Y');
    }

    t: int = 0;
    for n in 1..4 {
        t = t + n;
    }
    if (t == 6) { putchar('Y'); }

    for _e in 5..5 {
        putchar('X');
    }
    for _r in 3..1 {
        putchar('X');
    }

    s: int = 0;
    for j in 0 - 1..2 {
        s = s + j;
    }
    if (s == 0) { putchar('Y'); }

    for _k in 0..once() {
        putchar('Y');
    }

    outer: int = 0;
    for outer in outer..1 {
        if (outer == 0) { putchar('Y'); }
    }

    putchar('\n');
    0;
}
