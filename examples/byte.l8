/* Character literals are i8. `Ni8` is an integer byte (0..255).
   i8 op i8 wraps; mixed i8/int is a type error. */

putchar(c: i8) {
    write(1, &c, 1);
}

main(): int {
    z: i8 = 0i8;
    if (z == '\0') {
        putchar('Y');
    }
    if ('A' + 1i8 == 'B') {
        putchar('Y');
    }
    if ('B' - 'A' == 1i8) {
        putchar('Y');
    }
    if ('0' + 1i8 == '1') {
        putchar('Y');
    }
    if ((0i8 - 1i8) == 255i8) {
        putchar('Y');
    }
    putchar('\n');
    return 0;
}
