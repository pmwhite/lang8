/* Structs use C layout: natural alignment and tail padding. */
putchar(c: i8) {
    write(1, &c, 1);
}

type Pair32 = {
    a: i32;
    b: i32;
};

type Mix = {
    a: i8;
    b: i32;
};

type Wide = {
    a: i32;
    b: int;
};

type V2 = {
    x: f32;
    y: f32;
};

type Outer = {
    tag: i8;
    inner: Pair32;
};

main(): int {
    if (sizeof(Pair32) == 8) {
        putchar('Y');
    }
    if (sizeof(Mix) == 8) {
        putchar('Y');
    }
    if (sizeof(Wide) == 16) {
        putchar('Y');
    }
    if (sizeof(V2) == 8) {
        putchar('Y');
    }
    if (sizeof(Outer) == 12) {
        putchar('Y');
    }
    m: Mix = Mix { a: 1i8, b: 2i32 };
    if (m.a == 1i8 && m.b == 2i32) {
        putchar('Y');
    }
    v: V2 = V2 { x: 0.5, y: 1.5 };
    if (v.x + v.y == 2.0) {
        putchar('Y');
    }
    o: Outer = Outer { tag: 3i8, inner: Pair32 { a: 4i32, b: 5i32 } };
    if (o.tag == 3i8 && o.inner.a + o.inner.b == 9i32) {
        putchar('Y');
    }
    xs: []V2 = new V2[2](V2 { x: 0.25, y: 0.25 });
    if (xs[0].x + xs[1].y == 0.5) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
