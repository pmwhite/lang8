/* Heap array literals: [a, b, c] is []T. */
putchar(c: i8) {
    write(1, &c, 1);
}

type V2 = {
    x: f32;
    y: f32;
};

main(): int {
    xs: []int = [1, 2, 3];
    if (len(xs) == 3 && xs[0] + xs[1] + xs[2] == 6) {
        putchar('Y');
    }
    ys: []i32 = [4i32, 5i32, 6i32];
    if (len(ys) == 3 && ys[0] + ys[2] == 10i32) {
        putchar('Y');
    }
    zs: []f32 = [0.5, 1.5];
    if (len(zs) == 2 && zs[0] + zs[1] == 2.0) {
        putchar('Y');
    }
    vs: []V2 = [V2 { x: 1.0, y: 2.0 }, V2 { x: 3.0, y: 4.0 }];
    if (len(vs) == 2 && vs[0].x + vs[1].y == 5.0) {
        putchar('Y');
    }
    trail: []int = [7, 8];
    if (len(trail) == 2 && trail[1] == 8) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
