/* Bitwise: `~ & ^ | << >>` (C precedence; `>>` is arithmetic). */

putchar(c: i8) {
    write(1, &c, 1);
}

MASK: int = 7 & 3;
NOT0: int = ~0;
SHL: int = 1 << 3;

main(): int {
    if (MASK == 3) {
        putchar('Y');
    }
    if (NOT0 == (0 - 1)) {
        putchar('Y');
    }
    if (SHL == 8) {
        putchar('Y');
    }
    if ((7 | 8) == 15) {
        putchar('Y');
    }
    if ((7 ^ 3) == 4) {
        putchar('Y');
    }
    if ((16 >> 2) == 4) {
        putchar('Y');
    }
    if (((0 - 8) >> 1) == (0 - 4)) {
        putchar('Y');
    }
    if ((1 + 2 << 3) == 24) {
        putchar('Y');
    }
    if ((15i8 & 3i8) == 3i8) {
        putchar('Y');
    }
    if ((~0i8) == (0i8 - 1i8)) {
        putchar('Y');
    }
    x: int = 9;
    if (((x + 7) & (0 - 8)) == 16) {
        putchar('Y');
    }
    n: int = 3;
    if ((1 << n) == 8) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
