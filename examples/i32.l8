/* i32/u32: wrapping, no mixed promotion with int, unsigned compare and >>. */
putchar(c: i8) {
    write(1, &c, 1);
}

addi(a: i32, b: i32): i32 {
    a + b;
}

main(): int {
    if (1i32 + 2i32 == 3i32) {
        putchar('Y');
    }
    if (addi(10i32, 20i32) == 30i32) {
        putchar('Y');
    }
    if ((0i32 - 1i32) < 0i32) {
        putchar('Y');
    }
    if ((0u32 - 1u32) > 100u32) {
        putchar('Y');
    }
    if (1u32 < 2u32) {
        putchar('Y');
    }
    if ((2147483647i32 + 1i32) == (0i32 - 2147483647i32 - 1i32)) {
        putchar('Y');
    }
    if ((8u32 >> 1) == 4u32) {
        putchar('Y');
    }
    if ((1i32 << 3) == 8i32) {
        putchar('Y');
    }
    if ((7i32 & 3i32) == 3i32) {
        putchar('Y');
    }
    if ((10i32 as int) == 10) {
        putchar('Y');
    }
    x: i32 = 5 trunc i32;
    if (x == 5i32) {
        putchar('Y');
    }
    u: u32 = 7 trunc u32;
    if (u == 7u32) {
        putchar('Y');
    }
    if ((3i32 as f32) == 3.0) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
