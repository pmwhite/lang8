/* [N]T is a fixed-length array: inline storage, C layout. */
putchar(c: i8) {
    write(1, &c, 1);
}

type Pair = {
    a: i8;
    xs: [3]i8;
    b: i32;
};

type Two = {
    n: int;
    ys: [2]i32;
};

gxs: [2]int = [4, 5];

sum3(a: [3]int): int {
    a[0] + a[1] + a[2];
}

mk2(): [2]int {
    [9, 10];
}

main(): int {
    xs: [3]int = [1, 2, 3];
    if (sizeof([3]int) == 24) {
        putchar('Y');
    }
    if (len(xs) == 3) {
        putchar('Y');
    }
    if (xs[0] + xs[1] + xs[2] == 6) {
        putchar('Y');
    }
    xs[1] = 10;
    if (xs[1] == 10) {
        putchar('Y');
    }
    t: int = 0;
    for x in xs {
        t = t + x;
    }
    if (t == 14) {
        putchar('Y');
    }
    s: int = 0;
    for i in 0..len(xs) {
        s = s + xs[i];
    }
    if (s == 14) {
        putchar('Y');
    }
    if (sizeof(Pair) == 8) {
        putchar('Y');
    }
    p: Pair = Pair { a: 1i8, xs: [2i8, 3i8, 4i8], b: 5i32 };
    if (p.a == 1i8 && p.xs[1] == 3i8 && p.b == 5i32) {
        putchar('Y');
    }
    if (sizeof(Two) == 16) {
        putchar('Y');
    }
    zs: [2]i32 = [7i32, 8i32];
    if (zs[0] + zs[1] == 15i32) {
        putchar('Y');
    }
    b: [3]int = xs;
    if (b[0] + b[2] == 4) {
        putchar('Y');
    }
    if (sum3([1, 2, 3]) == 6) {
        putchar('Y');
    }
    r: [2]int = mk2();
    if (r[0] + r[1] == 19) {
        putchar('Y');
    }
    if (gxs[0] + gxs[1] == 9) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
