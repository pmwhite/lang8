putchar(c: int): int {
    ch: int = c;
    write(1, &ch, 1);
    return c;
}

main(): int {
    // 1 && 1 → 1;  1 && 0 → 0;  0 || 1 → 1;  short-circuit
    if (1 && 1) {
        putchar('Y');
    }
    if (1 && 0) {
        putchar('N');
    }
    if (0 || 1) {
        putchar('Y');
    }
    if (0 || 0) {
        putchar('N');
    }
    if (1 && 0 || 1) {
        putchar('Y');
    }
    putchar('\n');
    return 0;
}
