putchar(c: i8) {
    write(1, &c, 1);
}

main(): int {
    if (true && true) {
        putchar('Y');
    }
    if (true && false) {
        putchar('N');
    }
    if (false || true) {
        putchar('Y');
    }
    if (false || false) {
        putchar('N');
    }
    if (true && false || true) {
        putchar('Y');
    }
    if (!false) {
        putchar('Y');
    }
    putchar('\n');
    0;
}
