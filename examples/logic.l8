putchar(c: i8): int {
    write(1, &c, 1);
    return 0;
}

main(): int {
    if (1 && 1) {
        putchar('Y');
    }
    if (1 && 0) {
        putchar('N');
    }
    if (0 || 1) {
        putchar('Y');
    }
    if (0 || 0) {
        putchar('N');
    }
    if (1 && 0 || 1) {
        putchar('Y');
    }
    putchar('\n');
    return 0;
}
